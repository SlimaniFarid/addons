<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pm_plan_list" model="ir.ui.view">
        <field name="name">sf.preventive.maintenance.pro.pm.plan.list</field>
        <field name="model">sf.preventive.maintenance.pro.pm.plan</field>
        <field name="arch" type="xml">
            <list string="Pm.Plan">
                <field name="name"/>
                <field name="equipment_id"/>
                <field name="trigger_type"/>
                <field name="interval_days"/>
                <field name="meter_threshold"/>
                <field name="last_executed"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_pm_plan_form" model="ir.ui.view">
        <field name="name">sf.preventive.maintenance.pro.pm.plan.form</field>
        <field name="model">sf.preventive.maintenance.pro.pm.plan</field>
        <field name="arch" type="xml">
            <form string="Pm.Plan">
                <header>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" placeholder="Name"/></h1></div>
                    <group><group>
                            <field name="name"/>
                            <field name="equipment_id"/>
                            <field name="trigger_type"/>
                            <field name="interval_days"/>
                            <field name="meter_threshold"/>
                            <field name="last_executed"/>
                            <field name="next_due"/>
                            <field name="active"/>
                    </group>
                    <group>
                        <field name="currency_id" invisible="1"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_pm_plan" model="ir.actions.act_window">
        <field name="name">Pm.Plan</field>
        <field name="res_model">sf.preventive.maintenance.pro.pm.plan</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
