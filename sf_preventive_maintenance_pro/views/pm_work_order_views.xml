<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pm_work_order_list" model="ir.ui.view">
        <field name="name">sf.preventive.maintenance.pro.pm.work.order.list</field>
        <field name="model">sf.preventive.maintenance.pro.pm.work.order</field>
        <field name="arch" type="xml">
            <list string="Pm.Work.Order">
                <field name="plan_id"/>
                <field name="maintenance_request_id"/>
                <field name="created_date"/>
                <field name="state"/>
                <field name="state" widget="badge"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_pm_work_order_form" model="ir.ui.view">
        <field name="name">sf.preventive.maintenance.pro.pm.work.order.form</field>
        <field name="model">sf.preventive.maintenance.pro.pm.work.order</field>
        <field name="arch" type="xml">
            <form string="Pm.Work.Order">
                <header>
                <field name="state" widget="badge"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" placeholder="Name"/></h1></div>
                    <group><group>
                            <field name="plan_id"/>
                            <field name="maintenance_request_id"/>
                            <field name="created_date"/>
                            <field name="state"/>
                    </group>
                    <group>
                        <field name="currency_id" invisible="1"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_pm_work_order" model="ir.actions.act_window">
        <field name="name">Pm.Work.Order</field>
        <field name="res_model">sf.preventive.maintenance.pro.pm.work.order</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
