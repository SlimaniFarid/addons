<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_company_car_policy" model="ir.module.category">
        <field name="name">Company Car Policy &amp; Eligibility</field>
        <field name="sequence">3</field>
    </record>
    <record id="group_company_car_policy_user" model="res.groups">
        <field name="name">Company Car Policy &amp; Eligibility User</field>
        <field name="category_id" ref="module_category_company_car_policy"/>

    </record>
    <record id="group_company_car_policy_manager" model="res.groups">
        <field name="name">Company Car Policy &amp; Eligibility Manager</field>
        <field name="category_id" ref="module_category_company_car_policy"/>
        <field name="implied_ids" eval="[(4, ref('group_company_car_policy_user'))]"/>
    </record>
    <record id="rule_company_car_policy_sf_car_assignment" model="ir.rule">
        <field name="name">Company Car Assignment: multi-company</field>
        <field name="model_id" ref="model_sf_car_assignment"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_company_car_policy"/>
    </record>
</odoo>
