<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_car_assignment" model="ir.actions.act_window">
        <field name="name">Company Car Policy &amp; Eligibility</field>
        <field name="res_model">sf.car.assignment</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
    <record id="view_sf_car_assignment_form" model="ir.ui.view">
        <field name="name">sf.car.assignment.form</field>
        <field name="model">sf.car.assignment</field>
        <field name="arch" type="xml">
            <form string="Company Car Policy &amp; Eligibility">
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="assigned,returned"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="employee_id"/>
                            <field name="vehicle_id"/>
                            <field name="grade"/>
                            <field name="co2_gkm"/>
                            <field name="fuel_card_ref"/>
                            <field name="contract_end"/>
                            <field name="eligible"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_car_assignment_list" model="ir.ui.view">
        <field name="name">sf.car.assignment.list</field>
        <field name="model">sf.car.assignment</field>
        <field name="arch" type="xml">
            <list string="Company Car Policy &amp; Eligibility" sample="1">
                <field name="employee_id"/>
                <field name="vehicle_id"/>
                <field name="grade"/>
                <field name="co2_gkm"/>
                <field name="fuel_card_ref"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state in ('submitted','approved')"/>
            </list>
        </field>
    </record>
    <record id="view_sf_car_assignment_kanban" model="ir.ui.view">
        <field name="name">sf.car.assignment.kanban</field>
        <field name="model">sf.car.assignment</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_view" group_by="state">
                <field name="name"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <menuitem id="menu_sf_car_assignment_root" name="Company Car Policy &amp; Eligibility" sequence="22"
              web_icon="sf_company_car_policy,static/description/icon.png"/>
    <menuitem id="menu_sf_car_assignment_main" name="Records"
              parent="menu_sf_car_assignment_root" action="action_sf_car_assignment" sequence="10"/>

    <record id="wave_final_sf_company_car_policy" model="ir.actions.server">
        <field name="name">Refresh Business Data</field>
        <field name="model_id" ref="model_sf_car_assignment"/>
        <field name="binding_model_id" ref="model_sf_car_assignment"/>
        <field name="state">code</field>
        <field name="code">records.action_refresh_business()</field>
    </record>
</odoo>
