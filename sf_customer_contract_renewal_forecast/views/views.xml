<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_customer_contract_renewal_forecast" model="ir.actions.act_window">
        <field name="name">Renewal Revenue Forecast</field>
        <field name="res_model">sf.customer_contract_renewal_forecast</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
    <record id="view_sf_customer_contract_renewal_forecast_form" model="ir.ui.view">
        <field name="name">sf.customer_contract_renewal_forecast.form</field>
        <field name="model">sf.customer_contract_renewal_forecast</field>
        <field name="arch" type="xml">
            <form string="Renewal Revenue Forecast">
                <header>
                    <button name="action_submitted" type="object" string="Submitted"
                            class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="forecast_month"/>
                            <field name="contracts_expiring"/>
                            <field name="revenue_at_risk"/>
                            <field name="historical_win_rate"/>
                            <field name="forecast_revenue"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_customer_contract_renewal_forecast_list" model="ir.ui.view">
        <field name="name">sf.customer_contract_renewal_forecast.list</field>
        <field name="model">sf.customer_contract_renewal_forecast</field>
        <field name="arch" type="xml">
            <list string="Renewal Revenue Forecast" sample="1">
                <field name="forecast_month"/>
                <field name="contracts_expiring"/>
                <field name="revenue_at_risk"/>
                <field name="historical_win_rate"/>
                <field name="forecast_revenue"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state in ('submitted','approved')"/>
            </list>
        </field>
    </record>
    <record id="view_sf_customer_contract_renewal_forecast_kanban" model="ir.ui.view">
        <field name="name">sf.customer_contract_renewal_forecast.kanban</field>
        <field name="model">sf.customer_contract_renewal_forecast</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_view" group_by="state">
                <field name="name"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <menuitem id="menu_sf_customer_contract_renewal_forecast_root" name="Renewal Revenue Forecast" sequence="22"
              web_icon="sf_customer_contract_renewal_forecast,static/description/icon.png"/>
    <menuitem id="menu_sf_customer_contract_renewal_forecast_main" name="Records"
              parent="menu_sf_customer_contract_renewal_forecast_root" action="action_sf_customer_contract_renewal_forecast" sequence="10"/>
</odoo>
