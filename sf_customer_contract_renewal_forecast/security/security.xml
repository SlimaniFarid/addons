<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_customer_contract_renewal_forecast" model="ir.module.category">
        <field name="name">Renewal Revenue Forecast</field>
        <field name="sequence">179</field>
    </record>
    <record id="group_customer_contract_renewal_forecast_user" model="res.groups">
        <field name="name">Renewal Revenue Forecast User</field>
        <field name="category_id" ref="module_category_customer_contract_renewal_forecast"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>

    </record>
    <record id="group_customer_contract_renewal_forecast_manager" model="res.groups">
        <field name="name">Renewal Revenue Forecast Manager</field>
        <field name="category_id" ref="module_category_customer_contract_renewal_forecast"/>
        <field name="implied_ids" eval="[(4, ref('group_customer_contract_renewal_forecast_user'))]"/>
    </record>
    <record id="rule_customer_contract_renewal_forecast_sf_customer_contract_renewal_forecast" model="ir.rule">
        <field name="name">Renewal Revenue Forecast: multi-company</field>
        <field name="model_id" ref="model_sf_customer_contract_renewal_forecast"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_customer_contract_renewal_forecast"/>
    </record>
</odoo>
