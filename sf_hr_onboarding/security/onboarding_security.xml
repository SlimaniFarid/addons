<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_onboarding" model="ir.module.category">
        <field name="name">Onboarding</field>
        <field name="sequence">95</field>
    </record>

    <record id="group_onboarding_user" model="res.groups">
        <field name="name">Onboarding User</field>
        <field name="category_id" ref="module_category_onboarding"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_onboarding_manager" model="res.groups">
        <field name="name">Onboarding Manager</field>
        <field name="category_id" ref="module_category_onboarding"/>
        <field name="implied_ids" eval="[(4, ref('group_onboarding_user'))]"/>
    </record>

    <record id="rule_onboarding_program_user_company" model="ir.rule">
        <field name="name">Onboarding Program: user sees own company</field>
        <field name="model_id" ref="model_sf_onboarding_program"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_onboarding_user'))]"/>
    </record>

    <record id="rule_onboarding_task_user_company" model="ir.rule">
        <field name="name">Onboarding Task: user sees own company</field>
        <field name="model_id" ref="model_sf_onboarding_task"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('program_id.company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_onboarding_user'))]"/>
    </record>
    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_onboarding"/>
    </record>
</odoo>