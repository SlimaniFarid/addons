<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_sales_coaching_log" model="ir.module.category">
        <field name="name">Sales Coaching Log</field>
        <field name="sequence">200</field>
    </record>
    <record id="group_sales_coaching_log_user" model="res.groups">
        <field name="name">Sales Coaching Log User</field>
        <field name="category_id" ref="module_category_sales_coaching_log"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>

    </record>
    <record id="group_sales_coaching_log_manager" model="res.groups">
        <field name="name">Sales Coaching Log Manager</field>
        <field name="category_id" ref="module_category_sales_coaching_log"/>
        <field name="implied_ids" eval="[(4, ref('group_sales_coaching_log_user'))]"/>
    </record>
    <record id="rule_sales_coaching_log_sf_sales_coaching_log" model="ir.rule">
        <field name="name">Sales Coaching Log: multi-company</field>
        <field name="model_id" ref="model_sf_sales_coaching_log"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_sales_coaching_log"/>
    </record>
</odoo>
