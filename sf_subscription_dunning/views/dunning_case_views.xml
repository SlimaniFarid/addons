<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dunning_case_list" model="ir.ui.view">
        <field name="name">sf.subscription.dunning.dunning.case.list</field>
        <field name="model">sf.subscription.dunning.dunning.case</field>
        <field name="arch" type="xml">
            <list string="Dunning.Case">
                <field name="invoice_id"/>
                <field name="level_id"/>
                <field name="attempts"/>
                <field name="state"/>
                <field name="state" widget="badge"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_dunning_case_form" model="ir.ui.view">
        <field name="name">sf.subscription.dunning.dunning.case.form</field>
        <field name="model">sf.subscription.dunning.dunning.case</field>
        <field name="arch" type="xml">
            <form string="Dunning.Case">
                <header>
                <field name="state" widget="badge"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" placeholder="Name"/></h1></div>
                    <group><group>
                            <field name="invoice_id"/>
                            <field name="level_id"/>
                            <field name="attempts"/>
                            <field name="state"/>
                    </group>
                    <group>
                        <field name="currency_id" invisible="1"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_dunning_case" model="ir.actions.act_window">
        <field name="name">Dunning.Case</field>
        <field name="res_model">sf.subscription.dunning.dunning.case</field>
        <field name="view_mode">kanban,list,form</field>
    </record>

    <record id="view_sf_subscription_dunning_boost_kanban" model="ir.ui.view">
        <field name="name">sf_subscription_dunning.boost.kanban</field>
        <field name="model">sf.subscription.dunning.dunning.case</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" t-att-color="state">
                <field name="name"/>
                <field name="state"/>
                <field name="user_id"/>

                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_card oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title">
                                    <field name="name"/></strong>
                                <div class="o_kanban_record_subtitle">
                                    <field name="user_id" widget="many2one_avatar_user"/>
                                    <field name="create_date"/></div>
                            </div>
                            <div class="oe_kanban_bottom_right">
                                <field name="state" widget="badge"
                                       t-attf-options="{'classes_map': {'draft': 'info', 'done': 'success', 'cancelled': 'danger'}, 'domain': []}"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_sf_subscription_dunning_boost_search" model="ir.ui.view">
        <field name="name">sf_subscription_dunning.boost.search</field>
        <field name="model">sf.subscription.dunning.dunning.case</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
<separator/>
                <filter string="My records" name="my_records" domain="[('user_id', '=', uid)]"/>
                <filter string="To Do" name="todo" domain="[('state', 'not in', ('done', 'cancelled', 'closed'))]"/>
                <group expand="0" string="Group By"><filter string="Status" name="gb_state" context="{'group_by': 'state'}"/></group>
            </search>
        </field>
    </record>

    <record id="wave_final_sf_subscription_dunning" model="ir.actions.server">
        <field name="name">Refresh Business Data</field>
        <field name="model_id" ref="model_sf_subscription_dunning_dunning_case"/>
        <field name="binding_model_id" ref="model_sf_subscription_dunning_dunning_case"/>
        <field name="state">code</field>
        <field name="code">records.action_refresh_business()</field>
    </record>
</odoo>
