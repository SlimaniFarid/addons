<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dunning_level_list" model="ir.ui.view">
        <field name="name">sf.subscription.dunning.dunning.level.list</field>
        <field name="model">sf.subscription.dunning.dunning.level</field>
        <field name="arch" type="xml">
            <list string="Dunning.Level">
                <field name="name"/>
                <field name="sequence"/>
                <field name="days_after_due"/>
                <field name="email_template_id"/>
                <field name="suspend_subscription"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_dunning_level_form" model="ir.ui.view">
        <field name="name">sf.subscription.dunning.dunning.level.form</field>
        <field name="model">sf.subscription.dunning.dunning.level</field>
        <field name="arch" type="xml">
            <form string="Dunning.Level">
                <header>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" placeholder="Name"/></h1></div>
                    <group><group>
                            <field name="name"/>
                            <field name="sequence"/>
                            <field name="days_after_due"/>
                            <field name="email_template_id"/>
                            <field name="suspend_subscription"/>
                    </group>
                    <group>
                        <field name="currency_id" invisible="1"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_dunning_level" model="ir.actions.act_window">
        <field name="name">Dunning.Level</field>
        <field name="res_model">sf.subscription.dunning.dunning.level</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
