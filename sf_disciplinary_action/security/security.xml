<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_disciplinary_action" model="ir.module.category">
        <field name="name">Disciplinary Action Register</field>
        <field name="sequence">195</field>
    </record>
    <record id="group_disciplinary_action_user" model="res.groups">
        <field name="name">Disciplinary Action Register User</field>
        <field name="category_id" ref="module_category_disciplinary_action"/>

    </record>
    <record id="group_disciplinary_action_manager" model="res.groups">
        <field name="name">Disciplinary Action Register Manager</field>
        <field name="category_id" ref="module_category_disciplinary_action"/>
        <field name="implied_ids" eval="[(4, ref('group_disciplinary_action_user'))]"/>
    </record>
    <record id="rule_disciplinary_action_sf_disciplinary_action" model="ir.rule">
        <field name="name">Disciplinary Action Register: multi-company</field>
        <field name="model_id" ref="model_sf_disciplinary_action"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
