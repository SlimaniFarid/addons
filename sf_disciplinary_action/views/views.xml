<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_disciplinary_action" model="ir.actions.act_window">
        <field name="name">Disciplinary Action Register</field>
        <field name="res_model">sf.disciplinary_action</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
    <record id="view_sf_disciplinary_action_form" model="ir.ui.view">
        <field name="name">sf.disciplinary_action.form</field>
        <field name="model">sf.disciplinary_action</field>
        <field name="arch" type="xml">
            <form string="Disciplinary Action Register">
                <header>
                    <button name="action_submitted" type="object" string="Submitted"
                            class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="employee_id"/>
                            <field name="action_type"/>
                            <field name="action_date"/>
                            <field name="description"/>
                            <field name="expiry_date"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_disciplinary_action_list" model="ir.ui.view">
        <field name="name">sf.disciplinary_action.list</field>
        <field name="model">sf.disciplinary_action</field>
        <field name="arch" type="xml">
            <list string="Disciplinary Action Register" sample="1">
                <field name="employee_id"/>
                <field name="action_type"/>
                <field name="action_date"/>
                <field name="description"/>
                <field name="expiry_date"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state in ('submitted','approved')"/>
            </list>
        </field>
    </record>
    <record id="view_sf_disciplinary_action_kanban" model="ir.ui.view">
        <field name="name">sf.disciplinary_action.kanban</field>
        <field name="model">sf.disciplinary_action</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_view" group_by="state">
                <field name="name"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <menuitem id="menu_sf_disciplinary_action_root" name="Disciplinary Action Register" sequence="6"
              web_icon="sf_disciplinary_action,static/description/icon.png"/>
    <menuitem id="menu_sf_disciplinary_action_main" name="Records"
              parent="menu_sf_disciplinary_action_root" action="action_sf_disciplinary_action" sequence="10"/>
</odoo>
