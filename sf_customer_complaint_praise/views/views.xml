<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_compliment" model="ir.actions.act_window">
        <field name="name">Customer Compliments Register</field>
        <field name="res_model">sf.compliment</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
    <record id="view_sf_compliment_form" model="ir.ui.view">
        <field name="name">sf.compliment.form</field>
        <field name="model">sf.compliment</field>
        <field name="arch" type="xml">
            <form string="Customer Compliments Register">
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="received,shared"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="compliment_date"/>
                            <field name="channel"/>
                            <field name="praised_team"/>
                            <field name="quote"/>
                            <field name="shared_with_team"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_compliment_list" model="ir.ui.view">
        <field name="name">sf.compliment.list</field>
        <field name="model">sf.compliment</field>
        <field name="arch" type="xml">
            <list string="Customer Compliments Register" sample="1">
                <field name="partner_id"/>
                <field name="compliment_date"/>
                <field name="channel"/>
                <field name="praised_team"/>
                <field name="quote"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state in ('submitted','approved')"/>
            </list>
        </field>
    </record>
    <record id="view_sf_compliment_kanban" model="ir.ui.view">
        <field name="name">sf.compliment.kanban</field>
        <field name="model">sf.compliment</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_view" group_by="state">
                <field name="name"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <menuitem id="menu_sf_compliment_root" name="Customer Compliments Register" sequence="14"
              web_icon="sf_customer_complaint_praise,static/description/icon.png"/>
    <menuitem id="menu_sf_compliment_main" name="Records"
              parent="menu_sf_compliment_root" action="action_sf_compliment" sequence="10"/>
</odoo>
