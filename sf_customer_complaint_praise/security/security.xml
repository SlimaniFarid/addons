<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_customer_complaint_praise" model="ir.module.category">
        <field name="name">Customer Compliments Register</field>
        <field name="sequence">22</field>
    </record>
    <record id="group_customer_complaint_praise_user" model="res.groups">
        <field name="name">Customer Compliments Register User</field>
        <field name="category_id" ref="module_category_customer_complaint_praise"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>

    </record>
    <record id="group_customer_complaint_praise_manager" model="res.groups">
        <field name="name">Customer Compliments Register Manager</field>
        <field name="category_id" ref="module_category_customer_complaint_praise"/>
        <field name="implied_ids" eval="[(4, ref('group_customer_complaint_praise_user'))]"/>
    </record>
    <record id="rule_customer_complaint_praise_sf_compliment" model="ir.rule">
        <field name="name">Customer Compliment: multi-company</field>
        <field name="model_id" ref="model_sf_compliment"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
