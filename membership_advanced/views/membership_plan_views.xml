<odoo>
    <record id="action_membership_plan" model="ir.actions.act_window">
        <field name="name">Membership Plans</field>
        <field name="res_model">membership.plan</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_membership_member" model="ir.actions.act_window">
        <field name="name">Members</field>
        <field name="res_model">membership.member</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_membership_subscription" model="ir.actions.act_window">
        <field name="name">Subscriptions</field>
        <field name="res_model">membership.subscription</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_membership_payment" model="ir.actions.act_window">
        <field name="name">Payments</field>
        <field name="res_model">membership.payment</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_membership_root" name="Membership" web_icon="membership_advanced,static/description/icon.png"/>
    <menuitem id="menu_membership_members" name="Members" parent="menu_membership_root" action="action_membership_member" sequence="10"/>
    <menuitem id="menu_membership_subscriptions" name="Subscriptions" parent="menu_membership_root" action="action_membership_subscription" sequence="20"/>
    <menuitem id="menu_membership_payments" name="Payments" parent="menu_membership_root" action="action_membership_payment" sequence="30"/>
    <menuitem id="menu_membership_plans" name="Plans" parent="menu_membership_root" action="action_membership_plan" sequence="40"/>
    <menuitem id="menu_membership_reports" name="Reports" parent="menu_membership_root" sequence="50"/>

    <record id="view_membership_plan_form" model="ir.ui.view">
        <field name="name">membership.plan.form</field>
        <field name="model">membership.plan</field>
        <field name="arch" type="xml">
            <form string="Membership Plan">
                <header>
                    <button name="action_create_product" string="Create Product" type="object" class="btn-secondary" invisible="product_id"/>
                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="sequence"/>
                        <field name="active"/>
                        <field name="membership_type"/>
                        <field name="fee"/>
                        <field name="currency_id"/>
                        <field name="duration_months"/>
                        <field name="trial_days"/>
                        <field name="auto_renew"/>
                        <field name="max_members"/>
                    </group>
                    <group string="Details">
                        <field name="description"/>
                        <field name="benefits"/>
                    </group>
                    <group string="Product">
                        <field name="product_id" widget="many2one"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_membership_plan_list" model="ir.ui.view">
        <field name="name">membership.plan.list</field>
        <field name="model">membership.plan</field>
        <field name="arch" type="xml">
            <list string="Membership Plans">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="membership_type"/>
                <field name="fee"/>
                <field name="currency_id"/>
                <field name="duration_months"/>
                <field name="active" widget="boolean"/>
            </list>
        </field>
    </record>
</odoo>