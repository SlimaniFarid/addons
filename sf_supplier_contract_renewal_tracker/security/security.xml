<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_supplier_contract_renewal_tracker" model="ir.module.category">
        <field name="name">Contract Renewal Tracker</field>
        <field name="sequence">456</field>
    </record>
    <record id="group_supplier_contract_renewal_tracker_user" model="res.groups">
        <field name="name">Contract Renewal Tracker User</field>
        <field name="category_id" ref="module_category_supplier_contract_renewal_tracker"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>

    </record>
    <record id="group_supplier_contract_renewal_tracker_manager" model="res.groups">
        <field name="name">Contract Renewal Tracker Manager</field>
        <field name="category_id" ref="module_category_supplier_contract_renewal_tracker"/>
        <field name="implied_ids" eval="[(4, ref('group_supplier_contract_renewal_tracker_user'))]"/>
    </record>
    <record id="rule_supplier_contract_renewal_tracker_sf_supplier_contract_renewal_tracker" model="ir.rule">
        <field name="name">Contract Renewal Tracker: multi-company</field>
        <field name="model_id" ref="model_sf_supplier_contract_renewal_tracker"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
