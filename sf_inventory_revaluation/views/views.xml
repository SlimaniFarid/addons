<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_inventory_revaluation" model="ir.actions.act_window">
        <field name="name">Inventory Revaluation Register</field>
        <field name="res_model">sf.inventory_revaluation</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
    <record id="view_sf_inventory_revaluation_form" model="ir.ui.view">
        <field name="name">sf.inventory_revaluation.form</field>
        <field name="model">sf.inventory_revaluation</field>
        <field name="arch" type="xml">
            <form string="Inventory Revaluation Register">
                <header>
                    <button name="action_submitted" type="object" string="Submitted"
                            class="btn-primary"/>
                    <button name="action_approved" type="object" string="Approved"
                            class="btn-primary"/>
                    <button name="action_done" type="object" string="Done"
                            class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,approved,done,cancelled"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="period"/>
                            <field name="revaluation_method"/>
                            <field name="adjustment_amount"/>
                            <field name="reason"/>
                            <field name="approved_by_id"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_inventory_revaluation_list" model="ir.ui.view">
        <field name="name">sf.inventory_revaluation.list</field>
        <field name="model">sf.inventory_revaluation</field>
        <field name="arch" type="xml">
            <list string="Inventory Revaluation Register" sample="1">
                <field name="period"/>
                <field name="revaluation_method"/>
                <field name="adjustment_amount"/>
                <field name="reason"/>
                <field name="approved_by_id"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state in ('submitted','approved')"/>
            </list>
        </field>
    </record>
    <record id="view_sf_inventory_revaluation_kanban" model="ir.ui.view">
        <field name="name">sf.inventory_revaluation.kanban</field>
        <field name="model">sf.inventory_revaluation</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_view" group_by="state">
                <field name="name"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <menuitem id="menu_sf_inventory_revaluation_root" name="Inventory Revaluation Register" sequence="5"
              web_icon="sf_inventory_revaluation,static/description/icon.png"/>
    <menuitem id="menu_sf_inventory_revaluation_main" name="Records"
              parent="menu_sf_inventory_revaluation_root" action="action_sf_inventory_revaluation" sequence="10"/>
</odoo>
