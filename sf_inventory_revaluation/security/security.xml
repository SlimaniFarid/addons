<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_inventory_revaluation" model="ir.module.category">
        <field name="name">Inventory Revaluation Register</field>
        <field name="sequence">366</field>
    </record>
    <record id="group_inventory_revaluation_user" model="res.groups">
        <field name="name">Inventory Revaluation Register User</field>
        <field name="category_id" ref="module_category_inventory_revaluation"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>

    </record>
    <record id="group_inventory_revaluation_manager" model="res.groups">
        <field name="name">Inventory Revaluation Register Manager</field>
        <field name="category_id" ref="module_category_inventory_revaluation"/>
        <field name="implied_ids" eval="[(4, ref('group_inventory_revaluation_user'))]"/>
    </record>
    <record id="rule_inventory_revaluation_sf_inventory_revaluation" model="ir.rule">
        <field name="name">Inventory Revaluation Register: multi-company</field>
        <field name="model_id" ref="model_sf_inventory_revaluation"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
