<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_internal_audit" model="ir.actions.act_window">
        <field name="name">Internal Audit Annual Program</field>
        <field name="res_model">sf.internal.audit</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
    <record id="view_sf_internal_audit_form" model="ir.ui.view">
        <field name="name">sf.internal.audit.form</field>
        <field name="model">sf.internal.audit</field>
        <field name="arch" type="xml">
            <form string="Internal Audit Annual Program">
                <header>
                    <button name="action_in_progress" type="object" string="In Progress"
                            class="btn-primary"/>
                    <button name="action_reported" type="object" string="Reported"
                            class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="planned,in_progress,reported,closed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="audit_title"/>
                        <field name="scope"/>
                            <field name="planned_date"/>
                            <field name="lead_auditor_id"/>
                            <field name="findings_count"/>
                            <field name="report_ref"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_internal_audit_list" model="ir.ui.view">
        <field name="name">sf.internal.audit.list</field>
        <field name="model">sf.internal.audit</field>
        <field name="arch" type="xml">
            <list string="Internal Audit Annual Program" sample="1">
                <field name="audit_title"/>
                <field name="scope"/>
                <field name="planned_date"/>
                <field name="lead_auditor_id"/>
                <field name="findings_count"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state in ('submitted','approved')"/>
            </list>
        </field>
    </record>
    <record id="view_sf_internal_audit_kanban" model="ir.ui.view">
        <field name="name">sf.internal.audit.kanban</field>
        <field name="model">sf.internal.audit</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_view" group_by="state">
                <field name="name"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <menuitem id="menu_sf_internal_audit_root" name="Internal Audit Annual Program" sequence="13"
              web_icon="sf_internal_audit_program,static/description/icon.png"/>
    <menuitem id="menu_sf_internal_audit_main" name="Records"
              parent="menu_sf_internal_audit_root" action="action_sf_internal_audit" sequence="10"/>
</odoo>
