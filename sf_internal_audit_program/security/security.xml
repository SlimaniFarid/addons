<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_internal_audit_program" model="ir.module.category">
        <field name="name">Internal Audit Annual Program</field>
        <field name="sequence">34</field>
    </record>
    <record id="group_internal_audit_program_user" model="res.groups">
        <field name="name">Internal Audit Annual Program User</field>
        <field name="category_id" ref="module_category_internal_audit_program"/>

    </record>
    <record id="group_internal_audit_program_manager" model="res.groups">
        <field name="name">Internal Audit Annual Program Manager</field>
        <field name="category_id" ref="module_category_internal_audit_program"/>
        <field name="implied_ids" eval="[(4, ref('group_internal_audit_program_user'))]"/>
    </record>
    <record id="rule_internal_audit_program_sf_internal_audit" model="ir.rule">
        <field name="name">Internal Audit: multi-company</field>
        <field name="model_id" ref="model_sf_internal_audit"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
