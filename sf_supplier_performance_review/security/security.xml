<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_supplier_performance_review" model="ir.module.category">
        <field name="name">Supplier Performance Review Meeting</field>
        <field name="sequence">260</field>
    </record>
    <record id="group_supplier_performance_review_user" model="res.groups">
        <field name="name">Supplier Performance Review Meeting User</field>
        <field name="category_id" ref="module_category_supplier_performance_review"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>

    </record>
    <record id="group_supplier_performance_review_manager" model="res.groups">
        <field name="name">Supplier Performance Review Meeting Manager</field>
        <field name="category_id" ref="module_category_supplier_performance_review"/>
        <field name="implied_ids" eval="[(4, ref('group_supplier_performance_review_user'))]"/>
    </record>
    <record id="rule_supplier_performance_review_sf_supplier_performance_review" model="ir.rule">
        <field name="name">Supplier Performance Review Meeting: multi-company</field>
        <field name="model_id" ref="model_sf_supplier_performance_review"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_supplier_performance_review"/>
    </record>
</odoo>
