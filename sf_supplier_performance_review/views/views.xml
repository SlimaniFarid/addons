<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_supplier_performance_review" model="ir.actions.act_window">
        <field name="name">Supplier Performance Review Meeting</field>
        <field name="res_model">sf.supplier_performance_review</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
    <record id="view_sf_supplier_performance_review_form" model="ir.ui.view">
        <field name="name">sf.supplier_performance_review.form</field>
        <field name="model">sf.supplier_performance_review</field>
        <field name="arch" type="xml">
            <form string="Supplier Performance Review Meeting">
                <header>
                    <button name="action_in_progress" type="object" string="In Progress"
                            class="btn-primary"/>
                    <button name="action_review" type="object" string="Review"
                            class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,in_progress,review,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="vendor_id"/>
                            <field name="review_date"/>
                            <field name="overall_score"/>
                        <field name="improvement_areas"/>
                            <field name="commitments"/>
                            <field name="next_review"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_supplier_performance_review_list" model="ir.ui.view">
        <field name="name">sf.supplier_performance_review.list</field>
        <field name="model">sf.supplier_performance_review</field>
        <field name="arch" type="xml">
            <list string="Supplier Performance Review Meeting" sample="1">
                <field name="vendor_id"/>
                <field name="review_date"/>
                <field name="overall_score"/>
                <field name="improvement_areas"/>
                <field name="commitments"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state in ('submitted','approved')"/>
            </list>
        </field>
    </record>
    <record id="view_sf_supplier_performance_review_kanban" model="ir.ui.view">
        <field name="name">sf.supplier_performance_review.kanban</field>
        <field name="model">sf.supplier_performance_review</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_view" group_by="state">
                <field name="name"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <menuitem id="menu_sf_supplier_performance_review_root" name="Supplier Performance Review Meeting" sequence="11"
              web_icon="sf_supplier_performance_review,static/description/icon.png"/>
    <menuitem id="menu_sf_supplier_performance_review_main" name="Records"
              parent="menu_sf_supplier_performance_review_root" action="action_sf_supplier_performance_review" sequence="10"/>

    <record id="wave_final_sf_supplier_performance_review" model="ir.actions.server">
        <field name="name">Refresh Business Data</field>
        <field name="model_id" ref="model_sf_supplier_performance_review"/>
        <field name="binding_model_id" ref="model_sf_supplier_performance_review"/>
        <field name="state">code</field>
        <field name="code">records.action_refresh_business()</field>
    </record>
</odoo>
