<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_policy_exception_tracker" model="ir.module.category">
        <field name="name">Policy Exception Tracker</field>
        <field name="sequence">389</field>
    </record>
    <record id="group_policy_exception_tracker_user" model="res.groups">
        <field name="name">Policy Exception Tracker User</field>
        <field name="category_id" ref="module_category_policy_exception_tracker"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>

    </record>
    <record id="group_policy_exception_tracker_manager" model="res.groups">
        <field name="name">Policy Exception Tracker Manager</field>
        <field name="category_id" ref="module_category_policy_exception_tracker"/>
        <field name="implied_ids" eval="[(4, ref('group_policy_exception_tracker_user'))]"/>
    </record>
    <record id="rule_policy_exception_tracker_sf_policy_exception_tracker" model="ir.rule">
        <field name="name">Policy Exception Tracker: multi-company</field>
        <field name="model_id" ref="model_sf_policy_exception_tracker"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
