<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_policy_exception_tracker" model="ir.actions.act_window">
        <field name="name">Policy Exception Tracker</field>
        <field name="res_model">sf.policy_exception_tracker</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
    <record id="view_sf_policy_exception_tracker_form" model="ir.ui.view">
        <field name="name">sf.policy_exception_tracker.form</field>
        <field name="model">sf.policy_exception_tracker</field>
        <field name="arch" type="xml">
            <form string="Policy Exception Tracker">
                <header>
                    <button name="action_submitted" type="object" string="Submitted"
                            class="btn-primary"/>
                    <button name="action_approved" type="object" string="Approved"
                            class="btn-primary"/>
                    <button name="action_done" type="object" string="Done"
                            class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,approved,done,cancelled"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="policy_name"/>
                            <field name="exception_reason"/>
                            <field name="risk_level"/>
                            <field name="compensating_controls"/>
                            <field name="valid_until"/>
                            <field name="approved_by_id"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_policy_exception_tracker_list" model="ir.ui.view">
        <field name="name">sf.policy_exception_tracker.list</field>
        <field name="model">sf.policy_exception_tracker</field>
        <field name="arch" type="xml">
            <list string="Policy Exception Tracker" sample="1">
                <field name="policy_name"/>
                <field name="exception_reason"/>
                <field name="risk_level"/>
                <field name="compensating_controls"/>
                <field name="valid_until"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state in ('submitted','approved')"/>
            </list>
        </field>
    </record>
    <record id="view_sf_policy_exception_tracker_kanban" model="ir.ui.view">
        <field name="name">sf.policy_exception_tracker.kanban</field>
        <field name="model">sf.policy_exception_tracker</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_view" group_by="state">
                <field name="name"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <menuitem id="menu_sf_policy_exception_tracker_root" name="Policy Exception Tracker" sequence="12"
              web_icon="sf_policy_exception_tracker,static/description/icon.png"/>
    <menuitem id="menu_sf_policy_exception_tracker_main" name="Records"
              parent="menu_sf_policy_exception_tracker_root" action="action_sf_policy_exception_tracker" sequence="10"/>
</odoo>
