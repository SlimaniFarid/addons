<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sf_trade_program_list" model="ir.ui.view">
        <field name="name">sf.trade.program.list</field>
        <field name="model">sf.trade.program</field>
        <field name="arch" type="xml">
            <list string="Trade Programs">
                <field name="name"/>
                <field name="promotion_type"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="budget"/>
                <field name="total_claimed"/>
                <field name="remaining_budget"/>
                <field name="roi"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="sf_trade_program_form" model="ir.ui.view">
        <field name="name">sf.trade.program.form</field>
        <field name="model">sf.trade.program</field>
        <field name="arch" type="xml">
            <form string="Trade Program">
                <header>
                    <button name="action_activate" string="Activate" type="object"
                            states="draft" class="btn-primary"/>
                    <button name="action_close" string="Close" type="object"
                            states="active" class="btn-primary" groups="sf_trade_promotions.group_sf_trade_promotions_manager"/>
                    <button name="action_cancel" string="Cancel" type="object"
                            states="draft,active" class="btn-secondary"
                            groups="sf_trade_promotions.group_sf_trade_promotions_manager"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,active,closed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="claim_ids" type="object" class="oe_stat_button"
                                icon="fa-tasks">
                            <div class="o_stat_info">
                                <field name="claim_count" widget="statinfo"/>
                                <span>Claims</span>
                            </div>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="promotion_type"/>
                            <field name="partner_ids" widget="many2many_tags"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="currency_id"/>
                            <field name="start_date"/>
                            <field name="end_date"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Budget">
                            <group>
                                <group>
                                    <field name="budget"/>
                                    <field name="total_claimed" readonly="1"/>
                                </group>
                                <group>
                                    <field name="remaining_budget" readonly="1"/>
                                    <field name="roi" readonly="1"/>
                                </group>
                            </group>
                        </page>
                        <page string="Claims">
                            <field name="claim_ids">
                                <list string="Claims">
                                    <field name="name"/>
                                    <field name="partner_id"/>
                                    <field name="claim_date"/>
                                    <field name="amount"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="sf_trade_program_search" model="ir.ui.view">
        <field name="name">sf.trade.program.search</field>
        <field name="model">sf.trade.program</field>
        <field name="arch" type="xml">
            <search string="Trade Programs">
                <field name="name"/>
                <field name="partner_ids"/>
                <field name="promotion_type"/>
                <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="active" string="Active" domain="[('state', '=', 'active')]"/>
                <filter name="closed" string="Closed" domain="[('state', '=', 'closed')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_promotion_type" string="Promotion Type"
                            context="{'group_by': 'promotion_type'}"/>
                    <filter name="group_company" string="Company" context="{'group_by': 'company_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_sf_trade_program" model="ir.actions.act_window">
        <field name="name">Trade Programs</field>
        <field name="res_model">sf.trade.program</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="sf_trade_program_search"/>
        <field name="context">{'search_default_active': 1}</field>
        <field name="domain">[('state', '!=', 'cancelled')]</field>
    </record>
</odoo>