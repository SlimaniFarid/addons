<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="module_category_sf_trade_promotions" model="ir.module.category">
            <field name="name">Trade Promotions</field>
            <field name="description">Trade Promotion Management (TPM).</field>
            <field name="sequence">10</field>
        </record>

        <record id="group_sf_trade_promotions_user" model="res.groups">
            <field name="name">Trade Promotions / User</field>
            <field name="category_id" ref="module_category_sf_trade_promotions"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_sf_trade_promotions_manager" model="res.groups">
            <field name="name">Trade Promotions / Manager</field>
            <field name="category_id" ref="module_category_sf_trade_promotions"/>
            <field name="implied_ids" eval="[(4, ref('sf_trade_promotions.group_sf_trade_promotions_user'))]"/>
        </record>

        <record id="rule_sf_trade_program_company" model="ir.rule">
            <field name="name">Trade Program: user sees own company</field>
            <field name="model_id" ref="model_sf_trade_program"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('sf_trade_promotions.group_sf_trade_promotions_user'))]"/>
        </record>
        <record id="rule_sf_trade_program_manager_all" model="ir.rule">
            <field name="name">Trade Program: manager sees all companies</field>
            <field name="model_id" ref="model_sf_trade_program"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('sf_trade_promotions.group_sf_trade_promotions_manager'))]"/>
        </record>

        <record id="rule_sf_trade_claim_company" model="ir.rule">
            <field name="name">Trade Claim: user sees own company</field>
            <field name="model_id" ref="model_sf_trade_claim"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('sf_trade_promotions.group_sf_trade_promotions_user'))]"/>
        </record>
        <record id="rule_sf_trade_claim_manager_all" model="ir.rule">
            <field name="name">Trade Claim: manager sees all companies</field>
            <field name="model_id" ref="model_sf_trade_claim"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('sf_trade_promotions.group_sf_trade_promotions_manager'))]"/>
        </record>
    </data>
    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_sf_trade_promotions"/>
    </record>
</odoo>