<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_trade_claim">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-set="company" t-value="o.company_id or res_company"/>
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>Trade Promotion Claim</h2>
                        <table class="table table-sm">
                            <tr><th>Claim</th><td><span t-field="o.name"/></td></tr>
                            <tr><th>Program</th><td><span t-field="o.program_id"/></td></tr>
                            <tr><th>Customer</th><td><span t-field="o.partner_id"/></td></tr>
                            <tr><th>Claim Date</th><td><span t-field="o.claim_date"/></td></tr>
                            <tr><th>Amount</th><td><span t-field="o.amount"/></td></tr>
                            <tr><th>Reason</th><td><span t-field="o.reason"/></td></tr>
                            <tr><th>Status</th><td><span t-field="o.state"/></td></tr>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>