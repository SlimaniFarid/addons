<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sf_trade_claim_list" model="ir.ui.view">
        <field name="name">sf.trade.claim.list</field>
        <field name="model">sf.trade.claim</field>
        <field name="arch" type="xml">
            <list decoration-danger="is_overdue" string="Trade Promotion Claims">
                <field name="name"/>
                <field name="program_id"/>
                <field name="partner_id"/>
                <field name="claim_date"/>
                <field name="amount"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="sf_trade_claim_form" model="ir.ui.view">
        <field name="name">sf.trade.claim.form</field>
        <field name="model">sf.trade.claim</field>
        <field name="arch" type="xml">
            <form string="Trade Promotion Claim">
                <header>
                    <button name="action_submit" string="Submit" type="object"
                            states="draft" class="btn-primary"/>
                    <button name="action_approve" string="Approve" type="object"
                            states="submitted" class="btn-primary"
                            groups="sf_trade_promotions.group_sf_trade_promotions_manager"/>
                    <button name="action_reject" string="Reject" type="object"
                            states="submitted" class="btn-secondary"
                            groups="sf_trade_promotions.group_sf_trade_promotions_manager"/>
                    <button name="action_mark_paid" string="Mark as Paid" type="object"
                            states="approved" class="btn-primary"
                            groups="sf_trade_promotions.group_sf_trade_promotions_manager"/>
                    <button name="action_cancel" string="Cancel" type="object"
                            states="draft,submitted,rejected" class="btn-secondary"
                            groups="sf_trade_promotions.group_sf_trade_promotions_manager"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,submitted,approved,paid"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="program_id"/>
                            <field name="partner_id"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="currency_id"/>
                            <field name="claim_date"/>
                            <field name="invoice_id"/>
                        </group>
                    </group>
                    <group string="Claim Details">
                        <group>
                            <field name="amount"/>
                            <field name="reason"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="sf_trade_claim_search" model="ir.ui.view">
        <field name="name">sf.trade.claim.search</field>
        <field name="model">sf.trade.claim</field>
        <field name="arch" type="xml">
            <search string="Trade Promotion Claims">
                <field name="name"/>
                <field name="program_id"/>
                <field name="partner_id"/>
                <filter name="submitted" string="Submitted"
                        domain="[('state', '=', 'submitted')]"/>
                <filter name="approved" string="Approved"
                        domain="[('state', '=', 'approved')]"/>
                <filter name="paid" string="Paid" domain="[('state', '=', 'paid')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_program" string="Program"
                            context="{'group_by': 'program_id'}"/>
                    <filter name="group_company" string="Company" context="{'group_by': 'company_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_sf_trade_claim" model="ir.actions.act_window">
        <field name="name">Trade Promotion Claims</field>
        <field name="res_model">sf.trade.claim</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="sf_trade_claim_search"/>
        <field name="domain">[('state', 'not in', ('cancelled', 'rejected'))]</field>
    </record>

    <record id="view_sf_trade_promotions_boost_kanban" model="ir.ui.view">
        <field name="name">sf_trade_promotions.boost.kanban</field>
        <field name="model">sf.trade.claim</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" t-att-color="state">
                <field name="name"/>
                <field name="state"/>
                <field name="user_id"/>
                <field name="claim_date"/>
                <field name="is_overdue" invisible="1"/>

                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_card oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title">
                                    <field name="name"/></strong>
                                <div class="o_kanban_record_subtitle">
                                    <field name="user_id" widget="many2one_avatar_user"/>
                                    <field name="claim_date"/></div>
                            </div>
                            <div class="oe_kanban_bottom_right">
                                <field name="state" widget="badge"
                                       t-attf-options="{'classes_map': {'draft': 'info', 'done': 'success', 'cancelled': 'danger'}, 'domain': []}"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_sf_trade_promotions_boost_search" model="ir.ui.view">
        <field name="name">sf_trade_promotions.boost.search</field>
        <field name="model">sf.trade.claim</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
<separator/>
                <filter string="My records" name="my_records" domain="[('user_id', '=', uid)]"/>
                <filter string="To Do" name="todo" domain="[('state', 'not in', ('done', 'cancelled', 'closed'))]"/>
                <group expand="0" string="Group By"><filter string="Status" name="gb_state" context="{'group_by': 'state'}"/></group>
            </search>
        </field>
    </record>

    <record id="wave_final_sf_trade_promotions" model="ir.actions.server">
        <field name="name">Refresh Business Data</field>
        <field name="model_id" ref="model_sf_trade_claim"/>
        <field name="binding_model_id" ref="model_sf_trade_claim"/>
        <field name="state">code</field>
        <field name="code">records.action_refresh_business()</field>
    </record>
</odoo>
