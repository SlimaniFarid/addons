<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_visitor" model="ir.module.category">
        <field name="name">Visitor Access</field>
        <field name="sequence">90</field>
    </record>

    <record id="group_visitor_user" model="res.groups">
        <field name="name">Visitor Access User</field>
        <field name="category_id" ref="module_category_visitor"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_visitor_manager" model="res.groups">
        <field name="name">Visitor Access Manager</field>
        <field name="category_id" ref="module_category_visitor"/>
        <field name="implied_ids" eval="[(4, ref('group_visitor_user'))]"/>
    </record>

    <record id="rule_visitor_visit_user_company" model="ir.rule">
        <field name="name">Visit: user sees own company</field>
        <field name="model_id" ref="model_sf_visitor_visit"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_visitor_user'))]"/>
    </record>

    <record id="rule_visitor_gate_user_company" model="ir.rule">
        <field name="name">Gate: user sees own company</field>
        <field name="model_id" ref="model_sf_visitor_gate"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_visitor_user'))]"/>
    </record>

    <record id="rule_visitor_rule_user_company" model="ir.rule">
        <field name="name">Rule: user sees own company</field>
        <field name="model_id" ref="model_sf_visitor_rule"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_visitor_user'))]"/>
    </record>

    <record id="rule_visitor_person_user_company" model="ir.rule">
        <field name="name">Person: user sees own company</field>
        <field name="model_id" ref="model_sf_visitor_person"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_visitor_user'))]"/>
    </record>

    <record id="rule_visitor_visit_manager_all" model="ir.rule">
        <field name="name">Visit: manager sees all companies</field>
        <field name="model_id" ref="model_sf_visitor_visit"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_visitor_manager'))]"/>
    </record>

    <record id="rule_visitor_gate_manager_all" model="ir.rule">
        <field name="name">Gate: manager sees all companies</field>
        <field name="model_id" ref="model_sf_visitor_gate"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_visitor_manager'))]"/>
    </record>

    <record id="rule_visitor_rule_manager_all" model="ir.rule">
        <field name="name">Rule: manager sees all companies</field>
        <field name="model_id" ref="model_sf_visitor_rule"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_visitor_manager'))]"/>
    </record>

    <record id="rule_visitor_person_manager_all" model="ir.rule">
        <field name="name">Person: manager sees all companies</field>
        <field name="model_id" ref="model_sf_visitor_person"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_visitor_manager'))]"/>
    </record>
</odoo>