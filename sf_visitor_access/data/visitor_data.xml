<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_visitor_visit" model="ir.sequence">
            <field name="name">Visitor Visit</field>
            <field name="code">sf.visitor.visit</field>
            <field name="prefix"></field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>

        <record id="seq_visitor_badge" model="ir.sequence">
            <field name="name">Visitor Badge</field>
            <field name="code">sf.visitor.badge</field>
            <field name="prefix"></field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>

        <record id="cron_visitor_overtime" model="ir.cron">
            <field name="name">Visitor Access: Overtime Alerts</field>
            <field name="model_id" ref="model_sf_visitor_visit"/>
            <field name="state">code</field>
            <field name="code">model._check_visitor_overtime()</field>
            <field name="interval_number">15</field>
            <field name="interval_type">minutes</field>
            <field name="numbercall">-1</field>
            <field name="active">True</field>
        </record>
    </data>
</odoo>