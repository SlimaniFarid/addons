<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_production_schedule_alert" model="ir.module.category">
        <field name="name">Production Schedule Variance Alert</field>
        <field name="sequence">165</field>
    </record>
    <record id="group_production_schedule_alert_user" model="res.groups">
        <field name="name">Production Schedule Variance Alert User</field>
        <field name="category_id" ref="module_category_production_schedule_alert"/>

    </record>
    <record id="group_production_schedule_alert_manager" model="res.groups">
        <field name="name">Production Schedule Variance Alert Manager</field>
        <field name="category_id" ref="module_category_production_schedule_alert"/>
        <field name="implied_ids" eval="[(4, ref('group_production_schedule_alert_user'))]"/>
    </record>
    <record id="rule_production_schedule_alert_sf_production_schedule_alert" model="ir.rule">
        <field name="name">Production Schedule Variance Alert: multi-company</field>
        <field name="model_id" ref="model_sf_production_schedule_alert"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_production_schedule_alert"/>
    </record>
</odoo>
