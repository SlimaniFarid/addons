<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_production_schedule_alert" model="ir.actions.act_window">
        <field name="name">Production Schedule Variance Alert</field>
        <field name="res_model">sf.production_schedule_alert</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
    <record id="view_sf_production_schedule_alert_form" model="ir.ui.view">
        <field name="name">sf.production_schedule_alert.form</field>
        <field name="model">sf.production_schedule_alert</field>
        <field name="arch" type="xml">
            <form string="Production Schedule Variance Alert">
                <header>
                    <button name="action_submitted" type="object" string="Submitted"
                            class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="production_id"/>
                            <field name="planned_start"/>
                            <field name="actual_start"/>
                            <field name="variance_days"/>
                            <field name="root_cause"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_production_schedule_alert_list" model="ir.ui.view">
        <field name="name">sf.production_schedule_alert.list</field>
        <field name="model">sf.production_schedule_alert</field>
        <field name="arch" type="xml">
            <list string="Production Schedule Variance Alert" sample="1">
                <field name="production_id"/>
                <field name="planned_start"/>
                <field name="actual_start"/>
                <field name="variance_days"/>
                <field name="root_cause"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state in ('submitted','approved')"/>
            </list>
        </field>
    </record>
    <record id="view_sf_production_schedule_alert_kanban" model="ir.ui.view">
        <field name="name">sf.production_schedule_alert.kanban</field>
        <field name="model">sf.production_schedule_alert</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_view" group_by="state">
                <field name="name"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <menuitem id="menu_sf_production_schedule_alert_root" name="Production Schedule Variance Alert" sequence="6"
              web_icon="sf_production_schedule_alert,static/description/icon.png"/>
    <menuitem id="menu_sf_production_schedule_alert_main" name="Records"
              parent="menu_sf_production_schedule_alert_root" action="action_sf_production_schedule_alert" sequence="10"/>

    <record id="wave_final_sf_production_schedule_alert" model="ir.actions.server">
        <field name="name">Refresh Business Data</field>
        <field name="model_id" ref="model_sf_production_schedule_alert"/>
        <field name="binding_model_id" ref="model_sf_production_schedule_alert"/>
        <field name="state">code</field>
        <field name="code">records.action_refresh_business()</field>
    </record>
</odoo>
