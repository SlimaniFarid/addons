<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_quality_inspection_planner" model="ir.module.category">
        <field name="name">Quality Inspection Planner</field>
        <field name="sequence">275</field>
    </record>
    <record id="group_quality_inspection_planner_user" model="res.groups">
        <field name="name">Quality Inspection Planner User</field>
        <field name="category_id" ref="module_category_quality_inspection_planner"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>

    </record>
    <record id="group_quality_inspection_planner_manager" model="res.groups">
        <field name="name">Quality Inspection Planner Manager</field>
        <field name="category_id" ref="module_category_quality_inspection_planner"/>
        <field name="implied_ids" eval="[(4, ref('group_quality_inspection_planner_user'))]"/>
    </record>
    <record id="rule_quality_inspection_planner_sf_quality_inspection_planner" model="ir.rule">
        <field name="name">Quality Inspection Planner: multi-company</field>
        <field name="model_id" ref="model_sf_quality_inspection_planner"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_quality_inspection_planner"/>
    </record>
</odoo>
