<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_tooling_request" model="ir.actions.act_window">
        <field name="name">Tooling Request &amp; Preparation</field>
        <field name="res_model">sf.tooling.request</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
    <record id="view_sf_tooling_request_form" model="ir.ui.view">
        <field name="name">sf.tooling.request.form</field>
        <field name="model">sf.tooling.request</field>
        <field name="arch" type="xml">
            <form string="Tooling Request &amp; Preparation">
                <header>
                    <button name="action_preparing" type="object" string="Preparing"
                            class="btn-primary"/>
                    <button name="action_ready" type="object" string="Ready"
                            class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="requested,preparing,ready,delayed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="production_id"/>
                            <field name="tools_needed"/>
                            <field name="needed_for_date"/>
                            <field name="readiness"/>
                            <field name="notes"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_tooling_request_list" model="ir.ui.view">
        <field name="name">sf.tooling.request.list</field>
        <field name="model">sf.tooling.request</field>
        <field name="arch" type="xml">
            <list string="Tooling Request &amp; Preparation" sample="1">
                <field name="production_id"/>
                <field name="tools_needed"/>
                <field name="needed_for_date"/>
                <field name="readiness"/>
                <field name="notes"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state in ('submitted','approved')"/>
            </list>
        </field>
    </record>
    <record id="view_sf_tooling_request_kanban" model="ir.ui.view">
        <field name="name">sf.tooling.request.kanban</field>
        <field name="model">sf.tooling.request</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_view" group_by="state">
                <field name="name"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <menuitem id="menu_sf_tooling_request_root" name="Tooling Request &amp; Preparation" sequence="25"
              web_icon="sf_tooling_request,static/description/icon.png"/>
    <menuitem id="menu_sf_tooling_request_main" name="Records"
              parent="menu_sf_tooling_request_root" action="action_sf_tooling_request" sequence="10"/>
</odoo>
