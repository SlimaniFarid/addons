<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_tooling_request" model="ir.module.category">
        <field name="name">Tooling Request &amp; Preparation</field>
        <field name="sequence">20</field>
    </record>
    <record id="group_tooling_request_user" model="res.groups">
        <field name="name">Tooling Request &amp; Preparation User</field>
        <field name="category_id" ref="module_category_tooling_request"/>
        <field name="implied_ids" eval="[(4, ref('mrp.group_mrp_user'))]"/>

    </record>
    <record id="group_tooling_request_manager" model="res.groups">
        <field name="name">Tooling Request &amp; Preparation Manager</field>
        <field name="category_id" ref="module_category_tooling_request"/>
        <field name="implied_ids" eval="[(4, ref('group_tooling_request_user'))]"/>
    </record>
    <record id="rule_tooling_request_sf_tooling_request" model="ir.rule">
        <field name="name">Tooling Request: multi-company</field>
        <field name="model_id" ref="model_sf_tooling_request"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
