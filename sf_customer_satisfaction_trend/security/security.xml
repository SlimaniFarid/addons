<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_customer_satisfaction_trend" model="ir.module.category">
        <field name="name">CSAT Trend Monitor</field>
        <field name="sequence">174</field>
    </record>
    <record id="group_customer_satisfaction_trend_user" model="res.groups">
        <field name="name">CSAT Trend Monitor User</field>
        <field name="category_id" ref="module_category_customer_satisfaction_trend"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>

    </record>
    <record id="group_customer_satisfaction_trend_manager" model="res.groups">
        <field name="name">CSAT Trend Monitor Manager</field>
        <field name="category_id" ref="module_category_customer_satisfaction_trend"/>
        <field name="implied_ids" eval="[(4, ref('group_customer_satisfaction_trend_user'))]"/>
    </record>
    <record id="rule_customer_satisfaction_trend_sf_customer_satisfaction_trend" model="ir.rule">
        <field name="name">CSAT Trend Monitor: multi-company</field>
        <field name="model_id" ref="model_sf_customer_satisfaction_trend"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_customer_satisfaction_trend"/>
    </record>
</odoo>
