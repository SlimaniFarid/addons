<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_aging_analysis" model="ir.actions.act_window">
        <field name="name">Aging Analyses</field>
        <field name="res_model">sf.aging.analysis</field>
        <field name="view_mode">kanban,list,form</field>
    </record>
    <record id="view_sf_aging_analysis_form" model="ir.ui.view">
        <field name="name">sf.aging.analysis.form</field>
        <field name="model">sf.aging.analysis</field>
        <field name="arch" type="xml">
            <form string="Inventory Aging">
                <header>
                    <button name="action_compute" type="object"
                            string="Compute" class="btn-primary"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,computed"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="as_of_date"/>
                            <field name="warehouse_id"/>
                        </group>
                        <group>
                            <field name="b1_percent"/>
                            <field name="b2_percent"/>
                            <field name="b3_percent"/>
                            <field name="b4_percent"/>
                        </group>
                        <group>
                            <field name="total_value" readonly="1"/>
                            <field name="total_provision" readonly="1"/>
                            <field name="dead_stock_count" readonly="1"/>
                        </group>
                    </group>
                    <field name="line_ids" readonly="1"
                           decoration-danger="aging_bucket == 'b4'">
                        <list create="0">
                            <field name="product_id"/>
                            <field name="lot_id" optional="show"/>
                            <field name="quantity"/>
                            <field name="stock_value"/>
                            <field name="last_movement"/>
                            <field name="aging_days"/>
                            <field name="aging_bucket"/>
                            <field name="provision_percent"/>
                            <field name="provision_amount"/>
                        </list>
                    </field>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_aging_analysis_list" model="ir.ui.view">
        <field name="name">sf.aging.analysis.list</field>
        <field name="model">sf.aging.analysis</field>
        <field name="arch" type="xml">
            <list string="Aging Analyses" sample="1">
                <field name="name"/>
                <field name="as_of_date"/>
                <field name="warehouse_id"/>
                <field name="total_value"/>
                <field name="total_provision"/>
                <field name="dead_stock_count"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'computed'"/>
            </list>
        </field>
    </record>
    <menuitem id="menu_sf_aging_root" name="Inventory Aging" sequence="30"
              parent="stock.menu_stock_root"/>
    <menuitem id="menu_sf_aging_analyses" name="Aging Analyses"
              parent="menu_sf_aging_root" action="action_sf_aging_analysis"
              sequence="10"/>

    <record id="view_sf_inventory_aging_boost_kanban" model="ir.ui.view">
        <field name="name">sf_inventory_aging.boost.kanban</field>
        <field name="model">sf.aging.analysis</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" t-att-color="state">
                <field name="name"/>
                <field name="state"/>
                <field name="user_id"/>

                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_card oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title">
                                    <field name="name"/></strong>
                                <div class="o_kanban_record_subtitle">
                                    <field name="user_id" widget="many2one_avatar_user"/>
                                    <field name="create_date"/></div>
                            </div>
                            <div class="oe_kanban_bottom_right">
                                <field name="state" widget="badge"
                                       t-attf-options="{'classes_map': {'draft': 'info', 'done': 'success', 'cancelled': 'danger'}, 'domain': []}"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_sf_inventory_aging_boost_search" model="ir.ui.view">
        <field name="name">sf_inventory_aging.boost.search</field>
        <field name="model">sf.aging.analysis</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
<separator/>
                <filter string="My records" name="my_records" domain="[('user_id', '=', uid)]"/>
                <filter string="To Do" name="todo" domain="[('state', 'not in', ('done', 'cancelled', 'closed'))]"/>
                <group expand="0" string="Group By"><filter string="Status" name="gb_state" context="{'group_by': 'state'}"/></group>
            </search>
        </field>
    </record>

    <record id="wave_final_sf_inventory_aging" model="ir.actions.server">
        <field name="name">Refresh Business Data</field>
        <field name="model_id" ref="model_sf_aging_analysis"/>
        <field name="binding_model_id" ref="model_sf_aging_analysis"/>
        <field name="state">code</field>
        <field name="code">records.action_refresh_business()</field>
    </record>
</odoo>
