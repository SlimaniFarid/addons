<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_sf_aging" model="ir.module.category">
        <field name="name">Inventory Aging</field>
        <field name="sequence">80</field>
    </record>
    <record id="group_sf_aging_user" model="res.groups">
        <field name="name">Inventory Aging User</field>
        <field name="category_id" ref="module_category_sf_aging"/>
        <field name="implied_ids" eval="[(4, ref('stock.group_stock_user'))]"/>
    </record>
    <record id="group_sf_aging_manager" model="res.groups">
        <field name="name">Inventory Aging Manager</field>
        <field name="category_id" ref="module_category_sf_aging"/>
        <field name="implied_ids" eval="[(4, ref('group_sf_aging_user'))]"/>
    </record>
    <record id="rule_sf_aging_company" model="ir.rule">
        <field name="name">Aging Analysis: multi-company</field>
        <field name="model_id" ref="model_sf_aging_analysis"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
