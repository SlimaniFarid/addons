<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_freight_quote_compare" model="ir.module.category">
        <field name="name">Freight Quote Comparison</field>
        <field name="sequence">36</field>
    </record>
    <record id="group_freight_quote_compare_user" model="res.groups">
        <field name="name">Freight Quote Comparison User</field>
        <field name="category_id" ref="module_category_freight_quote_compare"/>
        <field name="implied_ids" eval="[(4, ref('stock.group_stock_user'))]"/>

    </record>
    <record id="group_freight_quote_compare_manager" model="res.groups">
        <field name="name">Freight Quote Comparison Manager</field>
        <field name="category_id" ref="module_category_freight_quote_compare"/>
        <field name="implied_ids" eval="[(4, ref('group_freight_quote_compare_user'))]"/>
    </record>
    <record id="rule_freight_quote_compare_sf_freight_quote" model="ir.rule">
        <field name="name">Freight Quote Comparison: multi-company</field>
        <field name="model_id" ref="model_sf_freight_quote"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_freight_quote_compare"/>
    </record>
</odoo>
