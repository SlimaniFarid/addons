<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_freight_quote" model="ir.actions.act_window">
        <field name="name">Freight Quote Comparison</field>
        <field name="res_model">sf.freight.quote</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
    <record id="view_sf_freight_quote_form" model="ir.ui.view">
        <field name="name">sf.freight.quote.form</field>
        <field name="model">sf.freight.quote</field>
        <field name="arch" type="xml">
            <form string="Freight Quote Comparison">
                <header>
                    <button name="action_awarded" type="object" string="Awarded"
                            class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="received,awarded,lost"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="shipment_ref"/>
                            <field name="carrier_id"/>
                            <field name="base_cost"/>
                            <field name="surcharges"/>
                            <field name="transit_days"/>
                            <field name="total_cost"/>
                            <field name="awarded"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_freight_quote_list" model="ir.ui.view">
        <field name="name">sf.freight.quote.list</field>
        <field name="model">sf.freight.quote</field>
        <field name="arch" type="xml">
            <list string="Freight Quote Comparison" sample="1">
                <field name="shipment_ref"/>
                <field name="carrier_id"/>
                <field name="base_cost"/>
                <field name="surcharges"/>
                <field name="transit_days"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state in ('submitted','approved')"/>
            </list>
        </field>
    </record>
    <record id="view_sf_freight_quote_kanban" model="ir.ui.view">
        <field name="name">sf.freight.quote.kanban</field>
        <field name="model">sf.freight.quote</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_view" group_by="state">
                <field name="name"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <menuitem id="menu_sf_freight_quote_root" name="Freight Quote Comparison" sequence="14"
              web_icon="sf_freight_quote_compare,static/description/icon.png"/>
    <menuitem id="menu_sf_freight_quote_main" name="Records"
              parent="menu_sf_freight_quote_root" action="action_sf_freight_quote" sequence="10"/>

    <record id="wave_final_sf_freight_quote_compare" model="ir.actions.server">
        <field name="name">Refresh Business Data</field>
        <field name="model_id" ref="model_sf_freight_quote"/>
        <field name="binding_model_id" ref="model_sf_freight_quote"/>
        <field name="state">code</field>
        <field name="code">records.action_refresh_business()</field>
    </record>
</odoo>
