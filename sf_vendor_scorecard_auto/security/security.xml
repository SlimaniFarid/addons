<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_vendor_scorecard_auto" model="ir.module.category">
        <field name="name">Automated Vendor Scorecard</field>
        <field name="sequence">166</field>
    </record>
    <record id="group_vendor_scorecard_auto_user" model="res.groups">
        <field name="name">Automated Vendor Scorecard User</field>
        <field name="category_id" ref="module_category_vendor_scorecard_auto"/>

    </record>
    <record id="group_vendor_scorecard_auto_manager" model="res.groups">
        <field name="name">Automated Vendor Scorecard Manager</field>
        <field name="category_id" ref="module_category_vendor_scorecard_auto"/>
        <field name="implied_ids" eval="[(4, ref('group_vendor_scorecard_auto_user'))]"/>
    </record>
    <record id="rule_vendor_scorecard_auto_sf_vendor_scorecard_auto" model="ir.rule">
        <field name="name">Automated Vendor Scorecard: multi-company</field>
        <field name="model_id" ref="model_sf_vendor_scorecard_auto"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_vendor_scorecard_auto"/>
    </record>
</odoo>
