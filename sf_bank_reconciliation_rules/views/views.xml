<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_brec_rule" model="ir.actions.act_window">
        <field name="name">Bank Reconciliation Rule Builder</field>
        <field name="res_model">sf.brec.rule</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
    <record id="view_sf_brec_rule_form" model="ir.ui.view">
        <field name="name">sf.brec.rule.form</field>
        <field name="model">sf.brec.rule</field>
        <field name="arch" type="xml">
            <form string="Bank Reconciliation Rule Builder">
                <header>
                    <button name="action_active" type="object" string="Active"
                            class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,active,archived"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="match_label"/>
                            <field name="amount_min"/>
                            <field name="amount_max"/>
                            <field name="priority"/>
                            <field name="partner_id"/>
                            <field name="notes"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_brec_rule_list" model="ir.ui.view">
        <field name="name">sf.brec.rule.list</field>
        <field name="model">sf.brec.rule</field>
        <field name="arch" type="xml">
            <list string="Bank Reconciliation Rule Builder" sample="1">
                <field name="name"/>
                <field name="match_label"/>
                <field name="amount_min"/>
                <field name="amount_max"/>
                <field name="priority"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state in ('submitted','approved')"/>
            </list>
        </field>
    </record>
    <record id="view_sf_brec_rule_kanban" model="ir.ui.view">
        <field name="name">sf.brec.rule.kanban</field>
        <field name="model">sf.brec.rule</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_view" group_by="state">
                <field name="name"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <menuitem id="menu_sf_brec_rule_root" name="Bank Reconciliation Rule Builder" sequence="14"
              web_icon="sf_bank_reconciliation_rules,static/description/icon.png"/>
    <menuitem id="menu_sf_brec_rule_main" name="Records"
              parent="menu_sf_brec_rule_root" action="action_sf_brec_rule" sequence="10"/>

    <record id="wave_final_sf_bank_reconciliation_rules" model="ir.actions.server">
        <field name="name">Refresh Business Data</field>
        <field name="model_id" ref="model_sf_brec_rule"/>
        <field name="binding_model_id" ref="model_sf_brec_rule"/>
        <field name="state">code</field>
        <field name="code">records.action_refresh_business()</field>
    </record>
</odoo>
