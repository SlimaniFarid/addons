<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_bank_reconciliation_rules" model="ir.module.category">
        <field name="name">Bank Reconciliation Rule Builder</field>
        <field name="sequence">64</field>
    </record>
    <record id="group_bank_reconciliation_rules_user" model="res.groups">
        <field name="name">Bank Reconciliation Rule Builder User</field>
        <field name="category_id" ref="module_category_bank_reconciliation_rules"/>

    </record>
    <record id="group_bank_reconciliation_rules_manager" model="res.groups">
        <field name="name">Bank Reconciliation Rule Builder Manager</field>
        <field name="category_id" ref="module_category_bank_reconciliation_rules"/>
        <field name="implied_ids" eval="[(4, ref('group_bank_reconciliation_rules_user'))]"/>
    </record>
    <record id="rule_bank_reconciliation_rules_sf_brec_rule" model="ir.rule">
        <field name="name">Reconciliation Rule: multi-company</field>
        <field name="model_id" ref="model_sf_brec_rule"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
