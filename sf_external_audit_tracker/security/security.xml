<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_external_audit_tracker" model="ir.module.category">
        <field name="name">External Audit Finding Tracker</field>
        <field name="sequence">58</field>
    </record>
    <record id="group_external_audit_tracker_user" model="res.groups">
        <field name="name">External Audit Finding Tracker User</field>
        <field name="category_id" ref="module_category_external_audit_tracker"/>

    </record>
    <record id="group_external_audit_tracker_manager" model="res.groups">
        <field name="name">External Audit Finding Tracker Manager</field>
        <field name="category_id" ref="module_category_external_audit_tracker"/>
        <field name="implied_ids" eval="[(4, ref('group_external_audit_tracker_user'))]"/>
    </record>
    <record id="rule_external_audit_tracker_sf_audit_finding" model="ir.rule">
        <field name="name">Audit Finding: multi-company</field>
        <field name="model_id" ref="model_sf_audit_finding"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
