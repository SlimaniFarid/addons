<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_supplier_negotiation_prep" model="ir.actions.act_window">
        <field name="name">Supplier Negotiation Prep</field>
        <field name="res_model">sf.supplier_negotiation_prep</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
    <record id="view_sf_supplier_negotiation_prep_form" model="ir.ui.view">
        <field name="name">sf.supplier_negotiation_prep.form</field>
        <field name="model">sf.supplier_negotiation_prep</field>
        <field name="arch" type="xml">
            <form string="Supplier Negotiation Prep">
                <header>
                    <button name="action_submitted" type="object" string="Submitted"
                            class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="vendor_id"/>
                            <field name="negotiation_date"/>
                        <field name="leverage_points"/>
                            <field name="target_outcome"/>
                            <field name="batna"/>
                            <field name="negotiator_id"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_supplier_negotiation_prep_list" model="ir.ui.view">
        <field name="name">sf.supplier_negotiation_prep.list</field>
        <field name="model">sf.supplier_negotiation_prep</field>
        <field name="arch" type="xml">
            <list string="Supplier Negotiation Prep" sample="1">
                <field name="vendor_id"/>
                <field name="negotiation_date"/>
                <field name="leverage_points"/>
                <field name="target_outcome"/>
                <field name="batna"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state in ('submitted','approved')"/>
            </list>
        </field>
    </record>
    <record id="view_sf_supplier_negotiation_prep_kanban" model="ir.ui.view">
        <field name="name">sf.supplier_negotiation_prep.kanban</field>
        <field name="model">sf.supplier_negotiation_prep</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_view" group_by="state">
                <field name="name"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <menuitem id="menu_sf_supplier_negotiation_prep_root" name="Supplier Negotiation Prep" sequence="26"
              web_icon="sf_supplier_negotiation_prep,static/description/icon.png"/>
    <menuitem id="menu_sf_supplier_negotiation_prep_main" name="Records"
              parent="menu_sf_supplier_negotiation_prep_root" action="action_sf_supplier_negotiation_prep" sequence="10"/>

    <record id="wave_final_sf_supplier_negotiation_prep" model="ir.actions.server">
        <field name="name">Refresh Business Data</field>
        <field name="model_id" ref="model_sf_supplier_negotiation_prep"/>
        <field name="binding_model_id" ref="model_sf_supplier_negotiation_prep"/>
        <field name="state">code</field>
        <field name="code">records.action_refresh_business()</field>
    </record>
</odoo>
