<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_supplier_negotiation_prep" model="ir.module.category">
        <field name="name">Supplier Negotiation Prep</field>
        <field name="sequence">475</field>
    </record>
    <record id="group_supplier_negotiation_prep_user" model="res.groups">
        <field name="name">Supplier Negotiation Prep User</field>
        <field name="category_id" ref="module_category_supplier_negotiation_prep"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>

    </record>
    <record id="group_supplier_negotiation_prep_manager" model="res.groups">
        <field name="name">Supplier Negotiation Prep Manager</field>
        <field name="category_id" ref="module_category_supplier_negotiation_prep"/>
        <field name="implied_ids" eval="[(4, ref('group_supplier_negotiation_prep_user'))]"/>
    </record>
    <record id="rule_supplier_negotiation_prep_sf_supplier_negotiation_prep" model="ir.rule">
        <field name="name">Supplier Negotiation Prep: multi-company</field>
        <field name="model_id" ref="model_sf_supplier_negotiation_prep"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_supplier_negotiation_prep"/>
    </record>
</odoo>
