<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_medical_patient" model="ir.sequence">
            <field name="name">Medical Patient</field>
            <field name="code">sf.medical.patient</field>
            <field name="prefix">PAT-</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>

        <record id="seq_medical_appointment" model="ir.sequence">
            <field name="name">Medical Appointment</field>
            <field name="code">sf.medical.appointment</field>
            <field name="prefix">APT-</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>

        <record id="seq_medical_consultation" model="ir.sequence">
            <field name="name">Medical Consultation</field>
            <field name="code">sf.medical.consultation</field>
            <field name="prefix">CNS-</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>

        <record id="seq_medical_prescription" model="ir.sequence">
            <field name="name">Medical Prescription</field>
            <field name="code">sf.medical.prescription</field>
            <field name="prefix">PRS-</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>

        <record id="seq_medical_vital" model="ir.sequence">
            <field name="name">Medical Vital Signs</field>
            <field name="code">sf.medical.vital</field>
            <field name="prefix">VTL-</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>

        <record id="cron_medical_appointment_reminder" model="ir.cron">
            <field name="name">Medical Practice: Appointment Reminders</field>
            <field name="model_id" ref="model_sf_medical_appointment"/>
            <field name="state">code</field>
            <field name="code">model._check_appointment_reminders()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="active">True</field>
        </record>
    </data>
</odoo>