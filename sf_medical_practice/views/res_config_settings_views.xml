<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_medical" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.medical</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app string="Medical Practice" name="medical_practice">
                    <block title="Appointments">
                        <setting string="Appointment reminder alert (days)"
                                 help="Number of days before an appointment on which an unconfirmed appointment triggers a reminder activity.">
                            <field name="sf_medical_alert_days"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>