<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_medical" model="ir.module.category">
        <field name="name">Medical Practice</field>
        <field name="sequence">90</field>
    </record>

    <record id="group_sf_medical_user" model="res.groups">
        <field name="name">Medical Practice / User</field>
        <field name="category_id" ref="module_category_medical"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_sf_medical_manager" model="res.groups">
        <field name="name">Medical Practice / Manager</field>
        <field name="category_id" ref="module_category_medical"/>
        <field name="implied_ids" eval="[(4, ref('group_sf_medical_user'))]"/>
    </record>

    <record id="rule_medical_patient_user_company" model="ir.rule">
        <field name="name">Patient: user sees own company</field>
        <field name="model_id" ref="model_sf_medical_patient"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_sf_medical_user'))]"/>
    </record>

    <record id="rule_medical_appointment_user_company" model="ir.rule">
        <field name="name">Appointment: user sees own company</field>
        <field name="model_id" ref="model_sf_medical_appointment"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_sf_medical_user'))]"/>
    </record>

    <record id="rule_medical_consultation_user_company" model="ir.rule">
        <field name="name">Consultation: user sees own company</field>
        <field name="model_id" ref="model_sf_medical_consultation"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_sf_medical_user'))]"/>
    </record>

    <record id="rule_medical_prescription_user_company" model="ir.rule">
        <field name="name">Prescription: user sees own company</field>
        <field name="model_id" ref="model_sf_medical_prescription"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_sf_medical_user'))]"/>
    </record>

    <record id="rule_medical_vital_user_company" model="ir.rule">
        <field name="name">Vital: user sees own company</field>
        <field name="model_id" ref="model_sf_medical_vital"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_sf_medical_user'))]"/>
    </record>

    <record id="rule_medical_patient_manager_all" model="ir.rule">
        <field name="name">Patient: manager sees all companies</field>
        <field name="model_id" ref="model_sf_medical_patient"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_sf_medical_manager'))]"/>
    </record>

    <record id="rule_medical_appointment_manager_all" model="ir.rule">
        <field name="name">Appointment: manager sees all companies</field>
        <field name="model_id" ref="model_sf_medical_appointment"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_sf_medical_manager'))]"/>
    </record>

    <record id="rule_medical_consultation_manager_all" model="ir.rule">
        <field name="name">Consultation: manager sees all companies</field>
        <field name="model_id" ref="model_sf_medical_consultation"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_sf_medical_manager'))]"/>
    </record>

    <record id="rule_medical_prescription_manager_all" model="ir.rule">
        <field name="name">Prescription: manager sees all companies</field>
        <field name="model_id" ref="model_sf_medical_prescription"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_sf_medical_manager'))]"/>
    </record>

    <record id="rule_medical_vital_manager_all" model="ir.rule">
        <field name="name">Vital: manager sees all companies</field>
        <field name="model_id" ref="model_sf_medical_vital"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_sf_medical_manager'))]"/>
    </record>
    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_medical"/>
    </record>
</odoo>