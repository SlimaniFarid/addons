<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="report_medical_patient_file" model="ir.actions.report">
        <field name="name">Patient File</field>
        <field name="model">sf.medical.patient</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">sf_medical_practice.patient_file_template</field>
        <field name="report_file">sf_medical_practice.patient_file_template</field>
        <field name="binding_model_id" ref="model_sf_medical_patient"/>
        <field name="binding_type">report</field>
    </record>

    <template id="patient_file_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>Patient File</h2>
                        <table class="table table-sm">
                            <tr><td><strong>Patient number</strong></td><td><t t-esc="o.name"/></td></tr>
                            <tr><td><strong>Name</strong></td><td><t t-esc="o.full_name"/></td></tr>
                            <tr><td><strong>Date of birth</strong></td><td><t t-esc="o.dob or ''"/></td></tr>
                            <tr><td><strong>Gender</strong></td><td><t t-esc="o.gender or ''"/></td></tr>
                            <tr><td><strong>Blood type</strong></td><td><t t-esc="o.blood_type or ''"/></td></tr>
                            <tr><td><strong>Phone</strong></td><td><t t-esc="o.phone or ''"/></td></tr>
                            <tr><td><strong>Email</strong></td><td><t t-esc="o.email or ''"/></td></tr>
                            <tr><td><strong>Insurance</strong></td><td><t t-esc="o.insurance or ''"/></td></tr>
                            <tr><td><strong>Allergies</strong></td><td><t t-esc="o.allergies or ''"/></td></tr>
                        </table>
                        <h4>Consultations</h4>
                        <table class="table table-sm">
                            <tr><th>Number</th><th>Date</th><th>Practitioner</th><th>Diagnosis</th><th>State</th></tr>
                            <t t-foreach="o.consultation_ids" t-as="consultation">
                                <tr>
                                    <td><t t-esc="consultation.name"/></td>
                                    <td><t t-esc="consultation.date or ''"/></td>
                                    <td><t t-esc="consultation.practitioner_id.name"/></td>
                                    <td><t t-esc="consultation.diagnosis or ''"/></td>
                                    <td><t t-esc="consultation.state"/></td>
                                </tr>
                            </t>
                        </table>
                        <h4>Prescriptions</h4>
                        <table class="table table-sm">
                            <tr><th>Number</th><th>Medication</th><th>Dosage</th><th>Duration</th><th>State</th></tr>
                            <t t-foreach="o.consultation_ids.mapped('prescription_ids')" t-as="prescription">
                                <tr>
                                    <td><t t-esc="prescription.name"/></td>
                                    <td><t t-esc="prescription.medication"/></td>
                                    <td><t t-esc="prescription.dosage or ''"/></td>
                                    <td><t t-esc="prescription.duration_days or ''"/></td>
                                    <td><t t-esc="prescription.state"/></td>
                                </tr>
                            </t>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <record id="report_medical_ordonnance" model="ir.actions.report">
        <field name="name">Prescription</field>
        <field name="model">sf.medical.prescription</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">sf_medical_practice.ordonnance_template</field>
        <field name="report_file">sf_medical_practice.ordonnance_template</field>
        <field name="binding_model_id" ref="model_sf_medical_prescription"/>
        <field name="binding_type">report</field>
    </record>

    <template id="ordonnance_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>Prescription</h2>
                        <table class="table table-sm">
                            <tr><td><strong>Prescription</strong></td><td><t t-esc="o.name"/></td></tr>
                            <tr><td><strong>Patient</strong></td><td><t t-esc="o.patient_id.full_name"/></td></tr>
                            <tr><td><strong>Consultation</strong></td><td><t t-esc="o.consultation_id.name"/></td></tr>
                            <tr><td><strong>Medication</strong></td><td><t t-esc="o.medication"/></td></tr>
                            <tr><td><strong>Dosage</strong></td><td><t t-esc="o.dosage or ''"/></td></tr>
                            <tr><td><strong>Duration (days)</strong></td><td><t t-esc="o.duration_days or ''"/></td></tr>
                            <tr><td><strong>State</strong></td><td><t t-esc="o.state"/></td></tr>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>