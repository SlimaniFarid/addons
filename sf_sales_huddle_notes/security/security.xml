<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_sales_huddle_notes" model="ir.module.category">
        <field name="name">Daily Sales Huddle Notes</field>
        <field name="sequence">694</field>
    </record>
    <record id="group_sales_huddle_notes_user" model="res.groups">
        <field name="name">Daily Sales Huddle Notes User</field>
        <field name="category_id" ref="module_category_sales_huddle_notes"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>

    </record>
    <record id="group_sales_huddle_notes_manager" model="res.groups">
        <field name="name">Daily Sales Huddle Notes Manager</field>
        <field name="category_id" ref="module_category_sales_huddle_notes"/>
        <field name="implied_ids" eval="[(4, ref('group_sales_huddle_notes_user'))]"/>
    </record>
    <record id="rule_sales_huddle_notes_sf_sales_huddle_notes" model="ir.rule">
        <field name="name">Daily Sales Huddle Notes: multi-company</field>
        <field name="model_id" ref="model_sf_sales_huddle_notes"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_sales_huddle_notes"/>
    </record>
</odoo>
