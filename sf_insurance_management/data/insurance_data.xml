<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_insurance_company" model="ir.sequence">
            <field name="name">Insurance Company</field>
            <field name="code">sf.insurance.company</field>
            <field name="prefix">INS-</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>

        <record id="seq_insurance_policy" model="ir.sequence">
            <field name="name">Insurance Policy</field>
            <field name="code">sf.insurance.policy</field>
            <field name="prefix">POL-</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>

        <record id="seq_insurance_claim" model="ir.sequence">
            <field name="name">Insurance Claim</field>
            <field name="code">sf.insurance.claim</field>
            <field name="prefix">CLA-</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>

        <record id="cron_insurance_check_policies" model="ir.cron">
            <field name="name">Insurance Management: Check Policies &amp; Claims</field>
            <field name="model_id" ref="model_sf_insurance_policy"/>
            <field name="state">code</field>
            <field name="code">model._check_policies()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="active">True</field>
        </record>
    </data>
</odoo>
