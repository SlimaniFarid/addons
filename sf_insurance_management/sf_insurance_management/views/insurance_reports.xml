<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="report_insurance_program" model="ir.actions.report">
        <field name="name">Insurance Program</field>
        <field name="model">sf.insurance.policy</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">sf_insurance_management.insurance_program_template</field>
        <field name="report_file">sf_insurance_management.insurance_program_template</field>
        <field name="binding_model_id" ref="model_sf_insurance_policy"/>
        <field name="binding_type">report</field>
    </record>

    <template id="insurance_program_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>Insurance Program</h2>
                        <p>
                            Company: <strong><t t-esc="o.company_id.name"/></strong>
                        </p>
                        <table class="table table-sm">
                            <tr><td><strong>Policy</strong></td><td><t t-esc="o.name"/></td></tr>
                            <tr><td><strong>Policy number</strong></td><td><t t-esc="o.policy_number or ''"/></td></tr>
                            <tr><td><strong>Insurer</strong></td><td><t t-esc="o.insurer_id.name"/></td></tr>
                            <tr><td><strong>Type</strong></td><td><t t-esc="o.policy_type"/></td></tr>
                            <tr><td><strong>Start date</strong></td><td><t t-esc="o.start_date or ''"/></td></tr>
                            <tr><td><strong>End date</strong></td><td><t t-esc="o.end_date or ''"/></td></tr>
                            <tr><td><strong>Premium amount</strong></td><td><t t-esc="o.premium_amount"/></td></tr>
                            <tr><td><strong>Premium frequency</strong></td><td><t t-esc="o.premium_frequency"/></td></tr>
                            <tr><td><strong>Status</strong></td><td><t t-esc="o.state"/></td></tr>
                        </table>
                        <t t-if="o.guarantee_ids">
                            <h4>Guarantees</h4>
                            <table class="table table-sm">
                                <thead>
                                    <tr>
                                        <th>Guarantee</th>
                                        <th>Type</th>
                                        <th>Coverage</th>
                                        <th>Deductible</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="o.guarantee_ids" t-as="g">
                                        <tr>
                                            <td><t t-esc="g.name"/></td>
                                            <td><t t-esc="g.guarantee_type or ''"/></td>
                                            <td><t t-esc="g.coverage_amount"/></td>
                                            <td><t t-esc="g.deductible"/></td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </t>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <record id="report_insurance_claims" model="ir.actions.report">
        <field name="name">Claims Report</field>
        <field name="model">sf.insurance.claim</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">sf_insurance_management.claims_report_template</field>
        <field name="report_file">sf_insurance_management.claims_report_template</field>
        <field name="binding_model_id" ref="model_sf_insurance_claim"/>
        <field name="binding_type">report</field>
    </record>

    <template id="claims_report_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>Claims Report</h2>
                        <table class="table table-sm">
                            <tr><td><strong>Claim</strong></td><td><t t-esc="o.name"/></td></tr>
                            <tr><td><strong>Claim number</strong></td><td><t t-esc="o.claim_number or ''"/></td></tr>
                            <tr><td><strong>Policy</strong></td><td><t t-esc="o.policy_id.name"/></td></tr>
                            <tr><td><strong>Insurer</strong></td><td><t t-esc="o.policy_id.insurer_id.name"/></td></tr>
                            <tr><td><strong>Date occurred</strong></td><td><t t-esc="o.date_occurred or ''"/></td></tr>
                            <tr><td><strong>Date notified</strong></td><td><t t-esc="o.date_notified or ''"/></td></tr>
                            <tr><td><strong>Status</strong></td><td><t t-esc="o.state"/></td></tr>
                            <tr><td><strong>Estimated amount</strong></td><td><t t-esc="o.estimated_amount"/></td></tr>
                            <tr><td><strong>Settlement amount</strong></td><td><t t-esc="o.settlement_amount"/></td></tr>
                            <tr><td><strong>Closed date</strong></td><td><t t-esc="o.closed_date or ''"/></td></tr>
                        </table>
                        <t t-if="o.description">
                            <h4>Description</h4>
                            <p><t t-esc="o.description"/></p>
                        </t>
                        <t t-if="o.notes">
                            <h4>Notes</h4>
                            <p><t t-esc="o.notes"/></p>
                        </t>
                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>