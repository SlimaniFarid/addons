<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_insurance" model="ir.module.category">
        <field name="name">Insurance Management</field>
        <field name="sequence">90</field>
    </record>

    <record id="group_insurance_user" model="res.groups">
        <field name="name">Insurance Management User</field>
        <field name="category_id" ref="module_category_insurance"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_insurance_manager" model="res.groups">
        <field name="name">Insurance Management Manager</field>
        <field name="category_id" ref="module_category_insurance"/>
        <field name="implied_ids" eval="[(4, ref('group_insurance_user'))]"/>
    </record>

    <record id="rule_insurance_company_user_company" model="ir.rule">
        <field name="name">Insurance Company: user sees own company</field>
        <field name="model_id" ref="model_sf_insurance_company"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_insurance_user'))]"/>
    </record>

    <record id="rule_insurance_policy_user_company" model="ir.rule">
        <field name="name">Policy: user sees own company</field>
        <field name="model_id" ref="model_sf_insurance_policy"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_insurance_user'))]"/>
    </record>

    <record id="rule_insurance_guarantee_user_company" model="ir.rule">
        <field name="name">Guarantee: user sees own company</field>
        <field name="model_id" ref="model_sf_insurance_guarantee"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_insurance_user'))]"/>
    </record>

    <record id="rule_insurance_claim_user_company" model="ir.rule">
        <field name="name">Claim: user sees own company</field>
        <field name="model_id" ref="model_sf_insurance_claim"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_insurance_user'))]"/>
    </record>

    <record id="rule_insurance_company_manager_all" model="ir.rule">
        <field name="name">Insurance Company: manager sees all companies</field>
        <field name="model_id" ref="model_sf_insurance_company"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_insurance_manager'))]"/>
    </record>

    <record id="rule_insurance_policy_manager_all" model="ir.rule">
        <field name="name">Policy: manager sees all companies</field>
        <field name="model_id" ref="model_sf_insurance_policy"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_insurance_manager'))]"/>
    </record>

    <record id="rule_insurance_guarantee_manager_all" model="ir.rule">
        <field name="name">Guarantee: manager sees all companies</field>
        <field name="model_id" ref="model_sf_insurance_guarantee"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_insurance_manager'))]"/>
    </record>

    <record id="rule_insurance_claim_manager_all" model="ir.rule">
        <field name="name">Claim: manager sees all companies</field>
        <field name="model_id" ref="model_sf_insurance_claim"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_insurance_manager'))]"/>
    </record>
</odoo>
