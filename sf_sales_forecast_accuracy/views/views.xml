<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_sales_forecast_accuracy" model="ir.actions.act_window">
        <field name="name">Sales Forecast Accuracy Tracker</field>
        <field name="res_model">sf.sales_forecast_accuracy</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
    <record id="view_sf_sales_forecast_accuracy_form" model="ir.ui.view">
        <field name="name">sf.sales_forecast_accuracy.form</field>
        <field name="model">sf.sales_forecast_accuracy</field>
        <field name="arch" type="xml">
            <form string="Sales Forecast Accuracy Tracker">
                <header>
                    <button name="action_submitted" type="object" string="Submitted"
                            class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="period"/>
                            <field name="rep_id"/>
                            <field name="forecast_amount"/>
                            <field name="actual_amount"/>
                            <field name="accuracy_percent"/>
                            <field name="bias"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_sales_forecast_accuracy_list" model="ir.ui.view">
        <field name="name">sf.sales_forecast_accuracy.list</field>
        <field name="model">sf.sales_forecast_accuracy</field>
        <field name="arch" type="xml">
            <list string="Sales Forecast Accuracy Tracker" sample="1">
                <field name="period"/>
                <field name="rep_id"/>
                <field name="forecast_amount"/>
                <field name="actual_amount"/>
                <field name="accuracy_percent"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state in ('submitted','approved')"/>
            </list>
        </field>
    </record>
    <record id="view_sf_sales_forecast_accuracy_kanban" model="ir.ui.view">
        <field name="name">sf.sales_forecast_accuracy.kanban</field>
        <field name="model">sf.sales_forecast_accuracy</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_view" group_by="state">
                <field name="name"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <menuitem id="menu_sf_sales_forecast_accuracy_root" name="Sales Forecast Accuracy Tracker" sequence="2"
              web_icon="sf_sales_forecast_accuracy,static/description/icon.png"/>
    <menuitem id="menu_sf_sales_forecast_accuracy_main" name="Records"
              parent="menu_sf_sales_forecast_accuracy_root" action="action_sf_sales_forecast_accuracy" sequence="10"/>
</odoo>
