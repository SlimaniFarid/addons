<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_customer_profitability_rank" model="ir.module.category">
        <field name="name">Customer Profitability Ranking</field>
        <field name="sequence">171</field>
    </record>
    <record id="group_customer_profitability_rank_user" model="res.groups">
        <field name="name">Customer Profitability Ranking User</field>
        <field name="category_id" ref="module_category_customer_profitability_rank"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>

    </record>
    <record id="group_customer_profitability_rank_manager" model="res.groups">
        <field name="name">Customer Profitability Ranking Manager</field>
        <field name="category_id" ref="module_category_customer_profitability_rank"/>
        <field name="implied_ids" eval="[(4, ref('group_customer_profitability_rank_user'))]"/>
    </record>
    <record id="rule_customer_profitability_rank_sf_customer_profitability_rank" model="ir.rule">
        <field name="name">Customer Profitability Ranking: multi-company</field>
        <field name="model_id" ref="model_sf_customer_profitability_rank"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
