<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_fixed_asset_transfer" model="ir.module.category">
        <field name="name">Fixed Asset Inter-Company Transfer</field>
        <field name="sequence">184</field>
    </record>
    <record id="group_fixed_asset_transfer_user" model="res.groups">
        <field name="name">Fixed Asset Inter-Company Transfer User</field>
        <field name="category_id" ref="module_category_fixed_asset_transfer"/>

    </record>
    <record id="group_fixed_asset_transfer_manager" model="res.groups">
        <field name="name">Fixed Asset Inter-Company Transfer Manager</field>
        <field name="category_id" ref="module_category_fixed_asset_transfer"/>
        <field name="implied_ids" eval="[(4, ref('group_fixed_asset_transfer_user'))]"/>
    </record>
    <record id="rule_fixed_asset_transfer_sf_fixed_asset_transfer" model="ir.rule">
        <field name="name">Fixed Asset Inter-Company Transfer: multi-company</field>
        <field name="model_id" ref="model_sf_fixed_asset_transfer"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_fixed_asset_transfer"/>
    </record>
</odoo>
