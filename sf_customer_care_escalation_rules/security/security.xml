<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_customer_care_escalation_rules" model="ir.module.category">
        <field name="name">Escalation Rules Engine</field>
        <field name="sequence">367</field>
    </record>
    <record id="group_customer_care_escalation_rules_user" model="res.groups">
        <field name="name">Escalation Rules Engine User</field>
        <field name="category_id" ref="module_category_customer_care_escalation_rules"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>

    </record>
    <record id="group_customer_care_escalation_rules_manager" model="res.groups">
        <field name="name">Escalation Rules Engine Manager</field>
        <field name="category_id" ref="module_category_customer_care_escalation_rules"/>
        <field name="implied_ids" eval="[(4, ref('group_customer_care_escalation_rules_user'))]"/>
    </record>
    <record id="rule_customer_care_escalation_rules_sf_customer_care_escalation_rules" model="ir.rule">
        <field name="name">Escalation Rules Engine: multi-company</field>
        <field name="model_id" ref="model_sf_customer_care_escalation_rules"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
