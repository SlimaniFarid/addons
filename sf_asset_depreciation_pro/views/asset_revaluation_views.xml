<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_asset_revaluation_list" model="ir.ui.view">
        <field name="name">sf.asset.depreciation.pro.asset.revaluation.list</field>
        <field name="model">sf.asset.depreciation.pro.asset.revaluation</field>
        <field name="arch" type="xml">
            <list string="Asset.Revaluation">
                <field name="asset_id"/>
                <field name="old_value"/>
                <field name="new_value"/>
                <field name="reason"/>
                <field name="date"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_asset_revaluation_form" model="ir.ui.view">
        <field name="name">sf.asset.depreciation.pro.asset.revaluation.form</field>
        <field name="model">sf.asset.depreciation.pro.asset.revaluation</field>
        <field name="arch" type="xml">
            <form string="Asset.Revaluation">
                <header>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" placeholder="Name"/></h1></div>
                    <group><group>
                            <field name="asset_id"/>
                            <field name="old_value"/>
                            <field name="new_value"/>
                            <field name="reason"/>
                            <field name="date"/>
                    </group>
                    <group>
                        <field name="currency_id" invisible="1"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_asset_revaluation" model="ir.actions.act_window">
        <field name="name">Asset.Revaluation</field>
        <field name="res_model">sf.asset.depreciation.pro.asset.revaluation</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
