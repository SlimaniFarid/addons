<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_fx_exposure" model="ir.actions.act_window">
        <field name="name">FX Exposure Snapshots</field>
        <field name="res_model">sf.fx.exposure</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_sf_fx_hedge" model="ir.actions.act_window">
        <field name="name">Forward Contracts</field>
        <field name="res_model">sf.fx.hedge</field>
        <field name="view_mode">list,form,kanban</field>
    </record>

    <record id="view_sf_fx_exposure_form" model="ir.ui.view">
        <field name="name">sf.fx.exposure.form</field>
        <field name="model">sf.fx.exposure</field>
        <field name="arch" type="xml">
            <form string="FX Exposure Snapshot">
                <header>
                    <button name="action_compute" type="object"
                            string="Compute Exposure" class="btn-primary"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,computed"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="snapshot_date"/>
                            <field name="company_id"
                                   groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <field name="line_ids" readonly="1">
                        <list create="0">
                            <field name="currency_id"/>
                            <field name="net_open_amount"/>
                            <field name="hedged_amount"/>
                            <field name="coverage_percent"
                                   widget="progressbar"/>
                        </list>
                    </field>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_fx_exposure_list" model="ir.ui.view">
        <field name="name">sf.fx.exposure.list</field>
        <field name="model">sf.fx.exposure</field>
        <field name="arch" type="xml">
            <list string="FX Exposure" sample="1">
                <field name="name"/>
                <field name="snapshot_date"/>
                <field name="company_id"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'computed'"/>
            </list>
        </field>
    </record>

    <record id="view_sf_fx_hedge_form" model="ir.ui.view">
        <field name="name">sf.fx.hedge.form</field>
        <field name="model">sf.fx.hedge</field>
        <field name="arch" type="xml">
            <form string="FX Forward Contract">
                <header>
                    <button name="action_activate" type="object"
                            string="Activate" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_settle" type="object"
                            string="Settle at Spot" class="btn-primary"
                            invisible="state != 'active'"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state in ('settled','cancelled')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,active,settled"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="currency_id"/>
                            <field name="counterparty_bank_id"/>
                            <field name="direction"/>
                            <field name="notional"/>
                        </group>
                        <group>
                            <field name="strike_rate"/>
                            <field name="trade_date"/>
                            <field name="value_date"/>
                            <field name="company_id"
                                   groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group string="Settlement" invisible="state != 'settled'">
                        <group>
                            <field name="spot_rate_at_settlement" readonly="1"/>
                            <field name="settlement_gain_loss" readonly="1"/>
                            <field name="settlement_date" readonly="1"/>
                        </group>
                    </group>
                    <group string="Notes">
                        <field name="notes"/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_fx_hedge_list" model="ir.ui.view">
        <field name="name">sf.fx.hedge.list</field>
        <field name="model">sf.fx.hedge</field>
        <field name="arch" type="xml">
            <list string="Forward Contracts" sample="1">
                <field name="name"/>
                <field name="currency_id"/>
                <field name="direction"/>
                <field name="notional"/>
                <field name="strike_rate"/>
                <field name="value_date"/>
                <field name="settlement_gain_loss" optional="show"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'settled'"/>
            </list>
        </field>
    </record>

    <menuitem id="menu_sf_fx_root" name="FX Hedging" sequence="41"
              parent="account.menu_finance_entries"/>
    <menuitem id="menu_sf_fx_exposure" name="Exposure Snapshots"
              parent="menu_sf_fx_root" action="action_sf_fx_exposure"
              sequence="10"/>
    <menuitem id="menu_sf_fx_hedges" name="Forward Contracts"
              parent="menu_sf_fx_root" action="action_sf_fx_hedge"
              sequence="20"/>
</odoo>
