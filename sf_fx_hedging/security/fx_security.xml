<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_sf_fx" model="ir.module.category">
        <field name="name">FX Hedging</field>
        <field name="sequence">91</field>
    </record>
    <record id="group_sf_fx_user" model="res.groups">
        <field name="name">FX Hedging User</field>
        <field name="category_id" ref="module_category_sf_fx"/>
        <field name="implied_ids" eval="[(4, ref('account.group_account_invoice'))]"/>
    </record>
    <record id="group_sf_fx_manager" model="res.groups">
        <field name="name">FX Hedging Manager</field>
        <field name="category_id" ref="module_category_sf_fx"/>
        <field name="implied_ids" eval="[(4, ref('group_sf_fx_user'))]"/>
    </record>
    <record id="rule_sf_fx_exposure_company" model="ir.rule">
        <field name="name">FX Exposure: multi-company</field>
        <field name="model_id" ref="model_sf_fx_exposure"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_sf_fx_hedge_company" model="ir.rule">
        <field name="name">FX Hedge: multi-company</field>
        <field name="model_id" ref="model_sf_fx_hedge"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
