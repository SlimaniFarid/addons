<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_peak_season_planning" model="ir.module.category">
        <field name="name">Peak Season Planning</field>
        <field name="sequence">21</field>
    </record>
    <record id="group_peak_season_planning_user" model="res.groups">
        <field name="name">Peak Season Planning User</field>
        <field name="category_id" ref="module_category_peak_season_planning"/>
        <field name="implied_ids" eval="[(4, ref('stock.group_stock_user'))]"/>

    </record>
    <record id="group_peak_season_planning_manager" model="res.groups">
        <field name="name">Peak Season Planning Manager</field>
        <field name="category_id" ref="module_category_peak_season_planning"/>
        <field name="implied_ids" eval="[(4, ref('group_peak_season_planning_user'))]"/>
    </record>
    <record id="rule_peak_season_planning_sf_peak_plan" model="ir.rule">
        <field name="name">Peak Season Plan: multi-company</field>
        <field name="model_id" ref="model_sf_peak_plan"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
