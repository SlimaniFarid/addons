<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_peak_plan" model="ir.actions.act_window">
        <field name="name">Peak Season Planning</field>
        <field name="res_model">sf.peak.plan</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
    <record id="view_sf_peak_plan_form" model="ir.ui.view">
        <field name="name">sf.peak.plan.form</field>
        <field name="model">sf.peak.plan</field>
        <field name="arch" type="xml">
            <form string="Peak Season Planning">
                <header>
                    <button name="action_ready" type="object" string="Ready"
                            class="btn-primary"/>
                    <button name="action_in_season" type="object" string="In Season"
                            class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="planning,ready,in_season,reviewed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="season"/>
                            <field name="start_date"/>
                            <field name="temp_staff"/>
                            <field name="stock_build_target"/>
                            <field name="carrier_capacity_booked"/>
                            <field name="daily_ship_target"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_peak_plan_list" model="ir.ui.view">
        <field name="name">sf.peak.plan.list</field>
        <field name="model">sf.peak.plan</field>
        <field name="arch" type="xml">
            <list string="Peak Season Planning" sample="1">
                <field name="season"/>
                <field name="start_date"/>
                <field name="temp_staff"/>
                <field name="stock_build_target"/>
                <field name="carrier_capacity_booked"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state in ('submitted','approved')"/>
            </list>
        </field>
    </record>
    <record id="view_sf_peak_plan_kanban" model="ir.ui.view">
        <field name="name">sf.peak.plan.kanban</field>
        <field name="model">sf.peak.plan</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_view" group_by="state">
                <field name="name"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <menuitem id="menu_sf_peak_plan_root" name="Peak Season Planning" sequence="12"
              web_icon="sf_peak_season_planning,static/description/icon.png"/>
    <menuitem id="menu_sf_peak_plan_main" name="Records"
              parent="menu_sf_peak_plan_root" action="action_sf_peak_plan" sequence="10"/>

    <record id="wave_final_sf_peak_season_planning" model="ir.actions.server">
        <field name="name">Refresh Business Data</field>
        <field name="model_id" ref="model_sf_peak_plan"/>
        <field name="binding_model_id" ref="model_sf_peak_plan"/>
        <field name="state">code</field>
        <field name="code">records.action_refresh_business()</field>
    </record>
</odoo>
