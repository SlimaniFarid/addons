<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_employee_loans" model="ir.module.category">
        <field name="name">Employee Loans</field>
        <field name="sequence">95</field>
    </record>

    <record id="group_employee_loans_user" model="res.groups">
        <field name="name">Employee Loans User</field>
        <field name="category_id" ref="module_category_employee_loans"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_employee_loans_manager" model="res.groups">
        <field name="name">Employee Loans Manager</field>
        <field name="category_id" ref="module_category_employee_loans"/>
        <field name="implied_ids" eval="[(4, ref('group_employee_loans_user'))]"/>
    </record>

    <record id="rule_employee_loan_user_company" model="ir.rule">
        <field name="name">Employee Loan: user sees own company</field>
        <field name="model_id" ref="model_sf_employee_loan"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_employee_loans_user'))]"/>
    </record>

    <record id="rule_employee_loan_line_user_company" model="ir.rule">
        <field name="name">Employee Loan Line: user sees own company</field>
        <field name="model_id" ref="model_sf_employee_loan_line"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('loan_id.company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_employee_loans_user'))]"/>
    </record>
</odoo>