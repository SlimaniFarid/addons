<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_shift_handover" model="ir.actions.act_window">
        <field name="name">Shift Handover Notes (Workcenters)</field>
        <field name="res_model">sf.shift.handover</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
    <record id="view_sf_shift_handover_form" model="ir.ui.view">
        <field name="name">sf.shift.handover.form</field>
        <field name="model">sf.shift.handover</field>
        <field name="arch" type="xml">
            <form string="Shift Handover Notes (Workcenters)">
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="draft,acknowledged"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="workcenter_id"/>
                            <field name="shift"/>
                            <field name="handover_date"/>
                            <field name="running_orders"/>
                            <field name="issues"/>
                            <field name="watchouts"/>
                            <field name="operator_id"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_shift_handover_list" model="ir.ui.view">
        <field name="name">sf.shift.handover.list</field>
        <field name="model">sf.shift.handover</field>
        <field name="arch" type="xml">
            <list string="Shift Handover Notes (Workcenters)" sample="1">
                <field name="workcenter_id"/>
                <field name="shift"/>
                <field name="handover_date"/>
                <field name="running_orders"/>
                <field name="issues"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state in ('submitted','approved')"/>
            </list>
        </field>
    </record>
    <record id="view_sf_shift_handover_kanban" model="ir.ui.view">
        <field name="name">sf.shift.handover.kanban</field>
        <field name="model">sf.shift.handover</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_view" group_by="state">
                <field name="name"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <menuitem id="menu_sf_shift_handover_root" name="Shift Handover Notes (Workcenters)" sequence="26"
              web_icon="sf_workorder_handover,static/description/icon.png"/>
    <menuitem id="menu_sf_shift_handover_main" name="Records"
              parent="menu_sf_shift_handover_root" action="action_sf_shift_handover" sequence="10"/>

    <record id="wave_final_sf_workorder_handover" model="ir.actions.server">
        <field name="name">Refresh Business Data</field>
        <field name="model_id" ref="model_sf_shift_handover"/>
        <field name="binding_model_id" ref="model_sf_shift_handover"/>
        <field name="state">code</field>
        <field name="code">records.action_refresh_business()</field>
    </record>
</odoo>
