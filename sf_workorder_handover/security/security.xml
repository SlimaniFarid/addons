<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_workorder_handover" model="ir.module.category">
        <field name="name">Shift Handover Notes (Workcenters)</field>
        <field name="sequence">21</field>
    </record>
    <record id="group_workorder_handover_user" model="res.groups">
        <field name="name">Shift Handover Notes (Workcenters) User</field>
        <field name="category_id" ref="module_category_workorder_handover"/>
        <field name="implied_ids" eval="[(4, ref('mrp.group_mrp_user'))]"/>

    </record>
    <record id="group_workorder_handover_manager" model="res.groups">
        <field name="name">Shift Handover Notes (Workcenters) Manager</field>
        <field name="category_id" ref="module_category_workorder_handover"/>
        <field name="implied_ids" eval="[(4, ref('group_workorder_handover_user'))]"/>
    </record>
    <record id="rule_workorder_handover_sf_shift_handover" model="ir.rule">
        <field name="name">Shift Handover: multi-company</field>
        <field name="model_id" ref="model_sf_shift_handover"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
