<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_cross_sell_engine" model="ir.actions.act_window">
        <field name="name">Cross-Sell Recommendation Engine</field>
        <field name="res_model">sf.cross_sell_engine</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
    <record id="view_sf_cross_sell_engine_form" model="ir.ui.view">
        <field name="name">sf.cross_sell_engine.form</field>
        <field name="model">sf.cross_sell_engine</field>
        <field name="arch" type="xml">
            <form string="Cross-Sell Recommendation Engine">
                <header>
                    <button name="action_submitted" type="object" string="Submitted"
                            class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="base_product_id"/>
                            <field name="recommend_product_id"/>
                            <field name="affinity_score"/>
                            <field name="attach_rate"/>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_cross_sell_engine_list" model="ir.ui.view">
        <field name="name">sf.cross_sell_engine.list</field>
        <field name="model">sf.cross_sell_engine</field>
        <field name="arch" type="xml">
            <list string="Cross-Sell Recommendation Engine" sample="1">
                <field name="base_product_id"/>
                <field name="recommend_product_id"/>
                <field name="affinity_score"/>
                <field name="attach_rate"/>
                <field name="active"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state in ('submitted','approved')"/>
            </list>
        </field>
    </record>
    <record id="view_sf_cross_sell_engine_kanban" model="ir.ui.view">
        <field name="name">sf.cross_sell_engine.kanban</field>
        <field name="model">sf.cross_sell_engine</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_view" group_by="state">
                <field name="name"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <menuitem id="menu_sf_cross_sell_engine_root" name="Cross-Sell Recommendation Engine" sequence="26"
              web_icon="sf_cross_sell_engine,static/description/icon.png"/>
    <menuitem id="menu_sf_cross_sell_engine_main" name="Records"
              parent="menu_sf_cross_sell_engine_root" action="action_sf_cross_sell_engine" sequence="10"/>
</odoo>
