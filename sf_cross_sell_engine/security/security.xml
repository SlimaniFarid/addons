<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_cross_sell_engine" model="ir.module.category">
        <field name="name">Cross-Sell Recommendation Engine</field>
        <field name="sequence">175</field>
    </record>
    <record id="group_cross_sell_engine_user" model="res.groups">
        <field name="name">Cross-Sell Recommendation Engine User</field>
        <field name="category_id" ref="module_category_cross_sell_engine"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>

    </record>
    <record id="group_cross_sell_engine_manager" model="res.groups">
        <field name="name">Cross-Sell Recommendation Engine Manager</field>
        <field name="category_id" ref="module_category_cross_sell_engine"/>
        <field name="implied_ids" eval="[(4, ref('group_cross_sell_engine_user'))]"/>
    </record>
    <record id="rule_cross_sell_engine_sf_cross_sell_engine" model="ir.rule">
        <field name="name">Cross-Sell Recommendation Engine: multi-company</field>
        <field name="model_id" ref="model_sf_cross_sell_engine"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
