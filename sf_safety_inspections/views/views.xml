<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_safety_inspections" model="ir.actions.act_window">
        <field name="name">Safety Inspection Scheduler</field>
        <field name="res_model">sf.safety_inspections</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
    <record id="view_sf_safety_inspections_form" model="ir.ui.view">
        <field name="name">sf.safety_inspections.form</field>
        <field name="model">sf.safety_inspections</field>
        <field name="arch" type="xml">
            <form string="Safety Inspection Scheduler">
                <header>
                    <button name="action_submitted" type="object" string="Submitted"
                            class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="area"/>
                            <field name="inspection_type"/>
                            <field name="scheduled_date"/>
                            <field name="inspector_id"/>
                        <field name="findings"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_safety_inspections_list" model="ir.ui.view">
        <field name="name">sf.safety_inspections.list</field>
        <field name="model">sf.safety_inspections</field>
        <field name="arch" type="xml">
            <list string="Safety Inspection Scheduler" sample="1">
                <field name="area"/>
                <field name="inspection_type"/>
                <field name="scheduled_date"/>
                <field name="inspector_id"/>
                <field name="findings"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state in ('submitted','approved')"/>
            </list>
        </field>
    </record>
    <record id="view_sf_safety_inspections_kanban" model="ir.ui.view">
        <field name="name">sf.safety_inspections.kanban</field>
        <field name="model">sf.safety_inspections</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_view" group_by="state">
                <field name="name"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <menuitem id="menu_sf_safety_inspections_root" name="Safety Inspection Scheduler" sequence="19"
              web_icon="sf_safety_inspections,static/description/icon.png"/>
    <menuitem id="menu_sf_safety_inspections_main" name="Records"
              parent="menu_sf_safety_inspections_root" action="action_sf_safety_inspections" sequence="10"/>
</odoo>
