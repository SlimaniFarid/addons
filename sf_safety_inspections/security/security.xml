<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_safety_inspections" model="ir.module.category">
        <field name="name">Safety Inspection Scheduler</field>
        <field name="sequence">282</field>
    </record>
    <record id="group_safety_inspections_user" model="res.groups">
        <field name="name">Safety Inspection Scheduler User</field>
        <field name="category_id" ref="module_category_safety_inspections"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>

    </record>
    <record id="group_safety_inspections_manager" model="res.groups">
        <field name="name">Safety Inspection Scheduler Manager</field>
        <field name="category_id" ref="module_category_safety_inspections"/>
        <field name="implied_ids" eval="[(4, ref('group_safety_inspections_user'))]"/>
    </record>
    <record id="rule_safety_inspections_sf_safety_inspections" model="ir.rule">
        <field name="name">Safety Inspection Scheduler: multi-company</field>
        <field name="model_id" ref="model_sf_safety_inspections"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
