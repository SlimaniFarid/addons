<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="module_category_sf_staffing" model="ir.module.category">
            <field name="name">Staffing</field>
            <field name="description">Temporary work and placement agency management.</field>
            <field name="sequence">10</field>
        </record>

        <record id="group_sf_staffing_user" model="res.groups">
            <field name="name">Staffing / User</field>
            <field name="category_id" ref="module_category_sf_staffing"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_sf_staffing_manager" model="res.groups">
            <field name="name">Staffing / Manager</field>
            <field name="category_id" ref="module_category_sf_staffing"/>
            <field name="implied_ids" eval="[(4, ref('sf_staffing.group_sf_staffing_user'))]"/>
        </record>

        <record id="rule_sf_staffing_candidate_company" model="ir.rule">
            <field name="name">Staffing Candidate: user sees own company</field>
            <field name="model_id" ref="model_sf_staffing_candidate"/>
            <field name="groups" eval="[(4, ref('sf_staffing.group_sf_staffing_user'))]"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="rule_sf_staffing_candidate_manager_all" model="ir.rule">
            <field name="name">Staffing Candidate: manager sees all companies</field>
            <field name="model_id" ref="model_sf_staffing_candidate"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('sf_staffing.group_sf_staffing_manager'))]"/>
        </record>

        <record id="rule_sf_staffing_client_company" model="ir.rule">
            <field name="name">Staffing Client: user sees own company</field>
            <field name="model_id" ref="model_sf_staffing_client"/>
            <field name="groups" eval="[(4, ref('sf_staffing.group_sf_staffing_user'))]"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="rule_sf_staffing_client_manager_all" model="ir.rule">
            <field name="name">Staffing Client: manager sees all companies</field>
            <field name="model_id" ref="model_sf_staffing_client"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('sf_staffing.group_sf_staffing_manager'))]"/>
        </record>

        <record id="rule_sf_staffing_need_company" model="ir.rule">
            <field name="name">Staffing Need: user sees own company</field>
            <field name="model_id" ref="model_sf_staffing_need"/>
            <field name="groups" eval="[(4, ref('sf_staffing.group_sf_staffing_user'))]"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="rule_sf_staffing_need_manager_all" model="ir.rule">
            <field name="name">Staffing Need: manager sees all companies</field>
            <field name="model_id" ref="model_sf_staffing_need"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('sf_staffing.group_sf_staffing_manager'))]"/>
        </record>

        <record id="rule_sf_staffing_mission_company" model="ir.rule">
            <field name="name">Staffing Mission: user sees own company</field>
            <field name="model_id" ref="model_sf_staffing_mission"/>
            <field name="groups" eval="[(4, ref('sf_staffing.group_sf_staffing_user'))]"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="rule_sf_staffing_mission_manager_all" model="ir.rule">
            <field name="name">Staffing Mission: manager sees all companies</field>
            <field name="model_id" ref="model_sf_staffing_mission"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('sf_staffing.group_sf_staffing_manager'))]"/>
        </record>

        <record id="rule_sf_staffing_contract_company" model="ir.rule">
            <field name="name">Staffing Contract: user sees own company</field>
            <field name="model_id" ref="model_sf_staffing_contract"/>
            <field name="groups" eval="[(4, ref('sf_staffing.group_sf_staffing_user'))]"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="rule_sf_staffing_contract_manager_all" model="ir.rule">
            <field name="name">Staffing Contract: manager sees all companies</field>
            <field name="model_id" ref="model_sf_staffing_contract"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('sf_staffing.group_sf_staffing_manager'))]"/>
        </record>

        <record id="rule_sf_staffing_timesheet_company" model="ir.rule">
            <field name="name">Staffing Timesheet: user sees own company</field>
            <field name="model_id" ref="model_sf_staffing_timesheet"/>
            <field name="groups" eval="[(4, ref('sf_staffing.group_sf_staffing_user'))]"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="rule_sf_staffing_timesheet_manager_all" model="ir.rule">
            <field name="name">Staffing Timesheet: manager sees all companies</field>
            <field name="model_id" ref="model_sf_staffing_timesheet"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('sf_staffing.group_sf_staffing_manager'))]"/>
        </record>
    </data>
    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_sf_staffing"/>
    </record>
</odoo>