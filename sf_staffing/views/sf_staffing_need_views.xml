<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sf_staffing_need_view_tree" model="ir.ui.view">
        <field name="name">sf.staffing.need.list</field>
        <field name="model">sf.staffing.need</field>
        <field name="arch" type="xml">
            <list string="Needs">
                <field name="name"/>
                <field name="client_id"/>
                <field name="job_title"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="quantity"/>
                <field name="state" widget="badge"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="sf_staffing_need_view_form" model="ir.ui.view">
        <field name="name">sf.staffing.need.form</field>
        <field name="model">sf.staffing.need</field>
        <field name="arch" type="xml">
            <form string="Need">
                <header>
                    <button name="action_open" type="object" string="Reopen" invisible="[('state', 'not in', ('assigned', 'filled', 'cancelled'))]"/>
                    <button name="action_assigned" type="object" string="Mark Assigned" invisible="[('state', 'not in', ('open',))]"/>
                    <button name="action_fill" type="object" string="Mark Filled" invisible="[('state', 'not in', ('open', 'assigned'))]"/>
                    <button name="action_cancel" type="object" string="Cancel" invisible="[('state', 'not in', ('open', 'assigned', 'filled'))]"/>
                    <field name="state" widget="statusbar" statusbar_visible="open,assigned,filled,cancelled"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="client_id"/>
                            <field name="job_title"/>
                            <field name="quantity"/>
                        </group>
                        <group>
                            <field name="start_date"/>
                            <field name="end_date"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group string="Required Skills">
                        <field name="required_skills" widget="text"/>
                    </group>
                    <notebook>
                        <page string="Missions">
                            <field name="mission_ids">
                                <list string="Missions">
                                    <field name="name"/>
                                    <field name="candidate_id"/>
                                    <field name="start_date"/>
                                    <field name="end_date"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="sf_staffing_need_view_kanban" model="ir.ui.view">
        <field name="name">sf.staffing.need.kanban</field>
        <field name="model">sf.staffing.need</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state">
                <field name="name"/>
                <field name="job_title"/>
                <field name="client_id"/>
                <field name="state"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong>
                                <div><field name="job_title"/></div>
                                <div><field name="client_id"/></div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="sf_staffing_need_view_search" model="ir.ui.view">
        <field name="name">sf.staffing.need.search</field>
        <field name="model">sf.staffing.need</field>
        <field name="arch" type="xml">
            <search string="Needs">
                <field name="name"/>
                <field name="job_title"/>
                <field name="client_id"/>
                <filter name="need_open" string="Open" domain="[('state', '=', 'open')]"/>
                <filter name="need_assigned" string="Assigned" domain="[('state', '=', 'assigned')]"/>
                <group>
                    <filter name="group_need_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_need_client" string="Client" context="{'group_by': 'client_id'}"/>
                    <filter name="group_need_company" string="Company" context="{'group_by': 'company_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_sf_staffing_need" model="ir.actions.act_window">
        <field name="name">Needs</field>
        <field name="res_model">sf.staffing.need</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="sf_staffing_need_view_search"/>
    </record>
</odoo>