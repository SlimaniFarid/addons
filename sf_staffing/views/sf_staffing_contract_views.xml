<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sf_staffing_contract_view_tree" model="ir.ui.view">
        <field name="name">sf.staffing.contract.list</field>
        <field name="model">sf.staffing.contract</field>
        <field name="arch" type="xml">
            <list string="Contracts">
                <field name="name"/>
                <field name="mission_id"/>
                <field name="client_id"/>
                <field name="candidate_id"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="hourly_rate" currency_field="currency_id"/>
                <field name="state" widget="badge"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="sf_staffing_contract_view_form" model="ir.ui.view">
        <field name="name">sf.staffing.contract.form</field>
        <field name="model">sf.staffing.contract</field>
        <field name="arch" type="xml">
            <form string="Contract">
                <header>
                    <button name="action_confirm" type="object" string="Confirm" invisible="[('state', 'not in', ('draft',))]" class="btn-primary"/>
                    <button name="action_done" type="object" string="Mark As Done" invisible="[('state', 'not in', ('confirmed',))]"/>
                    <button name="action_cancel" type="object" string="Cancel" invisible="[('state', 'not in', ('draft', 'confirmed'))]"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,done,cancelled"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="mission_id"/>
                            <field name="client_id"/>
                            <field name="candidate_id"/>
                        </group>
                        <group>
                            <field name="start_date"/>
                            <field name="end_date"/>
                            <field name="hourly_rate" currency_field="currency_id"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="sf_staffing_contract_view_kanban" model="ir.ui.view">
        <field name="name">sf.staffing.contract.kanban</field>
        <field name="model">sf.staffing.contract</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state">
                <field name="name"/>
                <field name="client_id"/>
                <field name="candidate_id"/>
                <field name="state"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong>
                                <div>Client: <field name="client_id"/></div>
                                <div>Candidate: <field name="candidate_id"/></div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="sf_staffing_contract_view_search" model="ir.ui.view">
        <field name="name">sf.staffing.contract.search</field>
        <field name="model">sf.staffing.contract</field>
        <field name="arch" type="xml">
            <search string="Contracts">
                <field name="name"/>
                <field name="client_id"/>
                <field name="candidate_id"/>
                <field name="mission_id"/>
                <filter name="contract_confirmed" string="Confirmed" domain="[('state', '=', 'confirmed')]"/>
                <filter name="contract_done" string="Done" domain="[('state', '=', 'done')]"/>
                <group>
                    <filter name="group_contract_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_contract_client" string="Client" context="{'group_by': 'client_id'}"/>
                    <filter name="group_contract_company" string="Company" context="{'group_by': 'company_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_sf_staffing_contract" model="ir.actions.act_window">
        <field name="name">Contracts</field>
        <field name="res_model">sf.staffing.contract</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="sf_staffing_contract_view_search"/>
    </record>
</odoo>