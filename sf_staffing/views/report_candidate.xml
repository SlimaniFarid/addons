<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_candidate">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-set="company" t-value="o.company_id or res_company"/>
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>Candidate Sheet</h2>
                        <table class="table table-sm">
                            <tr><th>Name</th><td><span t-field="o.name"/></td></tr>
                            <tr><th>Desired Job</th><td><span t-field="o.desired_job"/></td></tr>
                            <tr><th>Availability</th><td><span t-field="o.availability"/></td></tr>
                            <tr><th>Status</th><td><span t-field="o.state"/></td></tr>
                            <tr><th>Email</th><td><span t-field="o.email"/></td></tr>
                            <tr><th>Phone</th><td><span t-field="o.phone"/></td></tr>
                        </table>
                        <h3>Skills</h3>
                        <p t-field="o.skills"/>
                        <h3>Mission History</h3>
                        <table class="table table-sm">
                            <thead>
                                <tr><th>Mission</th><th>Client</th><th>Start</th><th>End</th><th>Status</th></tr>
                            </thead>
                            <tbody>
                                <t t-foreach="o.mission_ids" t-as="m">
                                    <tr>
                                        <td><span t-field="m.name"/></td>
                                        <td><span t-field="m.client_id.name"/></td>
                                        <td><span t-field="m.start_date"/></td>
                                        <td><span t-field="m.end_date"/></td>
                                        <td><span t-field="m.state"/></td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>