<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sf_staffing_timesheet_view_tree" model="ir.ui.view">
        <field name="name">sf.staffing.timesheet.list</field>
        <field name="model">sf.staffing.timesheet</field>
        <field name="arch" type="xml">
            <list string="Timesheets">
                <field name="name"/>
                <field name="mission_id"/>
                <field name="date"/>
                <field name="hours"/>
                <field name="hourly_rate" currency_field="currency_id"/>
                <field name="amount" currency_field="currency_id" sum="Total"/>
                <field name="state" widget="badge"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="sf_staffing_timesheet_view_form" model="ir.ui.view">
        <field name="name">sf.staffing.timesheet.form</field>
        <field name="model">sf.staffing.timesheet</field>
        <field name="arch" type="xml">
            <form string="Timesheet">
                <header>
                    <button name="action_confirm" type="object" string="Confirm" invisible="[('state', 'not in', ('draft',))]"/>
                    <button name="action_done" type="object" string="Validate" invisible="[('state', 'not in', ('draft', 'confirmed'))]" class="btn-primary"/>
                    <button name="action_cancel" type="object" string="Cancel" invisible="[('state', 'not in', ('draft', 'confirmed'))]"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,done,cancelled"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="mission_id"/>
                            <field name="date"/>
                        </group>
                        <group>
                            <field name="hours"/>
                            <field name="hourly_rate" currency_field="currency_id"/>
                            <field name="amount" readonly="1" currency_field="currency_id"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="sf_staffing_timesheet_view_kanban" model="ir.ui.view">
        <field name="name">sf.staffing.timesheet.kanban</field>
        <field name="model">sf.staffing.timesheet</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state">
                <field name="name"/>
                <field name="mission_id"/>
                <field name="date"/>
                <field name="hours"/>
                <field name="state"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong>
                                <div>Mission: <field name="mission_id"/></div>
                                <div><field name="hours"/> hours on <field name="date"/></div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="sf_staffing_timesheet_view_pivot" model="ir.ui.view">
        <field name="name">sf.staffing.timesheet.pivot</field>
        <field name="model">sf.staffing.timesheet</field>
        <field name="arch" type="xml">
            <pivot string="Timesheet Analysis">
                <field name="mission_id" type="row"/>
                <field name="state" type="col"/>
                <field name="hours" type="measure"/>
                <field name="amount" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="sf_staffing_timesheet_view_search" model="ir.ui.view">
        <field name="name">sf.staffing.timesheet.search</field>
        <field name="model">sf.staffing.timesheet</field>
        <field name="arch" type="xml">
            <search string="Timesheets">
                <field name="name"/>
                <field name="mission_id"/>
                <field name="date"/>
                <filter name="timesheet_draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="timesheet_confirmed" string="Confirmed" domain="[('state', '=', 'confirmed')]"/>
                <filter name="timesheet_done" string="Done" domain="[('state', '=', 'done')]"/>
                <group>
                    <filter name="group_timesheet_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_timesheet_mission" string="Mission" context="{'group_by': 'mission_id'}"/>
                    <filter name="group_timesheet_company" string="Company" context="{'group_by': 'company_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_sf_staffing_timesheet" model="ir.actions.act_window">
        <field name="name">Timesheets</field>
        <field name="res_model">sf.staffing.timesheet</field>
        <field name="view_mode">list,kanban,form,pivot</field>
        <field name="search_view_id" ref="sf_staffing_timesheet_view_search"/>
    </record>
</odoo>