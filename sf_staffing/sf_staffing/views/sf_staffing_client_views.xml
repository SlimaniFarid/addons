<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sf_staffing_client_view_tree" model="ir.ui.view">
        <field name="name">sf.staffing.client.list</field>
        <field name="model">sf.staffing.client</field>
        <field name="arch" type="xml">
            <list string="Clients">
                <field name="name"/>
                <field name="contact_name"/>
                <field name="email"/>
                <field name="phone"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="sf_staffing_client_view_form" model="ir.ui.view">
        <field name="name">sf.staffing.client.form</field>
        <field name="model">sf.staffing.client</field>
        <field name="arch" type="xml">
            <form string="Client">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="contact_name"/>
                        </group>
                        <group>
                            <field name="email"/>
                            <field name="phone"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Needs">
                            <field name="need_ids">
                                <list string="Needs">
                                    <field name="name"/>
                                    <field name="job_title"/>
                                    <field name="start_date"/>
                                    <field name="end_date"/>
                                    <field name="quantity"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                        <page string="Missions">
                            <field name="mission_ids">
                                <list string="Missions">
                                    <field name="name"/>
                                    <field name="candidate_id"/>
                                    <field name="start_date"/>
                                    <field name="end_date"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="sf_staffing_client_view_kanban" model="ir.ui.view">
        <field name="name">sf.staffing.client.kanban</field>
        <field name="model">sf.staffing.client</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="name"/>
                <field name="contact_name"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong>
                                <div><field name="contact_name"/></div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="sf_staffing_client_view_search" model="ir.ui.view">
        <field name="name">sf.staffing.client.search</field>
        <field name="model">sf.staffing.client</field>
        <field name="arch" type="xml">
            <search string="Clients">
                <field name="name"/>
                <field name="contact_name"/>
                <field name="email"/>
                <group>
                    <filter name="group_client_company" string="Company" context="{'group_by': 'company_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_sf_staffing_client" model="ir.actions.act_window">
        <field name="name">Clients</field>
        <field name="res_model">sf.staffing.client</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="sf_staffing_client_view_search"/>
    </record>
</odoo>