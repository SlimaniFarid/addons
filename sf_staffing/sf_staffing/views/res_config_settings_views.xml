<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_sf_staffing" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.sf.staffing</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Staffing" string="Staffing" name="sf_staffing">
                    <block title="Staffing">
                        <setting string="Mission End Reminder" help="Number of days before the mission end date to trigger the daily reminder activity.">
                            <field name="sf_staffing_mission_end_reminder_days"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>