<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_sales_play_execution" model="ir.module.category">
        <field name="name">Sales Play Execution Tracker</field>
        <field name="sequence">499</field>
    </record>
    <record id="group_sales_play_execution_user" model="res.groups">
        <field name="name">Sales Play Execution Tracker User</field>
        <field name="category_id" ref="module_category_sales_play_execution"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>

    </record>
    <record id="group_sales_play_execution_manager" model="res.groups">
        <field name="name">Sales Play Execution Tracker Manager</field>
        <field name="category_id" ref="module_category_sales_play_execution"/>
        <field name="implied_ids" eval="[(4, ref('group_sales_play_execution_user'))]"/>
    </record>
    <record id="rule_sales_play_execution_sf_sales_play_execution" model="ir.rule">
        <field name="name">Sales Play Execution Tracker: multi-company</field>
        <field name="model_id" ref="model_sf_sales_play_execution"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_sales_play_execution"/>
    </record>
</odoo>
