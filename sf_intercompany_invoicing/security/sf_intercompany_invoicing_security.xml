<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_sf_intercompany_invoicing" model="ir.module.category">
        <field name="name">Intercompany Invoicing Automation</field>
        <field name="description">Intercompany Invoicing Automation</field>
        <field name="sequence">10</field>
    </record>
    <record id="group_intercompany_invoicing_user" model="res.groups">
        <field name="name">Intercompany Invoicing Automation / User</field>
        <field name="category_id" ref="module_category_sf_intercompany_invoicing"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_intercompany_invoicing_manager" model="res.groups">
        <field name="name">Intercompany Invoicing Automation / Manager</field>
        <field name="category_id" ref="module_category_sf_intercompany_invoicing"/>
        <field name="implied_ids" eval="[(4, ref('sf_intercompany_invoicing.group_intercompany_invoicing_user'))]"/>
    </record>
    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_sf_intercompany_invoicing"/>
    </record>
</odoo>
