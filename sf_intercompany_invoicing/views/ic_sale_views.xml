<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ic_sale_list" model="ir.ui.view">
        <field name="name">sf.intercompany.invoicing.ic.sale.list</field>
        <field name="model">sf.intercompany.invoicing.ic.sale</field>
        <field name="arch" type="xml">
            <list string="Ic.Sale">
                <field name="name"/>
                <field name="source_company_id"/>
                <field name="dest_company_id"/>
                <field name="sale_order_id"/>
                <field name="amount"/>
                <field name="state"/>
                <field name="state" widget="badge"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_ic_sale_form" model="ir.ui.view">
        <field name="name">sf.intercompany.invoicing.ic.sale.form</field>
        <field name="model">sf.intercompany.invoicing.ic.sale</field>
        <field name="arch" type="xml">
            <form string="Ic.Sale">
                <header>
                <field name="state" widget="badge"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" placeholder="Name"/></h1></div>
                    <group><group>
                            <field name="name"/>
                            <field name="source_company_id"/>
                            <field name="dest_company_id"/>
                            <field name="sale_order_id"/>
                            <field name="amount"/>
                            <field name="state"/>
                    </group>
                    <group>
                        <field name="currency_id" invisible="1"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_ic_sale" model="ir.actions.act_window">
        <field name="name">Ic.Sale</field>
        <field name="res_model">sf.intercompany.invoicing.ic.sale</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
