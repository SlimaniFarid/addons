<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_currency_exposure_map" model="ir.actions.act_window">
        <field name="name">Currency Exposure Heatmap</field>
        <field name="res_model">sf.currency_exposure_map</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
    <record id="view_sf_currency_exposure_map_form" model="ir.ui.view">
        <field name="name">sf.currency_exposure_map.form</field>
        <field name="model">sf.currency_exposure_map</field>
        <field name="arch" type="xml">
            <form string="Currency Exposure Heatmap">
                <header>

                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="currency_pair"/>
                            <field name="net_exposure"/>
                            <field name="hedged_percent"/>
                            <field name="recommendation"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_currency_exposure_map_list" model="ir.ui.view">
        <field name="name">sf.currency_exposure_map.list</field>
        <field name="model">sf.currency_exposure_map</field>
        <field name="arch" type="xml">
            <list string="Currency Exposure Heatmap" sample="1">
                <field name="currency_pair"/>
                <field name="net_exposure"/>
                <field name="hedged_percent"/>
                <field name="recommendation"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state in ('submitted','approved')"/>
            </list>
        </field>
    </record>
    <record id="view_sf_currency_exposure_map_kanban" model="ir.ui.view">
        <field name="name">sf.currency_exposure_map.kanban</field>
        <field name="model">sf.currency_exposure_map</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_view" group_by="state">
                <field name="name"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <menuitem id="menu_sf_currency_exposure_map_root" name="Currency Exposure Heatmap" sequence="16"
              web_icon="sf_currency_exposure_map,static/description/icon.png"/>
    <menuitem id="menu_sf_currency_exposure_map_main" name="Records"
              parent="menu_sf_currency_exposure_map_root" action="action_sf_currency_exposure_map" sequence="10"/>
</odoo>
