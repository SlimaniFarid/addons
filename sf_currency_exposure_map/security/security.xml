<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_currency_exposure_map" model="ir.module.category">
        <field name="name">Currency Exposure Heatmap</field>
        <field name="sequence">185</field>
    </record>
    <record id="group_currency_exposure_map_user" model="res.groups">
        <field name="name">Currency Exposure Heatmap User</field>
        <field name="category_id" ref="module_category_currency_exposure_map"/>

    </record>
    <record id="group_currency_exposure_map_manager" model="res.groups">
        <field name="name">Currency Exposure Heatmap Manager</field>
        <field name="category_id" ref="module_category_currency_exposure_map"/>
        <field name="implied_ids" eval="[(4, ref('group_currency_exposure_map_user'))]"/>
    </record>
    <record id="rule_currency_exposure_map_sf_currency_exposure_map" model="ir.rule">
        <field name="name">Currency Exposure Heatmap: multi-company</field>
        <field name="model_id" ref="model_sf_currency_exposure_map"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_currency_exposure_map"/>
    </record>
</odoo>
