<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_label_print_batch_list" model="ir.ui.view">
        <field name="name">sf.barcode.label.designer.label.print.batch.list</field>
        <field name="model">sf.barcode.label.designer.label.print.batch</field>
        <field name="arch" type="xml">
            <list string="Label.Print.Batch">
                <field name="template_id"/>
                <field name="quantity"/>
                <field name="model_ref"/>
                <field name="state"/>
                <field name="state" widget="badge"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_label_print_batch_form" model="ir.ui.view">
        <field name="name">sf.barcode.label.designer.label.print.batch.form</field>
        <field name="model">sf.barcode.label.designer.label.print.batch</field>
        <field name="arch" type="xml">
            <form string="Label.Print.Batch">
                <header>
                <field name="state" widget="badge"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" placeholder="Name"/></h1></div>
                    <group><group>
                            <field name="template_id"/>
                            <field name="quantity"/>
                            <field name="model_ref"/>
                            <field name="state"/>
                    </group>
                    <group>
                        <field name="currency_id" invisible="1"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_label_print_batch" model="ir.actions.act_window">
        <field name="name">Label.Print.Batch</field>
        <field name="res_model">sf.barcode.label.designer.label.print.batch</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
