<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_label_template_list" model="ir.ui.view">
        <field name="name">sf.barcode.label.designer.label.template.list</field>
        <field name="model">sf.barcode.label.designer.label.template</field>
        <field name="arch" type="xml">
            <list string="Label.Template">
                <field name="name"/>
                <field name="label_width_mm"/>
                <field name="label_height_mm"/>
                <field name="barcode_type"/>
                <field name="output_format"/>
                <field name="active"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_label_template_form" model="ir.ui.view">
        <field name="name">sf.barcode.label.designer.label.template.form</field>
        <field name="model">sf.barcode.label.designer.label.template</field>
        <field name="arch" type="xml">
            <form string="Label.Template">
                <header>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" placeholder="Name"/></h1></div>
                    <group><group>
                            <field name="name"/>
                            <field name="label_width_mm"/>
                            <field name="label_height_mm"/>
                            <field name="barcode_type"/>
                            <field name="output_format"/>
                            <field name="active"/>
                    </group>
                    <group>
                        <field name="currency_id" invisible="1"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_label_template" model="ir.actions.act_window">
        <field name="name">Label.Template</field>
        <field name="res_model">sf.barcode.label.designer.label.template</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
