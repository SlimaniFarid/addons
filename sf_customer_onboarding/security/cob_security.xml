<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_sf_cob" model="ir.module.category">
        <field name="name">Customer Onboarding</field>
        <field name="sequence">76</field>
    </record>
    <record id="group_sf_cob_user" model="res.groups">
        <field name="name">Customer Onboarding User</field>
        <field name="category_id" ref="module_category_sf_cob"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
    </record>
    <record id="group_sf_cob_manager" model="res.groups">
        <field name="name">Customer Onboarding Manager</field>
        <field name="category_id" ref="module_category_sf_cob"/>
        <field name="implied_ids" eval="[(4, ref('group_sf_cob_user'))]"/>
    </record>
    <record id="rule_sf_cob_company" model="ir.rule">
        <field name="name">Customer Onboarding: multi-company</field>
        <field name="model_id" ref="model_sf_customer_onboarding"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
