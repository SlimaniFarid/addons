<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_cob" model="ir.actions.act_window">
        <field name="name">Customer Onboardings</field>
        <field name="res_model">sf.customer.onboarding</field>
        <field name="view_mode">kanban,list,form,kanban</field>
    </record>
    <record id="action_sf_cob_template" model="ir.actions.act_window">
        <field name="name">Templates</field>
        <field name="res_model">sf.cob.template</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="view_sf_cob_form" model="ir.ui.view">
        <field name="name">sf.customer.onboarding.form</field>
        <field name="model">sf.customer.onboarding</field>
        <field name="arch" type="xml">
            <form string="Customer Onboarding">
                <header>
                    <button name="action_start" type="object"
                            string="Generate Tasks and Start"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_complete" type="object"
                            string="Complete" invisible="state != 'in_progress'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,in_progress,completed"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="partner_id"/>
                            <field name="template_id"/>
                            <field name="owner_id"/>
                        </group>
                        <group>
                            <field name="progress" widget="progressbar"/>
                            <field name="first_order_id"/>
                            <field name="completed_date" readonly="1"/>
                            <field name="company_id"
                                   groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <field name="task_ids" invisible="state == 'draft'">
                        <list editable="bottom" decoration-success="done">
                            <field name="sequence" widget="handle"/>
                            <field name="step_type"/>
                            <field name="name"/>
                            <field name="responsible_id"/>
                            <field name="done" widget="boolean_toggle"/>
                            <field name="done_date" readonly="1"/>
                        </list>
                    </field>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_cob_list" model="ir.ui.view">
        <field name="name">sf.customer.onboarding.list</field>
        <field name="model">sf.customer.onboarding</field>
        <field name="arch" type="xml">
            <list string="Customer Onboardings" sample="1">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="owner_id"/>
                <field name="progress" widget="progressbar"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'completed'"/>
            </list>
        </field>
    </record>
    <record id="view_sf_cob_template_form" model="ir.ui.view">
        <field name="name">sf.cob.template.form</field>
        <field name="model">sf.cob.template</field>
        <field name="arch" type="xml">
            <form string="Onboarding Template">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                    <field name="step_ids">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="step_type"/>
                            <field name="name"/>
                            <field name="description"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>
    <menuitem id="menu_sf_cob_root" name="Customer Onboarding" sequence="26"
              parent="sale.sale_menu_root"/>
    <menuitem id="menu_sf_cob_cases" name="Onboardings"
              parent="menu_sf_cob_root" action="action_sf_cob" sequence="10"/>
    <menuitem id="menu_sf_cob_templates" name="Templates"
              parent="menu_sf_cob_root" action="action_sf_cob_template"
              sequence="20"/>

    <record id="view_sf_customer_onboarding_boost_kanban" model="ir.ui.view">
        <field name="name">sf_customer_onboarding.boost.kanban</field>
        <field name="model">sf.cob.template</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" t-att-color="state">
                <field name="name"/>
                <field name="state"/>

                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_card oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title">
                                    <field name="name"/></strong>
                                <div class="o_kanban_record_subtitle">
                                    <field name="user_id" widget="many2one_avatar_user"/>
                                    <field name="create_date"/></div>
                            </div>
                            <div class="oe_kanban_bottom_right">
                                <field name="state" widget="badge"
                                       t-attf-options="{'classes_map': {'draft': 'info', 'done': 'success', 'cancelled': 'danger'}, 'domain': []}"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_sf_customer_onboarding_boost_search" model="ir.ui.view">
        <field name="name">sf_customer_onboarding.boost.search</field>
        <field name="model">sf.cob.template</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
<separator/>
                <filter string="To Do" name="todo" domain="[('state', 'not in', ('done', 'cancelled', 'closed'))]"/>
                <group expand="0" string="Group By"><filter string="Status" name="gb_state" context="{'group_by': 'state'}"/></group>
            </search>
        </field>
    </record>
</odoo>
