<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_quote_followup_cadence" model="ir.module.category">
        <field name="name">Quote Follow-up Cadence</field>
        <field name="sequence">49</field>
    </record>
    <record id="group_quote_followup_cadence_user" model="res.groups">
        <field name="name">Quote Follow-up Cadence User</field>
        <field name="category_id" ref="module_category_quote_followup_cadence"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>

    </record>
    <record id="group_quote_followup_cadence_manager" model="res.groups">
        <field name="name">Quote Follow-up Cadence Manager</field>
        <field name="category_id" ref="module_category_quote_followup_cadence"/>
        <field name="implied_ids" eval="[(4, ref('group_quote_followup_cadence_user'))]"/>
    </record>
    <record id="rule_quote_followup_cadence_sf_quote_followup" model="ir.rule">
        <field name="name">Quote Follow-up: multi-company</field>
        <field name="model_id" ref="model_sf_quote_followup"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_quote_followup_cadence"/>
    </record>
</odoo>
