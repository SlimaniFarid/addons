<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_supplier_risk_mitigation_plan2" model="ir.module.category">
        <field name="name">Risk Mitigation Plan</field>
        <field name="sequence">669</field>
    </record>
    <record id="group_supplier_risk_mitigation_plan2_user" model="res.groups">
        <field name="name">Risk Mitigation Plan User</field>
        <field name="category_id" ref="module_category_supplier_risk_mitigation_plan2"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>

    </record>
    <record id="group_supplier_risk_mitigation_plan2_manager" model="res.groups">
        <field name="name">Risk Mitigation Plan Manager</field>
        <field name="category_id" ref="module_category_supplier_risk_mitigation_plan2"/>
        <field name="implied_ids" eval="[(4, ref('group_supplier_risk_mitigation_plan2_user'))]"/>
    </record>
    <record id="rule_supplier_risk_mitigation_plan2_sf_supplier_risk_mitigation_plan2" model="ir.rule">
        <field name="name">Risk Mitigation Plan: multi-company</field>
        <field name="model_id" ref="model_sf_supplier_risk_mitigation_plan2"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_supplier_risk_mitigation_plan2"/>
    </record>
</odoo>
