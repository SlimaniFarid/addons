<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_forecast_model" model="ir.actions.act_window">
        <field name="name">Forecast Models</field>
        <field name="res_model">forecast.model</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_forecast_prediction" model="ir.actions.act_window">
        <field name="name">Predictions</field>
        <field name="res_model">forecast.prediction</field>
        <field name="view_mode">list,pivot,graph</field>
    </record>
    <record id="action_forecast_config" model="ir.actions.act_window">
        <field name="name">Configuration</field>
        <field name="res_model">forecast.config</field>
        <field name="view_mode">form</field>
    </record>
    <record id="action_forecast_training_log" model="ir.actions.act_window">
        <field name="name">Training Logs</field>
        <field name="res_model">forecast.training.log</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_forecast_root" name="AI Demand Forecasting" web_icon="sf_ai_demand_forecast,static/description/icon.png"/>
    <menuitem id="menu_forecast_models" name="Models" parent="menu_forecast_root" action="action_forecast_model" sequence="10"/>
    <menuitem id="menu_forecast_predictions" name="Predictions" parent="menu_forecast_root" action="action_forecast_prediction" sequence="20"/>
    <menuitem id="menu_forecast_config" name="Configuration" parent="menu_forecast_root" action="action_forecast_config" sequence="30"/>
    <menuitem id="menu_forecast_logs" name="Training Logs" parent="menu_forecast_root" action="action_forecast_training_log" sequence="40"/>

    <record id="view_forecast_model_form" model="ir.ui.view">
        <field name="name">forecast.model.form</field>
        <field name="model">forecast.model</field>
        <field name="arch" type="xml">
            <form string="Forecast Model">
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="draft,training,trained,failed"/>
                    <button name="action_train" string="Train Model" type="object" class="btn-primary" invisible="state=='training'"/>
                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="algorithm"/>
                        <field name="active"/>
                    </group>
                    <group string="Scope">
                        <field name="product_ids" widget="many2many_tags"/>
                        <field name="warehouse_ids" widget="many2many_tags"/>
                        <field name="date_from"/>
                        <field name="date_to"/>
                    </group>
                    <group string="Hyperparameters">
                        <field name="n_estimators"/>
                        <field name="max_depth"/>
                        <field name="learning_rate"/>
                        <field name="min_samples_split"/>
                    </group>
                    <group string="Features">
                        <field name="use_lags"/>
                        <field name="use_rolling"/>
                        <field name="use_calendar"/>
                        <field name="use_promos"/>
                        <field name="use_price"/>
                    </group>
                    <group string="Metrics" invisible="state != 'trained'">
                        <field name="mae"/>
                        <field name="mape"/>
                        <field name="rmse"/>
                        <field name="bias"/>
                        <field name="training_samples"/>
                        <field name="validation_samples"/>
                        <field name="training_duration"/>
                        <field name="last_trained"/>
                    </group>
                    <group string="Error" invisible="state != 'failed'">
                        <field name="error_message" widget="text" readonly="1"/>
                    </group>
                    <notebook>
                        <page string="Predictions">
                            <field name="prediction_ids">
                                <list>
                                    <field name="product_id"/>
                                    <field name="warehouse_id"/>
                                    <field name="date"/>
                                    <field name="predicted_qty"/>
                                    <field name="lower_bound"/>
                                    <field name="upper_bound"/>
                                    <field name="confidence"/>
                                </list>
                            </field>
                        </page>
                        <page string="Training Logs">
                            <field name="training_log_ids">
                                <list>
                                    <field name="create_date"/>
                                    <field name="status"/>
                                    <field name="message"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_forecast_model_list" model="ir.ui.view">
        <field name="name">forecast.model.list</field>
        <field name="model">forecast.model</field>
        <field name="arch" type="xml">
            <list string="Forecast Models">
                <field name="name"/>
                <field name="algorithm"/>
                <field name="state" widget="badge" decoration-success="state=='trained'" decoration-danger="state=='failed'" decoration-warning="state=='training'" decoration-muted="state=='draft'"/>
                <field name="mae" invisible="state!='trained'"/>
                <field name="mape" invisible="state!='trained'"/>
                <field name="last_trained"/>
            </list>
        </field>
    </record>

    <record id="view_forecast_prediction_list" model="ir.ui.view">
        <field name="name">forecast.prediction.list</field>
        <field name="model">forecast.prediction</field>
        <field name="arch" type="xml">
            <list string="Predictions">
                <field name="model_id"/>
                <field name="product_id"/>
                <field name="warehouse_id"/>
                <field name="date"/>
                <field name="predicted_qty"/>
                <field name="lower_bound"/>
                <field name="upper_bound"/>
                <field name="confidence"/>
            </list>
        </field>
    </record>

    <record id="view_forecast_prediction_pivot" model="ir.ui.view">
        <field name="name">forecast.prediction.pivot</field>
        <field name="model">forecast.prediction</field>
        <field name="arch" type="xml">
            <pivot string="Predictions Pivot">
                <field name="model_id" type="row"/>
                <field name="product_id" type="row"/>
                <field name="warehouse_id" type="col"/>
                <field name="predicted_qty" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_forecast_config_form" model="ir.ui.view">
        <field name="name">forecast.config.form</field>
        <field name="model">forecast.config</field>
        <field name="arch" type="xml">
            <form string="Forecast Configuration">
                <sheet>
                    <group>
                        <field name="auto_retrain"/>
                        <field name="retrain_frequency"/>
                        <field name="prediction_horizon_days"/>
                        <field name="min_training_samples"/>
                        <field name="confidence_level"/>
                        <field name="service_level_target"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>