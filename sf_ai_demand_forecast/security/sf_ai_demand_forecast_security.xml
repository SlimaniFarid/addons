<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_sf_ai_demand_forecast" model="ir.module.category">
        <field name="name">AI Demand Forecast</field>
        <field name="description">AI Demand Forecast Management</field>
        <field name="sequence">10</field>
    </record>

    <record id="group_sf_ai_demand_forecast_user" model="res.groups">
        <field name="name">AI Demand Forecast / User</field>
        <field name="category_id" ref="module_category_sf_ai_demand_forecast"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_sf_ai_demand_forecast_manager" model="res.groups">
        <field name="name">AI Demand Forecast / Manager</field>
        <field name="category_id" ref="module_category_sf_ai_demand_forecast"/>
        <field name="implied_ids" eval="[(4, ref('sf_ai_demand_forecast.group_sf_ai_demand_forecast_user'))]"/>
    </record>

    <record id="rule_sf_ai_demand_forecast_company" model="ir.rule">
        <field name="name">AI Demand Forecast: user sees own company</field>
        <field name="model_id" ref="model_sf_ai_demand_forecast"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('sf_ai_demand_forecast.group_sf_ai_demand_forecast_user'))]"/>
    </record>
    <record id="rule_sf_ai_demand_forecast_manager_all" model="ir.rule">
        <field name="name">AI Demand Forecast: manager sees all companies</field>
        <field name="model_id" ref="model_sf_ai_demand_forecast"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('sf_ai_demand_forecast.group_sf_ai_demand_forecast_manager'))]"/>
    </record>
</odoo>