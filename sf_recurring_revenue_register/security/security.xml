<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_recurring_revenue_register" model="ir.module.category">
        <field name="name">Recurring Revenue Register (MRR)</field>
        <field name="sequence">16</field>
    </record>
    <record id="group_recurring_revenue_register_user" model="res.groups">
        <field name="name">Recurring Revenue Register (MRR) User</field>
        <field name="category_id" ref="module_category_recurring_revenue_register"/>

    </record>
    <record id="group_recurring_revenue_register_manager" model="res.groups">
        <field name="name">Recurring Revenue Register (MRR) Manager</field>
        <field name="category_id" ref="module_category_recurring_revenue_register"/>
        <field name="implied_ids" eval="[(4, ref('group_recurring_revenue_register_user'))]"/>
    </record>
    <record id="rule_recurring_revenue_register_sf_mrr_line" model="ir.rule">
        <field name="name">Recurring Revenue Line: multi-company</field>
        <field name="model_id" ref="model_sf_mrr_line"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_recurring_revenue_register"/>
    </record>
</odoo>
