<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_inventory_shrinkage_tracker" model="ir.module.category">
        <field name="name">Inventory Shrinkage Tracker</field>
        <field name="sequence">687</field>
    </record>
    <record id="group_inventory_shrinkage_tracker_user" model="res.groups">
        <field name="name">Inventory Shrinkage Tracker User</field>
        <field name="category_id" ref="module_category_inventory_shrinkage_tracker"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>

    </record>
    <record id="group_inventory_shrinkage_tracker_manager" model="res.groups">
        <field name="name">Inventory Shrinkage Tracker Manager</field>
        <field name="category_id" ref="module_category_inventory_shrinkage_tracker"/>
        <field name="implied_ids" eval="[(4, ref('group_inventory_shrinkage_tracker_user'))]"/>
    </record>
    <record id="rule_inventory_shrinkage_tracker_sf_inventory_shrinkage_tracker" model="ir.rule">
        <field name="name">Inventory Shrinkage Tracker: multi-company</field>
        <field name="model_id" ref="model_sf_inventory_shrinkage_tracker"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
