<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sf_salon_service_view_list" model="ir.ui.view">
        <field name="name">sf.salon.service.list</field>
        <field name="model">sf.salon.service</field>
        <field name="arch" type="xml">
            <list string="Services">
                <field name="name"/>
                <field name="category"/>
                <field name="duration"/>
                <field name="price"/>
                <field name="commission_rate" groups="sf_salon_beauty.group_sf_salon_manager"/>
                <field name="commission_rate" readonly="1" groups="!sf_salon_beauty.group_sf_salon_manager"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="sf_salon_service_view_form" model="ir.ui.view">
        <field name="name">sf.salon.service.form</field>
        <field name="model">sf.salon.service</field>
        <field name="arch" type="xml">
            <form string="Service">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="category"/>
                            <field name="duration"/>
                            <field name="price"/>
                            <field name="commission_rate" groups="sf_salon_beauty.group_sf_salon_manager"/>
                            <field name="commission_rate" readonly="1" groups="!sf_salon_beauty.group_sf_salon_manager"/>
                        </group>
                        <group>
                            <field name="product_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_sf_salon_service" model="ir.actions.act_window">
        <field name="name">Services</field>
        <field name="res_model">sf.salon.service</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>