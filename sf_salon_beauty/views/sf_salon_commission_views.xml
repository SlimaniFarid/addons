<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sf_salon_commission_view_list" model="ir.ui.view">
        <field name="name">sf.salon.commission.list</field>
        <field name="model">sf.salon.commission</field>
        <field name="arch" type="xml">
            <list decoration-danger="is_overdue" string="Commissions">
                <field name="name"/>
                <field name="period"/>
                <field name="staff_id"/>
                <field name="amount"/>
                <field name="state" widget="badge"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="sf_salon_commission_view_form" model="ir.ui.view">
        <field name="name">sf.salon.commission.form</field>
        <field name="model">sf.salon.commission</field>
        <field name="arch" type="xml">
            <form string="Commission">
                <header>
                    <button name="action_compute" string="Compute" type="object" class="btn-primary" invisible="[('state', '!=', 'draft')]"/>
                    <button name="action_paid" string="Mark Paid" type="object" class="btn-primary" groups="sf_salon_beauty.group_sf_salon_manager" invisible="[('state', '!=', 'computed')]"/>
                    <field name="state" widget="statusbar" readonly="1"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="staff_id"/>
                            <field name="period"/>
                            <field name="amount"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_sf_salon_commission" model="ir.actions.act_window">
        <field name="name">Commissions</field>
        <field name="res_model">sf.salon.commission</field>
        <field name="view_mode">kanban,list,form</field>
    </record>

    <record id="view_sf_salon_beauty_boost_kanban" model="ir.ui.view">
        <field name="name">sf_salon_beauty.boost.kanban</field>
        <field name="model">sf.salon.activity.mixin</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" t-att-color="state">
                <field name="name"/>
                <field name="state"/>
                <field name="user_id"/>
                <field name="expiration_date"/>
                <field name="is_overdue" invisible="1"/>

                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_card oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title">
                                    <field name="name"/></strong>
                                <div class="o_kanban_record_subtitle">
                                    <field name="user_id" widget="many2one_avatar_user"/>
                                    <field name="expiration_date"/></div>
                            </div>
                            <div class="oe_kanban_bottom_right">
                                <field name="state" widget="badge"
                                       t-attf-options="{'classes_map': {'draft': 'info', 'done': 'success', 'cancelled': 'danger'}, 'domain': []}"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_sf_salon_beauty_boost_search" model="ir.ui.view">
        <field name="name">sf_salon_beauty.boost.search</field>
        <field name="model">sf.salon.activity.mixin</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
<separator/>
                <filter string="My records" name="my_records" domain="[('user_id', '=', uid)]"/>
                <filter string="To Do" name="todo" domain="[('state', 'not in', ('done', 'cancelled', 'closed'))]"/>
                <group expand="0" string="Group By"><filter string="Status" name="gb_state" context="{'group_by': 'state'}"/></group>
            </search>
        </field>
    </record>
</odoo>
