<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sf_salon_staff_view_list" model="ir.ui.view">
        <field name="name">sf.salon.staff.list</field>
        <field name="model">sf.salon.staff</field>
        <field name="arch" type="xml">
            <list string="Staff">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="commission_rate" groups="sf_salon_beauty.group_sf_salon_manager"/>
                <field name="commission_rate" readonly="1" groups="!sf_salon_beauty.group_sf_salon_manager"/>
                <field name="active"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="sf_salon_staff_view_form" model="ir.ui.view">
        <field name="name">sf.salon.staff.form</field>
        <field name="model">sf.salon.staff</field>
        <field name="arch" type="xml">
            <form string="Staff">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="commission_rate" groups="sf_salon_beauty.group_sf_salon_manager"/>
                            <field name="commission_rate" readonly="1" groups="!sf_salon_beauty.group_sf_salon_manager"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="service_ids" widget="many2many_tags"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_sf_salon_staff" model="ir.actions.act_window">
        <field name="name">Staff</field>
        <field name="res_model">sf.salon.staff</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>