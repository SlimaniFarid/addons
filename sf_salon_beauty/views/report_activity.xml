<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_activity">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-set="company" t-value="o.company_id or res_company"/>
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>Salon Activity Report</h2>
                        <table class="table table-sm">
                            <tr><th>Appointment</th><th>Customer</th><th>Staff</th><th>Service</th><th>Start</th><th>Status</th></tr>
                            <tr t-foreach="o" t-as="a">
                                <td><span t-field="a.name"/></td>
                                <td><span t-field="a.partner_id"/></td>
                                <td><span t-field="a.staff_id"/></td>
                                <td><span t-field="a.service_id"/></td>
                                <td><span t-field="a.start_datetime"/></td>
                                <td><span t-field="a.state"/></td>
                            </tr>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>