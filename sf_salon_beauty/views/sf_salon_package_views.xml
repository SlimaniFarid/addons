<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sf_salon_package_view_list" model="ir.ui.view">
        <field name="name">sf.salon.package.list</field>
        <field name="model">sf.salon.package</field>
        <field name="arch" type="xml">
            <list string="Packages">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="service_id"/>
                <field name="sessions_total"/>
                <field name="sessions_used"/>
                <field name="sessions_left"/>
                <field name="amount"/>
                <field name="state" widget="badge"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="sf_salon_package_view_form" model="ir.ui.view">
        <field name="name">sf.salon.package.form</field>
        <field name="model">sf.salon.package</field>
        <field name="arch" type="xml">
            <form string="Package">
                <header>
                    <button name="action_refund" string="Refund" type="object" groups="sf_salon_beauty.group_sf_salon_manager" invisible="[('state', 'in', ('exhausted', 'refunded'))]"/>
                    <field name="state" widget="statusbar" readonly="1"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="service_id"/>
                            <field name="sessions_total"/>
                            <field name="sessions_used"/>
                            <field name="sessions_left"/>
                        </group>
                        <group>
                            <field name="amount"/>
                            <field name="expiration_date"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_sf_salon_package" model="ir.actions.act_window">
        <field name="name">Packages</field>
        <field name="res_model">sf.salon.package</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>