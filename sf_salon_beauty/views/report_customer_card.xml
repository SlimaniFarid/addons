<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_customer_card">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-set="company" t-value="o.company_id or res_company"/>
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>Customer Card</h2>
                        <table class="table table-sm">
                            <tr><th>Appointment</th><td><span t-field="o.name"/></td></tr>
                            <tr><th>Customer</th><td><span t-field="o.partner_id"/></td></tr>
                            <tr><th>Staff</th><td><span t-field="o.staff_id"/></td></tr>
                            <tr><th>Service</th><td><span t-field="o.service_id"/></td></tr>
                            <tr><th>Start</th><td><span t-field="o.start_datetime"/></td></tr>
                            <tr><th>Status</th><td><span t-field="o.state"/></td></tr>
                        </table>
                        <h3>Packages</h3>
                        <table class="table table-sm">
                            <tr><th>Package</th><th>Service</th><th>Sessions Used</th><th>Sessions Left</th></tr>
                            <tr t-foreach="o.partner_id.salon_package_ids.filtered(lambda p: p.company_id.id == o.company_id.id)" t-as="p">
                                <td><span t-field="p.name"/></td>
                                <td><span t-field="p.service_id"/></td>
                                <td><span t-field="p.sessions_used"/></td>
                                <td><span t-field="p.sessions_left"/></td>
                            </tr>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>