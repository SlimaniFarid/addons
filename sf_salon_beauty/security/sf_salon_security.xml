            <field name="model_id" ref="model_sf_salon_commission"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('sf_salon_beauty.group_sf_salon_manager'))]"/>
        </record>
    </data>
</odoo>