        </record>
        <record id="rule_sf_salon_package_manager_all" model="ir.rule">
            <field name="name">Salon Package: manager sees all companies</field>
            <field name="model_id" ref="model_sf_salon_package"/>
            <field name="domain_force">[(1, '=', 1)]</field>
