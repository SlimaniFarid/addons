<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="module_category_sf_salon" model="ir.module.category">
            <field name="name">Salon</field>
            <field name="description">Salon &amp; Beauty Studio Management.</field>
            <field name="sequence">10</field>
        </record>

        <record id="group_sf_salon_user" model="res.groups">
            <field name="name">Salon / User</field>
            <field name="category_id" ref="module_category_sf_salon"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_sf_salon_manager" model="res.groups">
            <field name="name">Salon / Manager</field>
            <field name="category_id" ref="module_category_sf_salon"/>
            <field name="implied_ids" eval="[(4, ref('sf_salon_beauty.group_sf_salon_user'))]"/>
        </record>

        <record id="rule_sf_salon_appointment_company" model="ir.rule">
            <field name="name">Salon Appointment: user sees own company</field>
            <field name="model_id" ref="model_sf_salon_appointment"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('sf_salon_beauty.group_sf_salon_user'))]"/>
        </record>
        <record id="rule_sf_salon_appointment_manager_all" model="ir.rule">
            <field name="name">Salon Appointment: manager sees all companies</field>
            <field name="model_id" ref="model_sf_salon_appointment"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('sf_salon_beauty.group_sf_salon_manager'))]"/>
        </record>

        <record id="rule_sf_salon_staff_company" model="ir.rule">
            <field name="name">Salon Staff: user sees own company</field>
            <field name="model_id" ref="model_sf_salon_staff"/>
