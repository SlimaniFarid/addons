            <field name="model_id" ref="model_sf_salon_staff"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('sf_salon_beauty.group_sf_salon_manager'))]"/>
        </record>

        <record id="rule_sf_salon_service_company" model="ir.rule">
            <field name="name">Salon Service: user sees own company</field>
            <field name="model_id" ref="model_sf_salon_service"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('sf_salon_beauty.group_sf_salon_user'))]"/>
        </record>
        <record id="rule_sf_salon_service_manager_all" model="ir.rule">
            <field name="name">Salon Service: manager sees all companies</field>
            <field name="model_id" ref="model_sf_salon_service"/>
            <field name="domain_force">[(1, '=', 1)]</field>
