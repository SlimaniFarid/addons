<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_commissions">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-set="company" t-value="o.company_id or res_company"/>
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>Commissions Report</h2>
                        <table class="table table-sm">
                            <tr><th>Commission</th><th>Period</th><th>Staff</th><th>Amount</th><th>Status</th></tr>
                            <tr t-foreach="o" t-as="c">
                                <td><span t-field="c.name"/></td>
                                <td><span t-field="c.period"/></td>
                                <td><span t-field="c.staff_id"/></td>
                                <td><span t-field="c.amount"/></td>
                                <td><span t-field="c.state"/></td>
                            </tr>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>