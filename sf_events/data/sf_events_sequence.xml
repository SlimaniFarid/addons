<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="seq_sf_event" model="ir.sequence">
            <field name="name">Event</field>
            <field name="code">sf.event</field>
            <field name="prefix">EVT-</field>
            <field name="padding">4</field>
            <field name="number_increment">1</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_sf_event_session" model="ir.sequence">
            <field name="name">Event Session</field>
            <field name="code">sf.event.session</field>
            <field name="prefix">SES-</field>
