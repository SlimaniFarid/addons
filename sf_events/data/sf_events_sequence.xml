            <field name="number_increment">1</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_sf_event_registration" model="ir.sequence">
            <field name="name">Event Registration</field>
            <field name="code">sf.event.registration</field>
            <field name="prefix">REG-</field>
            <field name="padding">4</field>
            <field name="number_increment">1</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_sf_event_expense" model="ir.sequence">
            <field name="name">Event Expense</field>
            <field name="code">sf.event.expense</field>
            <field name="prefix">EXP-</field>
            <field name="padding">4</field>
            <field name="number_increment">1</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
