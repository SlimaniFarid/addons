<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="module_category_sf_events" model="ir.module.category">
            <field name="name">Events</field>
            <field name="description">Events &amp; Conferences Management.</field>
            <field name="sequence">10</field>
        </record>

        <record id="group_sf_events_user" model="res.groups">
            <field name="name">Events / User</field>
            <field name="category_id" ref="module_category_sf_events"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_sf_events_manager" model="res.groups">
            <field name="name">Events / Manager</field>
            <field name="category_id" ref="module_category_sf_events"/>
            <field name="implied_ids" eval="[(4, ref('sf_events.group_sf_events_user'))]"/>
        </record>

        <record id="rule_sf_event_company" model="ir.rule">
            <field name="name">Event: user sees own company</field>
            <field name="model_id" ref="model_sf_event"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('sf_events.group_sf_events_user'))]"/>
        </record>
        <record id="rule_sf_event_manager_all" model="ir.rule">
            <field name="name">Event: manager sees all companies</field>
            <field name="model_id" ref="model_sf_event"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('sf_events.group_sf_events_manager'))]"/>
        </record>

        <record id="rule_sf_event_session_company" model="ir.rule">
            <field name="name">Event Session: user sees own company</field>
            <field name="model_id" ref="model_sf_event_session"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('sf_events.group_sf_events_user'))]"/>
        </record>
        <record id="rule_sf_event_session_manager_all" model="ir.rule">
            <field name="name">Event Session: manager sees all companies</field>
            <field name="model_id" ref="model_sf_event_session"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('sf_events.group_sf_events_manager'))]"/>
        </record>

        <record id="rule_sf_event_registration_company" model="ir.rule">
            <field name="name">Event Registration: user sees own company</field>
            <field name="model_id" ref="model_sf_event_registration"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('sf_events.group_sf_events_user'))]"/>
        </record>
        <record id="rule_sf_event_registration_manager_all" model="ir.rule">
            <field name="name">Event Registration: manager sees all companies</field>
            <field name="model_id" ref="model_sf_event_registration"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('sf_events.group_sf_events_manager'))]"/>
        </record>

        <record id="rule_sf_event_expense_company" model="ir.rule">
            <field name="name">Event Expense: user sees own company</field>
            <field name="model_id" ref="model_sf_event_expense"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('sf_events.group_sf_events_user'))]"/>
        </record>
        <record id="rule_sf_event_expense_manager_all" model="ir.rule">
            <field name="name">Event Expense: manager sees all companies</field>
            <field name="model_id" ref="model_sf_event_expense"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('sf_events.group_sf_events_manager'))]"/>
        </record>
    </data>
    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_sf_events"/>
    </record>
</odoo>