<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_event_budget">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-set="company" t-value="o.company_id or res_company"/>
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>Event Budget Report</h2>
                        <table class="table table-sm">
                            <tr><th>Event</th><td><span t-field="o.name"/></td></tr>
                            <tr><th>Budget</th><td><span t-field="o.budget"/></td></tr>
                            <tr><th>Revenue</th><td><span t-field="o.revenue"/></td></tr>
                            <tr><th>Expenses</th><td><span t-field="o.expenses_total"/></td></tr>
                            <tr><th>Balance</th><td><span t-field="o.balance"/></td></tr>
                        </table>
                        <h3>Expenses</h3>
                        <table class="table table-sm">
                            <tr><th>Expense</th><th>Category</th><th>Amount</th><th>Date</th></tr>
                            <tr t-foreach="o.expense_ids" t-as="exp">
                                <td><span t-field="exp.name"/></td>
                                <td><span t-field="exp.category"/></td>
                                <td><span t-field="exp.amount"/></td>
                                <td><span t-field="exp.expense_date"/></td>
                            </tr>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>