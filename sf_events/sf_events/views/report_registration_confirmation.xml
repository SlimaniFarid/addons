<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_registration_confirmation">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-set="company" t-value="o.company_id or res_company"/>
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>Registration Confirmation</h2>
                        <table class="table table-sm">
                            <tr><th>Registration</th><td><span t-field="o.name"/></td></tr>
                            <tr><th>Event</th><td><span t-field="o.event_id.name"/></td></tr>
                            <tr><th>Attendee</th><td><span t-field="o.attendee_name"/></td></tr>
                            <tr><th>Email</th><td><span t-field="o.attendee_email"/></td></tr>
                            <tr><th>Ticket</th><td><span t-field="o.ticket_type"/></td></tr>
                            <tr><th>Price</th><td><span t-field="o.price_unit"/></td></tr>
                        </table>
                        <h3>Sessions</h3>
                        <table class="table table-sm">
                            <tr><th>Session</th><th>Start</th><th>Room</th></tr>
                            <tr t-foreach="o.session_ids" t-as="session">
                                <td><span t-field="session.name"/></td>
                                <td><span t-field="session.start_datetime"/></td>
                                <td><span t-field="session.room"/></td>
                            </tr>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>