<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sf_event_expense_view_list" model="ir.ui.view">
        <field name="name">sf.event.expense.list</field>
        <field name="model">sf.event.expense</field>
        <field name="arch" type="xml">
            <list decoration-danger="is_overdue" string="Expenses">
                <field name="name"/>
                <field name="event_id"/>
                <field name="category"/>
                <field name="amount"/>
                <field name="vendor_partner_id"/>
                <field name="expense_date"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="sf_event_expense_view_form" model="ir.ui.view">
        <field name="name">sf.event.expense.form</field>
        <field name="model">sf.event.expense</field>
        <field name="arch" type="xml">
            <form string="Expense">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="event_id"/>
                            <field name="category"/>
                            <field name="amount"/>
                        </group>
                        <group>
                            <field name="vendor_partner_id"/>
                            <field name="expense_date"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="sf_event_expense_view_search" model="ir.ui.view">
        <field name="name">sf.event.expense.search</field>
        <field name="model">sf.event.expense</field>
        <field name="arch" type="xml">
            <search string="Expenses">
                <field name="name"/>
                <field name="event_id"/>
                <field name="category"/>
                <group>
                    <filter name="group_expense_category" string="Category" context="{'group_by': 'category'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_sf_event_expense" model="ir.actions.act_window">
        <field name="name">Expenses</field>
        <field name="res_model">sf.event.expense</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="sf_event_expense_view_search"/>
    </record>

    <record id="view_sf_events_boost_kanban" model="ir.ui.view">
        <field name="name">sf_events.boost.kanban</field>
        <field name="model">sf.event</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" t-att-color="state">
                <field name="name"/>
                <field name="state"/>
                <field name="user_id"/>
                <field name="end_date"/>
                <field name="is_overdue" invisible="1"/>

                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_card oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title">
                                    <field name="name"/></strong>
                                <div class="o_kanban_record_subtitle">
                                    <field name="user_id" widget="many2one_avatar_user"/>
                                    <field name="end_date"/></div>
                            </div>
                            <div class="oe_kanban_bottom_right">
                                <field name="state" widget="badge"
                                       t-attf-options="{'classes_map': {'draft': 'info', 'done': 'success', 'cancelled': 'danger'}, 'domain': []}"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_sf_events_boost_search" model="ir.ui.view">
        <field name="name">sf_events.boost.search</field>
        <field name="model">sf.event</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
<separator/>
                <filter string="My records" name="my_records" domain="[('user_id', '=', uid)]"/>
                <filter string="To Do" name="todo" domain="[('state', 'not in', ('done', 'cancelled', 'closed'))]"/>
                <group expand="0" string="Group By"><filter string="Status" name="gb_state" context="{'group_by': 'state'}"/></group>
            </search>
        </field>
    </record>
</odoo>
