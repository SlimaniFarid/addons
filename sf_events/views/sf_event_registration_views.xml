<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sf_event_registration_view_list" model="ir.ui.view">
        <field name="name">sf.event.registration.list</field>
        <field name="model">sf.event.registration</field>
        <field name="arch" type="xml">
            <list string="Registrations">
                <field name="name"/>
                <field name="event_id"/>
                <field name="attendee_name"/>
                <field name="attendee_email"/>
                <field name="ticket_type"/>
                <field name="price_unit"/>
                <field name="check_in_date"/>
                <field name="state" widget="badge"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="sf_event_registration_view_form" model="ir.ui.view">
        <field name="name">sf.event.registration.form</field>
        <field name="model">sf.event.registration</field>
        <field name="arch" type="xml">
            <form string="Registration">
                <header>
                    <button name="action_confirm" string="Confirm" type="object" class="btn-primary" invisible="[('state', '!=', 'draft')]"/>
                    <button name="action_check_in" string="Check In" type="object" class="btn-primary" invisible="[('state', '!=', 'confirmed')]"/>
                    <button name="action_done" string="Mark Done" type="object" class="btn-primary" invisible="[('state', 'not in', ('confirmed', 'checked_in'))]"/>
                    <button name="action_cancel" string="Cancel" type="object" invisible="[('state', 'not in', ('draft', 'confirmed'))]"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="event_id"/>
                            <field name="partner_id"/>
                            <field name="attendee_name"/>
                            <field name="attendee_email"/>
                        </group>
                        <group>
                            <field name="ticket_type"/>
                            <field name="price_unit"/>
                            <field name="check_in_date"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group string="Sessions">
                        <field name="session_ids" widget="many2many_tags"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="sf_event_registration_view_search" model="ir.ui.view">
        <field name="name">sf.event.registration.search</field>
        <field name="model">sf.event.registration</field>
        <field name="arch" type="xml">
            <search string="Registrations">
                <field name="name"/>
                <field name="event_id"/>
                <field name="attendee_name"/>
                <field name="ticket_type"/>
                <group>
                    <filter name="group_registration_state" string="Status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_sf_event_registration" model="ir.actions.act_window">
        <field name="name">Registrations</field>
        <field name="res_model">sf.event.registration</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="sf_event_registration_view_search"/>
    </record>
</odoo>