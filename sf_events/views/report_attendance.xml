<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_attendance">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-set="company" t-value="o.company_id or res_company"/>
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>Attendance Report</h2>
                        <table class="table table-sm">
                            <tr><th>Event</th><td><span t-field="o.name"/></td></tr>
                            <tr><th>Capacity</th><td><span t-field="o.capacity"/></td></tr>
                        </table>
                        <h3>Registrations</h3>
                        <table class="table table-sm">
                            <tr><th>Registration</th><th>Attendee</th><th>Ticket</th><th>Status</th><th>Check-in</th></tr>
                            <tr t-foreach="o.registration_ids" t-as="reg">
                                <td><span t-field="reg.name"/></td>
                                <td><span t-field="reg.attendee_name"/></td>
                                <td><span t-field="reg.ticket_type"/></td>
                                <td><span t-field="reg.state"/></td>
                                <td><span t-field="reg.check_in_date"/></td>
                            </tr>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>