<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sf_event_session_view_list" model="ir.ui.view">
        <field name="name">sf.event.session.list</field>
        <field name="model">sf.event.session</field>
        <field name="arch" type="xml">
            <list string="Sessions">
                <field name="name"/>
                <field name="event_id"/>
                <field name="start_datetime"/>
                <field name="end_datetime"/>
                <field name="room"/>
                <field name="speaker_ids" widget="many2many_tags"/>
                <field name="capacity"/>
                <field name="state" widget="badge"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="sf_event_session_view_form" model="ir.ui.view">
        <field name="name">sf.event.session.form</field>
        <field name="model">sf.event.session</field>
        <field name="arch" type="xml">
            <form string="Session">
                <header>
                    <button name="action_confirm" string="Confirm" type="object" class="btn-primary" invisible="[('state', '!=', 'draft')]"/>
                    <button name="action_done" string="Mark Done" type="object" class="btn-primary" invisible="[('state', '!=', 'confirmed')]"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="event_id"/>
                            <field name="room"/>
                            <field name="capacity"/>
                        </group>
                        <group>
                            <field name="start_datetime"/>
                            <field name="end_datetime"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group string="Speakers">
                        <field name="speaker_ids" widget="many2many_tags"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="sf_event_session_view_search" model="ir.ui.view">
        <field name="name">sf.event.session.search</field>
        <field name="model">sf.event.session</field>
        <field name="arch" type="xml">
            <search string="Sessions">
                <field name="name"/>
                <field name="event_id"/>
                <field name="speaker_ids"/>
                <group>
                    <filter name="group_session_state" string="Status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_sf_event_session" model="ir.actions.act_window">
        <field name="name">Sessions</field>
        <field name="res_model">sf.event.session</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="sf_event_session_view_search"/>
    </record>
</odoo>