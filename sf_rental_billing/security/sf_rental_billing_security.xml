<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_sf_rental_billing" model="ir.module.category">
        <field name="name">Rental Billing &amp; Contracts</field>
        <field name="description">Rental Billing &amp; Contracts</field>
        <field name="sequence">10</field>
    </record>
    <record id="group_rental_billing_user" model="res.groups">
        <field name="name">Rental Billing &amp; Contracts / User</field>
        <field name="category_id" ref="module_category_sf_rental_billing"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_rental_billing_manager" model="res.groups">
        <field name="name">Rental Billing &amp; Contracts / Manager</field>
        <field name="category_id" ref="module_category_sf_rental_billing"/>
        <field name="implied_ids" eval="[(4, ref('sf_rental_billing.group_rental_billing_user'))]"/>
    </record>
    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_sf_rental_billing"/>
    </record>
</odoo>
