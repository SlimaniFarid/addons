<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rental_contract_list" model="ir.ui.view">
        <field name="name">sf.rental.billing.rental.contract.list</field>
        <field name="model">sf.rental.billing.rental.contract</field>
        <field name="arch" type="xml">
            <list string="Rental.Contract">
                <field name="partner_id"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="recurring_interval"/>
                <field name="amount"/>
                <field name="deposit_amount"/>
                <field name="state" widget="badge"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_rental_contract_form" model="ir.ui.view">
        <field name="name">sf.rental.billing.rental.contract.form</field>
        <field name="model">sf.rental.billing.rental.contract</field>
        <field name="arch" type="xml">
            <form string="Rental.Contract">
                <header>
                <field name="state" widget="badge"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" placeholder="Name"/></h1></div>
                    <group><group>
                            <field name="partner_id"/>
                            <field name="start_date"/>
                            <field name="end_date"/>
                            <field name="recurring_interval"/>
                            <field name="amount"/>
                            <field name="deposit_amount"/>
                            <field name="state"/>
                            <field name="invoice_count"/>
                    </group>
                    <group>
                        <field name="currency_id" invisible="1"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_rental_contract" model="ir.actions.act_window">
        <field name="name">Rental.Contract</field>
        <field name="res_model">sf.rental.billing.rental.contract</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
