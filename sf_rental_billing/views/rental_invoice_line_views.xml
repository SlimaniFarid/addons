<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rental_invoice_line_list" model="ir.ui.view">
        <field name="name">sf.rental.billing.rental.invoice.line.list</field>
        <field name="model">sf.rental.billing.rental.invoice.line</field>
        <field name="arch" type="xml">
            <list string="Rental.Invoice.Line">
                <field name="contract_id"/>
                <field name="period_start"/>
                <field name="period_end"/>
                <field name="amount"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_rental_invoice_line_form" model="ir.ui.view">
        <field name="name">sf.rental.billing.rental.invoice.line.form</field>
        <field name="model">sf.rental.billing.rental.invoice.line</field>
        <field name="arch" type="xml">
            <form string="Rental.Invoice.Line">
                <header>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" placeholder="Name"/></h1></div>
                    <group><group>
                            <field name="contract_id"/>
                            <field name="period_start"/>
                            <field name="period_end"/>
                            <field name="amount"/>
                    </group>
                    <group>
                        <field name="currency_id" invisible="1"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_rental_invoice_line" model="ir.actions.act_window">
        <field name="name">Rental.Invoice.Line</field>
        <field name="res_model">sf.rental.billing.rental.invoice.line</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
