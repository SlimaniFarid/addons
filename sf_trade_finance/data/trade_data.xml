<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_trade_instrument" model="ir.sequence">
            <field name="name">Trade Finance Instrument</field>
            <field name="code">sf.trade.instrument</field>
            <field name="prefix"></field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>

        <record id="cron_trade_expiry_alert" model="ir.cron">
            <field name="name">Trade Finance: Expiry Alerts</field>
            <field name="model_id" ref="model_sf_trade_instrument"/>
            <field name="state">code</field>
            <field name="code">model._check_trade_expiry_alerts()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="active">True</field>
        </record>
    </data>
</odoo>