<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_trade" model="ir.module.category">
        <field name="name">Trade Finance</field>
        <field name="sequence">91</field>
    </record>

    <record id="group_trade_user" model="res.groups">
        <field name="name">Trade Finance User</field>
        <field name="category_id" ref="module_category_trade"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_trade_manager" model="res.groups">
        <field name="name">Trade Finance Manager</field>
        <field name="category_id" ref="module_category_trade"/>
        <field name="implied_ids" eval="[(4, ref('group_trade_user'))]"/>
    </record>

    <record id="rule_trade_instrument_user_company" model="ir.rule">
        <field name="name">Instrument: user sees own company</field>
        <field name="model_id" ref="model_sf_trade_instrument"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_trade_user'))]"/>
    </record>

    <record id="rule_trade_document_user_company" model="ir.rule">
        <field name="name">Document: user sees own company</field>
        <field name="model_id" ref="model_sf_trade_instrument_document"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_trade_user'))]"/>
    </record>

    <record id="rule_trade_fee_user_company" model="ir.rule">
        <field name="name">Fee: user sees own company</field>
        <field name="model_id" ref="model_sf_trade_instrument_fee"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_trade_user'))]"/>
    </record>

    <record id="rule_trade_instrument_manager_all" model="ir.rule">
        <field name="name">Instrument: manager sees all companies</field>
        <field name="model_id" ref="model_sf_trade_instrument"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_trade_manager'))]"/>
    </record>

    <record id="rule_trade_document_manager_all" model="ir.rule">
        <field name="name">Document: manager sees all companies</field>
        <field name="model_id" ref="model_sf_trade_instrument_document"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_trade_manager'))]"/>
    </record>

    <record id="rule_trade_fee_manager_all" model="ir.rule">
        <field name="name">Fee: manager sees all companies</field>
        <field name="model_id" ref="model_sf_trade_instrument_fee"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_trade_manager'))]"/>
    </record>
</odoo>