<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_trade" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.trade</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='general_settings']" position="inside">
                <h2>Trade Finance</h2>
                <div class="row mt16 o_settings_container">
                    <div class="col-12 col-lg-6 o_setting_box">
                        <div class="o_setting_left_pane"></div>
                        <div class="o_setting_right_pane">
                            <label for="sf_trade_alert_days"/>
                            <div class="text-muted">
                                Number of days before an instrument expiry to
                                raise an alert.
                            </div>
                            <div class="content-group">
                                <div class="mt16">
                                    <field name="sf_trade_alert_days"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>