<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_sf_access_rights_manager" model="ir.module.category">
        <field name="name">Access Rights Manager</field>
        <field name="description">Access Rights Manager Management</field>
        <field name="sequence">10</field>
    </record>

    <record id="group_sf_access_rights_manager_user" model="res.groups">
        <field name="name">Access Rights Manager / User</field>
        <field name="category_id" ref="module_category_sf_access_rights_manager"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_sf_access_rights_manager_manager" model="res.groups">
        <field name="name">Access Rights Manager / Manager</field>
        <field name="category_id" ref="module_category_sf_access_rights_manager"/>
        <field name="implied_ids" eval="[(4, ref('sf_access_rights_manager.group_sf_access_rights_manager_user'))]"/>
    </record>

    <record id="rule_sf_access_rights_manager_company" model="ir.rule">
        <field name="name">Access Rights Manager: user sees own company</field>
        <field name="model_id" ref="model_sf_access_rights_manager"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('sf_access_rights_manager.group_sf_access_rights_manager_user'))]"/>
    </record>
    <record id="rule_sf_access_rights_manager_manager_all" model="ir.rule">
        <field name="name">Access Rights Manager: manager sees all companies</field>
        <field name="model_id" ref="model_sf_access_rights_manager"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('sf_access_rights_manager.group_sf_access_rights_manager_manager'))]"/>
    </record>
</odoo>