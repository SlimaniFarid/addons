<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_bom_change_request" model="ir.module.category">
        <field name="name">BOM Change Requests</field>
        <field name="sequence">19</field>
    </record>
    <record id="group_bom_change_request_user" model="res.groups">
        <field name="name">BOM Change Requests User</field>
        <field name="category_id" ref="module_category_bom_change_request"/>
        <field name="implied_ids" eval="[(4, ref('mrp.group_mrp_user'))]"/>

    </record>
    <record id="group_bom_change_request_manager" model="res.groups">
        <field name="name">BOM Change Requests Manager</field>
        <field name="category_id" ref="module_category_bom_change_request"/>
        <field name="implied_ids" eval="[(4, ref('group_bom_change_request_user'))]"/>
    </record>
    <record id="rule_bom_change_request_sf_bom_change" model="ir.rule">
        <field name="name">BOM Change Request: multi-company</field>
        <field name="model_id" ref="model_sf_bom_change"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
