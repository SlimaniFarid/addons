<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_succession_plan" model="ir.actions.act_window">
        <field name="name">Succession Plan Register</field>
        <field name="res_model">sf.succession_plan</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
    <record id="view_sf_succession_plan_form" model="ir.ui.view">
        <field name="name">sf.succession_plan.form</field>
        <field name="model">sf.succession_plan</field>
        <field name="arch" type="xml">
            <form string="Succession Plan Register">
                <header>
                    <button name="action_submitted" type="object" string="Submitted"
                            class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="position"/>
                            <field name="candidate_id"/>
                            <field name="readiness"/>
                        <field name="development_actions"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_succession_plan_list" model="ir.ui.view">
        <field name="name">sf.succession_plan.list</field>
        <field name="model">sf.succession_plan</field>
        <field name="arch" type="xml">
            <list string="Succession Plan Register" sample="1">
                <field name="position"/>
                <field name="candidate_id"/>
                <field name="readiness"/>
                <field name="development_actions"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state in ('submitted','approved')"/>
            </list>
        </field>
    </record>
    <record id="view_sf_succession_plan_kanban" model="ir.ui.view">
        <field name="name">sf.succession_plan.kanban</field>
        <field name="model">sf.succession_plan</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_view" group_by="state">
                <field name="name"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <menuitem id="menu_sf_succession_plan_root" name="Succession Plan Register" sequence="3"
              web_icon="sf_succession_plan,static/description/icon.png"/>
    <menuitem id="menu_sf_succession_plan_main" name="Records"
              parent="menu_sf_succession_plan_root" action="action_sf_succession_plan" sequence="10"/>
</odoo>
