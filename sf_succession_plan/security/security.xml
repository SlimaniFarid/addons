<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_succession_plan" model="ir.module.category">
        <field name="name">Succession Plan Register</field>
        <field name="sequence">198</field>
    </record>
    <record id="group_succession_plan_user" model="res.groups">
        <field name="name">Succession Plan Register User</field>
        <field name="category_id" ref="module_category_succession_plan"/>

    </record>
    <record id="group_succession_plan_manager" model="res.groups">
        <field name="name">Succession Plan Register Manager</field>
        <field name="category_id" ref="module_category_succession_plan"/>
        <field name="implied_ids" eval="[(4, ref('group_succession_plan_user'))]"/>
    </record>
    <record id="rule_succession_plan_sf_succession_plan" model="ir.rule">
        <field name="name">Succession Plan Register: multi-company</field>
        <field name="model_id" ref="model_sf_succession_plan"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_succession_plan"/>
    </record>
</odoo>
