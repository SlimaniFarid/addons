<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_sf_cr" model="ir.module.category">
        <field name="name">Change Management</field>
        <field name="sequence">69</field>
    </record>
    <record id="group_sf_cr_user" model="res.groups">
        <field name="name">Change Requester</field>
        <field name="category_id" ref="module_category_sf_cr"/>
    </record>
    <record id="group_sf_cr_manager" model="res.groups">
        <field name="name">CAB Member / Change Manager</field>
        <field name="category_id" ref="module_category_sf_cr"/>
        <field name="implied_ids" eval="[(4, ref('group_sf_cr_user'))]"/>
    </record>
    <record id="rule_sf_cr_company" model="ir.rule">
        <field name="name">Change Request: multi-company</field>
        <field name="model_id" ref="model_sf_change_request"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_sf_cr"/>
    </record>
</odoo>
