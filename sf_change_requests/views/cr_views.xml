<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_change_request" model="ir.actions.act_window">
        <field name="name">Change Requests</field>
        <field name="res_model">sf.change.request</field>
        <field name="view_mode">kanban,list,form,kanban</field>
    </record>
    <record id="view_sf_change_request_form" model="ir.ui.view">
        <field name="name">sf.change.request.form</field>
        <field name="model">sf.change.request</field>
        <field name="arch" type="xml">
            <form string="Change Request">
                <header>
                    <button name="action_submit" type="object"
                            string="Submit" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_open_cab" type="object"
                            string="Open CAB Review"
                            invisible="state != 'submitted'"/>
                    <button name="action_close_cab" type="object"
                            string="Close CAB (Decision)"
                            invisible="state != 'cab_review'"/>
                    <button name="action_implemented" type="object"
                            string="Implemented" invisible="state != 'approved'"/>
                    <button name="action_close" type="object" string="Close"
                            invisible="state != 'implemented'"/>
                    <button name="action_failed" type="object" string="Failed"
                            class="btn-danger" invisible="state != 'implemented'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,submitted,cab_review,approved,implemented,closed"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="title"/>
                            <field name="requester_id"/>
                            <field name="change_type"/>
                            <field name="risk_level" widget="radio"/>
                        </group>
                        <group>
                            <field name="implementer_id"/>
                            <field name="planned_date"/>
                            <field name="cab_date"/>
                            <field name="approval_percent" readonly="1"
                                   widget="progressbar"/>
                            <field name="company_id"
                                   groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description &amp; Impact" name="desc">
                            <group>
                                <group string="Change Description">
                                    <field name="description"/>
                                </group>
                                <group string="Impact Analysis">
                                    <field name="impact_analysis"/>
                                </group>
                            </group>
                        </page>
                        <page string="Plans" name="plans">
                            <group>
                                <group string="Implementation Plan">
                                    <field name="implementation_plan"/>
                                </group>
                                <group string="Rollback Plan">
                                    <field name="rollback_plan"
                                           readonly="state != 'draft'"/>
                                </group>
                            </group>
                        </page>
                        <page string="CAB Votes" name="votes"
                              invisible="state in ('draft',)">
                            <field name="vote_ids" readonly="state != 'cab_review'">
                                <list editable="bottom">
                                    <field name="member_id"/>
                                    <field name="vote"/>
                                    <field name="comment"/>
                                </list>
                            </field>
                        </page>
                        <page string="Post-Implementation Review" name="pir"
                              invisible="state not in ('implemented','closed','failed')">
                            <field name="post_impl_review"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_change_request_list" model="ir.ui.view">
        <field name="name">sf.change.request.list</field>
        <field name="model">sf.change.request</field>
        <field name="arch" type="xml">
            <list string="Change Requests" sample="1">
                <field name="name"/>
                <field name="title"/>
                <field name="change_type"/>
                <field name="risk_level" widget="badge"
                       decoration-danger="risk_level == 'high'"
                       decoration-warning="risk_level == 'medium'"/>
                <field name="cab_date" optional="show"/>
                <field name="approval_percent" optional="hide"/>
                <field name="state" widget="badge"
                       decoration-success="state in ('implemented','closed')"/>
            </list>
        </field>
    </record>
    <menuitem id="menu_sf_cr_root" name="Change Management" sequence="19"
              web_icon="sf_change_requests,static/description/icon.png"/>
    <menuitem id="menu_sf_cr_requests" name="Change Requests"
              parent="menu_sf_cr_root" action="action_sf_change_request"
              sequence="10"/>

    <record id="view_sf_change_requests_boost_kanban" model="ir.ui.view">
        <field name="name">sf_change_requests.boost.kanban</field>
        <field name="model">sf.change.request</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" t-att-color="state">
                <field name="name"/>
                <field name="state"/>
                <field name="user_id"/>

                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_card oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title">
                                    <field name="name"/></strong>
                                <div class="o_kanban_record_subtitle">
                                    <field name="user_id" widget="many2one_avatar_user"/>
                                    <field name="create_date"/></div>
                            </div>
                            <div class="oe_kanban_bottom_right">
                                <field name="state" widget="badge"
                                       t-attf-options="{'classes_map': {'draft': 'info', 'done': 'success', 'cancelled': 'danger'}, 'domain': []}"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_sf_change_requests_boost_search" model="ir.ui.view">
        <field name="name">sf_change_requests.boost.search</field>
        <field name="model">sf.change.request</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
<separator/>
                <filter string="My records" name="my_records" domain="[('user_id', '=', uid)]"/>
                <filter string="To Do" name="todo" domain="[('state', 'not in', ('done', 'cancelled', 'closed'))]"/>
                <group expand="0" string="Group By"><filter string="Status" name="gb_state" context="{'group_by': 'state'}"/></group>
            </search>
        </field>
    </record>
</odoo>
