<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="seq_sf_rebate_deal" model="ir.sequence">
        <field name="name">Supplier Rebate Deal</field>
        <field name="code">sf.supplier.rebate.deal</field>
        <field name="prefix">SRB/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_sf_rebate_claim" model="ir.sequence">
        <field name="name">Supplier Rebate Claim</field>
        <field name="code">sf.supplier.rebate.claim</field>
        <field name="prefix">SRC/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
