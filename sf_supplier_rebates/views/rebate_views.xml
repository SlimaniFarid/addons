<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_rebate_deal" model="ir.actions.act_window">
        <field name="name">Rebate Deals</field>
        <field name="res_model">sf.supplier.rebate.deal</field>
        <field name="view_mode">kanban,list,form,kanban</field>
    </record>
    <record id="action_sf_rebate_claim" model="ir.actions.act_window">
        <field name="name">Claims</field>
        <field name="res_model">sf.supplier.rebate.claim</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_sf_rebate_deal_form" model="ir.ui.view">
        <field name="name">sf.supplier.rebate.deal.form</field>
        <field name="model">sf.supplier.rebate.deal</field>
        <field name="arch" type="xml">
            <form string="Rebate Deal">
                <header>
                    <button name="action_activate" type="object"
                            string="Activate" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_compute_accrual" type="object"
                            string="Compute Accruals"
                            invisible="state != 'active'"/>
                    <button name="action_expire" type="object"
                            string="Expire" invisible="state == 'expired'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,active,claimed,settled"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="vendor_id"/>
                            <field name="deal_type"/>
                            <field name="product_category_id"/>
                        </group>
                        <group>
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <field name="company_id"
                                   groups="base.group_multi_company"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group>
                            <field name="threshold_amount"
                                   invisible="deal_type != 'turnover_bonus'"/>
                            <field name="fixed_bonus_amount"
                                   invisible="deal_type != 'turnover_bonus'"/>
                            <field name="rebate_percent"
                                   invisible="deal_type != 'retro_percent'"/>
                            <field name="rebate_per_unit"
                                   invisible="deal_type != 'per_unit'"/>
                        </group>
                        <group>
                            <field name="total_purchases" readonly="1"/>
                            <field name="progress_percent"
                                   widget="progressbar"
                                   invisible="deal_type != 'turnover_bonus'"/>
                            <field name="total_accrued" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Accruals" name="accruals">
                            <field name="accrual_ids" readonly="1">
                                <list decoration-danger="is_overdue" create="0">
                                    <field name="period_month"/>
                                    <field name="purchases"/>
                                    <field name="units" optional="show"/>
                                    <field name="accrued_amount"/>
                                    <field name="claimed" widget="boolean"/>
                                </list>
                            </field>
                        </page>
                        <page string="Claims" name="claims">
                            <field name="claim_ids">
                                <list editable="bottom">
                                    <field name="name" readonly="1"/>
                                    <field name="claim_date"/>
                                    <field name="claimed_amount"/>
                                    <field name="credit_note_ref"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_rebate_deal_list" model="ir.ui.view">
        <field name="name">sf.supplier.rebate.deal.list</field>
        <field name="model">sf.supplier.rebate.deal</field>
        <field name="arch" type="xml">
            <list string="Rebate Deals" sample="1">
                <field name="name"/>
                <field name="vendor_id"/>
                <field name="deal_type"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="total_purchases" optional="show"/>
                <field name="total_accrued"/>
                <field name="state" widget="badge"
                       decoration-success="state in ('active','settled')"/>
            </list>
        </field>
    </record>

    <menuitem id="menu_sf_rebate_root" name="Supplier Rebates" sequence="39"
              parent="purchase.menu_purchase_root"/>
    <menuitem id="menu_sf_rebate_deals" name="Rebate Deals"
              parent="menu_sf_rebate_root" action="action_sf_rebate_deal"
              sequence="10"/>
    <menuitem id="menu_sf_rebate_claims" name="Claims"
              parent="menu_sf_rebate_root" action="action_sf_rebate_claim"
              sequence="20"/>

    <record id="view_sf_supplier_rebates_boost_kanban" model="ir.ui.view">
        <field name="name">sf_supplier_rebates.boost.kanban</field>
        <field name="model">sf.supplier.rebate.deal</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" t-att-color="state">
                <field name="name"/>
                <field name="state"/>
                <field name="user_id"/>
                <field name="claim_date"/>
                <field name="is_overdue" invisible="1"/>

                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_card oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title">
                                    <field name="name"/></strong>
                                <div class="o_kanban_record_subtitle">
                                    <field name="user_id" widget="many2one_avatar_user"/>
                                    <field name="claim_date"/></div>
                            </div>
                            <div class="oe_kanban_bottom_right">
                                <field name="state" widget="badge"
                                       t-attf-options="{'classes_map': {'draft': 'info', 'done': 'success', 'cancelled': 'danger'}, 'domain': []}"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_sf_supplier_rebates_boost_search" model="ir.ui.view">
        <field name="name">sf_supplier_rebates.boost.search</field>
        <field name="model">sf.supplier.rebate.deal</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
<separator/>
                <filter string="My records" name="my_records" domain="[('user_id', '=', uid)]"/>
                <filter string="To Do" name="todo" domain="[('state', 'not in', ('done', 'cancelled', 'closed'))]"/>
                <group expand="0" string="Group By"><filter string="Status" name="gb_state" context="{'group_by': 'state'}"/></group>
            </search>
        </field>
    </record>
</odoo>
