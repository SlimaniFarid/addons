<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_sf_rebate" model="ir.module.category">
        <field name="name">Supplier Rebates</field>
        <field name="sequence">89</field>
    </record>
    <record id="group_sf_rebate_user" model="res.groups">
        <field name="name">Supplier Rebate User</field>
        <field name="category_id" ref="module_category_sf_rebate"/>
        <field name="implied_ids" eval="[(4, ref('purchase.group_purchase_user'))]"/>
    </record>
    <record id="group_sf_rebate_manager" model="res.groups">
        <field name="name">Supplier Rebate Manager</field>
        <field name="category_id" ref="module_category_sf_rebate"/>
        <field name="implied_ids" eval="[(4, ref('group_sf_rebate_user'))]"/>
    </record>
    <record id="rule_sf_rebate_deal_company" model="ir.rule">
        <field name="name">Rebate Deal: multi-company</field>
        <field name="model_id" ref="model_sf_supplier_rebate_deal"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
