<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_customer_care_survey" model="ir.module.category">
        <field name="name">Customer Care Survey Runner</field>
        <field name="sequence">265</field>
    </record>
    <record id="group_customer_care_survey_user" model="res.groups">
        <field name="name">Customer Care Survey Runner User</field>
        <field name="category_id" ref="module_category_customer_care_survey"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>

    </record>
    <record id="group_customer_care_survey_manager" model="res.groups">
        <field name="name">Customer Care Survey Runner Manager</field>
        <field name="category_id" ref="module_category_customer_care_survey"/>
        <field name="implied_ids" eval="[(4, ref('group_customer_care_survey_user'))]"/>
    </record>
    <record id="rule_customer_care_survey_sf_customer_care_survey" model="ir.rule">
        <field name="name">Customer Care Survey Runner: multi-company</field>
        <field name="model_id" ref="model_sf_customer_care_survey"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
