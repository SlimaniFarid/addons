<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_customer_reference_program" model="ir.module.category">
        <field name="name">Reference Program Manager</field>
        <field name="sequence">693</field>
    </record>
    <record id="group_customer_reference_program_user" model="res.groups">
        <field name="name">Reference Program Manager User</field>
        <field name="category_id" ref="module_category_customer_reference_program"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>

    </record>
    <record id="group_customer_reference_program_manager" model="res.groups">
        <field name="name">Reference Program Manager Manager</field>
        <field name="category_id" ref="module_category_customer_reference_program"/>
        <field name="implied_ids" eval="[(4, ref('group_customer_reference_program_user'))]"/>
    </record>
    <record id="rule_customer_reference_program_sf_customer_reference_program" model="ir.rule">
        <field name="name">Reference Program Manager: multi-company</field>
        <field name="model_id" ref="model_sf_customer_reference_program"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
