<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_shift_swap_board" model="ir.module.category">
        <field name="name">Shift Swap Board</field>
        <field name="sequence">192</field>
    </record>
    <record id="group_shift_swap_board_user" model="res.groups">
        <field name="name">Shift Swap Board User</field>
        <field name="category_id" ref="module_category_shift_swap_board"/>

    </record>
    <record id="group_shift_swap_board_manager" model="res.groups">
        <field name="name">Shift Swap Board Manager</field>
        <field name="category_id" ref="module_category_shift_swap_board"/>
        <field name="implied_ids" eval="[(4, ref('group_shift_swap_board_user'))]"/>
    </record>
    <record id="rule_shift_swap_board_sf_shift_swap_board" model="ir.rule">
        <field name="name">Shift Swap Board: multi-company</field>
        <field name="model_id" ref="model_sf_shift_swap_board"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_shift_swap_board"/>
    </record>
</odoo>
