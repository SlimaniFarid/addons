<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_sales_commission_statement" model="ir.actions.act_window">
        <field name="name">Commission Statement Generator</field>
        <field name="res_model">sf.sales_commission_statement</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
    <record id="view_sf_sales_commission_statement_form" model="ir.ui.view">
        <field name="name">sf.sales_commission_statement.form</field>
        <field name="model">sf.sales_commission_statement</field>
        <field name="arch" type="xml">
            <form string="Commission Statement Generator">
                <header>
                    <button name="action_submitted" type="object" string="Submitted"
                            class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="rep_id"/>
                            <field name="period"/>
                            <field name="total_sales"/>
                            <field name="commission_rate"/>
                            <field name="gross_commission"/>
                            <field name="deductions"/>
                            <field name="net_commission"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_sales_commission_statement_list" model="ir.ui.view">
        <field name="name">sf.sales_commission_statement.list</field>
        <field name="model">sf.sales_commission_statement</field>
        <field name="arch" type="xml">
            <list string="Commission Statement Generator" sample="1">
                <field name="rep_id"/>
                <field name="period"/>
                <field name="total_sales"/>
                <field name="commission_rate"/>
                <field name="gross_commission"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state in ('submitted','approved')"/>
            </list>
        </field>
    </record>
    <record id="view_sf_sales_commission_statement_kanban" model="ir.ui.view">
        <field name="name">sf.sales_commission_statement.kanban</field>
        <field name="model">sf.sales_commission_statement</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_view" group_by="state">
                <field name="name"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <menuitem id="menu_sf_sales_commission_statement_root" name="Commission Statement Generator" sequence="6"
              web_icon="sf_sales_commission_statement,static/description/icon.png"/>
    <menuitem id="menu_sf_sales_commission_statement_main" name="Records"
              parent="menu_sf_sales_commission_statement_root" action="action_sf_sales_commission_statement" sequence="10"/>
</odoo>
