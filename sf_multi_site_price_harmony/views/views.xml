<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_price_harmony" model="ir.actions.act_window">
        <field name="name">Multi-Site Price Harmony Check</field>
        <field name="res_model">sf.price.harmony</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
    <record id="view_sf_price_harmony_form" model="ir.ui.view">
        <field name="name">sf.price.harmony.form</field>
        <field name="model">sf.price.harmony</field>
        <field name="arch" type="xml">
            <form string="Multi-Site Price Harmony Check">
                <header>
                    <button name="action_harmonized" type="object" string="Harmonized"
                            class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="detected,harmonized,justified"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="product_id"/>
                            <field name="site_a"/>
                            <field name="site_b"/>
                            <field name="price_a"/>
                            <field name="price_b"/>
                            <field name="gap_percent"/>
                            <field name="harmonized_to"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_price_harmony_list" model="ir.ui.view">
        <field name="name">sf.price.harmony.list</field>
        <field name="model">sf.price.harmony</field>
        <field name="arch" type="xml">
            <list string="Multi-Site Price Harmony Check" sample="1">
                <field name="product_id"/>
                <field name="site_a"/>
                <field name="site_b"/>
                <field name="price_a"/>
                <field name="price_b"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state in ('submitted','approved')"/>
            </list>
        </field>
    </record>
    <record id="view_sf_price_harmony_kanban" model="ir.ui.view">
        <field name="name">sf.price.harmony.kanban</field>
        <field name="model">sf.price.harmony</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_view" group_by="state">
                <field name="name"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <menuitem id="menu_sf_price_harmony_root" name="Multi-Site Price Harmony Check" sequence="10"
              web_icon="sf_multi_site_price_harmony,static/description/icon.png"/>
    <menuitem id="menu_sf_price_harmony_main" name="Records"
              parent="menu_sf_price_harmony_root" action="action_sf_price_harmony" sequence="10"/>

    <record id="wave_final_sf_multi_site_price_harmony" model="ir.actions.server">
        <field name="name">Refresh Business Data</field>
        <field name="model_id" ref="model_sf_price_harmony"/>
        <field name="binding_model_id" ref="model_sf_price_harmony"/>
        <field name="state">code</field>
        <field name="code">records.action_refresh_business()</field>
    </record>
</odoo>
