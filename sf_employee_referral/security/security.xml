<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_employee_referral" model="ir.module.category">
        <field name="name">Employee Referral Program</field>
        <field name="sequence">4</field>
    </record>
    <record id="group_employee_referral_user" model="res.groups">
        <field name="name">Employee Referral Program User</field>
        <field name="category_id" ref="module_category_employee_referral"/>

    </record>
    <record id="group_employee_referral_manager" model="res.groups">
        <field name="name">Employee Referral Program Manager</field>
        <field name="category_id" ref="module_category_employee_referral"/>
        <field name="implied_ids" eval="[(4, ref('group_employee_referral_user'))]"/>
    </record>
    <record id="rule_employee_referral_sf_referral" model="ir.rule">
        <field name="name">Referral: multi-company</field>
        <field name="model_id" ref="model_sf_referral"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_employee_referral"/>
    </record>
</odoo>
