<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_referral" model="ir.actions.act_window">
        <field name="name">Employee Referral Program</field>
        <field name="res_model">sf.referral</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
    <record id="view_sf_referral_form" model="ir.ui.view">
        <field name="name">sf.referral.form</field>
        <field name="model">sf.referral</field>
        <field name="arch" type="xml">
            <form string="Employee Referral Program">
                <header>
                    <button name="action_interviewing" type="object" string="Interviewing"
                            class="btn-primary"/>
                    <button name="action_hired" type="object" string="Hired"
                            class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="referred,interviewing,hired,rejected"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="referrer_id"/>
                            <field name="candidate_name"/>
                            <field name="position"/>
                            <field name="hired"/>
                            <field name="hire_date"/>
                            <field name="bonus_amount"/>
                            <field name="bonus_paid"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_referral_list" model="ir.ui.view">
        <field name="name">sf.referral.list</field>
        <field name="model">sf.referral</field>
        <field name="arch" type="xml">
            <list string="Employee Referral Program" sample="1">
                <field name="referrer_id"/>
                <field name="candidate_name"/>
                <field name="position"/>
                <field name="hired"/>
                <field name="hire_date"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state in ('submitted','approved')"/>
            </list>
        </field>
    </record>
    <record id="view_sf_referral_kanban" model="ir.ui.view">
        <field name="name">sf.referral.kanban</field>
        <field name="model">sf.referral</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_view" group_by="state">
                <field name="name"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <menuitem id="menu_sf_referral_root" name="Employee Referral Program" sequence="23"
              web_icon="sf_employee_referral,static/description/icon.png"/>
    <menuitem id="menu_sf_referral_main" name="Records"
              parent="menu_sf_referral_root" action="action_sf_referral" sequence="10"/>
</odoo>
