<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_customer_health_scoring" model="ir.module.category">
        <field name="name">Customer Health Scoring Rules</field>
        <field name="sequence">173</field>
    </record>
    <record id="group_customer_health_scoring_user" model="res.groups">
        <field name="name">Customer Health Scoring Rules User</field>
        <field name="category_id" ref="module_category_customer_health_scoring"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>

    </record>
    <record id="group_customer_health_scoring_manager" model="res.groups">
        <field name="name">Customer Health Scoring Rules Manager</field>
        <field name="category_id" ref="module_category_customer_health_scoring"/>
        <field name="implied_ids" eval="[(4, ref('group_customer_health_scoring_user'))]"/>
    </record>
    <record id="rule_customer_health_scoring_sf_customer_health_scoring" model="ir.rule">
        <field name="name">Customer Health Scoring Rules: multi-company</field>
        <field name="model_id" ref="model_sf_customer_health_scoring"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
