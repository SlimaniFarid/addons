<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_laundry" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.laundry</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Laundry" string="Laundry" name="sf_laundry">
                    <block title="Laundry Settings">
                        <setting string="Default Delivery Delay">
                            <field name="sf_laundry_expected_delivery_days"/>
                        </setting>
                        <setting string="Slow Treatment Threshold">
                            <field name="sf_laundry_slow_threshold_hours"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>