<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_overdue_list">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-set="company" t-value="o.company_id or res_company"/>
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>Overdue Orders List</h2>
                        <table class="table table-sm">
                            <tr><th>Order</th><th>Customer</th><th>Deposit</th><th>Expected</th><th>Status</th><th>Total</th></tr>
                            <tr t-foreach="o" t-as="order">
                                <td><span t-field="order.name"/></td>
                                <td><span t-field="order.customer_name"/></td>
                                <td><span t-field="order.deposit_date"/></td>
                                <td><span t-field="order.expected_delivery_date"/></td>
                                <td><span t-field="order.state"/></td>
                                <td><span t-field="order.total"/></td>
                            </tr>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>