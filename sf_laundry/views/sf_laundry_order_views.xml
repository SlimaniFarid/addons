<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sf_laundry_order_view_list" model="ir.ui.view">
        <field name="name">sf.laundry.order.list</field>
        <field name="model">sf.laundry.order</field>
        <field name="arch" type="xml">
            <list string="Laundry Orders">
                <field name="name"/>
                <field name="customer_name"/>
                <field name="phone"/>
                <field name="deposit_date"/>
                <field name="expected_delivery_date"/>
                <field name="total" string="Total"/>
                <field name="state" widget="badge"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="sf_laundry_order_view_form" model="ir.ui.view">
        <field name="name">sf.laundry.order.form</field>
        <field name="model">sf.laundry.order</field>
        <field name="arch" type="xml">
            <form string="Laundry Order">
                <header>
                    <button name="action_receive" string="Receive" type="object" class="btn-primary" invisible="[('state', '!=', 'draft')]"/>
                    <button name="action_start" string="Start Treatment" type="object" class="btn-primary" invisible="[('state', '!=', 'received')]"/>
                    <button name="action_ready" string="Mark Ready" type="object" class="btn-primary" invisible="[('state', '!=', 'in_progress')]"/>
                    <button name="action_deliver" string="Deliver" type="object" class="btn-primary" invisible="[('state', '!=', 'ready')]"/>
                    <button name="action_cancel" string="Cancel Order" type="object" invisible="[('state', 'in', ('delivered', 'cancelled'))]"/>
                    <field name="state" widget="statusbar" readonly="1"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="customer_name"/>
                            <field name="phone"/>
                        </group>
                        <group>
                            <field name="deposit_date"/>
                            <field name="expected_delivery_date"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Items">
                            <field name="item_ids">
                                <list string="Items">
                                    <field name="name"/>
                                    <field name="item_type"/>
                                    <field name="description"/>
                                    <field name="service"/>
                                    <field name="qty"/>
                                    <field name="price_unit"/>
                                    <field name="subtotal"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                    <div class="oe_subtotal_footer oe_right">
                        <div class="oe_subtotal">
                            <span class="oe_subtotal_footer_separator">Total:</span>
                            <field name="total"/>
                        </div>
                    </div>
                    <group string="Pickup &amp; Delivery">
                        <field name="pickup_date"/>
                        <field name="delivery_date"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="sf_laundry_order_view_kanban" model="ir.ui.view">
        <field name="name">sf.laundry.order.kanban</field>
        <field name="model">sf.laundry.order</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state">
                <field name="name"/>
                <field name="customer_name"/>
                <field name="deposit_date"/>
                <field name="expected_delivery_date"/>
                <field name="total"/>
                <field name="state"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong>
                                <div><field name="customer_name"/></div>
                                <div>Deposit: <field name="deposit_date"/></div>
                                <div>Expected: <field name="expected_delivery_date"/></div>
                                <div>Total: <field name="total"/></div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="sf_laundry_order_view_search" model="ir.ui.view">
        <field name="name">sf.laundry.order.search</field>
        <field name="model">sf.laundry.order</field>
        <field name="arch" type="xml">
            <search string="Laundry Orders">
                <field name="name"/>
                <field name="customer_name"/>
                <field name="phone"/>
                <filter name="order_received" string="Received" domain="[('state', '=', 'received')]"/>
                <filter name="order_in_progress" string="In Progress" domain="[('state', '=', 'in_progress')]"/>
                <filter name="order_ready" string="Ready" domain="[('state', '=', 'ready')]"/>
                <filter name="order_overdue" string="Overdue" domain="[('state', 'in', ('draft', 'received', 'in_progress', 'ready')), ('expected_delivery_date', '&lt;', 'today')]"/>
                <group>
                    <filter name="group_order_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_order_customer" string="Customer" context="{'group_by': 'customer_name'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_sf_laundry_order" model="ir.actions.act_window">
        <field name="name">Laundry Orders</field>
        <field name="res_model">sf.laundry.order</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="sf_laundry_order_view_search"/>
    </record>
</odoo>