<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sf_laundry_item_type_view_list" model="ir.ui.view">
        <field name="name">sf.laundry.item.type.list</field>
        <field name="model">sf.laundry.item.type</field>
        <field name="arch" type="xml">
            <list string="Item Types">
                <field name="name"/>
                <field name="service"/>
                <field name="price_unit"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="sf_laundry_item_type_view_form" model="ir.ui.view">
        <field name="name">sf.laundry.item.type.form</field>
        <field name="model">sf.laundry.item.type</field>
        <field name="arch" type="xml">
            <form string="Item Type">
                <sheet>
                    <group>
                        <group>
                            <field name="name" placeholder="Name"/>
                            <field name="service"/>
                        </group>
                        <group>
                            <field name="price_unit"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="sf_laundry_item_type_view_search" model="ir.ui.view">
        <field name="name">sf.laundry.item.type.search</field>
        <field name="model">sf.laundry.item.type</field>
        <field name="arch" type="xml">
            <search string="Item Types">
                <field name="name"/>
                <field name="service"/>
                <group>
                    <filter name="group_type_service" string="Service" context="{'group_by': 'service'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_sf_laundry_item_type" model="ir.actions.act_window">
        <field name="name">Item Types</field>
        <field name="res_model">sf.laundry.item.type</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="sf_laundry_item_type_view_search"/>
    </record>

    <record id="view_sf_laundry_boost_kanban" model="ir.ui.view">
        <field name="name">sf_laundry.boost.kanban</field>
        <field name="model">sf.laundry.activity.mixin</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" t-att-color="state">
                <field name="name"/>
                <field name="state"/>
                <field name="user_id"/>

                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_card oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title">
                                    <field name="name"/></strong>
                                <div class="o_kanban_record_subtitle">
                                    <field name="user_id" widget="many2one_avatar_user"/>
                                    <field name="create_date"/></div>
                            </div>
                            <div class="oe_kanban_bottom_right">
                                <field name="state" widget="badge"
                                       t-attf-options="{'classes_map': {'draft': 'info', 'done': 'success', 'cancelled': 'danger'}, 'domain': []}"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_sf_laundry_boost_search" model="ir.ui.view">
        <field name="name">sf_laundry.boost.search</field>
        <field name="model">sf.laundry.activity.mixin</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
<separator/>
                <filter string="My records" name="my_records" domain="[('user_id', '=', uid)]"/>
                <filter string="To Do" name="todo" domain="[('state', 'not in', ('done', 'cancelled', 'closed'))]"/>
                <group expand="0" string="Group By"><filter string="Status" name="gb_state" context="{'group_by': 'state'}"/></group>
            </search>
        </field>
    </record>
</odoo>
