<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_activity">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-set="company" t-value="o.company_id or res_company"/>
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>Laundry Activity Report</h2>
                        <table class="table table-sm">
                            <tr><th>Item</th><th>Order</th><th>Type</th><th>Service</th><th>Status</th><th>Last Update</th></tr>
                            <tr t-foreach="o" t-as="item">
                                <td><span t-field="item.name"/></td>
                                <td><span t-field="item.order_id"/></td>
                                <td><span t-field="item.item_type"/></td>
                                <td><span t-field="item.service"/></td>
                                <td><span t-field="item.state"/></td>
                                <td><span t-field="item.write_date"/></td>
                            </tr>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>