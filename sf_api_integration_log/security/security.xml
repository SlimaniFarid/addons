<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_api_integration_log" model="ir.module.category">
        <field name="name">API Integration Monitor</field>
        <field name="sequence">385</field>
    </record>
    <record id="group_api_integration_log_user" model="res.groups">
        <field name="name">API Integration Monitor User</field>
        <field name="category_id" ref="module_category_api_integration_log"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>

    </record>
    <record id="group_api_integration_log_manager" model="res.groups">
        <field name="name">API Integration Monitor Manager</field>
        <field name="category_id" ref="module_category_api_integration_log"/>
        <field name="implied_ids" eval="[(4, ref('group_api_integration_log_user'))]"/>
    </record>
    <record id="rule_api_integration_log_sf_api_integration_log" model="ir.rule">
        <field name="name">API Integration Monitor: multi-company</field>
        <field name="model_id" ref="model_sf_api_integration_log"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
