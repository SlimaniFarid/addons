<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_customer_contract_renewal_pipeline" model="ir.module.category">
        <field name="name">Contract Renewal Pipeline</field>
        <field name="sequence">483</field>
    </record>
    <record id="group_customer_contract_renewal_pipeline_user" model="res.groups">
        <field name="name">Contract Renewal Pipeline User</field>
        <field name="category_id" ref="module_category_customer_contract_renewal_pipeline"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>

    </record>
    <record id="group_customer_contract_renewal_pipeline_manager" model="res.groups">
        <field name="name">Contract Renewal Pipeline Manager</field>
        <field name="category_id" ref="module_category_customer_contract_renewal_pipeline"/>
        <field name="implied_ids" eval="[(4, ref('group_customer_contract_renewal_pipeline_user'))]"/>
    </record>
    <record id="rule_customer_contract_renewal_pipeline_sf_customer_contract_renewal_pipeline" model="ir.rule">
        <field name="name">Contract Renewal Pipeline: multi-company</field>
        <field name="model_id" ref="model_sf_customer_contract_renewal_pipeline"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
