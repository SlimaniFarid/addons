<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_customer_contract_renewal_pipeline" model="ir.actions.act_window">
        <field name="name">Contract Renewal Pipeline</field>
        <field name="res_model">sf.customer_contract_renewal_pipeline</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
    <record id="view_sf_customer_contract_renewal_pipeline_form" model="ir.ui.view">
        <field name="name">sf.customer_contract_renewal_pipeline.form</field>
        <field name="model">sf.customer_contract_renewal_pipeline</field>
        <field name="arch" type="xml">
            <form string="Contract Renewal Pipeline">
                <header>
                    <button name="action_submitted" type="object" string="Submitted"
                            class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="contract_ref"/>
                            <field name="expiry_date"/>
                            <field name="renewal_probability"/>
                            <field name="revenue_value"/>
                            <field name="owner_id"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_customer_contract_renewal_pipeline_list" model="ir.ui.view">
        <field name="name">sf.customer_contract_renewal_pipeline.list</field>
        <field name="model">sf.customer_contract_renewal_pipeline</field>
        <field name="arch" type="xml">
            <list string="Contract Renewal Pipeline" sample="1">
                <field name="partner_id"/>
                <field name="contract_ref"/>
                <field name="expiry_date"/>
                <field name="renewal_probability"/>
                <field name="revenue_value"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state in ('submitted','approved')"/>
            </list>
        </field>
    </record>
    <record id="view_sf_customer_contract_renewal_pipeline_kanban" model="ir.ui.view">
        <field name="name">sf.customer_contract_renewal_pipeline.kanban</field>
        <field name="model">sf.customer_contract_renewal_pipeline</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_view" group_by="state">
                <field name="name"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <menuitem id="menu_sf_customer_contract_renewal_pipeline_root" name="Contract Renewal Pipeline" sequence="18"
              web_icon="sf_customer_contract_renewal_pipeline,static/description/icon.png"/>
    <menuitem id="menu_sf_customer_contract_renewal_pipeline_main" name="Records"
              parent="menu_sf_customer_contract_renewal_pipeline_root" action="action_sf_customer_contract_renewal_pipeline" sequence="10"/>

    <record id="wave_final_sf_customer_contract_renewal_pipeline" model="ir.actions.server">
        <field name="name">Refresh Business Data</field>
        <field name="model_id" ref="model_sf_customer_contract_renewal_pipeline"/>
        <field name="binding_model_id" ref="model_sf_customer_contract_renewal_pipeline"/>
        <field name="state">code</field>
        <field name="code">records.action_refresh_business()</field>
    </record>
</odoo>
