<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_budget_alert" model="ir.actions.act_window">
        <field name="name">Budget vs Actual Alerts</field>
        <field name="res_model">sf.budget.alert</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
    <record id="view_sf_budget_alert_form" model="ir.ui.view">
        <field name="name">sf.budget.alert.form</field>
        <field name="model">sf.budget.alert</field>
        <field name="arch" type="xml">
            <form string="Budget vs Actual Alerts">
                <header>
                    <button name="action_explained" type="object" string="Explained"
                            class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="open,explained,closed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="department"/>
                            <field name="period_month"/>
                            <field name="budget_amount"/>
                            <field name="actual_amount"/>
                            <field name="consumption_percent"/>
                            <field name="alert_level"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_budget_alert_list" model="ir.ui.view">
        <field name="name">sf.budget.alert.list</field>
        <field name="model">sf.budget.alert</field>
        <field name="arch" type="xml">
            <list string="Budget vs Actual Alerts" sample="1">
                <field name="department"/>
                <field name="period_month"/>
                <field name="budget_amount"/>
                <field name="actual_amount"/>
                <field name="consumption_percent"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state in ('submitted','approved')"/>
            </list>
        </field>
    </record>
    <record id="view_sf_budget_alert_kanban" model="ir.ui.view">
        <field name="name">sf.budget.alert.kanban</field>
        <field name="model">sf.budget.alert</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_view" group_by="state">
                <field name="name"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <menuitem id="menu_sf_budget_alert_root" name="Budget vs Actual Alerts" sequence="12"
              web_icon="sf_budget_vs_actual_alerts,static/description/icon.png"/>
    <menuitem id="menu_sf_budget_alert_main" name="Records"
              parent="menu_sf_budget_alert_root" action="action_sf_budget_alert" sequence="10"/>
</odoo>
