<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_budget_vs_actual_alerts" model="ir.module.category">
        <field name="name">Budget vs Actual Alerts</field>
        <field name="sequence">33</field>
    </record>
    <record id="group_budget_vs_actual_alerts_user" model="res.groups">
        <field name="name">Budget vs Actual Alerts User</field>
        <field name="category_id" ref="module_category_budget_vs_actual_alerts"/>

    </record>
    <record id="group_budget_vs_actual_alerts_manager" model="res.groups">
        <field name="name">Budget vs Actual Alerts Manager</field>
        <field name="category_id" ref="module_category_budget_vs_actual_alerts"/>
        <field name="implied_ids" eval="[(4, ref('group_budget_vs_actual_alerts_user'))]"/>
    </record>
    <record id="rule_budget_vs_actual_alerts_sf_budget_alert" model="ir.rule">
        <field name="name">Budget Alert: multi-company</field>
        <field name="model_id" ref="model_sf_budget_alert"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
