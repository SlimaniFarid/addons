<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_sales_battle_rhythm" model="ir.module.category">
        <field name="name">Sales Battle Rhythm Planner</field>
        <field name="sequence">300</field>
    </record>
    <record id="group_sales_battle_rhythm_user" model="res.groups">
        <field name="name">Sales Battle Rhythm Planner User</field>
        <field name="category_id" ref="module_category_sales_battle_rhythm"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>

    </record>
    <record id="group_sales_battle_rhythm_manager" model="res.groups">
        <field name="name">Sales Battle Rhythm Planner Manager</field>
        <field name="category_id" ref="module_category_sales_battle_rhythm"/>
        <field name="implied_ids" eval="[(4, ref('group_sales_battle_rhythm_user'))]"/>
    </record>
    <record id="rule_sales_battle_rhythm_sf_sales_battle_rhythm" model="ir.rule">
        <field name="name">Sales Battle Rhythm Planner: multi-company</field>
        <field name="model_id" ref="model_sf_sales_battle_rhythm"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
