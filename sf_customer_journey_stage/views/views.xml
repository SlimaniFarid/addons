<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_customer_journey_stage" model="ir.actions.act_window">
        <field name="name">Customer Journey Stage Tracker</field>
        <field name="res_model">sf.customer_journey_stage</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
    <record id="view_sf_customer_journey_stage_form" model="ir.ui.view">
        <field name="name">sf.customer_journey_stage.form</field>
        <field name="model">sf.customer_journey_stage</field>
        <field name="arch" type="xml">
            <form string="Customer Journey Stage Tracker">
                <header>
                    <button name="action_submitted" type="object" string="Submitted"
                            class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="stage"/>
                            <field name="touchpoints"/>
                            <field name="days_in_stage"/>
                            <field name="next_action"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_customer_journey_stage_list" model="ir.ui.view">
        <field name="name">sf.customer_journey_stage.list</field>
        <field name="model">sf.customer_journey_stage</field>
        <field name="arch" type="xml">
            <list string="Customer Journey Stage Tracker" sample="1">
                <field name="partner_id"/>
                <field name="stage"/>
                <field name="touchpoints"/>
                <field name="days_in_stage"/>
                <field name="next_action"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state in ('submitted','approved')"/>
            </list>
        </field>
    </record>
    <record id="view_sf_customer_journey_stage_kanban" model="ir.ui.view">
        <field name="name">sf.customer_journey_stage.kanban</field>
        <field name="model">sf.customer_journey_stage</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_view" group_by="state">
                <field name="name"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <menuitem id="menu_sf_customer_journey_stage_root" name="Customer Journey Stage Tracker" sequence="21"
              web_icon="sf_customer_journey_stage,static/description/icon.png"/>
    <menuitem id="menu_sf_customer_journey_stage_main" name="Records"
              parent="menu_sf_customer_journey_stage_root" action="action_sf_customer_journey_stage" sequence="10"/>
</odoo>
