<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_customer_journey_stage" model="ir.module.category">
        <field name="name">Customer Journey Stage Tracker</field>
        <field name="sequence">680</field>
    </record>
    <record id="group_customer_journey_stage_user" model="res.groups">
        <field name="name">Customer Journey Stage Tracker User</field>
        <field name="category_id" ref="module_category_customer_journey_stage"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>

    </record>
    <record id="group_customer_journey_stage_manager" model="res.groups">
        <field name="name">Customer Journey Stage Tracker Manager</field>
        <field name="category_id" ref="module_category_customer_journey_stage"/>
        <field name="implied_ids" eval="[(4, ref('group_customer_journey_stage_user'))]"/>
    </record>
    <record id="rule_customer_journey_stage_sf_customer_journey_stage" model="ir.rule">
        <field name="name">Customer Journey Stage Tracker: multi-company</field>
        <field name="model_id" ref="model_sf_customer_journey_stage"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
