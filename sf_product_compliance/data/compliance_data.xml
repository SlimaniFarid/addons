<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_product_regulation" model="ir.sequence">
            <field name="name">Product Regulation</field>
            <field name="code">sf.product.regulation</field>
            <field name="prefix">REG-</field>
            <field name="padding">4</field>
            <field name="number_next">4</field>
            <field name="number_increment">1</field>
        </record>

        <record id="seq_product_compliance_requirement" model="ir.sequence">
            <field name="name">Product Compliance Requirement</field>
            <field name="code">sf.product.compliance.requirement</field>
            <field name="prefix">REQ-</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>

        <record id="seq_product_compliance_dossier" model="ir.sequence">
            <field name="name">Product Compliance Dossier</field>
            <field name="code">sf.product.compliance.dossier</field>
            <field name="prefix">DOS-</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>

        <record id="seq_product_compliance_certificate" model="ir.sequence">
            <field name="name">Product Compliance Certificate</field>
            <field name="code">sf.product.compliance.certificate</field>
            <field name="prefix">CER-</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>

        <record id="regulation_ce" model="sf.product.regulation">
            <field name="name">REG-001</field>
            <field name="code">CE</field>
            <field name="market">European Union</field>
            <field name="description">CE marking: conformity with applicable EU directives for placing products on the European market.</field>
            <field name="mandatory">True</field>
        </record>

        <record id="regulation_rohs" model="sf.product.regulation">
            <field name="name">REG-002</field>
            <field name="code">RoHS</field>
            <field name="market">European Union</field>
            <field name="description">Restriction of Hazardous Substances in electrical and electronic equipment.</field>
            <field name="mandatory">True</field>
        </record>

        <record id="regulation_reach" model="sf.product.regulation">
            <field name="name">REG-003</field>
            <field name="code">REACH</field>
            <field name="market">European Union</field>
            <field name="description">Registration, Evaluation, Authorisation and Restriction of Chemicals.</field>
            <field name="mandatory">True</field>
        </record>

        <record id="cron_certificate_expiry" model="ir.cron">
            <field name="name">Product Compliance: Certificate Expiry Alerts</field>
            <field name="model_id" ref="model_sf_product_compliance_certificate"/>
            <field name="state">code</field>
            <field name="code">model._check_certificate_expiry()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="active">True</field>
        </record>
    </data>
</odoo>