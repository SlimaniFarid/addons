<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="report_product_compliance" model="ir.actions.report">
        <field name="name">Product Compliance Report</field>
        <field name="model">product.product</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">sf_product_compliance.product_compliance_template</field>
        <field name="report_file">sf_product_compliance.product_compliance_template</field>
        <field name="binding_model_id" ref="model_product_product"/>
        <field name="binding_type">report</field>
    </record>

    <record id="report_expired_certificates" model="ir.actions.report">
        <field name="name">Expired Certificates</field>
        <field name="model">sf.product.compliance.certificate</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">sf_product_compliance.expired_certificates_template</field>
        <field name="report_file">sf_product_compliance.expired_certificates_template</field>
        <field name="binding_model_id" ref="model_sf_product_compliance_certificate"/>
        <field name="binding_type">report</field>
    </record>

    <template id="product_compliance_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>Product Compliance Report</h2>
                        <table class="table table-sm">
                            <tr><td><strong>Product</strong></td><td><t t-esc="o.display_name"/></td></tr>
                            <tr><td><strong>Compliance status</strong></td><td><t t-esc="o.sf_compliance_state"/></td></tr>
                        </table>
                        <t t-if="o.sf_compliance_dossier_ids">
                            <h4>Dossiers</h4>
                            <table class="table table-sm">
                                <tr><th>Number</th><th>Regulation</th><th>Version</th><th>State</th><th>Validated</th></tr>
                                <tr t-foreach="o.sf_compliance_dossier_ids" t-as="d">
                                    <td><t t-esc="d.name"/></td>
                                    <td><t t-esc="d.regulation_id.code"/></td>
                                    <td><t t-esc="d.version"/></td>
                                    <td><t t-esc="d.state"/></td>
                                    <td><t t-esc="d.validated_date or ''"/></td>
                                </tr>
                            </table>
                        </t>
                        <t t-if="o.sf_compliance_requirement_ids">
                            <h4>Requirements</h4>
                            <table class="table table-sm">
                                <tr><th>Number</th><th>Regulation</th><th>Requirement</th><th>State</th><th>Compliance date</th></tr>
                                <tr t-foreach="o.sf_compliance_requirement_ids" t-as="r">
                                    <td><t t-esc="r.name"/></td>
                                    <td><t t-esc="r.regulation_id.code"/></td>
                                    <td><t t-esc="r.requirement"/></td>
                                    <td><t t-esc="r.state"/></td>
                                    <td><t t-esc="r.compliance_date or ''"/></td>
                                </tr>
                            </table>
                        </t>
                        <t t-if="o.sf_compliance_certificate_ids">
                            <h4>Certificates</h4>
                            <table class="table table-sm">
                                <tr><th>Number</th><th>Certificate</th><th>Issuer</th><th>Expiry date</th><th>State</th></tr>
                                <tr t-foreach="o.sf_compliance_certificate_ids" t-as="c">
                                    <td><t t-esc="c.name"/></td>
                                    <td><t t-esc="c.certificate_number or ''"/></td>
                                    <td><t t-esc="c.issuer or ''"/></td>
                                    <td><t t-esc="c.expiry_date or ''"/></td>
                                    <td><t t-esc="c.state"/></td>
                                </tr>
                            </table>
                        </t>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <template id="expired_certificates_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>Expired Certificates</h2>
                        <table class="table table-sm">
                            <tr><td><strong>Number</strong></td><td><t t-esc="o.name"/></td></tr>
                            <tr><td><strong>Certificate number</strong></td><td><t t-esc="o.certificate_number or ''"/></td></tr>
                            <tr><td><strong>Product</strong></td><td><t t-esc="o.product_id.display_name"/></td></tr>
                            <tr><td><strong>Issuer</strong></td><td><t t-esc="o.issuer or ''"/></td></tr>
                            <tr><td><strong>Issue date</strong></td><td><t t-esc="o.issue_date or ''"/></td></tr>
                            <tr><td><strong>Expiry date</strong></td><td><t t-esc="o.expiry_date or ''"/></td></tr>
                            <tr><td><strong>State</strong></td><td><t t-esc="o.state"/></td></tr>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>