<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_compliance" model="ir.module.category">
        <field name="name">Product Compliance</field>
        <field name="sequence">90</field>
    </record>

    <record id="group_compliance_user" model="res.groups">
        <field name="name">Compliance User</field>
        <field name="category_id" ref="module_category_compliance"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_compliance_manager" model="res.groups">
        <field name="name">Compliance Manager</field>
        <field name="category_id" ref="module_category_compliance"/>
        <field name="implied_ids" eval="[(4, ref('group_compliance_user'))]"/>
    </record>

    <record id="rule_regulation_user_company" model="ir.rule">
        <field name="name">Regulation: user sees own company</field>
        <field name="model_id" ref="model_sf_product_regulation"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_compliance_user'))]"/>
    </record>

    <record id="rule_requirement_user_company" model="ir.rule">
        <field name="name">Requirement: user sees own company</field>
        <field name="model_id" ref="model_sf_product_compliance_requirement"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_compliance_user'))]"/>
    </record>

    <record id="rule_dossier_user_company" model="ir.rule">
        <field name="name">Dossier: user sees own company</field>
        <field name="model_id" ref="model_sf_product_compliance_dossier"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_compliance_user'))]"/>
    </record>

    <record id="rule_certificate_user_company" model="ir.rule">
        <field name="name">Certificate: user sees own company</field>
        <field name="model_id" ref="model_sf_product_compliance_certificate"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_compliance_user'))]"/>
    </record>

    <record id="rule_regulation_manager_all" model="ir.rule">
        <field name="name">Regulation: manager sees all companies</field>
        <field name="model_id" ref="model_sf_product_regulation"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_compliance_manager'))]"/>
    </record>

    <record id="rule_requirement_manager_all" model="ir.rule">
        <field name="name">Requirement: manager sees all companies</field>
        <field name="model_id" ref="model_sf_product_compliance_requirement"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_compliance_manager'))]"/>
    </record>

    <record id="rule_dossier_manager_all" model="ir.rule">
        <field name="name">Dossier: manager sees all companies</field>
        <field name="model_id" ref="model_sf_product_compliance_dossier"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_compliance_manager'))]"/>
    </record>

    <record id="rule_certificate_manager_all" model="ir.rule">
        <field name="name">Certificate: manager sees all companies</field>
        <field name="model_id" ref="model_sf_product_compliance_certificate"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_compliance_manager'))]"/>
    </record>
</odoo>