<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_sf_custom_report_builder" model="ir.module.category">
        <field name="name">Custom Report Builder</field>
        <field name="description">Custom Report Builder Management</field>
        <field name="sequence">10</field>
    </record>

    <record id="group_sf_custom_report_builder_user" model="res.groups">
        <field name="name">Custom Report Builder / User</field>
        <field name="category_id" ref="module_category_sf_custom_report_builder"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_sf_custom_report_builder_manager" model="res.groups">
        <field name="name">Custom Report Builder / Manager</field>
        <field name="category_id" ref="module_category_sf_custom_report_builder"/>
        <field name="implied_ids" eval="[(4, ref('sf_custom_report_builder.group_sf_custom_report_builder_user'))]"/>
    </record>

    <record id="rule_sf_custom_report_builder_company" model="ir.rule">
        <field name="name">Custom Report Builder: user sees own company</field>
        <field name="model_id" ref="model_sf_custom_report_builder"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('sf_custom_report_builder.group_sf_custom_report_builder_user'))]"/>
    </record>
    <record id="rule_sf_custom_report_builder_manager_all" model="ir.rule">
        <field name="name">Custom Report Builder: manager sees all companies</field>
        <field name="model_id" ref="model_sf_custom_report_builder"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('sf_custom_report_builder.group_sf_custom_report_builder_manager'))]"/>
    </record>
</odoo>