<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_production_scrap_pareto" model="ir.actions.act_window">
        <field name="name">Scrap Pareto Analyzer</field>
        <field name="res_model">sf.production_scrap_pareto</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
    <record id="view_sf_production_scrap_pareto_form" model="ir.ui.view">
        <field name="name">sf.production_scrap_pareto.form</field>
        <field name="model">sf.production_scrap_pareto</field>
        <field name="arch" type="xml">
            <form string="Scrap Pareto Analyzer">
                <header>
                    <button name="action_submitted" type="object" string="Submitted"
                            class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="period"/>
                            <field name="scrap_reason"/>
                            <field name="quantity"/>
                            <field name="cost"/>
                            <field name="cumulative_percent"/>
                            <field name="action_ref"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_production_scrap_pareto_list" model="ir.ui.view">
        <field name="name">sf.production_scrap_pareto.list</field>
        <field name="model">sf.production_scrap_pareto</field>
        <field name="arch" type="xml">
            <list string="Scrap Pareto Analyzer" sample="1">
                <field name="period"/>
                <field name="scrap_reason"/>
                <field name="quantity"/>
                <field name="cost"/>
                <field name="cumulative_percent"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state in ('submitted','approved')"/>
            </list>
        </field>
    </record>
    <record id="view_sf_production_scrap_pareto_kanban" model="ir.ui.view">
        <field name="name">sf.production_scrap_pareto.kanban</field>
        <field name="model">sf.production_scrap_pareto</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_view" group_by="state">
                <field name="name"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <menuitem id="menu_sf_production_scrap_pareto_root" name="Scrap Pareto Analyzer" sequence="10"
              web_icon="sf_production_scrap_pareto,static/description/icon.png"/>
    <menuitem id="menu_sf_production_scrap_pareto_main" name="Records"
              parent="menu_sf_production_scrap_pareto_root" action="action_sf_production_scrap_pareto" sequence="10"/>

    <record id="wave2_pareto_build" model="ir.actions.server">
        <field name="name">Rebuild Pareto from stock.scrap</field>
        <field name="model_id" ref="model_sf_production_scrap_pareto"/>
        <field name="binding_model_id" ref="model_sf_production_scrap_pareto"/>
        <field name="state">code</field>
        <field name="code">records.action_build_pareto()</field>
    </record>
</odoo>
