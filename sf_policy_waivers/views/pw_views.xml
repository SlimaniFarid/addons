<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_policy_waiver" model="ir.actions.act_window">
        <field name="name">Policy Waivers</field>
        <field name="res_model">sf.policy.waiver</field>
        <field name="view_mode">kanban,list,form,kanban</field>
    </record>
    <record id="view_sf_policy_waiver_form" model="ir.ui.view">
        <field name="name">sf.policy.waiver.form</field>
        <field name="model">sf.policy.waiver</field>
        <field name="arch" type="xml">
            <form string="Policy Waiver">
                <header>
                    <button name="action_approve" type="object"
                            string="Approve" class="btn-primary"
                            invisible="state != 'requested'"/>
                    <button name="action_reject" type="object" string="Reject"
                            class="btn-danger" invisible="state != 'requested'"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state in ('rejected','cancelled')"/>
                    <field name="expired" widget="boolean" readonly="1"
                           invisible="state != 'approved'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="requested,approved,rejected"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="policy_name"/>
                            <field name="requester_id"/>
                            <field name="department"/>
                            <field name="risk_level" widget="radio"/>
                        </group>
                        <group>
                            <field name="valid_from"/>
                            <field name="valid_to"/>
                            <field name="approver_id" readonly="1"/>
                            <field name="decision_date" readonly="1"/>
                            <field name="company_id"
                                   groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group string="Justification">
                        <field name="reason" readonly="state != 'requested'"/>
                    </group>
                    <group string="Risk Assessment">
                        <field name="risk_assessment"
                               readonly="state != 'requested'"/>
                    </group>
                    <group string="Compensating Controls">
                        <field name="compensating_controls"
                               readonly="state != 'requested'"/>
                    </group>
                    <group string="Rejection Reason"
                           invisible="state != 'rejected'">
                        <field name="rejection_reason"/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_policy_waiver_list" model="ir.ui.view">
        <field name="name">sf.policy.waiver.list</field>
        <field name="model">sf.policy.waiver</field>
        <field name="arch" type="xml">
            <list string="Policy Waivers" sample="1" decoration-danger="expired">
                <field name="name"/>
                <field name="policy_name"/>
                <field name="requester_id"/>
                <field name="risk_level" widget="badge"
                       decoration-danger="risk_level == 'high'"/>
                <field name="valid_from"/>
                <field name="valid_to"/>
                <field name="expired" widget="boolean"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'approved'"/>
            </list>
        </field>
    </record>
    <menuitem id="menu_sf_pw_root" name="Policy Waivers" sequence="20"
              web_icon="sf_policy_waivers,static/description/icon.png"/>
    <menuitem id="menu_sf_pw_waivers" name="Waiver Requests"
              parent="menu_sf_pw_root" action="action_sf_policy_waiver"
              sequence="10"/>

    <record id="view_sf_policy_waivers_boost_kanban" model="ir.ui.view">
        <field name="name">sf_policy_waivers.boost.kanban</field>
        <field name="model">sf.policy.waiver</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" t-att-color="state">
                <field name="name"/>
                <field name="state"/>
                <field name="user_id"/>

                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_card oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title">
                                    <field name="name"/></strong>
                                <div class="o_kanban_record_subtitle">
                                    <field name="user_id" widget="many2one_avatar_user"/>
                                    <field name="create_date"/></div>
                            </div>
                            <div class="oe_kanban_bottom_right">
                                <field name="state" widget="badge"
                                       t-attf-options="{'classes_map': {'draft': 'info', 'done': 'success', 'cancelled': 'danger'}, 'domain': []}"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_sf_policy_waivers_boost_search" model="ir.ui.view">
        <field name="name">sf_policy_waivers.boost.search</field>
        <field name="model">sf.policy.waiver</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
<separator/>
                <filter string="My records" name="my_records" domain="[('user_id', '=', uid)]"/>
                <filter string="To Do" name="todo" domain="[('state', 'not in', ('done', 'cancelled', 'closed'))]"/>
                <group expand="0" string="Group By"><filter string="Status" name="gb_state" context="{'group_by': 'state'}"/></group>
            </search>
        </field>
    </record>
</odoo>
