<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_sf_pw" model="ir.module.category">
        <field name="name">Policy Waivers</field>
        <field name="sequence">70</field>
    </record>
    <record id="group_sf_pw_user" model="res.groups">
        <field name="name">Waiver Requester</field>
        <field name="category_id" ref="module_category_sf_pw"/>
    </record>
    <record id="group_sf_pw_manager" model="res.groups">
        <field name="name">Waiver Approver</field>
        <field name="category_id" ref="module_category_sf_pw"/>
        <field name="implied_ids" eval="[(4, ref('group_sf_pw_user'))]"/>
    </record>
    <record id="rule_sf_pw_company" model="ir.rule">
        <field name="name">Policy Waiver: multi-company</field>
        <field name="model_id" ref="model_sf_policy_waiver"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
