<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_production_meeting" model="ir.actions.act_window">
        <field name="name">Daily Production Meeting Actions</field>
        <field name="res_model">sf.production.meeting</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
    <record id="view_sf_production_meeting_form" model="ir.ui.view">
        <field name="name">sf.production.meeting.form</field>
        <field name="model">sf.production.meeting</field>
        <field name="arch" type="xml">
            <form string="Daily Production Meeting Actions">
                <header>
                    <button name="action_held" type="object" string="Held"
                            class="btn-primary"/>
                    <button name="action_actions_tracked" type="object" string="Actions Tracked"
                            class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="planned,held,actions_tracked,closed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="meeting_date"/>
                            <field name="chair_id"/>
                        <field name="topics"/>
                        <field name="kpi_review"/>
                            <field name="escalations"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_production_meeting_list" model="ir.ui.view">
        <field name="name">sf.production.meeting.list</field>
        <field name="model">sf.production.meeting</field>
        <field name="arch" type="xml">
            <list string="Daily Production Meeting Actions" sample="1">
                <field name="meeting_date"/>
                <field name="chair_id"/>
                <field name="topics"/>
                <field name="kpi_review"/>
                <field name="escalations"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state in ('submitted','approved')"/>
            </list>
        </field>
    </record>
    <record id="view_sf_production_meeting_kanban" model="ir.ui.view">
        <field name="name">sf.production.meeting.kanban</field>
        <field name="model">sf.production.meeting</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_view" group_by="state">
                <field name="name"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <menuitem id="menu_sf_production_meeting_root" name="Daily Production Meeting Actions" sequence="20"
              web_icon="sf_production_meeting_actions,static/description/icon.png"/>
    <menuitem id="menu_sf_production_meeting_main" name="Records"
              parent="menu_sf_production_meeting_root" action="action_sf_production_meeting" sequence="10"/>
</odoo>
