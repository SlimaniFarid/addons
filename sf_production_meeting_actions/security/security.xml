<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_production_meeting_actions" model="ir.module.category">
        <field name="name">Daily Production Meeting Actions</field>
        <field name="sequence">13</field>
    </record>
    <record id="group_production_meeting_actions_user" model="res.groups">
        <field name="name">Daily Production Meeting Actions User</field>
        <field name="category_id" ref="module_category_production_meeting_actions"/>
        <field name="implied_ids" eval="[(4, ref('mrp.group_mrp_user'))]"/>

    </record>
    <record id="group_production_meeting_actions_manager" model="res.groups">
        <field name="name">Daily Production Meeting Actions Manager</field>
        <field name="category_id" ref="module_category_production_meeting_actions"/>
        <field name="implied_ids" eval="[(4, ref('group_production_meeting_actions_user'))]"/>
    </record>
    <record id="rule_production_meeting_actions_sf_production_meeting" model="ir.rule">
        <field name="name">Production Meeting: multi-company</field>
        <field name="model_id" ref="model_sf_production_meeting"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
