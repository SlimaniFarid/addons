<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_sf_ai_doc_intelligence" model="ir.module.category">
        <field name="name">AI Doc Intelligence</field>
        <field name="description">AI Doc Intelligence Management</field>
        <field name="sequence">10</field>
    </record>

    <record id="group_sf_ai_doc_intelligence_user" model="res.groups">
        <field name="name">AI Doc Intelligence / User</field>
        <field name="category_id" ref="module_category_sf_ai_doc_intelligence"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_sf_ai_doc_intelligence_manager" model="res.groups">
        <field name="name">AI Doc Intelligence / Manager</field>
        <field name="category_id" ref="module_category_sf_ai_doc_intelligence"/>
        <field name="implied_ids" eval="[(4, ref('sf_ai_doc_intelligence.group_sf_ai_doc_intelligence_user'))]"/>
    </record>

    <record id="rule_sf_ai_doc_intelligence_company" model="ir.rule">
        <field name="name">AI Doc Intelligence: user sees own company</field>
        <field name="model_id" ref="model_sf_ai_doc_intelligence"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('sf_ai_doc_intelligence.group_sf_ai_doc_intelligence_user'))]"/>
    </record>
    <record id="rule_sf_ai_doc_intelligence_manager_all" model="ir.rule">
        <field name="name">AI Doc Intelligence: manager sees all companies</field>
        <field name="model_id" ref="model_sf_ai_doc_intelligence"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('sf_ai_doc_intelligence.group_sf_ai_doc_intelligence_manager'))]"/>
    </record>
</odoo>