<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_quality_alert_auto_assign" model="ir.actions.act_window">
        <field name="name">Quality Alert Auto-Assignment</field>
        <field name="res_model">sf.quality_alert_auto_assign</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
    <record id="view_sf_quality_alert_auto_assign_form" model="ir.ui.view">
        <field name="name">sf.quality_alert_auto_assign.form</field>
        <field name="model">sf.quality_alert_auto_assign</field>
        <field name="arch" type="xml">
            <form string="Quality Alert Auto-Assignment">
                <header>
                    <button name="action_submitted" type="object" string="Submitted"
                            class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="product_category"/>
                            <field name="defect_type"/>
                            <field name="assign_team"/>
                            <field name="fallback_user_id"/>
                            <field name="priority_boost"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_quality_alert_auto_assign_list" model="ir.ui.view">
        <field name="name">sf.quality_alert_auto_assign.list</field>
        <field name="model">sf.quality_alert_auto_assign</field>
        <field name="arch" type="xml">
            <list string="Quality Alert Auto-Assignment" sample="1">
                <field name="product_category"/>
                <field name="defect_type"/>
                <field name="assign_team"/>
                <field name="fallback_user_id"/>
                <field name="priority_boost"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state in ('submitted','approved')"/>
            </list>
        </field>
    </record>
    <record id="view_sf_quality_alert_auto_assign_kanban" model="ir.ui.view">
        <field name="name">sf.quality_alert_auto_assign.kanban</field>
        <field name="model">sf.quality_alert_auto_assign</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_view" group_by="state">
                <field name="name"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <menuitem id="menu_sf_quality_alert_auto_assign_root" name="Quality Alert Auto-Assignment" sequence="13"
              web_icon="sf_quality_alert_auto_assign,static/description/icon.png"/>
    <menuitem id="menu_sf_quality_alert_auto_assign_main" name="Records"
              parent="menu_sf_quality_alert_auto_assign_root" action="action_sf_quality_alert_auto_assign" sequence="10"/>
</odoo>
