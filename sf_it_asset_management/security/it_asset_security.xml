<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_it_asset" model="ir.module.category">
        <field name="name">IT Asset Management</field>
        <field name="sequence">96</field>
    </record>

    <record id="group_it_asset_user" model="res.groups">
        <field name="name">IT Asset User</field>
        <field name="category_id" ref="module_category_it_asset"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_it_asset_manager" model="res.groups">
        <field name="name">IT Asset Manager</field>
        <field name="category_id" ref="module_category_it_asset"/>
        <field name="implied_ids" eval="[(4, ref('group_it_asset_user'))]"/>
    </record>

    <record id="rule_it_asset_user_company" model="ir.rule">
        <field name="name">IT Asset: user sees own company</field>
        <field name="model_id" ref="model_sf_it_asset"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_it_asset_user'))]"/>
    </record>

    <record id="rule_it_license_user_company" model="ir.rule">
        <field name="name">IT License: user sees own company</field>
        <field name="model_id" ref="model_sf_it_license"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_it_asset_user'))]"/>
    </record>
    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_it_asset"/>
    </record>
    <record id="group_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="module_category_it_asset"/>
    </record>
</odoo>