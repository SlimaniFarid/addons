<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_sample_request" model="ir.actions.act_window">
        <field name="name">Sample Requests</field>
        <field name="res_model">sf.sample.request</field>
        <field name="view_mode">list,form,kanban,pivot</field>
        <field name="context">{'search_default_group_by_state': 1}</field>
    </record>

    <record id="view_sf_sample_request_form" model="ir.ui.view">
        <field name="name">sf.sample.request.form</field>
        <field name="model">sf.sample.request</field>
        <field name="arch" type="xml">
            <form string="Sample Request">
                <header>
                    <button name="action_approve" type="object"
                            string="Approve" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_ship" type="object" string="Shipped"
                            invisible="state != 'approved'"/>
                    <button name="action_receive_feedback" type="object"
                            string="Feedback Received"
                            invisible="state != 'shipped'"/>
                    <button name="action_convert" type="object"
                            string="Converted to Order" class="btn-success"
                            invisible="state != 'feedback'"/>
                    <button name="action_mark_lost" type="object"
                            string="Lost" invisible="state != 'feedback'"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state in ('converted','closed','cancelled')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,approved,shipped,feedback,converted"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="partner_id"/>
                            <field name="purpose"/>
                            <field name="requester_id"/>
                        </group>
                        <group>
                            <field name="total_cost" readonly="1"/>
                            <field name="shipping_cost"/>
                            <field name="followup_date"/>
                            <field name="shipment_ref"/>
                            <field name="picking_id" readonly="1"/>
                            <field name="sale_order_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Sample Lines" name="lines">
                            <field name="line_ids" readonly="state != 'draft'">
                                <list editable="bottom">
                                    <field name="product_id"/>
                                    <field name="quantity"/>
                                    <field name="unit_cost"/>
                                    <field name="subtotal" readonly="1"/>
                                    <field name="notes"/>
                                </list>
                            </field>
                        </page>
                        <page string="Feedback" name="feedback">
                            <field name="feedback_ids">
                                <list editable="bottom">
                                    <field name="feedback_date"/>
                                    <field name="contact_name"/>
                                    <field name="rating"/>
                                    <field name="comments"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_sample_request_list" model="ir.ui.view">
        <field name="name">sf.sample.request.list</field>
        <field name="model">sf.sample.request</field>
        <field name="arch" type="xml">
            <list string="Sample Requests" sample="1">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="purpose"/>
                <field name="total_cost"/>
                <field name="outcome"/>
                <field name="state" widget="badge"
                       decoration-success="state in ('converted','closed')"
                       decoration-muted="state == 'cancelled'"/>
            </list>
        </field>
    </record>
    <record id="view_sf_sample_request_kanban" model="ir.ui.view">
        <field name="name">sf.sample.request.kanban</field>
        <field name="model">sf.sample.request</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_view" group_by="state">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="total_cost"/>
                <field name="purpose"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong><field name="partner_id"/></strong><br/>
                                <field name="total_cost"/> -
                                <field name="purpose"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <menuitem id="menu_sf_sample_root" name="Samples" sequence="35"
              parent="sale.sale_menu_root"/>
    <menuitem id="menu_sf_sample_requests" name="Sample Requests"
              parent="menu_sf_sample_root" action="action_sf_sample_request"
              sequence="10"/>

    <record id="wave_final_sf_sample_management" model="ir.actions.server">
        <field name="name">Refresh Business Data</field>
        <field name="model_id" ref="model_sf_sample_request"/>
        <field name="binding_model_id" ref="model_sf_sample_request"/>
        <field name="state">code</field>
        <field name="code">records.action_refresh_business()</field>
    </record>
</odoo>
