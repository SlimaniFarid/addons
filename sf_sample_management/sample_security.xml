<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_sf_sample" model="ir.module.category">
        <field name="name">Sample Management</field>
        <field name="sequence">85</field>
    </record>
    <record id="group_sf_sample_user" model="res.groups">
        <field name="name">Sample Request User</field>
        <field name="category_id" ref="module_category_sf_sample"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
    </record>
    <record id="group_sf_sample_manager" model="res.groups">
        <field name="name">Sample Request Manager</field>
        <field name="category_id" ref="module_category_sf_sample"/>
        <field name="implied_ids" eval="[(4, ref('group_sf_sample_user'))]"/>
    </record>
    <record id="rule_sf_sample_company" model="ir.rule">
        <field name="name">Sample Request: multi-company</field>
        <field name="model_id" ref="model_sf_sample_request"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
