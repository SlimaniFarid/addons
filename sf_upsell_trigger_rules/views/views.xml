<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_upsell_trigger_rules" model="ir.actions.act_window">
        <field name="name">Upsell Trigger Rules</field>
        <field name="res_model">sf.upsell_trigger_rules</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
    <record id="view_sf_upsell_trigger_rules_form" model="ir.ui.view">
        <field name="name">sf.upsell_trigger_rules.form</field>
        <field name="model">sf.upsell_trigger_rules</field>
        <field name="arch" type="xml">
            <form string="Upsell Trigger Rules">
                <header>
                    <button name="action_submitted" type="object" string="Submitted"
                            class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="rule_name"/>
                            <field name="trigger_type"/>
                            <field name="threshold_value"/>
                            <field name="recommended_product"/>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_upsell_trigger_rules_list" model="ir.ui.view">
        <field name="name">sf.upsell_trigger_rules.list</field>
        <field name="model">sf.upsell_trigger_rules</field>
        <field name="arch" type="xml">
            <list string="Upsell Trigger Rules" sample="1">
                <field name="rule_name"/>
                <field name="trigger_type"/>
                <field name="threshold_value"/>
                <field name="recommended_product"/>
                <field name="active"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state in ('submitted','approved')"/>
            </list>
        </field>
    </record>
    <record id="view_sf_upsell_trigger_rules_kanban" model="ir.ui.view">
        <field name="name">sf.upsell_trigger_rules.kanban</field>
        <field name="model">sf.upsell_trigger_rules</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_view" group_by="state">
                <field name="name"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <menuitem id="menu_sf_upsell_trigger_rules_root" name="Upsell Trigger Rules" sequence="7"
              web_icon="sf_upsell_trigger_rules,static/description/icon.png"/>
    <menuitem id="menu_sf_upsell_trigger_rules_main" name="Records"
              parent="menu_sf_upsell_trigger_rules_root" action="action_sf_upsell_trigger_rules" sequence="10"/>

    <record id="wave_final_sf_upsell_trigger_rules" model="ir.actions.server">
        <field name="name">Refresh Business Data</field>
        <field name="model_id" ref="model_sf_upsell_trigger_rules"/>
        <field name="binding_model_id" ref="model_sf_upsell_trigger_rules"/>
        <field name="state">code</field>
        <field name="code">records.action_refresh_business()</field>
    </record>
</odoo>
