<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_upsell_trigger_rules" model="ir.module.category">
        <field name="name">Upsell Trigger Rules</field>
        <field name="sequence">294</field>
    </record>
    <record id="group_upsell_trigger_rules_user" model="res.groups">
        <field name="name">Upsell Trigger Rules User</field>
        <field name="category_id" ref="module_category_upsell_trigger_rules"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>

    </record>
    <record id="group_upsell_trigger_rules_manager" model="res.groups">
        <field name="name">Upsell Trigger Rules Manager</field>
        <field name="category_id" ref="module_category_upsell_trigger_rules"/>
        <field name="implied_ids" eval="[(4, ref('group_upsell_trigger_rules_user'))]"/>
    </record>
    <record id="rule_upsell_trigger_rules_sf_upsell_trigger_rules" model="ir.rule">
        <field name="name">Upsell Trigger Rules: multi-company</field>
        <field name="model_id" ref="model_sf_upsell_trigger_rules"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
