<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_oh" model="ir.module.category">
        <field name="name">Occupational Health</field>
        <field name="sequence">93</field>
    </record>

    <record id="group_oh_user" model="res.groups">
        <field name="name">Occupational Health User</field>
        <field name="category_id" ref="module_category_oh"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_oh_manager" model="res.groups">
        <field name="name">Occupational Health Manager</field>
        <field name="category_id" ref="module_category_oh"/>
        <field name="implied_ids" eval="[(4, ref('group_oh_user'))]"/>
    </record>

    <record id="rule_oh_file_user_company" model="ir.rule">
        <field name="name">Medical File: user sees own company</field>
        <field name="model_id" ref="model_sf_oh_medical_file"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_oh_user'))]"/>
    </record>

    <record id="rule_oh_visit_user_company" model="ir.rule">
        <field name="name">Medical Visit: user sees own company</field>
        <field name="model_id" ref="model_sf_oh_visit"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_oh_user'))]"/>
    </record>

    <record id="rule_oh_restriction_user_company" model="ir.rule">
        <field name="name">Restriction: user sees own company</field>
        <field name="model_id" ref="model_sf_oh_restriction"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_oh_user'))]"/>
    </record>

    <record id="rule_oh_vaccination_user_company" model="ir.rule">
        <field name="name">Vaccination: user sees own company</field>
        <field name="model_id" ref="model_sf_oh_vaccination"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_oh_user'))]"/>
    </record>

    <record id="rule_oh_file_manager_all" model="ir.rule">
        <field name="name">Medical File: manager sees all companies</field>
        <field name="model_id" ref="model_sf_oh_medical_file"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_oh_manager'))]"/>
    </record>

    <record id="rule_oh_visit_manager_all" model="ir.rule">
        <field name="name">Medical Visit: manager sees all companies</field>
        <field name="model_id" ref="model_sf_oh_visit"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_oh_manager'))]"/>
    </record>

    <record id="rule_oh_restriction_manager_all" model="ir.rule">
        <field name="name">Restriction: manager sees all companies</field>
        <field name="model_id" ref="model_sf_oh_restriction"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_oh_manager'))]"/>
    </record>

    <record id="rule_oh_vaccination_manager_all" model="ir.rule">
        <field name="name">Vaccination: manager sees all companies</field>
        <field name="model_id" ref="model_sf_oh_vaccination"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_oh_manager'))]"/>
    </record>

    <record id="rule_oh_doctor_manager_all" model="ir.rule">
        <field name="name">Doctor: manager sees all companies</field>
        <field name="model_id" ref="model_sf_oh_doctor"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_oh_manager'))]"/>
    </record>

    <record id="rule_oh_exposure_manager_all" model="ir.rule">
        <field name="name">Exposure: manager sees all companies</field>
        <field name="model_id" ref="model_sf_oh_exposure"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_oh_manager'))]"/>
    </record>
</odoo>