<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_employee_form_oh" model="ir.ui.view">
        <field name="name">hr.employee.form.oh</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form/sheet/notebook" position="inside">
                <page string="Occupational Health" name="occupational_health">
                    <group>
                        <group>
                            <field name="sf_oh_medical_file_id"/>
                            <field name="sf_oh_last_aptitude"/>
                        </group>
                    </group>
                    <field name="sf_oh_medical_file_ids" readonly="1">
                        <tree string="Medical Files">
                            <field name="state"/>
                            <field name="last_aptitude"/>
                            <field name="last_visit_date"/>
                            <field name="next_due_date"/>
                        </tree>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>