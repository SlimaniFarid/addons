<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_supplier_contract_renewal_alert" model="ir.module.category">
        <field name="name">Contract Renewal Alert System</field>
        <field name="sequence">478</field>
    </record>
    <record id="group_supplier_contract_renewal_alert_user" model="res.groups">
        <field name="name">Contract Renewal Alert System User</field>
        <field name="category_id" ref="module_category_supplier_contract_renewal_alert"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>

    </record>
    <record id="group_supplier_contract_renewal_alert_manager" model="res.groups">
        <field name="name">Contract Renewal Alert System Manager</field>
        <field name="category_id" ref="module_category_supplier_contract_renewal_alert"/>
        <field name="implied_ids" eval="[(4, ref('group_supplier_contract_renewal_alert_user'))]"/>
    </record>
    <record id="rule_supplier_contract_renewal_alert_sf_supplier_contract_renewal_alert" model="ir.rule">
        <field name="name">Contract Renewal Alert System: multi-company</field>
        <field name="model_id" ref="model_sf_supplier_contract_renewal_alert"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
