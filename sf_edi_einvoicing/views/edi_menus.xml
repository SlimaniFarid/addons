<odoo>
    <record id="action_edi_document" model="ir.actions.act_window">
        <field name="name">EDI Documents</field>
        <field name="res_model">edi.document</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{'search_default_group_by_state': 1}</field>
    </record>
    <record id="action_edi_partner" model="ir.actions.act_window">
        <field name="name">Trading Partners</field>
        <field name="res_model">edi.partner</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_edi_transmission" model="ir.actions.act_window">
        <field name="name">Transmissions</field>
        <field name="res_model">edi.transmission</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_group_by_state': 1}</field>
    </record>
    <record id="action_edi_document_type" model="ir.actions.act_window">
        <field name="name">Document Types</field>
        <field name="res_model">edi.document.type</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_edi_peppol" model="ir.actions.act_window">
        <field name="name">Peppol Access Points</field>
        <field name="res_model">edi.peppol.config</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_edi_document_form" model="ir.ui.view">
        <field name="name">edi.document.form</field>
        <field name="model">edi.document</field>
        <field name="arch" type="xml">
            <form string="EDI Document">
                <header>
                    <button name="action_validate" type="object" string="Validate" class="btn-primary" invisible="state not in ('draft','invalid')"/>
                    <button name="action_transmit" type="object" string="Transmit" class="btn-secondary" invisible="state != 'valid'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,valid,sent,delivered,rejected,error"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="partner_id"/>
                            <field name="direction"/>
                            <field name="document_type_id"/>
                            <field name="format_id"/>
                        </group>
                        <group>
                            <field name="source_record"/>
                            <field name="peppol_message_id"/>
                            <field name="peppol_status" invisible="direction != 'outbound'"/>
                            <field name="validation_errors" widget="text" invisible="state != 'invalid'"/>
                        </group>
                    </group>
                    <group string="Content">
                        <field name="raw_content" filename="raw_filename"/>
                        <field name="raw_filename" invisible="1"/>
                        <field name="parsed_data" widget="text" readonly="1"/>
                    </group>
                    <notebook>
                        <page string="Transmissions" name="transmissions">
                            <field name="transmission_ids">
                                <list>
                                    <field name="create_date"/>
                                    <field name="protocol"/>
                                    <field name="direction"/>
                                    <field name="state"/>
                                    <field name="sent_at"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                    <group invisible="1">
                        <field name="company_id"/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_edi_document_list" model="ir.ui.view">
        <field name="name">edi.document.list</field>
        <field name="model">edi.document</field>
        <field name="arch" type="xml">
            <list string="EDI Documents">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="document_type_id"/>
                <field name="direction"/>
                <field name="state"/>
                <field name="create_date"/>
            </list>
        </field>
    </record>

    <record id="view_edi_partner_form" model="ir.ui.view">
        <field name="name">edi.partner.form</field>
        <field name="model">edi.partner</field>
        <field name="arch" type="xml">
            <form string="Trading Partner">
                <header>
                    <field name="status" widget="statusbar" statusbar_visible="draft,active,suspended"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="gln"/>
                            <field name="peppol_id"/>
                            <field name="edi_code"/>
                            <field name="preferred_format"/>
                            <field name="supported_doc_types" widget="many2many_tags"/>
                            <field name="last_exchange" readonly="1"/>
                        </group>
                        <group string="Channels">
                            <field name="supports_peppol"/>
                            <field name="supports_as2"/>
                            <field name="supports_sftp"/>
                            <field name="supports_api"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Peppol" name="peppol">
                            <group>
                                <field name="peppol_smp_url"/>
                                <field name="peppol_certificate" filename="peppol_certificate"/>
                                <field name="peppol_cert_expiry"/>
                            </group>
                        </page>
                        <page string="AS2" name="as2">
                            <group>
                                <field name="as2_url"/>
                                <field name="as2_cert" filename="as2_cert"/>
                                <field name="as2_encryption"/>
                            </group>
                        </page>
                        <page string="SFTP" name="sftp">
                            <group>
                                <field name="sftp_host"/>
                                <field name="sftp_port"/>
                                <field name="sftp_username"/>
                                <field name="sftp_password" password="True"/>
                                <field name="sftp_key" filename="sftp_key"/>
                            </group>
                        </page>
                    </notebook>
                    <group invisible="1">
                        <field name="company_id"/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_edi_partner_list" model="ir.ui.view">
        <field name="name">edi.partner.list</field>
        <field name="model">edi.partner</field>
        <field name="arch" type="xml">
            <list string="Trading Partners">
                <field name="partner_id"/>
                <field name="gln"/>
                <field name="peppol_id"/>
                <field name="edi_code"/>
                <field name="preferred_format"/>
                <field name="status"/>
            </list>
        </field>
    </record>

    <record id="view_edi_transmission_form" model="ir.ui.view">
        <field name="name">edi.transmission.form</field>
        <field name="model">edi.transmission</field>
        <field name="arch" type="xml">
            <form string="EDI Transmission">
                <header>
                    <button name="action_send" type="object" string="Send" class="btn-primary" invisible="state not in ('pending','failed','retry')"/>
                    <field name="state" widget="statusbar" statusbar_visible="pending,sending,sent,delivered,failed"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="document_id"/>
                            <field name="partner_id"/>
                            <field name="direction"/>
                            <field name="protocol"/>
                        </group>
                        <group>
                            <field name="sent_at"/>
                            <field name="delivered_at"/>
                            <field name="retry_count"/>
                            <field name="max_retries"/>
                            <field name="error_message" widget="text" invisible="state not in ('failed','retry')"/>
                        </group>
                    </group>
                    <group string="Response">
                        <field name="response_data" widget="text" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_edi_transmission_list" model="ir.ui.view">
        <field name="name">edi.transmission.list</field>
        <field name="model">edi.transmission</field>
        <field name="arch" type="xml">
            <list string="EDI Transmissions">
                <field name="create_date"/>
                <field name="document_id"/>
                <field name="partner_id"/>
                <field name="protocol"/>
                <field name="direction"/>
                <field name="state"/>
                <field name="sent_at"/>
            </list>
        </field>
    </record>

    <record id="view_edi_document_type_form" model="ir.ui.view">
        <field name="name">edi.document.type.form</field>
        <field name="model">edi.document.type</field>
        <field name="arch" type="xml">
            <form string="EDI Document Type">
                <group>
                    <field name="name"/>
                    <field name="code"/>
                    <field name="standard"/>
                    <field name="direction"/>
                    <field name="description"/>
                </group>
            </form>
        </field>
    </record>
    <record id="view_edi_document_type_list" model="ir.ui.view">
        <field name="name">edi.document.type.list</field>
        <field name="model">edi.document.type</field>
        <field name="arch" type="xml">
            <list string="EDI Document Types">
                <field name="name"/>
                <field name="code"/>
                <field name="standard"/>
                <field name="direction"/>
            </list>
        </field>
    </record>

    <record id="view_edi_peppol_form" model="ir.ui.view">
        <field name="name">edi.peppol.config.form</field>
        <field name="model">edi.peppol.config</field>
        <field name="arch" type="xml">
            <form string="Peppol Access Point">
                <header>
                    <button name="action_health_check" type="object" string="Health Check" class="btn-primary"/>
                    <button name="action_register_participant" type="object" string="Register Participant" class="btn-secondary"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="company_id"/>
                            <field name="is_active"/>
                            <field name="last_health_check" readonly="1"/>
                        </group>
                        <group string="Participant">
                            <field name="participant_id"/>
                            <field name="participant_scheme"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="SMP" name="smp">
                            <group>
                                <field name="smp_url"/>
                                <field name="smp_api_key" password="True"/>
                            </group>
                        </page>
                        <page string="Certificate" name="certificate">
                            <group>
                                <field name="certificate" filename="certificate"/>
                                <field name="certificate_password" password="True"/>
                                <field name="certificate_expiry"/>
                            </group>
                        </page>
                        <page string="Settings" name="settings">
                            <group>
                                <field name="auto_register"/>
                                <field name="validate_inbound"/>
                                <field name="sign_outbound"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_edi_peppol_list" model="ir.ui.view">
        <field name="name">edi.peppol.config.list</field>
        <field name="model">edi.peppol.config</field>
        <field name="arch" type="xml">
            <list string="Peppol Access Points">
                <field name="name"/>
                <field name="company_id"/>
                <field name="participant_id"/>
                <field name="certificate_expiry"/>
                <field name="is_active" widget="boolean"/>
            </list>
        </field>
    </record>

    <menuitem id="menu_edi_root" name="EDI &amp; E-Invoicing" sequence="55" web_icon="sf_edi_einvoicing,static/description/icon.png"/>
    <menuitem id="menu_edi_documents" name="EDI Documents" parent="menu_edi_root" action="action_edi_document" sequence="10"/>
    <menuitem id="menu_edi_transmissions" name="Transmissions" parent="menu_edi_root" action="action_edi_transmission" sequence="20"/>
    <menuitem id="menu_edi_partners" name="Trading Partners" parent="menu_edi_root" action="action_edi_partner" sequence="30"/>
    <menuitem id="menu_edi_types" name="Document Types" parent="menu_edi_root" action="action_edi_document_type" sequence="40"/>
    <menuitem id="menu_edi_peppol" name="Peppol Access Points" parent="menu_edi_root" action="action_edi_peppol" sequence="50"/>

    <record id="view_sf_edi_einvoicing_boost_kanban" model="ir.ui.view">
        <field name="name">sf_edi_einvoicing.boost.kanban</field>
        <field name="model">edi.document</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" t-att-color="state">
                <field name="name"/>
                <field name="state"/>
                <field name="user_id"/>

                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_card oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title">
                                    <field name="name"/></strong>
                                <div class="o_kanban_record_subtitle">
                                    <field name="user_id" widget="many2one_avatar_user"/>
                                    <field name="create_date"/></div>
                            </div>
                            <div class="oe_kanban_bottom_right">
                                <field name="state" widget="badge"
                                       t-attf-options="{'classes_map': {'draft': 'info', 'done': 'success', 'cancelled': 'danger'}, 'domain': []}"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_sf_edi_einvoicing_boost_search" model="ir.ui.view">
        <field name="name">sf_edi_einvoicing.boost.search</field>
        <field name="model">edi.document</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
<separator/>
                <filter string="My records" name="my_records" domain="[('user_id', '=', uid)]"/>
                <filter string="To Do" name="todo" domain="[('state', 'not in', ('done', 'cancelled', 'closed'))]"/>
                <group expand="0" string="Group By"><filter string="Status" name="gb_state" context="{'group_by': 'state'}"/></group>
            </search>
        </field>
    </record>

    <record id="wave_final_sf_edi_einvoicing" model="ir.actions.server">
        <field name="name">Refresh Business Data</field>
        <field name="model_id" ref="model_edi_document"/>
        <field name="binding_model_id" ref="model_edi_document"/>
        <field name="state">code</field>
        <field name="code">records.action_refresh_business()</field>
    </record>
</odoo>
