<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_sf_edi_einvoicing" model="ir.module.category">
        <field name="name">Edi Einvoicing</field>
        <field name="description">Edi Einvoicing Management</field>
        <field name="sequence">10</field>
    </record>

    <record id="group_sf_edi_einvoicing_user" model="res.groups">
        <field name="name">Edi Einvoicing / User</field>
        <field name="category_id" ref="module_category_sf_edi_einvoicing"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_sf_edi_einvoicing_manager" model="res.groups">
        <field name="name">Edi Einvoicing / Manager</field>
        <field name="category_id" ref="module_category_sf_edi_einvoicing"/>
        <field name="implied_ids" eval="[(4, ref('sf_edi_einvoicing.group_sf_edi_einvoicing_user'))]"/>
    </record>

    <record id="rule_sf_edi_einvoicing_company" model="ir.rule">
        <field name="name">Edi Einvoicing: user sees own company</field>
        <field name="model_id" ref="model_sf_edi_einvoicing"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('sf_edi_einvoicing.group_sf_edi_einvoicing_user'))]"/>
    </record>
    <record id="rule_sf_edi_einvoicing_manager_all" model="ir.rule">
        <field name="name">Edi Einvoicing: manager sees all companies</field>
        <field name="model_id" ref="model_sf_edi_einvoicing"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('sf_edi_einvoicing.group_sf_edi_einvoicing_manager'))]"/>
    </record>
    <record id="group_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="module_category_sf_edi_einvoicing"/>
    </record>
    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_sf_edi_einvoicing"/>
    </record>
    <record id="group_system" model="res.groups">
        <field name="name">System</field>
        <field name="category_id" ref="module_category_sf_edi_einvoicing"/>
    </record>
</odoo>