<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_quality_alert_aging" model="ir.module.category">
        <field name="name">Quality Alert Aging Monitor</field>
        <field name="sequence">10</field>
    </record>
    <record id="group_quality_alert_aging_user" model="res.groups">
        <field name="name">Quality Alert Aging Monitor User</field>
        <field name="category_id" ref="module_category_quality_alert_aging"/>
        <field name="implied_ids" eval="[(4, ref('quality.group_quality_user'))]"/>

    </record>
    <record id="group_quality_alert_aging_manager" model="res.groups">
        <field name="name">Quality Alert Aging Monitor Manager</field>
        <field name="category_id" ref="module_category_quality_alert_aging"/>
        <field name="implied_ids" eval="[(4, ref('group_quality_alert_aging_user'))]"/>
    </record>
    <record id="rule_quality_alert_aging_sf_qalert_aging" model="ir.rule">
        <field name="name">Alert Aging Entry: multi-company</field>
        <field name="model_id" ref="model_sf_qalert_aging"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
