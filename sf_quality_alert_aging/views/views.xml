<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_qalert_aging" model="ir.actions.act_window">
        <field name="name">Quality Alert Aging Monitor</field>
        <field name="res_model">sf.qalert.aging</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
    <record id="view_sf_qalert_aging_form" model="ir.ui.view">
        <field name="name">sf.qalert.aging.form</field>
        <field name="model">sf.qalert.aging</field>
        <field name="arch" type="xml">
            <form string="Quality Alert Aging Monitor">
                <header>
                    <button name="action_escalated" type="object" string="Escalated"
                            class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="open,escalated,closed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="alert_ref"/>
                            <field name="opened_date"/>
                            <field name="owner_id"/>
                            <field name="aging_days"/>
                            <field name="escalation_level"/>
                            <field name="blocker"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_qalert_aging_list" model="ir.ui.view">
        <field name="name">sf.qalert.aging.list</field>
        <field name="model">sf.qalert.aging</field>
        <field name="arch" type="xml">
            <list string="Quality Alert Aging Monitor" sample="1">
                <field name="alert_ref"/>
                <field name="opened_date"/>
                <field name="owner_id"/>
                <field name="aging_days"/>
                <field name="escalation_level"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state in ('submitted','approved')"/>
            </list>
        </field>
    </record>
    <record id="view_sf_qalert_aging_kanban" model="ir.ui.view">
        <field name="name">sf.qalert.aging.kanban</field>
        <field name="model">sf.qalert.aging</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_view" group_by="state">
                <field name="name"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <menuitem id="menu_sf_qalert_aging_root" name="Quality Alert Aging Monitor" sequence="13"
              web_icon="sf_quality_alert_aging,static/description/icon.png"/>
    <menuitem id="menu_sf_qalert_aging_main" name="Records"
              parent="menu_sf_qalert_aging_root" action="action_sf_qalert_aging" sequence="10"/>

    <record id="wave2_qaging_sync" model="ir.actions.server">
        <field name="name">Sync native quality alerts</field>
        <field name="model_id" ref="model_sf_qalert_aging"/>
        <field name="binding_model_id" ref="model_sf_qalert_aging"/>
        <field name="state">code</field>
        <field name="code">records.action_sync_alerts()</field>
    </record>
</odoo>
