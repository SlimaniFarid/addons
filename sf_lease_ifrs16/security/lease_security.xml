<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_sf_lease" model="ir.module.category">
        <field name="name">Lease Accounting</field>
        <field name="sequence">96</field>
    </record>

    <record id="group_sf_lease_user" model="res.groups">
        <field name="name">Lease Accounting User</field>
        <field name="category_id" ref="module_category_sf_lease"/>
        <field name="implied_ids" eval="[(4, ref('account.group_account_invoice'))]"/>
    </record>

    <record id="group_sf_lease_manager" model="res.groups">
        <field name="name">Lease Accounting Manager</field>
        <field name="category_id" ref="module_category_sf_lease"/>
        <field name="implied_ids" eval="[(4, ref('group_sf_lease_user'))]"/>
    </record>

    <record id="rule_sf_lease_contract_company" model="ir.rule">
        <field name="name">Lease Contract: multi-company</field>
        <field name="model_id" ref="model_sf_lease_contract"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_sf_lease_payment_line_company" model="ir.rule">
        <field name="name">Lease Payment Line: multi-company</field>
        <field name="model_id" ref="model_sf_lease_payment_line"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
