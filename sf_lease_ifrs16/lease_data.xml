<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="seq_sf_lease_contract" model="ir.sequence">
        <field name="name">Lease Contract</field>
        <field name="code">sf.lease.contract</field>
        <field name="prefix">LEASE/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_sf_lease_modification" model="ir.sequence">
        <field name="name">Lease Modification</field>
        <field name="code">sf.lease.modification</field>
        <field name="prefix">LMOD/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
