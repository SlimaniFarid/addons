<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Demo lease requires accounts from the installed localization.
         This demo creates a contract with generic defaults; the tester
         should map accounts on first activation. -->
    <record id="demo_lease_office_paris" model="sf.lease.contract">
        <field name="display_description">Office lease - Paris HQ 3rd floor</field>
        <field name="lessor_id" ref="base.res_partner_2"/>
        <field name="asset_category">real_estate</field>
        <field name="start_date" eval="(DateTime.today() - timedelta(days=90)).strftime('%Y-%m-%d')"/>
        <field name="term_months">60</field>
        <field name="payment_frequency">monthly</field>
        <field name="payment_amount">8500.0</field>
        <field name="payment_timing">arrears</field>
        <field name="incremental_borrowing_rate">4.5</field>
        <field name="initial_direct_costs">12000.0</field>
        <field name="incentives_received">8500.0</field>
    </record>
</odoo>
