<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ACTIONS -->
    <record id="action_sf_lease_contract" model="ir.actions.act_window">
        <field name="name">Lease Contracts</field>
        <field name="res_model">sf.lease.contract</field>
        <field name="view_mode">list,form,kanban,pivot</field>
        <field name="context">{'search_default_group_by_state': 1}</field>
    </record>
    <record id="action_sf_lease_modification" model="ir.actions.act_window">
        <field name="name">Modifications</field>
        <field name="res_model">sf.lease.modification</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_group_by_state': 1}</field>
    </record>

    <!-- CONTRACT FORM -->
    <record id="view_sf_lease_contract_form" model="ir.ui.view">
        <field name="name">sf.lease.contract.form</field>
        <field name="model">sf.lease.contract</field>
        <field name="arch" type="xml">
            <form string="Lease Contract">
                <header>
                    <button name="action_activate" type="object" string="Activate Lease"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_generate_schedule" type="object"
                            string="Regenerate Schedule" invisible="state == 'closed'"/>
                    <button name="action_post_due_entries" type="object"
                            string="Post Due Entries" class="btn-primary"
                            invisible="state not in ('active','modified')"/>
                    <button name="action_terminate" type="object" string="Terminate Early"
                            invisible="state not in ('active','modified')"/>
                    <button name="action_close" type="object" string="Close Lease"
                            invisible="state not in ('active','modified')"/>
                    <button name="action_reopen_draft" type="object" string="Set to Draft"
                            invisible="state != 'terminated'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,active,modified,closed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_schedule_report" type="object"
                                class="oe_stat_button" icon="fa-file-pdf-o">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Schedule</span>
                                <span class="o_stat_text">PDF</span>
                            </div>
                        </button>
                        <button name="%(action_sf_lease_modification)d" type="action"
                                class="oe_stat_button" icon="fa-edit"
                                context="{'default_contract_id': id}">
                            <field name="modification_count" widget="statinfo"
                                   string="Modifications"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Lease Terms">
                            <field name="display_description"/>
                            <field name="lessor_id"/>
                            <field name="asset_category"/>
                            <field name="start_date"/>
                            <field name="term_months"/>
                            <field name="end_date"/>
                        </group>
                        <group string="Payments and Discounting">
                            <field name="payment_amount"/>
                            <field name="payment_frequency"/>
                            <field name="payment_timing"/>
                            <field name="incremental_borrowing_rate"/>
                            <field name="asc842_classification"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <group string="Exemptions">
                        <field name="short_term_exemption"/>
                        <field name="low_value_exemption"/>
                    </group>
                    <group string="Initial Measurement Components">
                        <group>
                            <field name="initial_direct_costs"/>
                            <field name="prepaid_rent"/>
                        </group>
                        <group>
                            <field name="restoration_costs"/>
                            <field name="incentives_received"/>
                        </group>
                    </group>
                    <group string="Measured at Commencement">
                        <group>
                            <field name="lease_liability_initial"/>
                            <field name="rou_asset_initial"/>
                        </group>
                        <group>
                            <field name="monthly_depreciation"/>
                            <field name="fully_posted" widget="boolean"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Payment Schedule" name="schedule">
                            <field name="payment_line_ids" readonly="1">
                                <list create="0" delete="0" editable="false">
                                    <field name="period_index" string="P#"/>
                                    <field name="due_date"/>
                                    <field name="payment_amount"/>
                                    <field name="opening_liability"/>
                                    <field name="interest"/>
                                    <field name="principal"/>
                                    <field name="closing_liability"/>
                                    <field name="depreciation"/>
                                    <field name="posted" widget="boolean"/>
                                    <field name="move_id"/>
                                </list>
                            </field>
                        </page>
                        <page string="Modifications" name="mods">
                            <field name="modification_ids" readonly="1">
                                <list create="0">
                                    <field name="name"/>
                                    <field name="mod_type"/>
                                    <field name="effective_date"/>
                                    <field name="remeasured_liability"/>
                                    <field name="adjustment"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                        <page string="Accounting" name="accounts">
                            <group>
                                <group>
                                    <field name="rou_asset_account_id"/>
                                    <field name="accumulated_depreciation_account_id"/>
                                    <field name="payment_journal_id"/>
                                </group>
                                <group>
                                    <field name="interest_expense_account_id"/>
                                    <field name="depreciation_expense_account_id"/>
                                    <field name="lease_expense_account_id"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- CONTRACT LIST -->
    <record id="view_sf_lease_contract_list" model="ir.ui.view">
        <field name="name">sf.lease.contract.list</field>
        <field name="model">sf.lease.contract</field>
        <field name="arch" type="xml">
            <list string="Lease Contracts" sample="1">
                <field name="name"/>
                <field name="display_description"/>
                <field name="lessor_id"/>
                <field name="asset_category"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="rou_asset_initial"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'active'"
                       decoration-info="state == 'modified'"
                       decoration-warning="state == 'terminated'"
                       decoration-muted="state in ('draft','closed')"/>
            </list>
        </field>
    </record>

    <!-- CONTRACT KANBAN -->
    <record id="view_sf_lease_contract_kanban" model="ir.ui.view">
        <field name="name">sf.lease.contract.kanban</field>
        <field name="model">sf.lease.contract</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_view">
                <field name="name"/>
                <field name="display_description"/>
                <field name="lessor_id"/>
                <field name="rou_asset_initial"/>
                <field name="state"/>
                <field name="end_date"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong><field name="display_description"/></strong><br/>
                                <field name="lessor_id"/><br/>
                                ROU: <field name="rou_asset_initial"/><br/>
                                End: <field name="end_date"/>
                            </div>
                            <div class="oe_kanban_footer">
                                <field name="state" widget="badge"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- CONTRACT PIVOT -->
    <record id="view_sf_lease_contract_pivot" model="ir.ui.view">
        <field name="name">sf.lease.contract.pivot</field>
        <field name="model">sf.lease.contract</field>
        <field name="arch" type="xml">
            <pivot string="Lease Portfolio">
                <field name="asset_category" type="row"/>
                <field name="state" type="col"/>
                <field name="rou_asset_initial" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- MODIFICATION FORM -->
    <record id="view_sf_lease_modification_form" model="ir.ui.view">
        <field name="name">sf.lease.modification.form</field>
        <field name="model">sf.lease.modification</field>
        <field name="arch" type="xml">
            <form string="Lease Modification">
                <header>
                    <button name="action_apply" type="object" string="Apply Re-measurement"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state != 'draft'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,applied,cancelled"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="contract_id" readonly="state != 'draft'"/>
                            <field name="mod_type" readonly="state != 'draft'"/>
                            <field name="effective_date" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="new_payment_amount" readonly="state != 'draft'"/>
                            <field name="new_term_months" readonly="state != 'draft'"/>
                            <field name="extend_term_months" readonly="state != 'draft'"/>
                            <field name="new_ibr" readonly="state != 'draft'"/>
                        </group>
                    </group>
                    <group string="Reason">
                        <field name="reason" readonly="state != 'draft'"/>
                    </group>
                    <group string="Result" invisible="state != 'applied'">
                        <group>
                            <field name="liability_before"/>
                            <field name="remeasured_liability"/>
                        </group>
                        <group>
                            <field name="adjustment"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- MODIFICATION LIST -->
    <record id="view_sf_lease_modification_list" model="ir.ui.view">
        <field name="name">sf.lease.modification.list</field>
        <field name="model">sf.lease.modification</field>
        <field name="arch" type="xml">
            <list string="Lease Modifications" sample="1">
                <field name="name"/>
                <field name="contract_id"/>
                <field name="mod_type"/>
                <field name="effective_date"/>
                <field name="remeasured_liability"/>
                <field name="adjustment"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'applied'"
                       decoration-muted="state == 'cancelled'"/>
            </list>
        </field>
    </record>

    <!-- MENUS -->
    <menuitem id="menu_sf_lease_root" name="Lease Accounting" sequence="46"
              web_icon="sf_lease_ifrs16,static/description/icon.png"/>
    <menuitem id="menu_sf_lease_contracts" name="Lease Contracts"
              parent="menu_sf_lease_root" action="action_sf_lease_contract" sequence="10"/>
    <menuitem id="menu_sf_lease_modifications" name="Modifications"
              parent="menu_sf_lease_root" action="action_sf_lease_modification"
              sequence="20"/>

    <record id="wave_final_sf_lease_ifrs16" model="ir.actions.server">
        <field name="name">Refresh Business Data</field>
        <field name="model_id" ref="model_sf_lease_contract"/>
        <field name="binding_model_id" ref="model_sf_lease_contract"/>
        <field name="state">code</field>
        <field name="code">records.action_refresh_business()</field>
    </record>
</odoo>
