<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_lease_schedule" model="ir.actions.report">
        <field name="name">Lease Schedule</field>
        <field name="model">sf.lease.contract</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">sf_lease_ifrs16.report_lease_schedule</field>
        <field name="report_file">sf_lease_ifrs16.report_lease_schedule</field>
        <field name="print_report_name">'Lease Schedule - %s' % (object.name)</field>
    </record>

    <template id="report_lease_schedule">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2 class="mt16">
                            Lease Schedule -
                            <span t-out="doc.name"/>
                        </h2>
                        <h4 t-out="doc.display_description"/>
                        <div class="row mb16">
                            <div class="col-3">
                                <strong>Lessor:</strong>
                                <span t-out="doc.lessor_id.name"/>
                            </div>
                            <div class="col-3">
                                <strong>Start:</strong>
                                <span t-out="doc.start_date"/>
                            </div>
                            <div class="col-3">
                                <strong>End:</strong>
                                <span t-out="doc.end_date"/>
                            </div>
                            <div class="col-3">
                                <strong>IBR:</strong>
                                <span t-out="'%.2f%%' % doc.incremental_borrowing_rate"/>
                            </div>
                        </div>
                        <div class="row mb16">
                            <div class="col-4">
                                <strong>Initial Liability:</strong>
                                <span t-out="'%s %s' % (doc.currency_id.symbol, '{:,.2f}'.format(doc.lease_liability_initial))"/>
                            </div>
                            <div class="col-4">
                                <strong>Initial ROU Asset:</strong>
                                <span t-out="'%s %s' % (doc.currency_id.symbol, '{:,.2f}'.format(doc.rou_asset_initial))"/>
                            </div>
                            <div class="col-4">
                                <strong>Status:</strong>
                                <span t-out="doc.state"/>
                            </div>
                        </div>
                        <table class="table table-sm table-bordered o_main_table">
                            <thead>
                                <tr>
                                    <th>Period</th>
                                    <th>Due Date</th>
                                    <th class="text-end">Payment</th>
                                    <th class="text-end">Opening</th>
                                    <th class="text-end">Interest</th>
                                    <th class="text-end">Principal</th>
                                    <th class="text-end">Closing</th>
                                    <th class="text-end">Depreciation</th>
                                    <th>Posted</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="doc.payment_line_ids" t-as="line">
                                    <td t-out="line.period_index"/>
                                    <td t-out="line.due_date"/>
                                    <td class="text-end" t-out="'{:,.2f}'.format(line.payment_amount)"/>
                                    <td class="text-end" t-out="'{:,.2f}'.format(line.opening_liability)"/>
                                    <td class="text-end" t-out="'{:,.2f}'.format(line.interest)"/>
                                    <td class="text-end" t-out="'{:,.2f}'.format(line.principal)"/>
                                    <td class="text-end" t-out="'{:,.2f}'.format(line.closing_liability)"/>
                                    <td class="text-end" t-out="'{:,.2f}'.format(line.depreciation)"/>
                                    <td t-out="'Yes' if line.posted else 'No'"/>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
