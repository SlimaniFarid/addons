<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_project_charter" model="ir.module.category">
        <field name="name">Project Charter Manager</field>
        <field name="sequence">400</field>
    </record>
    <record id="group_project_charter_user" model="res.groups">
        <field name="name">Project Charter Manager User</field>
        <field name="category_id" ref="module_category_project_charter"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>

    </record>
    <record id="group_project_charter_manager" model="res.groups">
        <field name="name">Project Charter Manager Manager</field>
        <field name="category_id" ref="module_category_project_charter"/>
        <field name="implied_ids" eval="[(4, ref('group_project_charter_user'))]"/>
    </record>
    <record id="rule_project_charter_sf_project_charter" model="ir.rule">
        <field name="name">Project Charter Manager: multi-company</field>
        <field name="model_id" ref="model_sf_project_charter"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_project_charter"/>
    </record>
</odoo>
