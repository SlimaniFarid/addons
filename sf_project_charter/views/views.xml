<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_project_charter" model="ir.actions.act_window">
        <field name="name">Project Charter Manager</field>
        <field name="res_model">sf.project_charter</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
    <record id="view_sf_project_charter_form" model="ir.ui.view">
        <field name="name">sf.project_charter.form</field>
        <field name="model">sf.project_charter</field>
        <field name="arch" type="xml">
            <form string="Project Charter Manager">
                <header>
                    <button name="action_submitted" type="object" string="Submitted"
                            class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="project_name"/>
                        <field name="objectives"/>
                        <field name="scope"/>
                            <field name="budget"/>
                            <field name="sponsor_id"/>
                            <field name="start_date"/>
                            <field name="end_date"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_project_charter_list" model="ir.ui.view">
        <field name="name">sf.project_charter.list</field>
        <field name="model">sf.project_charter</field>
        <field name="arch" type="xml">
            <list string="Project Charter Manager" sample="1">
                <field name="project_name"/>
                <field name="objectives"/>
                <field name="scope"/>
                <field name="budget"/>
                <field name="sponsor_id"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state in ('submitted','approved')"/>
            </list>
        </field>
    </record>
    <record id="view_sf_project_charter_kanban" model="ir.ui.view">
        <field name="name">sf.project_charter.kanban</field>
        <field name="model">sf.project_charter</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_view" group_by="state">
                <field name="name"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <menuitem id="menu_sf_project_charter_root" name="Project Charter Manager" sequence="1"
              web_icon="sf_project_charter,static/description/icon.png"/>
    <menuitem id="menu_sf_project_charter_main" name="Records"
              parent="menu_sf_project_charter_root" action="action_sf_project_charter" sequence="10"/>
</odoo>
