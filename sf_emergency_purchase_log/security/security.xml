<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_emergency_purchase_log" model="ir.module.category">
        <field name="name">Emergency Purchase Workflow</field>
        <field name="sequence">35</field>
    </record>
    <record id="group_emergency_purchase_log_user" model="res.groups">
        <field name="name">Emergency Purchase Workflow User</field>
        <field name="category_id" ref="module_category_emergency_purchase_log"/>
        <field name="implied_ids" eval="[(4, ref('purchase.group_purchase_user'))]"/>

    </record>
    <record id="group_emergency_purchase_log_manager" model="res.groups">
        <field name="name">Emergency Purchase Workflow Manager</field>
        <field name="category_id" ref="module_category_emergency_purchase_log"/>
        <field name="implied_ids" eval="[(4, ref('group_emergency_purchase_log_user'))]"/>
    </record>
    <record id="rule_emergency_purchase_log_sf_emergency_purchase" model="ir.rule">
        <field name="name">Emergency Purchase: multi-company</field>
        <field name="model_id" ref="model_sf_emergency_purchase"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_emergency_purchase_log"/>
    </record>
</odoo>
