<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_emergency_purchase" model="ir.actions.act_window">
        <field name="name">Emergency Purchase Workflow</field>
        <field name="res_model">sf.emergency.purchase</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
    <record id="view_sf_emergency_purchase_form" model="ir.ui.view">
        <field name="name">sf.emergency.purchase.form</field>
        <field name="model">sf.emergency.purchase</field>
        <field name="arch" type="xml">
            <form string="Emergency Purchase Workflow">
                <header>
                    <button name="action_approved" type="object" string="Approved"
                            class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="logged,approved,po_created"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="vendor_id"/>
                            <field name="reason"/>
                            <field name="amount"/>
                            <field name="retro_po_ref"/>
                            <field name="justification"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_emergency_purchase_list" model="ir.ui.view">
        <field name="name">sf.emergency.purchase.list</field>
        <field name="model">sf.emergency.purchase</field>
        <field name="arch" type="xml">
            <list string="Emergency Purchase Workflow" sample="1">
                <field name="vendor_id"/>
                <field name="reason"/>
                <field name="amount"/>
                <field name="retro_po_ref"/>
                <field name="justification"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state in ('submitted','approved')"/>
            </list>
        </field>
    </record>
    <record id="view_sf_emergency_purchase_kanban" model="ir.ui.view">
        <field name="name">sf.emergency.purchase.kanban</field>
        <field name="model">sf.emergency.purchase</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_view" group_by="state">
                <field name="name"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <menuitem id="menu_sf_emergency_purchase_root" name="Emergency Purchase Workflow" sequence="23"
              web_icon="sf_emergency_purchase_log,static/description/icon.png"/>
    <menuitem id="menu_sf_emergency_purchase_main" name="Records"
              parent="menu_sf_emergency_purchase_root" action="action_sf_emergency_purchase" sequence="10"/>
</odoo>
