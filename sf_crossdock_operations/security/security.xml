<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_crossdock_operations" model="ir.module.category">
        <field name="name">Cross-Dock Operations Log</field>
        <field name="sequence">29</field>
    </record>
    <record id="group_crossdock_operations_user" model="res.groups">
        <field name="name">Cross-Dock Operations Log User</field>
        <field name="category_id" ref="module_category_crossdock_operations"/>
        <field name="implied_ids" eval="[(4, ref('stock.group_stock_user'))]"/>

    </record>
    <record id="group_crossdock_operations_manager" model="res.groups">
        <field name="name">Cross-Dock Operations Log Manager</field>
        <field name="category_id" ref="module_category_crossdock_operations"/>
        <field name="implied_ids" eval="[(4, ref('group_crossdock_operations_user'))]"/>
    </record>
    <record id="rule_crossdock_operations_sf_crossdock" model="ir.rule">
        <field name="name">Cross-Dock Operation: multi-company</field>
        <field name="model_id" ref="model_sf_crossdock"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_crossdock_operations"/>
    </record>
</odoo>
