<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_crossdock" model="ir.actions.act_window">
        <field name="name">Cross-Dock Operations Log</field>
        <field name="res_model">sf.crossdock</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
    <record id="view_sf_crossdock_form" model="ir.ui.view">
        <field name="name">sf.crossdock.form</field>
        <field name="model">sf.crossdock</field>
        <field name="arch" type="xml">
            <form string="Cross-Dock Operations Log">
                <header>
                    <button name="action_staged" type="object" string="Staged"
                            class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="arrived,staged,departed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="inbound_ref"/>
                            <field name="outbound_ref"/>
                            <field name="arrival_at"/>
                            <field name="departure_at"/>
                            <field name="dwell_hours"/>
                            <field name="priority"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_crossdock_list" model="ir.ui.view">
        <field name="name">sf.crossdock.list</field>
        <field name="model">sf.crossdock</field>
        <field name="arch" type="xml">
            <list string="Cross-Dock Operations Log" sample="1">
                <field name="inbound_ref"/>
                <field name="outbound_ref"/>
                <field name="arrival_at"/>
                <field name="departure_at"/>
                <field name="dwell_hours"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state in ('submitted','approved')"/>
            </list>
        </field>
    </record>
    <record id="view_sf_crossdock_kanban" model="ir.ui.view">
        <field name="name">sf.crossdock.kanban</field>
        <field name="model">sf.crossdock</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_view" group_by="state">
                <field name="name"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <menuitem id="menu_sf_crossdock_root" name="Cross-Dock Operations Log" sequence="22"
              web_icon="sf_crossdock_operations,static/description/icon.png"/>
    <menuitem id="menu_sf_crossdock_main" name="Records"
              parent="menu_sf_crossdock_root" action="action_sf_crossdock" sequence="10"/>

    <record id="wave_final_sf_crossdock_operations" model="ir.actions.server">
        <field name="name">Refresh Business Data</field>
        <field name="model_id" ref="model_sf_crossdock"/>
        <field name="binding_model_id" ref="model_sf_crossdock"/>
        <field name="state">code</field>
        <field name="code">records.action_refresh_business()</field>
    </record>
</odoo>
