<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_stock_adjustment_approval" model="ir.module.category">
        <field name="name">Stock Adjustment Approval</field>
        <field name="sequence">22</field>
    </record>
    <record id="group_stock_adjustment_approval_user" model="res.groups">
        <field name="name">Stock Adjustment Approval User</field>
        <field name="category_id" ref="module_category_stock_adjustment_approval"/>
        <field name="implied_ids" eval="[(4, ref('stock.group_stock_user'))]"/>

    </record>
    <record id="group_stock_adjustment_approval_manager" model="res.groups">
        <field name="name">Stock Adjustment Approval Manager</field>
        <field name="category_id" ref="module_category_stock_adjustment_approval"/>
        <field name="implied_ids" eval="[(4, ref('group_stock_adjustment_approval_user'))]"/>
    </record>
    <record id="rule_stock_adjustment_approval_sf_adjustment_request" model="ir.rule">
        <field name="name">Adjustment Request: multi-company</field>
        <field name="model_id" ref="model_sf_adjustment_request"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
