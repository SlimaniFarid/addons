<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_dividend" model="ir.actions.act_window">
        <field name="name">Dividend Declaration &amp; Payment Register</field>
        <field name="res_model">sf.dividend</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
    <record id="view_sf_dividend_form" model="ir.ui.view">
        <field name="name">sf.dividend.form</field>
        <field name="model">sf.dividend</field>
        <field name="arch" type="xml">
            <form string="Dividend Declaration &amp; Payment Register">
                <header>
                    <button name="action_approved" type="object" string="Approved"
                            class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="declared,approved,paid"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="shareholder_id"/>
                            <field name="declaration_date"/>
                            <field name="per_share_amount"/>
                            <field name="shares_held"/>
                            <field name="gross_amount"/>
                            <field name="withholding_percent"/>
                            <field name="payment_date"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_dividend_list" model="ir.ui.view">
        <field name="name">sf.dividend.list</field>
        <field name="model">sf.dividend</field>
        <field name="arch" type="xml">
            <list string="Dividend Declaration &amp; Payment Register" sample="1">
                <field name="shareholder_id"/>
                <field name="declaration_date"/>
                <field name="per_share_amount"/>
                <field name="shares_held"/>
                <field name="gross_amount"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state in ('submitted','approved')"/>
            </list>
        </field>
    </record>
    <record id="view_sf_dividend_kanban" model="ir.ui.view">
        <field name="name">sf.dividend.kanban</field>
        <field name="model">sf.dividend</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_view" group_by="state">
                <field name="name"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <menuitem id="menu_sf_dividend_root" name="Dividend Declaration &amp; Payment Register" sequence="7"
              web_icon="sf_dividend_register,static/description/icon.png"/>
    <menuitem id="menu_sf_dividend_main" name="Records"
              parent="menu_sf_dividend_root" action="action_sf_dividend" sequence="10"/>

    <record id="wave_final_sf_dividend_register" model="ir.actions.server">
        <field name="name">Refresh Business Data</field>
        <field name="model_id" ref="model_sf_dividend"/>
        <field name="binding_model_id" ref="model_sf_dividend"/>
        <field name="state">code</field>
        <field name="code">records.action_refresh_business()</field>
    </record>
</odoo>
