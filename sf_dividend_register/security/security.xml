<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_dividend_register" model="ir.module.category">
        <field name="name">Dividend Declaration &amp; Payment Register</field>
        <field name="sequence">56</field>
    </record>
    <record id="group_dividend_register_user" model="res.groups">
        <field name="name">Dividend Declaration &amp; Payment Register User</field>
        <field name="category_id" ref="module_category_dividend_register"/>

    </record>
    <record id="group_dividend_register_manager" model="res.groups">
        <field name="name">Dividend Declaration &amp; Payment Register Manager</field>
        <field name="category_id" ref="module_category_dividend_register"/>
        <field name="implied_ids" eval="[(4, ref('group_dividend_register_user'))]"/>
    </record>
    <record id="rule_dividend_register_sf_dividend" model="ir.rule">
        <field name="name">Dividend Declaration: multi-company</field>
        <field name="model_id" ref="model_sf_dividend"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_dividend_register"/>
    </record>
</odoo>
