<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_time_attendance" model="ir.module.category">
        <field name="name">Time &amp; Attendance</field>
        <field name="sequence">90</field>
    </record>

    <record id="group_time_attendance_user" model="res.groups">
        <field name="name">Time &amp; Attendance User</field>
        <field name="category_id" ref="module_category_time_attendance"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_time_attendance_manager" model="res.groups">
        <field name="name">Time &amp; Attendance Manager</field>
        <field name="category_id" ref="module_category_time_attendance"/>
        <field name="implied_ids" eval="[(4, ref('group_time_attendance_user'))]"/>
    </record>
</odoo>