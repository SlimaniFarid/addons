<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_production_capacity_whatif" model="ir.module.category">
        <field name="name">Capacity What-If Analyzer</field>
        <field name="sequence">470</field>
    </record>
    <record id="group_production_capacity_whatif_user" model="res.groups">
        <field name="name">Capacity What-If Analyzer User</field>
        <field name="category_id" ref="module_category_production_capacity_whatif"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>

    </record>
    <record id="group_production_capacity_whatif_manager" model="res.groups">
        <field name="name">Capacity What-If Analyzer Manager</field>
        <field name="category_id" ref="module_category_production_capacity_whatif"/>
        <field name="implied_ids" eval="[(4, ref('group_production_capacity_whatif_user'))]"/>
    </record>
    <record id="rule_production_capacity_whatif_sf_production_capacity_whatif" model="ir.rule">
        <field name="name">Capacity What-If Analyzer: multi-company</field>
        <field name="model_id" ref="model_sf_production_capacity_whatif"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_production_capacity_whatif"/>
    </record>
</odoo>
