<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_production_capacity_whatif" model="ir.actions.act_window">
        <field name="name">Capacity What-If Analyzer</field>
        <field name="res_model">sf.production_capacity_whatif</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
    <record id="view_sf_production_capacity_whatif_form" model="ir.ui.view">
        <field name="name">sf.production_capacity_whatif.form</field>
        <field name="model">sf.production_capacity_whatif</field>
        <field name="arch" type="xml">
            <form string="Capacity What-If Analyzer">
                <header>
                    <button name="action_submitted" type="object" string="Submitted"
                            class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="scenario_name"/>
                            <field name="scenario_type"/>
                        <field name="impact"/>
                            <field name="recommended"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_production_capacity_whatif_list" model="ir.ui.view">
        <field name="name">sf.production_capacity_whatif.list</field>
        <field name="model">sf.production_capacity_whatif</field>
        <field name="arch" type="xml">
            <list string="Capacity What-If Analyzer" sample="1">
                <field name="scenario_name"/>
                <field name="scenario_type"/>
                <field name="impact"/>
                <field name="recommended"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state in ('submitted','approved')"/>
            </list>
        </field>
    </record>
    <record id="view_sf_production_capacity_whatif_kanban" model="ir.ui.view">
        <field name="name">sf.production_capacity_whatif.kanban</field>
        <field name="model">sf.production_capacity_whatif</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_view" group_by="state">
                <field name="name"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <menuitem id="menu_sf_production_capacity_whatif_root" name="Capacity What-If Analyzer" sequence="1"
              web_icon="sf_production_capacity_whatif,static/description/icon.png"/>
    <menuitem id="menu_sf_production_capacity_whatif_main" name="Records"
              parent="menu_sf_production_capacity_whatif_root" action="action_sf_production_capacity_whatif" sequence="10"/>
</odoo>
