<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Marketplace form -->
    <record id="marketplace_view_form" model="ir.ui.view">
        <field name="name">sf.marketplace.form</field>
        <field name="model">sf.marketplace</field>
        <field name="arch" type="xml">
            <form string="Marketplace">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="sequence"/>
                            <field name="active"/>
                            <field name="company_id"/>
                            <field name="currency_id"/>
                        </group>
                        <group>
                            <field name="vendor_count"/>
                            <field name="listing_count"/>
                            <field name="gmv_total"/>
                            <field name="commission_total"/>
                        </group>
                    </group>
                    <field name="description" placeholder="Describe this marketplace..."/>
                    <notebook>
                        <page string="Vendors">
                            <field name="vendor_ids">
                                <tree string="Vendors" editable="bottom">
                                    <field name="partner_id"/>
                                    <field name="commission_rate"/>
                                    <field name="payout_account_id"/>
                                    <field name="listing_count"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Listings">
                            <field name="listing_ids">
                                <tree string="Listings" editable="bottom">
                                    <field name="product_id"/>
                                    <field name="vendor_id"/>
                                    <field name="list_price"/>
                                    <field name="sold_qty"/>
                                    <field name="sold_amount"/>
                                    <field name="commission_amount"/>
                                    <field name="state"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Payouts">
                            <field name="payout_ids">
                                <tree string="Payouts">
                                    <field name="name"/>
                                    <field name="date"/>
                                    <field name="vendor_id"/>
                                    <field name="amount"/>
                                    <field name="state"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="marketplace_view_tree" model="ir.ui.view">
        <field name="name">sf.marketplace.tree</field>
        <field name="model">sf.marketplace</field>
        <field name="arch" type="xml">
            <tree string="Marketplaces" editable="bottom">
                <field name="name"/>
                <field name="code"/>
                <field name="vendor_count"/>
                <field name="listing_count"/>
                <field name="gmv_total"/>
                <field name="commission_total"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <record id="marketplace_view_search" model="ir.ui.view">
        <field name="name">sf.marketplace.search</field>
        <field name="model">sf.marketplace</field>
        <field name="arch" type="xml">
            <search string="Marketplaces">
                <field name="name"/>
                <field name="code"/>
                <filter string="Active" name="active" domain="[('active','=',True)]"/>
                <filter string="Inactive" name="inactive" domain="[('active','=',False)]"/>
                <group expand="0" string="Group By">
                    <filter string="Company" name="company" context="{'group_by':'company_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Actions -->
    <record id="action_marketplace" model="ir.actions.act_window">
        <field name="name">Marketplaces</field>
        <field name="res_model">sf.marketplace</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="marketplace_view_search"/>
    </record>

    <record id="action_marketplace_vendor" model="ir.actions.act_window">
        <field name="name">Vendors</field>
        <field name="res_model">sf.marketplace.vendor</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record id="action_marketplace_listing" model="ir.actions.act_window">
        <field name="name">Listings</field>
        <field name="res_model">sf.marketplace.listing</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record id="action_marketplace_payout" model="ir.actions.act_window">
        <field name="name">Payouts</field>
        <field name="res_model">sf.marketplace.payout</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- Vendor form -->
    <record id="marketplace_vendor_view_form" model="ir.ui.view">
        <field name="name">sf.marketplace.vendor.form</field>
        <field name="model">sf.marketplace.vendor</field>
        <field name="arch" type="xml">
            <form string="Marketplace Vendor">
                <sheet>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="marketplace_id"/>
                            <field name="commission_rate"/>
                            <field name="payout_account_id"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="sales_total"/>
                            <field name="commission_total"/>
                            <field name="listing_count"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Listings">
                            <field name="listing_ids">
                                <tree string="Listings" editable="bottom">
                                    <field name="product_id"/>
                                    <field name="list_price"/>
                                    <field name="sold_qty"/>
                                    <field name="sold_amount"/>
                                    <field name="commission_amount"/>
                                    <field name="state"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Payouts">
                            <field name="payout_ids">
                                <tree string="Payouts">
                                    <field name="name"/>
                                    <field name="date"/>
                                    <field name="amount"/>
                                    <field name="state"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="marketplace_vendor_view_tree" model="ir.ui.view">
        <field name="name">sf.marketplace.vendor.tree</field>
        <field name="model">sf.marketplace.vendor</field>
        <field name="arch" type="xml">
            <tree string="Vendors">
                <field name="partner_id"/>
                <field name="marketplace_id"/>
                <field name="commission_rate"/>
                <field name="sales_total"/>
                <field name="commission_total"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <!-- Listing form -->
    <record id="marketplace_listing_view_form" model="ir.ui.view">
        <field name="name">sf.marketplace.listing.form</field>
        <field name="model">sf.marketplace.listing</field>
        <field name="arch" type="xml">
            <form string="Marketplace Listing">
                <header>
                    <button name="action_list" string="List" type="object"
                            states="draft,paused"/>
                    <button name="action_pause" string="Pause" type="object"
                            states="listed"/>
                    <button name="action_close" string="Close" type="object"
                            states="draft,listed,paused"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="product_id"/>
                            <field name="vendor_id"/>
                            <field name="marketplace_id"/>
                            <field name="state"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="list_price"/>
                            <field name="sold_qty"/>
                            <field name="sold_amount"/>
                            <field name="commission_amount"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="marketplace_listing_view_tree" model="ir.ui.view">
        <field name="name">sf.marketplace.listing.tree</field>
        <field name="model">sf.marketplace.listing</field>
        <field name="arch" type="xml">
            <tree string="Listings">
                <field name="product_id"/>
                <field name="vendor_id"/>
                <field name="marketplace_id"/>
                <field name="list_price"/>
                <field name="sold_qty"/>
                <field name="sold_amount"/>
                <field name="commission_amount"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <!-- Payout form -->
    <record id="marketplace_payout_view_form" model="ir.ui.view">
        <field name="name">sf.marketplace.payout.form</field>
        <field name="model">sf.marketplace.payout</field>
        <field name="arch" type="xml">
            <form string="Marketplace Payout">
                <header>
                    <button name="action_approve" string="Approve" type="object"
                            states="draft"/>
                    <button name="action_pay" string="Mark as Paid" type="object"
                            states="approved"/>
                    <button name="action_cancel" string="Cancel" type="object"
                            states="draft,approved"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="date"/>
                            <field name="vendor_id"/>
                            <field name="marketplace_id"/>
                        </group>
                        <group>
                            <field name="amount"/>
                            <field name="currency_id"/>
                            <field name="state"/>
                        </group>
                    </group>
                    <field name="note" placeholder="Note..."/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="marketplace_payout_view_tree" model="ir.ui.view">
        <field name="name">sf.marketplace.payout.tree</field>
        <field name="model">sf.marketplace.payout</field>
        <field name="arch" type="xml">
            <tree string="Payouts">
                <field name="name"/>
                <field name="date"/>
                <field name="vendor_id"/>
                <field name="marketplace_id"/>
                <field name="amount"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

</odoo>