<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_marketplace" model="ir.module.category">
        <field name="name">Marketplace Hub</field>
        <field name="sequence">90</field>
    </record>

    <record id="group_marketplace_user" model="res.groups">
        <field name="name">Marketplace User</field>
        <field name="category_id" ref="module_category_marketplace"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_marketplace_manager" model="res.groups">
        <field name="name">Marketplace Manager</field>
        <field name="category_id" ref="module_category_marketplace"/>
        <field name="implied_ids" eval="[(4, ref('group_marketplace_user'))]"/>
    </record>
</odoo>