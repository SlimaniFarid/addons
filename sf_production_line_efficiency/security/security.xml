<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_production_line_efficiency" model="ir.module.category">
        <field name="name">Production Line Efficiency Monitor</field>
        <field name="sequence">480</field>
    </record>
    <record id="group_production_line_efficiency_user" model="res.groups">
        <field name="name">Production Line Efficiency Monitor User</field>
        <field name="category_id" ref="module_category_production_line_efficiency"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>

    </record>
    <record id="group_production_line_efficiency_manager" model="res.groups">
        <field name="name">Production Line Efficiency Monitor Manager</field>
        <field name="category_id" ref="module_category_production_line_efficiency"/>
        <field name="implied_ids" eval="[(4, ref('group_production_line_efficiency_user'))]"/>
    </record>
    <record id="rule_production_line_efficiency_sf_production_line_efficiency" model="ir.rule">
        <field name="name">Production Line Efficiency Monitor: multi-company</field>
        <field name="model_id" ref="model_sf_production_line_efficiency"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_production_line_efficiency"/>
    </record>
</odoo>
