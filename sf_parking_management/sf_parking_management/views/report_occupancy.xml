<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_occupancy">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-set="company" t-value="o.company_id or res_company"/>
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>Occupancy Report</h2>
                        <table class="table table-sm">
                            <tr><th>Site</th><th>Capacity</th><th>Open Tickets</th><th>Occupancy Rate</th></tr>
                            <tr t-foreach="o" t-as="s">
                                <td><span t-field="s.name"/></td>
                                <td><span t-field="s.capacity"/></td>
                                <td><span t-field="s.open_tickets"/></td>
                                <td><span t-field="s.occupancy_rate"/>%</td>
                            </tr>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>