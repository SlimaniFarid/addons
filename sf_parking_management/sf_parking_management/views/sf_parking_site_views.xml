<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sf_parking_site_view_list" model="ir.ui.view">
        <field name="name">sf.parking.site.list</field>
        <field name="model">sf.parking.site</field>
        <field name="arch" type="xml">
            <list string="Parking Sites">
                <field name="name"/>
                <field name="address"/>
                <field name="capacity"/>
                <field name="hourly_rate"/>
                <field name="daily_rate"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="sf_parking_site_view_form" model="ir.ui.view">
        <field name="name">sf.parking.site.form</field>
        <field name="model">sf.parking.site</field>
        <field name="arch" type="xml">
            <form string="Parking Site">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="capacity"/>
                            <field name="hourly_rate"/>
                            <field name="daily_rate"/>
                        </group>
                        <group>
                            <field name="address"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Zones">
                            <field name="zone_ids">
                                <list string="Zones">
                                    <field name="name"/>
                                    <field name="capacity"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="sf_parking_site_view_search" model="ir.ui.view">
        <field name="name">sf.parking.site.search</field>
        <field name="model">sf.parking.site</field>
        <field name="arch" type="xml">
            <search string="Parking Sites">
                <field name="name"/>
                <group>
                    <filter name="group_site_capacity" string="Capacity" context="{'group_by': 'capacity'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_sf_parking_site" model="ir.actions.act_window">
        <field name="name">Parking Sites</field>
        <field name="res_model">sf.parking.site</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="sf_parking_site_view_search"/>
    </record>

    <record id="action_sf_parking_place" model="ir.actions.act_window">
        <field name="name">Places</field>
        <field name="res_model">sf.parking.place</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>