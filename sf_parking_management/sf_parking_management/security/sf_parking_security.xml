<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="module_category_sf_parking" model="ir.module.category">
            <field name="name">Parking</field>
            <field name="description">Parking Lot &amp; Garage Management.</field>
            <field name="sequence">10</field>
        </record>

        <record id="group_sf_parking_user" model="res.groups">
            <field name="name">Parking / User</field>
            <field name="category_id" ref="module_category_sf_parking"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_sf_parking_manager" model="res.groups">
            <field name="name">Parking / Manager</field>
            <field name="category_id" ref="module_category_sf_parking"/>
            <field name="implied_ids" eval="[(4, ref('sf_parking_management.group_sf_parking_user'))]"/>
        </record>

        <record id="rule_sf_parking_site_company" model="ir.rule">
            <field name="name">Parking Site: user sees own company</field>
            <field name="model_id" ref="model_sf_parking_site"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('sf_parking_management.group_sf_parking_user'))]"/>
        </record>
        <record id="rule_sf_parking_site_manager_all" model="ir.rule">
            <field name="name">Parking Site: manager sees all companies</field>
            <field name="model_id" ref="model_sf_parking_site"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('sf_parking_management.group_sf_parking_manager'))]"/>
        </record>

        <record id="rule_sf_parking_zone_company" model="ir.rule">
            <field name="name">Parking Zone: user sees own company</field>
            <field name="model_id" ref="model_sf_parking_zone"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('sf_parking_management.group_sf_parking_user'))]"/>
        </record>
        <record id="rule_sf_parking_zone_manager_all" model="ir.rule">
            <field name="name">Parking Zone: manager sees all companies</field>
            <field name="model_id" ref="model_sf_parking_zone"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('sf_parking_management.group_sf_parking_manager'))]"/>
        </record>

        <record id="rule_sf_parking_place_company" model="ir.rule">
            <field name="name">Parking Place: user sees own company</field>
            <field name="model_id" ref="model_sf_parking_place"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('sf_parking_management.group_sf_parking_user'))]"/>
        </record>
        <record id="rule_sf_parking_place_manager_all" model="ir.rule">
            <field name="name">Parking Place: manager sees all companies</field>
            <field name="model_id" ref="model_sf_parking_place"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('sf_parking_management.group_sf_parking_manager'))]"/>
        </record>

        <record id="rule_sf_parking_ticket_company" model="ir.rule">
            <field name="name">Parking Ticket: user sees own company</field>
            <field name="model_id" ref="model_sf_parking_ticket"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('sf_parking_management.group_sf_parking_user'))]"/>
        </record>
        <record id="rule_sf_parking_ticket_manager_all" model="ir.rule">
            <field name="name">Parking Ticket: manager sees all companies</field>
            <field name="model_id" ref="model_sf_parking_ticket"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('sf_parking_management.group_sf_parking_manager'))]"/>
        </record>

        <record id="rule_sf_parking_subscription_company" model="ir.rule">
            <field name="name">Parking Subscription: user sees own company</field>
            <field name="model_id" ref="model_sf_parking_subscription"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('sf_parking_management.group_sf_parking_user'))]"/>
        </record>
        <record id="rule_sf_parking_subscription_manager_all" model="ir.rule">
            <field name="name">Parking Subscription: manager sees all companies</field>
            <field name="model_id" ref="model_sf_parking_subscription"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('sf_parking_management.group_sf_parking_manager'))]"/>
        </record>
    </data>
</odoo>