<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sf_parking_subscription_view_list" model="ir.ui.view">
        <field name="name">sf.parking.subscription.list</field>
        <field name="model">sf.parking.subscription</field>
        <field name="arch" type="xml">
            <list string="Subscriptions">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="site_id"/>
                <field name="place_id"/>
                <field name="billing_period"/>
                <field name="amount"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="state" widget="badge"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="sf_parking_subscription_view_form" model="ir.ui.view">
        <field name="name">sf.parking.subscription.form</field>
        <field name="model">sf.parking.subscription</field>
        <field name="arch" type="xml">
            <form string="Subscription">
                <header>
                    <button name="action_activate" string="Activate" type="object" class="btn-primary" invisible="[('state', '!=', 'draft')]"/>
                    <button name="action_cancel" string="Cancel" type="object" invisible="[('state', 'in', ('expired', 'cancelled'))]"/>
                    <field name="state" widget="statusbar" readonly="1"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="site_id"/>
                            <field name="place_id"/>
                            <field name="vehicle_plate"/>
                        </group>
                        <group>
                            <field name="billing_period"/>
                            <field name="amount"/>
                            <field name="start_date"/>
                            <field name="end_date"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="sf_parking_subscription_view_search" model="ir.ui.view">
        <field name="name">sf.parking.subscription.search</field>
        <field name="model">sf.parking.subscription</field>
        <field name="arch" type="xml">
            <search string="Subscriptions">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="site_id"/>
                <filter name="subscription_active" string="Active" domain="[('state', '=', 'active')]"/>
                <filter name="subscription_expired" string="Expired" domain="[('state', '=', 'expired')]"/>
                <group>
                    <filter name="group_subscription_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_subscription_site" string="Site" context="{'group_by': 'site_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_sf_parking_subscription" model="ir.actions.act_window">
        <field name="name">Subscriptions</field>
        <field name="res_model">sf.parking.subscription</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="sf_parking_subscription_view_search"/>
    </record>
</odoo>