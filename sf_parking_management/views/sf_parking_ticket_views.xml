<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sf_parking_ticket_view_list" model="ir.ui.view">
        <field name="name">sf.parking.ticket.list</field>
        <field name="model">sf.parking.ticket</field>
        <field name="arch" type="xml">
            <list string="Tickets">
                <field name="name"/>
                <field name="site_id"/>
                <field name="place_id"/>
                <field name="vehicle_plate"/>
                <field name="entry_datetime"/>
                <field name="exit_datetime"/>
                <field name="amount"/>
                <field name="state" widget="badge"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="sf_parking_ticket_view_form" model="ir.ui.view">
        <field name="name">sf.parking.ticket.form</field>
        <field name="model">sf.parking.ticket</field>
        <field name="arch" type="xml">
            <form string="Parking Ticket">
                <header>
                    <button name="action_open" string="Open" type="object" class="btn-primary" invisible="[('state', '!=', 'draft')]"/>
                    <button name="action_close" string="Close" type="object" class="btn-primary" invisible="[('state', '!=', 'open')]"/>
                    <button name="action_paid" string="Mark Paid" type="object" class="btn-primary" invisible="[('state', '!=', 'closed')]"/>
                    <button name="action_cancel" string="Cancel" type="object" invisible="[('state', 'in', ('paid', 'cancelled'))]"/>
                    <field name="state" widget="statusbar" readonly="1"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="site_id"/>
                            <field name="place_id"/>
                            <field name="vehicle_plate"/>
                            <field name="subscription_id"/>
                        </group>
                        <group>
                            <field name="entry_datetime"/>
                            <field name="exit_datetime"/>
                            <field name="duration"/>
                            <field name="amount"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="sf_parking_ticket_view_search" model="ir.ui.view">
        <field name="name">sf.parking.ticket.search</field>
        <field name="model">sf.parking.ticket</field>
        <field name="arch" type="xml">
            <search string="Tickets">
                <field name="name"/>
                <field name="site_id"/>
                <field name="vehicle_plate"/>
                <filter name="ticket_open" string="Open" domain="[('state', '=', 'open')]"/>
                <filter name="ticket_closed" string="Closed" domain="[('state', '=', 'closed')]"/>
                <filter name="ticket_paid" string="Paid" domain="[('state', '=', 'paid')]"/>
                <group>
                    <filter name="group_ticket_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_ticket_site" string="Site" context="{'group_by': 'site_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_sf_parking_ticket" model="ir.actions.act_window">
        <field name="name">Tickets</field>
        <field name="res_model">sf.parking.ticket</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="sf_parking_ticket_view_search"/>
    </record>
</odoo>