<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_revenue">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-set="company" t-value="o.company_id or res_company"/>
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>Revenue Report</h2>
                        <table class="table table-sm">
                            <tr><th>Ticket</th><th>Site</th><th>Entry</th><th>Exit</th><th>Amount</th><th>Status</th></tr>
                            <tr t-foreach="o" t-as="t">
                                <td><span t-field="t.name"/></td>
                                <td><span t-field="t.site_id"/></td>
                                <td><span t-field="t.entry_datetime"/></td>
                                <td><span t-field="t.exit_datetime"/></td>
                                <td><span t-field="t.amount"/></td>
                                <td><span t-field="t.state"/></td>
                            </tr>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>