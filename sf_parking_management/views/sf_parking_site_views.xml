<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sf_parking_site_view_list" model="ir.ui.view">
        <field name="name">sf.parking.site.list</field>
        <field name="model">sf.parking.site</field>
        <field name="arch" type="xml">
            <list decoration-danger="is_overdue" string="Parking Sites">
                <field name="name"/>
                <field name="address"/>
                <field name="capacity"/>
                <field name="hourly_rate"/>
                <field name="daily_rate"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="sf_parking_site_view_form" model="ir.ui.view">
        <field name="name">sf.parking.site.form</field>
        <field name="model">sf.parking.site</field>
        <field name="arch" type="xml">
            <form string="Parking Site">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="capacity"/>
                            <field name="hourly_rate"/>
                            <field name="daily_rate"/>
                        </group>
                        <group>
                            <field name="address"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Zones">
                            <field name="zone_ids">
                                <list string="Zones">
                                    <field name="name"/>
                                    <field name="capacity"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="sf_parking_site_view_search" model="ir.ui.view">
        <field name="name">sf.parking.site.search</field>
        <field name="model">sf.parking.site</field>
        <field name="arch" type="xml">
            <search string="Parking Sites">
                <field name="name"/>
                <group>
                    <filter name="group_site_capacity" string="Capacity" context="{'group_by': 'capacity'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_sf_parking_site" model="ir.actions.act_window">
        <field name="name">Parking Sites</field>
        <field name="res_model">sf.parking.site</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="sf_parking_site_view_search"/>
    </record>

    <record id="action_sf_parking_place" model="ir.actions.act_window">
        <field name="name">Places</field>
        <field name="res_model">sf.parking.place</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_sf_parking_management_boost_kanban" model="ir.ui.view">
        <field name="name">sf_parking_management.boost.kanban</field>
        <field name="model">sf.parking.activity.mixin</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" t-att-color="state">
                <field name="name"/>
                <field name="state"/>
                <field name="user_id"/>
                <field name="end_date"/>
                <field name="is_overdue" invisible="1"/>

                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_card oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title">
                                    <field name="name"/></strong>
                                <div class="o_kanban_record_subtitle">
                                    <field name="user_id" widget="many2one_avatar_user"/>
                                    <field name="end_date"/></div>
                            </div>
                            <div class="oe_kanban_bottom_right">
                                <field name="state" widget="badge"
                                       t-attf-options="{'classes_map': {'draft': 'info', 'done': 'success', 'cancelled': 'danger'}, 'domain': []}"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_sf_parking_management_boost_search" model="ir.ui.view">
        <field name="name">sf_parking_management.boost.search</field>
        <field name="model">sf.parking.activity.mixin</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
<separator/>
                <filter string="My records" name="my_records" domain="[('user_id', '=', uid)]"/>
                <filter string="To Do" name="todo" domain="[('state', 'not in', ('done', 'cancelled', 'closed'))]"/>
                <group expand="0" string="Group By"><filter string="Status" name="gb_state" context="{'group_by': 'state'}"/></group>
            </search>
        </field>
    </record>

    <record id="wave_final_sf_parking_management" model="ir.actions.server">
        <field name="name">Refresh Business Data</field>
        <field name="model_id" ref="model_sf_parking_activity_mixin"/>
        <field name="binding_model_id" ref="model_sf_parking_activity_mixin"/>
        <field name="state">code</field>
        <field name="code">records.action_refresh_business()</field>
    </record>
</odoo>
