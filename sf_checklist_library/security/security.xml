<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_checklist_library" model="ir.module.category">
        <field name="name">Reusable Checklist Library</field>
        <field name="sequence">49</field>
    </record>
    <record id="group_checklist_library_user" model="res.groups">
        <field name="name">Reusable Checklist Library User</field>
        <field name="category_id" ref="module_category_checklist_library"/>

    </record>
    <record id="group_checklist_library_manager" model="res.groups">
        <field name="name">Reusable Checklist Library Manager</field>
        <field name="category_id" ref="module_category_checklist_library"/>
        <field name="implied_ids" eval="[(4, ref('group_checklist_library_user'))]"/>
    </record>
    <record id="rule_checklist_library_sf_checklist_template" model="ir.rule">
        <field name="name">Checklist Template: multi-company</field>
        <field name="model_id" ref="model_sf_checklist_template"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_checklist_library"/>
    </record>
</odoo>
