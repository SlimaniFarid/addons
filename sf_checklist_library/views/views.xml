<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_checklist_template" model="ir.actions.act_window">
        <field name="name">Reusable Checklist Library</field>
        <field name="res_model">sf.checklist.template</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
    <record id="view_sf_checklist_template_form" model="ir.ui.view">
        <field name="name">sf.checklist.template.form</field>
        <field name="model">sf.checklist.template</field>
        <field name="arch" type="xml">
            <form string="Reusable Checklist Library">
                <header>
                    <button name="action_active" type="object" string="Active"
                            class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,active,archived"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="title"/>
                            <field name="purpose"/>
                            <field name="items"/>
                            <field name="owner_id"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_checklist_template_list" model="ir.ui.view">
        <field name="name">sf.checklist.template.list</field>
        <field name="model">sf.checklist.template</field>
        <field name="arch" type="xml">
            <list string="Reusable Checklist Library" sample="1">
                <field name="title"/>
                <field name="purpose"/>
                <field name="items"/>
                <field name="owner_id"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state in ('submitted','approved')"/>
            </list>
        </field>
    </record>
    <record id="view_sf_checklist_template_kanban" model="ir.ui.view">
        <field name="name">sf.checklist.template.kanban</field>
        <field name="model">sf.checklist.template</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_view" group_by="state">
                <field name="name"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <menuitem id="menu_sf_checklist_template_root" name="Reusable Checklist Library" sequence="5"
              web_icon="sf_checklist_library,static/description/icon.png"/>
    <menuitem id="menu_sf_checklist_template_main" name="Records"
              parent="menu_sf_checklist_template_root" action="action_sf_checklist_template" sequence="10"/>
</odoo>
