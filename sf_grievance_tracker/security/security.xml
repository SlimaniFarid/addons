<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_grievance_tracker" model="ir.module.category">
        <field name="name">Grievance Tracker</field>
        <field name="sequence">199</field>
    </record>
    <record id="group_grievance_tracker_user" model="res.groups">
        <field name="name">Grievance Tracker User</field>
        <field name="category_id" ref="module_category_grievance_tracker"/>

    </record>
    <record id="group_grievance_tracker_manager" model="res.groups">
        <field name="name">Grievance Tracker Manager</field>
        <field name="category_id" ref="module_category_grievance_tracker"/>
        <field name="implied_ids" eval="[(4, ref('group_grievance_tracker_user'))]"/>
    </record>
    <record id="rule_grievance_tracker_sf_grievance_tracker" model="ir.rule">
        <field name="name">Grievance Tracker: multi-company</field>
        <field name="model_id" ref="model_sf_grievance_tracker"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
