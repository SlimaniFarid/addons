<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_fuel" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.fuel</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Fuel Management" string="Fuel Management" name="fuel_management">
                    <block>
                        <setting string="Fuel card expiry alerts"
                                 help="Number of days before a card expiry date to raise an alert.">
                            <div class="content-group">
                                <div class="row">
                                    <label string="Expiry alert (days)" for="sf_fuel_alert_days"/>
                                    <div class="text-muted">
                                        Number of days before the expiry
                                        date of a fuel card to raise an alert.
                                    </div>
                                    <field name="sf_fuel_alert_days"/>
                                </div>
                            </div>
                        </setting>
                        <setting string="Abnormal consumption alerts"
                                 help="Alert when a fill consumption exceeds this threshold (L/100km).">
                            <div class="content-group">
                                <div class="row">
                                    <label string="Maximum consumption (L/100km)" for="sf_fuel_max_l100"/>
                                    <div class="text-muted">
                                        Alert when the consumption of a fill
                                        exceeds this threshold (L/100km).
                                    </div>
                                    <field name="sf_fuel_max_l100"/>
                                </div>
                            </div>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>