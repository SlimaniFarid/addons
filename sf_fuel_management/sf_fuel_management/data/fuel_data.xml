<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_fuel_vehicle" model="ir.sequence">
            <field name="name">Fuel Vehicle</field>
            <field name="code">sf.fuel.vehicle</field>
            <field name="prefix">VEH-</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>

        <record id="seq_fuel_card" model="ir.sequence">
            <field name="name">Fuel Card</field>
            <field name="code">sf.fuel.card</field>
            <field name="prefix">CRD-</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>

        <record id="seq_fuel_fill" model="ir.sequence">
            <field name="name">Fuel Fill</field>
            <field name="code">sf.fuel.fill</field>
            <field name="prefix">FUL-</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>

        <record id="seq_fuel_tank" model="ir.sequence">
            <field name="name">Fuel Tank</field>
            <field name="code">sf.fuel.tank</field>
            <field name="prefix">TNK-</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>

        <record id="seq_fuel_tank_receipt" model="ir.sequence">
            <field name="name">Fuel Tank Receipt</field>
            <field name="code">sf.fuel.tank.receipt</field>
            <field name="prefix">RCP-</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>

        <record id="cron_fuel_alerts" model="ir.cron">
            <field name="name">Fuel Management: Fuel Alerts</field>
            <field name="model_id" ref="model_sf_fuel_fill"/>
            <field name="state">code</field>
            <field name="code">model._check_fuel_alerts()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="active">True</field>
        </record>
    </data>
</odoo>