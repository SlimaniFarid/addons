<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_fuel" model="ir.module.category">
        <field name="name">Fuel Management</field>
        <field name="sequence">91</field>
    </record>

    <record id="group_fuel_user" model="res.groups">
        <field name="name">Fuel Management User</field>
        <field name="category_id" ref="module_category_fuel"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_fuel_manager" model="res.groups">
        <field name="name">Fuel Management Manager</field>
        <field name="category_id" ref="module_category_fuel"/>
        <field name="implied_ids" eval="[(4, ref('group_fuel_user'))]"/>
    </record>

    <record id="rule_fuel_vehicle_user_company" model="ir.rule">
        <field name="name">Vehicle: user sees own company</field>
        <field name="model_id" ref="model_sf_fuel_vehicle"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_fuel_user'))]"/>
    </record>

    <record id="rule_fuel_card_user_company" model="ir.rule">
        <field name="name">Card: user sees own company</field>
        <field name="model_id" ref="model_sf_fuel_card"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_fuel_user'))]"/>
    </record>

    <record id="rule_fuel_fill_user_company" model="ir.rule">
        <field name="name">Fill: user sees own company</field>
        <field name="model_id" ref="model_sf_fuel_fill"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_fuel_user'))]"/>
    </record>

    <record id="rule_fuel_tank_user_company" model="ir.rule">
        <field name="name">Tank: user sees own company</field>
        <field name="model_id" ref="model_sf_fuel_tank"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_fuel_user'))]"/>
    </record>

    <record id="rule_fuel_tank_receipt_user_company" model="ir.rule">
        <field name="name">Tank receipt: user sees own company</field>
        <field name="model_id" ref="model_sf_fuel_tank_receipt"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_fuel_user'))]"/>
    </record>

    <record id="rule_fuel_vehicle_manager_all" model="ir.rule">
        <field name="name">Vehicle: manager sees all companies</field>
        <field name="model_id" ref="model_sf_fuel_vehicle"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_fuel_manager'))]"/>
    </record>

    <record id="rule_fuel_card_manager_all" model="ir.rule">
        <field name="name">Card: manager sees all companies</field>
        <field name="model_id" ref="model_sf_fuel_card"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_fuel_manager'))]"/>
    </record>

    <record id="rule_fuel_fill_manager_all" model="ir.rule">
        <field name="name">Fill: manager sees all companies</field>
        <field name="model_id" ref="model_sf_fuel_fill"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_fuel_manager'))]"/>
    </record>

    <record id="rule_fuel_tank_manager_all" model="ir.rule">
        <field name="name">Tank: manager sees all companies</field>
        <field name="model_id" ref="model_sf_fuel_tank"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_fuel_manager'))]"/>
    </record>

    <record id="rule_fuel_tank_receipt_manager_all" model="ir.rule">
        <field name="name">Tank receipt: manager sees all companies</field>
        <field name="model_id" ref="model_sf_fuel_tank_receipt"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_fuel_manager'))]"/>
    </record>
</odoo>