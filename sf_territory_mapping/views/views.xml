<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_territory_mapping" model="ir.actions.act_window">
        <field name="name">Sales Territory Mapping</field>
        <field name="res_model">sf.territory_mapping</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
    <record id="view_sf_territory_mapping_form" model="ir.ui.view">
        <field name="name">sf.territory_mapping.form</field>
        <field name="model">sf.territory_mapping</field>
        <field name="arch" type="xml">
            <form string="Sales Territory Mapping">
                <header>
                    <button name="action_submitted" type="object" string="Submitted"
                            class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="territory_name"/>
                            <field name="rep_id"/>
                            <field name="zip_ranges"/>
                            <field name="account_count"/>
                            <field name="revenue_target"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_territory_mapping_list" model="ir.ui.view">
        <field name="name">sf.territory_mapping.list</field>
        <field name="model">sf.territory_mapping</field>
        <field name="arch" type="xml">
            <list string="Sales Territory Mapping" sample="1">
                <field name="territory_name"/>
                <field name="rep_id"/>
                <field name="zip_ranges"/>
                <field name="account_count"/>
                <field name="revenue_target"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state in ('submitted','approved')"/>
            </list>
        </field>
    </record>
    <record id="view_sf_territory_mapping_kanban" model="ir.ui.view">
        <field name="name">sf.territory_mapping.kanban</field>
        <field name="model">sf.territory_mapping</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_view" group_by="state">
                <field name="name"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <menuitem id="menu_sf_territory_mapping_root" name="Sales Territory Mapping" sequence="22"
              web_icon="sf_territory_mapping,static/description/icon.png"/>
    <menuitem id="menu_sf_territory_mapping_main" name="Records"
              parent="menu_sf_territory_mapping_root" action="action_sf_territory_mapping" sequence="10"/>

    <record id="wave_final_sf_territory_mapping" model="ir.actions.server">
        <field name="name">Refresh Business Data</field>
        <field name="model_id" ref="model_sf_territory_mapping"/>
        <field name="binding_model_id" ref="model_sf_territory_mapping"/>
        <field name="state">code</field>
        <field name="code">records.action_refresh_business()</field>
    </record>
</odoo>
