<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_territory_mapping" model="ir.module.category">
        <field name="name">Sales Territory Mapping</field>
        <field name="sequence">179</field>
    </record>
    <record id="group_territory_mapping_user" model="res.groups">
        <field name="name">Sales Territory Mapping User</field>
        <field name="category_id" ref="module_category_territory_mapping"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>

    </record>
    <record id="group_territory_mapping_manager" model="res.groups">
        <field name="name">Sales Territory Mapping Manager</field>
        <field name="category_id" ref="module_category_territory_mapping"/>
        <field name="implied_ids" eval="[(4, ref('group_territory_mapping_user'))]"/>
    </record>
    <record id="rule_territory_mapping_sf_territory_mapping" model="ir.rule">
        <field name="name">Sales Territory Mapping: multi-company</field>
        <field name="model_id" ref="model_sf_territory_mapping"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
