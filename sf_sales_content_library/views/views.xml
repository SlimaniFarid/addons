<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_sales_content_library" model="ir.actions.act_window">
        <field name="name">Sales Content Library</field>
        <field name="res_model">sf.sales_content_library</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
    <record id="view_sf_sales_content_library_form" model="ir.ui.view">
        <field name="name">sf.sales_content_library.form</field>
        <field name="model">sf.sales_content_library</field>
        <field name="arch" type="xml">
            <form string="Sales Content Library">
                <header>
                    <button name="action_submitted" type="object" string="Submitted"
                            class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="title"/>
                            <field name="content_type"/>
                            <field name="usage_count"/>
                            <field name="last_used"/>
                            <field name="effectiveness"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_sales_content_library_list" model="ir.ui.view">
        <field name="name">sf.sales_content_library.list</field>
        <field name="model">sf.sales_content_library</field>
        <field name="arch" type="xml">
            <list string="Sales Content Library" sample="1">
                <field name="title"/>
                <field name="content_type"/>
                <field name="usage_count"/>
                <field name="last_used"/>
                <field name="effectiveness"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state in ('submitted','approved')"/>
            </list>
        </field>
    </record>
    <record id="view_sf_sales_content_library_kanban" model="ir.ui.view">
        <field name="name">sf.sales_content_library.kanban</field>
        <field name="model">sf.sales_content_library</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_view" group_by="state">
                <field name="name"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <menuitem id="menu_sf_sales_content_library_root" name="Sales Content Library" sequence="3"
              web_icon="sf_sales_content_library,static/description/icon.png"/>
    <menuitem id="menu_sf_sales_content_library_main" name="Records"
              parent="menu_sf_sales_content_library_root" action="action_sf_sales_content_library" sequence="10"/>
</odoo>
