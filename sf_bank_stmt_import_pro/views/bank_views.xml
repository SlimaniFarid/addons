<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ACTIONS -->
    <record id="action_sf_bank_stmt_run" model="ir.actions.act_window">
        <field name="name">Import Runs</field>
        <field name="res_model">sf.bank.stmt.run</field>
        <field name="view_mode">list,form,kanban</field>
        <field name="context">{'search_default_group_by_state': 1}</field>
    </record>
    <record id="action_sf_bank_stmt_template" model="ir.actions.act_window">
        <field name="name">Import Templates</field>
        <field name="res_model">sf.bank.stmt.template</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- RUN FORM -->
    <record id="view_sf_bank_stmt_run_form" model="ir.ui.view">
        <field name="name">sf.bank.stmt.run.form</field>
        <field name="model">sf.bank.stmt.run</field>
        <field name="arch" type="xml">
            <form string="Bank Import Run">
                <header>
                    <button name="action_parse_file" type="object"
                            string="Parse File" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_import_lines" type="object"
                            string="Import Lines" class="btn-primary"
                            invisible="state != 'parsed'"/>
                    <button name="action_reset_draft" type="object"
                            string="Reset to Draft"
                            invisible="state != 'parsed'"/>
                    <button name="action_cancel" type="object"
                            string="Cancel" invisible="state == 'cancelled'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,parsed,imported"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="%(account.action_bank_statement_form)d"
                                type="action" class="oe_stat_button"
                                icon="fa-book" invisible="not statement_id">
                            <field name="statement_id" widget="statinfo"
                                   string="Statement"/>
                        </button>
                        <field name="total_lines" widget="statinfo"
                               string="Parsed" invisible="1"/>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="template_id" readonly="state != 'draft'"/>
                            <field name="file_format" readonly="1"/>
                            <field name="journal_id" readonly="state != 'draft'"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group>
                            <field name="import_file" filename="file_name"
                                   readonly="state != 'draft'"/>
                            <field name="file_name" invisible="1"/>
                            <field name="skip_duplicates"
                                   invisible="state != 'parsed'"/>
                        </group>
                    </group>
                    <group string="Statistics" invisible="state == 'draft'">
                        <group>
                            <field name="total_lines" readonly="1"/>
                            <field name="duplicate_count" readonly="1"/>
                        </group>
                        <group>
                            <field name="error_count" readonly="1"/>
                            <field name="net_amount" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Parsed Lines" name="lines"
                              invisible="state == 'draft'">
                            <field name="line_ids" readonly="1">
                                <list create="0" delete="0" decoration-danger="is_duplicate" decoration-muted="imported">
                                    <field name="date"/>
                                    <field name="amount"/>
                                    <field name="currency_code" optional="show"/>
                                    <field name="reference"/>
                                    <field name="communication"/>
                                    <field name="partner_name" optional="show"/>
                                    <field name="is_duplicate" widget="boolean"/>
                                    <field name="imported" widget="boolean"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- RUN LIST -->
    <record id="view_sf_bank_stmt_run_list" model="ir.ui.view">
        <field name="name">sf.bank.stmt.run.list</field>
        <field name="model">sf.bank.stmt.run</field>
        <field name="arch" type="xml">
            <list string="Bank Import Runs" sample="1">
                <field name="name"/>
                <field name="journal_id"/>
                <field name="file_format"/>
                <field name="file_name" optional="show"/>
                <field name="total_lines"/>
                <field name="duplicate_count"/>
                <field name="statement_id" optional="show"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'imported'"
                       decoration-info="state == 'parsed'"
                       decoration-muted="state in ('draft','cancelled')"/>
            </list>
        </field>
    </record>

    <!-- RUN KANBAN -->
    <record id="view_sf_bank_stmt_run_kanban" model="ir.ui.view">
        <field name="name">sf.bank.stmt.run.kanban</field>
        <field name="model">sf.bank.stmt.run</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_view">
                <field name="name"/>
                <field name="journal_id"/>
                <field name="file_format"/>
                <field name="total_lines"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong><br/>
                                <field name="journal_id"/><br/>
                                <field name="file_format"/> -
                                <field name="total_lines"/> lines
                            </div>
                            <div class="oe_kanban_footer">
                                <field name="state" widget="badge"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- TEMPLATE FORM -->
    <record id="view_sf_bank_stmt_template_form" model="ir.ui.view">
        <field name="name">sf.bank.stmt.template.form</field>
        <field name="model">sf.bank.stmt.template</field>
        <field name="arch" type="xml">
            <form string="Import Template">
                <sheet>
                    <group>
                        <group string="Identification">
                            <field name="name"/>
                            <field name="bank_id"/>
                            <field name="file_format"/>
                            <field name="company_id"
                                   groups="base.group_multi_company"/>
                        </group>
                        <group string="CSV Options"
                               invisible="file_format != 'csv'">
                            <field name="csv_delimiter"/>
                            <field name="csv_encoding"/>
                            <field name="csv_header_row"/>
                            <field name="date_format"/>
                            <field name="decimal_separator"/>
                            <field name="thousands_separator"/>
                        </group>
                    </group>
                    <group string="CSV Column Mapping (0-based)"
                           invisible="file_format != 'csv'">
                        <group>
                            <field name="date_col"/>
                            <field name="value_date_col"/>
                            <field name="amount_col"/>
                            <field name="debit_credit_col"/>
                            <field name="debit_value"/>
                        </group>
                        <group>
                            <field name="reference_col"/>
                            <field name="partner_col"/>
                            <field name="communication_col"/>
                            <field name="currency_col"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- TEMPLATE LIST -->
    <record id="view_sf_bank_stmt_template_list" model="ir.ui.view">
        <field name="name">sf.bank.stmt.template.list</field>
        <field name="model">sf.bank.stmt.template</field>
        <field name="arch" type="xml">
            <list string="Import Templates" sample="1">
                <field name="name"/>
                <field name="bank_id"/>
                <field name="file_format"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <!-- MENUS -->
    <menuitem id="menu_sf_bank_import_root" name="Bank Import Pro"
              sequence="45" parent="account.menu_finance"
              web_icon="sf_bank_stmt_import_pro,static/description/icon.png"/>
    <menuitem id="menu_sf_bank_import_runs" name="Import Runs"
              parent="menu_sf_bank_import_root"
              action="action_sf_bank_stmt_run" sequence="10"/>
    <menuitem id="menu_sf_bank_import_templates" name="Templates"
              parent="menu_sf_bank_import_root"
              action="action_sf_bank_stmt_template" sequence="20"/>

    <record id="wave_final_sf_bank_stmt_import_pro" model="ir.actions.server">
        <field name="name">Refresh Business Data</field>
        <field name="model_id" ref="model_sf_bank_stmt_run"/>
        <field name="binding_model_id" ref="model_sf_bank_stmt_run"/>
        <field name="state">code</field>
        <field name="code">records.action_refresh_business()</field>
    </record>
</odoo>
