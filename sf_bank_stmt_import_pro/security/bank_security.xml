<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_sf_bank_import" model="ir.module.category">
        <field name="name">Bank Statement Import</field>
        <field name="sequence">95</field>
    </record>

    <record id="group_sf_bank_import_user" model="res.groups">
        <field name="name">Bank Import User</field>
        <field name="category_id" ref="module_category_sf_bank_import"/>
        <field name="implied_ids" eval="[(4, ref('account.group_account_invoice'))]"/>
    </record>

    <record id="group_sf_bank_import_manager" model="res.groups">
        <field name="name">Bank Import Manager</field>
        <field name="category_id" ref="module_category_sf_bank_import"/>
        <field name="implied_ids" eval="[(4, ref('group_sf_bank_import_user'))]"/>
    </record>

    <record id="rule_sf_bank_stmt_run_company" model="ir.rule">
        <field name="name">Bank Import Run: multi-company</field>
        <field name="model_id" ref="model_sf_bank_stmt_run"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_sf_bank_import"/>
    </record>
</odoo>
