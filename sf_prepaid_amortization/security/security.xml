<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_prepaid_amortization" model="ir.module.category">
        <field name="name">Prepaid Expense Amortization</field>
        <field name="sequence">54</field>
    </record>
    <record id="group_prepaid_amortization_user" model="res.groups">
        <field name="name">Prepaid Expense Amortization User</field>
        <field name="category_id" ref="module_category_prepaid_amortization"/>

    </record>
    <record id="group_prepaid_amortization_manager" model="res.groups">
        <field name="name">Prepaid Expense Amortization Manager</field>
        <field name="category_id" ref="module_category_prepaid_amortization"/>
        <field name="implied_ids" eval="[(4, ref('group_prepaid_amortization_user'))]"/>
    </record>
    <record id="rule_prepaid_amortization_sf_prepaid" model="ir.rule">
        <field name="name">Prepaid Expense: multi-company</field>
        <field name="model_id" ref="model_sf_prepaid"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_prepaid_amortization"/>
    </record>
</odoo>
