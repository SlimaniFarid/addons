<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_replenishment_review" model="ir.module.category">
        <field name="name">Replenishment Review Queue</field>
        <field name="sequence">28</field>
    </record>
    <record id="group_replenishment_review_user" model="res.groups">
        <field name="name">Replenishment Review Queue User</field>
        <field name="category_id" ref="module_category_replenishment_review"/>
        <field name="implied_ids" eval="[(4, ref('stock.group_stock_user'))]"/>

    </record>
    <record id="group_replenishment_review_manager" model="res.groups">
        <field name="name">Replenishment Review Queue Manager</field>
        <field name="category_id" ref="module_category_replenishment_review"/>
        <field name="implied_ids" eval="[(4, ref('group_replenishment_review_user'))]"/>
    </record>
    <record id="rule_replenishment_review_sf_replenishment_review" model="ir.rule">
        <field name="name">Replenishment Review: multi-company</field>
        <field name="model_id" ref="model_sf_replenishment_review"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
