<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_replenishment_review" model="ir.actions.act_window">
        <field name="name">Replenishment Review Queue</field>
        <field name="res_model">sf.replenishment.review</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
    <record id="view_sf_replenishment_review_form" model="ir.ui.view">
        <field name="name">sf.replenishment.review.form</field>
        <field name="model">sf.replenishment.review</field>
        <field name="arch" type="xml">
            <form string="Replenishment Review Queue">
                <header>
                    <button name="action_approved" type="object" string="Approved"
                            class="btn-primary"/>
                    <button name="action_ordered" type="object" string="Ordered"
                            class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="proposed,approved,ordered,rejected"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="product_id"/>
                            <field name="suggested_qty"/>
                            <field name="adjusted_qty"/>
                            <field name="demand_note"/>
                            <field name="reviewer_id"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_replenishment_review_list" model="ir.ui.view">
        <field name="name">sf.replenishment.review.list</field>
        <field name="model">sf.replenishment.review</field>
        <field name="arch" type="xml">
            <list string="Replenishment Review Queue" sample="1">
                <field name="product_id"/>
                <field name="suggested_qty"/>
                <field name="adjusted_qty"/>
                <field name="demand_note"/>
                <field name="reviewer_id"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state in ('submitted','approved')"/>
            </list>
        </field>
    </record>
    <record id="view_sf_replenishment_review_kanban" model="ir.ui.view">
        <field name="name">sf.replenishment.review.kanban</field>
        <field name="model">sf.replenishment.review</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_view" group_by="state">
                <field name="name"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <menuitem id="menu_sf_replenishment_review_root" name="Replenishment Review Queue" sequence="21"
              web_icon="sf_replenishment_review,static/description/icon.png"/>
    <menuitem id="menu_sf_replenishment_review_main" name="Records"
              parent="menu_sf_replenishment_review_root" action="action_sf_replenishment_review" sequence="10"/>

    <record id="wave_final_sf_replenishment_review" model="ir.actions.server">
        <field name="name">Refresh Business Data</field>
        <field name="model_id" ref="model_sf_replenishment_review"/>
        <field name="binding_model_id" ref="model_sf_replenishment_review"/>
        <field name="state">code</field>
        <field name="code">records.action_refresh_business()</field>
    </record>
</odoo>
