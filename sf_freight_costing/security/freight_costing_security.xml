        <field name="name">Freight Costing</field>
        <field name="sequence">93</field>
    </record>

    <record id="group_freight_costing_user" model="res.groups">
        <field name="name">Freight Costing User</field>
        <field name="category_id" ref="module_category_freight_costing"/>
