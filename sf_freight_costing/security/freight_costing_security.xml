    </record>

    <record id="group_freight_costing_manager" model="res.groups">
        <field name="name">Freight Costing Manager</field>
        <field name="category_id" ref="module_category_freight_costing"/>
        <field name="implied_ids" eval="[(4, ref('group_freight_costing_user'))]"/>
    </record>
</odoo>