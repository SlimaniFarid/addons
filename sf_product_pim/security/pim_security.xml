<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_pim" model="ir.module.category">
        <field name="name">PIM</field>
        <field name="sequence">94</field>
    </record>

    <record id="group_pim_user" model="res.groups">
        <field name="name">PIM User</field>
        <field name="category_id" ref="module_category_pim"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_pim_manager" model="res.groups">
        <field name="name">PIM Manager</field>
        <field name="category_id" ref="module_category_pim"/>
        <field name="implied_ids" eval="[(4, ref('group_pim_user'))]"/>
    </record>

    <record id="rule_pim_category_user_company" model="ir.rule">
        <field name="name">PIM Family: user sees own company</field>
        <field name="model_id" ref="model_sf_pim_category"/>
        <field name="global" eval="True"/>
        <field name="domain_force">['|', ('company_id', 'in', company_ids), ('company_id', '=', False)]</field>
        <field name="groups" eval="[(4, ref('group_pim_user'))]"/>
    </record>

    <record id="rule_pim_attribute_user_company" model="ir.rule">
        <field name="name">PIM Attribute: user sees own company</field>
        <field name="model_id" ref="model_sf_pim_attribute"/>
        <field name="global" eval="True"/>
        <field name="domain_force">['|', ('company_id', 'in', company_ids), ('company_id', '=', False)]</field>
        <field name="groups" eval="[(4, ref('group_pim_user'))]"/>
    </record>

    <record id="rule_pim_channel_user_company" model="ir.rule">
        <field name="name">PIM Channel: user sees own company</field>
        <field name="model_id" ref="model_sf_pim_channel"/>
        <field name="global" eval="True"/>
        <field name="domain_force">['|', ('company_id', 'in', company_ids), ('company_id', '=', False)]</field>
        <field name="groups" eval="[(4, ref('group_pim_user'))]"/>
    </record>

    <record id="rule_pim_publication_user_company" model="ir.rule">
        <field name="name">PIM Publication: user sees own company</field>
        <field name="model_id" ref="model_sf_pim_publication"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_pim_user'))]"/>
    </record>

    <record id="rule_pim_review_user_company" model="ir.rule">
        <field name="name">PIM Review: user sees own company</field>
        <field name="model_id" ref="model_sf_pim_review"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_pim_user'))]"/>
    </record>

    <record id="rule_pim_product_attr_user_company" model="ir.rule">
        <field name="name">PIM Product Attribute: user sees own company</field>
        <field name="model_id" ref="model_sf_pim_product_attribute"/>
        <field name="global" eval="True"/>
        <field name="domain_force">['|', ('company_id', 'in', company_ids), ('company_id', '=', False)]</field>
        <field name="groups" eval="[(4, ref('group_pim_user'))]"/>
    </record>

    <record id="rule_pim_category_manager_all" model="ir.rule">
        <field name="name">PIM Family: manager sees all companies</field>
        <field name="model_id" ref="model_sf_pim_category"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_pim_manager'))]"/>
    </record>

    <record id="rule_pim_attribute_manager_all" model="ir.rule">
        <field name="name">PIM Attribute: manager sees all companies</field>
        <field name="model_id" ref="model_sf_pim_attribute"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_pim_manager'))]"/>
    </record>

    <record id="rule_pim_channel_manager_all" model="ir.rule">
        <field name="name">PIM Channel: manager sees all companies</field>
        <field name="model_id" ref="model_sf_pim_channel"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_pim_manager'))]"/>
    </record>

    <record id="rule_pim_publication_manager_all" model="ir.rule">
        <field name="name">PIM Publication: manager sees all companies</field>
        <field name="model_id" ref="model_sf_pim_publication"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_pim_manager'))]"/>
    </record>

    <record id="rule_pim_review_manager_all" model="ir.rule">
        <field name="name">PIM Review: manager sees all companies</field>
        <field name="model_id" ref="model_sf_pim_review"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_pim_manager'))]"/>
    </record>

    <record id="rule_pim_product_attr_manager_all" model="ir.rule">
        <field name="name">PIM Product Attribute: manager sees all companies</field>
        <field name="model_id" ref="model_sf_pim_product_attribute"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_pim_manager'))]"/>
    </record>
    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_pim"/>
    </record>
</odoo>