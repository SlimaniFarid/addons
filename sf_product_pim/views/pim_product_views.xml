<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============ PRODUCT FORM: PIM TAB ============ -->
    <record id="view_pim_product_template_form" model="ir.ui.view">
        <field name="name">product.template.form.pim</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//form/sheet/notebook" position="inside">
                <page string="PIM" name="pim">
                    <group>
                        <group>
                            <field name="pim_state"/>
                            <field name="pim_category_id"/>
                            <field name="pim_score" widget="progressbar"/>
                            <field name="pim_channel_ids" widget="many2many_tags"/>
                        </group>
                        <group>
                            <button name="action_submit" type="object"
                                    string="Submit" icon="fa-arrow-right"
                                    class="btn-primary"
                                    invisible="pim_state != 'draft'"/>
                            <button name="action_approve" type="object"
                                    string="Approve" icon="fa-check"
                                    class="btn-success"
                                    groups="sf_product_pim.group_pim_manager"
                                    invisible="pim_state != 'in_review'"/>
                            <button name="action_reject" type="object"
                                    string="Reject" icon="fa-times"
                                    class="btn-danger"
                                    groups="sf_product_pim.group_pim_manager"
                                    invisible="pim_state != 'in_review'"/>
                            <button name="action_publish" type="object"
                                    string="Publish to Channel" icon="fa-bullhorn"
                                    class="btn-primary"
                                    groups="sf_product_pim.group_pim_manager"
                                    invisible="pim_state not in ('approved', 'published')"/>
                            <button name="action_withdraw" type="object"
                                    string="Withdraw from Channels" icon="fa-undo"
                                    groups="sf_product_pim.group_pim_manager"
                                    invisible="pim_state != 'published'"/>
                            <button name="action_archive" type="object"
                                    string="Archive" icon="fa-archive"
                                    groups="sf_product_pim.group_pim_manager"
                                    invisible="pim_state in ('draft', 'archived')"/>
                            <button name="action_restore" type="object"
                                    string="Restore" icon="fa-undo"
                                    class="btn-secondary"
                                    invisible="pim_state != 'archived'"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Attributes">
                            <field name="pim_attributes">
                                <tree editable="bottom">
                                    <field name="attribute_id"/>
                                    <field name="value"/>
                                    <field name="value_html" optional="show"/>
                                    <field name="image" widget="image" optional="hide"/>
                                    <field name="document_ids" widget="many2many_tags"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Publications">
                            <field name="pim_publication_ids" readonly="1">
                                <tree string="Publications">
                                    <field name="channel_id"/>
                                    <field name="state"/>
                                    <field name="published_on"/>
                                    <field name="withdrawn_on"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Review History">
                            <field name="pim_review_ids" readonly="1">
                                <tree string="Review History">
                                    <field name="action"/>
                                    <field name="date"/>
                                    <field name="user_id"/>
                                    <field name="notes"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </page>
            </xpath>
        </field>
    </record>

    <!-- ============ PRODUCT SEARCH ============ -->
    <record id="view_pim_product_search" model="ir.ui.view">
        <field name="name">product.template.pim.search</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_search_view"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='filter_to_sell']" position="after">
                <separator/>
                <filter string="PIM Draft" name="pim_draft"
                        domain="[('pim_state', '=', 'draft')]"/>
                <filter string="PIM In Review" name="pim_in_review"
                        domain="[('pim_state', '=', 'in_review')]"/>
                <filter string="PIM Approved" name="pim_approved"
                        domain="[('pim_state', '=', 'approved')]"/>
                <filter string="PIM Published" name="pim_published"
                        domain="[('pim_state', '=', 'published')]"/>
                <separator/>
                <filter string="Complete (100%)" name="pim_complete"
                        domain="[('pim_score', '>=', 100)]"/>
            </xpath>
            <xpath expr="//group" position="inside">
                <filter string="PIM Status" name="pim_state_group"
                        context="{'group_by': 'pim_state'}"/>
                <filter string="PIM Family" name="pim_category_group"
                        context="{'group_by': 'pim_category_id'}"/>
            </xpath>
        </field>
    </record>

    <!-- ============ PRODUCT LIST ============ -->
    <record id="view_pim_product_tree" model="ir.ui.view">
        <field name="name">product.template.pim.tree</field>
        <field name="model">product.template</field>
        <field name="arch" type="xml">
            <tree string="PIM Products" create="0">
                <field name="name"/>
                <field name="pim_state"/>
                <field name="pim_category_id"/>
                <field name="pim_score" widget="progressbar"/>
                <field name="pim_channel_ids" widget="many2many_tags"/>
            </tree>
        </field>
    </record>

    <record id="action_pim_product" model="ir.actions.act_window">
        <field name="name">PIM Products</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="view_pim_product_tree"/>
        <field name="search_view_id" ref="view_pim_product_search"/>
        <field name="domain">[('pim_state', '!=', 'archived')]</field>
    </record>

    <!-- ============ QUALITY DASHBOARD ============ -->
    <record id="view_pim_quality_graph" model="ir.ui.view">
        <field name="name">product.template.pim.quality.graph</field>
        <field name="model">product.template</field>
        <field name="arch" type="xml">
            <graph string="PIM Quality">
                <field name="pim_state"/>
                <field name="pim_score" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_pim_quality_pivot" model="ir.ui.view">
        <field name="name">product.template.pim.quality.pivot</field>
        <field name="model">product.template</field>
        <field name="arch" type="xml">
            <pivot string="PIM Quality">
                <field name="pim_category_id" type="row"/>
                <field name="pim_state" type="col"/>
                <field name="pim_score" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="action_pim_quality" model="ir.actions.act_window">
        <field name="name">PIM Quality Dashboard</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">graph,pivot</field>
        <field name="view_ids" eval="[(5, 0), (0, 0, {'view_mode': 'graph', 'view_id': ref('view_pim_quality_graph')}), (0, 0, {'view_mode': 'pivot', 'view_id': ref('view_pim_quality_pivot')})]"/>
        <field name="domain">[('pim_state', 'not in', ('draft', 'archived'))]</field>
    </record>

</odoo>