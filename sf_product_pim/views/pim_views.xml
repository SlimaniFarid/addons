<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============ FAMILIES ============ -->
    <record id="view_pim_category_tree" model="ir.ui.view">
        <field name="name">sf.pim.category.tree</field>
        <field name="model">sf.pim.category</field>
        <field name="arch" type="xml">
            <tree string="PIM Families">
                <field name="name"/>
                <field name="code"/>
                <field name="parent_id"/>
                <field name="attribute_ids" widget="many2many_tags"/>
            </tree>
        </field>
    </record>

    <record id="view_pim_category_form" model="ir.ui.view">
        <field name="name">sf.pim.category.form</field>
        <field name="model">sf.pim.category</field>
        <field name="arch" type="xml">
            <form string="PIM Family">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="toggle_active" type="object"
                                class="oe_stat_button" icon="fa-archive">
                            <field name="active" widget="boolean_toggle"/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                        </group>
                        <group>
                            <field name="parent_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Attributes">
                            <field name="attribute_ids">
                                <tree editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="field_type"/>
                                    <field name="required"/>
                                    <field name="translated"/>
                                    <field name="unit"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_pim_category" model="ir.actions.act_window">
        <field name="name">PIM Families</field>
        <field name="res_model">sf.pim.category</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- ============ ATTRIBUTES ============ -->
    <record id="view_pim_attribute_tree" model="ir.ui.view">
        <field name="name">sf.pim.attribute.tree</field>
        <field name="model">sf.pim.attribute</field>
        <field name="arch" type="xml">
            <tree string="PIM Attributes" editable="bottom">
                <field name="name"/>
                <field name="category_id"/>
                <field name="field_type"/>
                <field name="required"/>
                <field name="translated"/>
                <field name="unit"/>
            </tree>
        </field>
    </record>

    <record id="view_pim_attribute_form" model="ir.ui.view">
        <field name="name">sf.pim.attribute.form</field>
        <field name="model">sf.pim.attribute</field>
        <field name="arch" type="xml">
            <form string="PIM Attribute">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="category_id"/>
                        </group>
                        <group>
                            <field name="field_type"/>
                            <field name="sequence"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="required"/>
                            <field name="translated"/>
                        </group>
                        <group>
                            <field name="unit"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_pim_attribute" model="ir.actions.act_window">
        <field name="name">PIM Attributes</field>
        <field name="res_model">sf.pim.attribute</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- ============ CHANNELS ============ -->
    <record id="view_pim_channel_tree" model="ir.ui.view">
        <field name="name">sf.pim.channel.tree</field>
        <field name="model">sf.pim.channel</field>
        <field name="arch" type="xml">
            <tree string="Publication Channels">
                <field name="name"/>
                <field name="code"/>
            </tree>
        </field>
    </record>

    <record id="view_pim_channel_form" model="ir.ui.view">
        <field name="name">sf.pim.channel.form</field>
        <field name="model">sf.pim.channel</field>
        <field name="arch" type="xml">
            <form string="Publication Channel">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_pim_channel" model="ir.actions.act_window">
        <field name="name">Publication Channels</field>
        <field name="res_model">sf.pim.channel</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- ============ PUBLICATIONS ============ -->
    <record id="view_pim_publication_tree" model="ir.ui.view">
        <field name="name">sf.pim.publication.tree</field>
        <field name="model">sf.pim.publication</field>
        <field name="arch" type="xml">
            <tree string="Publications">
                <field name="product_tmpl_id"/>
                <field name="channel_id"/>
                <field name="state"/>
                <field name="published_on"/>
                <field name="withdrawn_on"/>
            </tree>
        </field>
    </record>

    <record id="view_pim_publication_form" model="ir.ui.view">
        <field name="name">sf.pim.publication.form</field>
        <field name="model">sf.pim.publication</field>
        <field name="arch" type="xml">
            <form string="Publication">
                <sheet>
                    <group>
                        <group>
                            <field name="product_tmpl_id"/>
                            <field name="channel_id"/>
                        </group>
                        <group>
                            <field name="state"/>
                            <field name="published_on"/>
                            <field name="withdrawn_on"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_pim_publication" model="ir.actions.act_window">
        <field name="name">Publications</field>
        <field name="res_model">sf.pim.publication</field>
        <field name="view_mode">tree,form</field>
    </record>

</odoo>