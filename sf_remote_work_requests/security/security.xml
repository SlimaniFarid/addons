<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_remote_work_requests" model="ir.module.category">
        <field name="name">Remote Work Request Workflow</field>
        <field name="sequence">9</field>
    </record>
    <record id="group_remote_work_requests_user" model="res.groups">
        <field name="name">Remote Work Request Workflow User</field>
        <field name="category_id" ref="module_category_remote_work_requests"/>

    </record>
    <record id="group_remote_work_requests_manager" model="res.groups">
        <field name="name">Remote Work Request Workflow Manager</field>
        <field name="category_id" ref="module_category_remote_work_requests"/>
        <field name="implied_ids" eval="[(4, ref('group_remote_work_requests_user'))]"/>
    </record>
    <record id="rule_remote_work_requests_sf_remote_work" model="ir.rule">
        <field name="name">Remote Work Request: multi-company</field>
        <field name="model_id" ref="model_sf_remote_work"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_remote_work_requests"/>
    </record>
</odoo>
