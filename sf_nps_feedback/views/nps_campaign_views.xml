<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_nps_campaign_list" model="ir.ui.view">
        <field name="name">sf.nps.feedback.nps.campaign.list</field>
        <field name="model">sf.nps.feedback.nps.campaign</field>
        <field name="arch" type="xml">
            <list string="Nps.Campaign">
                <field name="name"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="target_model"/>
                <field name="state"/>
                <field name="state" widget="badge"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_nps_campaign_form" model="ir.ui.view">
        <field name="name">sf.nps.feedback.nps.campaign.form</field>
        <field name="model">sf.nps.feedback.nps.campaign</field>
        <field name="arch" type="xml">
            <form string="Nps.Campaign">
                <header>
                <field name="state" widget="badge"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" placeholder="Name"/></h1></div>
                    <group><group>
                            <field name="name"/>
                            <field name="start_date"/>
                            <field name="end_date"/>
                            <field name="target_model"/>
                            <field name="state"/>
                    </group>
                    <group>
                        <field name="currency_id" invisible="1"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_nps_campaign" model="ir.actions.act_window">
        <field name="name">Nps.Campaign</field>
        <field name="res_model">sf.nps.feedback.nps.campaign</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
