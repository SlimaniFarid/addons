<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_sf_nps_feedback" model="ir.module.category">
        <field name="name">NPS &amp; Customer Feedback</field>
        <field name="description">NPS &amp; Customer Feedback</field>
        <field name="sequence">10</field>
    </record>
    <record id="group_nps_feedback_user" model="res.groups">
        <field name="name">NPS &amp; Customer Feedback / User</field>
        <field name="category_id" ref="module_category_sf_nps_feedback"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_nps_feedback_manager" model="res.groups">
        <field name="name">NPS &amp; Customer Feedback / Manager</field>
        <field name="category_id" ref="module_category_sf_nps_feedback"/>
        <field name="implied_ids" eval="[(4, ref('sf_nps_feedback.group_nps_feedback_user'))]"/>
    </record>
    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_sf_nps_feedback"/>
    </record>
</odoo>
