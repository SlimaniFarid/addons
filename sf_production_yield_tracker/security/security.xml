<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_production_yield_tracker" model="ir.module.category">
        <field name="name">Production Yield Tracker</field>
        <field name="sequence">266</field>
    </record>
    <record id="group_production_yield_tracker_user" model="res.groups">
        <field name="name">Production Yield Tracker User</field>
        <field name="category_id" ref="module_category_production_yield_tracker"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>

    </record>
    <record id="group_production_yield_tracker_manager" model="res.groups">
        <field name="name">Production Yield Tracker Manager</field>
        <field name="category_id" ref="module_category_production_yield_tracker"/>
        <field name="implied_ids" eval="[(4, ref('group_production_yield_tracker_user'))]"/>
    </record>
    <record id="rule_production_yield_tracker_sf_production_yield_tracker" model="ir.rule">
        <field name="name">Production Yield Tracker: multi-company</field>
        <field name="model_id" ref="model_sf_production_yield_tracker"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_production_yield_tracker"/>
    </record>
</odoo>
