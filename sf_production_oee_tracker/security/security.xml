<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_production_oee_tracker" model="ir.module.category">
        <field name="name">OEE Tracker</field>
        <field name="sequence">676</field>
    </record>
    <record id="group_production_oee_tracker_user" model="res.groups">
        <field name="name">OEE Tracker User</field>
        <field name="category_id" ref="module_category_production_oee_tracker"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>

    </record>
    <record id="group_production_oee_tracker_manager" model="res.groups">
        <field name="name">OEE Tracker Manager</field>
        <field name="category_id" ref="module_category_production_oee_tracker"/>
        <field name="implied_ids" eval="[(4, ref('group_production_oee_tracker_user'))]"/>
    </record>
    <record id="rule_production_oee_tracker_sf_production_oee_tracker" model="ir.rule">
        <field name="name">OEE Tracker: multi-company</field>
        <field name="model_id" ref="model_sf_production_oee_tracker"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_production_oee_tracker"/>
    </record>
</odoo>
