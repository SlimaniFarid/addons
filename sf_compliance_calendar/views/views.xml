<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_compliance_calendar" model="ir.actions.act_window">
        <field name="name">Compliance Calendar</field>
        <field name="res_model">sf.compliance_calendar</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
    <record id="view_sf_compliance_calendar_form" model="ir.ui.view">
        <field name="name">sf.compliance_calendar.form</field>
        <field name="model">sf.compliance_calendar</field>
        <field name="arch" type="xml">
            <form string="Compliance Calendar">
                <header>
                    <button name="action_submitted" type="object" string="Submitted"
                            class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="obligation"/>
                            <field name="regulation"/>
                            <field name="due_date"/>
                            <field name="frequency"/>
                            <field name="owner_id"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_compliance_calendar_list" model="ir.ui.view">
        <field name="name">sf.compliance_calendar.list</field>
        <field name="model">sf.compliance_calendar</field>
        <field name="arch" type="xml">
            <list string="Compliance Calendar" sample="1">
                <field name="obligation"/>
                <field name="regulation"/>
                <field name="due_date"/>
                <field name="frequency"/>
                <field name="owner_id"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state in ('submitted','approved')"/>
            </list>
        </field>
    </record>
    <record id="view_sf_compliance_calendar_kanban" model="ir.ui.view">
        <field name="name">sf.compliance_calendar.kanban</field>
        <field name="model">sf.compliance_calendar</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_view" group_by="state">
                <field name="name"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <menuitem id="menu_sf_compliance_calendar_root" name="Compliance Calendar" sequence="2"
              web_icon="sf_compliance_calendar,static/description/icon.png"/>
    <menuitem id="menu_sf_compliance_calendar_main" name="Records"
              parent="menu_sf_compliance_calendar_root" action="action_sf_compliance_calendar" sequence="10"/>
</odoo>
