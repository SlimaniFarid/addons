<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_compliance_calendar" model="ir.module.category">
        <field name="name">Compliance Calendar</field>
        <field name="sequence">169</field>
    </record>
    <record id="group_compliance_calendar_user" model="res.groups">
        <field name="name">Compliance Calendar User</field>
        <field name="category_id" ref="module_category_compliance_calendar"/>

    </record>
    <record id="group_compliance_calendar_manager" model="res.groups">
        <field name="name">Compliance Calendar Manager</field>
        <field name="category_id" ref="module_category_compliance_calendar"/>
        <field name="implied_ids" eval="[(4, ref('group_compliance_calendar_user'))]"/>
    </record>
    <record id="rule_compliance_calendar_sf_compliance_calendar" model="ir.rule">
        <field name="name">Compliance Calendar: multi-company</field>
        <field name="model_id" ref="model_sf_compliance_calendar"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_compliance_calendar"/>
    </record>
</odoo>
