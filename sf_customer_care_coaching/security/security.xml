<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_customer_care_coaching" model="ir.module.category">
        <field name="name">Customer Care Coaching Log</field>
        <field name="sequence">256</field>
    </record>
    <record id="group_customer_care_coaching_user" model="res.groups">
        <field name="name">Customer Care Coaching Log User</field>
        <field name="category_id" ref="module_category_customer_care_coaching"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>

    </record>
    <record id="group_customer_care_coaching_manager" model="res.groups">
        <field name="name">Customer Care Coaching Log Manager</field>
        <field name="category_id" ref="module_category_customer_care_coaching"/>
        <field name="implied_ids" eval="[(4, ref('group_customer_care_coaching_user'))]"/>
    </record>
    <record id="rule_customer_care_coaching_sf_customer_care_coaching" model="ir.rule">
        <field name="name">Customer Care Coaching Log: multi-company</field>
        <field name="model_id" ref="model_sf_customer_care_coaching"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_customer_care_coaching"/>
    </record>
</odoo>
