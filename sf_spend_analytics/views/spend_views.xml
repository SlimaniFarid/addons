<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_spend_analysis" model="ir.actions.act_window">
        <field name="name">Spend Analyses</field>
        <field name="res_model">sf.spend.analysis</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="view_sf_spend_analysis_form" model="ir.ui.view">
        <field name="name">sf.spend.analysis.form</field>
        <field name="model">sf.spend.analysis</field>
        <field name="arch" type="xml">
            <form string="Spend Analysis">
                <header>
                    <button name="action_compute" type="object"
                            string="Compute" class="btn-primary"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,computed"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="date_start"/>
                            <field name="date_end"/>
                        </group>
                        <group>
                            <field name="maverick_tolerance"/>
                            <field name="total_spend" readonly="1"/>
                            <field name="total_maverick" readonly="1"/>
                        </group>
                    </group>
                    <field name="line_ids" readonly="1" decoration-danger="alert">
                        <list create="0">
                            <field name="vendor_id"/>
                            <field name="category_id" optional="show"/>
                            <field name="invoice_count"/>
                            <field name="spend_amount"/>
                            <field name="po_covered_amount"/>
                            <field name="maverick_amount"/>
                            <field name="maverick_percent"/>
                            <field name="alert" widget="boolean"/>
                        </list>
                    </field>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_spend_analysis_list" model="ir.ui.view">
        <field name="name">sf.spend.analysis.list</field>
        <field name="model">sf.spend.analysis</field>
        <field name="arch" type="xml">
            <list string="Spend Analyses" sample="1">
                <field name="name"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="total_spend"/>
                <field name="total_maverick"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'computed'"/>
            </list>
        </field>
    </record>
    <menuitem id="menu_sf_spend_root" name="Spend Analytics" sequence="31"
              parent="purchase.menu_purchase_root"/>
    <menuitem id="menu_sf_spend_analyses" name="Spend Analyses"
              parent="menu_sf_spend_root" action="action_sf_spend_analysis"
              sequence="10"/>
</odoo>
