<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_sf_spend" model="ir.module.category">
        <field name="name">Spend Analytics</field>
        <field name="sequence">81</field>
    </record>
    <record id="group_sf_spend_user" model="res.groups">
        <field name="name">Spend Analytics User</field>
        <field name="category_id" ref="module_category_sf_spend"/>
        <field name="implied_ids" eval="[(4, ref('purchase.group_purchase_user'))]"/>
    </record>
    <record id="group_sf_spend_manager" model="res.groups">
        <field name="name">Spend Analytics Manager</field>
        <field name="category_id" ref="module_category_sf_spend"/>
        <field name="implied_ids" eval="[(4, ref('group_sf_spend_user'))]"/>
    </record>
    <record id="rule_sf_spend_company" model="ir.rule">
        <field name="name">Spend Analysis: multi-company</field>
        <field name="model_id" ref="model_sf_spend_analysis"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
