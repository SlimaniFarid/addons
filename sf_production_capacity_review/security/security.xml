<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_production_capacity_review" model="ir.module.category">
        <field name="name">Production Capacity Review Meeting</field>
        <field name="sequence">258</field>
    </record>
    <record id="group_production_capacity_review_user" model="res.groups">
        <field name="name">Production Capacity Review Meeting User</field>
        <field name="category_id" ref="module_category_production_capacity_review"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>

    </record>
    <record id="group_production_capacity_review_manager" model="res.groups">
        <field name="name">Production Capacity Review Meeting Manager</field>
        <field name="category_id" ref="module_category_production_capacity_review"/>
        <field name="implied_ids" eval="[(4, ref('group_production_capacity_review_user'))]"/>
    </record>
    <record id="rule_production_capacity_review_sf_production_capacity_review" model="ir.rule">
        <field name="name">Production Capacity Review Meeting: multi-company</field>
        <field name="model_id" ref="model_sf_production_capacity_review"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
