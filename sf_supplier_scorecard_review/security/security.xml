<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_supplier_scorecard_review" model="ir.module.category">
        <field name="name">Supplier Scorecard Review Meetings</field>
        <field name="sequence">24</field>
    </record>
    <record id="group_supplier_scorecard_review_user" model="res.groups">
        <field name="name">Supplier Scorecard Review Meetings User</field>
        <field name="category_id" ref="module_category_supplier_scorecard_review"/>
        <field name="implied_ids" eval="[(4, ref('purchase.group_purchase_user'))]"/>

    </record>
    <record id="group_supplier_scorecard_review_manager" model="res.groups">
        <field name="name">Supplier Scorecard Review Meetings Manager</field>
        <field name="category_id" ref="module_category_supplier_scorecard_review"/>
        <field name="implied_ids" eval="[(4, ref('group_supplier_scorecard_review_user'))]"/>
    </record>
    <record id="rule_supplier_scorecard_review_sf_supplier_review" model="ir.rule">
        <field name="name">Supplier Review: multi-company</field>
        <field name="model_id" ref="model_sf_supplier_review"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_supplier_scorecard_review"/>
    </record>
</odoo>
