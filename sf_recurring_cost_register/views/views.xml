<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_recurring_cost_register" model="ir.actions.act_window">
        <field name="name">Recurring Cost Register</field>
        <field name="res_model">sf.recurring_cost_register</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
    <record id="view_sf_recurring_cost_register_form" model="ir.ui.view">
        <field name="name">sf.recurring_cost_register.form</field>
        <field name="model">sf.recurring_cost_register</field>
        <field name="arch" type="xml">
            <form string="Recurring Cost Register">
                <header>
                    <button name="action_submitted" type="object" string="Submitted"
                            class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="label"/>
                            <field name="vendor_id"/>
                            <field name="monthly_amount"/>
                            <field name="frequency"/>
                            <field name="renewal_date"/>
                            <field name="cost_center"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_recurring_cost_register_list" model="ir.ui.view">
        <field name="name">sf.recurring_cost_register.list</field>
        <field name="model">sf.recurring_cost_register</field>
        <field name="arch" type="xml">
            <list string="Recurring Cost Register" sample="1">
                <field name="label"/>
                <field name="vendor_id"/>
                <field name="monthly_amount"/>
                <field name="frequency"/>
                <field name="renewal_date"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state in ('submitted','approved')"/>
            </list>
        </field>
    </record>
    <record id="view_sf_recurring_cost_register_kanban" model="ir.ui.view">
        <field name="name">sf.recurring_cost_register.kanban</field>
        <field name="model">sf.recurring_cost_register</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_view" group_by="state">
                <field name="name"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <menuitem id="menu_sf_recurring_cost_register_root" name="Recurring Cost Register" sequence="13"
              web_icon="sf_recurring_cost_register,static/description/icon.png"/>
    <menuitem id="menu_sf_recurring_cost_register_main" name="Records"
              parent="menu_sf_recurring_cost_register_root" action="action_sf_recurring_cost_register" sequence="10"/>
</odoo>
