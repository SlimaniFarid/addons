<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_recurring_cost_register" model="ir.module.category">
        <field name="name">Recurring Cost Register</field>
        <field name="sequence">188</field>
    </record>
    <record id="group_recurring_cost_register_user" model="res.groups">
        <field name="name">Recurring Cost Register User</field>
        <field name="category_id" ref="module_category_recurring_cost_register"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>

    </record>
    <record id="group_recurring_cost_register_manager" model="res.groups">
        <field name="name">Recurring Cost Register Manager</field>
        <field name="category_id" ref="module_category_recurring_cost_register"/>
        <field name="implied_ids" eval="[(4, ref('group_recurring_cost_register_user'))]"/>
    </record>
    <record id="rule_recurring_cost_register_sf_recurring_cost_register" model="ir.rule">
        <field name="name">Recurring Cost Register: multi-company</field>
        <field name="model_id" ref="model_sf_recurring_cost_register"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
