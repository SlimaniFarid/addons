<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_customer_feedback_analytics" model="ir.actions.act_window">
        <field name="name">Customer Feedback Analytics</field>
        <field name="res_model">sf.customer_feedback_analytics</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
    <record id="view_sf_customer_feedback_analytics_form" model="ir.ui.view">
        <field name="name">sf.customer_feedback_analytics.form</field>
        <field name="model">sf.customer_feedback_analytics</field>
        <field name="arch" type="xml">
            <form string="Customer Feedback Analytics">
                <header>
                    <button name="action_in_progress" type="object" string="In Progress"
                            class="btn-primary"/>
                    <button name="action_review" type="object" string="Review"
                            class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,in_progress,review,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="period"/>
                            <field name="feedback_source"/>
                            <field name="theme"/>
                            <field name="sentiment"/>
                            <field name="frequency"/>
                            <field name="action_priority"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_customer_feedback_analytics_list" model="ir.ui.view">
        <field name="name">sf.customer_feedback_analytics.list</field>
        <field name="model">sf.customer_feedback_analytics</field>
        <field name="arch" type="xml">
            <list string="Customer Feedback Analytics" sample="1">
                <field name="period"/>
                <field name="feedback_source"/>
                <field name="theme"/>
                <field name="sentiment"/>
                <field name="frequency"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state in ('submitted','approved')"/>
            </list>
        </field>
    </record>
    <record id="view_sf_customer_feedback_analytics_kanban" model="ir.ui.view">
        <field name="name">sf.customer_feedback_analytics.kanban</field>
        <field name="model">sf.customer_feedback_analytics</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_view" group_by="state">
                <field name="name"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <menuitem id="menu_sf_customer_feedback_analytics_root" name="Customer Feedback Analytics" sequence="28"
              web_icon="sf_customer_feedback_analytics,static/description/icon.png"/>
    <menuitem id="menu_sf_customer_feedback_analytics_main" name="Records"
              parent="menu_sf_customer_feedback_analytics_root" action="action_sf_customer_feedback_analytics" sequence="10"/>
</odoo>
