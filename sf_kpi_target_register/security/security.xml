<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_kpi_target_register" model="ir.module.category">
        <field name="name">KPI Definition &amp; Target Register</field>
        <field name="sequence">55</field>
    </record>
    <record id="group_kpi_target_register_user" model="res.groups">
        <field name="name">KPI Definition &amp; Target Register User</field>
        <field name="category_id" ref="module_category_kpi_target_register"/>

    </record>
    <record id="group_kpi_target_register_manager" model="res.groups">
        <field name="name">KPI Definition &amp; Target Register Manager</field>
        <field name="category_id" ref="module_category_kpi_target_register"/>
        <field name="implied_ids" eval="[(4, ref('group_kpi_target_register_user'))]"/>
    </record>
    <record id="rule_kpi_target_register_sf_kpi_definition" model="ir.rule">
        <field name="name">KPI Definition: multi-company</field>
        <field name="model_id" ref="model_sf_kpi_definition"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_kpi_target_register"/>
    </record>
</odoo>
