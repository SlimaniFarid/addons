<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_software_license_renewals" model="ir.module.category">
        <field name="name">Software License Renewal Register</field>
        <field name="sequence">46</field>
    </record>
    <record id="group_software_license_renewals_user" model="res.groups">
        <field name="name">Software License Renewal Register User</field>
        <field name="category_id" ref="module_category_software_license_renewals"/>

    </record>
    <record id="group_software_license_renewals_manager" model="res.groups">
        <field name="name">Software License Renewal Register Manager</field>
        <field name="category_id" ref="module_category_software_license_renewals"/>
        <field name="implied_ids" eval="[(4, ref('group_software_license_renewals_user'))]"/>
    </record>
    <record id="rule_software_license_renewals_sf_license_sub" model="ir.rule">
        <field name="name">License Subscription: multi-company</field>
        <field name="model_id" ref="model_sf_license_sub"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_software_license_renewals"/>
    </record>
</odoo>
