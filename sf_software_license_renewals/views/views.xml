<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_license_sub" model="ir.actions.act_window">
        <field name="name">Software License Renewal Register</field>
        <field name="res_model">sf.license.sub</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
    <record id="view_sf_license_sub_form" model="ir.ui.view">
        <field name="name">sf.license.sub.form</field>
        <field name="model">sf.license.sub</field>
        <field name="arch" type="xml">
            <form string="Software License Renewal Register">
                <header>
                    <button name="action_renewal_due" type="object" string="Renewal Due"
                            class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="active,renewal_due,cancelled"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="software"/>
                            <field name="vendor_id"/>
                            <field name="seats"/>
                            <field name="annual_cost"/>
                            <field name="renewal_date"/>
                            <field name="auto_renew"/>
                            <field name="owner_id"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_license_sub_list" model="ir.ui.view">
        <field name="name">sf.license.sub.list</field>
        <field name="model">sf.license.sub</field>
        <field name="arch" type="xml">
            <list string="Software License Renewal Register" sample="1">
                <field name="software"/>
                <field name="vendor_id"/>
                <field name="seats"/>
                <field name="annual_cost"/>
                <field name="renewal_date"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state in ('submitted','approved')"/>
            </list>
        </field>
    </record>
    <record id="view_sf_license_sub_kanban" model="ir.ui.view">
        <field name="name">sf.license.sub.kanban</field>
        <field name="model">sf.license.sub</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_view" group_by="state">
                <field name="name"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <menuitem id="menu_sf_license_sub_root" name="Software License Renewal Register" sequence="8"
              web_icon="sf_software_license_renewals,static/description/icon.png"/>
    <menuitem id="menu_sf_license_sub_main" name="Records"
              parent="menu_sf_license_sub_root" action="action_sf_license_sub" sequence="10"/>
</odoo>
