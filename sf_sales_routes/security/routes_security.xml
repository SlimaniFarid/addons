<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_routes" model="ir.module.category">
        <field name="name">Sales Routes</field>
        <field name="sequence">95</field>
    </record>

    <record id="group_route_user" model="res.groups">
        <field name="name">Sales Routes User</field>
        <field name="category_id" ref="module_category_routes"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_route_manager" model="res.groups">
        <field name="name">Sales Routes Manager</field>
        <field name="category_id" ref="module_category_routes"/>
        <field name="implied_ids" eval="[(4, ref('group_route_user'))]"/>
    </record>

    <record id="rule_route_tour_user_own" model="ir.rule">
        <field name="name">Route Tour: user sees own tours or company</field>
        <field name="model_id" ref="model_sf_route_tour"/>
        <field name="global" eval="True"/>
        <field name="domain_force">['|', ('salesperson_id', '=', user.id), ('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_route_user'))]"/>
    </record>

    <record id="rule_route_visit_user_own" model="ir.rule">
        <field name="name">Route Visit: user sees own tours or company</field>
        <field name="model_id" ref="model_sf_route_visit"/>
        <field name="global" eval="True"/>
        <field name="domain_force">['|', ('tour_id.salesperson_id', '=', user.id), ('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_route_user'))]"/>
    </record>

    <record id="rule_route_territory_user_company" model="ir.rule">
        <field name="name">Territory: user sees own company</field>
        <field name="model_id" ref="model_sf_route_territory"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_route_user'))]"/>
    </record>

    <record id="rule_route_objective_user_company" model="ir.rule">
        <field name="name">Objective: user sees own company</field>
        <field name="model_id" ref="model_sf_route_objective"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_route_user'))]"/>
    </record>
</odoo>