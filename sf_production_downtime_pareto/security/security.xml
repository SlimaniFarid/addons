<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_production_downtime_pareto" model="ir.module.category">
        <field name="name">Production Downtime Pareto</field>
        <field name="sequence">271</field>
    </record>
    <record id="group_production_downtime_pareto_user" model="res.groups">
        <field name="name">Production Downtime Pareto User</field>
        <field name="category_id" ref="module_category_production_downtime_pareto"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>

    </record>
    <record id="group_production_downtime_pareto_manager" model="res.groups">
        <field name="name">Production Downtime Pareto Manager</field>
        <field name="category_id" ref="module_category_production_downtime_pareto"/>
        <field name="implied_ids" eval="[(4, ref('group_production_downtime_pareto_user'))]"/>
    </record>
    <record id="rule_production_downtime_pareto_sf_production_downtime_pareto" model="ir.rule">
        <field name="name">Production Downtime Pareto: multi-company</field>
        <field name="model_id" ref="model_sf_production_downtime_pareto"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
