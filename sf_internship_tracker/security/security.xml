<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_internship_tracker" model="ir.module.category">
        <field name="name">Internship Program Tracker</field>
        <field name="sequence">191</field>
    </record>
    <record id="group_internship_tracker_user" model="res.groups">
        <field name="name">Internship Program Tracker User</field>
        <field name="category_id" ref="module_category_internship_tracker"/>

    </record>
    <record id="group_internship_tracker_manager" model="res.groups">
        <field name="name">Internship Program Tracker Manager</field>
        <field name="category_id" ref="module_category_internship_tracker"/>
        <field name="implied_ids" eval="[(4, ref('group_internship_tracker_user'))]"/>
    </record>
    <record id="rule_internship_tracker_sf_internship_tracker" model="ir.rule">
        <field name="name">Internship Program Tracker: multi-company</field>
        <field name="model_id" ref="model_sf_internship_tracker"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
