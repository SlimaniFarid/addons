<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_ic_balance_check" model="ir.actions.act_window">
        <field name="name">Intercompany Balance Check</field>
        <field name="res_model">sf.ic.balance.check</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
    <record id="view_sf_ic_balance_check_form" model="ir.ui.view">
        <field name="name">sf.ic.balance.check.form</field>
        <field name="model">sf.ic.balance.check</field>
        <field name="arch" type="xml">
            <form string="Intercompany Balance Check">
                <header>
                    <button name="action_explained" type="object" string="Explained"
                            class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="open,explained,resolved"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="period_month"/>
                            <field name="company_a"/>
                            <field name="company_b"/>
                            <field name="balance_a_books"/>
                            <field name="balance_b_books"/>
                            <field name="difference"/>
                            <field name="explanation"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_ic_balance_check_list" model="ir.ui.view">
        <field name="name">sf.ic.balance.check.list</field>
        <field name="model">sf.ic.balance.check</field>
        <field name="arch" type="xml">
            <list string="Intercompany Balance Check" sample="1">
                <field name="period_month"/>
                <field name="company_a"/>
                <field name="company_b"/>
                <field name="balance_a_books"/>
                <field name="balance_b_books"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state in ('submitted','approved')"/>
            </list>
        </field>
    </record>
    <record id="view_sf_ic_balance_check_kanban" model="ir.ui.view">
        <field name="name">sf.ic.balance.check.kanban</field>
        <field name="model">sf.ic.balance.check</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_view" group_by="state">
                <field name="name"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <menuitem id="menu_sf_ic_balance_check_root" name="Intercompany Balance Check" sequence="11"
              web_icon="sf_intercompany_balance_check,static/description/icon.png"/>
    <menuitem id="menu_sf_ic_balance_check_main" name="Records"
              parent="menu_sf_ic_balance_check_root" action="action_sf_ic_balance_check" sequence="10"/>
</odoo>
