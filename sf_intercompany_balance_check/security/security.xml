<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_intercompany_balance_check" model="ir.module.category">
        <field name="name">Intercompany Balance Check</field>
        <field name="sequence">32</field>
    </record>
    <record id="group_intercompany_balance_check_user" model="res.groups">
        <field name="name">Intercompany Balance Check User</field>
        <field name="category_id" ref="module_category_intercompany_balance_check"/>

    </record>
    <record id="group_intercompany_balance_check_manager" model="res.groups">
        <field name="name">Intercompany Balance Check Manager</field>
        <field name="category_id" ref="module_category_intercompany_balance_check"/>
        <field name="implied_ids" eval="[(4, ref('group_intercompany_balance_check_user'))]"/>
    </record>
    <record id="rule_intercompany_balance_check_sf_ic_balance_check" model="ir.rule">
        <field name="name">IC Balance Check: multi-company</field>
        <field name="model_id" ref="model_sf_ic_balance_check"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
