<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_blanket_order" model="ir.actions.act_window">
        <field name="name">Blanket Order Release Tracking</field>
        <field name="res_model">sf.blanket.order</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
    <record id="view_sf_blanket_order_form" model="ir.ui.view">
        <field name="name">sf.blanket.order.form</field>
        <field name="model">sf.blanket.order</field>
        <field name="arch" type="xml">
            <form string="Blanket Order Release Tracking">
                <header>
                    <button name="action_exhausted" type="object" string="Exhausted"
                            class="btn-primary"/>
                    <button name="action_expired" type="object" string="Expired"
                            class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="active,exhausted,expired,cancelled"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="vendor_id"/>
                            <field name="product_id"/>
                            <field name="total_quantity"/>
                            <field name="released_quantity"/>
                            <field name="unit_price"/>
                            <field name="expiry_date"/>
                            <field name="remaining"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_blanket_order_list" model="ir.ui.view">
        <field name="name">sf.blanket.order.list</field>
        <field name="model">sf.blanket.order</field>
        <field name="arch" type="xml">
            <list string="Blanket Order Release Tracking" sample="1">
                <field name="vendor_id"/>
                <field name="product_id"/>
                <field name="total_quantity"/>
                <field name="released_quantity"/>
                <field name="unit_price"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state in ('submitted','approved')"/>
            </list>
        </field>
    </record>
    <record id="view_sf_blanket_order_kanban" model="ir.ui.view">
        <field name="name">sf.blanket.order.kanban</field>
        <field name="model">sf.blanket.order</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_view" group_by="state">
                <field name="name"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <menuitem id="menu_sf_blanket_order_root" name="Blanket Order Release Tracking" sequence="24"
              web_icon="sf_blanket_order_release,static/description/icon.png"/>
    <menuitem id="menu_sf_blanket_order_main" name="Records"
              parent="menu_sf_blanket_order_root" action="action_sf_blanket_order" sequence="10"/>

    <record id="wave_final_sf_blanket_order_release" model="ir.actions.server">
        <field name="name">Refresh Business Data</field>
        <field name="model_id" ref="model_sf_blanket_order"/>
        <field name="binding_model_id" ref="model_sf_blanket_order"/>
        <field name="state">code</field>
        <field name="code">records.action_refresh_business()</field>
    </record>
</odoo>
