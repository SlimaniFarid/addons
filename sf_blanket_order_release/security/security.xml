<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_blanket_order_release" model="ir.module.category">
        <field name="name">Blanket Order Release Tracking</field>
        <field name="sequence">36</field>
    </record>
    <record id="group_blanket_order_release_user" model="res.groups">
        <field name="name">Blanket Order Release Tracking User</field>
        <field name="category_id" ref="module_category_blanket_order_release"/>
        <field name="implied_ids" eval="[(4, ref('purchase.group_purchase_user'))]"/>

    </record>
    <record id="group_blanket_order_release_manager" model="res.groups">
        <field name="name">Blanket Order Release Tracking Manager</field>
        <field name="category_id" ref="module_category_blanket_order_release"/>
        <field name="implied_ids" eval="[(4, ref('group_blanket_order_release_user'))]"/>
    </record>
    <record id="rule_blanket_order_release_sf_blanket_order" model="ir.rule">
        <field name="name">Blanket Order: multi-company</field>
        <field name="model_id" ref="model_sf_blanket_order"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_blanket_order_release"/>
    </record>
</odoo>
