<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_revenue_milestone" model="ir.module.category">
        <field name="name">Revenue Milestone Tracker</field>
        <field name="sequence">187</field>
    </record>
    <record id="group_revenue_milestone_user" model="res.groups">
        <field name="name">Revenue Milestone Tracker User</field>
        <field name="category_id" ref="module_category_revenue_milestone"/>

    </record>
    <record id="group_revenue_milestone_manager" model="res.groups">
        <field name="name">Revenue Milestone Tracker Manager</field>
        <field name="category_id" ref="module_category_revenue_milestone"/>
        <field name="implied_ids" eval="[(4, ref('group_revenue_milestone_user'))]"/>
    </record>
    <record id="rule_revenue_milestone_sf_revenue_milestone" model="ir.rule">
        <field name="name">Revenue Milestone Tracker: multi-company</field>
        <field name="model_id" ref="model_sf_revenue_milestone"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_revenue_milestone"/>
    </record>
</odoo>
