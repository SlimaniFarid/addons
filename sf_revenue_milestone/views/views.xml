<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_revenue_milestone" model="ir.actions.act_window">
        <field name="name">Revenue Milestone Tracker</field>
        <field name="res_model">sf.revenue_milestone</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
    <record id="view_sf_revenue_milestone_form" model="ir.ui.view">
        <field name="name">sf.revenue_milestone.form</field>
        <field name="model">sf.revenue_milestone</field>
        <field name="arch" type="xml">
            <form string="Revenue Milestone Tracker">
                <header>
                    <button name="action_in_progress" type="object" string="In Progress"
                            class="btn-primary"/>
                    <button name="action_review" type="object" string="Review"
                            class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,in_progress,review,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="contract_ref"/>
                            <field name="partner_id"/>
                            <field name="total_value"/>
                            <field name="milestone_percent"/>
                            <field name="recognized_to_date"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_revenue_milestone_list" model="ir.ui.view">
        <field name="name">sf.revenue_milestone.list</field>
        <field name="model">sf.revenue_milestone</field>
        <field name="arch" type="xml">
            <list string="Revenue Milestone Tracker" sample="1">
                <field name="contract_ref"/>
                <field name="partner_id"/>
                <field name="total_value"/>
                <field name="milestone_percent"/>
                <field name="recognized_to_date"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state in ('submitted','approved')"/>
            </list>
        </field>
    </record>
    <record id="view_sf_revenue_milestone_kanban" model="ir.ui.view">
        <field name="name">sf.revenue_milestone.kanban</field>
        <field name="model">sf.revenue_milestone</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_view" group_by="state">
                <field name="name"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <menuitem id="menu_sf_revenue_milestone_root" name="Revenue Milestone Tracker" sequence="14"
              web_icon="sf_revenue_milestone,static/description/icon.png"/>
    <menuitem id="menu_sf_revenue_milestone_main" name="Records"
              parent="menu_sf_revenue_milestone_root" action="action_sf_revenue_milestone" sequence="10"/>
</odoo>
