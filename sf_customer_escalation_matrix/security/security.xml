<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_customer_escalation_matrix" model="ir.module.category">
        <field name="name">Customer Escalation Matrix</field>
        <field name="sequence">182</field>
    </record>
    <record id="group_customer_escalation_matrix_user" model="res.groups">
        <field name="name">Customer Escalation Matrix User</field>
        <field name="category_id" ref="module_category_customer_escalation_matrix"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>

    </record>
    <record id="group_customer_escalation_matrix_manager" model="res.groups">
        <field name="name">Customer Escalation Matrix Manager</field>
        <field name="category_id" ref="module_category_customer_escalation_matrix"/>
        <field name="implied_ids" eval="[(4, ref('group_customer_escalation_matrix_user'))]"/>
    </record>
    <record id="rule_customer_escalation_matrix_sf_customer_escalation_matrix" model="ir.rule">
        <field name="name">Customer Escalation Matrix: multi-company</field>
        <field name="model_id" ref="model_sf_customer_escalation_matrix"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
