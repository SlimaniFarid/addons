<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sf_library_config_settings" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.sf.library</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Library &amp; Media"
                     string="Library &amp; Media"
                     name="sf_library">
                    <block title="Loans">
                        <setting string="Loan duration (days)"
                                 help="Number of days a member can keep an item before it is due.">
                            <field name="sf_library_loan_days"/>
                        </setting>
                    </block>
                    <block title="Sanctions">
                        <setting string="Fine per day"
                                 help="Amount charged per late day on overdue loans.">
                            <field name="sf_library_fine_per_day"/>
                        </setting>
                    </block>
                    <block title="Reservations">
                        <setting string="Reservation hold (days)"
                                 help="Number of days a reservation stays ready before expiring.">
                            <field name="sf_library_hold_days"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
