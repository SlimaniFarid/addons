<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_sf_library" model="ir.module.category">
        <field name="name">Library &amp; Media</field>
        <field name="sequence">90</field>
    </record>

    <record id="group_sf_library_user" model="res.groups">
        <field name="name">Library User</field>
        <field name="category_id" ref="module_category_sf_library"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_sf_library_manager" model="res.groups">
        <field name="name">Library Manager</field>
        <field name="category_id" ref="module_category_sf_library"/>
        <field name="implied_ids" eval="[(4, ref('group_sf_library_user'))]"/>
    </record>

    <record id="rule_sf_library_item_user_company" model="ir.rule">
        <field name="name">Item: user sees own company</field>
        <field name="model_id" ref="model_sf_library_item"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_sf_library_user'))]"/>
    </record>

    <record id="rule_sf_library_item_manager_all" model="ir.rule">
        <field name="name">Item: manager sees all companies</field>
        <field name="model_id" ref="model_sf_library_item"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_sf_library_manager'))]"/>
    </record>

    <record id="rule_sf_library_category_user_company" model="ir.rule">
        <field name="name">Category: user sees own company</field>
