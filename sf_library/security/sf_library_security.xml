        <field name="name">Member: user sees own company</field>
        <field name="model_id" ref="model_sf_library_member"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_sf_library_user'))]"/>
    </record>

