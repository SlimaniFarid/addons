<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_sf_library_item" model="ir.sequence">
            <field name="name">Library Item</field>
            <field name="code">sf.library.item</field>
            <field name="prefix">LIB-</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>

        <record id="seq_sf_library_category" model="ir.sequence">
            <field name="name">Library Category</field>
            <field name="code">sf.library.category</field>
            <field name="prefix">CAT-</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>

        <record id="seq_sf_library_member" model="ir.sequence">
            <field name="name">Library Member</field>
            <field name="code">sf.library.member</field>
            <field name="prefix">MEM-</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>

        <record id="seq_sf_library_loan" model="ir.sequence">
            <field name="name">Library Loan</field>
            <field name="code">sf.library.loan</field>
            <field name="prefix">LOA-</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>

        <record id="seq_sf_library_reservation" model="ir.sequence">
            <field name="name">Library Reservation</field>
            <field name="code">sf.library.reservation</field>
            <field name="prefix">RES-</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>

        <record id="cron_sf_library_alerts" model="ir.cron">
            <field name="name">Library: Late Loans &amp; Reservation Alerts</field>
            <field name="model_id" ref="model_sf_library_loan"/>
            <field name="state">code</field>
            <field name="code">model._cron_library_alerts()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="active">True</field>
        </record>
    </data>
</odoo>
