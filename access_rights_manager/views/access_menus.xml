<odoo>
    <record id="action_access_policy" model="ir.actions.act_window">
        <field name="name">Access Policies</field>
        <field name="res_model">access.policy</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_access_root" name="Access Rights Manager" web_icon="access_rights_manager,static/description/icon.png"/>
    <menuitem id="menu_access_policies" name="Policies" parent="menu_access_root" action="action_access_policy" sequence="10"/>

    <record id="view_access_policy_form" model="ir.ui.view">
        <field name="name">access.policy.form</field>
        <field name="model">access.policy</field>
        <field name="arch" type="xml">
            <form string="Access Policy">
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="draft,active,error"/>
                    <button name="action_apply" string="Apply Policy" type="object" class="btn-primary" invisible="state!='draft'"/>
                    <button name="action_reset" string="Reset to Draft" type="object" class="btn-secondary" invisible="state=='draft'"/>
                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="sequence"/>
                        <field name="active"/>
                    </group>
                    <group string="Scope">
                        <field name="group_ids" widget="many2many_tags" options="{'no_create': True}"/>
                        <field name="company_ids" widget="many2many_tags" options="{'no_create': True}"/>
                    </group>
                    <notebook>
                        <page string="Menu Rules">
                            <field name="menu_rule_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="action"/>
                                    <field name="menu_ids" widget="many2many_tags" options="{'no_create': True}"/>
                                    <field name="group_ids" widget="many2many_tags" options="{'no_create': True}"/>
                                </list>
                            </field>
                        </page>
                        <page string="Field Rules">
                            <field name="field_rule_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="model_id" options="{'no_create': True}"/>
                                    <field name="field_id" options="{'no_create': True}"/>
                                    <field name="action"/>
                                    <field name="group_ids" widget="many2many_tags" options="{'no_create': True}"/>
                                    <field name="condition"/>
                                </list>
                            </field>
                        </page>
                        <page string="Action Rules">
                            <field name="action_rule_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="action"/>
                                    <field name="action_ids" widget="many2many_tags" options="{'no_create': True}"/>
                                    <field name="group_ids" widget="many2many_tags" options="{'no_create': True}"/>
                                </list>
                            </field>
                        </page>
                        <page string="Export Rules">
                            <field name="export_rule_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="model_id" options="{'no_create': True}"/>
                                    <field name="action"/>
                                    <field name="group_ids" widget="many2many_tags" options="{'no_create': True}"/>
                                    <field name="field_ids" widget="many2many_tags" options="{'no_create': True}"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_access_policy_list" model="ir.ui.view">
        <field name="name">access.policy.list</field>
        <field name="model">access.policy</field>
        <field name="arch" type="xml">
            <list string="Access Policies">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="state" widget="badge" decoration-success="state=='active'" decoration-muted="state=='draft'" decoration-danger="state=='error'"/>
                <field name="active"/>
            </list>
        </field>
    </record>
</odoo>