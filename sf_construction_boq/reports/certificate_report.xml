<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <report
        id="report_construction_certificate"
        string="Payment Certificate"
        model="construction.payment.certificate"
        report_type="qweb-pdf"
        file="sf_construction_boq.construction_certificate_report"
        name="sf_construction_boq.construction_certificate_report"
        print_report_name="'IPC - %s' % (object.name)"
    />

    <template id="construction_certificate_report">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>
                            <span>Payment Certificate — </span>
                            <span t-field="o.name"/>
                        </h2>
                        <div class="row mt-4">
                            <div class="col-6">
                                <strong>Project:</strong>
                                <span t-field="o.project_id"/>
                                <br/>
                                <strong>Contractor:</strong>
                                <span t-field="o.contractor_id"/>
                                <br/>
                                <strong>Subcontract:</strong>
                                <span t-field="o.subcontract_id"/>
                            </div>
                            <div class="col-6 text-end">
                                <strong>Period:</strong>
                                <span t-field="o.period_start"/> — <span t-field="o.period_end"/>
                                <br/>
                                <strong>Certificate Date:</strong>
                                <span t-field="o.date"/>
                                <br/>
                                <strong>Retention:</strong>
                                <span t-field="o.retention_rate"/>%
                            </div>
                        </div>
                        <table class="table table-sm mt-4">
                            <thead>
                                <tr>
                                    <th>Description</th>
                                    <th class="text-end">Previous Qty</th>
                                    <th class="text-end">Current Qty</th>
                                    <th class="text-end">Total Qty</th>
                                    <th class="text-end">Unit Price</th>
                                    <th class="text-end">Amount</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="o.certificate_line_ids" t-as="line">
                                    <tr>
                                        <td>
                                            <span t-field="line.description"/>
                                        </td>
                                        <td class="text-end">
                                            <span t-field="line.previous_quantity"/>
                                        </td>
                                        <td class="text-end">
                                            <span t-field="line.current_quantity"/>
                                        </td>
                                        <td class="text-end">
                                            <span t-field="line.total_quantity"/>
                                        </td>
                                        <td class="text-end">
                                            <span t-field="line.unit_price"/>
                                        </td>
                                        <td class="text-end">
                                            <span t-field="line.current_amount"/>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                        <div class="row mt-4">
                            <div class="col-6 offset-6">
                                <table class="table table-sm">
                                    <tr>
                                        <td><strong>Previously Certified</strong></td>
                                        <td class="text-end"><span t-field="o.previous_certified"/></td>
                                    </tr>
                                    <tr>
                                        <td><strong>Current Period</strong></td>
                                        <td class="text-end"><span t-field="o.current_amount"/></td>
                                    </tr>
                                    <tr>
                                        <td><strong>Retention</strong></td>
                                        <td class="text-end"><span t-field="o.retention_amount"/></td>
                                    </tr>
                                    <tr>
                                        <td><strong>Net Amount</strong></td>
                                        <td class="text-end"><span t-field="o.net_amount"/></td>
                                    </tr>
                                    <tr class="table-primary">
                                        <td><strong>Amount to Pay</strong></td>
                                        <td class="text-end"><strong><span t-field="o.amount_to_pay"/></strong></td>
                                    </tr>
                                </table>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>