<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============ BOQ ============ -->
    <record id="view_construction_boq_form" model="ir.ui.view">
        <field name="name">construction.boq.form</field>
        <field name="model">construction.boq</field>
        <field name="arch" type="xml">
            <form string="Bill of Quantities">
                <header>
                    <button name="action_confirm" type="object" string="Confirm" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_start" type="object" string="Start" class="btn-secondary" invisible="state != 'confirmed'"/>
                    <button name="action_done" type="object" string="Mark Done" class="btn-secondary" invisible="state not in ('confirmed','in_progress')"/>
                    <button name="action_cancel" type="object" string="Cancel" class="btn-secondary" invisible="state in ('done','cancelled')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,in_progress,done,cancelled"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="project_id"/>
                            <field name="partner_id"/>
                            <field name="date"/>
                        </group>
                        <group>
                            <field name="amount_total" class="oe_subtotal_footer_separator"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group string="BOQ Lines">
                        <field name="boq_line_ids">
                            <list decoration-danger="is_overdue" editable="bottom">
                                <field name="sequence" widget="handle"/>
                                <field name="code"/>
                                <field name="description"/>
                                <field name="category"/>
                                <field name="product_id"/>
                                <field name="uom_id" groups="uom.group_uom"/>
                                <field name="quantity"/>
                                <field name="unit_price"/>
                                <field name="price_subtotal" readonly="1" sum="Total"/>
                            </list>
                        </field>
                    </group>
                    <group string="Notes">
                        <field name="notes"/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_construction_boq_list" model="ir.ui.view">
        <field name="name">construction.boq.list</field>
        <field name="model">construction.boq</field>
        <field name="arch" type="xml">
            <list string="Bills of Quantities">
                <field name="name"/>
                <field name="project_id"/>
                <field name="partner_id"/>
                <field name="date"/>
                <field name="amount_total" sum="Total"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_construction_boq_search" model="ir.ui.view">
        <field name="name">construction.boq.search</field>
        <field name="model">construction.boq</field>
        <field name="arch" type="xml">
            <search string="Search Bills of Quantities">
                <field name="name"/>
                <field name="project_id"/>
                <field name="partner_id"/>
                <filter name="group_by_state" string="Status" context="{'group_by': 'state'}"/>
                <filter name="group_by_project" string="Project" context="{'group_by': 'project_id'}"/>
            </search>
        </field>
    </record>

    <!-- ============ Subcontract ============ -->
    <record id="view_construction_subcontract_form" model="ir.ui.view">
        <field name="name">construction.subcontract.form</field>
        <field name="model">construction.subcontract</field>
        <field name="arch" type="xml">
            <form string="Subcontract">
                <header>
                    <button name="action_confirm" type="object" string="Confirm" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_start" type="object" string="Start" class="btn-secondary" invisible="state != 'confirmed'"/>
                    <button name="action_close" type="object" string="Close" class="btn-secondary" invisible="state not in ('confirmed','in_progress')"/>
                    <button name="action_cancel" type="object" string="Cancel" class="btn-secondary" invisible="state in ('closed','cancelled')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,in_progress,closed,cancelled"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="project_id"/>
                            <field name="contractor_id"/>
                            <field name="start_date"/>
                            <field name="end_date"/>
                        </group>
                        <group>
                            <field name="contract_amount"/>
                            <field name="retention_rate"/>
                            <field name="advance_amount"/>
                            <field name="amount_certified" readonly="1"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Payment Certificates" name="certificates">
                            <field name="certificate_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="period_start"/>
                                    <field name="period_end"/>
                                    <field name="current_amount"/>
                                    <field name="retention_amount"/>
                                    <field name="net_amount"/>
                                    <field name="amount_to_pay"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_construction_subcontract_list" model="ir.ui.view">
        <field name="name">construction.subcontract.list</field>
        <field name="model">construction.subcontract</field>
        <field name="arch" type="xml">
            <list string="Subcontracts">
                <field name="name"/>
                <field name="project_id"/>
                <field name="contractor_id"/>
                <field name="contract_amount"/>
                <field name="amount_certified" sum="Total"/>
                <field name="end_date"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_construction_subcontract_search" model="ir.ui.view">
        <field name="name">construction.subcontract.search</field>
        <field name="model">construction.subcontract</field>
        <field name="arch" type="xml">
            <search string="Search Subcontracts">
                <field name="name"/>
                <field name="project_id"/>
                <field name="contractor_id"/>
                <filter name="group_by_state" string="Status" context="{'group_by': 'state'}"/>
                <filter name="group_by_project" string="Project" context="{'group_by': 'project_id'}"/>
            </search>
        </field>
    </record>

    <!-- ============ Payment Certificate ============ -->
    <record id="view_construction_certificate_form" model="ir.ui.view">
        <field name="name">construction.payment.certificate.form</field>
        <field name="model">construction.payment.certificate</field>
        <field name="arch" type="xml">
            <form string="Payment Certificate">
                <header>
                    <button name="action_confirm" type="object" string="Confirm" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_paid" type="object" string="Mark Paid" class="btn-secondary" invisible="state != 'confirmed'"/>
                    <button name="action_cancel" type="object" string="Cancel" class="btn-secondary" invisible="state in ('paid','cancelled')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,paid,cancelled"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="subcontract_id"/>
                            <field name="project_id"/>
                            <field name="contractor_id"/>
                        </group>
                        <group>
                            <field name="period_start"/>
                            <field name="period_end"/>
                            <field name="date"/>
                            <field name="retention_rate"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="previous_certified" readonly="1"/>
                            <field name="current_amount" readonly="1"/>
                            <field name="retention_amount" readonly="1"/>
                        </group>
                        <group>
                            <field name="net_amount" readonly="1" class="oe_subtotal_footer_separator"/>
                            <field name="amount_to_pay" readonly="1"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <group string="Lines">
                        <field name="certificate_line_ids">
                            <list editable="bottom">
                                <field name="sequence" widget="handle"/>
                                <field name="boq_line_id"/>
                                <field name="description"/>
                                <field name="previous_quantity"/>
                                <field name="current_quantity"/>
                                <field name="total_quantity" readonly="1"/>
                                <field name="unit_price"/>
                                <field name="current_amount" readonly="1" sum="Total"/>
                            </list>
                        </field>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_construction_certificate_list" model="ir.ui.view">
        <field name="name">construction.payment.certificate.list</field>
        <field name="model">construction.payment.certificate</field>
        <field name="arch" type="xml">
            <list string="Payment Certificates">
                <field name="name"/>
                <field name="subcontract_id"/>
                <field name="project_id"/>
                <field name="contractor_id"/>
                <field name="period_end"/>
                <field name="current_amount"/>
                <field name="amount_to_pay" sum="Total"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_construction_certificate_search" model="ir.ui.view">
        <field name="name">construction.payment.certificate.search</field>
        <field name="model">construction.payment.certificate</field>
        <field name="arch" type="xml">
            <search string="Search Payment Certificates">
                <field name="name"/>
                <field name="project_id"/>
                <field name="contractor_id"/>
                <filter name="group_by_state" string="Status" context="{'group_by': 'state'}"/>
                <filter name="group_by_project" string="Project" context="{'group_by': 'project_id'}"/>
            </search>
        </field>
    </record>

    <record id="view_sf_construction_boq_boost_kanban" model="ir.ui.view">
        <field name="name">sf_construction_boq.boost.kanban</field>
        <field name="model">construction.boq</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" t-att-color="state">
                <field name="name"/>
                <field name="state"/>
                <field name="user_id"/>
                <field name="end_date"/>
                <field name="is_overdue" invisible="1"/>

                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_card oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title">
                                    <field name="name"/></strong>
                                <div class="o_kanban_record_subtitle">
                                    <field name="user_id" widget="many2one_avatar_user"/>
                                    <field name="end_date"/></div>
                            </div>
                            <div class="oe_kanban_bottom_right">
                                <field name="state" widget="badge"
                                       t-attf-options="{'classes_map': {'draft': 'info', 'done': 'success', 'cancelled': 'danger'}, 'domain': []}"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_sf_construction_boq_boost_search" model="ir.ui.view">
        <field name="name">sf_construction_boq.boost.search</field>
        <field name="model">construction.boq</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
<separator/>
                <filter string="My records" name="my_records" domain="[('user_id', '=', uid)]"/>
                <filter string="To Do" name="todo" domain="[('state', 'not in', ('done', 'cancelled', 'closed'))]"/>
                <group expand="0" string="Group By"><filter string="Status" name="gb_state" context="{'group_by': 'state'}"/></group>
            </search>
        </field>
    </record>

    <record id="wave_final_sf_construction_boq" model="ir.actions.server">
        <field name="name">Refresh Business Data</field>
        <field name="model_id" ref="model_construction_boq"/>
        <field name="binding_model_id" ref="model_construction_boq"/>
        <field name="state">code</field>
        <field name="code">records.action_refresh_business()</field>
    </record>
</odoo>
