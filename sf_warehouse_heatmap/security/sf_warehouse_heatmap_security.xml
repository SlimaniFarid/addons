<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_sf_warehouse_heatmap" model="ir.module.category">
        <field name="name">Warehouse Activity Heatmap</field>
        <field name="description">Warehouse Activity Heatmap</field>
        <field name="sequence">10</field>
    </record>
    <record id="group_warehouse_heatmap_user" model="res.groups">
        <field name="name">Warehouse Activity Heatmap / User</field>
        <field name="category_id" ref="module_category_sf_warehouse_heatmap"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_warehouse_heatmap_manager" model="res.groups">
        <field name="name">Warehouse Activity Heatmap / Manager</field>
        <field name="category_id" ref="module_category_sf_warehouse_heatmap"/>
        <field name="implied_ids" eval="[(4, ref('sf_warehouse_heatmap.group_warehouse_heatmap_user'))]"/>
    </record>
    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_sf_warehouse_heatmap"/>
    </record>
</odoo>
