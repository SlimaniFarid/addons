<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_slotting_analysis_list" model="ir.ui.view">
        <field name="name">sf.warehouse.heatmap.slotting.analysis.list</field>
        <field name="model">sf.warehouse.heatmap.slotting.analysis</field>
        <field name="arch" type="xml">
            <list string="Slotting.Analysis">
                <field name="warehouse_id"/>
                <field name="analysis_date"/>
                <field name="abc_a_pct"/>
                <field name="abc_b_pct"/>
                <field name="state"/>
                <field name="state" widget="badge"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_slotting_analysis_form" model="ir.ui.view">
        <field name="name">sf.warehouse.heatmap.slotting.analysis.form</field>
        <field name="model">sf.warehouse.heatmap.slotting.analysis</field>
        <field name="arch" type="xml">
            <form string="Slotting.Analysis">
                <header>
                <field name="state" widget="badge"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" placeholder="Name"/></h1></div>
                    <group><group>
                            <field name="warehouse_id"/>
                            <field name="analysis_date"/>
                            <field name="abc_a_pct"/>
                            <field name="abc_b_pct"/>
                            <field name="state"/>
                    </group>
                    <group>
                        <field name="currency_id" invisible="1"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_slotting_analysis" model="ir.actions.act_window">
        <field name="name">Slotting.Analysis</field>
        <field name="res_model">sf.warehouse.heatmap.slotting.analysis</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="wave_final_sf_warehouse_heatmap" model="ir.actions.server">
        <field name="name">Refresh Business Data</field>
        <field name="model_id" ref="model_sf_warehouse_heatmap_slotting_analysis"/>
        <field name="binding_model_id" ref="model_sf_warehouse_heatmap_slotting_analysis"/>
        <field name="state">code</field>
        <field name="code">records.action_refresh_business()</field>
    </record>
</odoo>
