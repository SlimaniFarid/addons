<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_slotting_result_list" model="ir.ui.view">
        <field name="name">sf.warehouse.heatmap.slotting.result.list</field>
        <field name="model">sf.warehouse.heatmap.slotting.result</field>
        <field name="arch" type="xml">
            <list string="Slotting.Result">
                <field name="analysis_id"/>
                <field name="product_id"/>
                <field name="pick_count"/>
                <field name="current_location"/>
                <field name="abc_class"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_slotting_result_form" model="ir.ui.view">
        <field name="name">sf.warehouse.heatmap.slotting.result.form</field>
        <field name="model">sf.warehouse.heatmap.slotting.result</field>
        <field name="arch" type="xml">
            <form string="Slotting.Result">
                <header>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" placeholder="Name"/></h1></div>
                    <group><group>
                            <field name="analysis_id"/>
                            <field name="product_id"/>
                            <field name="pick_count"/>
                            <field name="current_location"/>
                            <field name="abc_class"/>
                    </group>
                    <group>
                        <field name="currency_id" invisible="1"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_slotting_result" model="ir.actions.act_window">
        <field name="name">Slotting.Result</field>
        <field name="res_model">sf.warehouse.heatmap.slotting.result</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
