<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_project_margin" model="ir.module.category">
        <field name="name">Project Margin</field>
        <field name="sequence">97</field>
    </record>

    <record id="group_project_margin_user" model="res.groups">
        <field name="name">Project Margin User</field>
        <field name="category_id" ref="module_category_project_margin"/>
        <field name="implied_ids" eval="[(4, ref('project.group_project_user'))]"/>
    </record>

    <record id="group_project_margin_manager" model="res.groups">
        <field name="name">Project Margin Manager</field>
        <field name="category_id" ref="module_category_project_margin"/>
        <field name="implied_ids" eval="[(4, ref('group_project_margin_user'))]"/>
    </record>
</odoo>