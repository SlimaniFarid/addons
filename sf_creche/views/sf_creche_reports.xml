<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="report_sf_creche_billing" model="ir.actions.report">
        <field name="name">Monthly Invoice</field>
        <field name="model">sf.creche.billing</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">sf_creche.monthly_invoice_template</field>
        <field name="report_file">sf_creche.monthly_invoice_template</field>
        <field name="binding_model_id" ref="model_sf_creche_billing"/>
        <field name="binding_type">report</field>
    </record>

    <template id="monthly_invoice_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>Monthly Invoice</h2>
                        <table class="table table-sm">
                            <tr><td><strong>Invoice</strong></td><td><t t-esc="o.name"/></td></tr>
                            <tr><td><strong>Child</strong></td><td><t t-esc="o.child_id.name"/></td></tr>
                            <tr><td><strong>Month</strong></td><td><t t-esc="o.month"/></td></tr>
                            <tr><td><strong>Hours</strong></td><td><t t-esc="o.hours"/></td></tr>
                            <tr><td><strong>Hourly rate</strong></td><td><t t-esc="o.hourly_rate"/></td></tr>
                            <tr><td><strong>Amount</strong></td><td><t t-esc="o.amount"/></td></tr>
                            <tr><td><strong>Status</strong></td><td><t t-esc="dict(o._fields['state'].selection).get(o.state)"/></td></tr>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <record id="report_sf_creche_attendance" model="ir.actions.report">
        <field name="name">Attendance Register</field>
        <field name="model">sf.creche.attendance</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">sf_creche.attendance_register_template</field>
        <field name="report_file">sf_creche.attendance_register_template</field>
        <field name="binding_model_id" ref="model_sf_creche_attendance"/>
        <field name="binding_type">report</field>
    </record>

    <template id="attendance_register_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>Attendance Register</h2>
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Attendance</th>
                                    <th>Child</th>
                                    <th>Date</th>
                                    <th>Arrival</th>
                                    <th>Departure</th>
                                    <th>Hours</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="docs" t-as="attendance">
                                    <tr>
                                        <td><t t-esc="attendance.name"/></td>
                                        <td><t t-esc="attendance.child_id.name"/></td>
                                        <td><t t-esc="attendance.date"/></td>
                                        <td><t t-esc="attendance.arrival_time"/></td>
                                        <td><t t-esc="attendance.departure_time or ''"/></td>
                                        <td><t t-esc="attendance.hours"/></td>
                                        <td><t t-esc="dict(attendance._fields['state'].selection).get(attendance.state)"/></td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>
