<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_sf_creche" model="ir.module.category">
        <field name="name">Creche Management</field>
        <field name="sequence">90</field>
    </record>

    <record id="group_sf_creche_user" model="res.groups">
        <field name="name">Creche Management User</field>
        <field name="category_id" ref="module_category_sf_creche"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_sf_creche_manager" model="res.groups">
        <field name="name">Creche Management Manager</field>
        <field name="category_id" ref="module_category_sf_creche"/>
        <field name="implied_ids" eval="[(4, ref('group_sf_creche_user'))]"/>
    </record>

    <record id="rule_creche_child_user_company" model="ir.rule">
        <field name="name">Child: user sees own company</field>
        <field name="model_id" ref="model_sf_creche_child"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_sf_creche_user'))]"/>
    </record>

    <record id="rule_creche_enrollment_user_company" model="ir.rule">
        <field name="name">Enrollment: user sees own company</field>
        <field name="model_id" ref="model_sf_creche_enrollment"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_sf_creche_user'))]"/>
    </record>

    <record id="rule_creche_attendance_user_company" model="ir.rule">
        <field name="name">Attendance: user sees own company</field>
        <field name="model_id" ref="model_sf_creche_attendance"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_sf_creche_user'))]"/>
    </record>

    <record id="rule_creche_room_user_company" model="ir.rule">
        <field name="name">Room: user sees own company</field>
        <field name="model_id" ref="model_sf_creche_room"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_sf_creche_user'))]"/>
    </record>

    <record id="rule_creche_billing_user_company" model="ir.rule">
        <field name="name">Billing: user sees own company</field>
        <field name="model_id" ref="model_sf_creche_billing"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_sf_creche_user'))]"/>
    </record>

    <record id="rule_creche_child_manager_all" model="ir.rule">
        <field name="name">Child: manager sees all companies</field>
        <field name="model_id" ref="model_sf_creche_child"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_sf_creche_manager'))]"/>
    </record>

    <record id="rule_creche_enrollment_manager_all" model="ir.rule">
        <field name="name">Enrollment: manager sees all companies</field>
        <field name="model_id" ref="model_sf_creche_enrollment"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_sf_creche_manager'))]"/>
    </record>

    <record id="rule_creche_attendance_manager_all" model="ir.rule">
        <field name="name">Attendance: manager sees all companies</field>
        <field name="model_id" ref="model_sf_creche_attendance"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_sf_creche_manager'))]"/>
    </record>

    <record id="rule_creche_room_manager_all" model="ir.rule">
        <field name="name">Room: manager sees all companies</field>
        <field name="model_id" ref="model_sf_creche_room"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_sf_creche_manager'))]"/>
    </record>

    <record id="rule_creche_billing_manager_all" model="ir.rule">
        <field name="name">Billing: manager sees all companies</field>
        <field name="model_id" ref="model_sf_creche_billing"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_sf_creche_manager'))]"/>
    </record>
</odoo>
