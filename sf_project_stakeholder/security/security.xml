<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_project_stakeholder" model="ir.module.category">
        <field name="name">Stakeholder Register</field>
        <field name="sequence">399</field>
    </record>
    <record id="group_project_stakeholder_user" model="res.groups">
        <field name="name">Stakeholder Register User</field>
        <field name="category_id" ref="module_category_project_stakeholder"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>

    </record>
    <record id="group_project_stakeholder_manager" model="res.groups">
        <field name="name">Stakeholder Register Manager</field>
        <field name="category_id" ref="module_category_project_stakeholder"/>
        <field name="implied_ids" eval="[(4, ref('group_project_stakeholder_user'))]"/>
    </record>
    <record id="rule_project_stakeholder_sf_project_stakeholder" model="ir.rule">
        <field name="name">Stakeholder Register: multi-company</field>
        <field name="model_id" ref="model_sf_project_stakeholder"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_project_stakeholder"/>
    </record>
</odoo>
