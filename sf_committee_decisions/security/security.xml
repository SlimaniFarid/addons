<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_committee_decisions" model="ir.module.category">
        <field name="name">Committee Decision Log</field>
        <field name="sequence">56</field>
    </record>
    <record id="group_committee_decisions_user" model="res.groups">
        <field name="name">Committee Decision Log User</field>
        <field name="category_id" ref="module_category_committee_decisions"/>

    </record>
    <record id="group_committee_decisions_manager" model="res.groups">
        <field name="name">Committee Decision Log Manager</field>
        <field name="category_id" ref="module_category_committee_decisions"/>
        <field name="implied_ids" eval="[(4, ref('group_committee_decisions_user'))]"/>
    </record>
    <record id="rule_committee_decisions_sf_committee_decision" model="ir.rule">
        <field name="name">Committee Decision: multi-company</field>
        <field name="model_id" ref="model_sf_committee_decision"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_committee_decisions"/>
    </record>
</odoo>
