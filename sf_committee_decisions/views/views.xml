<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_committee_decision" model="ir.actions.act_window">
        <field name="name">Committee Decision Log</field>
        <field name="res_model">sf.committee.decision</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
    <record id="view_sf_committee_decision_form" model="ir.ui.view">
        <field name="name">sf.committee.decision.form</field>
        <field name="model">sf.committee.decision</field>
        <field name="arch" type="xml">
            <form string="Committee Decision Log">
                <header>
                    <button name="action_confirmed" type="object" string="Confirmed"
                            class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,executed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="committee"/>
                            <field name="meeting_date"/>
                            <field name="topic"/>
                        <field name="context"/>
                            <field name="decision"/>
                            <field name="followup_actions"/>
                            <field name="chair_id"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_committee_decision_list" model="ir.ui.view">
        <field name="name">sf.committee.decision.list</field>
        <field name="model">sf.committee.decision</field>
        <field name="arch" type="xml">
            <list string="Committee Decision Log" sample="1">
                <field name="committee"/>
                <field name="meeting_date"/>
                <field name="topic"/>
                <field name="context"/>
                <field name="decision"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state in ('submitted','approved')"/>
            </list>
        </field>
    </record>
    <record id="view_sf_committee_decision_kanban" model="ir.ui.view">
        <field name="name">sf.committee.decision.kanban</field>
        <field name="model">sf.committee.decision</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_view" group_by="state">
                <field name="name"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <menuitem id="menu_sf_committee_decision_root" name="Committee Decision Log" sequence="12"
              web_icon="sf_committee_decisions,static/description/icon.png"/>
    <menuitem id="menu_sf_committee_decision_main" name="Records"
              parent="menu_sf_committee_decision_root" action="action_sf_committee_decision" sequence="10"/>
</odoo>
