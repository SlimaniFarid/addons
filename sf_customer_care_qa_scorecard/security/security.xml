<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_customer_care_qa_scorecard" model="ir.module.category">
        <field name="name">Care QA Scorecard</field>
        <field name="sequence">471</field>
    </record>
    <record id="group_customer_care_qa_scorecard_user" model="res.groups">
        <field name="name">Care QA Scorecard User</field>
        <field name="category_id" ref="module_category_customer_care_qa_scorecard"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>

    </record>
    <record id="group_customer_care_qa_scorecard_manager" model="res.groups">
        <field name="name">Care QA Scorecard Manager</field>
        <field name="category_id" ref="module_category_customer_care_qa_scorecard"/>
        <field name="implied_ids" eval="[(4, ref('group_customer_care_qa_scorecard_user'))]"/>
    </record>
    <record id="rule_customer_care_qa_scorecard_sf_customer_care_qa_scorecard" model="ir.rule">
        <field name="name">Care QA Scorecard: multi-company</field>
        <field name="model_id" ref="model_sf_customer_care_qa_scorecard"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
