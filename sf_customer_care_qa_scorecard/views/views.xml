<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_customer_care_qa_scorecard" model="ir.actions.act_window">
        <field name="name">Care QA Scorecard</field>
        <field name="res_model">sf.customer_care_qa_scorecard</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
    <record id="view_sf_customer_care_qa_scorecard_form" model="ir.ui.view">
        <field name="name">sf.customer_care_qa_scorecard.form</field>
        <field name="model">sf.customer_care_qa_scorecard</field>
        <field name="arch" type="xml">
            <form string="Care QA Scorecard">
                <header>
                    <button name="action_in_progress" type="object" string="In Progress"
                            class="btn-primary"/>
                    <button name="action_review" type="object" string="Review"
                            class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,in_progress,review,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="agent_id"/>
                            <field name="interaction_ref"/>
                            <field name="qa_score"/>
                            <field name="strengths"/>
                            <field name="improvements"/>
                            <field name="reviewer_id"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_customer_care_qa_scorecard_list" model="ir.ui.view">
        <field name="name">sf.customer_care_qa_scorecard.list</field>
        <field name="model">sf.customer_care_qa_scorecard</field>
        <field name="arch" type="xml">
            <list string="Care QA Scorecard" sample="1">
                <field name="agent_id"/>
                <field name="interaction_ref"/>
                <field name="qa_score"/>
                <field name="strengths"/>
                <field name="improvements"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state in ('submitted','approved')"/>
            </list>
        </field>
    </record>
    <record id="view_sf_customer_care_qa_scorecard_kanban" model="ir.ui.view">
        <field name="name">sf.customer_care_qa_scorecard.kanban</field>
        <field name="model">sf.customer_care_qa_scorecard</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_view" group_by="state">
                <field name="name"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <menuitem id="menu_sf_customer_care_qa_scorecard_root" name="Care QA Scorecard" sequence="30"
              web_icon="sf_customer_care_qa_scorecard,static/description/icon.png"/>
    <menuitem id="menu_sf_customer_care_qa_scorecard_main" name="Records"
              parent="menu_sf_customer_care_qa_scorecard_root" action="action_sf_customer_care_qa_scorecard" sequence="10"/>
</odoo>
