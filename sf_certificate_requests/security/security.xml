<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_certificate_requests" model="ir.module.category">
        <field name="name">Employee Certificate Requests</field>
        <field name="sequence">7</field>
    </record>
    <record id="group_certificate_requests_user" model="res.groups">
        <field name="name">Employee Certificate Requests User</field>
        <field name="category_id" ref="module_category_certificate_requests"/>

    </record>
    <record id="group_certificate_requests_manager" model="res.groups">
        <field name="name">Employee Certificate Requests Manager</field>
        <field name="category_id" ref="module_category_certificate_requests"/>
        <field name="implied_ids" eval="[(4, ref('group_certificate_requests_user'))]"/>
    </record>
    <record id="rule_certificate_requests_sf_cert_request" model="ir.rule">
        <field name="name">Certificate Request: multi-company</field>
        <field name="model_id" ref="model_sf_cert_request"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
