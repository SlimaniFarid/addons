<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_scrap_reason_analytics" model="ir.module.category">
        <field name="name">Scrap Reason Analytics</field>
        <field name="sequence">17</field>
    </record>
    <record id="group_scrap_reason_analytics_user" model="res.groups">
        <field name="name">Scrap Reason Analytics User</field>
        <field name="category_id" ref="module_category_scrap_reason_analytics"/>
        <field name="implied_ids" eval="[(4, ref('mrp.group_mrp_user'))]"/>

    </record>
    <record id="group_scrap_reason_analytics_manager" model="res.groups">
        <field name="name">Scrap Reason Analytics Manager</field>
        <field name="category_id" ref="module_category_scrap_reason_analytics"/>
        <field name="implied_ids" eval="[(4, ref('group_scrap_reason_analytics_user'))]"/>
    </record>
    <record id="rule_scrap_reason_analytics_sf_scrap_reason" model="ir.rule">
        <field name="name">Scrap Record: multi-company</field>
        <field name="model_id" ref="model_sf_scrap_reason"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
