<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_iatf" model="ir.module.category">
        <field name="name">IATF 16949 Quality Toolkit</field>
        <field name="sequence">97</field>
    </record>

    <record id="group_iatf_quality_user" model="res.groups">
        <field name="name">IATF Quality User</field>
        <field name="category_id" ref="module_category_iatf"/>
        <field name="implied_ids" eval="[(4, ref('quality.group_quality_user'))]"/>
    </record>

    <record id="group_iatf_quality_engineer" model="res.groups">
        <field name="name">IATF Quality Engineer</field>
        <field name="category_id" ref="module_category_iatf"/>
        <field name="implied_ids" eval="[(4, ref('group_iatf_quality_user'))]"/>
    </record>

    <record id="group_iatf_quality_manager" model="res.groups">
        <field name="name">IATF Quality Manager</field>
        <field name="category_id" ref="module_category_iatf"/>
        <field name="implied_ids" eval="[(4, ref('group_iatf_quality_engineer'))]"/>
    </record>

    <record id="group_iatf_apqp_lead" model="res.groups">
        <field name="name">IATF APQP Project Lead</field>
        <field name="category_id" ref="module_category_iatf"/>
        <field name="implied_ids" eval="[(4, ref('group_iatf_quality_engineer'))]"/>
    </record>

    <record id="group_iatf_ppap_approver" model="res.groups">
        <field name="name">IATF PPAP Approver</field>
        <field name="category_id" ref="module_category_iatf"/>
        <field name="implied_ids" eval="[(4, ref('group_iatf_quality_engineer'))]"/>
    </record>

    <!-- Record Rules for Multi-Company -->
    <record id="rule_iatf_fmea_company" model="ir.rule">
        <field name="name">IATF FMEA: Multi-company</field>
        <field name="model_id" ref="model_iatf_fmea"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_iatf_quality_user'))]"/>
    </record>

    <record id="rule_iatf_control_plan_company" model="ir.rule">
        <field name="name">IATF Control Plan: Multi-company</field>
        <field name="model_id" ref="model_iatf_control_plan"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_iatf_quality_user'))]"/>
    </record>

    <record id="rule_iatf_apqp_project_company" model="ir.rule">
        <field name="name">IATF APQP Project: Multi-company</field>
        <field name="model_id" ref="model_iatf_apqp_project"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_iatf_quality_user'))]"/>
    </record>

    <record id="rule_iatf_ppap_submission_company" model="ir.rule">
        <field name="name">IATF PPAP Submission: Multi-company</field>
        <field name="model_id" ref="model_iatf_ppap_submission"/>
        <field name="domain_force">['|', ('company_id', 'in', company_ids), ('customer_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_iatf_quality_user'))]"/>
    </record>

    <record id="rule_iatf_msa_study_company" model="ir.rule">
        <field name="name">IATF MSA Study: Multi-company</field>
        <field name="model_id" ref="model_iatf_msa_study"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_iatf_quality_user'))]"/>
    </record>

    <record id="rule_iatf_spc_chart_company" model="ir.rule">
        <field name="name">IATF SPC Chart: Multi-company</field>
        <field name="model_id" ref="model_iatf_spc_chart"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_iatf_quality_user'))]"/>
    </record>

    <record id="rule_iatf_process_company" model="ir.rule">
        <field name="name">IATF Process: Multi-company</field>
        <field name="model_id" ref="model_iatf_process"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_iatf_quality_user'))]"/>
    </record>
</odoo>