<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- SPC Chart Form View -->
    <record id="view_iatf_spc_chart_form" model="ir.ui.view">
        <field name="name">iatf.spc.chart.form</field>
        <field name="model">iatf.spc.chart</field>
        <field name="arch" type="xml">
            <form string="SPC Control Chart">
                <header>
                    <button name="action_calculate_limits" type="object" string="Calculate Limits" class="btn-primary"/>
                    <button name="action_check_rules" type="object" string="Check Rules" class="btn-secondary"/>
                    <field name="state" widget="statusbar" invisible="1"/>  <!-- No state field on chart -->
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button type="object" name="action_calculate_limits" class="oe_stat_button" icon="fa-chart-line">
                            <field name="measurement_ids" widget="statinfo" string="Measurements"/>
                        </button>
                        <button type="object" name="action_check_rules" class="oe_stat_button" icon="fa-exclamation-triangle"
                                invisible="not alert_ids">
                            <field name="alert_ids" widget="statinfo" string="Open Alerts"
                                   options="{'domain': [('state', 'in', ('new','acknowledged','investigating'))]}"/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="chart_number" readonly="1"/>
                            <field name="name"/>
                            <field name="product_id"/>
                            <field name="characteristic_name"/>
                            <field name="characteristic_type" readonly="1"/>
                        </group>
                        <group>
                            <field name="chart_type"/>
                            <field name="subgroup_size" attrs="{'invisible': [('chart_type', '=', 'imr')]}"/>
                            <field name="frequency"/>
                            <field name="equipment_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group string="Specification Limits">
                        <field name="spec_usl"/>
                        <field name="spec_lsl"/>
                        <field name="spec_target"/>
                    </group>
                    <group string="Calculated Control Limits" attrs="{'invisible': [('state', 'in', ('draft','in_progress'))]}">
                        <group>
                            <field name="ucl" readonly="1" string="UCL (X-bar)"/>
                            <field name="lcl" readonly="1" string="LCL (X-bar)"/>
                            <field name="cl" readonly="1" string="CL (X-bar)"/>
                        </group>
                        <group>
                            <field name="ucl_attr" readonly="1" string="UCL (R/S)"/>
                            <field name="lcl_attr" readonly="1" string="LCL (R/S)"/>
                            <field name="cl_attr" readonly="1" string="CL (R/S)"/>
                        </group>
                    </group>
                    <group string="Process Capability" attrs="{'invisible': [('spec_usl', '=', False), ('spec_lsl', '=', False)]}">
                        <field name="cp" readonly="1" optional="hide"/>
                        <field name="cpk" readonly="1" optional="hide"/>
                        <field name="pp" readonly="1" optional="hide"/>
                        <field name="ppk" readonly="1" optional="hide"/>
                    </group>
                    <group string="IoT Integration">
                        <field name="iot_enabled"/>
                        <field name="iot_topic" attrs="{'invisible': [('iot_enabled', '=', False)]}"/>
                    </group>
                    <notebook>
                        <page string="Measurements" name="measurements">
                            <field name="measurement_ids">
                                <list editable="bottom" create="1" delete="1">
                                    <field name="datetime"/>
                                    <field name="subgroup_index"/>
                                    <field name="value"/>
                                    <field name="subgroup_mean" readonly="1"/>
                                    <field name="subgroup_range" readonly="1"/>
                                    <field name="subgroup_std" readonly="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Alerts / OOC Signals" name="alerts">
                            <field name="alert_ids" domain="[('state', 'in', ('new','acknowledged','investigating'))]">
                                <list create="0" delete="0">
                                    <field name="measurement_id"/>
                                    <field name="rule_number"/>
                                    <field name="description"/>
                                    <field name="state" widget="selection"/>
                                    <field name="acknowledged_by_id" readonly="1"/>
                                    <field name="acknowledged_date" readonly="1"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- SPC Chart List View -->
    <record id="view_iatf_spc_chart_list" model="ir.ui.view">
        <field name="name">iatf.spc.chart.list</field>
        <field name="model">iatf.spc.chart</field>
        <field name="arch" type="xml">
            <list string="SPC Charts" sample="1">
                <field name="chart_number"/>
                <field name="name"/>
                <field name="product_id"/>
                <field name="characteristic_name"/>
                <field name="chart_type"/>
                <field name="cp" optional="hide"/>
                <field name="cpk" optional="hide"/>
                <field name="measurement_ids" widget="statinfo" string="Count"/>
                <field name="alert_ids" widget="statinfo" string="Alerts"
                       options="{'domain': [('state', 'in', ('new','acknowledged','investigating'))]}"/>
                <field name="iot_enabled" widget="boolean"/>
            </list>
        </field>
    </record>

    <!-- SPC Chart Kanban View -->
    <record id="view_iatf_spc_chart_kanban" model="ir.ui.view">
        <field name="name">iatf.spc.chart.kanban</field>
        <field name="model">iatf.spc.chart</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_view">
                <field name="chart_number"/>
                <field name="name"/>
                <field name="product_id"/>
                <field name="characteristic_name"/>
                <field name="chart_type"/>
                <field name="cp"/>
                <field name="cpk"/>
                <field name="iot_enabled"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_header">
                                <span class="oe_kanban_label"><t t-esc="record.chart_number"/>: <t t-esc="record.name"/></span>
                                <field name="iot_enabled" widget="boolean"
                                       options="{'terminology': {'on': 'IoT', 'off': 'Manual'}}"/>
                            </div>
                            <div class="oe_kanban_details">
                                <field name="product_id"/> — <t t-esc="record.characteristic_name"/>
                                <br/>Type: <field name="chart_type"/> | n=<field name="subgroup_size"/>
                                <br/>Cp: <field name="cp"/> | Cpk: <field name="cpk"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- SPC Alert Form View -->
    <record id="view_iatf_spc_alert_form" model="ir.ui.view">
        <field name="name">iatf.spc.alert.form</field>
        <field name="model">iatf.spc.alert</field>
        <field name="arch" type="xml">
            <form string="SPC Alert">
                <header>
                    <button name="action_acknowledge" type="object" string="Acknowledge" class="btn-primary" invisible="state != 'new'"/>
                    <button name="action_resolve" type="object" string="Resolve" class="btn-success" invisible="state not in ('acknowledged','investigating')"/>
                    <button name="action_false_alarm" type="object" string="False Alarm" class="btn-secondary" invisible="state != 'new'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="new,acknowledged,investigating,resolved,false_alarm"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="chart_id" readonly="1"/>
                            <field name="measurement_id" readonly="1"/>
                            <field name="rule_number" readonly="1"/>
                        </group>
                        <group>
                            <field name="state" readonly="1" widget="selection"/>
                            <field name="acknowledged_by_id" readonly="1"/>
                            <field name="acknowledged_date" readonly="1"/>
                        </group>
                    </group>
                    <group string="Description">
                        <field name="description" readonly="1"/>
                    </group>
                    <group string="Resolution" attrs="{'invisible': [('state', 'in', ('new','acknowledged'))]}">
                        <field name="resolved_by_id" readonly="1"/>
                        <field name="resolved_date" readonly="1"/>
                        <field name="resolution_notes"/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
</odoo>