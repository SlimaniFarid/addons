<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- MSA Study Form View -->
    <record id="view_iatf_msa_study_form" model="ir.ui.view">
        <field name="name">iatf.msa.study.form</field>
        <field name="model">iatf.msa.study</field>
        <field name="arch" type="xml">
            <form string="MSA / Gauge R&amp;R Study">
                <header>
                    <button name="action_start_collection" type="object" string="Start Data Collection" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_calculate" type="object" string="Calculate Results" class="btn-primary" invisible="state != 'in_progress'"/>
                    <button name="action_accept" type="object" string="Accept" class="btn-success" invisible="state != 'complete'"/>
                    <button name="action_reject" type="object" string="Reject" class="btn-danger" invisible="state != 'complete'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,in_progress,calculating,complete,accepted,rejected"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <field name="conclusion" widget="statinfo" string="Conclusion"
                               options="{'decoration-danger': 'unacceptable', 'decoration-warning': 'marginal', 'decoration-success': 'acceptable'}"/>
                    </div>
                    <group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="study_type" readonly="state != 'draft'"/>
                            <field name="characteristic_name" readonly="state != 'draft'"/>
                            <field name="specification" readonly="state != 'draft'"/>
                            <field name="spec_usl" readonly="state != 'draft'"/>
                            <field name="spec_lsl" readonly="state != 'draft'"/>
                            <field name="spec_target" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="equipment_id" readonly="state != 'draft'"/>
                            <field name="equipment_calibration_date" readonly="1"/>
                            <field name="trial_count" readonly="state != 'draft'"/>
                        </group>
                    </group>
                    <group string="Study Design">
                        <field name="part_ids" widget="many2many_tags" readonly="state != 'draft'"/>
                        <field name="operator_ids" widget="many2many_tags" readonly="state != 'draft'"/>
                    </group>
                    <group string="GRR Results (ANOVA)" attrs="{'invisible': [('state', 'in', ('draft','in_progress'))]}">
                        <group>
                            <field name="grr_percent" readonly="1" string="%GRR (TV)"/>
                            <field name="grr_percent_tolerance" readonly="1" string="%GRR (Tol)"/>
                            <field name="ndc" readonly="1"/>
                            <field name="conclusion" readonly="1" widget="selection"/>
                        </group>
                        <group>
                            <field name="pv_percent" readonly="1" string="%PV"/>
                            <field name="ev_percent" readonly="1" string="%EV (Repeatability)"/>
                            <field name="av_percent" readonly="1" string="%AV (Reproducibility)"/>
                        </group>
                        <group>
                            <field name="cp" readonly="1"/>
                            <field name="cpk" readonly="1"/>
                        </group>
                    </group>
                    <group string="ANOVA p-values" attrs="{'invisible': [('study_type', '!=', 'crossed'), ('state', 'in', ('draft','in_progress'))]}">
                        <field name="anova_p_value_part" readonly="1" string="Part p-value"/>
                        <field name="anova_p_value_operator" readonly="1" string="Operator p-value"/>
                        <field name="anova_p_value_interaction" readonly="1" string="Interaction p-value"/>
                    </group>
                    <notebook>
                        <page string="Measurements" name="measurements">
                            <field name="measurement_ids">
                                <list editable="bottom" create="state == 'in_progress'" delete="state == 'in_progress'">
                                    <field name="part_id"/>
                                    <field name="operator_id"/>
                                    <field name="trial"/>
                                    <field name="value"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- MSA Study List View -->
    <record id="view_iatf_msa_study_list" model="ir.ui.view">
        <field name="name">iatf.msa.study.list</field>
        <field name="model">iatf.msa.study</field>
        <field name="arch" type="xml">
            <list string="MSA Studies" sample="1">
                <field name="name"/>
                <field name="study_type"/>
                <field name="characteristic_name"/>
                <field name="equipment_id"/>
                <field name="grr_percent" readonly="1" optional="hide"/>
                <field name="ndc" readonly="1" optional="hide"/>
                <field name="conclusion" readonly="1" widget="badge"
                       decoration-danger="conclusion == 'unacceptable'"
                       decoration-warning="conclusion == 'marginal'"
                       decoration-success="conclusion == 'acceptable'"/>
                <field name="state" widget="badge"
                       decoration-danger="state == 'rejected'"
                       decoration-success="state == 'accepted'"
                       decoration-info="state == 'complete'"
                       decoration-warning="state == 'in_progress'"
                       decoration-muted="state == 'draft'"/>
                <field name="create_date"/>
            </list>
        </field>
    </record>

    <!-- MSA Study Kanban View -->
    <record id="view_iatf_msa_study_kanban" model="ir.ui.view">
        <field name="name">iatf.msa.study.kanban</field>
        <field name="model">iatf.msa.study</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_view">
                <field name="name"/>
                <field name="study_type"/>
                <field name="characteristic_name"/>
                <field name="equipment_id"/>
                <field name="grr_percent"/>
                <field name="ndc"/>
                <field name="conclusion"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_header">
                                <span class="oe_kanban_label"><t t-esc="record.name"/></span>
                                <field name="state" widget="badge"
                                       decoration-danger="state == 'rejected'"
                                       decoration-success="state == 'accepted'"
                                       decoration-info="state == 'complete'"
                                       decoration-warning="state == 'in_progress'"
                                       decoration-muted="state == 'draft'"/>
                            </div>
                            <div class="oe_kanban_details">
                                <field name="study_type"/> — <t t-esc="record.characteristic_name"/>
                                <br/>Equipment: <field name="equipment_id"/>
                                <br/>%GRR: <field name="grr_percent"/>% | ndc: <field name="ndc"/>
                                <br/>Conclusion: <field name="conclusion" widget="badge"
                                       decoration-danger="conclusion == 'unacceptable'"
                                       decoration-warning="conclusion == 'marginal'"
                                       decoration-success="conclusion == 'acceptable'"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
</odoo>