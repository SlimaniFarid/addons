<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- APQP Project Form View -->
    <record id="view_iatf_apqp_project_form" model="ir.ui.view">
        <field name="name">iatf.apqp.project.form</field>
        <field name="model">iatf.apqp.project</field>
        <field name="arch" type="xml">
            <form string="APQP Project">
                <header>
                    <button name="action_start" type="object" string="Start Project" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_complete_phase" type="object" string="Complete Phase" class="btn-primary"
                            invisible="state in ('draft','completed','closed')"/>
                    <button name="action_close" type="object" string="Close Project" class="btn-secondary" invisible="state != 'completed'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,active,phase1_complete,phase2_complete,phase3_complete,phase4_complete,completed,closed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button type="object" name="action_complete_phase" class="oe_stat_button" icon="fa-check-circle"
                                invisible="state in ('draft','completed','closed')">
                            <field name="element_ids" widget="statinfo" string="Elements"
                                   options="{'domain': [('phase', '=', context.get('phase_current', 'phase1'))]}"/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="project_number" readonly="1"/>
                            <field name="name"/>
                            <field name="customer_id"/>
                            <field name="product_id"/>
                            <field name="product_revision"/>
                        </group>
                        <group>
                            <field name="phase_current" readonly="1"/>
                            <field name="start_date"/>
                            <field name="target_sop_date"/>
                            <field name="actual_sop_date" readonly="1"/>
                            <field name="project_manager_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group string="Team">
                        <field name="team_member_ids" widget="many2many_tags"/>
                    </group>
                    <notebook>
                        <page string="Phase 1: Plan &amp; Define" name="phase1" attrs="{'invisible': [('phase_current', '!=', 'phase1')]}">
                            <field name="element_ids" domain="[('phase', '=', 'phase1')]">
                                <list editable="bottom" create="0" delete="0">
                                    <field name="element_number"/>
                                    <field name="name"/>
                                    <field name="status" widget="selection"/>
                                    <field name="responsible_id"/>
                                    <field name="due_date"/>
                                    <field name="completion_date" readonly="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Phase 2: Product Design" name="phase2" attrs="{'invisible': [('phase_current', '!=', 'phase2')]}">
                            <field name="element_ids" domain="[('phase', '=', 'phase2')]">
                                <list editable="bottom" create="0" delete="0">
                                    <field name="element_number"/>
                                    <field name="name"/>
                                    <field name="status" widget="selection"/>
                                    <field name="responsible_id"/>
                                    <field name="due_date"/>
                                    <field name="completion_date" readonly="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Phase 3: Process Design" name="phase3" attrs="{'invisible': [('phase_current', '!=', 'phase3')]}">
                            <field name="element_ids" domain="[('phase', '=', 'phase3')]">
                                <list editable="bottom" create="0" delete="0">
                                    <field name="element_number"/>
                                    <field name="name"/>
                                    <field name="status" widget="selection"/>
                                    <field name="responsible_id"/>
                                    <field name="due_date"/>
                                    <field name="completion_date" readonly="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Phase 4: Validation" name="phase4" attrs="{'invisible': [('phase_current', '!=', 'phase4')]}">
                            <field name="element_ids" domain="[('phase', '=', 'phase4')]">
                                <list editable="bottom" create="0" delete="0">
                                    <field name="element_number"/>
                                    <field name="name"/>
                                    <field name="status" widget="selection"/>
                                    <field name="responsible_id"/>
                                    <field name="due_date"/>
                                    <field name="completion_date" readonly="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Phase 5: Production" name="phase5" attrs="{'invisible': [('phase_current', '!=', 'phase5')]}">
                            <field name="element_ids" domain="[('phase', '=', 'phase5')]">
                                <list editable="bottom" create="0" delete="0">
                                    <field name="element_number"/>
                                    <field name="name"/>
                                    <field name="status" widget="selection"/>
                                    <field name="responsible_id"/>
                                    <field name="due_date"/>
                                    <field name="completion_date" readonly="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="All Elements" name="all_elements">
                            <field name="element_ids">
                                <list editable="bottom" create="0" delete="0">
                                    <field name="phase" widget="selection"/>
                                    <field name="element_number"/>
                                    <field name="name"/>
                                    <field name="status" widget="selection"/>
                                    <field name="responsible_id"/>
                                    <field name="due_date"/>
                                    <field name="completion_date" readonly="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Linked Records" name="linked">
                            <group>
                                <group string="FMEA">
                                    <field name="dfmea_id"/>
                                    <field name="pfmea_id"/>
                                </group>
                                <group string="Control Plans &amp; PPAP">
                                    <field name="control_plan_ids" domain="[('phase', '=', 'production')]">
                                        <list create="0" delete="0">
                                            <field name="name"/>
                                            <field name="phase"/>
                                            <field name="state"/>
                                        </list>
                                    </field>
                                    <field name="ppap_submission_id"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- APQP Project List View -->
    <record id="view_iatf_apqp_project_list" model="ir.ui.view">
        <field name="name">iatf.apqp.project.list</field>
        <field name="model">iatf.apqp.project</field>
        <field name="arch" type="xml">
            <list string="APQP Projects" sample="1">
                <field name="project_number"/>
                <field name="name"/>
                <field name="customer_id"/>
                <field name="product_id"/>
                <field name="phase_current" widget="selection"/>
                <field name="state" widget="badge"
                       decoration-danger="state == 'closed'"
                       decoration-success="state == 'completed'"
                       decoration-info="state in ('phase1_complete','phase2_complete','phase3_complete','phase4_complete')"
                       decoration-warning="state == 'active'"
                       decoration-muted="state == 'draft'"/>
                <field name="target_sop_date"/>
                <field name="project_manager_id"/>
            </list>
        </field>
    </record>

    <!-- APQP Project Kanban View -->
    <record id="view_iatf_apqp_project_kanban" model="ir.ui.view">
        <field name="name">iatf.apqp.project.kanban</field>
        <field name="model">iatf.apqp.project</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_view" group_by="phase_current">
                <field name="project_number"/>
                <field name="name"/>
                <field name="customer_id"/>
                <field name="product_id"/>
                <field name="phase_current"/>
                <field name="state"/>
                <field name="target_sop_date"/>
                <field name="project_manager_id"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_header">
                                <span class="oe_kanban_label"><t t-esc="record.project_number"/>: <t t-esc="record.name"/></span>
                                <field name="state" widget="badge"
                                       decoration-danger="state == 'closed'"
                                       decoration-success="state == 'completed'"
                                       decoration-info="state in ('phase1_complete','phase2_complete','phase3_complete','phase4_complete')"
                                       decoration-warning="state == 'active'"
                                       decoration-muted="state == 'draft'"/>
                            </div>
                            <div class="oe_kanban_details">
                                <field name="customer_id"/>
                                <br/><field name="product_id"/>
                                <br/>Phase: <field name="phase_current"/>
                                <br/>SOP: <field name="target_sop_date"/>
                                <br/><field name="project_manager_id"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- APQP Gantt View (using project.task style) -->
    <record id="view_iatf_apqp_project_gantt" model="ir.ui.view">
        <field name="name">iatf.apqp.project.gantt</field>
        <field name="model">iatf.apqp.project</field>
        <field name="arch" type="xml">
            <gantt string="APQP Timeline" date_start="start_date" date_stop="target_sop_date"
                   default_group_by="phase_current" precision="month">
                <field name="name"/>
                <field name="customer_id"/>
                <field name="product_id"/>
                <field name="phase_current"/>
            </gantt>
        </field>
    </record>

    <!-- APQP Element Form View -->
    <record id="view_iatf_apqp_element_form" model="ir.ui.view">
        <field name="name">iatf.apqp.element.form</field>
        <field name="model">iatf.apqp.element</field>
        <field name="arch" type="xml">
            <form string="APQP Element">
                <header>
                    <field name="status" widget="statusbar"
                           statusbar_visible="not_started,in_progress,complete,na"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="project_id" readonly="1"/>
                            <field name="phase" readonly="1" widget="selection"/>
                            <field name="element_number" readonly="1"/>
                            <field name="name" readonly="1"/>
                            <field name="responsible_id"/>
                            <field name="due_date"/>
                            <field name="completion_date" readonly="1"/>
                        </group>
                        <group>
                            <field name="status" widget="selection"/>
                        </group>
                    </group>
                    <group string="Description / Requirements">
                        <field name="description"/>
                    </group>
                    <group string="Evidence &amp; Attachments">
                        <field name="attachment_ids" widget="many2many_tags"/>
                    </group>
                    <group string="Linked Records (Traceability)">
                        <field name="linked_dfmea_id"/>
                        <field name="linked_pfmea_id"/>
                        <field name="linked_cp_id"/>
                        <field name="linked_ppap_id"/>
                        <field name="linked_msa_id"/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="wave_final_sf_iatf_quality_suite" model="ir.actions.server">
        <field name="name">Refresh Business Data</field>
        <field name="model_id" ref="model_iatf_apqp_project"/>
        <field name="binding_model_id" ref="model_iatf_apqp_project"/>
        <field name="state">code</field>
        <field name="code">records.action_refresh_business()</field>
    </record>
</odoo>