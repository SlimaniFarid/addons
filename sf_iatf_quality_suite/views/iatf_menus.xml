<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Actions -->
    <record id="action_iatf_fmea" model="ir.actions.act_window">
        <field name="name">FMEA (DFMEA / PFMEA)</field>
        <field name="res_model">iatf.fmea</field>
        <field name="view_mode">list,form,kanban,pivot</field>
        <field name="context">{'search_default_group_by_state': 1}</field>
    </record>
    <record id="action_iatf_control_plan" model="ir.actions.act_window">
        <field name="name">Control Plans</field>
        <field name="res_model">iatf.control.plan</field>
        <field name="view_mode">list,form,kanban</field>
        <field name="context">{'search_default_group_by_phase': 1}</field>
    </record>
    <record id="action_iatf_apqp_project" model="ir.actions.act_window">
        <field name="name">APQP Projects</field>
        <field name="res_model">iatf.apqp.project</field>
        <field name="view_mode">list,form,kanban,gantt</field>
    </record>
    <record id="action_iatf_ppap_submission" model="ir.actions.act_window">
        <field name="name">PPAP Submissions</field>
        <field name="res_model">iatf.ppap.submission</field>
        <field name="view_mode">list,form,kanban</field>
        <field name="context">{'search_default_group_by_state': 1}</field>
    </record>
    <record id="action_iatf_msa_study" model="ir.actions.act_window">
        <field name="name">MSA / Gauge R&amp;R Studies</field>
        <field name="res_model">iatf.msa.study</field>
        <field name="view_mode">list,form,kanban</field>
        <field name="context">{'search_default_group_by_status': 1}</field>
    </record>
    <record id="action_iatf_spc_chart" model="ir.actions.act_window">
        <field name="name">SPC Control Charts</field>
        <field name="res_model">iatf.spc.chart</field>
        <field name="view_mode">list,form,kanban</field>
        <field name="context">{'search_default_group_by_chart_type': 1}</field>
    </record>
    <record id="action_iatf_process" model="ir.actions.act_window">
        <field name="name">Processes</field>
        <field name="res_model">iatf.process</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_iatf_quality_dashboard" model="ir.actions.client">
        <field name="name">IATF Quality Dashboard</field>
        <field name="tag">iatf_quality_dashboard</field>
    </record>

    <!-- Menu Structure -->
    <menuitem id="menu_iatf_root" name="IATF 16949 Toolkit" sequence="47"
              web_icon="sf_iatf_quality_suite,static/description/icon.png"/>
    <menuitem id="menu_iatf_fmea" name="FMEA" parent="menu_iatf_root"
              action="action_iatf_fmea" sequence="10"/>
    <menuitem id="menu_iatf_control_plan" name="Control Plans" parent="menu_iatf_root"
              action="action_iatf_control_plan" sequence="20"/>
    <menuitem id="menu_iatf_apqp" name="APQP Projects" parent="menu_iatf_root"
              action="action_iatf_apqp_project" sequence="30"/>
    <menuitem id="menu_iatf_ppap" name="PPAP Submissions" parent="menu_iatf_root"
              action="action_iatf_ppap_submission" sequence="40"/>
    <menuitem id="menu_iatf_msa" name="MSA / Gauge R&amp;R" parent="menu_iatf_root"
              action="action_iatf_msa_study" sequence="50"/>
    <menuitem id="menu_iatf_spc" name="SPC Charts" parent="menu_iatf_root"
              action="action_iatf_spc_chart" sequence="60"/>
    <menuitem id="menu_iatf_dashboard" name="Dashboard" parent="menu_iatf_root"
              action="action_iatf_quality_dashboard" sequence="5"/>
    <menuitem id="menu_iatf_config" name="Configuration" parent="menu_iatf_root" sequence="90">
        <menuitem id="menu_iatf_processes" name="Processes" parent="menu_iatf_config"
                  action="action_iatf_process" sequence="10"/>
    </menuitem>
</odoo>