<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_sf_donation_campaign" model="ir.sequence">
            <field name="name">Donation Campaign</field>
            <field name="code">sf.donation.campaign</field>
            <field name="prefix">DON-</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>

        <record id="seq_sf_donation_promise" model="ir.sequence">
            <field name="name">Donation Promise</field>
            <field name="code">sf.donation.promise</field>
            <field name="prefix">PRM-</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>

        <record id="seq_sf_donation_payment" model="ir.sequence">
            <field name="name">Donation Payment</field>
            <field name="code">sf.donation.payment</field>
            <field name="prefix">PAY-</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>

        <record id="seq_sf_donation_receipt" model="ir.sequence">
            <field name="name">Donation Receipt</field>
            <field name="code">sf.donation.receipt</field>
            <field name="prefix">RCP-</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>

        <record id="cron_sf_donation_reminders" model="ir.cron">
            <field name="name">Donations: Pledge Reminders</field>
            <field name="model_id" ref="model_sf_donation_promise"/>
            <field name="state">code</field>
            <field name="code">model._cron_donation_reminders()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="active">True</field>
        </record>
    </data>
</odoo>