<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_sf_donation" model="ir.module.category">
        <field name="name">Donations &amp; Charity</field>
        <field name="sequence">90</field>
    </record>

    <record id="group_sf_donation_user" model="res.groups">
        <field name="name">Donations User</field>
        <field name="category_id" ref="module_category_sf_donation"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_sf_donation_manager" model="res.groups">
        <field name="name">Donations Manager</field>
        <field name="category_id" ref="module_category_sf_donation"/>
        <field name="implied_ids" eval="[(4, ref('group_sf_donation_user'))]"/>
    </record>

    <record id="rule_sf_donation_campaign_user_company" model="ir.rule">
        <field name="name">Campaign: user sees own company</field>
        <field name="model_id" ref="model_sf_donation_campaign"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_sf_donation_user'))]"/>
    </record>

    <record id="rule_sf_donation_campaign_manager_all" model="ir.rule">
        <field name="name">Campaign: manager sees all companies</field>
        <field name="model_id" ref="model_sf_donation_campaign"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_sf_donation_manager'))]"/>
    </record>

    <record id="rule_sf_donation_promise_user_company" model="ir.rule">
        <field name="name">Promise: user sees own company</field>
        <field name="model_id" ref="model_sf_donation_promise"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_sf_donation_user'))]"/>
    </record>

    <record id="rule_sf_donation_promise_manager_all" model="ir.rule">
        <field name="name">Promise: manager sees all companies</field>
        <field name="model_id" ref="model_sf_donation_promise"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_sf_donation_manager'))]"/>
    </record>

    <record id="rule_sf_donation_payment_user_company" model="ir.rule">
        <field name="name">Payment: user sees own company</field>
        <field name="model_id" ref="model_sf_donation_payment"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_sf_donation_user'))]"/>
    </record>

    <record id="rule_sf_donation_payment_manager_all" model="ir.rule">
        <field name="name">Payment: manager sees all companies</field>
        <field name="model_id" ref="model_sf_donation_payment"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_sf_donation_manager'))]"/>
    </record>

    <record id="rule_sf_donation_receipt_user_company" model="ir.rule">
        <field name="name">Receipt: user sees own company</field>
        <field name="model_id" ref="model_sf_donation_receipt"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_sf_donation_user'))]"/>
    </record>

    <record id="rule_sf_donation_receipt_manager_all" model="ir.rule">
        <field name="name">Receipt: manager sees all companies</field>
        <field name="model_id" ref="model_sf_donation_receipt"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_sf_donation_manager'))]"/>
    </record>
</odoo>