<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sf_donation_campaign_tree" model="ir.ui.view">
        <field name="name">sf.donation.campaign.tree</field>
        <field name="model">sf.donation.campaign</field>
        <field name="arch" type="xml">
            <tree string="Donation Campaigns">
                <field name="name"/>
                <field name="title"/>
                <field name="target_amount"/>
                <field name="collected_amount"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <record id="view_sf_donation_campaign_form" model="ir.ui.view">
        <field name="name">sf.donation.campaign.form</field>
        <field name="model">sf.donation.campaign</field>
        <field name="arch" type="xml">
            <form string="Donation Campaign">
                <header>
                    <button name="action_activate" type="object"
                            string="Activate" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_close" type="object"
                            string="Close" class="btn-success"
                            invisible="state != 'active'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="title"/>
                            <field name="target_amount"/>
                        </group>
                        <group>
                            <field name="start_date"/>
                            <field name="end_date"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="collected_amount"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Promises">
                            <field name="promise_ids">
                                <tree string="Promises">
                                    <field name="name"/>
                                    <field name="donor"/>
                                    <field name="amount"/>
                                    <field name="paid_amount"/>
                                    <field name="pledge_date"/>
                                    <field name="frequency"/>
                                    <field name="state"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Payments">
                            <field name="payment_ids" readonly="1">
                                <tree string="Payments">
                                    <field name="name"/>
                                    <field name="donor"/>
                                    <field name="amount"/>
                                    <field name="payment_date"/>
                                    <field name="method"/>
                                    <field name="state"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_sf_donation_campaign_search" model="ir.ui.view">
        <field name="name">sf.donation.campaign.search</field>
        <field name="model">sf.donation.campaign</field>
        <field name="arch" type="xml">
            <search string="Donation Campaigns">
                <field name="title"/>
                <field name="name"/>
                <filter string="Active" name="active_campaign"
                        domain="[('state', '=', 'active')]"/>
                <filter string="Closed" name="closed_campaign"
                        domain="[('state', '=', 'closed')]"/>
                <group expand="0" string="Group By">
                    <filter string="Status" name="state_group"
                            context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_sf_donation_campaign" model="ir.actions.act_window">
        <field name="name">Campaigns</field>
        <field name="res_model">sf.donation.campaign</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_sf_donation_campaign_search"/>
    </record>

    <record id="view_sf_donation_promise_tree" model="ir.ui.view">
        <field name="name">sf.donation.promise.tree</field>
        <field name="model">sf.donation.promise</field>
        <field name="arch" type="xml">
            <tree string="Donation Promises">
                <field name="name"/>
                <field name="campaign_id"/>
                <field name="donor"/>
                <field name="amount"/>
                <field name="paid_amount"/>
                <field name="pledge_date"/>
                <field name="frequency"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <record id="view_sf_donation_promise_form" model="ir.ui.view">
        <field name="name">sf.donation.promise.form</field>
        <field name="model">sf.donation.promise</field>
        <field name="arch" type="xml">
            <form string="Donation Promise">
                <header>
                    <button name="action_confirm" type="object"
                            string="Confirm" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_cancel" type="object"
                            string="Cancel" class="btn-danger"
                            invisible="state not in ('draft', 'pending')"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="campaign_id"/>
                            <field name="donor"/>
                            <field name="partner_id"/>
                        </group>
                        <group>
                            <field name="amount"/>
                            <field name="pledge_date"/>
                            <field name="frequency"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="paid_amount"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Payments">
                            <field name="payment_ids" readonly="1">
                                <tree string="Payments">
                                    <field name="name"/>
                                    <field name="donor"/>
                                    <field name="amount"/>
                                    <field name="payment_date"/>
                                    <field name="method"/>
                                    <field name="state"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_sf_donation_promise_search" model="ir.ui.view">
        <field name="name">sf.donation.promise.search</field>
        <field name="model">sf.donation.promise</field>
        <field name="arch" type="xml">
            <search string="Donation Promises">
                <field name="donor"/>
                <field name="campaign_id"/>
                <field name="name"/>
                <filter string="Pending" name="pending_promise"
                        domain="[('state', '=', 'pending')]"/>
                <filter string="Paid" name="paid_promise"
                        domain="[('state', '=', 'paid')]"/>
                <group expand="0" string="Group By">
                    <filter string="Status" name="state_group"
                            context="{'group_by': 'state'}"/>
                    <filter string="Campaign" name="campaign_group"
                            context="{'group_by': 'campaign_id'}"/>
                    <filter string="Frequency" name="frequency_group"
                            context="{'group_by': 'frequency'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_sf_donation_promise" model="ir.actions.act_window">
        <field name="name">Promises</field>
        <field name="res_model">sf.donation.promise</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_sf_donation_promise_search"/>
    </record>

    <record id="view_sf_donation_payment_tree" model="ir.ui.view">
        <field name="name">sf.donation.payment.tree</field>
        <field name="model">sf.donation.payment</field>
        <field name="arch" type="xml">
            <tree string="Donation Payments">
                <field name="name"/>
                <field name="promise_id"/>
                <field name="donor"/>
                <field name="amount"/>
                <field name="payment_date"/>
                <field name="method"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <record id="view_sf_donation_payment_form" model="ir.ui.view">
        <field name="name">sf.donation.payment.form</field>
        <field name="model">sf.donation.payment</field>
        <field name="arch" type="xml">
            <form string="Donation Payment">
                <header>
                    <button name="action_receive" type="object"
                            string="Mark Received" class="btn-primary"
                            invisible="state != 'draft'"
                            groups="sf_donations.group_sf_donation_manager"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="promise_id"/>
                            <field name="donor"/>
                            <field name="partner_id"/>
                        </group>
                        <group>
                            <field name="amount"/>
                            <field name="payment_date"/>
                            <field name="method"/>
                            <field name="campaign_id" readonly="1"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_sf_donation_payment_search" model="ir.ui.view">
        <field name="name">sf.donation.payment.search</field>
        <field name="model">sf.donation.payment</field>
        <field name="arch" type="xml">
            <search string="Donation Payments">
                <field name="donor"/>
                <field name="promise_id"/>
                <field name="name"/>
                <filter string="Received" name="received_payment"
                        domain="[('state', '=', 'received')]"/>
                <group expand="0" string="Group By">
                    <filter string="Status" name="state_group"
                            context="{'group_by': 'state'}"/>
                    <filter string="Method" name="method_group"
                            context="{'group_by': 'method'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_sf_donation_payment" model="ir.actions.act_window">
        <field name="name">Payments</field>
        <field name="res_model">sf.donation.payment</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_sf_donation_payment_search"/>
    </record>

    <record id="view_sf_donation_receipt_tree" model="ir.ui.view">
        <field name="name">sf.donation.receipt.tree</field>
        <field name="model">sf.donation.receipt</field>
        <field name="arch" type="xml">
            <tree string="Fiscal Receipts">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="donor"/>
                <field name="amount"/>
                <field name="receipt_date"/>
                <field name="fiscal_ref"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <record id="view_sf_donation_receipt_form" model="ir.ui.view">
        <field name="name">sf.donation.receipt.form</field>
        <field name="model">sf.donation.receipt</field>
        <field name="arch" type="xml">
            <form string="Fiscal Receipt">
                <header>
                    <button name="action_issue" type="object"
                            string="Issue" class="btn-primary"
                            invisible="state != 'draft'"
                            groups="sf_donations.group_sf_donation_manager"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="partner_id"/>
                            <field name="donor"/>
                            <field name="payment_id"/>
                        </group>
                        <group>
                            <field name="amount"/>
                            <field name="receipt_date"/>
                            <field name="fiscal_ref"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_sf_donation_receipt_search" model="ir.ui.view">
        <field name="name">sf.donation.receipt.search</field>
        <field name="model">sf.donation.receipt</field>
        <field name="arch" type="xml">
            <search string="Fiscal Receipts">
                <field name="donor"/>
                <field name="partner_id"/>
                <field name="fiscal_ref"/>
                <filter string="Issued" name="issued_receipt"
                        domain="[('state', '=', 'issued')]"/>
                <group expand="0" string="Group By">
                    <filter string="Status" name="state_group"
                            context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_sf_donation_receipt" model="ir.actions.act_window">
        <field name="name">Fiscal Receipts</field>
        <field name="res_model">sf.donation.receipt</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_sf_donation_receipt_search"/>
    </record>
</odoo>