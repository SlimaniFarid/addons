<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sale_auto_rule" model="ir.actions.act_window">
        <field name="name">Auto Workflow Rules</field>
        <field name="res_model">sale.auto.rule</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_sale_auto_log" model="ir.actions.act_window">
        <field name="name">Execution Logs</field>
        <field name="res_model">sale.auto.rule.log</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_sale_auto_root" name="Sales Auto Workflow" web_icon="sf_sale_auto_workflow,static/description/icon.png"/>
    <menuitem id="menu_sale_auto_rules" name="Rules" parent="menu_sale_auto_root" action="action_sale_auto_rule" sequence="10"/>
    <menuitem id="menu_sale_auto_logs" name="Logs" parent="menu_sale_auto_root" action="action_sale_auto_log" sequence="20"/>

    <record id="view_sale_auto_rule_form" model="ir.ui.view">
        <field name="name">sale.auto.rule.form</field>
        <field name="model">sale.auto.rule</field>
        <field name="arch" type="xml">
            <form string="Auto Workflow Rule">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="sequence"/>
                        <field name="active"/>
                        <field name="condition_type"/>
                    </group>
                    <group string="Conditions">
                        <field name="payment_method_ids" widget="many2many_tags" options="{'no_create': True}"/>
                        <field name="sale_type_ids" widget="many2many_tags" options="{'no_create': True}"/>
                        <field name="partner_ids" widget="many2many_tags" options="{'no_create': True}"/>
                        <field name="partner_category_ids" widget="many2many_tags" options="{'no_create': True}"/>
                        <field name="warehouse_ids" widget="many2many_tags" options="{'no_create': True}"/>
                        <field name="user_ids" widget="many2many_tags" options="{'no_create': True}"/>
                        <field name="team_ids" widget="many2many_tags" options="{'no_create': True}"/>
                        <field name="country_ids" widget="many2many_tags" options="{'no_create': True}"/>
                        <field name="state_ids" widget="many2many_tags" options="{'no_create': True}"/>
                    </group>
                    <group string="Amount Range">
                        <field name="amount_min"/>
                        <field name="amount_max"/>
                        <field name="currency_id"/>
                    </group>
                    <group string="Actions">
                        <field name="action_confirm"/>
                        <field name="action_create_delivery"/>
                        <field name="action_validate_delivery"/>
                        <field name="action_create_invoice"/>
                        <field name="action_post_invoice"/>
                        <field name="action_send_email"/>
                        <field name="email_template_id" invisible="not action_send_email" options="{'no_create': True}"/>
                    </group>
                    <notebook>
                        <page string="Execution Logs">
                            <field name="rule_log_ids">
                                <list>
                                    <field name="order_id"/>
                                    <field name="action"/>
                                    <field name="status" widget="badge" decoration-success="status=='success'" decoration-danger="status=='error'"/>
                                    <field name="error_message"/>
                                    <field name="create_date"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_sale_auto_rule_list" model="ir.ui.view">
        <field name="name">sale.auto.rule.list</field>
        <field name="model">sale.auto.rule</field>
        <field name="arch" type="xml">
            <list string="Auto Workflow Rules">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="condition_type"/>
                <field name="active" widget="boolean"/>
            </list>
        </field>
    </record>

    <record id="view_sale_auto_log_form" model="ir.ui.view">
        <field name="name">sale.auto.rule.log.form</field>
        <field name="model">sale.auto.rule.log</field>
        <field name="arch" type="xml">
            <form string="Auto Rule Log" create="false">
                <sheet>
                    <group>
                        <field name="rule_id" readonly="1"/>
                        <field name="order_id" readonly="1"/>
                        <field name="action" readonly="1"/>
                        <field name="status" readonly="1" widget="badge" decoration-success="status=='success'" decoration-danger="status=='error'"/>
                        <field name="error_message" readonly="1"/>
                        <field name="create_date" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_sale_auto_log_list" model="ir.ui.view">
        <field name="name">sale.auto.rule.log.list</field>
        <field name="model">sale.auto.rule.log</field>
        <field name="arch" type="xml">
            <list string="Auto Rule Logs">
                <field name="create_date"/>
                <field name="rule_id"/>
                <field name="order_id"/>
                <field name="action"/>
                <field name="status" widget="badge" decoration-success="status=='success'" decoration-danger="status=='error'"/>
            </list>
        </field>
    </record>
</odoo>
