<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_sf_sale_auto_workflow" model="ir.module.category">
        <field name="name">Sale Auto Workflow</field>
        <field name="description">Sale Auto Workflow Management</field>
        <field name="sequence">10</field>
    </record>

    <record id="group_sf_sale_auto_workflow_user" model="res.groups">
        <field name="name">Sale Auto Workflow / User</field>
        <field name="category_id" ref="module_category_sf_sale_auto_workflow"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_sf_sale_auto_workflow_manager" model="res.groups">
        <field name="name">Sale Auto Workflow / Manager</field>
        <field name="category_id" ref="module_category_sf_sale_auto_workflow"/>
        <field name="implied_ids" eval="[(4, ref('sf_sale_auto_workflow.group_sf_sale_auto_workflow_user'))]"/>
    </record>

    <record id="rule_sf_sale_auto_workflow_company" model="ir.rule">
        <field name="name">Sale Auto Workflow: user sees own company</field>
        <field name="model_id" ref="model_sf_sale_auto_workflow"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('sf_sale_auto_workflow.group_sf_sale_auto_workflow_user'))]"/>
    </record>
    <record id="rule_sf_sale_auto_workflow_manager_all" model="ir.rule">
        <field name="name">Sale Auto Workflow: manager sees all companies</field>
        <field name="model_id" ref="model_sf_sale_auto_workflow"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('sf_sale_auto_workflow.group_sf_sale_auto_workflow_manager'))]"/>
    </record>
    <record id="group_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="module_category_sf_sale_auto_workflow"/>
    </record>
    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_sf_sale_auto_workflow"/>
    </record>
    <record id="group_system" model="res.groups">
        <field name="name">System</field>
        <field name="category_id" ref="module_category_sf_sale_auto_workflow"/>
    </record>
</odoo>