<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_schedule_slot_list" model="ir.ui.view">
        <field name="name">sf.production.scheduling.schedule.slot.list</field>
        <field name="model">sf.production.scheduling.schedule.slot</field>
        <field name="arch" type="xml">
            <list string="Schedule.Slot">
                <field name="plan_id"/>
                <field name="mo_id"/>
                <field name="start_datetime"/>
                <field name="end_datetime"/>
                <field name="workcenter_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_schedule_slot_form" model="ir.ui.view">
        <field name="name">sf.production.scheduling.schedule.slot.form</field>
        <field name="model">sf.production.scheduling.schedule.slot</field>
        <field name="arch" type="xml">
            <form string="Schedule.Slot">
                <header>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" placeholder="Name"/></h1></div>
                    <group><group>
                            <field name="plan_id"/>
                            <field name="mo_id"/>
                            <field name="start_datetime"/>
                            <field name="end_datetime"/>
                            <field name="workcenter_id"/>
                    </group>
                    <group>
                        <field name="currency_id" invisible="1"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_schedule_slot" model="ir.actions.act_window">
        <field name="name">Schedule.Slot</field>
        <field name="res_model">sf.production.scheduling.schedule.slot</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
