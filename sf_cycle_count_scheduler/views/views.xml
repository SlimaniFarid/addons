<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_cycle_count" model="ir.actions.act_window">
        <field name="name">Cycle Count Scheduler</field>
        <field name="res_model">sf.cycle.count</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
    <record id="view_sf_cycle_count_form" model="ir.ui.view">
        <field name="name">sf.cycle.count.form</field>
        <field name="model">sf.cycle.count</field>
        <field name="arch" type="xml">
            <form string="Cycle Count Scheduler">
                <header>
                    <button name="action_counted" type="object" string="Counted"
                            class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="scheduled,counted,approved"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="zone"/>
                            <field name="abc_class"/>
                            <field name="scheduled_date"/>
                            <field name="counted_lines"/>
                            <field name="variance_lines"/>
                            <field name="counter_id"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_cycle_count_list" model="ir.ui.view">
        <field name="name">sf.cycle.count.list</field>
        <field name="model">sf.cycle.count</field>
        <field name="arch" type="xml">
            <list string="Cycle Count Scheduler" sample="1">
                <field name="zone"/>
                <field name="abc_class"/>
                <field name="scheduled_date"/>
                <field name="counted_lines"/>
                <field name="variance_lines"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state in ('submitted','approved')"/>
            </list>
        </field>
    </record>
    <record id="view_sf_cycle_count_kanban" model="ir.ui.view">
        <field name="name">sf.cycle.count.kanban</field>
        <field name="model">sf.cycle.count</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_view" group_by="state">
                <field name="name"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <menuitem id="menu_sf_cycle_count_root" name="Cycle Count Scheduler" sequence="25"
              web_icon="sf_cycle_count_scheduler,static/description/icon.png"/>
    <menuitem id="menu_sf_cycle_count_main" name="Records"
              parent="menu_sf_cycle_count_root" action="action_sf_cycle_count" sequence="10"/>
</odoo>
