<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_training" model="ir.module.category">
        <field name="name">Training &amp; Certifications</field>
        <field name="sequence">95</field>
    </record>

    <record id="group_training_user" model="res.groups">
        <field name="name">Training User</field>
        <field name="category_id" ref="module_category_training"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_training_manager" model="res.groups">
        <field name="name">Training Manager</field>
        <field name="category_id" ref="module_category_training"/>
        <field name="implied_ids" eval="[(4, ref('group_training_user'))]"/>
    </record>

    <record id="rule_training_user_company" model="ir.rule">
        <field name="name">Training: user sees own company</field>
        <field name="model_id" ref="model_sf_training"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_training_user'))]"/>
    </record>

    <record id="rule_session_user_company" model="ir.rule">
        <field name="name">Training Session: user sees own company</field>
        <field name="model_id" ref="model_sf_training_session"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_training_user'))]"/>
    </record>

    <record id="rule_certification_user_own" model="ir.rule">
        <field name="name">Certification: employee sees own</field>
        <field name="model_id" ref="model_sf_employee_certification"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[
            '|',
            ('employee_id.user_id', '=', user.id),
            ('company_id', 'in', company_ids),
        ]</field>
        <field name="groups" eval="[(4, ref('group_training_user'))]"/>
    </record>
    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_training"/>
    </record>
</odoo>