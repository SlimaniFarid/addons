<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_carrier_perf" model="ir.actions.act_window">
        <field name="name">Carrier Performance Tracker</field>
        <field name="res_model">sf.carrier.perf</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
    <record id="view_sf_carrier_perf_form" model="ir.ui.view">
        <field name="name">sf.carrier.perf.form</field>
        <field name="model">sf.carrier.perf</field>
        <field name="arch" type="xml">
            <form string="Carrier Performance Tracker">
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="draft,validated"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="carrier_id"/>
                            <field name="period_month"/>
                            <field name="shipments"/>
                            <field name="on_time"/>
                            <field name="damaged"/>
                            <field name="claims_amount"/>
                            <field name="otd_percent"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_carrier_perf_list" model="ir.ui.view">
        <field name="name">sf.carrier.perf.list</field>
        <field name="model">sf.carrier.perf</field>
        <field name="arch" type="xml">
            <list string="Carrier Performance Tracker" sample="1">
                <field name="carrier_id"/>
                <field name="period_month"/>
                <field name="shipments"/>
                <field name="on_time"/>
                <field name="damaged"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state in ('submitted','approved')"/>
            </list>
        </field>
    </record>
    <record id="view_sf_carrier_perf_kanban" model="ir.ui.view">
        <field name="name">sf.carrier.perf.kanban</field>
        <field name="model">sf.carrier.perf</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_view" group_by="state">
                <field name="name"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <menuitem id="menu_sf_carrier_perf_root" name="Carrier Performance Tracker" sequence="18"
              web_icon="sf_carrier_performance,static/description/icon.png"/>
    <menuitem id="menu_sf_carrier_perf_main" name="Records"
              parent="menu_sf_carrier_perf_root" action="action_sf_carrier_perf" sequence="10"/>
</odoo>
