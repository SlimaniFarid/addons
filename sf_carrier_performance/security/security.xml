<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_carrier_performance" model="ir.module.category">
        <field name="name">Carrier Performance Tracker</field>
        <field name="sequence">25</field>
    </record>
    <record id="group_carrier_performance_user" model="res.groups">
        <field name="name">Carrier Performance Tracker User</field>
        <field name="category_id" ref="module_category_carrier_performance"/>
        <field name="implied_ids" eval="[(4, ref('stock.group_stock_user'))]"/>

    </record>
    <record id="group_carrier_performance_manager" model="res.groups">
        <field name="name">Carrier Performance Tracker Manager</field>
        <field name="category_id" ref="module_category_carrier_performance"/>
        <field name="implied_ids" eval="[(4, ref('group_carrier_performance_user'))]"/>
    </record>
    <record id="rule_carrier_performance_sf_carrier_perf" model="ir.rule">
        <field name="name">Carrier Performance: multi-company</field>
        <field name="model_id" ref="model_sf_carrier_perf"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_carrier_performance"/>
    </record>
</odoo>
