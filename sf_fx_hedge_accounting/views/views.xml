<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_fx_hedge_accounting" model="ir.actions.act_window">
        <field name="name">FX Hedge Accounting (IFRS 9)</field>
        <field name="res_model">sf.fx_hedge_accounting</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
    <record id="view_sf_fx_hedge_accounting_form" model="ir.ui.view">
        <field name="name">sf.fx_hedge_accounting.form</field>
        <field name="model">sf.fx_hedge_accounting</field>
        <field name="arch" type="xml">
            <form string="FX Hedge Accounting (IFRS 9)">
                <header>
                    <button name="action_in_progress" type="object" string="In Progress"
                            class="btn-primary"/>
                    <button name="action_review" type="object" string="Review"
                            class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,in_progress,review,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="hedge_id"/>
                            <field name="designation"/>
                            <field name="effectiveness_percent"/>
                            <field name="reclass_date"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_fx_hedge_accounting_list" model="ir.ui.view">
        <field name="name">sf.fx_hedge_accounting.list</field>
        <field name="model">sf.fx_hedge_accounting</field>
        <field name="arch" type="xml">
            <list string="FX Hedge Accounting (IFRS 9)" sample="1">
                <field name="hedge_id"/>
                <field name="designation"/>
                <field name="effectiveness_percent"/>
                <field name="reclass_date"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state in ('submitted','approved')"/>
            </list>
        </field>
    </record>
    <record id="view_sf_fx_hedge_accounting_kanban" model="ir.ui.view">
        <field name="name">sf.fx_hedge_accounting.kanban</field>
        <field name="model">sf.fx_hedge_accounting</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_view" group_by="state">
                <field name="name"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <menuitem id="menu_sf_fx_hedge_accounting_root" name="FX Hedge Accounting (IFRS 9)" sequence="11"
              web_icon="sf_fx_hedge_accounting,static/description/icon.png"/>
    <menuitem id="menu_sf_fx_hedge_accounting_main" name="Records"
              parent="menu_sf_fx_hedge_accounting_root" action="action_sf_fx_hedge_accounting" sequence="10"/>
</odoo>
