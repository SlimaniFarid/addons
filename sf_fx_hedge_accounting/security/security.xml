<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_fx_hedge_accounting" model="ir.module.category">
        <field name="name">FX Hedge Accounting (IFRS 9)</field>
        <field name="sequence">190</field>
    </record>
    <record id="group_fx_hedge_accounting_user" model="res.groups">
        <field name="name">FX Hedge Accounting (IFRS 9) User</field>
        <field name="category_id" ref="module_category_fx_hedge_accounting"/>

    </record>
    <record id="group_fx_hedge_accounting_manager" model="res.groups">
        <field name="name">FX Hedge Accounting (IFRS 9) Manager</field>
        <field name="category_id" ref="module_category_fx_hedge_accounting"/>
        <field name="implied_ids" eval="[(4, ref('group_fx_hedge_accounting_user'))]"/>
    </record>
    <record id="rule_fx_hedge_accounting_sf_fx_hedge_accounting" model="ir.rule">
        <field name="name">FX Hedge Accounting (IFRS 9): multi-company</field>
        <field name="model_id" ref="model_sf_fx_hedge_accounting"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_fx_hedge_accounting"/>
    </record>
</odoo>
