<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_care_touch" model="ir.actions.act_window">
        <field name="name">Customer Care Touch Program</field>
        <field name="res_model">sf.care.touch</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
    <record id="view_sf_care_touch_form" model="ir.ui.view">
        <field name="name">sf.care.touch.form</field>
        <field name="model">sf.care.touch</field>
        <field name="arch" type="xml">
            <form string="Customer Care Touch Program">
                <header>
                    <button name="action_done" type="object" string="Done"
                            class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="planned,done,skipped"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="cadence_days"/>
                            <field name="last_touch"/>
                            <field name="next_touch"/>
                            <field name="touch_type"/>
                            <field name="satisfaction"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_care_touch_list" model="ir.ui.view">
        <field name="name">sf.care.touch.list</field>
        <field name="model">sf.care.touch</field>
        <field name="arch" type="xml">
            <list string="Customer Care Touch Program" sample="1">
                <field name="partner_id"/>
                <field name="cadence_days"/>
                <field name="last_touch"/>
                <field name="next_touch"/>
                <field name="touch_type"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state in ('submitted','approved')"/>
            </list>
        </field>
    </record>
    <record id="view_sf_care_touch_kanban" model="ir.ui.view">
        <field name="name">sf.care.touch.kanban</field>
        <field name="model">sf.care.touch</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_view" group_by="state">
                <field name="name"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <menuitem id="menu_sf_care_touch_root" name="Customer Care Touch Program" sequence="5"
              web_icon="sf_customer_care_program,static/description/icon.png"/>
    <menuitem id="menu_sf_care_touch_main" name="Records"
              parent="menu_sf_care_touch_root" action="action_sf_care_touch" sequence="10"/>
</odoo>
