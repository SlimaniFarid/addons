<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_revenue_backlog_tracker" model="ir.module.category">
        <field name="name">Revenue Backlog Tracker</field>
        <field name="sequence">25</field>
    </record>
    <record id="group_revenue_backlog_tracker_user" model="res.groups">
        <field name="name">Revenue Backlog Tracker User</field>
        <field name="category_id" ref="module_category_revenue_backlog_tracker"/>

    </record>
    <record id="group_revenue_backlog_tracker_manager" model="res.groups">
        <field name="name">Revenue Backlog Tracker Manager</field>
        <field name="category_id" ref="module_category_revenue_backlog_tracker"/>
        <field name="implied_ids" eval="[(4, ref('group_revenue_backlog_tracker_user'))]"/>
    </record>
    <record id="rule_revenue_backlog_tracker_sf_revenue_backlog" model="ir.rule">
        <field name="name">Backlog Item: multi-company</field>
        <field name="model_id" ref="model_sf_revenue_backlog"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
