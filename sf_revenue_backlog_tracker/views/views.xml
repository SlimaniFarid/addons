<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_revenue_backlog" model="ir.actions.act_window">
        <field name="name">Revenue Backlog Tracker</field>
        <field name="res_model">sf.revenue.backlog</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
    <record id="view_sf_revenue_backlog_form" model="ir.ui.view">
        <field name="name">sf.revenue.backlog.form</field>
        <field name="model">sf.revenue.backlog</field>
        <field name="arch" type="xml">
            <form string="Revenue Backlog Tracker">
                <header>
                    <button name="action_partially_invoiced" type="object" string="Partially Invoiced"
                            class="btn-primary"/>
                    <button name="action_invoiced" type="object" string="Invoiced"
                            class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="open,partially_invoiced,invoiced,cancelled"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="contract_ref"/>
                            <field name="backlog_amount"/>
                            <field name="expected_invoice_month"/>
                            <field name="invoiced_amount"/>
                            <field name="risk_note"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_revenue_backlog_list" model="ir.ui.view">
        <field name="name">sf.revenue.backlog.list</field>
        <field name="model">sf.revenue.backlog</field>
        <field name="arch" type="xml">
            <list string="Revenue Backlog Tracker" sample="1">
                <field name="partner_id"/>
                <field name="contract_ref"/>
                <field name="backlog_amount"/>
                <field name="expected_invoice_month"/>
                <field name="invoiced_amount"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state in ('submitted','approved')"/>
            </list>
        </field>
    </record>
    <record id="view_sf_revenue_backlog_kanban" model="ir.ui.view">
        <field name="name">sf.revenue.backlog.kanban</field>
        <field name="model">sf.revenue.backlog</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_view" group_by="state">
                <field name="name"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <menuitem id="menu_sf_revenue_backlog_root" name="Revenue Backlog Tracker" sequence="7"
              web_icon="sf_revenue_backlog_tracker,static/description/icon.png"/>
    <menuitem id="menu_sf_revenue_backlog_main" name="Records"
              parent="menu_sf_revenue_backlog_root" action="action_sf_revenue_backlog" sequence="10"/>

    <record id="wave_final_sf_revenue_backlog_tracker" model="ir.actions.server">
        <field name="name">Refresh Business Data</field>
        <field name="model_id" ref="model_sf_revenue_backlog"/>
        <field name="binding_model_id" ref="model_sf_revenue_backlog"/>
        <field name="state">code</field>
        <field name="code">records.action_refresh_business()</field>
    </record>
</odoo>
