<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_job_costing_snapshot" model="ir.module.category">
        <field name="name">Job Costing Snapshot</field>
        <field name="sequence">26</field>
    </record>
    <record id="group_job_costing_snapshot_user" model="res.groups">
        <field name="name">Job Costing Snapshot User</field>
        <field name="category_id" ref="module_category_job_costing_snapshot"/>

    </record>
    <record id="group_job_costing_snapshot_manager" model="res.groups">
        <field name="name">Job Costing Snapshot Manager</field>
        <field name="category_id" ref="module_category_job_costing_snapshot"/>
        <field name="implied_ids" eval="[(4, ref('group_job_costing_snapshot_user'))]"/>
    </record>
    <record id="rule_job_costing_snapshot_sf_job_cost" model="ir.rule">
        <field name="name">Job Cost Snapshot: multi-company</field>
        <field name="model_id" ref="model_sf_job_cost"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_job_costing_snapshot"/>
    </record>
</odoo>
