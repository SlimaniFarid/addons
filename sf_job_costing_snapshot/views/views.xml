<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_job_cost" model="ir.actions.act_window">
        <field name="name">Job Costing Snapshot</field>
        <field name="res_model">sf.job.cost</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
    <record id="view_sf_job_cost_form" model="ir.ui.view">
        <field name="name">sf.job.cost.form</field>
        <field name="model">sf.job.cost</field>
        <field name="arch" type="xml">
            <form string="Job Costing Snapshot">
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="draft,reviewed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="job_name"/>
                            <field name="snapshot_date"/>
                            <field name="labor_cost"/>
                            <field name="material_cost"/>
                            <field name="overhead_cost"/>
                            <field name="budget_total"/>
                            <field name="margin_percent"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_job_cost_list" model="ir.ui.view">
        <field name="name">sf.job.cost.list</field>
        <field name="model">sf.job.cost</field>
        <field name="arch" type="xml">
            <list string="Job Costing Snapshot" sample="1">
                <field name="job_name"/>
                <field name="snapshot_date"/>
                <field name="labor_cost"/>
                <field name="material_cost"/>
                <field name="overhead_cost"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state in ('submitted','approved')"/>
            </list>
        </field>
    </record>
    <record id="view_sf_job_cost_kanban" model="ir.ui.view">
        <field name="name">sf.job.cost.kanban</field>
        <field name="model">sf.job.cost</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_view" group_by="state">
                <field name="name"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <menuitem id="menu_sf_job_cost_root" name="Job Costing Snapshot" sequence="8"
              web_icon="sf_job_costing_snapshot,static/description/icon.png"/>
    <menuitem id="menu_sf_job_cost_main" name="Records"
              parent="menu_sf_job_cost_root" action="action_sf_job_cost" sequence="10"/>
</odoo>
