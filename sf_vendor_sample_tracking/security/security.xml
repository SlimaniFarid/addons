<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_vendor_sample_tracking" model="ir.module.category">
        <field name="name">Vendor Sample Request Tracking</field>
        <field name="sequence">37</field>
    </record>
    <record id="group_vendor_sample_tracking_user" model="res.groups">
        <field name="name">Vendor Sample Request Tracking User</field>
        <field name="category_id" ref="module_category_vendor_sample_tracking"/>
        <field name="implied_ids" eval="[(4, ref('purchase.group_purchase_user'))]"/>

    </record>
    <record id="group_vendor_sample_tracking_manager" model="res.groups">
        <field name="name">Vendor Sample Request Tracking Manager</field>
        <field name="category_id" ref="module_category_vendor_sample_tracking"/>
        <field name="implied_ids" eval="[(4, ref('group_vendor_sample_tracking_user'))]"/>
    </record>
    <record id="rule_vendor_sample_tracking_sf_vendor_sample" model="ir.rule">
        <field name="name">Vendor Sample Request: multi-company</field>
        <field name="model_id" ref="model_sf_vendor_sample"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_vendor_sample_tracking"/>
    </record>
</odoo>
