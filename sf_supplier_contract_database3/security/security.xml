<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_supplier_contract_database3" model="ir.module.category">
        <field name="name">Contract Database</field>
        <field name="sequence">657</field>
    </record>
    <record id="group_supplier_contract_database3_user" model="res.groups">
        <field name="name">Contract Database User</field>
        <field name="category_id" ref="module_category_supplier_contract_database3"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>

    </record>
    <record id="group_supplier_contract_database3_manager" model="res.groups">
        <field name="name">Contract Database Manager</field>
        <field name="category_id" ref="module_category_supplier_contract_database3"/>
        <field name="implied_ids" eval="[(4, ref('group_supplier_contract_database3_user'))]"/>
    </record>
    <record id="rule_supplier_contract_database3_sf_supplier_contract_database3" model="ir.rule">
        <field name="name">Contract Database: multi-company</field>
        <field name="model_id" ref="model_sf_supplier_contract_database3"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_supplier_contract_database3"/>
    </record>
</odoo>
