<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_ooo_calendar" model="ir.module.category">
        <field name="name">Out-of-Office &amp; Backup Calendar</field>
        <field name="sequence">48</field>
    </record>
    <record id="group_ooo_calendar_user" model="res.groups">
        <field name="name">Out-of-Office &amp; Backup Calendar User</field>
        <field name="category_id" ref="module_category_ooo_calendar"/>

    </record>
    <record id="group_ooo_calendar_manager" model="res.groups">
        <field name="name">Out-of-Office &amp; Backup Calendar Manager</field>
        <field name="category_id" ref="module_category_ooo_calendar"/>
        <field name="implied_ids" eval="[(4, ref('group_ooo_calendar_user'))]"/>
    </record>
    <record id="rule_ooo_calendar_sf_ooo_period" model="ir.rule">
        <field name="name">OOO Period: multi-company</field>
        <field name="model_id" ref="model_sf_ooo_period"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_ooo_calendar"/>
    </record>
</odoo>
