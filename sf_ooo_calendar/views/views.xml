<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_ooo_period" model="ir.actions.act_window">
        <field name="name">Out-of-Office &amp; Backup Calendar</field>
        <field name="res_model">sf.ooo.period</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
    <record id="view_sf_ooo_period_form" model="ir.ui.view">
        <field name="name">sf.ooo.period.form</field>
        <field name="model">sf.ooo.period</field>
        <field name="arch" type="xml">
            <form string="Out-of-Office &amp; Backup Calendar">
                <header>
                    <button name="action_active" type="object" string="Active"
                            class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="planned,active,completed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="employee_id"/>
                            <field name="date_from"/>
                            <field name="date_to"/>
                            <field name="backup_id"/>
                            <field name="handover_note"/>
                            <field name="reachable"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_ooo_period_list" model="ir.ui.view">
        <field name="name">sf.ooo.period.list</field>
        <field name="model">sf.ooo.period</field>
        <field name="arch" type="xml">
            <list string="Out-of-Office &amp; Backup Calendar" sample="1">
                <field name="employee_id"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="backup_id"/>
                <field name="handover_note"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state in ('submitted','approved')"/>
            </list>
        </field>
    </record>
    <record id="view_sf_ooo_period_kanban" model="ir.ui.view">
        <field name="name">sf.ooo.period.kanban</field>
        <field name="model">sf.ooo.period</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_view" group_by="state">
                <field name="name"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <menuitem id="menu_sf_ooo_period_root" name="Out-of-Office &amp; Backup Calendar" sequence="20"
              web_icon="sf_ooo_calendar,static/description/icon.png"/>
    <menuitem id="menu_sf_ooo_period_main" name="Records"
              parent="menu_sf_ooo_period_root" action="action_sf_ooo_period" sequence="10"/>
</odoo>
