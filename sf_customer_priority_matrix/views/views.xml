<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_customer_class" model="ir.actions.act_window">
        <field name="name">Customer Priority Matrix</field>
        <field name="res_model">sf.customer.class</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
    <record id="view_sf_customer_class_form" model="ir.ui.view">
        <field name="name">sf.customer.class.form</field>
        <field name="model">sf.customer.class</field>
        <field name="arch" type="xml">
            <form string="Customer Priority Matrix">
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="active,review"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="revenue_class"/>
                            <field name="strategic_value"/>
                            <field name="service_level"/>
                            <field name="review_date"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_customer_class_list" model="ir.ui.view">
        <field name="name">sf.customer.class.list</field>
        <field name="model">sf.customer.class</field>
        <field name="arch" type="xml">
            <list string="Customer Priority Matrix" sample="1">
                <field name="partner_id"/>
                <field name="revenue_class"/>
                <field name="strategic_value"/>
                <field name="service_level"/>
                <field name="review_date"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state in ('submitted','approved')"/>
            </list>
        </field>
    </record>
    <record id="view_sf_customer_class_kanban" model="ir.ui.view">
        <field name="name">sf.customer.class.kanban</field>
        <field name="model">sf.customer.class</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_view" group_by="state">
                <field name="name"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <menuitem id="menu_sf_customer_class_root" name="Customer Priority Matrix" sequence="7"
              web_icon="sf_customer_priority_matrix,static/description/icon.png"/>
    <menuitem id="menu_sf_customer_class_main" name="Records"
              parent="menu_sf_customer_class_root" action="action_sf_customer_class" sequence="10"/>
</odoo>
