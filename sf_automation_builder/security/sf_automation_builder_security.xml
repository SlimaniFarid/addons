<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_sf_automation_builder" model="ir.module.category">
        <field name="name">Automation Builder</field>
        <field name="description">Automation Builder Management</field>
        <field name="sequence">10</field>
    </record>

    <record id="group_sf_automation_builder_user" model="res.groups">
        <field name="name">Automation Builder / User</field>
        <field name="category_id" ref="module_category_sf_automation_builder"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_sf_automation_builder_manager" model="res.groups">
        <field name="name">Automation Builder / Manager</field>
        <field name="category_id" ref="module_category_sf_automation_builder"/>
        <field name="implied_ids" eval="[(4, ref('sf_automation_builder.group_sf_automation_builder_user'))]"/>
    </record>

    <record id="rule_sf_automation_builder_company" model="ir.rule">
        <field name="name">Automation Builder: user sees own company</field>
        <field name="model_id" ref="model_sf_automation_builder"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('sf_automation_builder.group_sf_automation_builder_user'))]"/>
    </record>
    <record id="rule_sf_automation_builder_manager_all" model="ir.rule">
        <field name="name">Automation Builder: manager sees all companies</field>
        <field name="model_id" ref="model_sf_automation_builder"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('sf_automation_builder.group_sf_automation_builder_manager'))]"/>
    </record>
    <record id="group_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="module_category_sf_automation_builder"/>
    </record>
    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_sf_automation_builder"/>
    </record>
    <record id="group_system" model="res.groups">
        <field name="name">System</field>
        <field name="category_id" ref="module_category_sf_automation_builder"/>
    </record>
</odoo>