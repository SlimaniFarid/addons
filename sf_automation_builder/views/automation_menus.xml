<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_automation_flow" model="ir.actions.act_window">
        <field name="name">Automation Flows</field>
        <field name="res_model">automation.flow</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
    <record id="action_automation_log" model="ir.actions.act_window">
        <field name="name">Execution Logs</field>
        <field name="res_model">automation.log</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_automation_connector" model="ir.actions.act_window">
        <field name="name">Connectors</field>
        <field name="res_model">automation.connector</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_automation_template" model="ir.actions.act_window">
        <field name="name">Templates</field>
        <field name="res_model">automation.flow.template</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_automation_root" name="Automation Builder" web_icon="sf_automation_builder,static/description/icon.png"/>
    <menuitem id="menu_automation_flows" name="Flows" parent="menu_automation_root" action="action_automation_flow" sequence="10"/>
    <menuitem id="menu_automation_logs" name="Logs" parent="menu_automation_root" action="action_automation_log" sequence="20"/>
    <menuitem id="menu_automation_connectors" name="Connectors" parent="menu_automation_root" action="action_automation_connector" sequence="30"/>
    <menuitem id="menu_automation_templates" name="Templates" parent="menu_automation_root" action="action_automation_template" sequence="40"/>

    <record id="view_automation_flow_form" model="ir.ui.view">
        <field name="name">automation.flow.form</field>
        <field name="model">automation.flow</field>
        <field name="arch" type="xml">
            <form string="Automation Flow">
                <header>
                    <field name="active" widget="boolean" invisible="1"/>
                    <button name="action_publish" string="Publish" type="object" class="btn-primary" invisible="active"/>
                    <button name="action_test_run" string="Test Run" type="object" class="btn-secondary"/>
                    <button name="action_new_version" string="New Version" type="object" class="btn-secondary" invisible="not active"/>
                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="version" readonly="1"/>
                        <field name="trigger_mode"/>
                        <field name="active" widget="boolean"/>
                    </group>
                    <group string="Execution">
                        <field name="max_concurrent_runs"/>
                        <field name="timeout_seconds"/>
                        <field name="retry_on_failure"/>
                        <field name="max_retries"/>
                    </group>
                    <group string="Access">
                        <field name="owner_id" options="{'no_create': True}"/>
                        <field name="allowed_group_ids" widget="many2many_tags" options="{'no_create': True}"/>
                        <field name="is_public"/>
                    </group>
                    <notebook>
                        <page string="Canvas (JSON)">
                            <field name="canvas_data" widget="text" class="monospace"/>
                        </page>
                        <page string="Nodes">
                            <field name="node_ids">
                                <list>
                                    <field name="node_type_id"/>
                                    <field name="name"/>
                                    <field name="category"/>
                                </list>
                            </field>
                        </page>
                        <page string="Variables">
                            <field name="variable_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="var_type"/>
                                    <field name="scope"/>
                                    <field name="required"/>
                                </list>
                            </field>
                        </page>
                        <page string="Logs">
                            <field name="log_ids">
                                <list>
                                    <field name="run_id"/>
                                    <field name="trigger"/>
                                    <field name="status" widget="badge" decoration-success="status=='success'" decoration-danger="status=='failed'"/>
                                    <field name="started_at"/>
                                    <field name="duration_ms"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_automation_flow_list" model="ir.ui.view">
        <field name="name">automation.flow.list</field>
        <field name="model">automation.flow</field>
        <field name="arch" type="xml">
            <list string="Automation Flows">
                <field name="name"/>
                <field name="version"/>
                <field name="trigger_mode"/>
                <field name="active" widget="boolean"/>
                <field name="run_count"/>
                <field name="success_count"/>
                <field name="failure_count"/>
                <field name="last_run"/>
            </list>
        </field>
    </record>
</odoo>