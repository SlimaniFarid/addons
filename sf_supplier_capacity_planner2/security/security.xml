<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_supplier_capacity_planner2" model="ir.module.category">
        <field name="name">Capacity Planner</field>
        <field name="sequence">663</field>
    </record>
    <record id="group_supplier_capacity_planner2_user" model="res.groups">
        <field name="name">Capacity Planner User</field>
        <field name="category_id" ref="module_category_supplier_capacity_planner2"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>

    </record>
    <record id="group_supplier_capacity_planner2_manager" model="res.groups">
        <field name="name">Capacity Planner Manager</field>
        <field name="category_id" ref="module_category_supplier_capacity_planner2"/>
        <field name="implied_ids" eval="[(4, ref('group_supplier_capacity_planner2_user'))]"/>
    </record>
    <record id="rule_supplier_capacity_planner2_sf_supplier_capacity_planner2" model="ir.rule">
        <field name="name">Capacity Planner: multi-company</field>
        <field name="model_id" ref="model_sf_supplier_capacity_planner2"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_supplier_capacity_planner2"/>
    </record>
</odoo>
