<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_product_lifecycle_stage" model="ir.module.category">
        <field name="name">Product Lifecycle Stage Tracker</field>
        <field name="sequence">377</field>
    </record>
    <record id="group_product_lifecycle_stage_user" model="res.groups">
        <field name="name">Product Lifecycle Stage Tracker User</field>
        <field name="category_id" ref="module_category_product_lifecycle_stage"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>

    </record>
    <record id="group_product_lifecycle_stage_manager" model="res.groups">
        <field name="name">Product Lifecycle Stage Tracker Manager</field>
        <field name="category_id" ref="module_category_product_lifecycle_stage"/>
        <field name="implied_ids" eval="[(4, ref('group_product_lifecycle_stage_user'))]"/>
    </record>
    <record id="rule_product_lifecycle_stage_sf_product_lifecycle_stage" model="ir.rule">
        <field name="name">Product Lifecycle Stage Tracker: multi-company</field>
        <field name="model_id" ref="model_sf_product_lifecycle_stage"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_product_lifecycle_stage"/>
    </record>
</odoo>
