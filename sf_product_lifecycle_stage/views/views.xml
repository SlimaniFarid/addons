<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_product_lifecycle_stage" model="ir.actions.act_window">
        <field name="name">Product Lifecycle Stage Tracker</field>
        <field name="res_model">sf.product_lifecycle_stage</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
    <record id="view_sf_product_lifecycle_stage_form" model="ir.ui.view">
        <field name="name">sf.product_lifecycle_stage.form</field>
        <field name="model">sf.product_lifecycle_stage</field>
        <field name="arch" type="xml">
            <form string="Product Lifecycle Stage Tracker">
                <header>
                    <button name="action_in_progress" type="object" string="In Progress"
                            class="btn-primary"/>
                    <button name="action_review" type="object" string="Review"
                            class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,in_progress,review,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="product_id"/>
                            <field name="stage"/>
                            <field name="strategy"/>
                            <field name="review_date"/>
                            <field name="owner_id"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_product_lifecycle_stage_list" model="ir.ui.view">
        <field name="name">sf.product_lifecycle_stage.list</field>
        <field name="model">sf.product_lifecycle_stage</field>
        <field name="arch" type="xml">
            <list string="Product Lifecycle Stage Tracker" sample="1">
                <field name="product_id"/>
                <field name="stage"/>
                <field name="strategy"/>
                <field name="review_date"/>
                <field name="owner_id"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state in ('submitted','approved')"/>
            </list>
        </field>
    </record>
    <record id="view_sf_product_lifecycle_stage_kanban" model="ir.ui.view">
        <field name="name">sf.product_lifecycle_stage.kanban</field>
        <field name="model">sf.product_lifecycle_stage</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_view" group_by="state">
                <field name="name"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <menuitem id="menu_sf_product_lifecycle_stage_root" name="Product Lifecycle Stage Tracker" sequence="24"
              web_icon="sf_product_lifecycle_stage,static/description/icon.png"/>
    <menuitem id="menu_sf_product_lifecycle_stage_main" name="Records"
              parent="menu_sf_product_lifecycle_stage_root" action="action_sf_product_lifecycle_stage" sequence="10"/>

    <record id="wave_final_sf_product_lifecycle_stage" model="ir.actions.server">
        <field name="name">Refresh Business Data</field>
        <field name="model_id" ref="model_sf_product_lifecycle_stage"/>
        <field name="binding_model_id" ref="model_sf_product_lifecycle_stage"/>
        <field name="state">code</field>
        <field name="code">records.action_refresh_business()</field>
    </record>
</odoo>
