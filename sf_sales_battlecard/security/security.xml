<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_sales_battlecard" model="ir.module.category">
        <field name="name">Competitive Battle Cards</field>
        <field name="sequence">174</field>
    </record>
    <record id="group_sales_battlecard_user" model="res.groups">
        <field name="name">Competitive Battle Cards User</field>
        <field name="category_id" ref="module_category_sales_battlecard"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>

    </record>
    <record id="group_sales_battlecard_manager" model="res.groups">
        <field name="name">Competitive Battle Cards Manager</field>
        <field name="category_id" ref="module_category_sales_battlecard"/>
        <field name="implied_ids" eval="[(4, ref('group_sales_battlecard_user'))]"/>
    </record>
    <record id="rule_sales_battlecard_sf_sales_battlecard" model="ir.rule">
        <field name="name">Competitive Battle Cards: multi-company</field>
        <field name="model_id" ref="model_sf_sales_battlecard"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
