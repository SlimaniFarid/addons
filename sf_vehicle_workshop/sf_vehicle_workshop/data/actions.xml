<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_workshop_vehicle" model="ir.sequence">
            <field name="name">Workshop Vehicle</field>
            <field name="code">sf.workshop.vehicle</field>
            <field name="prefix">VEH-</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>

        <record id="seq_workshop_request" model="ir.sequence">
            <field name="name">Workshop Request</field>
            <field name="code">sf.workshop.request</field>
            <field name="prefix">REQ-</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>

        <record id="seq_workshop_order" model="ir.sequence">
            <field name="name">Workshop Order</field>
            <field name="code">sf.workshop.order</field>
            <field name="prefix">ORD-</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>

        <record id="seq_workshop_operation" model="ir.sequence">
            <field name="name">Workshop Operation</field>
            <field name="code">sf.workshop.operation</field>
            <field name="prefix">OPR-</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>

        <record id="seq_workshop_part" model="ir.sequence">
            <field name="name">Workshop Part</field>
            <field name="code">sf.workshop.part</field>
            <field name="prefix">PRT-</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>

        <record id="cron_workshop_alerts" model="ir.cron">
            <field name="name">Vehicle Workshop: Alerts</field>
            <field name="model_id" ref="model_sf_workshop_request"/>
            <field name="state">code</field>
            <field name="code">model._check_workshop_alerts()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="active">True</field>
        </record>
    </data>
</odoo>