<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_sf_workshop" model="ir.module.category">
        <field name="name">sf_workshop</field>
        <field name="sequence">90</field>
    </record>

    <record id="group_sf_workshop_user" model="res.groups">
        <field name="name">Workshop User</field>
        <field name="category_id" ref="module_category_sf_workshop"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_sf_workshop_manager" model="res.groups">
        <field name="name">Workshop Manager</field>
        <field name="category_id" ref="module_category_sf_workshop"/>
        <field name="implied_ids" eval="[(4, ref('group_sf_workshop_user'))]"/>
    </record>

    <record id="rule_workshop_vehicle_user_company" model="ir.rule">
        <field name="name">Vehicle: user sees own company</field>
        <field name="model_id" ref="model_sf_workshop_vehicle"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_sf_workshop_user'))]"/>
    </record>

    <record id="rule_workshop_request_user_company" model="ir.rule">
        <field name="name">Request: user sees own company</field>
        <field name="model_id" ref="model_sf_workshop_request"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_sf_workshop_user'))]"/>
    </record>

    <record id="rule_workshop_order_user_company" model="ir.rule">
        <field name="name">Order: user sees own company</field>
        <field name="model_id" ref="model_sf_workshop_order"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_sf_workshop_user'))]"/>
    </record>

    <record id="rule_workshop_operation_user_company" model="ir.rule">
        <field name="name">Operation: user sees own company</field>
        <field name="model_id" ref="model_sf_workshop_operation"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_sf_workshop_user'))]"/>
    </record>

    <record id="rule_workshop_part_user_company" model="ir.rule">
        <field name="name">Part: user sees own company</field>
        <field name="model_id" ref="model_sf_workshop_part"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_sf_workshop_user'))]"/>
    </record>

    <record id="rule_workshop_vehicle_manager_all" model="ir.rule">
        <field name="name">Vehicle: manager sees all companies</field>
        <field name="model_id" ref="model_sf_workshop_vehicle"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_sf_workshop_manager'))]"/>
    </record>

    <record id="rule_workshop_request_manager_all" model="ir.rule">
        <field name="name">Request: manager sees all companies</field>
        <field name="model_id" ref="model_sf_workshop_request"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_sf_workshop_manager'))]"/>
    </record>

    <record id="rule_workshop_order_manager_all" model="ir.rule">
        <field name="name">Order: manager sees all companies</field>
        <field name="model_id" ref="model_sf_workshop_order"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_sf_workshop_manager'))]"/>
    </record>

    <record id="rule_workshop_operation_manager_all" model="ir.rule">
        <field name="name">Operation: manager sees all companies</field>
        <field name="model_id" ref="model_sf_workshop_operation"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_sf_workshop_manager'))]"/>
    </record>

    <record id="rule_workshop_part_manager_all" model="ir.rule">
        <field name="name">Part: manager sees all companies</field>
        <field name="model_id" ref="model_sf_workshop_part"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_sf_workshop_manager'))]"/>
    </record>
    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_sf_workshop"/>
    </record>
</odoo>