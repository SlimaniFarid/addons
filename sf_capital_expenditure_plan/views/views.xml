<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_capital_expenditure_plan" model="ir.actions.act_window">
        <field name="name">Multi-Year CapEx Plan</field>
        <field name="res_model">sf.capital_expenditure_plan</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
    <record id="view_sf_capital_expenditure_plan_form" model="ir.ui.view">
        <field name="name">sf.capital_expenditure_plan.form</field>
        <field name="model">sf.capital_expenditure_plan</field>
        <field name="arch" type="xml">
            <form string="Multi-Year CapEx Plan">
                <header>

                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="plan_year"/>
                            <field name="category"/>
                            <field name="planned_amount"/>
                            <field name="depreciation_years"/>
                            <field name="annual_dep"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_capital_expenditure_plan_list" model="ir.ui.view">
        <field name="name">sf.capital_expenditure_plan.list</field>
        <field name="model">sf.capital_expenditure_plan</field>
        <field name="arch" type="xml">
            <list string="Multi-Year CapEx Plan" sample="1">
                <field name="plan_year"/>
                <field name="category"/>
                <field name="planned_amount"/>
                <field name="depreciation_years"/>
                <field name="annual_dep"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state in ('submitted','approved')"/>
            </list>
        </field>
    </record>
    <record id="view_sf_capital_expenditure_plan_kanban" model="ir.ui.view">
        <field name="name">sf.capital_expenditure_plan.kanban</field>
        <field name="model">sf.capital_expenditure_plan</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_view" group_by="state">
                <field name="name"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <menuitem id="menu_sf_capital_expenditure_plan_root" name="Multi-Year CapEx Plan" sequence="20"
              web_icon="sf_capital_expenditure_plan,static/description/icon.png"/>
    <menuitem id="menu_sf_capital_expenditure_plan_main" name="Records"
              parent="menu_sf_capital_expenditure_plan_root" action="action_sf_capital_expenditure_plan" sequence="10"/>

    <record id="wave_final_sf_capital_expenditure_plan" model="ir.actions.server">
        <field name="name">Refresh Business Data</field>
        <field name="model_id" ref="model_sf_capital_expenditure_plan"/>
        <field name="binding_model_id" ref="model_sf_capital_expenditure_plan"/>
        <field name="state">code</field>
        <field name="code">records.action_refresh_business()</field>
    </record>
</odoo>
