<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_safety_stock" model="ir.module.category">
        <field name="name">Safety Stock</field>
        <field name="sequence">90</field>
    </record>

    <record id="group_safety_stock_user" model="res.groups">
        <field name="name">Safety Stock User</field>
        <field name="category_id" ref="module_category_safety_stock"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_safety_stock_manager" model="res.groups">
        <field name="name">Safety Stock Manager</field>
        <field name="category_id" ref="module_category_safety_stock"/>
        <field name="implied_ids" eval="[(4, ref('group_safety_stock_user'))]"/>
    </record>
</odoo>