<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Rule form -->
    <record id="safety_stock_rule_view_form" model="ir.ui.view">
        <field name="name">sf.safety.stock.rule.form</field>
        <field name="model">sf.safety.stock.rule</field>
        <field name="arch" type="xml">
            <form string="Safety Stock Rule">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="product_id"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="warehouse_id"/>
                            <field name="service_level"/>
                            <field name="demand_days"/>
                            <field name="lead_time_days"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="current_stock"/>
                            <field name="safety_stock"/>
                            <field name="reorder_point"/>
                            <field name="suggested_qty"/>
                            <field name="below_point"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Demand History">
                            <field name="demand_ids">
                                <tree string="Daily Demand" editable="bottom">
                                    <field name="day"/>
                                    <field name="quantity"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="safety_stock_rule_view_tree" model="ir.ui.view">
        <field name="name">sf.safety.stock.rule.tree</field>
        <field name="model">sf.safety.stock.rule</field>
        <field name="arch" type="xml">
            <tree string="Safety Stock Rules">
                <field name="product_id"/>
                <field name="warehouse_id"/>
                <field name="service_level"/>
                <field name="current_stock"/>
                <field name="reorder_point"/>
                <field name="safety_stock"/>
                <field name="suggested_qty"/>
                <field name="below_point"/>
            </tree>
        </field>
    </record>

    <record id="safety_stock_rule_view_search" model="ir.ui.view">
        <field name="name">sf.safety.stock.rule.search</field>
        <field name="model">sf.safety.stock.rule</field>
        <field name="arch" type="xml">
            <search string="Safety Stock Rules">
                <field name="product_id"/>
                <field name="warehouse_id"/>
                <filter string="Below Reorder Point" name="below"
                        domain="[('below_point','=',True)]"/>
                <group>
                    <filter string="Warehouse" name="warehouse"
                            context="{'group_by':'warehouse_id'}"/>
                    <filter string="Service Level" name="level"
                            context="{'group_by':'service_level'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Demand tree -->
    <record id="safety_stock_demand_view_tree" model="ir.ui.view">
        <field name="name">sf.safety.stock.demand.tree</field>
        <field name="model">sf.safety.stock.demand</field>
        <field name="arch" type="xml">
            <tree string="Daily Demand">
                <field name="rule_id"/>
                <field name="day"/>
                <field name="quantity"/>
            </tree>
        </field>
    </record>

    <!-- Actions -->
    <record id="action_safety_stock_rule" model="ir.actions.act_window">
        <field name="name">Safety Stock Rules</field>
        <field name="res_model">sf.safety.stock.rule</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="safety_stock_rule_view_search"/>
    </record>

    <record id="action_safety_stock_demand" model="ir.actions.act_window">
        <field name="name">Demand History</field>
        <field name="res_model">sf.safety.stock.demand</field>
        <field name="view_mode">tree</field>
    </record>

</odoo>