<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_customer_care_sla" model="ir.module.category">
        <field name="name">Customer Care SLA Tracker</field>
        <field name="sequence">272</field>
    </record>
    <record id="group_customer_care_sla_user" model="res.groups">
        <field name="name">Customer Care SLA Tracker User</field>
        <field name="category_id" ref="module_category_customer_care_sla"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>

    </record>
    <record id="group_customer_care_sla_manager" model="res.groups">
        <field name="name">Customer Care SLA Tracker Manager</field>
        <field name="category_id" ref="module_category_customer_care_sla"/>
        <field name="implied_ids" eval="[(4, ref('group_customer_care_sla_user'))]"/>
    </record>
    <record id="rule_customer_care_sla_sf_customer_care_sla" model="ir.rule">
        <field name="name">Customer Care SLA Tracker: multi-company</field>
        <field name="model_id" ref="model_sf_customer_care_sla"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
