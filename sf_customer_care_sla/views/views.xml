<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_customer_care_sla" model="ir.actions.act_window">
        <field name="name">Customer Care SLA Tracker</field>
        <field name="res_model">sf.customer_care_sla</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
    <record id="view_sf_customer_care_sla_form" model="ir.ui.view">
        <field name="name">sf.customer_care_sla.form</field>
        <field name="model">sf.customer_care_sla</field>
        <field name="arch" type="xml">
            <form string="Customer Care SLA Tracker">
                <header>
                    <button name="action_submitted" type="object" string="Submitted"
                            class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="tier"/>
                            <field name="first_response_target"/>
                            <field name="resolution_target"/>
                            <field name="breaches_this_month"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_customer_care_sla_list" model="ir.ui.view">
        <field name="name">sf.customer_care_sla.list</field>
        <field name="model">sf.customer_care_sla</field>
        <field name="arch" type="xml">
            <list string="Customer Care SLA Tracker" sample="1">
                <field name="partner_id"/>
                <field name="tier"/>
                <field name="first_response_target"/>
                <field name="resolution_target"/>
                <field name="breaches_this_month"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state in ('submitted','approved')"/>
            </list>
        </field>
    </record>
    <record id="view_sf_customer_care_sla_kanban" model="ir.ui.view">
        <field name="name">sf.customer_care_sla.kanban</field>
        <field name="model">sf.customer_care_sla</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_view" group_by="state">
                <field name="name"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <menuitem id="menu_sf_customer_care_sla_root" name="Customer Care SLA Tracker" sequence="29"
              web_icon="sf_customer_care_sla,static/description/icon.png"/>
    <menuitem id="menu_sf_customer_care_sla_main" name="Records"
              parent="menu_sf_customer_care_sla_root" action="action_sf_customer_care_sla" sequence="10"/>
</odoo>
