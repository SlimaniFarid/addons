<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_haccp" model="ir.module.category">
        <field name="name">HACCP Food Safety</field>
        <field name="sequence">90</field>
    </record>

    <record id="group_haccp_user" model="res.groups">
        <field name="name">HACCP User</field>
        <field name="category_id" ref="module_category_haccp"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_haccp_manager" model="res.groups">
        <field name="name">HACCP Manager</field>
        <field name="category_id" ref="module_category_haccp"/>
        <field name="implied_ids" eval="[(4, ref('group_haccp_user'))]"/>
    </record>

    <record id="rule_haccp_site_user_company" model="ir.rule">
        <field name="name">Site: user sees own company</field>
        <field name="model_id" ref="model_sf_haccp_site"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_haccp_user'))]"/>
    </record>

    <record id="rule_haccp_plan_user_company" model="ir.rule">
        <field name="name">Plan: user sees own company</field>
        <field name="model_id" ref="model_sf_haccp_plan"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_haccp_user'))]"/>
    </record>

    <record id="rule_haccp_step_user_company" model="ir.rule">
        <field name="name">Step: user sees own company</field>
        <field name="model_id" ref="model_sf_haccp_step"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_haccp_user'))]"/>
    </record>

    <record id="rule_haccp_prerequisite_user_company" model="ir.rule">
        <field name="name">Prerequisite: user sees own company</field>
        <field name="model_id" ref="model_sf_haccp_prerequisite"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_haccp_user'))]"/>
    </record>

    <record id="rule_haccp_check_user_company" model="ir.rule">
        <field name="name">Check: user sees own company</field>
        <field name="model_id" ref="model_sf_haccp_check"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_haccp_user'))]"/>
    </record>

    <record id="rule_haccp_nonconformity_user_company" model="ir.rule">
        <field name="name">Nonconformity: user sees own company</field>
        <field name="model_id" ref="model_sf_haccp_nonconformity"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_haccp_user'))]"/>
    </record>

    <record id="rule_haccp_site_manager_all" model="ir.rule">
        <field name="name">Site: manager sees all companies</field>
        <field name="model_id" ref="model_sf_haccp_site"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_haccp_manager'))]"/>
    </record>

    <record id="rule_haccp_plan_manager_all" model="ir.rule">
        <field name="name">Plan: manager sees all companies</field>
        <field name="model_id" ref="model_sf_haccp_plan"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_haccp_manager'))]"/>
    </record>

    <record id="rule_haccp_step_manager_all" model="ir.rule">
        <field name="name">Step: manager sees all companies</field>
        <field name="model_id" ref="model_sf_haccp_step"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_haccp_manager'))]"/>
    </record>

    <record id="rule_haccp_prerequisite_manager_all" model="ir.rule">
        <field name="name">Prerequisite: manager sees all companies</field>
        <field name="model_id" ref="model_sf_haccp_prerequisite"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_haccp_manager'))]"/>
    </record>

    <record id="rule_haccp_check_manager_all" model="ir.rule">
        <field name="name">Check: manager sees all companies</field>
        <field name="model_id" ref="model_sf_haccp_check"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_haccp_manager'))]"/>
    </record>

    <record id="rule_haccp_nonconformity_manager_all" model="ir.rule">
        <field name="name">Nonconformity: manager sees all companies</field>
        <field name="model_id" ref="model_sf_haccp_nonconformity"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_haccp_manager'))]"/>
    </record>
    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_haccp"/>
    </record>
</odoo>