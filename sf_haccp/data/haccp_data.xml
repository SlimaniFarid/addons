<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_haccp_site" model="ir.sequence">
            <field name="name">HACCP Site</field>
            <field name="code">sf.haccp.site</field>
            <field name="prefix">SIT-</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>

        <record id="seq_haccp_plan" model="ir.sequence">
            <field name="name">HACCP Plan</field>
            <field name="code">sf.haccp.plan</field>
            <field name="prefix">PLN-</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>

        <record id="seq_haccp_prerequisite" model="ir.sequence">
            <field name="name">HACCP Prerequisite</field>
            <field name="code">sf.haccp.prerequisite</field>
            <field name="prefix">PRE-</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>

        <record id="seq_haccp_check" model="ir.sequence">
            <field name="name">HACCP Check</field>
            <field name="code">sf.haccp.check</field>
            <field name="prefix">CHK-</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>

        <record id="seq_haccp_nonconformity" model="ir.sequence">
            <field name="name">HACCP Nonconformity</field>
            <field name="code">sf.haccp.nonconformity</field>
            <field name="prefix">NCN-</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>

        <record id="cron_haccp_controls" model="ir.cron">
            <field name="name">HACCP: Control and Nonconformity Alerts</field>
            <field name="model_id" ref="model_sf_haccp_check"/>
            <field name="state">code</field>
            <field name="code">model._check_haccp_controls()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="active">True</field>
        </record>
    </data>
</odoo>