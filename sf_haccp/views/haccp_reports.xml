<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="report_haccp_register" model="ir.actions.report">
        <field name="name">HACCP Register</field>
        <field name="model">sf.haccp.site</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">sf_haccp.report_haccp_register_template</field>
        <field name="report_file">sf_haccp.report_haccp_register_template</field>
        <field name="binding_model_id" ref="model_sf_haccp_site"/>
        <field name="binding_type">report</field>
    </record>

    <record id="report_nonconformities" model="ir.actions.report">
        <field name="name">Nonconformities</field>
        <field name="model">sf.haccp.nonconformity</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">sf_haccp.report_nonconformities_template</field>
        <field name="report_file">sf_haccp.report_nonconformities_template</field>
        <field name="binding_model_id" ref="model_sf_haccp_nonconformity"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_haccp_register_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>HACCP Register</h2>
                        <table class="table table-sm">
                            <tr><td><strong>Site</strong></td><td><t t-esc="o.name"/></td></tr>
                            <tr><td><strong>Address</strong></td><td><t t-esc="o.address or ''"/></td></tr>
                            <tr><td><strong>Manager</strong></td><td><t t-esc="o.manager_id.name or ''"/></td></tr>
                        </table>
                        <t t-if="o.prerequisite_ids">
                            <h4>Prerequisites</h4>
                            <table class="table table-sm">
                                <tr><th>Number</th><th>Category</th><th>Description</th><th>Status</th></tr>
                                <tr t-foreach="o.prerequisite_ids" t-as="p">
                                    <td><t t-esc="p.name"/></td>
                                    <td><t t-esc="p.category"/></td>
                                    <td><t t-esc="p.description"/></td>
                                    <td><t t-esc="p.status"/></td>
                                </tr>
                            </table>
                        </t>
                        <t t-foreach="o.plan_ids" t-as="plan">
                            <h4>Plan <t t-esc="plan.name"/> - <t t-esc="plan.process"/></h4>
                            <table class="table table-sm">
                                <tr><th>Seq</th><th>Step</th><th>Hazard</th><th>CCP</th><th>Critical limit</th><th>Monitoring</th><th>Corrective</th></tr>
                                <tr t-foreach="plan.step_ids" t-as="s">
                                    <td><t t-esc="s.sequence"/></td>
                                    <td><t t-esc="s.name"/></td>
                                    <td><t t-esc="s.hazard or ''"/></td>
                                    <td><t t-esc="s.is_ccp"/></td>
                                    <td><t t-esc="s.critical_limit or ''"/></td>
                                    <td><t t-esc="s.monitoring or ''"/></td>
                                    <td><t t-esc="s.corrective or ''"/></td>
                                </tr>
                            </table>
                        </t>
                        <t t-if="o.check_ids">
                            <h4>Monitoring Checks</h4>
                            <table class="table table-sm">
                                <tr><th>Number</th><th>Type</th><th>Result</th><th>Range</th><th>Status</th><th>Deviation</th></tr>
                                <tr t-foreach="o.check_ids" t-as="c">
                                    <td><t t-esc="c.name"/></td>
                                    <td><t t-esc="c.check_type"/></td>
                                    <td><t t-esc="c.result or ''"/></td>
                                    <td><t t-esc="c.target_min or ''"/> - <t t-esc="c.target_max or ''"/> <t t-esc="c.unit or ''"/></td>
                                    <td><t t-esc="c.state"/></td>
                                    <td><t t-esc="c.deviation_detail or ''"/></td>
                                </tr>
                            </table>
                        </t>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <template id="report_nonconformities_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>Nonconformity Register</h2>
                        <table class="table table-sm">
                            <tr><td><strong>Number</strong></td><td><t t-esc="o.name"/></td></tr>
                            <tr><td><strong>Site</strong></td><td><t t-esc="o.site_id.name"/></td></tr>
                            <tr><td><strong>Check</strong></td><td><t t-esc="o.check_id.name or ''"/></td></tr>
                            <tr><td><strong>Severity</strong></td><td><t t-esc="o.severity"/></td></tr>
                            <tr><td><strong>Status</strong></td><td><t t-esc="o.state"/></td></tr>
                            <tr><td><strong>Description</strong></td><td><t t-esc="o.description"/></td></tr>
                            <tr><td><strong>Corrective action</strong></td><td><t t-esc="o.corrective_action or ''"/></td></tr>
                            <tr><td><strong>Due date</strong></td><td><t t-esc="o.due_date or ''"/></td></tr>
                            <tr><td><strong>Closed on</strong></td><td><t t-esc="o.closed_date or ''"/></td></tr>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>