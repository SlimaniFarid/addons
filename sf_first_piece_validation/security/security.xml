<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_first_piece_validation" model="ir.module.category">
        <field name="name">First-Piece Validation</field>
        <field name="sequence">18</field>
    </record>
    <record id="group_first_piece_validation_user" model="res.groups">
        <field name="name">First-Piece Validation User</field>
        <field name="category_id" ref="module_category_first_piece_validation"/>
        <field name="implied_ids" eval="[(4, ref('mrp.group_mrp_user'))]"/>

    </record>
    <record id="group_first_piece_validation_manager" model="res.groups">
        <field name="name">First-Piece Validation Manager</field>
        <field name="category_id" ref="module_category_first_piece_validation"/>
        <field name="implied_ids" eval="[(4, ref('group_first_piece_validation_user'))]"/>
    </record>
    <record id="rule_first_piece_validation_sf_first_piece" model="ir.rule">
        <field name="name">First-Piece Validation: multi-company</field>
        <field name="model_id" ref="model_sf_first_piece"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_first_piece_validation"/>
    </record>
</odoo>
