<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_nonconformance_cost" model="ir.module.category">
        <field name="name">Non-Conformance Cost Calculator</field>
        <field name="sequence">287</field>
    </record>
    <record id="group_nonconformance_cost_user" model="res.groups">
        <field name="name">Non-Conformance Cost Calculator User</field>
        <field name="category_id" ref="module_category_nonconformance_cost"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>

    </record>
    <record id="group_nonconformance_cost_manager" model="res.groups">
        <field name="name">Non-Conformance Cost Calculator Manager</field>
        <field name="category_id" ref="module_category_nonconformance_cost"/>
        <field name="implied_ids" eval="[(4, ref('group_nonconformance_cost_user'))]"/>
    </record>
    <record id="rule_nonconformance_cost_sf_nonconformance_cost" model="ir.rule">
        <field name="name">Non-Conformance Cost Calculator: multi-company</field>
        <field name="model_id" ref="model_sf_nonconformance_cost"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_nonconformance_cost"/>
    </record>
</odoo>
