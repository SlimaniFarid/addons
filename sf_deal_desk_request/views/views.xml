<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_deal_desk_request" model="ir.actions.act_window">
        <field name="name">Deal Desk Request</field>
        <field name="res_model">sf.deal_desk_request</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
    <record id="view_sf_deal_desk_request_form" model="ir.ui.view">
        <field name="name">sf.deal_desk_request.form</field>
        <field name="model">sf.deal_desk_request</field>
        <field name="arch" type="xml">
            <form string="Deal Desk Request">
                <header>
                    <button name="action_in_progress" type="object" string="In Progress"
                            class="btn-primary"/>
                    <button name="action_review" type="object" string="Review"
                            class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,in_progress,review,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="deal_value"/>
                            <field name="complexity"/>
                            <field name="legal_review"/>
                            <field name="finance_review"/>
                            <field name="decision"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_deal_desk_request_list" model="ir.ui.view">
        <field name="name">sf.deal_desk_request.list</field>
        <field name="model">sf.deal_desk_request</field>
        <field name="arch" type="xml">
            <list string="Deal Desk Request" sample="1">
                <field name="partner_id"/>
                <field name="deal_value"/>
                <field name="complexity"/>
                <field name="legal_review"/>
                <field name="finance_review"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state in ('submitted','approved')"/>
            </list>
        </field>
    </record>
    <record id="view_sf_deal_desk_request_kanban" model="ir.ui.view">
        <field name="name">sf.deal_desk_request.kanban</field>
        <field name="model">sf.deal_desk_request</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_view" group_by="state">
                <field name="name"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <menuitem id="menu_sf_deal_desk_request_root" name="Deal Desk Request" sequence="4"
              web_icon="sf_deal_desk_request,static/description/icon.png"/>
    <menuitem id="menu_sf_deal_desk_request_main" name="Records"
              parent="menu_sf_deal_desk_request_root" action="action_sf_deal_desk_request" sequence="10"/>
</odoo>
