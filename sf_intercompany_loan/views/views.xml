<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_intercompany_loan" model="ir.actions.act_window">
        <field name="name">Intercompany Loan Register</field>
        <field name="res_model">sf.intercompany_loan</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
    <record id="view_sf_intercompany_loan_form" model="ir.ui.view">
        <field name="name">sf.intercompany_loan.form</field>
        <field name="model">sf.intercompany_loan</field>
        <field name="arch" type="xml">
            <form string="Intercompany Loan Register">
                <header>
                    <button name="action_submitted" type="object" string="Submitted"
                            class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="lender_company"/>
                            <field name="borrower_company"/>
                            <field name="principal"/>
                            <field name="rate_percent"/>
                            <field name="start_date"/>
                            <field name="maturity_date"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_intercompany_loan_list" model="ir.ui.view">
        <field name="name">sf.intercompany_loan.list</field>
        <field name="model">sf.intercompany_loan</field>
        <field name="arch" type="xml">
            <list string="Intercompany Loan Register" sample="1">
                <field name="lender_company"/>
                <field name="borrower_company"/>
                <field name="principal"/>
                <field name="rate_percent"/>
                <field name="start_date"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state in ('submitted','approved')"/>
            </list>
        </field>
    </record>
    <record id="view_sf_intercompany_loan_kanban" model="ir.ui.view">
        <field name="name">sf.intercompany_loan.kanban</field>
        <field name="model">sf.intercompany_loan</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_view" group_by="state">
                <field name="name"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <menuitem id="menu_sf_intercompany_loan_root" name="Intercompany Loan Register" sequence="12"
              web_icon="sf_intercompany_loan,static/description/icon.png"/>
    <menuitem id="menu_sf_intercompany_loan_main" name="Records"
              parent="menu_sf_intercompany_loan_root" action="action_sf_intercompany_loan" sequence="10"/>
</odoo>
