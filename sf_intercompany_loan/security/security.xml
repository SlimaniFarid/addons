<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_intercompany_loan" model="ir.module.category">
        <field name="name">Intercompany Loan Register</field>
        <field name="sequence">189</field>
    </record>
    <record id="group_intercompany_loan_user" model="res.groups">
        <field name="name">Intercompany Loan Register User</field>
        <field name="category_id" ref="module_category_intercompany_loan"/>

    </record>
    <record id="group_intercompany_loan_manager" model="res.groups">
        <field name="name">Intercompany Loan Register Manager</field>
        <field name="category_id" ref="module_category_intercompany_loan"/>
        <field name="implied_ids" eval="[(4, ref('group_intercompany_loan_user'))]"/>
    </record>
    <record id="rule_intercompany_loan_sf_intercompany_loan" model="ir.rule">
        <field name="name">Intercompany Loan Register: multi-company</field>
        <field name="model_id" ref="model_sf_intercompany_loan"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
