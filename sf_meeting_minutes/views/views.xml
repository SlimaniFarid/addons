<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_meeting_minutes" model="ir.actions.act_window">
        <field name="name">Meeting Minutes &amp; Action Items</field>
        <field name="res_model">sf.meeting.minutes</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
    <record id="view_sf_meeting_minutes_form" model="ir.ui.view">
        <field name="name">sf.meeting.minutes.form</field>
        <field name="model">sf.meeting.minutes</field>
        <field name="arch" type="xml">
            <form string="Meeting Minutes &amp; Action Items">
                <header>
                    <button name="action_distributed" type="object" string="Distributed"
                            class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,distributed,actions_done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="title"/>
                            <field name="meeting_date"/>
                            <field name="chair_id"/>
                            <field name="attendees"/>
                        <field name="decisions"/>
                        <field name="action_items"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_meeting_minutes_list" model="ir.ui.view">
        <field name="name">sf.meeting.minutes.list</field>
        <field name="model">sf.meeting.minutes</field>
        <field name="arch" type="xml">
            <list string="Meeting Minutes &amp; Action Items" sample="1">
                <field name="title"/>
                <field name="meeting_date"/>
                <field name="chair_id"/>
                <field name="attendees"/>
                <field name="decisions"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state in ('submitted','approved')"/>
            </list>
        </field>
    </record>
    <record id="view_sf_meeting_minutes_kanban" model="ir.ui.view">
        <field name="name">sf.meeting.minutes.kanban</field>
        <field name="model">sf.meeting.minutes</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_view" group_by="state">
                <field name="name"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <menuitem id="menu_sf_meeting_minutes_root" name="Meeting Minutes &amp; Action Items" sequence="4"
              web_icon="sf_meeting_minutes,static/description/icon.png"/>
    <menuitem id="menu_sf_meeting_minutes_main" name="Records"
              parent="menu_sf_meeting_minutes_root" action="action_sf_meeting_minutes" sequence="10"/>
</odoo>
