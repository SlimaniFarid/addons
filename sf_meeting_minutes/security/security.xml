<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_meeting_minutes" model="ir.module.category">
        <field name="name">Meeting Minutes &amp; Action Items</field>
        <field name="sequence">47</field>
    </record>
    <record id="group_meeting_minutes_user" model="res.groups">
        <field name="name">Meeting Minutes &amp; Action Items User</field>
        <field name="category_id" ref="module_category_meeting_minutes"/>

    </record>
    <record id="group_meeting_minutes_manager" model="res.groups">
        <field name="name">Meeting Minutes &amp; Action Items Manager</field>
        <field name="category_id" ref="module_category_meeting_minutes"/>
        <field name="implied_ids" eval="[(4, ref('group_meeting_minutes_user'))]"/>
    </record>
    <record id="rule_meeting_minutes_sf_meeting_minutes" model="ir.rule">
        <field name="name">Meeting Minutes: multi-company</field>
        <field name="model_id" ref="model_sf_meeting_minutes"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_meeting_minutes"/>
    </record>
</odoo>
