<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_sales_playbook" model="ir.module.category">
        <field name="name">Sales Playbook Library</field>
        <field name="sequence">177</field>
    </record>
    <record id="group_sales_playbook_user" model="res.groups">
        <field name="name">Sales Playbook Library User</field>
        <field name="category_id" ref="module_category_sales_playbook"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>

    </record>
    <record id="group_sales_playbook_manager" model="res.groups">
        <field name="name">Sales Playbook Library Manager</field>
        <field name="category_id" ref="module_category_sales_playbook"/>
        <field name="implied_ids" eval="[(4, ref('group_sales_playbook_user'))]"/>
    </record>
    <record id="rule_sales_playbook_sf_sales_playbook" model="ir.rule">
        <field name="name">Sales Playbook Library: multi-company</field>
        <field name="model_id" ref="model_sf_sales_playbook"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_sales_playbook"/>
    </record>
</odoo>
