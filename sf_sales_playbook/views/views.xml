<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_sales_playbook" model="ir.actions.act_window">
        <field name="name">Sales Playbook Library</field>
        <field name="res_model">sf.sales_playbook</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
    <record id="view_sf_sales_playbook_form" model="ir.ui.view">
        <field name="name">sf.sales_playbook.form</field>
        <field name="model">sf.sales_playbook</field>
        <field name="arch" type="xml">
            <form string="Sales Playbook Library">
                <header>
                    <button name="action_submitted" type="object" string="Submitted"
                            class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="play_name"/>
                            <field name="trigger"/>
                        <field name="steps"/>
                            <field name="success_metric"/>
                            <field name="owner_id"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_sales_playbook_list" model="ir.ui.view">
        <field name="name">sf.sales_playbook.list</field>
        <field name="model">sf.sales_playbook</field>
        <field name="arch" type="xml">
            <list string="Sales Playbook Library" sample="1">
                <field name="play_name"/>
                <field name="trigger"/>
                <field name="steps"/>
                <field name="success_metric"/>
                <field name="owner_id"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state in ('submitted','approved')"/>
            </list>
        </field>
    </record>
    <record id="view_sf_sales_playbook_kanban" model="ir.ui.view">
        <field name="name">sf.sales_playbook.kanban</field>
        <field name="model">sf.sales_playbook</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_view" group_by="state">
                <field name="name"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <menuitem id="menu_sf_sales_playbook_root" name="Sales Playbook Library" sequence="24"
              web_icon="sf_sales_playbook,static/description/icon.png"/>
    <menuitem id="menu_sf_sales_playbook_main" name="Records"
              parent="menu_sf_sales_playbook_root" action="action_sf_sales_playbook" sequence="10"/>
</odoo>
