<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_report_legal_activity" model="ir.actions.report">
        <field name="name">Legal Activity Report</field>
        <field name="model">sf.litigation.case</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">sf_litigation.report_legal_activity_template</field>
        <field name="report_file">sf_litigation.report_legal_activity_template</field>
        <field name="binding_model_id" ref="model_sf_litigation_case"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_legal_activity_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>Legal Activity Report</h2>
                        <h4><t t-esc="o.name"/> - <t t-esc="o.title or ''"/></h4>
                        <table class="table table-sm">
                            <tr><td><strong>Legal domain</strong></td><td><t t-esc="o.case_type"/></td></tr>
                            <tr><td><strong>Status</strong></td><td><t t-esc="o.state"/></td></tr>
                            <tr><td><strong>Plaintiff</strong></td><td><t t-esc="o.plaintiff_id.name or ''"/></td></tr>
                            <tr><td><strong>Defendant</strong></td><td><t t-esc="o.defendant_id.name or ''"/></td></tr>
                            <tr><td><strong>Lawyer</strong></td><td><t t-esc="o.lawyer_id.name or ''"/></td></tr>
                            <tr><td><strong>Court</strong></td><td><t t-esc="o.court or ''"/></td></tr>
                            <tr><td><strong>Jurisdiction</strong></td><td><t t-esc="o.jurisdiction or ''"/></td></tr>
                            <tr><td><strong>Claim amount</strong></td><td><t t-esc="o.claim_amount"/></td></tr>
                            <tr><td><strong>Total fees</strong></td><td><t t-esc="o.total_fees"/></td></tr>
                            <tr><td><strong>Opened date</strong></td><td><t t-esc="o.opened_date or ''"/></td></tr>
                            <tr><td><strong>Closed date</strong></td><td><t t-esc="o.closed_date or ''"/></td></tr>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <record id="action_report_case_sheet" model="ir.actions.report">
        <field name="name">Case Sheet</field>
        <field name="model">sf.litigation.case</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">sf_litigation.case_sheet_template</field>
        <field name="report_file">sf_litigation.case_sheet_template</field>
        <field name="binding_model_id" ref="model_sf_litigation_case"/>
        <field name="binding_type">report</field>
    </record>

    <template id="case_sheet_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>Case Sheet</h2>
                        <h4><t t-esc="o.name"/> - <t t-esc="o.title or ''"/></h4>
                        <table class="table table-sm">
                            <tr><td><strong>Legal domain</strong></td><td><t t-esc="o.case_type"/></td></tr>
                            <tr><td><strong>Status</strong></td><td><t t-esc="o.state"/></td></tr>
                            <tr><td><strong>Plaintiff</strong></td><td><t t-esc="o.plaintiff_id.name or ''"/></td></tr>
                            <tr><td><strong>Defendant</strong></td><td><t t-esc="o.defendant_id.name or ''"/></td></tr>
                            <tr><td><strong>Lawyer</strong></td><td><t t-esc="o.lawyer_id.name or ''"/></td></tr>
                            <tr><td><strong>Court</strong></td><td><t t-esc="o.court or ''"/></td></tr>
                            <tr><td><strong>Jurisdiction</strong></td><td><t t-esc="o.jurisdiction or ''"/></td></tr>
                            <tr><td><strong>Claim amount</strong></td><td><t t-esc="o.claim_amount"/></td></tr>
                        </table>
                        <h4>Procedural Deadlines</h4>
                        <table class="table table-sm">
                            <tr><th>Reference</th><th>Type</th><th>Due date</th><th>Status</th><th>Met date</th></tr>
                            <t t-foreach="o.deadline_ids" t-as="d">
                                <tr>
                                    <td><t t-esc="d.name"/></td>
                                    <td><t t-esc="d.deadline_type"/></td>
                                    <td><t t-esc="d.due_date or ''"/></td>
                                    <td><t t-esc="d.state"/></td>
                                    <td><t t-esc="d.met_date or ''"/></td>
                                </tr>
                            </t>
                        </table>
                        <h4>Fees &amp; Honoraries</h4>
                        <table class="table table-sm">
                            <tr><th>Reference</th><th>Type</th><th>Amount</th><th>Date</th><th>Paid</th></tr>
                            <t t-foreach="o.fee_ids" t-as="f">
                                <tr>
                                    <td><t t-esc="f.name"/></td>
                                    <td><t t-esc="f.fee_type"/></td>
                                    <td><t t-esc="f.amount"/></td>
                                    <td><t t-esc="f.date or ''"/></td>
                                    <td><t t-esc="f.paid"/></td>
                                </tr>
                            </t>
                            <tr><td colspan="5"><strong>Total: <t t-esc="o.total_fees"/></strong></td></tr>
                        </table>
                        <h4>Decisions</h4>
                        <table class="table table-sm">
                            <tr><th>Reference</th><th>Decision date</th><th>Outcome</th><th>Amount awarded</th><th>Status</th></tr>
                            <t t-foreach="o.decision_ids" t-as="dec">
                                <tr>
                                    <td><t t-esc="dec.name"/></td>
                                    <td><t t-esc="dec.decision_date or ''"/></td>
                                    <td><t t-esc="dec.outcome"/></td>
                                    <td><t t-esc="dec.amount_awarded"/></td>
                                    <td><t t-esc="dec.state"/></td>
                                </tr>
                            </t>
                        </table>
                        <p><strong>Description:</strong> <t t-esc="o.description or ''"/></p>
                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>