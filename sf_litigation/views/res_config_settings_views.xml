<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_litigation" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.litigation</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Litigation" string="Litigation" name="litigation">
                    <block title="Deadline alerts">
                        <setting string="Alert delay before procedural deadline"
                                 help="Number of days before a procedural deadline due date to schedule an alert activity on the deadline.">
                            <div class="content-group">
                                <div class="mt16">
                                    <field name="sf_litigation_alert_days"/>
                                </div>
                            </div>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>