<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_litigation" model="ir.module.category">
        <field name="name">Litigation</field>
        <field name="sequence">90</field>
    </record>

    <record id="group_litigation_user" model="res.groups">
        <field name="name">Litigation User</field>
        <field name="category_id" ref="module_category_litigation"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_litigation_manager" model="res.groups">
        <field name="name">Litigation Manager</field>
        <field name="category_id" ref="module_category_litigation"/>
        <field name="implied_ids" eval="[(4, ref('group_litigation_user'))]"/>
    </record>

    <record id="rule_litigation_case_user_company" model="ir.rule">
        <field name="name">Case: user sees own company</field>
        <field name="model_id" ref="model_sf_litigation_case"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_litigation_user'))]"/>
    </record>

    <record id="rule_litigation_deadline_user_company" model="ir.rule">
        <field name="name">Deadline: user sees own company</field>
        <field name="model_id" ref="model_sf_litigation_deadline"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_litigation_user'))]"/>
    </record>

    <record id="rule_litigation_fee_user_company" model="ir.rule">
        <field name="name">Fee: user sees own company</field>
        <field name="model_id" ref="model_sf_litigation_fee"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_litigation_user'))]"/>
    </record>

    <record id="rule_litigation_decision_user_company" model="ir.rule">
        <field name="name">Decision: user sees own company</field>
        <field name="model_id" ref="model_sf_litigation_decision"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_litigation_user'))]"/>
    </record>

    <record id="rule_litigation_case_manager_all" model="ir.rule">
        <field name="name">Case: manager sees all companies</field>
        <field name="model_id" ref="model_sf_litigation_case"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_litigation_manager'))]"/>
    </record>

    <record id="rule_litigation_deadline_manager_all" model="ir.rule">
        <field name="name">Deadline: manager sees all companies</field>
        <field name="model_id" ref="model_sf_litigation_deadline"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_litigation_manager'))]"/>
    </record>

    <record id="rule_litigation_fee_manager_all" model="ir.rule">
        <field name="name">Fee: manager sees all companies</field>
        <field name="model_id" ref="model_sf_litigation_fee"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_litigation_manager'))]"/>
    </record>

    <record id="rule_litigation_decision_manager_all" model="ir.rule">
        <field name="name">Decision: manager sees all companies</field>
        <field name="model_id" ref="model_sf_litigation_decision"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_litigation_manager'))]"/>
    </record>
</odoo>