<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_litigation_case" model="ir.sequence">
            <field name="name">Litigation Case</field>
            <field name="code">sf.litigation.case</field>
            <field name="prefix"></field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>

        <record id="seq_litigation_deadline" model="ir.sequence">
            <field name="name">Procedural Deadline</field>
            <field name="code">sf.litigation.deadline</field>
            <field name="prefix"></field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>

        <record id="seq_litigation_fee" model="ir.sequence">
            <field name="name">Litigation Fee</field>
            <field name="code">sf.litigation.fee</field>
            <field name="prefix"></field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>

        <record id="seq_litigation_decision" model="ir.sequence">
            <field name="name">Litigation Decision</field>
            <field name="code">sf.litigation.decision</field>
            <field name="prefix"></field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>

        <record id="cron_litigation_deadlines" model="ir.cron">
            <field name="name">Litigation: Procedural Deadline Alerts</field>
            <field name="model_id" ref="model_sf_litigation_deadline"/>
            <field name="state">code</field>
            <field name="code">model._check_litigation_deadlines()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="active">True</field>
        </record>
    </data>
</odoo>