<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_obsolescence_forecast" model="ir.module.category">
        <field name="name">Obsolescence Forecast Model</field>
        <field name="sequence">192</field>
    </record>
    <record id="group_obsolescence_forecast_user" model="res.groups">
        <field name="name">Obsolescence Forecast Model User</field>
        <field name="category_id" ref="module_category_obsolescence_forecast"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>

    </record>
    <record id="group_obsolescence_forecast_manager" model="res.groups">
        <field name="name">Obsolescence Forecast Model Manager</field>
        <field name="category_id" ref="module_category_obsolescence_forecast"/>
        <field name="implied_ids" eval="[(4, ref('group_obsolescence_forecast_user'))]"/>
    </record>
    <record id="rule_obsolescence_forecast_sf_obsolescence_forecast" model="ir.rule">
        <field name="name">Obsolescence Forecast Model: multi-company</field>
        <field name="model_id" ref="model_sf_obsolescence_forecast"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
