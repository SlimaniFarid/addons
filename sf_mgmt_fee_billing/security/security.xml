<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_mgmt_fee_billing" model="ir.module.category">
        <field name="name">Recurring Management Fee Billing</field>
        <field name="sequence">55</field>
    </record>
    <record id="group_mgmt_fee_billing_user" model="res.groups">
        <field name="name">Recurring Management Fee Billing User</field>
        <field name="category_id" ref="module_category_mgmt_fee_billing"/>

    </record>
    <record id="group_mgmt_fee_billing_manager" model="res.groups">
        <field name="name">Recurring Management Fee Billing Manager</field>
        <field name="category_id" ref="module_category_mgmt_fee_billing"/>
        <field name="implied_ids" eval="[(4, ref('group_mgmt_fee_billing_user'))]"/>
    </record>
    <record id="rule_mgmt_fee_billing_sf_mgmt_fee" model="ir.rule">
        <field name="name">Management Fee Contract: multi-company</field>
        <field name="model_id" ref="model_sf_mgmt_fee"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_mgmt_fee_billing"/>
    </record>
</odoo>
