<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_customer_document_vault" model="ir.module.category">
        <field name="name">Customer Document Vault</field>
        <field name="sequence">40</field>
    </record>
    <record id="group_customer_document_vault_user" model="res.groups">
        <field name="name">Customer Document Vault User</field>
        <field name="category_id" ref="module_category_customer_document_vault"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>

    </record>
    <record id="group_customer_document_vault_manager" model="res.groups">
        <field name="name">Customer Document Vault Manager</field>
        <field name="category_id" ref="module_category_customer_document_vault"/>
        <field name="implied_ids" eval="[(4, ref('group_customer_document_vault_user'))]"/>
    </record>
    <record id="rule_customer_document_vault_sf_customer_doc" model="ir.rule">
        <field name="name">Customer Document: multi-company</field>
        <field name="model_id" ref="model_sf_customer_doc"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_customer_document_vault"/>
    </record>
</odoo>
