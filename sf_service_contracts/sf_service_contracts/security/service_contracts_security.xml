<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_service_contracts" model="ir.module.category">
        <field name="name">Service Contracts</field>
        <field name="sequence">90</field>
    </record>

    <record id="group_service_contracts_user" model="res.groups">
        <field name="name">Service Contracts User</field>
        <field name="category_id" ref="module_category_service_contracts"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_service_contracts_manager" model="res.groups">
        <field name="name">Service Contracts Manager</field>
        <field name="category_id" ref="module_category_service_contracts"/>
        <field name="implied_ids" eval="[(4, ref('group_service_contracts_user'))]"/>
    </record>
</odoo>