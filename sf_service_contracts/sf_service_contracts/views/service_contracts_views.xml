<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Contract form -->
    <record id="service_contract_view_form" model="ir.ui.view">
        <field name="name">sf.service.contract.form</field>
        <field name="model">sf.service.contract</field>
        <field name="arch" type="xml">
            <form string="Service Contract">
                <header>
                    <button name="action_activate" string="Activate"
                            type="object" invisible="[('state', 'not in', ('draft',))]"/>
                    <button name="action_cancel" string="Cancel"
                            type="object" invisible="[('state', 'not in', ('draft', 'active'))]"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                        <field name="state" widget="statusbar"/>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="sla_tier_id"/>
                            <field name="date_start"/>
                            <field name="date_end"/>
                        </group>
                        <group>
                            <field name="recurring_amount"/>
                            <field name="currency_id"/>
                            <field name="breached_events"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="SLA Events">
                            <field name="sla_event_ids">
                                <tree string="SLA Events">
                                    <field name="reference"/>
                                    <field name="date_opened"/>
                                    <field name="response_breached"/>
                                    <field name="resolution_breached"/>
                                    <field name="breached"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="service_contract_view_tree" model="ir.ui.view">
        <field name="name">sf.service.contract.tree</field>
        <field name="model">sf.service.contract</field>
        <field name="arch" type="xml">
            <tree string="Service Contracts">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="sla_tier_id"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="recurring_amount"/>
                <field name="breached_events"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <record id="service_contract_view_search" model="ir.ui.view">
        <field name="name">sf.service.contract.search</field>
        <field name="model">sf.service.contract</field>
        <field name="arch" type="xml">
            <search string="Service Contracts">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="sla_tier_id"/>
                <filter string="Active" name="active"
                        domain="[('state','=','active')]"/>
                <filter string="Breached" name="breached"
                        domain="[('breached_events','&gt;',0)]"/>
                <group>
                    <filter string="SLA Tier" name="tier"
                            context="{'group_by':'sla_tier_id'}"/>
                    <filter string="Status" name="state"
                            context="{'group_by':'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- SLA tier -->
    <record id="sla_tier_view_form" model="ir.ui.view">
        <field name="name">sf.sla.tier.form</field>
        <field name="model">sf.sla.tier</field>
        <field name="arch" type="xml">
            <form string="SLA Tier">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="response_hours"/>
                            <field name="resolution_hours"/>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="sla_tier_view_tree" model="ir.ui.view">
        <field name="name">sf.sla.tier.tree</field>
        <field name="model">sf.sla.tier</field>
        <field name="arch" type="xml">
            <tree string="SLA Tiers">
                <field name="name"/>
                <field name="code"/>
                <field name="response_hours"/>
                <field name="resolution_hours"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <!-- SLA event -->
    <record id="sla_event_view_form" model="ir.ui.view">
        <field name="name">sf.sla.event.form</field>
        <field name="model">sf.sla.event</field>
        <field name="arch" type="xml">
            <form string="SLA Event">
                <sheet>
                    <group>
                        <group>
                            <field name="contract_id"/>
                            <field name="reference"/>
                            <field name="partner_id"/>
                        </group>
                        <group>
                            <field name="date_opened"/>
                            <field name="date_responded"/>
                            <field name="date_resolved"/>
                        </group>
                    </group>
                    <group string="SLA Targets">
                        <group>
                            <field name="response_hours"/>
                            <field name="response_breached"/>
                        </group>
                        <group>
                            <field name="resolution_hours"/>
                            <field name="resolution_breached"/>
                            <field name="breached"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="sla_event_view_tree" model="ir.ui.view">
        <field name="name">sf.sla.event.tree</field>
        <field name="model">sf.sla.event</field>
        <field name="arch" type="xml">
            <tree string="SLA Events">
                <field name="reference"/>
                <field name="contract_id"/>
                <field name="partner_id"/>
                <field name="date_opened"/>
                <field name="breached"/>
            </tree>
        </field>
    </record>

    <!-- Actions -->
    <record id="action_service_contract" model="ir.actions.act_window">
        <field name="name">Service Contracts</field>
        <field name="res_model">sf.service.contract</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="service_contract_view_search"/>
    </record>

    <record id="action_sla_tier" model="ir.actions.act_window">
        <field name="name">SLA Tiers</field>
        <field name="res_model">sf.sla.tier</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record id="action_sla_event" model="ir.actions.act_window">
        <field name="name">SLA Events</field>
        <field name="res_model">sf.sla.event</field>
        <field name="view_mode">tree,form</field>
    </record>

</odoo>