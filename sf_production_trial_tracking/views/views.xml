<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_production_trial" model="ir.actions.act_window">
        <field name="name">Production Trial Tracking</field>
        <field name="res_model">sf.production.trial</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
    <record id="view_sf_production_trial_form" model="ir.ui.view">
        <field name="name">sf.production.trial.form</field>
        <field name="model">sf.production.trial</field>
        <field name="arch" type="xml">
            <form string="Production Trial Tracking">
                <header>
                    <button name="action_run" type="object" string="Run"
                            class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="planned,run,decided"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="product_id"/>
                            <field name="trial_date"/>
                        <field name="parameters_tested"/>
                            <field name="result_qty_ok"/>
                            <field name="result_qty_ko"/>
                            <field name="decision"/>
                            <field name="decided_by_id"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_production_trial_list" model="ir.ui.view">
        <field name="name">sf.production.trial.list</field>
        <field name="model">sf.production.trial</field>
        <field name="arch" type="xml">
            <list string="Production Trial Tracking" sample="1">
                <field name="product_id"/>
                <field name="trial_date"/>
                <field name="parameters_tested"/>
                <field name="result_qty_ok"/>
                <field name="result_qty_ko"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state in ('submitted','approved')"/>
            </list>
        </field>
    </record>
    <record id="view_sf_production_trial_kanban" model="ir.ui.view">
        <field name="name">sf.production.trial.kanban</field>
        <field name="model">sf.production.trial</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_view" group_by="state">
                <field name="name"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <menuitem id="menu_sf_production_trial_root" name="Production Trial Tracking" sequence="18"
              web_icon="sf_production_trial_tracking,static/description/icon.png"/>
    <menuitem id="menu_sf_production_trial_main" name="Records"
              parent="menu_sf_production_trial_root" action="action_sf_production_trial" sequence="10"/>
</odoo>
