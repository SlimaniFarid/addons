<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_production_trial_tracking" model="ir.module.category">
        <field name="name">Production Trial Tracking</field>
        <field name="sequence">2</field>
    </record>
    <record id="group_production_trial_tracking_user" model="res.groups">
        <field name="name">Production Trial Tracking User</field>
        <field name="category_id" ref="module_category_production_trial_tracking"/>
        <field name="implied_ids" eval="[(4, ref('mrp.group_mrp_user'))]"/>

    </record>
    <record id="group_production_trial_tracking_manager" model="res.groups">
        <field name="name">Production Trial Tracking Manager</field>
        <field name="category_id" ref="module_category_production_trial_tracking"/>
        <field name="implied_ids" eval="[(4, ref('group_production_trial_tracking_user'))]"/>
    </record>
    <record id="rule_production_trial_tracking_sf_production_trial" model="ir.rule">
        <field name="name">Production Trial: multi-company</field>
        <field name="model_id" ref="model_sf_production_trial"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
