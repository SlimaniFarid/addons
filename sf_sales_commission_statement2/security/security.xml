<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_sales_commission_statement2" model="ir.module.category">
        <field name="name">Commission Statement</field>
        <field name="sequence">660</field>
    </record>
    <record id="group_sales_commission_statement2_user" model="res.groups">
        <field name="name">Commission Statement User</field>
        <field name="category_id" ref="module_category_sales_commission_statement2"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>

    </record>
    <record id="group_sales_commission_statement2_manager" model="res.groups">
        <field name="name">Commission Statement Manager</field>
        <field name="category_id" ref="module_category_sales_commission_statement2"/>
        <field name="implied_ids" eval="[(4, ref('group_sales_commission_statement2_user'))]"/>
    </record>
    <record id="rule_sales_commission_statement2_sf_sales_commission_statement2" model="ir.rule">
        <field name="name">Commission Statement: multi-company</field>
        <field name="model_id" ref="model_sf_sales_commission_statement2"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_sales_commission_statement2"/>
    </record>
</odoo>
