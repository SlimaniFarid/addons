<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_customer_segments_rules" model="ir.actions.act_window">
        <field name="name">Customer Segmentation Rules</field>
        <field name="res_model">sf.customer_segments_rules</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
    <record id="view_sf_customer_segments_rules_form" model="ir.ui.view">
        <field name="name">sf.customer_segments_rules.form</field>
        <field name="model">sf.customer_segments_rules</field>
        <field name="arch" type="xml">
            <form string="Customer Segmentation Rules">
                <header>
                    <button name="action_submitted" type="object" string="Submitted"
                            class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="segment_name"/>
                            <field name="recency_max_days"/>
                            <field name="frequency_min"/>
                            <field name="monetary_min"/>
                            <field name="member_count"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_customer_segments_rules_list" model="ir.ui.view">
        <field name="name">sf.customer_segments_rules.list</field>
        <field name="model">sf.customer_segments_rules</field>
        <field name="arch" type="xml">
            <list string="Customer Segmentation Rules" sample="1">
                <field name="segment_name"/>
                <field name="recency_max_days"/>
                <field name="frequency_min"/>
                <field name="monetary_min"/>
                <field name="member_count"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state in ('submitted','approved')"/>
            </list>
        </field>
    </record>
    <record id="view_sf_customer_segments_rules_kanban" model="ir.ui.view">
        <field name="name">sf.customer_segments_rules.kanban</field>
        <field name="model">sf.customer_segments_rules</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_view" group_by="state">
                <field name="name"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <menuitem id="menu_sf_customer_segments_rules_root" name="Customer Segmentation Rules" sequence="20"
              web_icon="sf_customer_segments_rules,static/description/icon.png"/>
    <menuitem id="menu_sf_customer_segments_rules_main" name="Records"
              parent="menu_sf_customer_segments_rules_root" action="action_sf_customer_segments_rules" sequence="10"/>
</odoo>
