<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_customer_segments_rules" model="ir.module.category">
        <field name="name">Customer Segmentation Rules</field>
        <field name="sequence">381</field>
    </record>
    <record id="group_customer_segments_rules_user" model="res.groups">
        <field name="name">Customer Segmentation Rules User</field>
        <field name="category_id" ref="module_category_customer_segments_rules"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>

    </record>
    <record id="group_customer_segments_rules_manager" model="res.groups">
        <field name="name">Customer Segmentation Rules Manager</field>
        <field name="category_id" ref="module_category_customer_segments_rules"/>
        <field name="implied_ids" eval="[(4, ref('group_customer_segments_rules_user'))]"/>
    </record>
    <record id="rule_customer_segments_rules_sf_customer_segments_rules" model="ir.rule">
        <field name="name">Customer Segmentation Rules: multi-company</field>
        <field name="model_id" ref="model_sf_customer_segments_rules"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
