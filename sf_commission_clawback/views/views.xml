<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_clawback" model="ir.actions.act_window">
        <field name="name">Sales Commission Clawback</field>
        <field name="res_model">sf.clawback</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
    <record id="view_sf_clawback_form" model="ir.ui.view">
        <field name="name">sf.clawback.form</field>
        <field name="model">sf.clawback</field>
        <field name="arch" type="xml">
            <form string="Sales Commission Clawback">
                <header>
                    <button name="action_notified" type="object" string="Notified"
                            class="btn-primary"/>
                    <button name="action_recovered" type="object" string="Recovered"
                            class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="open,notified,recovered,written_off"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="salesperson_id"/>
                            <field name="reason"/>
                            <field name="commission_amount"/>
                            <field name="recovered_amount"/>
                            <field name="notes"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_clawback_list" model="ir.ui.view">
        <field name="name">sf.clawback.list</field>
        <field name="model">sf.clawback</field>
        <field name="arch" type="xml">
            <list string="Sales Commission Clawback" sample="1">
                <field name="salesperson_id"/>
                <field name="reason"/>
                <field name="commission_amount"/>
                <field name="recovered_amount"/>
                <field name="notes"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state in ('submitted','approved')"/>
            </list>
        </field>
    </record>
    <record id="view_sf_clawback_kanban" model="ir.ui.view">
        <field name="name">sf.clawback.kanban</field>
        <field name="model">sf.clawback</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_view" group_by="state">
                <field name="name"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <menuitem id="menu_sf_clawback_root" name="Sales Commission Clawback" sequence="8"
              web_icon="sf_commission_clawback,static/description/icon.png"/>
    <menuitem id="menu_sf_clawback_main" name="Records"
              parent="menu_sf_clawback_root" action="action_sf_clawback" sequence="10"/>

    <record id="wave_final_sf_commission_clawback" model="ir.actions.server">
        <field name="name">Refresh Business Data</field>
        <field name="model_id" ref="model_sf_clawback"/>
        <field name="binding_model_id" ref="model_sf_clawback"/>
        <field name="state">code</field>
        <field name="code">records.action_refresh_business()</field>
    </record>
</odoo>
