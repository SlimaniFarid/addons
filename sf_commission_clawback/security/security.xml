<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_commission_clawback" model="ir.module.category">
        <field name="name">Sales Commission Clawback</field>
        <field name="sequence">42</field>
    </record>
    <record id="group_commission_clawback_user" model="res.groups">
        <field name="name">Sales Commission Clawback User</field>
        <field name="category_id" ref="module_category_commission_clawback"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>

    </record>
    <record id="group_commission_clawback_manager" model="res.groups">
        <field name="name">Sales Commission Clawback Manager</field>
        <field name="category_id" ref="module_category_commission_clawback"/>
        <field name="implied_ids" eval="[(4, ref('group_commission_clawback_user'))]"/>
    </record>
    <record id="rule_commission_clawback_sf_clawback" model="ir.rule">
        <field name="name">Clawback Case: multi-company</field>
        <field name="model_id" ref="model_sf_clawback"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
