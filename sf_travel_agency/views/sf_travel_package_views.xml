<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sf_travel_package_view_kanban" model="ir.ui.view">
        <field name="name">sf.travel.package.kanban</field>
        <field name="model">sf.travel.package</field>
        <field name="arch" type="xml">
            <kanban default_group_by="destination">
                <t t-name="card">
                    <field name="name"/>
                    <field name="destination"/>
                    <field name="start_date"/>
                    <field name="end_date"/>
                    <field name="price_unit"/>
                    <field name="currency_id"/>
                    <field name="state"/>
                    <div class="oe_kanban_global_click">
                        <div class="o_kanban_record_title">
                            <span t-field="name" class="fw-bold"/>
                        </div>
                        <div class="o_kanban_record_subtitle">
                            <i class="fa fa-map-location-dot"/>
                            <span t-field="destination"/>
                        </div>
                        <div class="o_kanban_record_body">
                            <div>
                                <i class="fa fa-calendar"/>
                                <span t-field="start_date"/>
                                <span>-</span>
                                <span t-field="end_date"/>
                            </div>
                            <div>
                                <span t-field="price_unit"/>
                                <span t-field="currency_id"/>
                            </div>
                        </div>
                        <div class="o_kanban_record_bottom">
                            <span t-field="state" class="badge text-bg-info"/>
                        </div>
                    </div>
                </t>
            </kanban>
        </field>
    </record>

    <record id="sf_travel_package_view_list" model="ir.ui.view">
        <field name="name">sf.travel.package.list</field>
        <field name="model">sf.travel.package</field>
        <field name="arch" type="xml">
            <list string="Packages">
                <field name="name"/>
                <field name="destination"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="price_unit" string="Price"/>
                <field name="capacity"/>
                <field name="state" widget="badge" decoration-success="state == 'on_sale'" decoration-info="state == 'confirmed'" decoration-muted="state in ('closed', 'cancelled')"/>
            </list>
        </field>
    </record>

    <record id="sf_travel_package_view_form" model="ir.ui.view">
        <field name="name">sf.travel.package.form</field>
        <field name="model">sf.travel.package</field>
        <field name="arch" type="xml">
            <form string="Travel Package">
                <header>
                    <button name="action_confirm" type="object" string="Confirm" invisible="state != 'draft'"/>
                    <button name="action_on_sale" type="object" string="Put On Sale" invisible="state != 'confirmed'"/>
                    <button name="action_close" type="object" string="Close" invisible="state not in ('confirmed', 'on_sale')"/>
                    <button name="action_cancel" type="object" string="Cancel" invisible="state in ('cancelled', 'closed')"/>
                    <button name="action_draft" type="object" string="Set To Draft" invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,on_sale,closed,cancelled"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="destination"/>
                            <field name="start_date"/>
                            <field name="end_date"/>
                            <field name="price_unit"/>
                            <field name="capacity"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="currency_id"/>
                            <field name="provider_ids" widget="many2many_tags"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Reservations" name="reservations">
                            <field name="reservation_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="partner_id"/>
                                    <field name="traveler_name"/>
                                    <field name="pax"/>
                                    <field name="price_unit"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="sf_travel_package_view_search" model="ir.ui.view">
        <field name="name">sf.travel.package.search</field>
        <field name="model">sf.travel.package</field>
        <field name="arch" type="xml">
            <search string="Search Packages">
                <field name="name"/>
                <field name="destination"/>
                <field name="state"/>
                <field name="start_date"/>
                <group>
                    <filter string="Draft" name="filter_draft" domain="[('state', '=', 'draft')]"/>
                    <filter string="Confirmed" name="filter_confirmed" domain="[('state', '=', 'confirmed')]"/>
                    <filter string="On Sale" name="filter_on_sale" domain="[('state', '=', 'on_sale')]"/>
                    <filter string="Closed" name="filter_closed" domain="[('state', '=', 'closed')]"/>
                    <separator/>
                    <group string="Group By">
                        <filter string="Destination" name="group_by_destination" context="{'group_by': 'destination'}"/>
                        <filter string="State" name="group_by_state" context="{'group_by': 'state'}"/>
                        <filter string="Start Date" name="group_by_start_date" context="{'group_by': 'start_date'}"/>
                    </group>
                </group>
            </search>
        </field>
    </record>

    <record id="action_sf_travel_package" model="ir.actions.act_window">
        <field name="name">Packages</field>
        <field name="res_model">sf.travel.package</field>
        <field name="view_mode">list,kanban,form</field>
    </record>

    <record id="wave_final_sf_travel_agency" model="ir.actions.server">
        <field name="name">Refresh Business Data</field>
        <field name="model_id" ref="model_sf_travel_package"/>
        <field name="binding_model_id" ref="model_sf_travel_package"/>
        <field name="state">code</field>
        <field name="code">records.action_refresh_business()</field>
    </record>
</odoo>
