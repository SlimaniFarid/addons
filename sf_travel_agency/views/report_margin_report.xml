<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_margin_report">
        <t t-call="web.html_container">
            <div class="page">
                <h2>Margin Report</h2>
                <table class="table table-sm">
                    <thead>
                        <tr>
                            <th>Reservation</th>
                            <th>Package</th>
                            <th>Price</th>
                            <th>Cost</th>
                            <th>Commission</th>
                            <th>Margin</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="docs" t-as="doc">
                            <td t-field="doc.name"/>
                            <td t-field="doc.package_id.name"/>
                            <td><span t-field="doc.price_unit"/> <span t-field="doc.currency_id"/></td>
                            <td><span t-field="doc.cost"/> <span t-field="doc.currency_id"/></td>
                            <td><span t-field="doc.commission"/> <span t-field="doc.currency_id"/></td>
                            <td><span t-field="doc.margin"/> <span t-field="doc.currency_id"/></td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </t>
    </template>
</odoo>
