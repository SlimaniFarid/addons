<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_sf_travel_agency" model="ir.ui.view">
        <field name="name">res.config.settings.form.sf.travel.agency</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <div class="app_settings_block" data-string="Travel Agency" string="Travel Agency" data-key="sf_travel_agency" groups="sf_travel_agency.group_sf_travel_agency_manager">
                    <h2>Travel Agency</h2>
                    <div class="row mt16 o_settings_container">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <label for="sf_travel_agency_commission_rate"/>
                                <div class="text-muted">Default commission rate applied to new reservations.</div>
                                <div class="content-group">
                                    <div class="mt16">
                                        <field name="sf_travel_agency_commission_rate"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <label for="sf_travel_agency_reminder_days"/>
                                <div class="text-muted">Number of days before departure used by the reminder cron.</div>
                                <div class="content-group">
                                    <div class="mt16">
                                        <field name="sf_travel_agency_reminder_days"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
