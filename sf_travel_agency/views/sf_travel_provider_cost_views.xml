<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sf_travel_provider_cost_view_list" model="ir.ui.view">
        <field name="name">sf.travel.provider.cost.list</field>
        <field name="model">sf.travel.provider.cost</field>
        <field name="arch" type="xml">
            <list decoration-danger="is_overdue" string="Provider Costs">
                <field name="name"/>
                <field name="reservation_id"/>
                <field name="provider_id"/>
                <field name="amount"/>
                <field name="cost_date"/>
            </list>
        </field>
    </record>

    <record id="sf_travel_provider_cost_view_form" model="ir.ui.view">
        <field name="name">sf.travel.provider.cost.form</field>
        <field name="model">sf.travel.provider.cost</field>
        <field name="arch" type="xml">
            <form string="Provider Cost">
                <sheet>
                    <group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="reservation_id"/>
                            <field name="provider_id"/>
                            <field name="amount"/>
                            <field name="cost_date"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="currency_id"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="sf_travel_provider_cost_view_search" model="ir.ui.view">
        <field name="name">sf.travel.provider.cost.search</field>
        <field name="model">sf.travel.provider.cost</field>
        <field name="arch" type="xml">
            <search string="Search Provider Costs">
                <field name="name"/>
                <field name="reservation_id"/>
                <field name="provider_id"/>
                <group>
                    <group string="Group By">
                        <filter string="Provider" name="group_by_provider" context="{'group_by': 'provider_id'}"/>
                        <filter string="Cost Date" name="group_by_cost_date" context="{'group_by': 'cost_date'}"/>
                    </group>
                </group>
            </search>
        </field>
    </record>

    <record id="action_sf_travel_provider_cost" model="ir.actions.act_window">
        <field name="name">Provider Costs</field>
        <field name="res_model">sf.travel.provider.cost</field>
        <field name="view_mode">kanban,list,form</field>
    </record>

    <record id="view_sf_travel_agency_boost_kanban" model="ir.ui.view">
        <field name="name">sf_travel_agency.boost.kanban</field>
        <field name="model">sf.travel.package</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" t-att-color="state">
                <field name="name"/>
                <field name="state"/>
                <field name="user_id"/>
                <field name="end_date"/>
                <field name="is_overdue" invisible="1"/>

                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_card oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title">
                                    <field name="name"/></strong>
                                <div class="o_kanban_record_subtitle">
                                    <field name="user_id" widget="many2one_avatar_user"/>
                                    <field name="end_date"/></div>
                            </div>
                            <div class="oe_kanban_bottom_right">
                                <field name="state" widget="badge"
                                       t-attf-options="{'classes_map': {'draft': 'info', 'done': 'success', 'cancelled': 'danger'}, 'domain': []}"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_sf_travel_agency_boost_search" model="ir.ui.view">
        <field name="name">sf_travel_agency.boost.search</field>
        <field name="model">sf.travel.package</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
<separator/>
                <filter string="My records" name="my_records" domain="[('user_id', '=', uid)]"/>
                <filter string="To Do" name="todo" domain="[('state', 'not in', ('done', 'cancelled', 'closed'))]"/>
                <group expand="0" string="Group By"><filter string="Status" name="gb_state" context="{'group_by': 'state'}"/></group>
            </search>
        </field>
    </record>
</odoo>
