<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_reservation_invoice">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <div class="page">
                    <h2>Reservation Invoice</h2>
                    <p>
                        Invoice for reservation <strong t-field="doc.name"/>
                        for traveler <strong t-field="doc.traveler_name"/>.
                    </p>
                    <table class="table table-sm">
                        <tr>
                            <td><strong>Package</strong></td>
                            <td t-field="doc.package_id.name"/>
                        </tr>
                        <tr>
                            <td><strong>Traveler</strong></td>
                            <td t-field="doc.traveler_name"/>
                        </tr>
                        <tr>
                            <td><strong>Travelers</strong></td>
                            <td t-field="doc.pax"/>
                        </tr>
                        <tr>
                            <td><strong>Price</strong></td>
                            <td><span t-field="doc.price_unit"/> <span t-field="doc.currency_id"/></td>
                        </tr>
                        <tr>
                            <td><strong>Commission</strong></td>
                            <td><span t-field="doc.commission"/> <span t-field="doc.currency_id"/></td>
                        </tr>
                        <tr>
                            <td><strong>Total Due</strong></td>
                            <td><span t-field="doc.price_unit"/> <span t-field="doc.currency_id"/></td>
                        </tr>
                    </table>
                </div>
            </t>
        </t>
    </template>
</odoo>
