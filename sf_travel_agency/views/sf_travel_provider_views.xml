<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sf_travel_provider_view_list" model="ir.ui.view">
        <field name="name">sf.travel.provider.list</field>
        <field name="model">sf.travel.provider</field>
        <field name="arch" type="xml">
            <list string="Providers">
                <field name="name"/>
                <field name="provider_type"/>
                <field name="partner_id"/>
                <field name="email"/>
                <field name="phone"/>
                <field name="state" widget="badge" decoration-success="state == 'confirmed'" decoration-muted="state == 'archived'"/>
            </list>
        </field>
    </record>

    <record id="sf_travel_provider_view_form" model="ir.ui.view">
        <field name="name">sf.travel.provider.form</field>
        <field name="model">sf.travel.provider</field>
        <field name="arch" type="xml">
            <form string="Travel Provider">
                <header>
                    <button name="action_confirm" type="object" string="Confirm" invisible="state == 'confirmed'"/>
                    <button name="action_archive" type="object" string="Archive" invisible="state == 'archived'" confirm="Are you sure you want to archive this provider?"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="provider_type"/>
                            <field name="partner_id"/>
                            <field name="contact_name"/>
                            <field name="email"/>
                            <field name="phone"/>
                            <field name="contract_ref"/>
                        </group>
                        <group>
                            <field name="active"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="sf_travel_provider_view_search" model="ir.ui.view">
        <field name="name">sf.travel.provider.search</field>
        <field name="model">sf.travel.provider</field>
        <field name="arch" type="xml">
            <search string="Search Providers">
                <field name="name"/>
                <field name="provider_type"/>
                <field name="partner_id"/>
                <group>
                    <filter string="Confirmed" name="filter_confirmed" domain="[('state', '=', 'confirmed')]"/>
                    <separator/>
                    <group string="Group By">
                        <filter string="Provider Type" name="group_by_type" context="{'group_by': 'provider_type'}"/>
                        <filter string="State" name="group_by_state" context="{'group_by': 'state'}"/>
                    </group>
                </group>
            </search>
        </field>
    </record>

    <record id="action_sf_travel_provider" model="ir.actions.act_window">
        <field name="name">Providers</field>
        <field name="res_model">sf.travel.provider</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
