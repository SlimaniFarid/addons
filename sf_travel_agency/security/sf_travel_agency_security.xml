<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="module_category_sf_travel_agency" model="ir.module.category">
            <field name="name">Travel Agency</field>
            <field name="sequence">20</field>
        </record>

        <record id="group_sf_travel_agency_user" model="res.groups">
            <field name="name">Travel Agency / User</field>
            <field name="category_id" ref="module_category_sf_travel_agency"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_sf_travel_agency_manager" model="res.groups">
            <field name="name">Travel Agency / Manager</field>
            <field name="category_id" ref="module_category_sf_travel_agency"/>
            <field name="implied_ids" eval="[(4, ref('group_sf_travel_agency_user'))]"/>
        </record>

        <record id="rule_sf_travel_package_company" model="ir.rule">
            <field name="name">Package: own company</field>
            <field name="model_id" ref="model_sf_travel_package"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('group_sf_travel_agency_user'))]"/>
        </record>
        <record id="rule_sf_travel_package_manager" model="ir.rule">
            <field name="name">Package: all companies</field>
            <field name="model_id" ref="model_sf_travel_package"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_sf_travel_agency_manager'))]"/>
        </record>

        <record id="rule_sf_travel_provider_company" model="ir.rule">
            <field name="name">Provider: own company</field>
            <field name="model_id" ref="model_sf_travel_provider"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('group_sf_travel_agency_user'))]"/>
        </record>
        <record id="rule_sf_travel_provider_manager" model="ir.rule">
            <field name="name">Provider: all companies</field>
            <field name="model_id" ref="model_sf_travel_provider"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_sf_travel_agency_manager'))]"/>
        </record>

        <record id="rule_sf_travel_reservation_company" model="ir.rule">
            <field name="name">Reservation: own company</field>
            <field name="model_id" ref="model_sf_travel_reservation"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('group_sf_travel_agency_user'))]"/>
        </record>
        <record id="rule_sf_travel_reservation_manager" model="ir.rule">
            <field name="name">Reservation: all companies</field>
            <field name="model_id" ref="model_sf_travel_reservation"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_sf_travel_agency_manager'))]"/>
        </record>

        <record id="rule_sf_travel_provider_cost_company" model="ir.rule">
            <field name="name">Provider Cost: own company</field>
            <field name="model_id" ref="model_sf_travel_provider_cost"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('group_sf_travel_agency_user'))]"/>
        </record>
        <record id="rule_sf_travel_provider_cost_manager" model="ir.rule">
            <field name="name">Provider Cost: all companies</field>
            <field name="model_id" ref="model_sf_travel_provider_cost"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_sf_travel_agency_manager'))]"/>
        </record>
    </data>
</odoo>
