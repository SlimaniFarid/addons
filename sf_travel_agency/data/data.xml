<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_sf_travel_package" model="ir.sequence">
            <field name="name">Travel Package</field>
            <field name="code">sf.travel.package</field>
            <field name="prefix">PKG-</field>
            <field name="padding">5</field>
            <field name="number_increment">1</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_sf_travel_provider" model="ir.sequence">
            <field name="name">Travel Provider</field>
            <field name="code">sf.travel.provider</field>
            <field name="prefix">PRV-</field>
            <field name="padding">5</field>
            <field name="number_increment">1</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_sf_travel_reservation" model="ir.sequence">
            <field name="name">Travel Reservation</field>
            <field name="code">sf.travel.reservation</field>
            <field name="prefix">RSV-</field>
            <field name="padding">5</field>
            <field name="number_increment">1</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_sf_travel_provider_cost" model="ir.sequence">
            <field name="name">Provider Cost</field>
            <field name="code">sf.travel.provider.cost</field>
            <field name="prefix">CST-</field>
            <field name="padding">5</field>
            <field name="number_increment">1</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="ir_cron_sf_travel_agency_daily_alert" model="ir.cron">
            <field name="name">Travel Agency: Daily Departure and Unpaid Alerts</field>
            <field name="model_id" ref="model_sf_travel_package"/>
            <field name="state">code</field>
            <field name="code">model._cron_departure_and_unpaid_alerts()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="active">True</field>
        </record>
    </data>
</odoo>
