<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_lead_score_list" model="ir.ui.view">
        <field name="name">sf.lead.scoring.ai.lead.score.list</field>
        <field name="model">sf.lead.scoring.ai.lead.score</field>
        <field name="arch" type="xml">
            <list string="Lead.Score">
                <field name="lead_id"/>
                <field name="total_score"/>
                <field name="grade"/>
                <field name="scored_date"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_lead_score_form" model="ir.ui.view">
        <field name="name">sf.lead.scoring.ai.lead.score.form</field>
        <field name="model">sf.lead.scoring.ai.lead.score</field>
        <field name="arch" type="xml">
            <form string="Lead.Score">
                <header>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" placeholder="Name"/></h1></div>
                    <group><group>
                            <field name="lead_id"/>
                            <field name="total_score"/>
                            <field name="grade"/>
                            <field name="scored_date"/>
                    </group>
                    <group>
                        <field name="currency_id" invisible="1"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_lead_score" model="ir.actions.act_window">
        <field name="name">Lead.Score</field>
        <field name="res_model">sf.lead.scoring.ai.lead.score</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
