<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_lead_score_list" model="ir.ui.view">
        <field name="name">sf.lead.scoring.ai.lead.score.list</field>
        <field name="model">sf.lead.scoring.ai.lead.score</field>
        <field name="arch" type="xml">
            <list string="Lead Scores" decoration-success="grade == 'A'"
                  decoration-info="grade == 'B'">
                <field name="lead_id"/>
                <field name="total_score"/>
                <field name="grade"/>
                <field name="matched_rule_ids" widget="many2many_tags"/>
                <field name="scored_date"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_lead_score_form" model="ir.ui.view">
        <field name="name">sf.lead.scoring.ai.lead.score.form</field>
        <field name="model">sf.lead.scoring.ai.lead.score</field>
        <field name="arch" type="xml">
            <form string="Lead Score">
                <header>
                    <button name="action_recompute" type="object"
                            string="Recompute" class="btn-primary"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="lead_id"/></h1></div>
                    <group><group>
                            <field name="lead_id"/>
                            <field name="total_score"/>
                            <field name="grade"/>
                            <field name="scored_date"/>
                    </group>
                    <group>
                        <field name="matched_rule_ids" widget="many2many_tags"/>
                        <field name="currency_id" invisible="1"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_lead_score" model="ir.actions.act_window">
        <field name="name">Lead Scores</field>
        <field name="res_model">sf.lead.scoring.ai.lead.score</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Run scoring on every open lead -->
    <record id="server_action_score_all_leads" model="ir.actions.server">
        <field name="name">Run Lead Scoring</field>
        <field name="model_id" ref="model_sf_lead_scoring_ai_lead_score"/>
        <field name="binding_model_id" ref="model_sf_lead_scoring_ai_lead_score"/>
        <field name="state">code</field>
        <field name="code">action = records.action_score_all_leads()</field>
    </record>
</odoo>
