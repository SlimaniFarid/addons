<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_scoring_rule_list" model="ir.ui.view">
        <field name="name">sf.lead.scoring.ai.scoring.rule.list</field>
        <field name="model">sf.lead.scoring.ai.scoring.rule</field>
        <field name="arch" type="xml">
            <list string="Scoring.Rule">
                <field name="name"/>
                <field name="field_name"/>
                <field name="operator"/>
                <field name="score_value"/>
                <field name="sequence"/>
                <field name="active"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_scoring_rule_form" model="ir.ui.view">
        <field name="name">sf.lead.scoring.ai.scoring.rule.form</field>
        <field name="model">sf.lead.scoring.ai.scoring.rule</field>
        <field name="arch" type="xml">
            <form string="Scoring.Rule">
                <header>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" placeholder="Name"/></h1></div>
                    <group><group>
                            <field name="name"/>
                            <field name="field_name"/>
                            <field name="operator"/>
                            <field name="score_value"/>
                            <field name="sequence"/>
                            <field name="active"/>
                    </group>
                    <group>
                        <field name="currency_id" invisible="1"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_scoring_rule" model="ir.actions.act_window">
        <field name="name">Scoring.Rule</field>
        <field name="res_model">sf.lead.scoring.ai.scoring.rule</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
