<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_telecom_line" model="ir.actions.act_window">
        <field name="name">Telecom Lines</field>
        <field name="res_model">sf.telecom.line</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_sf_telecom_audit" model="ir.actions.act_window">
        <field name="name">Invoice Audits</field>
        <field name="res_model">sf.telecom.audit</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="view_sf_telecom_line_form" model="ir.ui.view">
        <field name="name">sf.telecom.line.form</field>
        <field name="model">sf.telecom.line</field>
        <field name="arch" type="xml">
            <form string="Telecom Line">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="employee_id"/>
                            <field name="department"/>
                            <field name="provider"/>
                        </group>
                        <group>
                            <field name="phone_number"/>
                            <field name="line_type"/>
                            <field name="monthly_cost"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group>
                            <field name="contract_start"/>
                            <field name="contract_end"/>
                            <field name="contract_ending_soon" readonly="1"
                                   widget="boolean"/>
                        </group>
                        <group>
                            <field name="active" widget="boolean_toggle"/>
                            <field name="company_id"
                                   groups="base.group_multi_company"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_telecom_line_list" model="ir.ui.view">
        <field name="name">sf.telecom.line.list</field>
        <field name="model">sf.telecom.line</field>
        <field name="arch" type="xml">
            <list string="Telecom Lines" sample="1" decoration-warning="contract_ending_soon">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="provider"/>
                <field name="phone_number" optional="show"/>
                <field name="line_type"/>
                <field name="monthly_cost"/>
                <field name="contract_end"/>
                <field name="active" widget="boolean"/>
            </list>
        </field>
    </record>
    <record id="view_sf_telecom_audit_form" model="ir.ui.view">
        <field name="name">sf.telecom.audit.form</field>
        <field name="model">sf.telecom.audit</field>
        <field name="arch" type="xml">
            <form string="Invoice Audit">
                <header>
                    <button name="action_compute_expected" type="object"
                            string="Compute Expected Cost"/>
                    <button name="action_mark_reviewed" type="object"
                            string="Mark Reviewed" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,done"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="provider"/>
                            <field name="period_month"/>
                            <field name="invoiced_amount"/>
                        </group>
                        <group>
                            <field name="expected_cost" readonly="1"/>
                            <field name="variance" readonly="1"/>
                            <field name="variance_percent" readonly="1"/>
                            <field name="tolerance_percent"/>
                            <field name="alert" readonly="1" widget="boolean"/>
                        </group>
                    </group>
                    <group string="Notes">
                        <field name="notes"/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_telecom_audit_list" model="ir.ui.view">
        <field name="name">sf.telecom.audit.list</field>
        <field name="model">sf.telecom.audit</field>
        <field name="arch" type="xml">
            <list string="Invoice Audits" sample="1" decoration-danger="alert">
                <field name="name"/>
                <field name="provider"/>
                <field name="period_month"/>
                <field name="expected_cost"/>
                <field name="invoiced_amount"/>
                <field name="variance_percent"/>
                <field name="alert" widget="boolean"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"/>
            </list>
        </field>
    </record>
    <menuitem id="menu_sf_tel_root" name="Telecom Expense" sequence="18"
              web_icon="sf_telecom_expense,static/description/icon.png"/>
    <menuitem id="menu_sf_tel_lines" name="Telecom Lines"
              parent="menu_sf_tel_root" action="action_sf_telecom_line"
              sequence="10"/>
    <menuitem id="menu_sf_tel_audits" name="Invoice Audits"
              parent="menu_sf_tel_root" action="action_sf_telecom_audit"
              sequence="20"/>
</odoo>
