<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_sf_tel" model="ir.module.category">
        <field name="name">Telecom Expense</field>
        <field name="sequence">68</field>
    </record>
    <record id="group_sf_tel_user" model="res.groups">
        <field name="name">Telecom Expense User</field>
        <field name="category_id" ref="module_category_sf_tel"/>
    </record>
    <record id="group_sf_tel_manager" model="res.groups">
        <field name="name">Telecom Expense Manager</field>
        <field name="category_id" ref="module_category_sf_tel"/>
        <field name="implied_ids" eval="[(4, ref('group_sf_tel_user'))]"/>
    </record>
    <record id="rule_sf_tel_line_company" model="ir.rule">
        <field name="name">Telecom Line: multi-company</field>
        <field name="model_id" ref="model_sf_telecom_line"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_sf_tel_audit_company" model="ir.rule">
        <field name="name">Telecom Audit: multi-company</field>
        <field name="model_id" ref="model_sf_telecom_audit"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_sf_tel"/>
    </record>
</odoo>
