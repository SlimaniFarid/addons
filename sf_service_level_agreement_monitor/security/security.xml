<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_service_level_agreement_monitor" model="ir.module.category">
        <field name="name">Internal SLA Monitor</field>
        <field name="sequence">163</field>
    </record>
    <record id="group_service_level_agreement_monitor_user" model="res.groups">
        <field name="name">Internal SLA Monitor User</field>
        <field name="category_id" ref="module_category_service_level_agreement_monitor"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>

    </record>
    <record id="group_service_level_agreement_monitor_manager" model="res.groups">
        <field name="name">Internal SLA Monitor Manager</field>
        <field name="category_id" ref="module_category_service_level_agreement_monitor"/>
        <field name="implied_ids" eval="[(4, ref('group_service_level_agreement_monitor_user'))]"/>
    </record>
    <record id="rule_service_level_agreement_monitor_sf_service_level_agreement_monitor" model="ir.rule">
        <field name="name">Internal SLA Monitor: multi-company</field>
        <field name="model_id" ref="model_sf_service_level_agreement_monitor"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
