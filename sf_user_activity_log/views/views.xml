<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_user_activity_log" model="ir.actions.act_window">
        <field name="name">User Activity Summary</field>
        <field name="res_model">sf.user_activity_log</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
    <record id="view_sf_user_activity_log_form" model="ir.ui.view">
        <field name="name">sf.user_activity_log.form</field>
        <field name="model">sf.user_activity_log</field>
        <field name="arch" type="xml">
            <form string="User Activity Summary">
                <header>
                    <button name="action_submitted" type="object" string="Submitted"
                            class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="log_date"/>
                            <field name="user_id"/>
                            <field name="login_count"/>
                            <field name="records_created"/>
                            <field name="records_modified"/>
                            <field name="anomaly_note"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_user_activity_log_list" model="ir.ui.view">
        <field name="name">sf.user_activity_log.list</field>
        <field name="model">sf.user_activity_log</field>
        <field name="arch" type="xml">
            <list string="User Activity Summary" sample="1">
                <field name="log_date"/>
                <field name="user_id"/>
                <field name="login_count"/>
                <field name="records_created"/>
                <field name="records_modified"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state in ('submitted','approved')"/>
            </list>
        </field>
    </record>
    <record id="view_sf_user_activity_log_kanban" model="ir.ui.view">
        <field name="name">sf.user_activity_log.kanban</field>
        <field name="model">sf.user_activity_log</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_view" group_by="state">
                <field name="name"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <menuitem id="menu_sf_user_activity_log_root" name="User Activity Summary" sequence="19"
              web_icon="sf_user_activity_log,static/description/icon.png"/>
    <menuitem id="menu_sf_user_activity_log_main" name="Records"
              parent="menu_sf_user_activity_log_root" action="action_sf_user_activity_log" sequence="10"/>
</odoo>
