<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_user_activity_log" model="ir.module.category">
        <field name="name">User Activity Summary</field>
        <field name="sequence">382</field>
    </record>
    <record id="group_user_activity_log_user" model="res.groups">
        <field name="name">User Activity Summary User</field>
        <field name="category_id" ref="module_category_user_activity_log"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>

    </record>
    <record id="group_user_activity_log_manager" model="res.groups">
        <field name="name">User Activity Summary Manager</field>
        <field name="category_id" ref="module_category_user_activity_log"/>
        <field name="implied_ids" eval="[(4, ref('group_user_activity_log_user'))]"/>
    </record>
    <record id="rule_user_activity_log_sf_user_activity_log" model="ir.rule">
        <field name="name">User Activity Summary: multi-company</field>
        <field name="model_id" ref="model_sf_user_activity_log"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
