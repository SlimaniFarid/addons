<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_production_scrap_analytics" model="ir.actions.act_window">
        <field name="name">Scrap Analytics &amp; Cost</field>
        <field name="res_model">sf.production_scrap_analytics</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
    <record id="view_sf_production_scrap_analytics_form" model="ir.ui.view">
        <field name="name">sf.production_scrap_analytics.form</field>
        <field name="model">sf.production_scrap_analytics</field>
        <field name="arch" type="xml">
            <form string="Scrap Analytics &amp; Cost">
                <header>
                    <button name="action_submitted" type="object" string="Submitted"
                            class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="period"/>
                            <field name="product_id"/>
                            <field name="scrap_qty"/>
                            <field name="scrap_cost"/>
                            <field name="reason_code"/>
                            <field name="reduction_target"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_production_scrap_analytics_list" model="ir.ui.view">
        <field name="name">sf.production_scrap_analytics.list</field>
        <field name="model">sf.production_scrap_analytics</field>
        <field name="arch" type="xml">
            <list string="Scrap Analytics &amp; Cost" sample="1">
                <field name="period"/>
                <field name="product_id"/>
                <field name="scrap_qty"/>
                <field name="scrap_cost"/>
                <field name="reason_code"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state in ('submitted','approved')"/>
            </list>
        </field>
    </record>
    <record id="view_sf_production_scrap_analytics_kanban" model="ir.ui.view">
        <field name="name">sf.production_scrap_analytics.kanban</field>
        <field name="model">sf.production_scrap_analytics</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_view" group_by="state">
                <field name="name"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <menuitem id="menu_sf_production_scrap_analytics_root" name="Scrap Analytics &amp; Cost" sequence="18"
              web_icon="sf_production_scrap_analytics,static/description/icon.png"/>
    <menuitem id="menu_sf_production_scrap_analytics_main" name="Records"
              parent="menu_sf_production_scrap_analytics_root" action="action_sf_production_scrap_analytics" sequence="10"/>

    <record id="wave_final_sf_production_scrap_analytics" model="ir.actions.server">
        <field name="name">Refresh Business Data</field>
        <field name="model_id" ref="model_sf_production_scrap_analytics"/>
        <field name="binding_model_id" ref="model_sf_production_scrap_analytics"/>
        <field name="state">code</field>
        <field name="code">records.action_refresh_business()</field>
    </record>
</odoo>
