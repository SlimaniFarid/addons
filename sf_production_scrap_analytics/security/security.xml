<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_production_scrap_analytics" model="ir.module.category">
        <field name="name">Scrap Analytics &amp; Cost</field>
        <field name="sequence">683</field>
    </record>
    <record id="group_production_scrap_analytics_user" model="res.groups">
        <field name="name">Scrap Analytics &amp; Cost User</field>
        <field name="category_id" ref="module_category_production_scrap_analytics"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>

    </record>
    <record id="group_production_scrap_analytics_manager" model="res.groups">
        <field name="name">Scrap Analytics &amp; Cost Manager</field>
        <field name="category_id" ref="module_category_production_scrap_analytics"/>
        <field name="implied_ids" eval="[(4, ref('group_production_scrap_analytics_user'))]"/>
    </record>
    <record id="rule_production_scrap_analytics_sf_production_scrap_analytics" model="ir.rule">
        <field name="name">Scrap Analytics &amp; Cost: multi-company</field>
        <field name="model_id" ref="model_sf_production_scrap_analytics"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_production_scrap_analytics"/>
    </record>
</odoo>
