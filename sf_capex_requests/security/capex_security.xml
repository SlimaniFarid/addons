<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_sf_capex" model="ir.module.category">
        <field name="name">CAPEX Management</field>
        <field name="sequence">90</field>
    </record>
    <record id="group_sf_capex_user" model="res.groups">
        <field name="name">CAPEX Requester</field>
        <field name="category_id" ref="module_category_sf_capex"/>
    </record>
    <record id="group_sf_capex_manager" model="res.groups">
        <field name="name">CAPEX Manager</field>
        <field name="category_id" ref="module_category_sf_capex"/>
        <field name="implied_ids" eval="[(4, ref('group_sf_capex_user'))]"/>
    </record>
    <record id="rule_sf_capex_company" model="ir.rule">
        <field name="name">CAPEX Request: multi-company</field>
        <field name="model_id" ref="model_sf_capex_request"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
