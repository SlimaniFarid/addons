<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_customer_pain_point" model="ir.actions.act_window">
        <field name="name">Customer Pain Point Register</field>
        <field name="res_model">sf.customer_pain_point</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
    <record id="view_sf_customer_pain_point_form" model="ir.ui.view">
        <field name="name">sf.customer_pain_point.form</field>
        <field name="model">sf.customer_pain_point</field>
        <field name="arch" type="xml">
            <form string="Customer Pain Point Register">
                <header>
                    <button name="action_submitted" type="object" string="Submitted"
                            class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="pain_point"/>
                            <field name="severity"/>
                            <field name="product_impact"/>
                            <field name="resolution_status"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_customer_pain_point_list" model="ir.ui.view">
        <field name="name">sf.customer_pain_point.list</field>
        <field name="model">sf.customer_pain_point</field>
        <field name="arch" type="xml">
            <list string="Customer Pain Point Register" sample="1">
                <field name="partner_id"/>
                <field name="pain_point"/>
                <field name="severity"/>
                <field name="product_impact"/>
                <field name="resolution_status"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state in ('submitted','approved')"/>
            </list>
        </field>
    </record>
    <record id="view_sf_customer_pain_point_kanban" model="ir.ui.view">
        <field name="name">sf.customer_pain_point.kanban</field>
        <field name="model">sf.customer_pain_point</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_view" group_by="state">
                <field name="name"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <menuitem id="menu_sf_customer_pain_point_root" name="Customer Pain Point Register" sequence="6"
              web_icon="sf_customer_pain_point,static/description/icon.png"/>
    <menuitem id="menu_sf_customer_pain_point_main" name="Records"
              parent="menu_sf_customer_pain_point_root" action="action_sf_customer_pain_point" sequence="10"/>
</odoo>
