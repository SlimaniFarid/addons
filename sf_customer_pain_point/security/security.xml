<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_customer_pain_point" model="ir.module.category">
        <field name="name">Customer Pain Point Register</field>
        <field name="sequence">695</field>
    </record>
    <record id="group_customer_pain_point_user" model="res.groups">
        <field name="name">Customer Pain Point Register User</field>
        <field name="category_id" ref="module_category_customer_pain_point"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>

    </record>
    <record id="group_customer_pain_point_manager" model="res.groups">
        <field name="name">Customer Pain Point Register Manager</field>
        <field name="category_id" ref="module_category_customer_pain_point"/>
        <field name="implied_ids" eval="[(4, ref('group_customer_pain_point_user'))]"/>
    </record>
    <record id="rule_customer_pain_point_sf_customer_pain_point" model="ir.rule">
        <field name="name">Customer Pain Point Register: multi-company</field>
        <field name="model_id" ref="model_sf_customer_pain_point"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
