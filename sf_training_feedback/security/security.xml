<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_training_feedback" model="ir.module.category">
        <field name="name">Training Feedback Collection</field>
        <field name="sequence">10</field>
    </record>
    <record id="group_training_feedback_user" model="res.groups">
        <field name="name">Training Feedback Collection User</field>
        <field name="category_id" ref="module_category_training_feedback"/>

    </record>
    <record id="group_training_feedback_manager" model="res.groups">
        <field name="name">Training Feedback Collection Manager</field>
        <field name="category_id" ref="module_category_training_feedback"/>
        <field name="implied_ids" eval="[(4, ref('group_training_feedback_user'))]"/>
    </record>
    <record id="rule_training_feedback_sf_training_feedback" model="ir.rule">
        <field name="name">Training Feedback: multi-company</field>
        <field name="model_id" ref="model_sf_training_feedback"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
