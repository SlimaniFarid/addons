<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_training_feedback" model="ir.actions.act_window">
        <field name="name">Training Feedback Collection</field>
        <field name="res_model">sf.training.feedback</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
    <record id="view_sf_training_feedback_form" model="ir.ui.view">
        <field name="name">sf.training.feedback.form</field>
        <field name="model">sf.training.feedback</field>
        <field name="arch" type="xml">
            <form string="Training Feedback Collection">
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="collected,reviewed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="session_label"/>
                            <field name="employee_id"/>
                            <field name="rating"/>
                            <field name="trainer_rating"/>
                            <field name="comments"/>
                            <field name="would_recommend"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_training_feedback_list" model="ir.ui.view">
        <field name="name">sf.training.feedback.list</field>
        <field name="model">sf.training.feedback</field>
        <field name="arch" type="xml">
            <list string="Training Feedback Collection" sample="1">
                <field name="session_label"/>
                <field name="employee_id"/>
                <field name="rating"/>
                <field name="trainer_rating"/>
                <field name="comments"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state in ('submitted','approved')"/>
            </list>
        </field>
    </record>
    <record id="view_sf_training_feedback_kanban" model="ir.ui.view">
        <field name="name">sf.training.feedback.kanban</field>
        <field name="model">sf.training.feedback</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_view" group_by="state">
                <field name="name"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <menuitem id="menu_sf_training_feedback_root" name="Training Feedback Collection" sequence="29"
              web_icon="sf_training_feedback,static/description/icon.png"/>
    <menuitem id="menu_sf_training_feedback_main" name="Records"
              parent="menu_sf_training_feedback_root" action="action_sf_training_feedback" sequence="10"/>
</odoo>
