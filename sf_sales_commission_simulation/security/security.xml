<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_sales_commission_simulation" model="ir.module.category">
        <field name="name">Sales Commission Simulator</field>
        <field name="sequence">263</field>
    </record>
    <record id="group_sales_commission_simulation_user" model="res.groups">
        <field name="name">Sales Commission Simulator User</field>
        <field name="category_id" ref="module_category_sales_commission_simulation"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>

    </record>
    <record id="group_sales_commission_simulation_manager" model="res.groups">
        <field name="name">Sales Commission Simulator Manager</field>
        <field name="category_id" ref="module_category_sales_commission_simulation"/>
        <field name="implied_ids" eval="[(4, ref('group_sales_commission_simulation_user'))]"/>
    </record>
    <record id="rule_sales_commission_simulation_sf_sales_commission_simulation" model="ir.rule">
        <field name="name">Sales Commission Simulator: multi-company</field>
        <field name="model_id" ref="model_sf_sales_commission_simulation"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
