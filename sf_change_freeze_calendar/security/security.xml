<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_change_freeze_calendar" model="ir.module.category">
        <field name="name">Change Freeze Calendar</field>
        <field name="sequence">45</field>
    </record>
    <record id="group_change_freeze_calendar_user" model="res.groups">
        <field name="name">Change Freeze Calendar User</field>
        <field name="category_id" ref="module_category_change_freeze_calendar"/>

    </record>
    <record id="group_change_freeze_calendar_manager" model="res.groups">
        <field name="name">Change Freeze Calendar Manager</field>
        <field name="category_id" ref="module_category_change_freeze_calendar"/>
        <field name="implied_ids" eval="[(4, ref('group_change_freeze_calendar_user'))]"/>
    </record>
    <record id="rule_change_freeze_calendar_sf_freeze_window" model="ir.rule">
        <field name="name">Freeze Window: multi-company</field>
        <field name="model_id" ref="model_sf_freeze_window"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
