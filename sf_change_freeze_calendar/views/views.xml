<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_freeze_window" model="ir.actions.act_window">
        <field name="name">Change Freeze Calendar</field>
        <field name="res_model">sf.freeze.window</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
    <record id="view_sf_freeze_window_form" model="ir.ui.view">
        <field name="name">sf.freeze.window.form</field>
        <field name="model">sf.freeze.window</field>
        <field name="arch" type="xml">
            <form string="Change Freeze Calendar">
                <header>
                    <button name="action_active" type="object" string="Active"
                            class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="scheduled,active,ended"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="scope"/>
                            <field name="start"/>
                            <field name="end"/>
                            <field name="exception_process"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_freeze_window_list" model="ir.ui.view">
        <field name="name">sf.freeze.window.list</field>
        <field name="model">sf.freeze.window</field>
        <field name="arch" type="xml">
            <list string="Change Freeze Calendar" sample="1">
                <field name="name"/>
                <field name="scope"/>
                <field name="start"/>
                <field name="end"/>
                <field name="exception_process"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state in ('submitted','approved')"/>
            </list>
        </field>
    </record>
    <record id="view_sf_freeze_window_kanban" model="ir.ui.view">
        <field name="name">sf.freeze.window.kanban</field>
        <field name="model">sf.freeze.window</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_view" group_by="state">
                <field name="name"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <menuitem id="menu_sf_freeze_window_root" name="Change Freeze Calendar" sequence="7"
              web_icon="sf_change_freeze_calendar,static/description/icon.png"/>
    <menuitem id="menu_sf_freeze_window_main" name="Records"
              parent="menu_sf_freeze_window_root" action="action_sf_freeze_window" sequence="10"/>
</odoo>
