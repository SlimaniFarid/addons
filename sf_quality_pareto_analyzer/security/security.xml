<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_quality_pareto_analyzer" model="ir.module.category">
        <field name="name">Quality Pareto Analyzer</field>
        <field name="sequence">180</field>
    </record>
    <record id="group_quality_pareto_analyzer_user" model="res.groups">
        <field name="name">Quality Pareto Analyzer User</field>
        <field name="category_id" ref="module_category_quality_pareto_analyzer"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>

    </record>
    <record id="group_quality_pareto_analyzer_manager" model="res.groups">
        <field name="name">Quality Pareto Analyzer Manager</field>
        <field name="category_id" ref="module_category_quality_pareto_analyzer"/>
        <field name="implied_ids" eval="[(4, ref('group_quality_pareto_analyzer_user'))]"/>
    </record>
    <record id="rule_quality_pareto_analyzer_sf_quality_pareto_analyzer" model="ir.rule">
        <field name="name">Quality Pareto Analyzer: multi-company</field>
        <field name="model_id" ref="model_sf_quality_pareto_analyzer"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_quality_pareto_analyzer"/>
    </record>
</odoo>
