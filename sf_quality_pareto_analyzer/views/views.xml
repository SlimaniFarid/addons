<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_quality_pareto_analyzer" model="ir.actions.act_window">
        <field name="name">Quality Pareto Analyzer</field>
        <field name="res_model">sf.quality_pareto_analyzer</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
    <record id="view_sf_quality_pareto_analyzer_form" model="ir.ui.view">
        <field name="name">sf.quality_pareto_analyzer.form</field>
        <field name="model">sf.quality_pareto_analyzer</field>
        <field name="arch" type="xml">
            <form string="Quality Pareto Analyzer">
                <header>
                    <button name="action_submitted" type="object" string="Submitted"
                            class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="defect_type"/>
                            <field name="occurrences"/>
                            <field name="cost"/>
                            <field name="cumulative_percent"/>
                            <field name="priority"/>
                            <field name="action_ref"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_quality_pareto_analyzer_list" model="ir.ui.view">
        <field name="name">sf.quality_pareto_analyzer.list</field>
        <field name="model">sf.quality_pareto_analyzer</field>
        <field name="arch" type="xml">
            <list string="Quality Pareto Analyzer" sample="1">
                <field name="defect_type"/>
                <field name="occurrences"/>
                <field name="cost"/>
                <field name="cumulative_percent"/>
                <field name="priority"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state in ('submitted','approved')"/>
            </list>
        </field>
    </record>
    <record id="view_sf_quality_pareto_analyzer_kanban" model="ir.ui.view">
        <field name="name">sf.quality_pareto_analyzer.kanban</field>
        <field name="model">sf.quality_pareto_analyzer</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_view" group_by="state">
                <field name="name"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <menuitem id="menu_sf_quality_pareto_analyzer_root" name="Quality Pareto Analyzer" sequence="21"
              web_icon="sf_quality_pareto_analyzer,static/description/icon.png"/>
    <menuitem id="menu_sf_quality_pareto_analyzer_main" name="Records"
              parent="menu_sf_quality_pareto_analyzer_root" action="action_sf_quality_pareto_analyzer" sequence="10"/>
</odoo>
