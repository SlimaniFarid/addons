<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_fx_reval" model="ir.actions.act_window">
        <field name="name">FX Revaluation Scheduler</field>
        <field name="res_model">sf.fx.reval</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
    <record id="view_sf_fx_reval_form" model="ir.ui.view">
        <field name="name">sf.fx.reval.form</field>
        <field name="model">sf.fx.reval</field>
        <field name="arch" type="xml">
            <form string="FX Revaluation Scheduler">
                <header>
                    <button name="action_computed" type="object" string="Computed"
                            class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,computed,posted"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="period_month"/>
                            <field name="total_gain"/>
                            <field name="total_loss"/>
                            <field name="item_count"/>
                            <field name="notes"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_fx_reval_list" model="ir.ui.view">
        <field name="name">sf.fx.reval.list</field>
        <field name="model">sf.fx.reval</field>
        <field name="arch" type="xml">
            <list string="FX Revaluation Scheduler" sample="1">
                <field name="period_month"/>
                <field name="total_gain"/>
                <field name="total_loss"/>
                <field name="item_count"/>
                <field name="notes"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state in ('submitted','approved')"/>
            </list>
        </field>
    </record>
    <record id="view_sf_fx_reval_kanban" model="ir.ui.view">
        <field name="name">sf.fx.reval.kanban</field>
        <field name="model">sf.fx.reval</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_view" group_by="state">
                <field name="name"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <menuitem id="menu_sf_fx_reval_root" name="FX Revaluation Scheduler" sequence="10"
              web_icon="sf_fx_reval_scheduler,static/description/icon.png"/>
    <menuitem id="menu_sf_fx_reval_main" name="Records"
              parent="menu_sf_fx_reval_root" action="action_sf_fx_reval" sequence="10"/>
</odoo>
