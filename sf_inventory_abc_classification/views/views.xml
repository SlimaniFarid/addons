<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_inventory_abc_classification" model="ir.actions.act_window">
        <field name="name">Inventory ABC Classification</field>
        <field name="res_model">sf.inventory_abc_classification</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
    <record id="view_sf_inventory_abc_classification_form" model="ir.ui.view">
        <field name="name">sf.inventory_abc_classification.form</field>
        <field name="model">sf.inventory_abc_classification</field>
        <field name="arch" type="xml">
            <form string="Inventory ABC Classification">
                <header>
                    <button name="action_submitted" type="object" string="Submitted"
                            class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="product_id"/>
                            <field name="annual_value"/>
                            <field name="movement_class"/>
                            <field name="abc_class"/>
                            <field name="count_frequency"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_inventory_abc_classification_list" model="ir.ui.view">
        <field name="name">sf.inventory_abc_classification.list</field>
        <field name="model">sf.inventory_abc_classification</field>
        <field name="arch" type="xml">
            <list string="Inventory ABC Classification" sample="1">
                <field name="product_id"/>
                <field name="annual_value"/>
                <field name="movement_class"/>
                <field name="abc_class"/>
                <field name="count_frequency"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state in ('submitted','approved')"/>
            </list>
        </field>
    </record>
    <record id="view_sf_inventory_abc_classification_kanban" model="ir.ui.view">
        <field name="name">sf.inventory_abc_classification.kanban</field>
        <field name="model">sf.inventory_abc_classification</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_view" group_by="state">
                <field name="name"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <menuitem id="menu_sf_inventory_abc_classification_root" name="Inventory ABC Classification" sequence="16"
              web_icon="sf_inventory_abc_classification,static/description/icon.png"/>
    <menuitem id="menu_sf_inventory_abc_classification_main" name="Records"
              parent="menu_sf_inventory_abc_classification_root" action="action_sf_inventory_abc_classification" sequence="10"/>
</odoo>
