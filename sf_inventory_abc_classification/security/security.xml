<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_inventory_abc_classification" model="ir.module.category">
        <field name="name">Inventory ABC Classification</field>
        <field name="sequence">285</field>
    </record>
    <record id="group_inventory_abc_classification_user" model="res.groups">
        <field name="name">Inventory ABC Classification User</field>
        <field name="category_id" ref="module_category_inventory_abc_classification"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>

    </record>
    <record id="group_inventory_abc_classification_manager" model="res.groups">
        <field name="name">Inventory ABC Classification Manager</field>
        <field name="category_id" ref="module_category_inventory_abc_classification"/>
        <field name="implied_ids" eval="[(4, ref('group_inventory_abc_classification_user'))]"/>
    </record>
    <record id="rule_inventory_abc_classification_sf_inventory_abc_classification" model="ir.rule">
        <field name="name">Inventory ABC Classification: multi-company</field>
        <field name="model_id" ref="model_sf_inventory_abc_classification"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_inventory_abc_classification"/>
    </record>
</odoo>
