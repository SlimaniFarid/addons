<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_quality_document_control" model="ir.module.category">
        <field name="name">Quality Document Control</field>
        <field name="sequence">261</field>
    </record>
    <record id="group_quality_document_control_user" model="res.groups">
        <field name="name">Quality Document Control User</field>
        <field name="category_id" ref="module_category_quality_document_control"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>

    </record>
    <record id="group_quality_document_control_manager" model="res.groups">
        <field name="name">Quality Document Control Manager</field>
        <field name="category_id" ref="module_category_quality_document_control"/>
        <field name="implied_ids" eval="[(4, ref('group_quality_document_control_user'))]"/>
    </record>
    <record id="rule_quality_document_control_sf_quality_document_control" model="ir.rule">
        <field name="name">Quality Document Control: multi-company</field>
        <field name="model_id" ref="model_sf_quality_document_control"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_quality_document_control"/>
    </record>
</odoo>
