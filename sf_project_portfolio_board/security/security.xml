<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_project_portfolio_board" model="ir.module.category">
        <field name="name">Project Portfolio Board</field>
        <field name="sequence">186</field>
    </record>
    <record id="group_project_portfolio_board_user" model="res.groups">
        <field name="name">Project Portfolio Board User</field>
        <field name="category_id" ref="module_category_project_portfolio_board"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>

    </record>
    <record id="group_project_portfolio_board_manager" model="res.groups">
        <field name="name">Project Portfolio Board Manager</field>
        <field name="category_id" ref="module_category_project_portfolio_board"/>
        <field name="implied_ids" eval="[(4, ref('group_project_portfolio_board_user'))]"/>
    </record>
    <record id="rule_project_portfolio_board_sf_project_portfolio_board" model="ir.rule">
        <field name="name">Project Portfolio Board: multi-company</field>
        <field name="model_id" ref="model_sf_project_portfolio_board"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_project_portfolio_board"/>
    </record>
</odoo>
