<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_project_portfolio_board" model="ir.actions.act_window">
        <field name="name">Project Portfolio Board</field>
        <field name="res_model">sf.project_portfolio_board</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
    <record id="view_sf_project_portfolio_board_form" model="ir.ui.view">
        <field name="name">sf.project_portfolio_board.form</field>
        <field name="model">sf.project_portfolio_board</field>
        <field name="arch" type="xml">
            <form string="Project Portfolio Board">
                <header>
                    <button name="action_submitted" type="object" string="Submitted"
                            class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="project_name"/>
                            <field name="status"/>
                            <field name="budget"/>
                            <field name="spent"/>
                            <field name="risk_level"/>
                            <field name="sponsor_id"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_project_portfolio_board_list" model="ir.ui.view">
        <field name="name">sf.project_portfolio_board.list</field>
        <field name="model">sf.project_portfolio_board</field>
        <field name="arch" type="xml">
            <list string="Project Portfolio Board" sample="1">
                <field name="project_name"/>
                <field name="status"/>
                <field name="budget"/>
                <field name="spent"/>
                <field name="risk_level"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state in ('submitted','approved')"/>
            </list>
        </field>
    </record>
    <record id="view_sf_project_portfolio_board_kanban" model="ir.ui.view">
        <field name="name">sf.project_portfolio_board.kanban</field>
        <field name="model">sf.project_portfolio_board</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_view" group_by="state">
                <field name="name"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <menuitem id="menu_sf_project_portfolio_board_root" name="Project Portfolio Board" sequence="15"
              web_icon="sf_project_portfolio_board,static/description/icon.png"/>
    <menuitem id="menu_sf_project_portfolio_board_main" name="Records"
              parent="menu_sf_project_portfolio_board_root" action="action_sf_project_portfolio_board" sequence="10"/>
</odoo>
