<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_customer_expansion_tracker" model="ir.module.category">
        <field name="name">Customer Expansion Tracker</field>
        <field name="sequence">691</field>
    </record>
    <record id="group_customer_expansion_tracker_user" model="res.groups">
        <field name="name">Customer Expansion Tracker User</field>
        <field name="category_id" ref="module_category_customer_expansion_tracker"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>

    </record>
    <record id="group_customer_expansion_tracker_manager" model="res.groups">
        <field name="name">Customer Expansion Tracker Manager</field>
        <field name="category_id" ref="module_category_customer_expansion_tracker"/>
        <field name="implied_ids" eval="[(4, ref('group_customer_expansion_tracker_user'))]"/>
    </record>
    <record id="rule_customer_expansion_tracker_sf_customer_expansion_tracker" model="ir.rule">
        <field name="name">Customer Expansion Tracker: multi-company</field>
        <field name="model_id" ref="model_sf_customer_expansion_tracker"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_customer_expansion_tracker"/>
    </record>
</odoo>
