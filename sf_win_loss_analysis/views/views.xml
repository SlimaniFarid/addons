<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_win_loss" model="ir.actions.act_window">
        <field name="name">Win / Loss Analysis Library</field>
        <field name="res_model">sf.win.loss</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
    <record id="view_sf_win_loss_form" model="ir.ui.view">
        <field name="name">sf.win.loss.form</field>
        <field name="model">sf.win.loss</field>
        <field name="arch" type="xml">
            <form string="Win / Loss Analysis Library">
                <header>
                    <button name="action_analyzed" type="object" string="Analyzed"
                            class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="open,analyzed,shared"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="outcome"/>
                            <field name="primary_reason"/>
                            <field name="competitor"/>
                            <field name="price_gap_percent"/>
                        <field name="lessons"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_win_loss_list" model="ir.ui.view">
        <field name="name">sf.win.loss.list</field>
        <field name="model">sf.win.loss</field>
        <field name="arch" type="xml">
            <list string="Win / Loss Analysis Library" sample="1">
                <field name="partner_id"/>
                <field name="outcome"/>
                <field name="primary_reason"/>
                <field name="competitor"/>
                <field name="price_gap_percent"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state in ('submitted','approved')"/>
            </list>
        </field>
    </record>
    <record id="view_sf_win_loss_kanban" model="ir.ui.view">
        <field name="name">sf.win.loss.kanban</field>
        <field name="model">sf.win.loss</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_view" group_by="state">
                <field name="name"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <menuitem id="menu_sf_win_loss_root" name="Win / Loss Analysis Library" sequence="13"
              web_icon="sf_win_loss_analysis,static/description/icon.png"/>
    <menuitem id="menu_sf_win_loss_main" name="Records"
              parent="menu_sf_win_loss_root" action="action_sf_win_loss" sequence="10"/>

    <record id="wave2_winloss_analyze" model="ir.actions.server">
        <field name="name">Analyze Win/Loss KPIs</field>
        <field name="model_id" ref="model_sf_win_loss"/>
        <field name="binding_model_id" ref="model_sf_win_loss"/>
        <field name="state">code</field>
        <field name="code">records.action_analyze()</field>
    </record>
</odoo>
