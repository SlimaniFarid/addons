<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_win_loss_analysis" model="ir.module.category">
        <field name="name">Win / Loss Analysis Library</field>
        <field name="sequence">48</field>
    </record>
    <record id="group_win_loss_analysis_user" model="res.groups">
        <field name="name">Win / Loss Analysis Library User</field>
        <field name="category_id" ref="module_category_win_loss_analysis"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>

    </record>
    <record id="group_win_loss_analysis_manager" model="res.groups">
        <field name="name">Win / Loss Analysis Library Manager</field>
        <field name="category_id" ref="module_category_win_loss_analysis"/>
        <field name="implied_ids" eval="[(4, ref('group_win_loss_analysis_user'))]"/>
    </record>
    <record id="rule_win_loss_analysis_sf_win_loss" model="ir.rule">
        <field name="name">Win / Loss Record: multi-company</field>
        <field name="model_id" ref="model_sf_win_loss"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
