<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_supplier_capacity" model="ir.actions.act_window">
        <field name="name">Supplier Capacity Check</field>
        <field name="res_model">sf.supplier.capacity</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
    <record id="view_sf_supplier_capacity_form" model="ir.ui.view">
        <field name="name">sf.supplier.capacity.form</field>
        <field name="model">sf.supplier.capacity</field>
        <field name="arch" type="xml">
            <form string="Supplier Capacity Check">
                <header>
                    <button name="action_confirmed" type="object" string="Confirmed"
                            class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="requested,confirmed,rejected"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="vendor_id"/>
                            <field name="product_id"/>
                            <field name="requested_qty"/>
                            <field name="confirmed_capacity"/>
                            <field name="lead_time_confirmed"/>
                            <field name="notes"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_supplier_capacity_list" model="ir.ui.view">
        <field name="name">sf.supplier.capacity.list</field>
        <field name="model">sf.supplier.capacity</field>
        <field name="arch" type="xml">
            <list string="Supplier Capacity Check" sample="1">
                <field name="vendor_id"/>
                <field name="product_id"/>
                <field name="requested_qty"/>
                <field name="confirmed_capacity"/>
                <field name="lead_time_confirmed"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state in ('submitted','approved')"/>
            </list>
        </field>
    </record>
    <record id="view_sf_supplier_capacity_kanban" model="ir.ui.view">
        <field name="name">sf.supplier.capacity.kanban</field>
        <field name="model">sf.supplier.capacity</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_view" group_by="state">
                <field name="name"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <menuitem id="menu_sf_supplier_capacity_root" name="Supplier Capacity Check" sequence="18"
              web_icon="sf_supplier_capacity_check,static/description/icon.png"/>
    <menuitem id="menu_sf_supplier_capacity_main" name="Records"
              parent="menu_sf_supplier_capacity_root" action="action_sf_supplier_capacity" sequence="10"/>

    <record id="wave_final_sf_supplier_capacity_check" model="ir.actions.server">
        <field name="name">Refresh Business Data</field>
        <field name="model_id" ref="model_sf_supplier_capacity"/>
        <field name="binding_model_id" ref="model_sf_supplier_capacity"/>
        <field name="state">code</field>
        <field name="code">records.action_refresh_business()</field>
    </record>
</odoo>
