<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_interim_billing" model="ir.actions.act_window">
        <field name="name">Interim Billing Tracker</field>
        <field name="res_model">sf.interim.billing</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
    <record id="view_sf_interim_billing_form" model="ir.ui.view">
        <field name="name">sf.interim.billing.form</field>
        <field name="model">sf.interim.billing</field>
        <field name="arch" type="xml">
            <form string="Interim Billing Tracker">
                <header>
                    <button name="action_final_billing" type="object" string="Final Billing"
                            class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="active,final_billing,closed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="project_ref"/>
                            <field name="partner_id"/>
                            <field name="total_contract"/>
                            <field name="percent_complete"/>
                            <field name="billed_to_date"/>
                            <field name="next_milestone"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_interim_billing_list" model="ir.ui.view">
        <field name="name">sf.interim.billing.list</field>
        <field name="model">sf.interim.billing</field>
        <field name="arch" type="xml">
            <list string="Interim Billing Tracker" sample="1">
                <field name="project_ref"/>
                <field name="partner_id"/>
                <field name="total_contract"/>
                <field name="percent_complete"/>
                <field name="billed_to_date"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state in ('submitted','approved')"/>
            </list>
        </field>
    </record>
    <record id="view_sf_interim_billing_kanban" model="ir.ui.view">
        <field name="name">sf.interim.billing.kanban</field>
        <field name="model">sf.interim.billing</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_view" group_by="state">
                <field name="name"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <menuitem id="menu_sf_interim_billing_root" name="Interim Billing Tracker" sequence="3"
              web_icon="sf_interim_billing_tracker,static/description/icon.png"/>
    <menuitem id="menu_sf_interim_billing_main" name="Records"
              parent="menu_sf_interim_billing_root" action="action_sf_interim_billing" sequence="10"/>
</odoo>
