<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_interim_billing_tracker" model="ir.module.category">
        <field name="name">Interim Billing Tracker</field>
        <field name="sequence">5</field>
    </record>
    <record id="group_interim_billing_tracker_user" model="res.groups">
        <field name="name">Interim Billing Tracker User</field>
        <field name="category_id" ref="module_category_interim_billing_tracker"/>

    </record>
    <record id="group_interim_billing_tracker_manager" model="res.groups">
        <field name="name">Interim Billing Tracker Manager</field>
        <field name="category_id" ref="module_category_interim_billing_tracker"/>
        <field name="implied_ids" eval="[(4, ref('group_interim_billing_tracker_user'))]"/>
    </record>
    <record id="rule_interim_billing_tracker_sf_interim_billing" model="ir.rule">
        <field name="name">Interim Billing: multi-company</field>
        <field name="model_id" ref="model_sf_interim_billing"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
