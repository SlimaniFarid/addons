<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_invoice_matching" model="ir.module.category">
        <field name="name">Invoice Matching</field>
        <field name="sequence">92</field>
    </record>

    <record id="group_invoice_matching_user" model="res.groups">
        <field name="name">Invoice Matching User</field>
        <field name="category_id" ref="module_category_invoice_matching"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_invoice_matching_manager" model="res.groups">
        <field name="name">Invoice Matching Manager</field>
        <field name="category_id" ref="module_category_invoice_matching"/>
        <field name="implied_ids" eval="[(4, ref('group_invoice_matching_user'))]"/>
    </record>

    <record id="rule_match_line_user_company" model="ir.rule">
        <field name="name">Match Line: user sees own company</field>
        <field name="model_id" ref="model_sf_invoice_match_line"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_invoice_matching_user'))]"/>
    </record>

    <record id="rule_match_log_user_company" model="ir.rule">
        <field name="name">Match Log: user sees own company</field>
        <field name="model_id" ref="model_sf_invoice_match_log"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_invoice_matching_user'))]"/>
    </record>

    <record id="rule_match_exception_user_company" model="ir.rule">
        <field name="name">Exception: user sees own company</field>
        <field name="model_id" ref="model_sf_invoice_exception"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_invoice_matching_user'))]"/>
    </record>

    <record id="rule_match_line_manager_all" model="ir.rule">
        <field name="name">Match Line: manager sees all companies</field>
        <field name="model_id" ref="model_sf_invoice_match_line"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_invoice_matching_manager'))]"/>
    </record>

    <record id="rule_match_log_manager_all" model="ir.rule">
        <field name="name">Match Log: manager sees all companies</field>
        <field name="model_id" ref="model_sf_invoice_match_log"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_invoice_matching_manager'))]"/>
    </record>

    <record id="rule_match_exception_manager_all" model="ir.rule">
        <field name="name">Exception: manager sees all companies</field>
        <field name="model_id" ref="model_sf_invoice_exception"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_invoice_matching_manager'))]"/>
    </record>
    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_invoice_matching"/>
    </record>
</odoo>