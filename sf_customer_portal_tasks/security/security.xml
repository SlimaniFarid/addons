<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_customer_portal_tasks" model="ir.module.category">
        <field name="name">Customer Portal Task Exchange</field>
        <field name="sequence">17</field>
    </record>
    <record id="group_customer_portal_tasks_user" model="res.groups">
        <field name="name">Customer Portal Task Exchange User</field>
        <field name="category_id" ref="module_category_customer_portal_tasks"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>

    </record>
    <record id="group_customer_portal_tasks_manager" model="res.groups">
        <field name="name">Customer Portal Task Exchange Manager</field>
        <field name="category_id" ref="module_category_customer_portal_tasks"/>
        <field name="implied_ids" eval="[(4, ref('group_customer_portal_tasks_user'))]"/>
    </record>
    <record id="rule_customer_portal_tasks_sf_portal_task" model="ir.rule">
        <field name="name">Portal Task: multi-company</field>
        <field name="model_id" ref="model_sf_portal_task"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_customer_portal_tasks"/>
    </record>
</odoo>
