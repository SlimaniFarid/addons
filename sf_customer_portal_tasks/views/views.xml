<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_portal_task" model="ir.actions.act_window">
        <field name="name">Customer Portal Task Exchange</field>
        <field name="res_model">sf.portal.task</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
    <record id="view_sf_portal_task_form" model="ir.ui.view">
        <field name="name">sf.portal.task.form</field>
        <field name="model">sf.portal.task</field>
        <field name="arch" type="xml">
            <form string="Customer Portal Task Exchange">
                <header>
                    <button name="action_in_progress" type="object" string="Customer Working"
                            class="btn-primary"/>
                    <button name="action_submitted" type="object" string="Submitted"
                            class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="requested,in_progress,submitted,validated"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="title"/>
                            <field name="requested_from_customer"/>
                        <field name="customer_input"/>
                            <field name="due_date"/>
                            <field name="validated"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_portal_task_list" model="ir.ui.view">
        <field name="name">sf.portal.task.list</field>
        <field name="model">sf.portal.task</field>
        <field name="arch" type="xml">
            <list string="Customer Portal Task Exchange" sample="1">
                <field name="partner_id"/>
                <field name="title"/>
                <field name="requested_from_customer"/>
                <field name="customer_input"/>
                <field name="due_date"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state in ('submitted','approved')"/>
            </list>
        </field>
    </record>
    <record id="view_sf_portal_task_kanban" model="ir.ui.view">
        <field name="name">sf.portal.task.kanban</field>
        <field name="model">sf.portal.task</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_view" group_by="state">
                <field name="name"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <menuitem id="menu_sf_portal_task_root" name="Customer Portal Task Exchange" sequence="12"
              web_icon="sf_customer_portal_tasks,static/description/icon.png"/>
    <menuitem id="menu_sf_portal_task_main" name="Records"
              parent="menu_sf_portal_task_root" action="action_sf_portal_task" sequence="10"/>
</odoo>
