<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_maintenance_schedule_optimizer" model="ir.actions.act_window">
        <field name="name">Maintenance Schedule Optimizer</field>
        <field name="res_model">sf.maintenance_schedule_optimizer</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
    <record id="view_sf_maintenance_schedule_optimizer_form" model="ir.ui.view">
        <field name="name">sf.maintenance_schedule_optimizer.form</field>
        <field name="model">sf.maintenance_schedule_optimizer</field>
        <field name="arch" type="xml">
            <form string="Maintenance Schedule Optimizer">
                <header>
                    <button name="action_submitted" type="object" string="Submitted"
                            class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="equipment_id"/>
                            <field name="criticality"/>
                            <field name="optimal_frequency_days"/>
                            <field name="production_impact"/>
                            <field name="recommended_window"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_maintenance_schedule_optimizer_list" model="ir.ui.view">
        <field name="name">sf.maintenance_schedule_optimizer.list</field>
        <field name="model">sf.maintenance_schedule_optimizer</field>
        <field name="arch" type="xml">
            <list string="Maintenance Schedule Optimizer" sample="1">
                <field name="equipment_id"/>
                <field name="criticality"/>
                <field name="optimal_frequency_days"/>
                <field name="production_impact"/>
                <field name="recommended_window"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state in ('submitted','approved')"/>
            </list>
        </field>
    </record>
    <record id="view_sf_maintenance_schedule_optimizer_kanban" model="ir.ui.view">
        <field name="name">sf.maintenance_schedule_optimizer.kanban</field>
        <field name="model">sf.maintenance_schedule_optimizer</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_view" group_by="state">
                <field name="name"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <menuitem id="menu_sf_maintenance_schedule_optimizer_root" name="Maintenance Schedule Optimizer" sequence="27"
              web_icon="sf_maintenance_schedule_optimizer,static/description/icon.png"/>
    <menuitem id="menu_sf_maintenance_schedule_optimizer_main" name="Records"
              parent="menu_sf_maintenance_schedule_optimizer_root" action="action_sf_maintenance_schedule_optimizer" sequence="10"/>

    <record id="wave_final_sf_maintenance_schedule_optimizer" model="ir.actions.server">
        <field name="name">Refresh Business Data</field>
        <field name="model_id" ref="model_sf_maintenance_schedule_optimizer"/>
        <field name="binding_model_id" ref="model_sf_maintenance_schedule_optimizer"/>
        <field name="state">code</field>
        <field name="code">records.action_refresh_business()</field>
    </record>
</odoo>
