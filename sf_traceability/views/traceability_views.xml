<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Recall form -->
    <record id="traceability_recall_view_form" model="ir.ui.view">
        <field name="name">sf.traceability.recall.form</field>
        <field name="model">sf.traceability.recall</field>
        <field name="arch" type="xml">
            <form string="Batch Recall">
                <header>
                    <button name="action_start" string="Start" type="object"
                            states="open"/>
                    <button name="action_close" string="Close" type="object"
                            states="in_progress"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                        <field name="state" widget="statusbar"/>
                    </div>
                    <group>
                        <group>
                            <field name="lot_id"/>
                            <field name="product_id"/>
                            <field name="severity"/>
                            <field name="date_recall"/>
                        </group>
                        <group>
                            <field name="move_count"/>
                            <field name="partner_count"/>
                        </group>
                    </group>
                    <group>
                        <field name="reason"/>
                    </group>
                    <group string="Affected Customers">
                        <field name="affected_customers"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="traceability_recall_view_tree" model="ir.ui.view">
        <field name="name">sf.traceability.recall.tree</field>
        <field name="model">sf.traceability.recall</field>
        <field name="arch" type="xml">
            <tree string="Batch Recalls">
                <field name="name"/>
                <field name="lot_id"/>
                <field name="product_id"/>
                <field name="severity"/>
                <field name="partner_count"/>
                <field name="state"/>
                <field name="date_recall"/>
            </tree>
        </field>
    </record>

    <record id="traceability_recall_view_search" model="ir.ui.view">
        <field name="name">sf.traceability.recall.search</field>
        <field name="model">sf.traceability.recall</field>
        <field name="arch" type="xml">
            <search string="Batch Recalls">
                <field name="name"/>
                <field name="lot_id"/>
                <field name="product_id"/>
                <filter string="Open" name="open"
                        domain="[('state','=','open')]"/>
                <filter string="In Progress" name="in_progress"
                        domain="[('state','=','in_progress')]"/>
                <filter string="Critical" name="critical"
                        domain="[('severity','=','critical')]"/>
                <group expand="0" string="Group By">
                    <filter string="Severity" name="severity"
                            context="{'group_by':'severity'}"/>
                    <filter string="Status" name="state"
                            context="{'group_by':'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Inherited lot form: quality status + history -->
    <record id="traceability_lot_view_form_ext" model="ir.ui.view">
        <field name="name">stock.lot.form.sf</field>
        <field name="model">stock.lot</field>
        <field name="inherit_id" ref="stock.view_production_lot_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Traceability">
                    <group>
                        <field name="quality_status"/>
                        <field name="batch_origin"/>
                        <field name="expiry_date"/>
                        <field name="recall_ids"/>
                    </group>
                    <group>
                        <field name="movement_history" readonly="1"
                               colspan="2"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>

    <!-- Actions -->
    <record id="action_traceability_recall" model="ir.actions.act_window">
        <field name="name">Batch Recalls</field>
        <field name="res_model">sf.traceability.recall</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="traceability_recall_view_search"/>
    </record>

    <record id="action_traceability_lot" model="ir.actions.act_window">
        <field name="name">Batches &amp; Serial Numbers</field>
        <field name="res_model">stock.lot</field>
        <field name="view_mode">tree,form</field>
    </record>

</odoo>