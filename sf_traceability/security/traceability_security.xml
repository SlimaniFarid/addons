<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_traceability" model="ir.module.category">
        <field name="name">Traceability</field>
        <field name="sequence">90</field>
    </record>

    <record id="group_traceability_user" model="res.groups">
        <field name="name">Traceability User</field>
        <field name="category_id" ref="module_category_traceability"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_traceability_manager" model="res.groups">
        <field name="name">Traceability Manager</field>
        <field name="category_id" ref="module_category_traceability"/>
        <field name="implied_ids" eval="[(4, ref('group_traceability_user'))]"/>
    </record>
</odoo>