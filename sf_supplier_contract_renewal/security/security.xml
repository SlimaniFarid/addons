<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_supplier_contract_renewal" model="ir.module.category">
        <field name="name">Supplier Contract Renewal Tracker</field>
        <field name="sequence">172</field>
    </record>
    <record id="group_supplier_contract_renewal_user" model="res.groups">
        <field name="name">Supplier Contract Renewal Tracker User</field>
        <field name="category_id" ref="module_category_supplier_contract_renewal"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>

    </record>
    <record id="group_supplier_contract_renewal_manager" model="res.groups">
        <field name="name">Supplier Contract Renewal Tracker Manager</field>
        <field name="category_id" ref="module_category_supplier_contract_renewal"/>
        <field name="implied_ids" eval="[(4, ref('group_supplier_contract_renewal_user'))]"/>
    </record>
    <record id="rule_supplier_contract_renewal_sf_supplier_contract_renewal" model="ir.rule">
        <field name="name">Supplier Contract Renewal Tracker: multi-company</field>
        <field name="model_id" ref="model_sf_supplier_contract_renewal"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_supplier_contract_renewal"/>
    </record>
</odoo>
