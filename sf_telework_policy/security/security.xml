<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_telework_policy" model="ir.module.category">
        <field name="name">Telework Policy Manager</field>
        <field name="sequence">200</field>
    </record>
    <record id="group_telework_policy_user" model="res.groups">
        <field name="name">Telework Policy Manager User</field>
        <field name="category_id" ref="module_category_telework_policy"/>

    </record>
    <record id="group_telework_policy_manager" model="res.groups">
        <field name="name">Telework Policy Manager Manager</field>
        <field name="category_id" ref="module_category_telework_policy"/>
        <field name="implied_ids" eval="[(4, ref('group_telework_policy_user'))]"/>
    </record>
    <record id="rule_telework_policy_sf_telework_policy" model="ir.rule">
        <field name="name">Telework Policy Manager: multi-company</field>
        <field name="model_id" ref="model_sf_telework_policy"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_telework_policy"/>
    </record>
</odoo>
