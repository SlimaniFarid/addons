<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_dock_appointments" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.dock.appointments</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Dock Appointments" string="Dock Appointments" name="sf_dock_appointments">
                    <block title="Dock Appointment Settings">
                        <setting string="No-Show Grace (Minutes)">
                            <field name="sf_dock_grace_minutes"/>
                        </setting>
                        <setting string="Default Appointment Window (Minutes)">
                            <field name="sf_dock_default_window_minutes"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>