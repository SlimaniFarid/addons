<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sf_dock_appointment_view_list" model="ir.ui.view">
        <field name="name">sf.dock.appointment.list</field>
        <field name="model">sf.dock.appointment</field>
        <field name="arch" type="xml">
            <list string="Dock Appointments">
                <field name="name"/>
                <field name="dock_id"/>
                <field name="partner_id"/>
                <field name="direction"/>
                <field name="appointment_datetime"/>
                <field name="vehicle_plate"/>
                <field name="delay_minutes"/>
                <field name="state" widget="badge"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="sf_dock_appointment_view_calendar" model="ir.ui.view">
        <field name="name">sf.dock.appointment.calendar</field>
        <field name="model">sf.dock.appointment</field>
        <field name="arch" type="xml">
            <calendar string="Dock Appointments" date_start="appointment_datetime"
                      color="state" mode="day">
                <field name="partner_id"/>
                <field name="dock_id"/>
            </calendar>
        </field>
    </record>

    <record id="sf_dock_appointment_view_form" model="ir.ui.view">
        <field name="name">sf.dock.appointment.form</field>
        <field name="model">sf.dock.appointment</field>
        <field name="arch" type="xml">
            <form string="Dock Appointment">
                <header>
                    <button name="action_arrive" string="Register Arrival" type="object" class="btn-primary" invisible="[('state', '!=', 'scheduled')]"/>
                    <button name="action_dock" string="Move to Dock" type="object" class="btn-primary" invisible="[('state', '!=', 'arrived')]"/>
                    <button name="action_complete" string="Complete" type="object" class="btn-primary" invisible="[('state', '!=', 'docked')]"/>
                    <button name="action_cancel" string="Cancel" type="object" invisible="[('state', 'in', ('completed', 'no_show', 'cancelled'))]"/>
                    <field name="state" widget="statusbar" readonly="1"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="dock_id"/>
                            <field name="partner_id"/>
                            <field name="direction"/>
                            <field name="reference"/>
                            <field name="carrier_name"/>
                        </group>
                        <group>
                            <field name="vehicle_plate"/>
                            <field name="driver_name"/>
                            <field name="appointment_datetime"/>
                            <field name="window_minutes"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group string="Actual Times">
                        <group>
                            <field name="actual_arrival_datetime"/>
                            <field name="actual_dock_datetime"/>
                            <field name="actual_departure_datetime"/>
                        </group>
                        <group>
                            <field name="delay_minutes"/>
                            <field name="dock_duration_minutes"/>
                        </group>
                    </group>
                    <group>
                        <field name="notes"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="sf_dock_appointment_view_search" model="ir.ui.view">
        <field name="name">sf.dock.appointment.search</field>
        <field name="model">sf.dock.appointment</field>
        <field name="arch" type="xml">
            <search string="Dock Appointments">
                <field name="name"/>
                <field name="dock_id"/>
                <field name="partner_id"/>
                <field name="vehicle_plate"/>
                <filter name="appointment_scheduled" string="Scheduled" domain="[('state', '=', 'scheduled')]"/>
                <filter name="appointment_active" string="Active" domain="[('state', 'in', ('scheduled', 'arrived', 'docked'))]"/>
                <filter name="appointment_no_show" string="No-Show" domain="[('state', '=', 'no_show')]"/>
                <group>
                    <filter name="group_appointment_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_appointment_dock" string="Dock" context="{'group_by': 'dock_id'}"/>
                    <filter name="group_appointment_direction" string="Direction" context="{'group_by': 'direction'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_sf_dock_appointment" model="ir.actions.act_window">
        <field name="name">Dock Appointments</field>
        <field name="res_model">sf.dock.appointment</field>
        <field name="view_mode">list,calendar,form</field>
        <field name="search_view_id" ref="sf_dock_appointment_view_search"/>
    </record>
</odoo>