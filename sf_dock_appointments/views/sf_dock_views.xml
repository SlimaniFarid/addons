<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sf_dock_view_list" model="ir.ui.view">
        <field name="name">sf.dock.list</field>
        <field name="model">sf.dock</field>
        <field name="arch" type="xml">
            <list string="Docks">
                <field name="name"/>
                <field name="dock_type"/>
                <field name="location_note"/>
                <field name="is_active"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="sf_dock_view_form" model="ir.ui.view">
        <field name="name">sf.dock.form</field>
        <field name="model">sf.dock</field>
        <field name="arch" type="xml">
            <form string="Dock">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="dock_type"/>
                            <field name="location_note"/>
                            <field name="is_active"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Appointments">
                            <field name="appointment_ids">
                                <list string="Appointments">
                                    <field name="name"/>
                                    <field name="partner_id"/>
                                    <field name="direction"/>
                                    <field name="appointment_datetime"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="sf_dock_view_search" model="ir.ui.view">
        <field name="name">sf.dock.search</field>
        <field name="model">sf.dock</field>
        <field name="arch" type="xml">
            <search string="Docks">
                <field name="name"/>
                <field name="dock_type"/>
                <group>
                    <filter name="group_dock_type" string="Type" context="{'group_by': 'dock_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_sf_dock" model="ir.actions.act_window">
        <field name="name">Docks</field>
        <field name="res_model">sf.dock</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="sf_dock_view_search"/>
    </record>

    <record id="view_sf_dock_appointments_boost_kanban" model="ir.ui.view">
        <field name="name">sf_dock_appointments.boost.kanban</field>
        <field name="model">sf.dock</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" t-att-color="state">
                <field name="name"/>
                <field name="state"/>
                <field name="user_id"/>

                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_card oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title">
                                    <field name="name"/></strong>
                                <div class="o_kanban_record_subtitle">
                                    <field name="user_id" widget="many2one_avatar_user"/>
                                    <field name="create_date"/></div>
                            </div>
                            <div class="oe_kanban_bottom_right">
                                <field name="state" widget="badge"
                                       t-attf-options="{'classes_map': {'draft': 'info', 'done': 'success', 'cancelled': 'danger'}, 'domain': []}"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_sf_dock_appointments_boost_search" model="ir.ui.view">
        <field name="name">sf_dock_appointments.boost.search</field>
        <field name="model">sf.dock</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
<separator/>
                <filter string="My records" name="my_records" domain="[('user_id', '=', uid)]"/>
                <filter string="To Do" name="todo" domain="[('state', 'not in', ('done', 'cancelled', 'closed'))]"/>
                <group expand="0" string="Group By"><filter string="Status" name="gb_state" context="{'group_by': 'state'}"/></group>
            </search>
        </field>
    </record>
</odoo>
