<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="module_category_sf_dock_appointments" model="ir.module.category">
            <field name="name">Dock Appointments</field>
            <field name="description">Dock &amp; Shipment Appointment Scheduling.</field>
            <field name="sequence">10</field>
        </record>

        <record id="group_sf_dock_appointments_user" model="res.groups">
            <field name="name">Dock Appointments / User</field>
            <field name="category_id" ref="module_category_sf_dock_appointments"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_sf_dock_appointments_manager" model="res.groups">
            <field name="name">Dock Appointments / Manager</field>
            <field name="category_id" ref="module_category_sf_dock_appointments"/>
            <field name="implied_ids" eval="[(4, ref('sf_dock_appointments.group_sf_dock_appointments_user'))]"/>
        </record>

        <record id="rule_sf_dock_company" model="ir.rule">
            <field name="name">Dock: user sees own company</field>
            <field name="model_id" ref="model_sf_dock"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('sf_dock_appointments.group_sf_dock_appointments_user'))]"/>
        </record>
        <record id="rule_sf_dock_manager_all" model="ir.rule">
            <field name="name">Dock: manager sees all companies</field>
            <field name="model_id" ref="model_sf_dock"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('sf_dock_appointments.group_sf_dock_appointments_manager'))]"/>
        </record>

        <record id="rule_sf_dock_appointment_company" model="ir.rule">
            <field name="name">Dock Appointment: user sees own company</field>
            <field name="model_id" ref="model_sf_dock_appointment"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('sf_dock_appointments.group_sf_dock_appointments_user'))]"/>
        </record>
        <record id="rule_sf_dock_appointment_manager_all" model="ir.rule">
            <field name="name">Dock Appointment: manager sees all companies</field>
            <field name="model_id" ref="model_sf_dock_appointment"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('sf_dock_appointments.group_sf_dock_appointments_manager'))]"/>
        </record>
    </data>
    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_sf_dock_appointments"/>
    </record>
</odoo>