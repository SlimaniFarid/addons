<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_sales_pipeline_review" model="ir.module.category">
        <field name="name">Pipeline Review Meeting Log</field>
        <field name="sequence">379</field>
    </record>
    <record id="group_sales_pipeline_review_user" model="res.groups">
        <field name="name">Pipeline Review Meeting Log User</field>
        <field name="category_id" ref="module_category_sales_pipeline_review"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>

    </record>
    <record id="group_sales_pipeline_review_manager" model="res.groups">
        <field name="name">Pipeline Review Meeting Log Manager</field>
        <field name="category_id" ref="module_category_sales_pipeline_review"/>
        <field name="implied_ids" eval="[(4, ref('group_sales_pipeline_review_user'))]"/>
    </record>
    <record id="rule_sales_pipeline_review_sf_sales_pipeline_review" model="ir.rule">
        <field name="name">Pipeline Review Meeting Log: multi-company</field>
        <field name="model_id" ref="model_sf_sales_pipeline_review"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
