<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="module_category_sf_cold_chain" model="ir.module.category">
            <field name="name">Cold Chain</field>
            <field name="description">Cold chain monitoring for storage and transport.</field>
            <field name="sequence">10</field>
        </record>

        <record id="group_sf_cold_chain_user" model="res.groups">
            <field name="name">Cold Chain / User</field>
            <field name="category_id" ref="module_category_sf_cold_chain"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_sf_cold_chain_manager" model="res.groups">
            <field name="name">Cold Chain / Manager</field>
            <field name="category_id" ref="module_category_sf_cold_chain"/>
            <field name="implied_ids" eval="[(4, ref('sf_cold_chain.group_sf_cold_chain_user'))]"/>
        </record>

        <record id="rule_sf_cold_site_company" model="ir.rule">
            <field name="name">Cold Site: user sees own company</field>
            <field name="model_id" ref="model_sf_cold_site"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('sf_cold_chain.group_sf_cold_chain_user'))]"/>
        </record>
        <record id="rule_sf_cold_site_manager_all" model="ir.rule">
            <field name="name">Cold Site: manager sees all companies</field>
            <field name="model_id" ref="model_sf_cold_site"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('sf_cold_chain.group_sf_cold_chain_manager'))]"/>
        </record>

        <record id="rule_sf_cold_trip_company" model="ir.rule">
            <field name="name">Cold Trip: user sees own company</field>
            <field name="model_id" ref="model_sf_cold_trip"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('sf_cold_chain.group_sf_cold_chain_user'))]"/>
        </record>
        <record id="rule_sf_cold_trip_manager_all" model="ir.rule">
            <field name="name">Cold Trip: manager sees all companies</field>
            <field name="model_id" ref="model_sf_cold_trip"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('sf_cold_chain.group_sf_cold_chain_manager'))]"/>
        </record>

        <record id="rule_sf_cold_reading_company" model="ir.rule">
            <field name="name">Cold Reading: user sees own company</field>
            <field name="model_id" ref="model_sf_cold_reading"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('sf_cold_chain.group_sf_cold_chain_user'))]"/>
        </record>
        <record id="rule_sf_cold_reading_manager_all" model="ir.rule">
            <field name="name">Cold Reading: manager sees all companies</field>
            <field name="model_id" ref="model_sf_cold_reading"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('sf_cold_chain.group_sf_cold_chain_manager'))]"/>
        </record>

        <record id="rule_sf_cold_excursion_company" model="ir.rule">
            <field name="name">Cold Excursion: user sees own company</field>
            <field name="model_id" ref="model_sf_cold_excursion"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('sf_cold_chain.group_sf_cold_chain_user'))]"/>
        </record>
        <record id="rule_sf_cold_excursion_manager_all" model="ir.rule">
            <field name="name">Cold Excursion: manager sees all companies</field>
            <field name="model_id" ref="model_sf_cold_excursion"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('sf_cold_chain.group_sf_cold_chain_manager'))]"/>
        </record>
    </data>
</odoo>