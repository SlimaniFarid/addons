<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="action_report_cold_log" model="ir.actions.report">
            <field name="name">Cold Chain Log</field>
            <field name="model">sf.cold.reading</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">sf_cold_chain.report_cold_log</field>
            <field name="report_file">sf_cold_chain.report_cold_log</field>
        </record>

        <record id="action_cold_chain_report_site" model="ir.actions.server">
            <field name="name">Print Cold Chain Log</field>
            <field name="model_id" ref="model_sf_cold_site"/>
            <field name="binding_model_id" ref="model_sf_cold_site"/>
            <field name="binding_type">action</field>
            <field name="state">code</field>
            <field name="code">
action = self.env.ref('sf_cold_chain.action_sf_cold_chain_report_wizard').read()[0]
action['context'] = {'default_site_id': self.id}
</field>
        </record>

        <record id="action_cold_chain_report_trip" model="ir.actions.server">
            <field name="name">Print Cold Chain Log</field>
            <field name="model_id" ref="model_sf_cold_trip"/>
            <field name="binding_model_id" ref="model_sf_cold_trip"/>
            <field name="binding_type">action</field>
            <field name="state">code</field>
            <field name="code">
action = self.env.ref('sf_cold_chain.action_sf_cold_chain_report_wizard').read()[0]
action['context'] = {'default_trip_id': self.id}
</field>
        </record>
    </data>
</odoo>