<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sf_cold_chain_report_wizard_view_form" model="ir.ui.view">
        <field name="name">sf.cold.chain.report.wizard.form</field>
        <field name="model">sf.cold.chain.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Cold Chain Log Report">
                <group>
                    <field name="site_id"/>
                    <field name="trip_id"/>
                </group>
                <group>
                    <field name="date_from"/>
                    <field name="date_to"/>
                </group>
                <footer>
                    <button name="action_print_report" string="Print Report" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_sf_cold_chain_report_wizard" model="ir.actions.act_window">
        <field name="name">Cold Chain Log Report</field>
        <field name="res_model">sf.cold.chain.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="action_report_cold_log" model="ir.actions.report">
        <field name="name">Cold Chain Log</field>
        <field name="model">sf.cold.reading</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">sf_cold_chain.report_cold_log</field>
        <field name="report_file">sf_cold_chain.report_cold_log</field>
    </record>
</odoo>