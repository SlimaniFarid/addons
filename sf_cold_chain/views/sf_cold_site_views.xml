<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sf_cold_site_view_list" model="ir.ui.view">
        <field name="name">sf.cold.site.list</field>
        <field name="model">sf.cold.site</field>
        <field name="arch" type="xml">
            <list string="Cold Storage Sites">
                <field name="name"/>
                <field name="site_type"/>
                <field name="temperature_min"/>
                <field name="temperature_max"/>
                <field name="location_note"/>
                <field name="is_active"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="sf_cold_site_view_form" model="ir.ui.view">
        <field name="name">sf.cold.site.form</field>
        <field name="model">sf.cold.site</field>
        <field name="arch" type="xml">
            <form string="Cold Storage Site">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="site_type"/>
                            <field name="temperature_min"/>
                            <field name="temperature_max"/>
                        </group>
                        <group>
                            <field name="location_note"/>
                            <field name="is_active"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="sf_cold_site_view_search" model="ir.ui.view">
        <field name="name">sf.cold.site.search</field>
        <field name="model">sf.cold.site</field>
        <field name="arch" type="xml">
            <search string="Cold Storage Sites">
                <field name="name"/>
                <field name="site_type"/>
                <group>
                    <filter name="group_site_type" string="Type" context="{'group_by': 'site_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_sf_cold_site" model="ir.actions.act_window">
        <field name="name">Cold Storage Sites</field>
        <field name="res_model">sf.cold.site</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="sf_cold_site_view_search"/>
    </record>
</odoo>