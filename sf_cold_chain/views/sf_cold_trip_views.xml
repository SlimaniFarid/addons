<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sf_cold_trip_view_list" model="ir.ui.view">
        <field name="name">sf.cold.trip.list</field>
        <field name="model">sf.cold.trip</field>
        <field name="arch" type="xml">
            <list string="Cold Transport Trips">
                <field name="name"/>
                <field name="carrier_id"/>
                <field name="vehicle_plate"/>
                <field name="planned_departure"/>
                <field name="planned_arrival"/>
                <field name="state" widget="badge"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="sf_cold_trip_view_form" model="ir.ui.view">
        <field name="name">sf.cold.trip.form</field>
        <field name="model">sf.cold.trip</field>
        <field name="arch" type="xml">
            <form string="Cold Transport Trip">
                <header>
                    <button name="action_start" string="Start Trip" type="object" class="btn-primary" invisible="[('state', '!=', 'planned')]"/>
                    <button name="action_complete" string="Complete Trip" type="object" class="btn-primary" invisible="[('state', '!=', 'in_transit')]"/>
                    <button name="action_cancel" string="Cancel" type="object" invisible="[('state', 'in', ('completed', 'cancelled'))]"/>
                    <field name="state" widget="statusbar" readonly="1"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="carrier_id"/>
                            <field name="vehicle_plate"/>
                            <field name="cargo_description"/>
                            <field name="temperature_min"/>
                            <field name="temperature_max"/>
                        </group>
                        <group>
                            <field name="planned_departure"/>
                            <field name="planned_arrival"/>
                            <field name="actual_departure"/>
                            <field name="actual_arrival"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Readings">
                            <field name="reading_ids">
                                <list string="Readings">
                                    <field name="reading_datetime"/>
                                    <field name="temperature"/>
                                    <field name="within_range" widget="boolean_toggle"/>
                                    <field name="recorded_by"/>
                                </list>
                            </field>
                        </page>
                        <page string="Excursions">
                            <field name="excursion_ids">
                                <list string="Excursions">
                                    <field name="name"/>
                                    <field name="start_datetime"/>
                                    <field name="duration_minutes"/>
                                    <field name="max_deviation"/>
                                    <field name="severity"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="sf_cold_trip_view_search" model="ir.ui.view">
        <field name="name">sf.cold.trip.search</field>
        <field name="model">sf.cold.trip</field>
        <field name="arch" type="xml">
            <search string="Cold Transport Trips">
                <field name="name"/>
                <field name="carrier_id"/>
                <field name="vehicle_plate"/>
                <filter name="trip_open" string="Active" domain="[('state', 'in', ('planned', 'in_transit'))]"/>
                <filter name="trip_completed" string="Completed" domain="[('state', '=', 'completed')]"/>
                <group>
                    <filter name="group_trip_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_trip_carrier" string="Carrier" context="{'group_by': 'carrier_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_sf_cold_trip" model="ir.actions.act_window">
        <field name="name">Cold Transport Trips</field>
        <field name="res_model">sf.cold.trip</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="sf_cold_trip_view_search"/>
    </record>
</odoo>