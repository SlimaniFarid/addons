<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sf_cold_excursion_view_list" model="ir.ui.view">
        <field name="name">sf.cold.excursion.list</field>
        <field name="model">sf.cold.excursion</field>
        <field name="arch" type="xml">
            <list string="Cold Chain Excursions">
                <field name="name"/>
                <field name="trip_id"/>
                <field name="site_id"/>
                <field name="started_at"/>
                <field name="duration_minutes"/>
                <field name="min_temp"/>
                <field name="max_temp"/>
                <field name="severity"/>
                <field name="state" widget="badge"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="sf_cold_excursion_view_form" model="ir.ui.view">
        <field name="name">sf.cold.excursion.form</field>
        <field name="model">sf.cold.excursion</field>
        <field name="arch" type="xml">
            <form string="Cold Chain Excursion">
                <header>
                    <button name="action_resolve" string="Resolve" type="object" class="btn-primary" invisible="[('state', '!=', 'open')]"/>
                    <field name="state" widget="statusbar" readonly="1"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="trip_id"/>
                            <field name="site_id"/>
                            <field name="started_at"/>
                            <field name="ended_at"/>
                        </group>
                        <group>
                            <field name="duration_minutes"/>
                            <field name="min_temp"/>
                            <field name="max_temp"/>
                            <field name="severity"/>
                            <field name="resolved_by"/>
                            <field name="resolved_on"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group>
                        <field name="corrective_action"/>
                    </group>
                    <notebook>
                        <page string="Readings">
                            <field name="reading_ids">
                                <list string="Readings">
                                    <field name="recorded_at"/>
                                    <field name="temperature"/>
                                    <field name="deviation"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="sf_cold_excursion_view_search" model="ir.ui.view">
        <field name="name">sf.cold.excursion.search</field>
        <field name="model">sf.cold.excursion</field>
        <field name="arch" type="xml">
            <search string="Cold Chain Excursions">
                <field name="name"/>
                <field name="trip_id"/>
                <field name="site_id"/>
                <filter name="excursion_open" string="Open" domain="[('state', '=', 'open')]"/>
                <filter name="excursion_resolved" string="Resolved" domain="[('state', '=', 'resolved')]"/>
                <group>
                    <filter name="group_excursion_severity" string="Severity" context="{'group_by': 'severity'}"/>
                    <filter name="group_excursion_state" string="Status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_sf_cold_excursion" model="ir.actions.act_window">
        <field name="name">Excursions</field>
        <field name="res_model">sf.cold.excursion</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="sf_cold_excursion_view_search"/>
    </record>

    <record id="view_sf_cold_chain_boost_kanban" model="ir.ui.view">
        <field name="name">sf_cold_chain.boost.kanban</field>
        <field name="model">sf.cold.chain.activity.mixin</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" t-att-color="state">
                <field name="name"/>
                <field name="state"/>
                <field name="user_id"/>

                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_card oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title">
                                    <field name="name"/></strong>
                                <div class="o_kanban_record_subtitle">
                                    <field name="user_id" widget="many2one_avatar_user"/>
                                    <field name="create_date"/></div>
                            </div>
                            <div class="oe_kanban_bottom_right">
                                <field name="state" widget="badge"
                                       t-attf-options="{'classes_map': {'draft': 'info', 'done': 'success', 'cancelled': 'danger'}, 'domain': []}"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_sf_cold_chain_boost_search" model="ir.ui.view">
        <field name="name">sf_cold_chain.boost.search</field>
        <field name="model">sf.cold.chain.activity.mixin</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
<separator/>
                <filter string="My records" name="my_records" domain="[('user_id', '=', uid)]"/>
                <filter string="To Do" name="todo" domain="[('state', 'not in', ('done', 'cancelled', 'closed'))]"/>
                <group expand="0" string="Group By"><filter string="Status" name="gb_state" context="{'group_by': 'state'}"/></group>
            </search>
        </field>
    </record>
</odoo>
