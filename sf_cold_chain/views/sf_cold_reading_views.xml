<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sf_cold_reading_view_list" model="ir.ui.view">
        <field name="name">sf.cold.reading.list</field>
        <field name="model">sf.cold.reading</field>
        <field name="arch" type="xml">
            <list string="Cold Chain Readings">
                <field name="name"/>
                <field name="trip_id"/>
                <field name="site_id"/>
                <field name="recorded_at"/>
                <field name="temperature"/>
                <field name="source"/>
                <field name="temperature_min"/>
                <field name="temperature_max"/>
                <field name="within_range" widget="boolean_toggle"/>
                <field name="deviation"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="sf_cold_reading_view_form" model="ir.ui.view">
        <field name="name">sf.cold.reading.form</field>
        <field name="model">sf.cold.reading</field>
        <field name="arch" type="xml">
            <form string="Cold Chain Reading">
                <sheet>
                    <group>
                        <group>
                            <field name="trip_id"/>
                            <field name="site_id"/>
                            <field name="recorded_at"/>
                            <field name="temperature"/>
                            <field name="source"/>
                        </group>
                        <group>
                            <field name="temperature_min"/>
                            <field name="temperature_max"/>
                            <field name="within_range" widget="boolean_toggle"/>
                            <field name="deviation"/>
                            <field name="excursion_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group>
                        <field name="notes"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="sf_cold_reading_view_search" model="ir.ui.view">
        <field name="name">sf.cold.reading.search</field>
        <field name="model">sf.cold.reading</field>
        <field name="arch" type="xml">
            <search string="Cold Chain Readings">
                <field name="name"/>
                <field name="trip_id"/>
                <field name="site_id"/>
                <field name="source"/>
                <filter name="reading_out_of_range" string="Out of Range" domain="[('within_range', '=', False)]"/>
                <filter name="reading_in_range" string="Within Range" domain="[('within_range', '=', True)]"/>
                <group>
                    <filter name="group_reading_trip" string="Trip" context="{'group_by': 'trip_id'}"/>
                    <filter name="group_reading_site" string="Site" context="{'group_by': 'site_id'}"/>
                    <filter name="group_reading_source" string="Source" context="{'group_by': 'source'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_sf_cold_reading" model="ir.actions.act_window">
        <field name="name">Readings</field>
        <field name="res_model">sf.cold.reading</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="sf_cold_reading_view_search"/>
    </record>

    <record id="view_sf_cold_chain_boost_kanban" model="ir.ui.view">
        <field name="name">sf_cold_chain.boost.kanban</field>
        <field name="model">sf.cold.chain.activity.mixin</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" t-att-color="state">
                <field name="name"/>
                <field name="state"/>
                <field name="user_id"/>

                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_card oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title">
                                    <field name="name"/></strong>
                                <div class="o_kanban_record_subtitle">
                                    <field name="user_id" widget="many2one_avatar_user"/>
                                    <field name="create_date"/></div>
                            </div>
                            <div class="oe_kanban_bottom_right">
                                <field name="state" widget="badge"
                                       t-attf-options="{'classes_map': {'draft': 'info', 'done': 'success', 'cancelled': 'danger'}, 'domain': []}"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_sf_cold_chain_boost_search" model="ir.ui.view">
        <field name="name">sf_cold_chain.boost.search</field>
        <field name="model">sf.cold.chain.activity.mixin</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
<separator/>
                <filter string="My records" name="my_records" domain="[('user_id', '=', uid)]"/>
                <filter string="To Do" name="todo" domain="[('state', 'not in', ('done', 'cancelled', 'closed'))]"/>
                <group expand="0" string="Group By"><filter string="Status" name="gb_state" context="{'group_by': 'state'}"/></group>
            </search>
        </field>
    </record>
</odoo>
