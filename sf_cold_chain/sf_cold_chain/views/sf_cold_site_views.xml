<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sf_cold_site_view_list" model="ir.ui.view">
        <field name="name">sf.cold.site.list</field>
        <field name="model">sf.cold.site</field>
        <field name="arch" type="xml">
            <list string="Cold Storage Sites">
                <field name="name"/>
                <field name="device_type"/>
                <field name="target_min_temp"/>
                <field name="target_max_temp"/>
                <field name="location"/>
                <field name="state" widget="badge"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="sf_cold_site_view_form" model="ir.ui.view">
        <field name="name">sf.cold.site.form</field>
        <field name="model">sf.cold.site</field>
        <field name="arch" type="xml">
            <form string="Cold Storage Site">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="device_type"/>
                            <field name="target_min_temp"/>
                            <field name="target_max_temp"/>
                        </group>
                        <group>
                            <field name="location"/>
                            <field name="state" readonly="1"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Readings">
                            <field name="reading_ids">
                                <list string="Readings">
                                    <field name="recorded_at"/>
                                    <field name="temperature"/>
                                    <field name="source"/>
                                    <field name="within_range" widget="boolean_toggle"/>
                                    <field name="deviation"/>
                                </list>
                            </field>
                        </page>
                        <page string="Excursions">
                            <field name="excursion_ids">
                                <list string="Excursions">
                                    <field name="name"/>
                                    <field name="started_at"/>
                                    <field name="duration_minutes"/>
                                    <field name="min_temp"/>
                                    <field name="max_temp"/>
                                    <field name="severity"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="sf_cold_site_view_search" model="ir.ui.view">
        <field name="name">sf.cold.site.search</field>
        <field name="model">sf.cold.site</field>
        <field name="arch" type="xml">
            <search string="Cold Storage Sites">
                <field name="name"/>
                <field name="device_type"/>
                <field name="location"/>
                <group>
                    <filter name="group_device_type" string="Type" context="{'group_by': 'device_type'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_sf_cold_site" model="ir.actions.act_window">
        <field name="name">Cold Storage Sites</field>
        <field name="res_model">sf.cold.site</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="sf_cold_site_view_search"/>
    </record>
</odoo>