<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_sales_coaching_effectiveness" model="ir.actions.act_window">
        <field name="name">Coaching Effectiveness Tracker</field>
        <field name="res_model">sf.sales_coaching_effectiveness</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
    <record id="view_sf_sales_coaching_effectiveness_form" model="ir.ui.view">
        <field name="name">sf.sales_coaching_effectiveness.form</field>
        <field name="model">sf.sales_coaching_effectiveness</field>
        <field name="arch" type="xml">
            <form string="Coaching Effectiveness Tracker">
                <header>
                    <button name="action_submitted" type="object" string="Submitted"
                            class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="rep_id"/>
                            <field name="coaching_topic"/>
                            <field name="pre_metric"/>
                            <field name="post_metric"/>
                            <field name="improvement_percent"/>
                            <field name="coach_id"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_sales_coaching_effectiveness_list" model="ir.ui.view">
        <field name="name">sf.sales_coaching_effectiveness.list</field>
        <field name="model">sf.sales_coaching_effectiveness</field>
        <field name="arch" type="xml">
            <list string="Coaching Effectiveness Tracker" sample="1">
                <field name="rep_id"/>
                <field name="coaching_topic"/>
                <field name="pre_metric"/>
                <field name="post_metric"/>
                <field name="improvement_percent"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state in ('submitted','approved')"/>
            </list>
        </field>
    </record>
    <record id="view_sf_sales_coaching_effectiveness_kanban" model="ir.ui.view">
        <field name="name">sf.sales_coaching_effectiveness.kanban</field>
        <field name="model">sf.sales_coaching_effectiveness</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_view" group_by="state">
                <field name="name"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <menuitem id="menu_sf_sales_coaching_effectiveness_root" name="Coaching Effectiveness Tracker" sequence="14"
              web_icon="sf_sales_coaching_effectiveness,static/description/icon.png"/>
    <menuitem id="menu_sf_sales_coaching_effectiveness_main" name="Records"
              parent="menu_sf_sales_coaching_effectiveness_root" action="action_sf_sales_coaching_effectiveness" sequence="10"/>

    <record id="wave_final_sf_sales_coaching_effectiveness" model="ir.actions.server">
        <field name="name">Refresh Business Data</field>
        <field name="model_id" ref="model_sf_sales_coaching_effectiveness"/>
        <field name="binding_model_id" ref="model_sf_sales_coaching_effectiveness"/>
        <field name="state">code</field>
        <field name="code">records.action_refresh_business()</field>
    </record>
</odoo>
