<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_sales_coaching_effectiveness" model="ir.module.category">
        <field name="name">Coaching Effectiveness Tracker</field>
        <field name="sequence">487</field>
    </record>
    <record id="group_sales_coaching_effectiveness_user" model="res.groups">
        <field name="name">Coaching Effectiveness Tracker User</field>
        <field name="category_id" ref="module_category_sales_coaching_effectiveness"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>

    </record>
    <record id="group_sales_coaching_effectiveness_manager" model="res.groups">
        <field name="name">Coaching Effectiveness Tracker Manager</field>
        <field name="category_id" ref="module_category_sales_coaching_effectiveness"/>
        <field name="implied_ids" eval="[(4, ref('group_sales_coaching_effectiveness_user'))]"/>
    </record>
    <record id="rule_sales_coaching_effectiveness_sf_sales_coaching_effectiveness" model="ir.rule">
        <field name="name">Coaching Effectiveness Tracker: multi-company</field>
        <field name="model_id" ref="model_sf_sales_coaching_effectiveness"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
