<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_risk" model="ir.module.category">
        <field name="name">GRC &amp; Risk</field>
        <field name="sequence">95</field>
    </record>

    <record id="group_risk_user" model="res.groups">
        <field name="name">GRC User</field>
        <field name="category_id" ref="module_category_risk"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_risk_manager" model="res.groups">
        <field name="name">GRC Manager</field>
        <field name="category_id" ref="module_category_risk"/>
        <field name="implied_ids" eval="[(4, ref('group_risk_user'))]"/>
    </record>

    <record id="rule_risk_user_company" model="ir.rule">
        <field name="name">Risk: user sees own company</field>
        <field name="model_id" ref="model_sf_risk"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_risk_user'))]"/>
    </record>

    <record id="rule_risk_control_user_company" model="ir.rule">
        <field name="name">Control: user sees own company</field>
        <field name="model_id" ref="model_sf_risk_control"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_risk_user'))]"/>
    </record>

    <record id="rule_risk_requirement_user_company" model="ir.rule">
        <field name="name">Requirement: user sees own company</field>
        <field name="model_id" ref="model_sf_risk_requirement"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_risk_user'))]"/>
    </record>
</odoo>