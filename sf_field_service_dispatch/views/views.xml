<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_field_service_dispatch" model="ir.actions.act_window">
        <field name="name">Field Service Dispatch Board</field>
        <field name="res_model">sf.field_service_dispatch</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
    <record id="view_sf_field_service_dispatch_form" model="ir.ui.view">
        <field name="name">sf.field_service_dispatch.form</field>
        <field name="model">sf.field_service_dispatch</field>
        <field name="arch" type="xml">
            <form string="Field Service Dispatch Board">
                <header>
                    <button name="action_submitted" type="object" string="Submitted"
                            class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="technician_id"/>
                            <field name="partner_id"/>
                            <field name="service_type"/>
                            <field name="scheduled_at"/>
                            <field name="sla_hours"/>
                            <field name="status_note"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_field_service_dispatch_list" model="ir.ui.view">
        <field name="name">sf.field_service_dispatch.list</field>
        <field name="model">sf.field_service_dispatch</field>
        <field name="arch" type="xml">
            <list string="Field Service Dispatch Board" sample="1">
                <field name="technician_id"/>
                <field name="partner_id"/>
                <field name="service_type"/>
                <field name="scheduled_at"/>
                <field name="sla_hours"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state in ('submitted','approved')"/>
            </list>
        </field>
    </record>
    <record id="view_sf_field_service_dispatch_kanban" model="ir.ui.view">
        <field name="name">sf.field_service_dispatch.kanban</field>
        <field name="model">sf.field_service_dispatch</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_view" group_by="state">
                <field name="name"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <menuitem id="menu_sf_field_service_dispatch_root" name="Field Service Dispatch Board" sequence="7"
              web_icon="sf_field_service_dispatch,static/description/icon.png"/>
    <menuitem id="menu_sf_field_service_dispatch_main" name="Records"
              parent="menu_sf_field_service_dispatch_root" action="action_sf_field_service_dispatch" sequence="10"/>

    <record id="wave_final_sf_field_service_dispatch" model="ir.actions.server">
        <field name="name">Refresh Business Data</field>
        <field name="model_id" ref="model_sf_field_service_dispatch"/>
        <field name="binding_model_id" ref="model_sf_field_service_dispatch"/>
        <field name="state">code</field>
        <field name="code">records.action_refresh_business()</field>
    </record>
</odoo>
