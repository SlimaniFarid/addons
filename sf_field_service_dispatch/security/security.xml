<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_field_service_dispatch" model="ir.module.category">
        <field name="name">Field Service Dispatch Board</field>
        <field name="sequence">394</field>
    </record>
    <record id="group_field_service_dispatch_user" model="res.groups">
        <field name="name">Field Service Dispatch Board User</field>
        <field name="category_id" ref="module_category_field_service_dispatch"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>

    </record>
    <record id="group_field_service_dispatch_manager" model="res.groups">
        <field name="name">Field Service Dispatch Board Manager</field>
        <field name="category_id" ref="module_category_field_service_dispatch"/>
        <field name="implied_ids" eval="[(4, ref('group_field_service_dispatch_user'))]"/>
    </record>
    <record id="rule_field_service_dispatch_sf_field_service_dispatch" model="ir.rule">
        <field name="name">Field Service Dispatch Board: multi-company</field>
        <field name="model_id" ref="model_sf_field_service_dispatch"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
