<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_sell_through" model="ir.actions.act_window">
        <field name="name">Distributor Sell-Through Reporting</field>
        <field name="res_model">sf.sell.through</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
    <record id="view_sf_sell_through_form" model="ir.ui.view">
        <field name="name">sf.sell.through.form</field>
        <field name="model">sf.sell.through</field>
        <field name="arch" type="xml">
            <form string="Distributor Sell-Through Reporting">
                <header>
                    <button name="action_received" type="object" string="Received"
                            class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,received,validated"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="period_month"/>
                            <field name="product_id"/>
                            <field name="opening_stock"/>
                            <field name="purchases"/>
                            <field name="sell_through_qty"/>
                            <field name="closing_stock"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_sell_through_list" model="ir.ui.view">
        <field name="name">sf.sell.through.list</field>
        <field name="model">sf.sell.through</field>
        <field name="arch" type="xml">
            <list string="Distributor Sell-Through Reporting" sample="1">
                <field name="partner_id"/>
                <field name="period_month"/>
                <field name="product_id"/>
                <field name="opening_stock"/>
                <field name="purchases"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state in ('submitted','approved')"/>
            </list>
        </field>
    </record>
    <record id="view_sf_sell_through_kanban" model="ir.ui.view">
        <field name="name">sf.sell.through.kanban</field>
        <field name="model">sf.sell.through</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_view" group_by="state">
                <field name="name"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <menuitem id="menu_sf_sell_through_root" name="Distributor Sell-Through Reporting" sequence="7"
              web_icon="sf_sell_through_reporting,static/description/icon.png"/>
    <menuitem id="menu_sf_sell_through_main" name="Records"
              parent="menu_sf_sell_through_root" action="action_sf_sell_through" sequence="10"/>
</odoo>
