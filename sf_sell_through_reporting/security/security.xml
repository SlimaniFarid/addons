<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_sell_through_reporting" model="ir.module.category">
        <field name="name">Distributor Sell-Through Reporting</field>
        <field name="sequence">41</field>
    </record>
    <record id="group_sell_through_reporting_user" model="res.groups">
        <field name="name">Distributor Sell-Through Reporting User</field>
        <field name="category_id" ref="module_category_sell_through_reporting"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>

    </record>
    <record id="group_sell_through_reporting_manager" model="res.groups">
        <field name="name">Distributor Sell-Through Reporting Manager</field>
        <field name="category_id" ref="module_category_sell_through_reporting"/>
        <field name="implied_ids" eval="[(4, ref('group_sell_through_reporting_user'))]"/>
    </record>
    <record id="rule_sell_through_reporting_sf_sell_through" model="ir.rule">
        <field name="name">Sell-Through Report: multi-company</field>
        <field name="model_id" ref="model_sf_sell_through"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
