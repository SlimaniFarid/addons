<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_packaging_spec" model="ir.actions.act_window">
        <field name="name">Packaging Specification Register</field>
        <field name="res_model">sf.packaging.spec</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
    <record id="view_sf_packaging_spec_form" model="ir.ui.view">
        <field name="name">sf.packaging.spec.form</field>
        <field name="model">sf.packaging.spec</field>
        <field name="arch" type="xml">
            <form string="Packaging Specification Register">
                <header>
                    <button name="action_approved" type="object" string="Approved"
                            class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,approved,obsolete"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="product_id"/>
                            <field name="box_type"/>
                            <field name="units_per_box"/>
                            <field name="boxes_per_pallet"/>
                            <field name="label_ref"/>
                            <field name="revision"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_packaging_spec_list" model="ir.ui.view">
        <field name="name">sf.packaging.spec.list</field>
        <field name="model">sf.packaging.spec</field>
        <field name="arch" type="xml">
            <list string="Packaging Specification Register" sample="1">
                <field name="product_id"/>
                <field name="box_type"/>
                <field name="units_per_box"/>
                <field name="boxes_per_pallet"/>
                <field name="label_ref"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state in ('submitted','approved')"/>
            </list>
        </field>
    </record>
    <record id="view_sf_packaging_spec_kanban" model="ir.ui.view">
        <field name="name">sf.packaging.spec.kanban</field>
        <field name="model">sf.packaging.spec</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_view" group_by="state">
                <field name="name"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <menuitem id="menu_sf_packaging_spec_root" name="Packaging Specification Register" sequence="11"
              web_icon="sf_packaging_spec_register,static/description/icon.png"/>
    <menuitem id="menu_sf_packaging_spec_main" name="Records"
              parent="menu_sf_packaging_spec_root" action="action_sf_packaging_spec" sequence="10"/>

    <record id="wave_final_sf_packaging_spec_register" model="ir.actions.server">
        <field name="name">Refresh Business Data</field>
        <field name="model_id" ref="model_sf_packaging_spec"/>
        <field name="binding_model_id" ref="model_sf_packaging_spec"/>
        <field name="state">code</field>
        <field name="code">records.action_refresh_business()</field>
    </record>
</odoo>
