<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_packaging_spec_register" model="ir.module.category">
        <field name="name">Packaging Specification Register</field>
        <field name="sequence">4</field>
    </record>
    <record id="group_packaging_spec_register_user" model="res.groups">
        <field name="name">Packaging Specification Register User</field>
        <field name="category_id" ref="module_category_packaging_spec_register"/>
        <field name="implied_ids" eval="[(4, ref('stock.group_stock_user'))]"/>

    </record>
    <record id="group_packaging_spec_register_manager" model="res.groups">
        <field name="name">Packaging Specification Register Manager</field>
        <field name="category_id" ref="module_category_packaging_spec_register"/>
        <field name="implied_ids" eval="[(4, ref('group_packaging_spec_register_user'))]"/>
    </record>
    <record id="rule_packaging_spec_register_sf_packaging_spec" model="ir.rule">
        <field name="name">Packaging Spec: multi-company</field>
        <field name="model_id" ref="model_sf_packaging_spec"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_packaging_spec_register"/>
    </record>
</odoo>
