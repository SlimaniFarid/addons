<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sf_product_reviews_product_template_form" model="ir.ui.view">
        <field name="name">product.template.form.sf.product.reviews</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Reviews" name="sf_reviews">
                    <group>
                        <group>
                            <field name="sf_review_avg" string="Average Rating"/>
                        </group>
                        <group>
                            <field name="sf_review_count" string="Review Count"/>
                        </group>
                    </group>
                    <field name="sf_product_review_ids" readonly="1">
                        <list decoration-danger="is_overdue" string="Reviews">
                            <field name="name"/>
                            <field name="author_name"/>
                            <field name="rating"/>
                            <field name="verified_purchase"/>
                            <field name="review_date"/>
                            <field name="state"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_sf_product_reviews_boost_kanban" model="ir.ui.view">
        <field name="name">sf_product_reviews.boost.kanban</field>
        <field name="model">sf.product.review</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" t-att-color="state">
                <field name="name"/>
                <field name="state"/>
                <field name="user_id"/>
                <field name="review_date"/>
                <field name="is_overdue" invisible="1"/>

                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_card oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title">
                                    <field name="name"/></strong>
                                <div class="o_kanban_record_subtitle">
                                    <field name="user_id" widget="many2one_avatar_user"/>
                                    <field name="review_date"/></div>
                            </div>
                            <div class="oe_kanban_bottom_right">
                                <field name="state" widget="badge"
                                       t-attf-options="{'classes_map': {'draft': 'info', 'done': 'success', 'cancelled': 'danger'}, 'domain': []}"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_sf_product_reviews_boost_search" model="ir.ui.view">
        <field name="name">sf_product_reviews.boost.search</field>
        <field name="model">sf.product.review</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
<separator/>
                <filter string="My records" name="my_records" domain="[('user_id', '=', uid)]"/>
                <filter string="To Do" name="todo" domain="[('state', 'not in', ('done', 'cancelled', 'closed'))]"/>
                <group expand="0" string="Group By"><filter string="Status" name="gb_state" context="{'group_by': 'state'}"/></group>
            </search>
        </field>
    </record>

    <record id="wave_final_sf_product_reviews" model="ir.actions.server">
        <field name="name">Refresh Business Data</field>
        <field name="model_id" ref="model_sf_product_review"/>
        <field name="binding_model_id" ref="model_sf_product_review"/>
        <field name="state">code</field>
        <field name="code">records.action_refresh_business()</field>
    </record>
</odoo>
