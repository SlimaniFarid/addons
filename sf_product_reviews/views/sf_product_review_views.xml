<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sf_product_review_view_list" model="ir.ui.view">
        <field name="name">sf.product.review.list</field>
        <field name="model">sf.product.review</field>
        <field name="arch" type="xml">
            <list decoration-danger="is_overdue" string="Product Reviews">
                <field name="name"/>
                <field name="product_id"/>
                <field name="partner_id"/>
                <field name="author_name"/>
                <field name="rating"/>
                <field name="verified_purchase"/>
                <field name="review_date"/>
                <field name="state" widget="badge"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="sf_product_review_view_form" model="ir.ui.view">
        <field name="name">sf.product.review.form</field>
        <field name="model">sf.product.review</field>
        <field name="arch" type="xml">
            <form string="Product Review">
                <header>
                    <button name="action_submit" string="Submit" type="object" class="btn-primary"
                            invisible="[('state', '!=', 'draft')]"/>
                    <button name="action_approve" string="Approve" type="object"
                            class="btn-primary" invisible="[('state', '!=', 'submitted')]"
                            groups="sf_product_reviews.group_sf_product_reviews_manager"/>
                    <button name="action_reject" string="Reject" type="object"
                            invisible="[('state', '!=', 'submitted')]"
                            groups="sf_product_reviews.group_sf_product_reviews_manager"/>
                    <button name="action_archive" string="Archive" type="object"
                            invisible="[('state', '!=', 'approved')]"
                            groups="sf_product_reviews.group_sf_product_reviews_manager"/>
                    <field name="state" widget="statusbar" readonly="1"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="title" placeholder="Title"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="product_id"/>
                            <field name="partner_id"/>
                            <field name="author_name"/>
                        </group>
                        <group>
                            <field name="rating"/>
                            <field name="review_date"/>
                            <field name="verified_purchase"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group string="Comment">
                        <field name="body"/>
                    </group>
                    <group string="Reply">
                        <field name="reply"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="sf_product_review_view_search" model="ir.ui.view">
        <field name="name">sf.product.review.search</field>
        <field name="model">sf.product.review</field>
        <field name="arch" type="xml">
            <search string="Product Reviews">
                <field name="product_id"/>
                <field name="partner_id"/>
                <field name="author_name"/>
                <filter name="review_approved" string="Approved" domain="[('state', '=', 'approved')]"/>
                <filter name="review_submitted" string="Submitted" domain="[('state', '=', 'submitted')]"/>
                <filter name="review_rejected" string="Rejected" domain="[('state', '=', 'rejected')]"/>
                <filter name="review_verified" string="Verified Purchase" domain="[('verified_purchase', '=', True)]"/>
                <group>
                    <filter name="group_review_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_review_rating" string="Rating" context="{'group_by': 'rating'}"/>
                    <filter name="group_review_product" string="Product" context="{'group_by': 'product_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_sf_product_review" model="ir.actions.act_window">
        <field name="name">Product Reviews</field>
        <field name="res_model">sf.product.review</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="sf_product_review_view_search"/>
    </record>

    <record id="view_sf_product_reviews_boost_kanban" model="ir.ui.view">
        <field name="name">sf_product_reviews.boost.kanban</field>
        <field name="model">sf.product.review</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" t-att-color="state">
                <field name="name"/>
                <field name="state"/>
                <field name="user_id"/>
                <field name="review_date"/>
                <field name="is_overdue" invisible="1"/>

                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_card oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title">
                                    <field name="name"/></strong>
                                <div class="o_kanban_record_subtitle">
                                    <field name="user_id" widget="many2one_avatar_user"/>
                                    <field name="review_date"/></div>
                            </div>
                            <div class="oe_kanban_bottom_right">
                                <field name="state" widget="badge"
                                       t-attf-options="{'classes_map': {'draft': 'info', 'done': 'success', 'cancelled': 'danger'}, 'domain': []}"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_sf_product_reviews_boost_search" model="ir.ui.view">
        <field name="name">sf_product_reviews.boost.search</field>
        <field name="model">sf.product.review</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
<separator/>
                <filter string="My records" name="my_records" domain="[('user_id', '=', uid)]"/>
                <filter string="To Do" name="todo" domain="[('state', 'not in', ('done', 'cancelled', 'closed'))]"/>
                <group expand="0" string="Group By"><filter string="Status" name="gb_state" context="{'group_by': 'state'}"/></group>
            </search>
        </field>
    </record>
</odoo>
