<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="module_category_sf_product_reviews" model="ir.module.category">
            <field name="name">Product Reviews</field>
            <field name="description">E-commerce Product Reviews &amp; Ratings.</field>
            <field name="sequence">10</field>
        </record>

        <record id="group_sf_product_reviews_user" model="res.groups">
            <field name="name">Product Reviews / User</field>
            <field name="category_id" ref="module_category_sf_product_reviews"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_sf_product_reviews_manager" model="res.groups">
            <field name="name">Product Reviews / Manager</field>
            <field name="category_id" ref="module_category_sf_product_reviews"/>
            <field name="implied_ids" eval="[(4, ref('sf_product_reviews.group_sf_product_reviews_user'))]"/>
        </record>

        <record id="rule_sf_product_review_company" model="ir.rule">
            <field name="name">Product Review: user sees own company</field>
            <field name="model_id" ref="model_sf_product_review"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('sf_product_reviews.group_sf_product_reviews_user'))]"/>
        </record>
        <record id="rule_sf_product_review_manager_all" model="ir.rule">
            <field name="name">Product Review: manager sees all companies</field>
            <field name="model_id" ref="model_sf_product_review"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('sf_product_reviews.group_sf_product_reviews_manager'))]"/>
        </record>
    </data>
    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_sf_product_reviews"/>
    </record>
</odoo>