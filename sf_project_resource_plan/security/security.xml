<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_project_resource_plan" model="ir.module.category">
        <field name="name">Resource Allocation Plan</field>
        <field name="sequence">397</field>
    </record>
    <record id="group_project_resource_plan_user" model="res.groups">
        <field name="name">Resource Allocation Plan User</field>
        <field name="category_id" ref="module_category_project_resource_plan"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>

    </record>
    <record id="group_project_resource_plan_manager" model="res.groups">
        <field name="name">Resource Allocation Plan Manager</field>
        <field name="category_id" ref="module_category_project_resource_plan"/>
        <field name="implied_ids" eval="[(4, ref('group_project_resource_plan_user'))]"/>
    </record>
    <record id="rule_project_resource_plan_sf_project_resource_plan" model="ir.rule">
        <field name="name">Resource Allocation Plan: multi-company</field>
        <field name="model_id" ref="model_sf_project_resource_plan"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_project_resource_plan"/>
    </record>
</odoo>
