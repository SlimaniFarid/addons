<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_waste_stream_tracker" model="ir.module.category">
        <field name="name">Waste Stream Tracker</field>
        <field name="sequence">163</field>
    </record>
    <record id="group_waste_stream_tracker_user" model="res.groups">
        <field name="name">Waste Stream Tracker User</field>
        <field name="category_id" ref="module_category_waste_stream_tracker"/>

    </record>
    <record id="group_waste_stream_tracker_manager" model="res.groups">
        <field name="name">Waste Stream Tracker Manager</field>
        <field name="category_id" ref="module_category_waste_stream_tracker"/>
        <field name="implied_ids" eval="[(4, ref('group_waste_stream_tracker_user'))]"/>
    </record>
    <record id="rule_waste_stream_tracker_sf_waste_stream_tracker" model="ir.rule">
        <field name="name">Waste Stream Tracker: multi-company</field>
        <field name="model_id" ref="model_sf_waste_stream_tracker"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_waste_stream_tracker"/>
    </record>
</odoo>
