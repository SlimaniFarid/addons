<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_customer_care_satisfaction" model="ir.module.category">
        <field name="name">Post-Interaction Satisfaction</field>
        <field name="sequence">269</field>
    </record>
    <record id="group_customer_care_satisfaction_user" model="res.groups">
        <field name="name">Post-Interaction Satisfaction User</field>
        <field name="category_id" ref="module_category_customer_care_satisfaction"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>

    </record>
    <record id="group_customer_care_satisfaction_manager" model="res.groups">
        <field name="name">Post-Interaction Satisfaction Manager</field>
        <field name="category_id" ref="module_category_customer_care_satisfaction"/>
        <field name="implied_ids" eval="[(4, ref('group_customer_care_satisfaction_user'))]"/>
    </record>
    <record id="rule_customer_care_satisfaction_sf_customer_care_satisfaction" model="ir.rule">
        <field name="name">Post-Interaction Satisfaction: multi-company</field>
        <field name="model_id" ref="model_sf_customer_care_satisfaction"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
