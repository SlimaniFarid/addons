<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_quality_cost_tracker" model="ir.actions.act_window">
        <field name="name">Cost of Quality Tracker</field>
        <field name="res_model">sf.quality_cost_tracker</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
    <record id="view_sf_quality_cost_tracker_form" model="ir.ui.view">
        <field name="name">sf.quality_cost_tracker.form</field>
        <field name="model">sf.quality_cost_tracker</field>
        <field name="arch" type="xml">
            <form string="Cost of Quality Tracker">
                <header>
                    <button name="action_submitted" type="object" string="Submitted"
                            class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="cost_category"/>
                            <field name="period"/>
                            <field name="amount"/>
                            <field name="trend"/>
                            <field name="notes"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_quality_cost_tracker_list" model="ir.ui.view">
        <field name="name">sf.quality_cost_tracker.list</field>
        <field name="model">sf.quality_cost_tracker</field>
        <field name="arch" type="xml">
            <list string="Cost of Quality Tracker" sample="1">
                <field name="cost_category"/>
                <field name="period"/>
                <field name="amount"/>
                <field name="trend"/>
                <field name="notes"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state in ('submitted','approved')"/>
            </list>
        </field>
    </record>
    <record id="view_sf_quality_cost_tracker_kanban" model="ir.ui.view">
        <field name="name">sf.quality_cost_tracker.kanban</field>
        <field name="model">sf.quality_cost_tracker</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_view" group_by="state">
                <field name="name"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <menuitem id="menu_sf_quality_cost_tracker_root" name="Cost of Quality Tracker" sequence="10"
              web_icon="sf_quality_cost_tracker,static/description/icon.png"/>
    <menuitem id="menu_sf_quality_cost_tracker_main" name="Records"
              parent="menu_sf_quality_cost_tracker_root" action="action_sf_quality_cost_tracker" sequence="10"/>

    <record id="wave_final_sf_quality_cost_tracker" model="ir.actions.server">
        <field name="name">Refresh Business Data</field>
        <field name="model_id" ref="model_sf_quality_cost_tracker"/>
        <field name="binding_model_id" ref="model_sf_quality_cost_tracker"/>
        <field name="state">code</field>
        <field name="code">records.action_refresh_business()</field>
    </record>
</odoo>
