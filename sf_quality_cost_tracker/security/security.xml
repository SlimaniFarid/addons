<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_quality_cost_tracker" model="ir.module.category">
        <field name="name">Cost of Quality Tracker</field>
        <field name="sequence">191</field>
    </record>
    <record id="group_quality_cost_tracker_user" model="res.groups">
        <field name="name">Cost of Quality Tracker User</field>
        <field name="category_id" ref="module_category_quality_cost_tracker"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>

    </record>
    <record id="group_quality_cost_tracker_manager" model="res.groups">
        <field name="name">Cost of Quality Tracker Manager</field>
        <field name="category_id" ref="module_category_quality_cost_tracker"/>
        <field name="implied_ids" eval="[(4, ref('group_quality_cost_tracker_user'))]"/>
    </record>
    <record id="rule_quality_cost_tracker_sf_quality_cost_tracker" model="ir.rule">
        <field name="name">Cost of Quality Tracker: multi-company</field>
        <field name="model_id" ref="model_sf_quality_cost_tracker"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
