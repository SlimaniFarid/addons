<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_marketing_campaign_roi" model="ir.actions.act_window">
        <field name="name">Marketing Campaign ROI Tracker</field>
        <field name="res_model">sf.marketing_campaign_roi</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
    <record id="view_sf_marketing_campaign_roi_form" model="ir.ui.view">
        <field name="name">sf.marketing_campaign_roi.form</field>
        <field name="model">sf.marketing_campaign_roi</field>
        <field name="arch" type="xml">
            <form string="Marketing Campaign ROI Tracker">
                <header>
                    <button name="action_submitted" type="object" string="Submitted"
                            class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="campaign_name"/>
                            <field name="channel"/>
                            <field name="spend"/>
                            <field name="leads_generated"/>
                            <field name="conversions"/>
                            <field name="revenue_generated"/>
                            <field name="roi_percent"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_marketing_campaign_roi_list" model="ir.ui.view">
        <field name="name">sf.marketing_campaign_roi.list</field>
        <field name="model">sf.marketing_campaign_roi</field>
        <field name="arch" type="xml">
            <list string="Marketing Campaign ROI Tracker" sample="1">
                <field name="campaign_name"/>
                <field name="channel"/>
                <field name="spend"/>
                <field name="leads_generated"/>
                <field name="conversions"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state in ('submitted','approved')"/>
            </list>
        </field>
    </record>
    <record id="view_sf_marketing_campaign_roi_kanban" model="ir.ui.view">
        <field name="name">sf.marketing_campaign_roi.kanban</field>
        <field name="model">sf.marketing_campaign_roi</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_view" group_by="state">
                <field name="name"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <menuitem id="menu_sf_marketing_campaign_roi_root" name="Marketing Campaign ROI Tracker" sequence="17"
              web_icon="sf_marketing_campaign_roi,static/description/icon.png"/>
    <menuitem id="menu_sf_marketing_campaign_roi_main" name="Records"
              parent="menu_sf_marketing_campaign_roi_root" action="action_sf_marketing_campaign_roi" sequence="10"/>

    <record id="wave_final_sf_marketing_campaign_roi" model="ir.actions.server">
        <field name="name">Refresh Business Data</field>
        <field name="model_id" ref="model_sf_marketing_campaign_roi"/>
        <field name="binding_model_id" ref="model_sf_marketing_campaign_roi"/>
        <field name="state">code</field>
        <field name="code">records.action_refresh_business()</field>
    </record>
</odoo>
