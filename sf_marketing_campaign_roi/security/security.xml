<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_marketing_campaign_roi" model="ir.module.category">
        <field name="name">Marketing Campaign ROI Tracker</field>
        <field name="sequence">184</field>
    </record>
    <record id="group_marketing_campaign_roi_user" model="res.groups">
        <field name="name">Marketing Campaign ROI Tracker User</field>
        <field name="category_id" ref="module_category_marketing_campaign_roi"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>

    </record>
    <record id="group_marketing_campaign_roi_manager" model="res.groups">
        <field name="name">Marketing Campaign ROI Tracker Manager</field>
        <field name="category_id" ref="module_category_marketing_campaign_roi"/>
        <field name="implied_ids" eval="[(4, ref('group_marketing_campaign_roi_user'))]"/>
    </record>
    <record id="rule_marketing_campaign_roi_sf_marketing_campaign_roi" model="ir.rule">
        <field name="name">Marketing Campaign ROI Tracker: multi-company</field>
        <field name="model_id" ref="model_sf_marketing_campaign_roi"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
