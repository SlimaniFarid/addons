<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_late_interest" model="ir.actions.act_window">
        <field name="name">Late Payment Interest Calculator</field>
        <field name="res_model">sf.late.interest</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
    <record id="view_sf_late_interest_form" model="ir.ui.view">
        <field name="name">sf.late.interest.form</field>
        <field name="model">sf.late.interest</field>
        <field name="arch" type="xml">
            <form string="Late Payment Interest Calculator">
                <header>
                    <button name="action_computed" type="object" string="Computed"
                            class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,computed,invoiced"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="rate_percent"/>
                            <field name="grace_days"/>
                            <field name="as_of_date"/>
                            <field name="total_interest"/>
                            <field name="invoice_count"/>
                            <field name="notes"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_late_interest_list" model="ir.ui.view">
        <field name="name">sf.late.interest.list</field>
        <field name="model">sf.late.interest</field>
        <field name="arch" type="xml">
            <list string="Late Payment Interest Calculator" sample="1">
                <field name="rate_percent"/>
                <field name="grace_days"/>
                <field name="as_of_date"/>
                <field name="total_interest"/>
                <field name="invoice_count"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state in ('submitted','approved')"/>
            </list>
        </field>
    </record>
    <record id="view_sf_late_interest_kanban" model="ir.ui.view">
        <field name="name">sf.late.interest.kanban</field>
        <field name="model">sf.late.interest</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_view" group_by="state">
                <field name="name"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <menuitem id="menu_sf_late_interest_root" name="Late Payment Interest Calculator" sequence="13"
              web_icon="sf_late_payment_interest,static/description/icon.png"/>
    <menuitem id="menu_sf_late_interest_main" name="Records"
              parent="menu_sf_late_interest_root" action="action_sf_late_interest" sequence="10"/>
</odoo>
