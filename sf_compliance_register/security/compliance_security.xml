<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_compliance" model="ir.module.category">
        <field name="name">Compliance</field>
        <field name="sequence">95</field>
    </record>

    <record id="group_compliance_user" model="res.groups">
        <field name="name">Compliance User</field>
        <field name="category_id" ref="module_category_compliance"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_compliance_manager" model="res.groups">
        <field name="name">Compliance Manager</field>
        <field name="category_id" ref="module_category_compliance"/>
        <field name="implied_ids" eval="[(4, ref('group_compliance_user'))]"/>
    </record>

    <record id="rule_compliance_document_user_company" model="ir.rule">
        <field name="name">Compliance Document: user sees own company</field>
        <field name="model_id" ref="model_sf_compliance_document"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_compliance_user'))]"/>
    </record>

    <record id="rule_compliance_type_user_company" model="ir.rule">
        <field name="name">Compliance Type: user sees own company</field>
        <field name="model_id" ref="model_sf_compliance_document_type"/>
        <field name="global" eval="True"/>
        <field name="domain_force">['|', ('company_id', 'in', company_ids), ('company_id', '=', False)]</field>
        <field name="groups" eval="[(4, ref('group_compliance_user'))]"/>
    </record>
    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_compliance"/>
    </record>
</odoo>