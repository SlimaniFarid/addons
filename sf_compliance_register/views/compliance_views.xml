<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Document form -->
    <record id="compliance_document_view_form" model="ir.ui.view">
        <field name="name">sf.compliance.document.form</field>
        <field name="model">sf.compliance.document</field>
        <field name="arch" type="xml">
            <form string="Compliance Document">
                <header>
                    <button name="action_publish" type="object"
                            string="Publish" class="btn-primary"
                            states="draft"/>
                    <button name="action_renew" type="object"
                            string="Renew" class="btn-primary"
                            states="active,expiring,expired"/>
                    <button name="action_expire" type="object"
                            string="Force Expire" states="expired"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="ref"/>
                            <field name="document_type_id"/>
                            <field name="issuer"/>
                            <field name="partner_id"/>
                        </group>
                        <group>
                            <field name="issue_date"/>
                            <field name="expiry_date"/>
                            <field name="alert_days"/>
                            <field name="responsible_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Attachments">
                            <field name="attachment_ids" widget="many2many_binary"/>
                        </page>
                        <page string="Renewal">
                            <group>
                                <group>
                                    <field name="renewal_of_id" readonly="1"/>
                                </group>
                                <group>
                                    <field name="renewed_by_id" readonly="1"/>
                                </group>
                            </group>
                            <field name="history_ids" context="{'tree_view_ref': 'compliance_history_view_tree'}">
                                <tree string="History">
                                    <field name="action"/>
                                    <field name="action_date"/>
                                    <field name="old_expiry_date"/>
                                    <field name="new_expiry_date"/>
                                    <field name="user_id"/>
                                    <field name="notes"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Notes">
                            <field name="notes"/>
                        </page>
                        <page string="Messages">
                            <field name="message_ids"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Document tree -->
    <record id="compliance_document_view_tree" model="ir.ui.view">
        <field name="name">sf.compliance.document.tree</field>
        <field name="model">sf.compliance.document</field>
        <field name="arch" type="xml">
            <tree string="Compliance Documents">
                <field name="name"/>
                <field name="ref"/>
                <field name="document_type_id"/>
                <field name="responsible_id"/>
                <field name="issue_date"/>
                <field name="expiry_date"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <!-- Document kanban -->
    <record id="compliance_document_view_kanban" model="ir.ui.view">
        <field name="name">sf.compliance.document.kanban</field>
        <field name="model">sf.compliance.document</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_mobile">
                <field name="name"/>
                <field name="document_type_id"/>
                <field name="expiry_date"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_record_title">
                                <field name="name"/>
                            </div>
                            <div class="oe_kanban_details">
                                <div><field name="document_type_id"/></div>
                                <div>Expires: <field name="expiry_date"/></div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Document search -->
    <record id="compliance_document_view_search" model="ir.ui.view">
        <field name="name">sf.compliance.document.search</field>
        <field name="model">sf.compliance.document</field>
        <field name="arch" type="xml">
            <search string="Compliance Documents">
                <field name="name"/>
                <field name="ref"/>
                <field name="document_type_id"/>
                <field name="responsible_id"/>
                <filter name="expiring" string="Expiring"
                        domain="[('state', '=', 'expiring')]"/>
                <filter name="expired" string="Expired"
                        domain="[('state', '=', 'expired')]"/>
                <filter name="active" string="Active"
                        domain="[('state', '=', 'active')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_state" string="Status"
                            context="{'group_by': 'state'}"/>
                    <filter name="group_type" string="Type"
                            context="{'group_by': 'document_type_id'}"/>
                    <filter name="group_responsible" string="Responsible"
                            context="{'group_by': 'responsible_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Document type form -->
    <record id="compliance_type_view_form" model="ir.ui.view">
        <field name="name">sf.compliance.document.type.form</field>
        <field name="model">sf.compliance.document.type</field>
        <field name="arch" type="xml">
            <form string="Document Type">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="category"/>
                        </group>
                        <group>
                            <field name="default_alert_days"/>
                            <field name="active"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Document type tree -->
    <record id="compliance_type_view_tree" model="ir.ui.view">
        <field name="name">sf.compliance.document.type.tree</field>
        <field name="model">sf.compliance.document.type</field>
        <field name="arch" type="xml">
            <tree string="Document Types">
                <field name="name"/>
                <field name="code"/>
                <field name="category"/>
                <field name="default_alert_days"/>
            </tree>
        </field>
    </record>

    <!-- History tree -->
    <record id="compliance_history_view_tree" model="ir.ui.view">
        <field name="name">sf.compliance.history.tree</field>
        <field name="model">sf.compliance.history</field>
        <field name="arch" type="xml">
            <tree string="Compliance History">
                <field name="document_id"/>
                <field name="action"/>
                <field name="action_date"/>
                <field name="old_expiry_date"/>
                <field name="new_expiry_date"/>
                <field name="user_id"/>
            </tree>
        </field>
    </record>

    <!-- Renew wizard form -->
    <record id="compliance_renew_wizard_view_form" model="ir.ui.view">
        <field name="name">sf.compliance.renew.wizard.form</field>
        <field name="model">sf.compliance.renew.wizard</field>
        <field name="arch" type="xml">
            <form string="Renew Document">
                <group>
                    <group>
                        <field name="document_id"/>
                        <field name="new_expiry_date"/>
                    </group>
                    <group>
                        <field name="issuer"/>
                    </group>
                </group>
                <group string="Notes">
                    <field name="notes" colspan="2"/>
                </group>
                <footer>
                    <button name="action_renew" type="object"
                            string="Renew" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Actions -->
    <record id="action_compliance_document" model="ir.actions.act_window">
        <field name="name">Compliance Documents</field>
        <field name="res_model">sf.compliance.document</field>
        <field name="view_mode">tree,form,kanban</field>
        <field name="search_view_id" ref="compliance_document_view_search"/>
    </record>

    <record id="action_compliance_type" model="ir.actions.act_window">
        <field name="name">Document Types</field>
        <field name="res_model">sf.compliance.document.type</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record id="action_compliance_history" model="ir.actions.act_window">
        <field name="name">Compliance History</field>
        <field name="res_model">sf.compliance.history</field>
        <field name="view_mode">tree</field>
    </record>

</odoo>