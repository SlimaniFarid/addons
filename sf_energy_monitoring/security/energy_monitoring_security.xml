<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_energy" model="ir.module.category">
        <field name="name">Energy Monitoring</field>
        <field name="sequence">97</field>
    </record>

    <record id="group_energy_user" model="res.groups">
        <field name="name">Energy Monitoring User</field>
        <field name="category_id" ref="module_category_energy"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_energy_manager" model="res.groups">
        <field name="name">Energy Monitoring Manager</field>
        <field name="category_id" ref="module_category_energy"/>
        <field name="implied_ids" eval="[(4, ref('group_energy_user'))]"/>
    </record>

    <record id="rule_energy_site_user_company" model="ir.rule">
        <field name="name">Energy Site: user sees own company</field>
        <field name="model_id" ref="model_sf_energy_site"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_energy_user'))]"/>
    </record>
</odoo>