<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_it_capacity_planning" model="ir.module.category">
        <field name="name">IT Capacity Planning Records</field>
        <field name="sequence">59</field>
    </record>
    <record id="group_it_capacity_planning_user" model="res.groups">
        <field name="name">IT Capacity Planning Records User</field>
        <field name="category_id" ref="module_category_it_capacity_planning"/>

    </record>
    <record id="group_it_capacity_planning_manager" model="res.groups">
        <field name="name">IT Capacity Planning Records Manager</field>
        <field name="category_id" ref="module_category_it_capacity_planning"/>
        <field name="implied_ids" eval="[(4, ref('group_it_capacity_planning_user'))]"/>
    </record>
    <record id="rule_it_capacity_planning_sf_it_capacity" model="ir.rule">
        <field name="name">Capacity Record: multi-company</field>
        <field name="model_id" ref="model_sf_it_capacity"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
