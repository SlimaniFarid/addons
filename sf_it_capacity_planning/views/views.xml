<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_it_capacity" model="ir.actions.act_window">
        <field name="name">IT Capacity Planning Records</field>
        <field name="res_model">sf.it.capacity</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
    <record id="view_sf_it_capacity_form" model="ir.ui.view">
        <field name="name">sf.it.capacity.form</field>
        <field name="model">sf.it.capacity</field>
        <field name="arch" type="xml">
            <form string="IT Capacity Planning Records">
                <header>
                    <button name="action_watch" type="object" string="Watch"
                            class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="healthy,watch,critical"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="resource_name"/>
                            <field name="resource_type"/>
                            <field name="cpu_percent"/>
                            <field name="ram_percent"/>
                            <field name="storage_percent"/>
                            <field name="forecast_exhaustion"/>
                            <field name="action_plan"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_it_capacity_list" model="ir.ui.view">
        <field name="name">sf.it.capacity.list</field>
        <field name="model">sf.it.capacity</field>
        <field name="arch" type="xml">
            <list string="IT Capacity Planning Records" sample="1">
                <field name="resource_name"/>
                <field name="resource_type"/>
                <field name="cpu_percent"/>
                <field name="ram_percent"/>
                <field name="storage_percent"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state in ('submitted','approved')"/>
            </list>
        </field>
    </record>
    <record id="view_sf_it_capacity_kanban" model="ir.ui.view">
        <field name="name">sf.it.capacity.kanban</field>
        <field name="model">sf.it.capacity</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_view" group_by="state">
                <field name="name"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <menuitem id="menu_sf_it_capacity_root" name="IT Capacity Planning Records" sequence="9"
              web_icon="sf_it_capacity_planning,static/description/icon.png"/>
    <menuitem id="menu_sf_it_capacity_main" name="Records"
              parent="menu_sf_it_capacity_root" action="action_sf_it_capacity" sequence="10"/>
</odoo>
