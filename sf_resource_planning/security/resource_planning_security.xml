<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_resource_planning" model="ir.module.category">
        <field name="name">Resource Planning</field>
        <field name="sequence">90</field>
    </record>

    <record id="group_resource_planning_user" model="res.groups">
        <field name="name">Resource Planning User</field>
        <field name="category_id" ref="module_category_resource_planning"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_resource_planning_manager" model="res.groups">
        <field name="name">Resource Planning Manager</field>
        <field name="category_id" ref="module_category_resource_planning"/>
        <field name="implied_ids" eval="[(4, ref('group_resource_planning_user'))]"/>
    </record>
</odoo>