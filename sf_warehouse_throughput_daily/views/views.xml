<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_warehouse_throughput_daily" model="ir.actions.act_window">
        <field name="name">Daily Warehouse Throughput</field>
        <field name="res_model">sf.warehouse_throughput_daily</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
    <record id="view_sf_warehouse_throughput_daily_form" model="ir.ui.view">
        <field name="name">sf.warehouse_throughput_daily.form</field>
        <field name="model">sf.warehouse_throughput_daily</field>
        <field name="arch" type="xml">
            <form string="Daily Warehouse Throughput">
                <header>
                    <button name="action_submitted" type="object" string="Submitted"
                            class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="date"/>
                            <field name="warehouse_id"/>
                            <field name="orders_shipped"/>
                            <field name="lines_picked"/>
                            <field name="error_rate"/>
                            <field name="operators_count"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_warehouse_throughput_daily_list" model="ir.ui.view">
        <field name="name">sf.warehouse_throughput_daily.list</field>
        <field name="model">sf.warehouse_throughput_daily</field>
        <field name="arch" type="xml">
            <list string="Daily Warehouse Throughput" sample="1">
                <field name="date"/>
                <field name="warehouse_id"/>
                <field name="orders_shipped"/>
                <field name="lines_picked"/>
                <field name="error_rate"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state in ('submitted','approved')"/>
            </list>
        </field>
    </record>
    <record id="view_sf_warehouse_throughput_daily_kanban" model="ir.ui.view">
        <field name="name">sf.warehouse_throughput_daily.kanban</field>
        <field name="model">sf.warehouse_throughput_daily</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_view" group_by="state">
                <field name="name"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <menuitem id="menu_sf_warehouse_throughput_daily_root" name="Daily Warehouse Throughput" sequence="12"
              web_icon="sf_warehouse_throughput_daily,static/description/icon.png"/>
    <menuitem id="menu_sf_warehouse_throughput_daily_main" name="Records"
              parent="menu_sf_warehouse_throughput_daily_root" action="action_sf_warehouse_throughput_daily" sequence="10"/>

    <record id="wave_final_sf_warehouse_throughput_daily" model="ir.actions.server">
        <field name="name">Refresh Business Data</field>
        <field name="model_id" ref="model_sf_warehouse_throughput_daily"/>
        <field name="binding_model_id" ref="model_sf_warehouse_throughput_daily"/>
        <field name="state">code</field>
        <field name="code">records.action_refresh_business()</field>
    </record>
</odoo>
