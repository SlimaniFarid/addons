<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_warehouse_throughput_daily" model="ir.module.category">
        <field name="name">Daily Warehouse Throughput</field>
        <field name="sequence">489</field>
    </record>
    <record id="group_warehouse_throughput_daily_user" model="res.groups">
        <field name="name">Daily Warehouse Throughput User</field>
        <field name="category_id" ref="module_category_warehouse_throughput_daily"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>

    </record>
    <record id="group_warehouse_throughput_daily_manager" model="res.groups">
        <field name="name">Daily Warehouse Throughput Manager</field>
        <field name="category_id" ref="module_category_warehouse_throughput_daily"/>
        <field name="implied_ids" eval="[(4, ref('group_warehouse_throughput_daily_user'))]"/>
    </record>
    <record id="rule_warehouse_throughput_daily_sf_warehouse_throughput_daily" model="ir.rule">
        <field name="name">Daily Warehouse Throughput: multi-company</field>
        <field name="model_id" ref="model_sf_warehouse_throughput_daily"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_warehouse_throughput_daily"/>
    </record>
</odoo>
