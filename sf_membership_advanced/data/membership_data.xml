<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="seq_membership_member" model="ir.sequence">
        <field name="name">Member Code</field>
        <field name="code">membership.member</field>
        <field name="prefix">MEM-</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_membership_subscription" model="ir.sequence">
        <field name="name">Subscription Reference</field>
        <field name="code">membership.subscription</field>
        <field name="prefix">SUB-</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_membership_payment" model="ir.sequence">
        <field name="name">Payment Reference</field>
        <field name="code">membership.payment</field>
        <field name="prefix">PAY-</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="membership_plan_individual" model="membership.plan">
        <field name="name">Individual Annual</field>
        <field name="code">IND-ANNUAL</field>
        <field name="membership_type">individual</field>
        <field name="fee">50.0</field>
        <field name="duration_months">12</field>
        <field name="description"><p>Standard individual membership for one year.</p></field>
        <field name="benefits"><ul><li>Access to all events</li><li>Monthly newsletter</li><li>Voting rights at AGM</li></ul></field>
    </record>
    <record id="membership_plan_family" model="membership.plan">
        <field name="name">Family Annual</field>
        <field name="code">FAM-ANNUAL</field>
        <field name="membership_type">family</field>
        <field name="fee">120.0</field>
        <field name="duration_months">12</field>
        <field name="max_members">4</field>
        <field name="description"><p>Family membership for up to 4 members.</p></field>
        <field name="benefits"><ul><li>All individual benefits</li><li>Family event access</li><li>Discounted workshops</li></ul></field>
    </record>
    <record id="membership_plan_student" model="membership.plan">
        <field name="name">Student Annual</field>
        <field name="code">STU-ANNUAL</field>
        <field name="membership_type">student</field>
        <field name="fee">25.0</field>
        <field name="duration_months">12</field>
        <field name="trial_days">30</field>
        <field name="description"><p>Discounted membership for students.</p></field>
        <field name="benefits"><ul><li>Access to events</li><li>Student forum</li><li>Mentorship program</li></ul></field>
    </record>
</odoo>