<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_sf_membership_advanced" model="ir.module.category">
        <field name="name">Membership Advanced</field>
        <field name="description">Membership Advanced Management</field>
        <field name="sequence">10</field>
    </record>

    <record id="group_sf_membership_advanced_user" model="res.groups">
        <field name="name">Membership Advanced / User</field>
        <field name="category_id" ref="module_category_sf_membership_advanced"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_sf_membership_advanced_manager" model="res.groups">
        <field name="name">Membership Advanced / Manager</field>
        <field name="category_id" ref="module_category_sf_membership_advanced"/>
        <field name="implied_ids" eval="[(4, ref('sf_membership_advanced.group_sf_membership_advanced_user'))]"/>
    </record>

    <record id="rule_sf_membership_advanced_company" model="ir.rule">
        <field name="name">Membership Advanced: user sees own company</field>
        <field name="model_id" ref="model_sf_membership_advanced"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('sf_membership_advanced.group_sf_membership_advanced_user'))]"/>
    </record>
    <record id="rule_sf_membership_advanced_manager_all" model="ir.rule">
        <field name="name">Membership Advanced: manager sees all companies</field>
        <field name="model_id" ref="model_sf_membership_advanced"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('sf_membership_advanced.group_sf_membership_advanced_manager'))]"/>
    </record>
    <record id="group_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="module_category_sf_membership_advanced"/>
    </record>
    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_sf_membership_advanced"/>
    </record>
    <record id="group_system" model="res.groups">
        <field name="name">System</field>
        <field name="category_id" ref="module_category_sf_membership_advanced"/>
    </record>
</odoo>