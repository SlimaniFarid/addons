<odoo>
    <record id="view_membership_payment_form" model="ir.ui.view">
        <field name="name">membership.payment.form</field>
        <field name="model">membership.payment</field>
        <field name="arch" type="xml">
            <form string="Payment">
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="draft,paid,failed,refunded"/>
                    <button name="action_confirm" string="Confirm" type="object" class="btn-primary" invisible="state!='draft'"/>
                </header>
                <sheet>
                    <group>
                        <field name="member_id" options="{'no_create': True}"/>
                        <field name="subscription_id" options="{'no_create': True}"/>
                        <field name="name"/>
                        <field name="date"/>
                        <field name="amount"/>
                        <field name="currency_id"/>
                        <field name="method"/>
                        <field name="state"/>
                        <field name="reference"/>
                    </group>
                    <group string="Notes">
                        <field name="notes"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_membership_payment_list" model="ir.ui.view">
        <field name="name">membership.payment.list</field>
        <field name="model">membership.payment</field>
        <field name="arch" type="xml">
            <list decoration-danger="is_overdue" string="Payments">
                <field name="name"/>
                <field name="member_id"/>
                <field name="subscription_id"/>
                <field name="date"/>
                <field name="amount"/>
                <field name="currency_id"/>
                <field name="method"/>
                <field name="state" widget="badge" decoration-success="state=='paid'" decoration-danger="state in ('failed','refunded')" decoration-muted="state=='draft'"/>
            </list>
        </field>
    </record>

    <record id="view_sf_membership_advanced_boost_kanban" model="ir.ui.view">
        <field name="name">sf_membership_advanced.boost.kanban</field>
        <field name="model">membership.plan</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" t-att-color="state">
                <field name="name"/>
                <field name="state"/>
                <field name="user_id"/>
                <field name="end_date"/>
                <field name="is_overdue" invisible="1"/>

                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_card oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title">
                                    <field name="name"/></strong>
                                <div class="o_kanban_record_subtitle">
                                    <field name="user_id" widget="many2one_avatar_user"/>
                                    <field name="end_date"/></div>
                            </div>
                            <div class="oe_kanban_bottom_right">
                                <field name="state" widget="badge"
                                       t-attf-options="{'classes_map': {'draft': 'info', 'done': 'success', 'cancelled': 'danger'}, 'domain': []}"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_sf_membership_advanced_boost_search" model="ir.ui.view">
        <field name="name">sf_membership_advanced.boost.search</field>
        <field name="model">membership.plan</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
<separator/>
                <filter string="My records" name="my_records" domain="[('user_id', '=', uid)]"/>
                <filter string="To Do" name="todo" domain="[('state', 'not in', ('done', 'cancelled', 'closed'))]"/>
                <group expand="0" string="Group By"><filter string="Status" name="gb_state" context="{'group_by': 'state'}"/></group>
            </search>
        </field>
    </record>
</odoo>
