<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <menuitem id="menu_membership_reports_root" name="Reports" parent="menu_membership_root" sequence="50"/>
    <record id="action_membership_expiring" model="ir.actions.act_window">
        <field name="name">Expiring Subscriptions</field>
        <field name="res_model">membership.subscription</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', '=', 'active'), ('end_date', '&lt;=', (context_today() + relativedelta(months=1)).strftime('%%Y-%%m-%%d'))]</field>
        <field name="context">{'search_default_group_by_plan_id': 1}</field>
    </record>
    <record id="action_membership_pending" model="ir.actions.act_window">
        <field name="name">Pending Payments</field>
        <field name="res_model">membership.payment</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', '=', 'draft')]</field>
    </record>
    <menuitem id="menu_membership_expiring" name="Expiring Soon" parent="menu_membership_reports_root" action="action_membership_expiring" sequence="10"/>
    <menuitem id="menu_membership_pending" name="Pending Payments" parent="menu_membership_reports_root" action="action_membership_pending" sequence="20"/>
</odoo>