<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_membership_member_form" model="ir.ui.view">
        <field name="name">membership.member.form</field>
        <field name="model">membership.member</field>
        <field name="arch" type="xml">
            <form string="Member">
                <header>
                    <field name="status" widget="statusbar" statusbar_visible="pending,active,expired,cancelled,suspended"/>
                    <button name="action_activate" string="Activate" type="object" class="btn-primary" invisible="status!='pending'"/>
                    <button name="action_suspend" string="Suspend" type="object" class="btn-warning" invisible="status!='active'"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="%(action_membership_subscription)d" string="Subscriptions" type="action" class="oe_stat_button" icon="fa-credit-card">
                            <field name="subscription_ids" widget="statinfo" string="Subscriptions"/>
                        </button>
                        <button name="%(action_membership_payment)d" string="Payments" type="action" class="oe_stat_button" icon="fa-money">
                            <field name="payment_ids" widget="statinfo" string="Payments"/>
                        </button>
                    </div>
                    <group>
                        <field name="partner_id" options="{'no_create': True, 'no_open': True}"/>
                        <field name="member_code"/>
                        <field name="member_since"/>
                        <field name="status"/>
                    </group>
                    <group string="Financial">
                        <field name="total_paid"/>
                        <field name="currency_id"/>
                    </group>
                    <notebook>
                        <page string="Subscriptions">
                            <field name="subscription_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="plan_id"/>
                                    <field name="state" widget="badge" decoration-success="state=='active'" decoration-info="state=='trial'" decoration-danger="state=='expired'" decoration-muted="state in ('draft','pending','cancelled')"/>
                                    <field name="start_date"/>
                                    <field name="end_date"/>
                                    <field name="amount"/>
                                    <field name="auto_renew"/>
                                </list>
                            </field>
                        </page>
                        <page string="Payments">
                            <field name="payment_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="date"/>
                                    <field name="amount"/>
                                    <field name="method"/>
                                    <field name="state" widget="badge" decoration-success="state=='paid'" decoration-danger="state in ('failed','refunded')" decoration-muted="state=='draft'"/>
                                    <field name="reference"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_membership_member_list" model="ir.ui.view">
        <field name="name">membership.member.list</field>
        <field name="model">membership.member</field>
        <field name="arch" type="xml">
            <list string="Members">
                <field name="member_code"/>
                <field name="name"/>
                <field name="email"/>
                <field name="phone"/>
                <field name="status" widget="badge" decoration-success="status=='active'" decoration-info="state=='pending'" decoration-danger="state in ('expired','cancelled','suspended')"/>
                <field name="member_since"/>
                <field name="total_paid"/>
                <field name="currency_id"/>
            </list>
        </field>
    </record>
</odoo>