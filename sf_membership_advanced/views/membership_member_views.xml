<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_membership_member_form" model="ir.ui.view">
        <field name="name">membership.member.form</field>
        <field name="model">membership.member</field>
        <field name="arch" type="xml">
            <form string="Member">
                <header>
                    <field name="status" widget="statusbar" statusbar_visible="pending,active,expired,cancelled,suspended"/>
                    <button name="action_activate" string="Activate" type="object" class="btn-primary" invisible="status!='pending'"/>
                    <button name="action_suspend" string="Suspend" type="object" class="btn-warning" invisible="status!='active'"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="%(action_membership_subscription)d" string="Subscriptions" type="action" class="oe_stat_button" icon="fa-credit-card">
                            <field name="subscription_ids" widget="statinfo" string="Subscriptions"/>
                        </button>
                        <button name="%(action_membership_payment)d" string="Payments" type="action" class="oe_stat_button" icon="fa-money">
                            <field name="payment_ids" widget="statinfo" string="Payments"/>
                        </button>
                    </div>
                    <group>
                        <field name="partner_id" options="{'no_create': True, 'no_open': True}"/>
                        <field name="member_code"/>
                        <field name="member_since"/>
                        <field name="status"/>
                    </group>
                    <group string="Financial">
                        <field name="total_paid"/>
                        <field name="currency_id"/>
                    </group>
                    <notebook>
                        <page string="Subscriptions">
                            <field name="subscription_ids">
                                <list decoration-danger="is_overdue" editable="bottom">
                                    <field name="name"/>
                                    <field name="plan_id"/>
                                    <field name="state" widget="badge" decoration-success="state=='active'" decoration-info="state=='trial'" decoration-danger="state=='expired'" decoration-muted="state in ('draft','pending','cancelled')"/>
                                    <field name="start_date"/>
                                    <field name="end_date"/>
                                    <field name="amount"/>
                                    <field name="auto_renew"/>
                                </list>
                            </field>
                        </page>
                        <page string="Payments">
                            <field name="payment_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="date"/>
                                    <field name="amount"/>
                                    <field name="method"/>
                                    <field name="state" widget="badge" decoration-success="state=='paid'" decoration-danger="state in ('failed','refunded')" decoration-muted="state=='draft'"/>
                                    <field name="reference"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_membership_member_list" model="ir.ui.view">
        <field name="name">membership.member.list</field>
        <field name="model">membership.member</field>
        <field name="arch" type="xml">
            <list string="Members">
                <field name="member_code"/>
                <field name="name"/>
                <field name="email"/>
                <field name="phone"/>
                <field name="status" widget="badge" decoration-success="status=='active'" decoration-info="state=='pending'" decoration-danger="state in ('expired','cancelled','suspended')"/>
                <field name="member_since"/>
                <field name="total_paid"/>
                <field name="currency_id"/>
            </list>
        </field>
    </record>

    <record id="view_sf_membership_advanced_boost_kanban" model="ir.ui.view">
        <field name="name">sf_membership_advanced.boost.kanban</field>
        <field name="model">membership.plan</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" t-att-color="state">
                <field name="name"/>
                <field name="state"/>
                <field name="user_id"/>
                <field name="end_date"/>
                <field name="is_overdue" invisible="1"/>

                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_card oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title">
                                    <field name="name"/></strong>
                                <div class="o_kanban_record_subtitle">
                                    <field name="user_id" widget="many2one_avatar_user"/>
                                    <field name="end_date"/></div>
                            </div>
                            <div class="oe_kanban_bottom_right">
                                <field name="state" widget="badge"
                                       t-attf-options="{'classes_map': {'draft': 'info', 'done': 'success', 'cancelled': 'danger'}, 'domain': []}"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_sf_membership_advanced_boost_search" model="ir.ui.view">
        <field name="name">sf_membership_advanced.boost.search</field>
        <field name="model">membership.plan</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
<separator/>
                <filter string="My records" name="my_records" domain="[('user_id', '=', uid)]"/>
                <filter string="To Do" name="todo" domain="[('state', 'not in', ('done', 'cancelled', 'closed'))]"/>
                <group expand="0" string="Group By"><filter string="Status" name="gb_state" context="{'group_by': 'state'}"/></group>
            </search>
        </field>
    </record>

    <record id="wave_final_sf_membership_advanced" model="ir.actions.server">
        <field name="name">Refresh Business Data</field>
        <field name="model_id" ref="model_membership_plan"/>
        <field name="binding_model_id" ref="model_membership_plan"/>
        <field name="state">code</field>
        <field name="code">records.action_refresh_business()</field>
    </record>
</odoo>
