<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_asset_return" model="ir.actions.act_window">
        <field name="name">Employee Asset Return Tracking</field>
        <field name="res_model">sf.asset.return</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
    <record id="view_sf_asset_return_form" model="ir.ui.view">
        <field name="name">sf.asset.return.form</field>
        <field name="model">sf.asset.return</field>
        <field name="arch" type="xml">
            <form string="Employee Asset Return Tracking">
                <header>
                    <button name="action_returned" type="object" string="Returned"
                            class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="pending,returned,overdue"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="employee_id"/>
                            <field name="asset_type"/>
                            <field name="return_due"/>
                            <field name="returned_date"/>
                            <field name="condition"/>
                            <field name="deposit_released"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_asset_return_list" model="ir.ui.view">
        <field name="name">sf.asset.return.list</field>
        <field name="model">sf.asset.return</field>
        <field name="arch" type="xml">
            <list string="Employee Asset Return Tracking" sample="1">
                <field name="employee_id"/>
                <field name="asset_type"/>
                <field name="return_due"/>
                <field name="returned_date"/>
                <field name="condition"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state in ('submitted','approved')"/>
            </list>
        </field>
    </record>
    <record id="view_sf_asset_return_kanban" model="ir.ui.view">
        <field name="name">sf.asset.return.kanban</field>
        <field name="model">sf.asset.return</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_view" group_by="state">
                <field name="name"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <menuitem id="menu_sf_asset_return_root" name="Employee Asset Return Tracking" sequence="18"
              web_icon="sf_employee_asset_return,static/description/icon.png"/>
    <menuitem id="menu_sf_asset_return_main" name="Records"
              parent="menu_sf_asset_return_root" action="action_sf_asset_return" sequence="10"/>

    <record id="wave_final_sf_employee_asset_return" model="ir.actions.server">
        <field name="name">Refresh Business Data</field>
        <field name="model_id" ref="model_sf_asset_return"/>
        <field name="binding_model_id" ref="model_sf_asset_return"/>
        <field name="state">code</field>
        <field name="code">records.action_refresh_business()</field>
    </record>
</odoo>
