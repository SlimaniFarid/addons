<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_employee_asset_return" model="ir.module.category">
        <field name="name">Employee Asset Return Tracking</field>
        <field name="sequence">28</field>
    </record>
    <record id="group_employee_asset_return_user" model="res.groups">
        <field name="name">Employee Asset Return Tracking User</field>
        <field name="category_id" ref="module_category_employee_asset_return"/>

    </record>
    <record id="group_employee_asset_return_manager" model="res.groups">
        <field name="name">Employee Asset Return Tracking Manager</field>
        <field name="category_id" ref="module_category_employee_asset_return"/>
        <field name="implied_ids" eval="[(4, ref('group_employee_asset_return_user'))]"/>
    </record>
    <record id="rule_employee_asset_return_sf_asset_return" model="ir.rule">
        <field name="name">Asset Return: multi-company</field>
        <field name="model_id" ref="model_sf_asset_return"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_employee_asset_return"/>
    </record>
</odoo>
