<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_sf_veterinary" model="ir.module.category">
        <field name="name">Veterinary Clinic</field>
        <field name="sequence">91</field>
    </record>

    <record id="group_sf_veterinary_user" model="res.groups">
        <field name="name">Veterinary User</field>
        <field name="category_id" ref="module_category_sf_veterinary"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_sf_veterinary_manager" model="res.groups">
        <field name="name">Veterinary Manager</field>
        <field name="category_id" ref="module_category_sf_veterinary"/>
        <field name="implied_ids" eval="[(4, ref('group_sf_veterinary_user'))]"/>
    </record>

    <record id="rule_sf_veterinary_patient_user_company" model="ir.rule">
        <field name="name">Patient: user sees own company</field>
        <field name="model_id" ref="model_sf_veterinary_patient"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_sf_veterinary_user'))]"/>
    </record>

    <record id="rule_sf_veterinary_patient_manager_all" model="ir.rule">
        <field name="name">Patient: manager sees all companies</field>
        <field name="model_id" ref="model_sf_veterinary_patient"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_sf_veterinary_manager'))]"/>
    </record>

    <record id="rule_sf_veterinary_appointment_user_company" model="ir.rule">
        <field name="name">Appointment: user sees own company</field>
        <field name="model_id" ref="model_sf_veterinary_appointment"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_sf_veterinary_user'))]"/>
    </record>

    <record id="rule_sf_veterinary_appointment_manager_all" model="ir.rule">
        <field name="name">Appointment: manager sees all companies</field>
        <field name="model_id" ref="model_sf_veterinary_appointment"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_sf_veterinary_manager'))]"/>
    </record>

    <record id="rule_sf_veterinary_vaccination_user_company" model="ir.rule">
        <field name="name">Vaccination: user sees own company</field>
        <field name="model_id" ref="model_sf_veterinary_vaccination"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_sf_veterinary_user'))]"/>
    </record>

    <record id="rule_sf_veterinary_vaccination_manager_all" model="ir.rule">
        <field name="name">Vaccination: manager sees all companies</field>
        <field name="model_id" ref="model_sf_veterinary_vaccination"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_sf_veterinary_manager'))]"/>
    </record>

    <record id="rule_sf_veterinary_hospitalization_user_company" model="ir.rule">
        <field name="name">Hospitalization: user sees own company</field>
        <field name="model_id" ref="model_sf_veterinary_hospitalization"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_sf_veterinary_user'))]"/>
    </record>

    <record id="rule_sf_veterinary_hospitalization_manager_all" model="ir.rule">
        <field name="name">Hospitalization: manager sees all companies</field>
        <field name="model_id" ref="model_sf_veterinary_hospitalization"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_sf_veterinary_manager'))]"/>
    </record>
    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_sf_veterinary"/>
    </record>
</odoo>
