<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_sf_veterinary_patient" model="ir.sequence">
            <field name="name">Veterinary Patient</field>
            <field name="code">sf.veterinary.patient</field>
            <field name="prefix">PAT-</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>

        <record id="seq_sf_veterinary_appointment" model="ir.sequence">
            <field name="name">Veterinary Appointment</field>
            <field name="code">sf.veterinary.appointment</field>
            <field name="prefix">RDV-</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>

        <record id="seq_sf_veterinary_vaccination" model="ir.sequence">
            <field name="name">Veterinary Vaccination</field>
            <field name="code">sf.veterinary.vaccination</field>
            <field name="prefix">VAC-</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>

        <record id="seq_sf_veterinary_hospitalization" model="ir.sequence">
            <field name="name">Veterinary Hospitalization</field>
            <field name="code">sf.veterinary.hospitalization</field>
            <field name="prefix">HOS-</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>

        <record id="cron_sf_veterinary_reminders" model="ir.cron">
            <field name="name">Veterinary: Vaccination Reminders</field>
            <field name="model_id" ref="model_sf_veterinary_vaccination"/>
            <field name="state">code</field>
            <field name="code">model._cron_vaccination_reminders()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="active">True</field>
        </record>
    </data>
</odoo>
