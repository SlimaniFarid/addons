<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_dr_plan_tracker" model="ir.module.category">
        <field name="name">Disaster Recovery Plan Tracker</field>
        <field name="sequence">170</field>
    </record>
    <record id="group_dr_plan_tracker_user" model="res.groups">
        <field name="name">Disaster Recovery Plan Tracker User</field>
        <field name="category_id" ref="module_category_dr_plan_tracker"/>

    </record>
    <record id="group_dr_plan_tracker_manager" model="res.groups">
        <field name="name">Disaster Recovery Plan Tracker Manager</field>
        <field name="category_id" ref="module_category_dr_plan_tracker"/>
        <field name="implied_ids" eval="[(4, ref('group_dr_plan_tracker_user'))]"/>
    </record>
    <record id="rule_dr_plan_tracker_sf_dr_plan_tracker" model="ir.rule">
        <field name="name">Disaster Recovery Plan Tracker: multi-company</field>
        <field name="model_id" ref="model_sf_dr_plan_tracker"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_dr_plan_tracker"/>
    </record>
</odoo>
