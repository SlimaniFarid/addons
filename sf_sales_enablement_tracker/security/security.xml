<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_sales_enablement_tracker" model="ir.module.category">
        <field name="name">Sales Enablement Tracker</field>
        <field name="sequence">278</field>
    </record>
    <record id="group_sales_enablement_tracker_user" model="res.groups">
        <field name="name">Sales Enablement Tracker User</field>
        <field name="category_id" ref="module_category_sales_enablement_tracker"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>

    </record>
    <record id="group_sales_enablement_tracker_manager" model="res.groups">
        <field name="name">Sales Enablement Tracker Manager</field>
        <field name="category_id" ref="module_category_sales_enablement_tracker"/>
        <field name="implied_ids" eval="[(4, ref('group_sales_enablement_tracker_user'))]"/>
    </record>
    <record id="rule_sales_enablement_tracker_sf_sales_enablement_tracker" model="ir.rule">
        <field name="name">Sales Enablement Tracker: multi-company</field>
        <field name="model_id" ref="model_sf_sales_enablement_tracker"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
