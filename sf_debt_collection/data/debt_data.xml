<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="sequence_debt_case" model="ir.sequence">
            <field name="name">Debt Collection Case</field>
            <field name="code">sf.debt.collection.case</field>
            <field name="prefix">DC/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="sequence_dunning_run" model="ir.sequence">
            <field name="name">Dunning Run</field>
            <field name="code">sf.debt.dunning.run</field>
            <field name="prefix">DN/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="dunning_level_1" model="sf.debt.dunning">
            <field name="name">Reminder</field>
            <field name="sequence">10</field>
            <field name="days_after_due">0</field>
            <field name="message">Friendly reminder: your payment is due.</field>
        </record>

        <record id="dunning_level_2" model="sf.debt.dunning">
            <field name="name">First Notice</field>
            <field name="sequence">20</field>
            <field name="days_after_due">15</field>
            <field name="message">First notice: please settle the outstanding balance.</field>
        </record>

        <record id="dunning_level_3" model="sf.debt.dunning">
            <field name="name">Final Notice</field>
            <field name="sequence">30</field>
            <field name="days_after_due">30</field>
            <field name="message">Final notice before escalation to collections.</field>
        </record>
    </data>
</odoo>