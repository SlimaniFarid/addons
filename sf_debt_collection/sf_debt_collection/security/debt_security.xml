<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="module_category_debt" model="ir.module.category">
            <field name="name">Debt Collection</field>
            <field name="sequence">90</field>
        </record>

        <record id="group_debt_user" model="res.groups">
            <field name="name">Debt Collection User</field>
            <field name="category_id" ref="module_category_debt"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_debt_manager" model="res.groups">
            <field name="name">Debt Collection Manager</field>
            <field name="category_id" ref="module_category_debt"/>
            <field name="implied_ids" eval="[(4, ref('group_debt_user'))]"/>
        </record>
    </data>
</odoo>