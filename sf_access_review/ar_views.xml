<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_access_campaign" model="ir.actions.act_window">
        <field name="name">Access Campaigns</field>
        <field name="res_model">sf.access.campaign</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="view_sf_access_campaign_form" model="ir.ui.view">
        <field name="name">sf.access.campaign.form</field>
        <field name="model">sf.access.campaign</field>
        <field name="arch" type="xml">
            <form string="Access Review Campaign">
                <header>
                    <button name="action_open" type="object"
                            string="Generate Reviews and Open"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_close" type="object"
                            string="Close Campaign" invisible="state != 'open'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,open,closed"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="scope" readonly="state != 'draft'"/>
                            <field name="due_date"/>
                        </group>
                        <group>
                            <field name="reviewer_id"/>
                            <field name="user_count" readonly="1"/>
                            <field name="reviewed_count" readonly="1"/>
                            <field name="revoke_count" readonly="1"/>
                        </group>
                    </group>
                    <field name="line_ids" readonly="1"
                           decoration-warning="decision == 'revoke'">
                        <list create="0">
                            <field name="user_id"/>
                            <field name="groups_summary"/>
                            <field name="decision" widget="badge"
                                   decoration-success="decision == 'keep'"
                                   decoration-danger="decision == 'revoke'"/>
                            <field name="reviewer_id" readonly="1"/>
                            <field name="comments" optional="show"/>
                        </list>
                    </field>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_access_campaign_list" model="ir.ui.view">
        <field name="name">sf.access.campaign.list</field>
        <field name="model">sf.access.campaign</field>
        <field name="arch" type="xml">
            <list string="Access Campaigns" sample="1">
                <field name="name"/>
                <field name="scope"/>
                <field name="due_date"/>
                <field name="user_count"/>
                <field name="revoke_count"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'closed'"/>
            </list>
        </field>
    </record>
    <menuitem id="menu_sf_ar_root" name="Access Review" sequence="16"
              parent="base.menu_administration"/>
    <menuitem id="menu_sf_ar_campaigns" name="Access Campaigns"
              parent="menu_sf_ar_root" action="action_sf_access_campaign"
              sequence="10"/>
</odoo>
