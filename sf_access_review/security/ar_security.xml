<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_sf_ar" model="ir.module.category">
        <field name="name">Access Review</field>
        <field name="sequence">66</field>
    </record>
    <record id="group_sf_ar_user" model="res.groups">
        <field name="name">Access Reviewer</field>
        <field name="category_id" ref="module_category_sf_ar"/>
    </record>
    <record id="group_sf_ar_manager" model="res.groups">
        <field name="name">Access Review Manager</field>
        <field name="category_id" ref="module_category_sf_ar"/>
        <field name="implied_ids" eval="[(4, ref('group_sf_ar_user'))]"/>
    </record>
    <record id="rule_sf_ar_company" model="ir.rule">
        <field name="name">Access Campaign: multi-company</field>
        <field name="model_id" ref="model_sf_access_campaign"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
