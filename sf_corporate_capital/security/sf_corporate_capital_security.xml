<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="module_category_sf_corporate_capital" model="ir.module.category">
            <field name="name">Corporate Capital</field>
            <field name="description">Shareholder register and capital management.</field>
            <field name="sequence">10</field>
        </record>

        <record id="group_sf_capital_user" model="res.groups">
            <field name="name">Corporate Capital / User</field>
            <field name="category_id" ref="module_category_sf_corporate_capital"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_sf_capital_manager" model="res.groups">
            <field name="name">Corporate Capital / Manager</field>
            <field name="category_id" ref="module_category_sf_corporate_capital"/>
            <field name="implied_ids" eval="[(4, ref('sf_corporate_capital.group_sf_capital_user'))]"/>
        </record>

        <record id="rule_sf_shareholder_company" model="ir.rule">
            <field name="name">Shareholder: user sees own company</field>
            <field name="model_id" ref="model_sf_shareholder"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('sf_corporate_capital.group_sf_capital_user'))]"/>
        </record>
        <record id="rule_sf_shareholder_manager_all" model="ir.rule">
            <field name="name">Shareholder: manager sees all companies</field>
            <field name="model_id" ref="model_sf_shareholder"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('sf_corporate_capital.group_sf_capital_manager'))]"/>
        </record>

        <record id="rule_sf_share_class_company" model="ir.rule">
            <field name="name">Share Class: user sees own company</field>
            <field name="model_id" ref="model_sf_share_class"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('sf_corporate_capital.group_sf_capital_user'))]"/>
        </record>
        <record id="rule_sf_share_class_manager_all" model="ir.rule">
            <field name="name">Share Class: manager sees all companies</field>
            <field name="model_id" ref="model_sf_share_class"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('sf_corporate_capital.group_sf_capital_manager'))]"/>
        </record>

        <record id="rule_sf_capital_movement_company" model="ir.rule">
            <field name="name">Capital Movement: user sees own company</field>
            <field name="model_id" ref="model_sf_capital_movement"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('sf_corporate_capital.group_sf_capital_user'))]"/>
        </record>
        <record id="rule_sf_capital_movement_manager_all" model="ir.rule">
            <field name="name">Capital Movement: manager sees all companies</field>
            <field name="model_id" ref="model_sf_capital_movement"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('sf_corporate_capital.group_sf_capital_manager'))]"/>
        </record>
    </data>
</odoo>