<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sf_corporate_capital_res_config_settings_view_form" model="ir.ui.view">
        <field name="name">sf.corporate.capital.res.config.settings.view.form</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('settings')]" position="inside">
                <div class="app_settings_block" data-string="Corporate Capital"
                     data-key="sf_corporate_capital" string="Corporate Capital">
                    <h2>Corporate Capital</h2>
                    <div class="row mt16 o_settings_container">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane">
                                <field name="sf_capital_default_nominal_value"
                                       class="oe_inline"
                                       widget="monetary"
                                       options="{'currency_field': 'company_currency_id'}"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="sf_capital_default_nominal_value"/>
                                <span class="fa fa-lg fa-question-circle o_setting_help"
                                      title="Default nominal value for new share classes"/>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane">
                                <field name="sf_capital_default_authorized_shares"
                                       class="oe_inline"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="sf_capital_default_authorized_shares"/>
                                <span class="fa fa-lg fa-question-circle o_setting_help"
                                      title="Default authorized shares for new share classes"/>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>