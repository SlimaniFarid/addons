<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sf_capital_movement_view_list" model="ir.ui.view">
        <field name="name">sf.capital.movement.list</field>
        <field name="model">sf.capital.movement</field>
        <field name="arch" type="xml">
            <list string="Capital Movements">
                <field name="name"/>
                <field name="shareholder_id"/>
                <field name="from_shareholder_id"/>
                <field name="to_shareholder_id"/>
                <field name="share_class_id"/>
                <field name="movement_type"/>
                <field name="quantity"/>
                <field name="unit_price"/>
                <field name="amount"/>
                <field name="date"/>
                <field name="state" widget="badge"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="sf_capital_movement_view_form" model="ir.ui.view">
        <field name="name">sf.capital.movement.form</field>
        <field name="model">sf.capital.movement</field>
        <field name="arch" type="xml">
            <form string="Capital Movement">
                <header>
                    <button name="action_post" string="Post" type="object" class="btn-primary" invisible="[('state', '!=', 'draft')]"/>
                    <button name="action_cancel" string="Cancel" type="object" invisible="[('state', 'in', ('posted', 'cancelled'))]"/>
                    <field name="state" widget="statusbar" readonly="1"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="share_class_id"/>
                            <field name="movement_type"/>
                        </group>
                        <group>
                            <field name="quantity"/>
                            <field name="unit_price"/>
                            <field name="amount"/>
                            <field name="date"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group string="Shareholders" attrs="{'invisible': [('movement_type', '=', 'issue')]}">
                        <group>
                            <field name="shareholder_id" attrs="{'invisible': [('movement_type', '=', 'transfer')], 'required': [('movement_type', 'in', ('issue', 'buyback'))]}"/>
                        </group>
                        <group>
                            <field name="from_shareholder_id" attrs="{'invisible': [('movement_type', '!=', 'transfer')], 'required': [('movement_type', '=', 'transfer')]}"/>
                            <field name="to_shareholder_id" attrs="{'invisible': [('movement_type', '!=', 'transfer')], 'required': [('movement_type', '=', 'transfer')]}"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="sf_capital_movement_view_search" model="ir.ui.view">
        <field name="name">sf.capital.movement.search</field>
        <field name="model">sf.capital.movement</field>
        <field name="arch" type="xml">
            <search string="Capital Movements">
                <field name="name"/>
                <field name="shareholder_id"/>
                <field name="from_shareholder_id"/>
                <field name="to_shareholder_id"/>
                <field name="share_class_id"/>
                <filter name="capital_movement_draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="capital_movement_posted" string="Posted" domain="[('state', '=', 'posted')]"/>
                <filter name="capital_movement_issue" string="Issue" domain="[('movement_type', '=', 'issue')]"/>
                <filter name="capital_movement_transfer" string="Transfer" domain="[('movement_type', '=', 'transfer')]"/>
                <filter name="capital_movement_buyback" string="Buyback" domain="[('movement_type', '=', 'buyback')]"/>
                <group>
                    <filter name="group_capital_movement_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_capital_movement_type" string="Type" context="{'group_by': 'movement_type'}"/>
                    <filter name="group_capital_movement_shareholder" string="Shareholder" context="{'group_by': 'shareholder_id'}"/>
                    <filter name="group_capital_movement_from" string="From Shareholder" context="{'group_by': 'from_shareholder_id'}"/>
                    <filter name="group_capital_movement_to" string="To Shareholder" context="{'group_by': 'to_shareholder_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_sf_capital_movement" model="ir.actions.act_window">
        <field name="name">Capital Movements</field>
        <field name="res_model">sf.capital.movement</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="sf_capital_movement_view_search"/>
    </record>

    <record id="view_sf_corporate_capital_boost_kanban" model="ir.ui.view">
        <field name="name">sf_corporate_capital.boost.kanban</field>
        <field name="model">sf.capital.activity.mixin</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" t-att-color="state">
                <field name="name"/>
                <field name="state"/>
                <field name="user_id"/>

                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_card oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title">
                                    <field name="name"/></strong>
                                <div class="o_kanban_record_subtitle">
                                    <field name="user_id" widget="many2one_avatar_user"/>
                                    <field name="create_date"/></div>
                            </div>
                            <div class="oe_kanban_bottom_right">
                                <field name="state" widget="badge"
                                       t-attf-options="{'classes_map': {'draft': 'info', 'done': 'success', 'cancelled': 'danger'}, 'domain': []}"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_sf_corporate_capital_boost_search" model="ir.ui.view">
        <field name="name">sf_corporate_capital.boost.search</field>
        <field name="model">sf.capital.activity.mixin</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
<separator/>
                <filter string="My records" name="my_records" domain="[('user_id', '=', uid)]"/>
                <filter string="To Do" name="todo" domain="[('state', 'not in', ('done', 'cancelled', 'closed'))]"/>
                <group expand="0" string="Group By"><filter string="Status" name="gb_state" context="{'group_by': 'state'}"/></group>
            </search>
        </field>
    </record>
</odoo>
