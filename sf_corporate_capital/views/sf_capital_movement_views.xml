<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sf_capital_movement_view_list" model="ir.ui.view">
        <field name="name">sf.capital.movement.list</field>
        <field name="model">sf.capital.movement</field>
        <field name="arch" type="xml">
            <list string="Capital Movements">
                <field name="name"/>
                <field name="shareholder_id"/>
                <field name="share_class_id"/>
                <field name="direction"/>
                <field name="quantity"/>
                <field name="unit_price"/>
                <field name="amount"/>
                <field name="date"/>
                <field name="state" widget="badge"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="sf_capital_movement_view_form" model="ir.ui.view">
        <field name="name">sf.capital.movement.form</field>
        <field name="model">sf.capital.movement</field>
        <field name="arch" type="xml">
            <form string="Capital Movement">
                <header>
                    <button name="action_post" string="Post" type="object" class="btn-primary" invisible="[('state', '!=', 'draft')]"/>
                    <button name="action_cancel" string="Cancel" type="object" invisible="[('state', 'in', ('posted', 'cancelled'))]"/>
                    <field name="state" widget="statusbar" readonly="1"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="shareholder_id"/>
                            <field name="share_class_id"/>
                            <field name="direction"/>
                        </group>
                        <group>
                            <field name="quantity"/>
                            <field name="unit_price"/>
                            <field name="amount"/>
                            <field name="date"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="sf_capital_movement_view_search" model="ir.ui.view">
        <field name="name">sf.capital.movement.search</field>
        <field name="model">sf.capital.movement</field>
        <field name="arch" type="xml">
            <search string="Capital Movements">
                <field name="name"/>
                <field name="shareholder_id"/>
                <field name="share_class_id"/>
                <filter name="capital_movement_draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="capital_movement_posted" string="Posted" domain="[('state', '=', 'posted')]"/>
                <filter name="capital_movement_buy" string="Buy" domain="[('direction', '=', 'buy')]"/>
                <filter name="capital_movement_sell" string="Sell" domain="[('direction', '=', 'sell')]"/>
                <group>
                    <filter name="group_capital_movement_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_capital_movement_shareholder" string="Shareholder" context="{'group_by': 'shareholder_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_sf_capital_movement" model="ir.actions.act_window">
        <field name="name">Capital Movements</field>
        <field name="res_model">sf.capital.movement</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="sf_capital_movement_view_search"/>
    </record>
</odoo>