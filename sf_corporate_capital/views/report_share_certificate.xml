<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_share_certificate">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-set="company" t-value="o.company_id or res_company"/>
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>Share Certificate</h2>
                        <table class="table table-sm">
                            <tr><th>Movement</th><td><span t-field="o.name"/></td></tr>
                            <tr><th>Shareholder</th><td><span t-field="o.shareholder_id"/></td></tr>
                            <tr><th>Share Class</th><td><span t-field="o.share_class_id"/></td></tr>
                            <tr><th>Direction</th><td><span t-field="o.direction"/></td></tr>
                            <tr><th>Quantity</th><td><span t-field="o.quantity"/></td></tr>
                            <tr><th>Unit Price</th><td><span t-field="o.unit_price"/></td></tr>
                            <tr><th>Amount</th><td><span t-field="o.amount"/></td></tr>
                            <tr><th>Date</th><td><span t-field="o.date"/></td></tr>
                            <tr><th>Status</th><td><span t-field="o.state"/></td></tr>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>