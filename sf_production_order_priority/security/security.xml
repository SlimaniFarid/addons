<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_production_order_priority" model="ir.module.category">
        <field name="name">Production Order Priority Manager</field>
        <field name="sequence">369</field>
    </record>
    <record id="group_production_order_priority_user" model="res.groups">
        <field name="name">Production Order Priority Manager User</field>
        <field name="category_id" ref="module_category_production_order_priority"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>

    </record>
    <record id="group_production_order_priority_manager" model="res.groups">
        <field name="name">Production Order Priority Manager Manager</field>
        <field name="category_id" ref="module_category_production_order_priority"/>
        <field name="implied_ids" eval="[(4, ref('group_production_order_priority_user'))]"/>
    </record>
    <record id="rule_production_order_priority_sf_production_order_priority" model="ir.rule">
        <field name="name">Production Order Priority Manager: multi-company</field>
        <field name="model_id" ref="model_sf_production_order_priority"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
