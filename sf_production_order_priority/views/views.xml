<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_production_order_priority" model="ir.actions.act_window">
        <field name="name">Production Order Priority Manager</field>
        <field name="res_model">sf.production_order_priority</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
    <record id="view_sf_production_order_priority_form" model="ir.ui.view">
        <field name="name">sf.production_order_priority.form</field>
        <field name="model">sf.production_order_priority</field>
        <field name="arch" type="xml">
            <form string="Production Order Priority Manager">
                <header>
                    <button name="action_submitted" type="object" string="Submitted"
                            class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="production_id"/>
                            <field name="priority_score"/>
                            <field name="customer_tier"/>
                            <field name="late_penalty"/>
                            <field name="sequence_note"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_production_order_priority_list" model="ir.ui.view">
        <field name="name">sf.production_order_priority.list</field>
        <field name="model">sf.production_order_priority</field>
        <field name="arch" type="xml">
            <list string="Production Order Priority Manager" sample="1">
                <field name="production_id"/>
                <field name="priority_score"/>
                <field name="customer_tier"/>
                <field name="late_penalty"/>
                <field name="sequence_note"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state in ('submitted','approved')"/>
            </list>
        </field>
    </record>
    <record id="view_sf_production_order_priority_kanban" model="ir.ui.view">
        <field name="name">sf.production_order_priority.kanban</field>
        <field name="model">sf.production_order_priority</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_view" group_by="state">
                <field name="name"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <menuitem id="menu_sf_production_order_priority_root" name="Production Order Priority Manager" sequence="2"
              web_icon="sf_production_order_priority,static/description/icon.png"/>
    <menuitem id="menu_sf_production_order_priority_main" name="Records"
              parent="menu_sf_production_order_priority_root" action="action_sf_production_order_priority" sequence="10"/>
</odoo>
