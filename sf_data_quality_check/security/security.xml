<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_data_quality_check" model="ir.module.category">
        <field name="name">Data Quality Check Runner</field>
        <field name="sequence">386</field>
    </record>
    <record id="group_data_quality_check_user" model="res.groups">
        <field name="name">Data Quality Check Runner User</field>
        <field name="category_id" ref="module_category_data_quality_check"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>

    </record>
    <record id="group_data_quality_check_manager" model="res.groups">
        <field name="name">Data Quality Check Runner Manager</field>
        <field name="category_id" ref="module_category_data_quality_check"/>
        <field name="implied_ids" eval="[(4, ref('group_data_quality_check_user'))]"/>
    </record>
    <record id="rule_data_quality_check_sf_data_quality_check" model="ir.rule">
        <field name="name">Data Quality Check Runner: multi-company</field>
        <field name="model_id" ref="model_sf_data_quality_check"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
