<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_data_quality_check" model="ir.actions.act_window">
        <field name="name">Data Quality Check Runner</field>
        <field name="res_model">sf.data_quality_check</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
    <record id="view_sf_data_quality_check_form" model="ir.ui.view">
        <field name="name">sf.data_quality_check.form</field>
        <field name="model">sf.data_quality_check</field>
        <field name="arch" type="xml">
            <form string="Data Quality Check Runner">
                <header>
                    <button name="action_submitted" type="object" string="Submitted"
                            class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="check_name"/>
                            <field name="model_checked"/>
                            <field name="completeness_percent"/>
                            <field name="accuracy_percent"/>
                            <field name="issues_found"/>
                            <field name="remediation"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_data_quality_check_list" model="ir.ui.view">
        <field name="name">sf.data_quality_check.list</field>
        <field name="model">sf.data_quality_check</field>
        <field name="arch" type="xml">
            <list string="Data Quality Check Runner" sample="1">
                <field name="check_name"/>
                <field name="model_checked"/>
                <field name="completeness_percent"/>
                <field name="accuracy_percent"/>
                <field name="issues_found"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state in ('submitted','approved')"/>
            </list>
        </field>
    </record>
    <record id="view_sf_data_quality_check_kanban" model="ir.ui.view">
        <field name="name">sf.data_quality_check.kanban</field>
        <field name="model">sf.data_quality_check</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_view" group_by="state">
                <field name="name"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <menuitem id="menu_sf_data_quality_check_root" name="Data Quality Check Runner" sequence="15"
              web_icon="sf_data_quality_check,static/description/icon.png"/>
    <menuitem id="menu_sf_data_quality_check_main" name="Records"
              parent="menu_sf_data_quality_check_root" action="action_sf_data_quality_check" sequence="10"/>
</odoo>
