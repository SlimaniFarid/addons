<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_access_request_workflow" model="ir.module.category">
        <field name="name">Access Request Workflow</field>
        <field name="sequence">167</field>
    </record>
    <record id="group_access_request_workflow_user" model="res.groups">
        <field name="name">Access Request Workflow User</field>
        <field name="category_id" ref="module_category_access_request_workflow"/>

    </record>
    <record id="group_access_request_workflow_manager" model="res.groups">
        <field name="name">Access Request Workflow Manager</field>
        <field name="category_id" ref="module_category_access_request_workflow"/>
        <field name="implied_ids" eval="[(4, ref('group_access_request_workflow_user'))]"/>
    </record>
    <record id="rule_access_request_workflow_sf_access_request_workflow" model="ir.rule">
        <field name="name">Access Request Workflow: multi-company</field>
        <field name="model_id" ref="model_sf_access_request_workflow"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_access_request_workflow"/>
    </record>
</odoo>
