<odoo>
    <record id="action_tiktokshop_store" model="ir.actions.act_window">
        <field name="name">TikTok Shops</field>
        <field name="res_model">tiktokshop.store</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_tiktokshop_product" model="ir.actions.act_window">
        <field name="name">Products</field>
        <field name="res_model">tiktokshop.product</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_tiktokshop_order" model="ir.actions.act_window">
        <field name="name">Orders</field>
        <field name="res_model">tiktokshop.order</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_tiktokshop_sync_log" model="ir.actions.act_window">
        <field name="name">Sync Logs</field>
        <field name="res_model">tiktokshop.sync.log</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_tiktokshop_root" name="TikTok Shop" web_icon="sf_tiktokshop_connector,static/description/icon.png"/>
    <menuitem id="menu_tiktokshop_stores" name="Stores" parent="menu_tiktokshop_root" action="action_tiktokshop_store" sequence="10"/>
    <menuitem id="menu_tiktokshop_products" name="Products" parent="menu_tiktokshop_root" action="action_tiktokshop_product" sequence="20"/>
    <menuitem id="menu_tiktokshop_orders" name="Orders" parent="menu_tiktokshop_root" action="action_tiktokshop_order" sequence="30"/>
    <menuitem id="menu_tiktokshop_logs" name="Sync Logs" parent="menu_tiktokshop_root" action="action_tiktokshop_sync_log" sequence="40"/>

    <record id="view_tiktokshop_store_form" model="ir.ui.view">
        <field name="name">tiktokshop.store.form</field>
        <field name="model">tiktokshop.store</field>
        <field name="arch" type="xml">
            <form string="TikTok Shop">
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="draft,connected,error"/>
                    <button name="action_test_connection" string="Test Connection" type="object" class="btn-primary"/>
                    <button name="action_sync_products" string="Sync Products" type="object" class="btn-secondary" invisible="state!='connected'"/>
                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="shop_id"/>
                        <field name="shop_cipher"/>
                        <field name="region"/>
                        <field name="active"/>
                        <field name="state"/>
                    </group>
                    <group string="API Credentials">
                        <field name="app_key" groups="base.group_system"/>
                        <field name="app_secret" password="True" groups="base.group_system"/>
                        <field name="access_token" password="True" groups="base.group_system"/>
                        <field name="refresh_token" password="True" groups="base.group_system"/>
                        <field name="token_expires_at" groups="base.group_system"/>
                    </group>
                    <group string="Sync Options">
                        <field name="sync_products"/>
                        <field name="sync_inventory"/>
                        <field name="sync_orders"/>
                        <field name="sync_returns"/>
                    </group>
                    <notebook>
                        <page string="Products">
                            <field name="product_ids">
                                <list>
                                    <field name="tiktok_product_id"/>
                                    <field name="name"/>
                                    <field name="status"/>
                                    <field name="odoo_product_id"/>
                                </list>
                            </field>
                        </page>
                        <page string="Orders">
                            <field name="order_ids">
                                <list>
                                    <field name="tiktok_order_id"/>
                                    <field name="order_status"/>
                                    <field name="total_amount"/>
                                    <field name="currency"/>
                                    <field name="create_time"/>
                                </list>
                            </field>
                        </page>
                        <page string="Sync Logs">
                            <field name="sync_log_ids">
                                <list>
                                    <field name="operation"/>
                                    <field name="direction"/>
                                    <field name="status" widget="badge" decoration-success="status=='success'" decoration-danger="status=='error'"/>
                                    <field name="records_processed"/>
                                    <field name="create_date"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_tiktokshop_store_list" model="ir.ui.view">
        <field name="name">tiktokshop.store.list</field>
        <field name="model">tiktokshop.store</field>
        <field name="arch" type="xml">
            <list string="TikTok Shops">
                <field name="name"/>
                <field name="shop_id"/>
                <field name="region"/>
                <field name="state" widget="badge" decoration-success="state=='connected'" decoration-danger="state=='error'" decoration-muted="state=='draft'"/>
                <field name="active"/>
            </list>
        </field>
    </record>
</odoo>
