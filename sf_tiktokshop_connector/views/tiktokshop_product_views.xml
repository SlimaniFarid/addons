<odoo>
    <record id="view_tiktokshop_product_form" model="ir.ui.view">
        <field name="name">tiktokshop.product.form</field>
        <field name="model">tiktokshop.product</field>
        <field name="arch" type="xml">
            <form string="TikTok Product">
                <sheet>
                    <group>
                        <field name="store_id" options="{'no_create': True}"/>
                        <field name="tiktok_product_id"/>
                        <field name="name"/>
                        <field name="status"/>
                        <field name="category_id"/>
                        <field name="brand"/>
                        <field name="odoo_product_id" options="{'no_create': True}"/>
                    </group>
                    <group string="Details">
                        <field name="description"/>
                        <field name="images" widget="text"/>
                        <field name="skus" widget="text"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_tiktokshop_product_list" model="ir.ui.view">
        <field name="name">tiktokshop.product.list</field>
        <field name="model">tiktokshop.product</field>
        <field name="arch" type="xml">
            <list string="TikTok Products">
                <field name="store_id"/>
                <field name="tiktok_product_id"/>
                <field name="name"/>
                <field name="status"/>
                <field name="brand"/>
                <field name="odoo_product_id"/>
            </list>
        </field>
    </record>
</odoo>