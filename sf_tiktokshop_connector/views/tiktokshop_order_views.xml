<odoo>
    <record id="view_tiktokshop_order_form" model="ir.ui.view">
        <field name="name">tiktokshop.order.form</field>
        <field name="model">tiktokshop.order</field>
        <field name="arch" type="xml">
            <form string="TikTok Order">
                <sheet>
                    <group>
                        <field name="store_id" options="{'no_create': True}"/>
                        <field name="tiktok_order_id"/>
                        <field name="order_status" widget="badge" decoration-success="order_status=='delivered'" decoration-danger="order_status in ('cancelled','returned')" decoration-warning="order_status in ('pending','awaiting_shipment','shipped')"/>
                        <field name="total_amount"/>
                        <field name="currency"/>
                        <field name="create_time"/>
                        <field name="update_time"/>
                        <field name="odoo_order_id" options="{'no_create': True}"/>
                    </group>
                    <group string="Buyer">
                        <field name="buyer_info" widget="text"/>
                    </group>
                    <group string="Shipping">
                        <field name="shipping_info" widget="text"/>
                    </group>
                    <group string="Items">
                        <field name="line_items" widget="text"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_tiktokshop_order_list" model="ir.ui.view">
        <field name="name">tiktokshop.order.list</field>
        <field name="model">tiktokshop.order</field>
        <field name="arch" type="xml">
            <list string="TikTok Orders">
                <field name="store_id"/>
                <field name="tiktok_order_id"/>
                <field name="order_status" widget="badge" decoration-success="order_status=='delivered'" decoration-danger="order_status in ('cancelled','returned')" decoration-warning="order_status in ('pending','awaiting_shipment','shipped')"/>
                <field name="total_amount"/>
                <field name="currency"/>
                <field name="create_time"/>
                <field name="update_time"/>
            </list>
        </field>
    </record>

    <record id="view_sf_tiktokshop_connector_boost_kanban" model="ir.ui.view">
        <field name="name">sf_tiktokshop_connector.boost.kanban</field>
        <field name="model">tiktokshop.store</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" t-att-color="state">
                <field name="name"/>
                <field name="state"/>
                <field name="user_id"/>

                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_card oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title">
                                    <field name="name"/></strong>
                                <div class="o_kanban_record_subtitle">
                                    <field name="user_id" widget="many2one_avatar_user"/>
                                    <field name="create_date"/></div>
                            </div>
                            <div class="oe_kanban_bottom_right">
                                <field name="state" widget="badge"
                                       t-attf-options="{'classes_map': {'draft': 'info', 'done': 'success', 'cancelled': 'danger'}, 'domain': []}"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_sf_tiktokshop_connector_boost_search" model="ir.ui.view">
        <field name="name">sf_tiktokshop_connector.boost.search</field>
        <field name="model">tiktokshop.store</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
<separator/>
                <filter string="My records" name="my_records" domain="[('user_id', '=', uid)]"/>
                <filter string="To Do" name="todo" domain="[('state', 'not in', ('done', 'cancelled', 'closed'))]"/>
                <group expand="0" string="Group By"><filter string="Status" name="gb_state" context="{'group_by': 'state'}"/></group>
            </search>
        </field>
    </record>
</odoo>
