<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_sf_tiktokshop_connector" model="ir.module.category">
        <field name="name">Tiktokshop Connector</field>
        <field name="description">Tiktokshop Connector Management</field>
        <field name="sequence">10</field>
    </record>

    <record id="group_sf_tiktokshop_connector_user" model="res.groups">
        <field name="name">Tiktokshop Connector / User</field>
        <field name="category_id" ref="module_category_sf_tiktokshop_connector"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_sf_tiktokshop_connector_manager" model="res.groups">
        <field name="name">Tiktokshop Connector / Manager</field>
        <field name="category_id" ref="module_category_sf_tiktokshop_connector"/>
        <field name="implied_ids" eval="[(4, ref('sf_tiktokshop_connector.group_sf_tiktokshop_connector_user'))]"/>
    </record>

    <record id="rule_sf_tiktokshop_connector_company" model="ir.rule">
        <field name="name">Tiktokshop Connector: user sees own company</field>
        <field name="model_id" ref="model_sf_tiktokshop_connector"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('sf_tiktokshop_connector.group_sf_tiktokshop_connector_user'))]"/>
    </record>
    <record id="rule_sf_tiktokshop_connector_manager_all" model="ir.rule">
        <field name="name">Tiktokshop Connector: manager sees all companies</field>
        <field name="model_id" ref="model_sf_tiktokshop_connector"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('sf_tiktokshop_connector.group_sf_tiktokshop_connector_manager'))]"/>
    </record>
</odoo>