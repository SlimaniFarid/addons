<odoo>
    <record id="view_tiktokshop_sync_log_form" model="ir.ui.view">
        <field name="name">tiktokshop.sync.log.form</field>
        <field name="model">tiktokshop.sync.log</field>
        <field name="arch" type="xml">
            <form string="Sync Log" create="false">
                <header>
                    <field name="status" widget="statusbar" statusbar_visible="running,success,error"/>
                </header>
                <sheet>
                    <group>
                        <field name="store_id" readonly="1"/>
                        <field name="operation" readonly="1"/>
                        <field name="direction" readonly="1"/>
                        <field name="status" readonly="1"/>
                        <field name="records_processed" readonly="1"/>
                        <field name="start_time" readonly="1"/>
                        <field name="end_time" readonly="1"/>
                    </group>
                    <group string="Error" invisible="status != 'error'">
                        <field name="error_message" widget="text" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_tiktokshop_sync_log_list" model="ir.ui.view">
        <field name="name">tiktokshop.sync.log.list</field>
        <field name="model">tiktokshop.sync.log</field>
        <field name="arch" type="xml">
            <list string="Sync Logs">
                <field name="create_date"/>
                <field name="store_id"/>
                <field name="operation"/>
                <field name="direction"/>
                <field name="status" widget="badge" decoration-success="status=='success'" decoration-danger="status=='error'" decoration-warning="status=='running'"/>
                <field name="records_processed"/>
            </list>
        </field>
    </record>
</odoo>