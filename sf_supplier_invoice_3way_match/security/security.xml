<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_supplier_invoice_3way_match" model="ir.module.category">
        <field name="name">3-Way Match Monitor</field>
        <field name="sequence">453</field>
    </record>
    <record id="group_supplier_invoice_3way_match_user" model="res.groups">
        <field name="name">3-Way Match Monitor User</field>
        <field name="category_id" ref="module_category_supplier_invoice_3way_match"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>

    </record>
    <record id="group_supplier_invoice_3way_match_manager" model="res.groups">
        <field name="name">3-Way Match Monitor Manager</field>
        <field name="category_id" ref="module_category_supplier_invoice_3way_match"/>
        <field name="implied_ids" eval="[(4, ref('group_supplier_invoice_3way_match_user'))]"/>
    </record>
    <record id="rule_supplier_invoice_3way_match_sf_supplier_invoice_3way_match" model="ir.rule">
        <field name="name">3-Way Match Monitor: multi-company</field>
        <field name="model_id" ref="model_sf_supplier_invoice_3way_match"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
