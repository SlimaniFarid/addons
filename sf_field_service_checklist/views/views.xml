<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_field_service_checklist" model="ir.actions.act_window">
        <field name="name">Field Service Checklist</field>
        <field name="res_model">sf.field_service_checklist</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
    <record id="view_sf_field_service_checklist_form" model="ir.ui.view">
        <field name="name">sf.field_service_checklist.form</field>
        <field name="model">sf.field_service_checklist</field>
        <field name="arch" type="xml">
            <form string="Field Service Checklist">
                <header>
                    <button name="action_submitted" type="object" string="Submitted"
                            class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="service_order_ref"/>
                            <field name="checklist_type"/>
                        <field name="items"/>
                            <field name="customer_signature"/>
                            <field name="technician_id"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_field_service_checklist_list" model="ir.ui.view">
        <field name="name">sf.field_service_checklist.list</field>
        <field name="model">sf.field_service_checklist</field>
        <field name="arch" type="xml">
            <list string="Field Service Checklist" sample="1">
                <field name="service_order_ref"/>
                <field name="checklist_type"/>
                <field name="items"/>
                <field name="customer_signature"/>
                <field name="technician_id"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state in ('submitted','approved')"/>
            </list>
        </field>
    </record>
    <record id="view_sf_field_service_checklist_kanban" model="ir.ui.view">
        <field name="name">sf.field_service_checklist.kanban</field>
        <field name="model">sf.field_service_checklist</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_view" group_by="state">
                <field name="name"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <menuitem id="menu_sf_field_service_checklist_root" name="Field Service Checklist" sequence="8"
              web_icon="sf_field_service_checklist,static/description/icon.png"/>
    <menuitem id="menu_sf_field_service_checklist_main" name="Records"
              parent="menu_sf_field_service_checklist_root" action="action_sf_field_service_checklist" sequence="10"/>
</odoo>
