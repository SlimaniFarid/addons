<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_quality_pareto_update" model="ir.module.category">
        <field name="name">Non-Conformance Pareto Update</field>
        <field name="sequence">164</field>
    </record>
    <record id="group_quality_pareto_update_user" model="res.groups">
        <field name="name">Non-Conformance Pareto Update User</field>
        <field name="category_id" ref="module_category_quality_pareto_update"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>

    </record>
    <record id="group_quality_pareto_update_manager" model="res.groups">
        <field name="name">Non-Conformance Pareto Update Manager</field>
        <field name="category_id" ref="module_category_quality_pareto_update"/>
        <field name="implied_ids" eval="[(4, ref('group_quality_pareto_update_user'))]"/>
    </record>
    <record id="rule_quality_pareto_update_sf_quality_pareto_update" model="ir.rule">
        <field name="name">Non-Conformance Pareto Update: multi-company</field>
        <field name="model_id" ref="model_sf_quality_pareto_update"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_quality_pareto_update"/>
    </record>
</odoo>
