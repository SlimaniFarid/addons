<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sf_utility_meter_view_list" model="ir.ui.view">
        <field name="name">sf.utility.meter.list</field>
        <field name="model">sf.utility.meter</field>
        <field name="arch" type="xml">
            <list string="Meters">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="utility_type"/>
                <field name="serial"/>
                <field name="last_index"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="sf_utility_meter_view_form" model="ir.ui.view">
        <field name="name">sf.utility.meter.form</field>
        <field name="model">sf.utility.meter</field>
        <field name="arch" type="xml">
            <form string="Meter">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="address_id"/>
                            <field name="utility_type"/>
                            <field name="serial"/>
                        </group>
                        <group>
                            <field name="unit_of_measure"/>
                            <field name="opening_index"/>
                            <field name="last_index"/>
                            <field name="active"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Readings">
                            <field name="reading_ids">
                                <list string="Readings">
                                    <field name="name"/>
                                    <field name="reading_date"/>
                                    <field name="index"/>
                                    <field name="consumption"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                        <page string="Invoices">
                            <field name="invoice_ids">
                                <list string="Invoices">
                                    <field name="name"/>
                                    <field name="consumption"/>
                                    <field name="amount_total"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="sf_utility_meter_view_search" model="ir.ui.view">
        <field name="name">sf.utility.meter.search</field>
        <field name="model">sf.utility.meter</field>
        <field name="arch" type="xml">
            <search string="Meters">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="serial"/>
                <group>
                    <filter name="group_meter_type" string="Utility Type" context="{'group_by': 'utility_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_sf_utility_meter" model="ir.actions.act_window">
        <field name="name">Meters</field>
        <field name="res_model">sf.utility.meter</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="sf_utility_meter_view_search"/>
    </record>
</odoo>