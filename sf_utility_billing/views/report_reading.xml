<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_reading">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-set="company" t-value="o.company_id or res_company"/>
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>Consumption Reading</h2>
                        <table class="table table-sm">
                            <tr><th>Reading</th><td><span t-field="o.name"/></td></tr>
                            <tr><th>Meter</th><td><span t-field="o.meter_id"/></td></tr>
                            <tr><th>Campaign</th><td><span t-field="o.campaign_id"/></td></tr>
                            <tr><th>Reading Date</th><td><span t-field="o.reading_date"/></td></tr>
                            <tr><th>Index</th><td><span t-field="o.index"/></td></tr>
                            <tr><th>Consumption</th><td><span t-field="o.consumption"/></td></tr>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>