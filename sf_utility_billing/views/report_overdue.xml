<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_overdue">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-set="company" t-value="o.company_id or res_company"/>
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>Overdue Invoices</h2>
                        <table class="table table-sm">
                            <tr><th>Invoice</th><th>Customer</th><th>Meter</th><th>Amount</th><th>Status</th></tr>
                            <tr t-foreach="o.filtered(lambda x: x.state == 'overdue')" t-as="inv">
                                <td><span t-field="inv.name"/></td>
                                <td><span t-field="inv.meter_id.partner_id"/></td>
                                <td><span t-field="inv.meter_id"/></td>
                                <td><span t-field="inv.amount_total"/></td>
                                <td><span t-field="inv.state"/></td>
                            </tr>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>