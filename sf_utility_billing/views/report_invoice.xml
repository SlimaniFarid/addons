<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_invoice">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-set="company" t-value="o.company_id or res_company"/>
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>Consumption Invoice</h2>
                        <table class="table table-sm">
                            <tr><th>Invoice</th><td><span t-field="o.name"/></td></tr>
                            <tr><th>Customer</th><td><span t-field="o.meter_id.partner_id"/></td></tr>
                            <tr><th>Meter</th><td><span t-field="o.meter_id"/></td></tr>
                            <tr><th>Campaign</th><td><span t-field="o.campaign_id"/></td></tr>
                            <tr><th>Consumption</th><td><span t-field="o.consumption"/></td></tr>
                            <tr><th>Amount</th><td><span t-field="o.amount_total"/></td></tr>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>