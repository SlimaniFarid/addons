<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sf_utility_invoice_view_list" model="ir.ui.view">
        <field name="name">sf.utility.invoice.list</field>
        <field name="model">sf.utility.invoice</field>
        <field name="arch" type="xml">
            <list string="Invoices">
                <field name="name"/>
                <field name="meter_id"/>
                <field name="consumption"/>
                <field name="amount_total" sum="Total"/>
                <field name="state" widget="badge"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="sf_utility_invoice_view_form" model="ir.ui.view">
        <field name="name">sf.utility.invoice.form</field>
        <field name="model">sf.utility.invoice</field>
        <field name="arch" type="xml">
            <form string="Invoice">
                <header>
                    <button name="action_post" string="Post" type="object" class="btn-primary" invisible="[('state', '!=', 'draft')]"/>
                    <button name="action_paid" string="Mark Paid" type="object" class="btn-primary" invisible="[('state', 'not in', ('posted', 'overdue'))]"/>
                    <button name="action_cancel" string="Cancel" type="object" invisible="[('state', 'in', ('paid', 'cancelled'))]"/>
                    <field name="state" widget="statusbar" readonly="1"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="meter_id"/>
                            <field name="campaign_id"/>
                            <field name="reading_id"/>
                        </group>
                        <group>
                            <field name="consumption"/>
                            <field name="amount_total"/>
                            <field name="invoice_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="sf_utility_invoice_view_search" model="ir.ui.view">
        <field name="name">sf.utility.invoice.search</field>
        <field name="model">sf.utility.invoice</field>
        <field name="arch" type="xml">
            <search string="Invoices">
                <field name="name"/>
                <field name="meter_id"/>
                <filter name="invoice_draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="invoice_posted" string="Posted" domain="[('state', '=', 'posted')]"/>
                <filter name="invoice_overdue" string="Overdue" domain="[('state', '=', 'overdue')]"/>
                <group>
                    <filter name="group_invoice_state" string="Status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_sf_utility_invoice" model="ir.actions.act_window">
        <field name="name">Invoices</field>
        <field name="res_model">sf.utility.invoice</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="sf_utility_invoice_view_search"/>
    </record>

    <record id="view_sf_utility_billing_boost_kanban" model="ir.ui.view">
        <field name="name">sf_utility_billing.boost.kanban</field>
        <field name="model">sf.utility.activity.mixin</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" t-att-color="state">
                <field name="name"/>
                <field name="state"/>
                <field name="user_id"/>

                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_card oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title">
                                    <field name="name"/></strong>
                                <div class="o_kanban_record_subtitle">
                                    <field name="user_id" widget="many2one_avatar_user"/>
                                    <field name="create_date"/></div>
                            </div>
                            <div class="oe_kanban_bottom_right">
                                <field name="state" widget="badge"
                                       t-attf-options="{'classes_map': {'draft': 'info', 'done': 'success', 'cancelled': 'danger'}, 'domain': []}"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_sf_utility_billing_boost_search" model="ir.ui.view">
        <field name="name">sf_utility_billing.boost.search</field>
        <field name="model">sf.utility.activity.mixin</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
<separator/>
                <filter string="My records" name="my_records" domain="[('user_id', '=', uid)]"/>
                <filter string="To Do" name="todo" domain="[('state', 'not in', ('done', 'cancelled', 'closed'))]"/>
                <group expand="0" string="Group By"><filter string="Status" name="gb_state" context="{'group_by': 'state'}"/></group>
            </search>
        </field>
    </record>
</odoo>
