<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sf_utility_reading_view_list" model="ir.ui.view">
        <field name="name">sf.utility.reading.list</field>
        <field name="model">sf.utility.meter.reading</field>
        <field name="arch" type="xml">
            <list string="Readings">
                <field name="name"/>
                <field name="meter_id"/>
                <field name="campaign_id"/>
                <field name="reading_date"/>
                <field name="index"/>
                <field name="consumption"/>
                <field name="state" widget="badge"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="sf_utility_reading_view_form" model="ir.ui.view">
        <field name="name">sf.utility.reading.form</field>
        <field name="model">sf.utility.meter.reading</field>
        <field name="arch" type="xml">
            <form string="Reading">
                <header>
                    <button name="action_done" string="Mark Done" type="object" class="btn-primary" invisible="[('state', '!=', 'draft')]"/>
                    <button name="action_validate" string="Validate" type="object" class="btn-primary" invisible="[('state', 'not in', ('draft', 'done'))]"/>
                    <button name="action_reject" string="Reject" type="object" invisible="[('state', 'not in', ('done', 'validated'))]"/>
                    <button name="action_reset" string="Reset" type="object" invisible="[('state', '!=', 'rejected')]"/>
                    <field name="state" widget="statusbar" readonly="1"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="meter_id"/>
                            <field name="campaign_id"/>
                            <field name="reading_date"/>
                        </group>
                        <group>
                            <field name="index"/>
                            <field name="consumption"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="sf_utility_reading_view_search" model="ir.ui.view">
        <field name="name">sf.utility.reading.search</field>
        <field name="model">sf.utility.meter.reading</field>
        <field name="arch" type="xml">
            <search string="Readings">
                <field name="name"/>
                <field name="meter_id"/>
                <field name="campaign_id"/>
                <filter name="reading_validated" string="Validated" domain="[('state', '=', 'validated')]"/>
                <filter name="reading_rejected" string="Rejected" domain="[('state', '=', 'rejected')]"/>
                <group>
                    <filter name="group_reading_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_reading_date" string="Date" context="{'group_by': 'reading_date'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_sf_utility_reading" model="ir.actions.act_window">
        <field name="name">Readings</field>
        <field name="res_model">sf.utility.meter.reading</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="sf_utility_reading_view_search"/>
    </record>
</odoo>