<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_campaign">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-set="company" t-value="o.company_id or res_company"/>
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>Campaign Report</h2>
                        <table class="table table-sm">
                            <tr><th>Campaign</th><td><span t-field="o.name"/></td></tr>
                            <tr><th>Period</th><td><span t-field="o.period_start"/> - <span t-field="o.period_end"/></td></tr>
                            <tr><th>Status</th><td><span t-field="o.state"/></td></tr>
                        </table>
                        <table class="table table-sm">
                            <tr><th>Reading</th><th>Meter</th><th>Index</th><th>Consumption</th><th>Status</th></tr>
                            <tr t-foreach="o.reading_ids" t-as="r">
                                <td><span t-field="r.name"/></td>
                                <td><span t-field="r.meter_id"/></td>
                                <td><span t-field="r.index"/></td>
                                <td><span t-field="r.consumption"/></td>
                                <td><span t-field="r.state"/></td>
                            </tr>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>