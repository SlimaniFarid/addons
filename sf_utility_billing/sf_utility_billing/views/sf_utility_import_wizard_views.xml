<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sf_utility_import_wizard_view_form" model="ir.ui.view">
        <field name="name">sf.utility.import.wizard.form</field>
        <field name="model">sf.utility.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Import Readings">
                <group>
                    <group>
                        <field name="campaign_id"/>
                        <field name="meter_id"/>
                    </group>
                    <group>
                        <field name="data"
                               placeholder="meter,index,YYYY-MM-DD&#10;MTR-000001,135.0,2026-02-15&#10;MTR-000002,140.0"/>
                    </group>
                </group>
                <footer>
                    <button name="action_import" string="Import" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_sf_utility_import" model="ir.actions.act_window">
        <field name="name">Import Readings</field>
        <field name="res_model">sf.utility.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="view_id" ref="sf_utility_import_wizard_view_form"/>
    </record>
</odoo>