<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="module_category_sf_utility" model="ir.module.category">
            <field name="name">Utility</field>
            <field name="description">Utility &amp; Sub-Meter Billing.</field>
            <field name="sequence">10</field>
        </record>

        <record id="group_sf_utility_user" model="res.groups">
            <field name="name">Utility / User</field>
            <field name="category_id" ref="module_category_sf_utility"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_sf_utility_manager" model="res.groups">
            <field name="name">Utility / Manager</field>
            <field name="category_id" ref="module_category_sf_utility"/>
            <field name="implied_ids" eval="[(4, ref('sf_utility_billing.group_sf_utility_user'))]"/>
        </record>

        <record id="rule_sf_utility_meter_company" model="ir.rule">
            <field name="name">Utility Meter: user sees own company</field>
            <field name="model_id" ref="model_sf_utility_meter"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('sf_utility_billing.group_sf_utility_user'))]"/>
        </record>
        <record id="rule_sf_utility_meter_manager_all" model="ir.rule">
            <field name="name">Utility Meter: manager sees all companies</field>
            <field name="model_id" ref="model_sf_utility_meter"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('sf_utility_billing.group_sf_utility_manager'))]"/>
        </record>

        <record id="rule_sf_utility_reading_company" model="ir.rule">
            <field name="name">Utility Reading: user sees own company</field>
            <field name="model_id" ref="model_sf_utility_meter_reading"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('sf_utility_billing.group_sf_utility_user'))]"/>
        </record>
        <record id="rule_sf_utility_reading_manager_all" model="ir.rule">
            <field name="name">Utility Reading: manager sees all companies</field>
            <field name="model_id" ref="model_sf_utility_meter_reading"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('sf_utility_billing.group_sf_utility_manager'))]"/>
        </record>

        <record id="rule_sf_utility_campaign_company" model="ir.rule">
            <field name="name">Utility Campaign: user sees own company</field>
            <field name="model_id" ref="model_sf_utility_campaign"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('sf_utility_billing.group_sf_utility_user'))]"/>
        </record>
        <record id="rule_sf_utility_campaign_manager_all" model="ir.rule">
            <field name="name">Utility Campaign: manager sees all companies</field>
            <field name="model_id" ref="model_sf_utility_campaign"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('sf_utility_billing.group_sf_utility_manager'))]"/>
        </record>

        <record id="rule_sf_utility_tariff_company" model="ir.rule">
            <field name="name">Utility Tariff: user sees own company</field>
            <field name="model_id" ref="model_sf_utility_tariff"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('sf_utility_billing.group_sf_utility_user'))]"/>
        </record>
        <record id="rule_sf_utility_tariff_manager_all" model="ir.rule">
            <field name="name">Utility Tariff: manager sees all companies</field>
            <field name="model_id" ref="model_sf_utility_tariff"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('sf_utility_billing.group_sf_utility_manager'))]"/>
        </record>

        <record id="rule_sf_utility_invoice_company" model="ir.rule">
            <field name="name">Utility Invoice: user sees own company</field>
            <field name="model_id" ref="model_sf_utility_invoice"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('sf_utility_billing.group_sf_utility_user'))]"/>
        </record>
        <record id="rule_sf_utility_invoice_manager_all" model="ir.rule">
            <field name="name">Utility Invoice: manager sees all companies</field>
            <field name="model_id" ref="model_sf_utility_invoice"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('sf_utility_billing.group_sf_utility_manager'))]"/>
        </record>
    </data>
    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_sf_utility"/>
    </record>
</odoo>