<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_bank_fee_analytics" model="ir.module.category">
        <field name="name">Bank Fee Analytics</field>
        <field name="sequence">186</field>
    </record>
    <record id="group_bank_fee_analytics_user" model="res.groups">
        <field name="name">Bank Fee Analytics User</field>
        <field name="category_id" ref="module_category_bank_fee_analytics"/>

    </record>
    <record id="group_bank_fee_analytics_manager" model="res.groups">
        <field name="name">Bank Fee Analytics Manager</field>
        <field name="category_id" ref="module_category_bank_fee_analytics"/>
        <field name="implied_ids" eval="[(4, ref('group_bank_fee_analytics_user'))]"/>
    </record>
    <record id="rule_bank_fee_analytics_sf_bank_fee_analytics" model="ir.rule">
        <field name="name">Bank Fee Analytics: multi-company</field>
        <field name="model_id" ref="model_sf_bank_fee_analytics"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
