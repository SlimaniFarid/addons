<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_competitive_intel_register" model="ir.module.category">
        <field name="name">Competitive Intelligence Register</field>
        <field name="sequence">498</field>
    </record>
    <record id="group_competitive_intel_register_user" model="res.groups">
        <field name="name">Competitive Intelligence Register User</field>
        <field name="category_id" ref="module_category_competitive_intel_register"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>

    </record>
    <record id="group_competitive_intel_register_manager" model="res.groups">
        <field name="name">Competitive Intelligence Register Manager</field>
        <field name="category_id" ref="module_category_competitive_intel_register"/>
        <field name="implied_ids" eval="[(4, ref('group_competitive_intel_register_user'))]"/>
    </record>
    <record id="rule_competitive_intel_register_sf_competitive_intel_register" model="ir.rule">
        <field name="name">Competitive Intelligence Register: multi-company</field>
        <field name="model_id" ref="model_sf_competitive_intel_register"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
