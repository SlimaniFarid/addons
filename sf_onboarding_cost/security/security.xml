<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_onboarding_cost" model="ir.module.category">
        <field name="name">Onboarding Cost Tracker</field>
        <field name="sequence">193</field>
    </record>
    <record id="group_onboarding_cost_user" model="res.groups">
        <field name="name">Onboarding Cost Tracker User</field>
        <field name="category_id" ref="module_category_onboarding_cost"/>

    </record>
    <record id="group_onboarding_cost_manager" model="res.groups">
        <field name="name">Onboarding Cost Tracker Manager</field>
        <field name="category_id" ref="module_category_onboarding_cost"/>
        <field name="implied_ids" eval="[(4, ref('group_onboarding_cost_user'))]"/>
    </record>
    <record id="rule_onboarding_cost_sf_onboarding_cost" model="ir.rule">
        <field name="name">Onboarding Cost Tracker: multi-company</field>
        <field name="model_id" ref="model_sf_onboarding_cost"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
