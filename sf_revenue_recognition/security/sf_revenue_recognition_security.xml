<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_sf_revenue_recognition" model="ir.module.category">
        <field name="name">Revenue Recognition</field>
        <field name="description">Revenue Recognition Management</field>
        <field name="sequence">10</field>
    </record>

    <record id="group_sf_revenue_recognition_user" model="res.groups">
        <field name="name">Revenue Recognition / User</field>
        <field name="category_id" ref="module_category_sf_revenue_recognition"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_sf_revenue_recognition_manager" model="res.groups">
        <field name="name">Revenue Recognition / Manager</field>
        <field name="category_id" ref="module_category_sf_revenue_recognition"/>
        <field name="implied_ids" eval="[(4, ref('sf_revenue_recognition.group_sf_revenue_recognition_user'))]"/>
    </record>

    <record id="rule_sf_revenue_recognition_company" model="ir.rule">
        <field name="name">Revenue Recognition: user sees own company</field>
        <field name="model_id" ref="model_sf_revenue_recognition"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('sf_revenue_recognition.group_sf_revenue_recognition_user'))]"/>
    </record>
    <record id="rule_sf_revenue_recognition_manager_all" model="ir.rule">
        <field name="name">Revenue Recognition: manager sees all companies</field>
        <field name="model_id" ref="model_sf_revenue_recognition"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('sf_revenue_recognition.group_sf_revenue_recognition_manager'))]"/>
    </record>
</odoo>