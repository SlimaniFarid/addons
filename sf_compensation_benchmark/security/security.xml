<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_compensation_benchmark" model="ir.module.category">
        <field name="name">Compensation Benchmark</field>
        <field name="sequence">197</field>
    </record>
    <record id="group_compensation_benchmark_user" model="res.groups">
        <field name="name">Compensation Benchmark User</field>
        <field name="category_id" ref="module_category_compensation_benchmark"/>

    </record>
    <record id="group_compensation_benchmark_manager" model="res.groups">
        <field name="name">Compensation Benchmark Manager</field>
        <field name="category_id" ref="module_category_compensation_benchmark"/>
        <field name="implied_ids" eval="[(4, ref('group_compensation_benchmark_user'))]"/>
    </record>
    <record id="rule_compensation_benchmark_sf_compensation_benchmark" model="ir.rule">
        <field name="name">Compensation Benchmark: multi-company</field>
        <field name="model_id" ref="model_sf_compensation_benchmark"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_compensation_benchmark"/>
    </record>
</odoo>
