<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_compensation_benchmark" model="ir.actions.act_window">
        <field name="name">Compensation Benchmark</field>
        <field name="res_model">sf.compensation_benchmark</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
    <record id="view_sf_compensation_benchmark_form" model="ir.ui.view">
        <field name="name">sf.compensation_benchmark.form</field>
        <field name="model">sf.compensation_benchmark</field>
        <field name="arch" type="xml">
            <form string="Compensation Benchmark">
                <header>
                    <button name="action_submitted" type="object" string="Submitted"
                            class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="role"/>
                            <field name="grade"/>
                            <field name="current_salary"/>
                            <field name="market_p25"/>
                            <field name="market_p50"/>
                            <field name="market_p75"/>
                            <field name="compa_ratio"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_compensation_benchmark_list" model="ir.ui.view">
        <field name="name">sf.compensation_benchmark.list</field>
        <field name="model">sf.compensation_benchmark</field>
        <field name="arch" type="xml">
            <list string="Compensation Benchmark" sample="1">
                <field name="role"/>
                <field name="grade"/>
                <field name="current_salary"/>
                <field name="market_p25"/>
                <field name="market_p50"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state in ('submitted','approved')"/>
            </list>
        </field>
    </record>
    <record id="view_sf_compensation_benchmark_kanban" model="ir.ui.view">
        <field name="name">sf.compensation_benchmark.kanban</field>
        <field name="model">sf.compensation_benchmark</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_view" group_by="state">
                <field name="name"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <menuitem id="menu_sf_compensation_benchmark_root" name="Compensation Benchmark" sequence="4"
              web_icon="sf_compensation_benchmark,static/description/icon.png"/>
    <menuitem id="menu_sf_compensation_benchmark_main" name="Records"
              parent="menu_sf_compensation_benchmark_root" action="action_sf_compensation_benchmark" sequence="10"/>

    <record id="wave_final_sf_compensation_benchmark" model="ir.actions.server">
        <field name="name">Refresh Business Data</field>
        <field name="model_id" ref="model_sf_compensation_benchmark"/>
        <field name="binding_model_id" ref="model_sf_compensation_benchmark"/>
        <field name="state">code</field>
        <field name="code">records.action_refresh_business()</field>
    </record>
</odoo>
