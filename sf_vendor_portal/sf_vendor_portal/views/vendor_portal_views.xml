<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="vendor_portal_settings_view" model="ir.ui.view">
        <field name="name">vendor.portal.settings.form</field>
        <field name="model">sf.vendor.portal.settings</field>
        <field name="arch" type="xml">
            <form string="Vendor Portal Settings">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="company_id"/>
                        </group>
                        <group>
                            <field name="auto_create_portal_user"/>
                            <field name="notify_on_rfq"/>
                        </group>
                    </group>
                    <group string="Welcome Message">
                        <field name="welcome_message" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="vendor_portal_settings_tree" model="ir.ui.view">
        <field name="name">vendor.portal.settings.tree</field>
        <field name="model">sf.vendor.portal.settings</field>
        <field name="arch" type="xml">
            <tree string="Vendor Portal Settings">
                <field name="name"/>
                <field name="company_id"/>
                <field name="auto_create_portal_user"/>
            </tree>
        </field>
    </record>

    <record id="action_vendor_portal_settings" model="ir.actions.act_window">
        <field name="name">Vendor Portal Settings</field>
        <field name="res_model">sf.vendor.portal.settings</field>
        <field name="view_mode">tree,form</field>
    </record>

</odoo>