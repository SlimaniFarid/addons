<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_employee_survey" model="ir.actions.act_window">
        <field name="name">Employee Survey Runner</field>
        <field name="res_model">sf.employee_survey</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
    <record id="view_sf_employee_survey_form" model="ir.ui.view">
        <field name="name">sf.employee_survey.form</field>
        <field name="model">sf.employee_survey</field>
        <field name="arch" type="xml">
            <form string="Employee Survey Runner">
                <header>
                    <button name="action_submitted" type="object" string="Submitted"
                            class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="survey_title"/>
                            <field name="survey_date"/>
                            <field name="invited_count"/>
                            <field name="responded_count"/>
                            <field name="enps_score"/>
                        <field name="action_plan"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_employee_survey_list" model="ir.ui.view">
        <field name="name">sf.employee_survey.list</field>
        <field name="model">sf.employee_survey</field>
        <field name="arch" type="xml">
            <list string="Employee Survey Runner" sample="1">
                <field name="survey_title"/>
                <field name="survey_date"/>
                <field name="invited_count"/>
                <field name="responded_count"/>
                <field name="enps_score"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state in ('submitted','approved')"/>
            </list>
        </field>
    </record>
    <record id="view_sf_employee_survey_kanban" model="ir.ui.view">
        <field name="name">sf.employee_survey.kanban</field>
        <field name="model">sf.employee_survey</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_view" group_by="state">
                <field name="name"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <menuitem id="menu_sf_employee_survey_root" name="Employee Survey Runner" sequence="7"
              web_icon="sf_employee_survey,static/description/icon.png"/>
    <menuitem id="menu_sf_employee_survey_main" name="Records"
              parent="menu_sf_employee_survey_root" action="action_sf_employee_survey" sequence="10"/>
</odoo>
