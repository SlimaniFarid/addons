<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_employee_survey" model="ir.module.category">
        <field name="name">Employee Survey Runner</field>
        <field name="sequence">194</field>
    </record>
    <record id="group_employee_survey_user" model="res.groups">
        <field name="name">Employee Survey Runner User</field>
        <field name="category_id" ref="module_category_employee_survey"/>

    </record>
    <record id="group_employee_survey_manager" model="res.groups">
        <field name="name">Employee Survey Runner Manager</field>
        <field name="category_id" ref="module_category_employee_survey"/>
        <field name="implied_ids" eval="[(4, ref('group_employee_survey_user'))]"/>
    </record>
    <record id="rule_employee_survey_sf_employee_survey" model="ir.rule">
        <field name="name">Employee Survey Runner: multi-company</field>
        <field name="model_id" ref="model_sf_employee_survey"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_employee_survey"/>
    </record>
</odoo>
