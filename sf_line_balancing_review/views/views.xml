<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_line_balance" model="ir.actions.act_window">
        <field name="name">Line Balancing Review</field>
        <field name="res_model">sf.line.balance</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
    <record id="view_sf_line_balance_form" model="ir.ui.view">
        <field name="name">sf.line.balance.form</field>
        <field name="model">sf.line.balance</field>
        <field name="arch" type="xml">
            <form string="Line Balancing Review">
                <header>
                    <button name="action_reviewed" type="object" string="Reviewed"
                            class="btn-primary"/>
                    <button name="action_actions" type="object" string="Actions Defined"
                            class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,reviewed,actions,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="production_id"/>
                            <field name="takt_time_seconds"/>
                            <field name="bottleneck_station"/>
                        <field name="findings"/>
                        <field name="rebalancing_plan"/>
                            <field name="reviewer_id"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_line_balance_list" model="ir.ui.view">
        <field name="name">sf.line.balance.list</field>
        <field name="model">sf.line.balance</field>
        <field name="arch" type="xml">
            <list string="Line Balancing Review" sample="1">
                <field name="production_id"/>
                <field name="takt_time_seconds"/>
                <field name="bottleneck_station"/>
                <field name="findings"/>
                <field name="rebalancing_plan"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state in ('submitted','approved')"/>
            </list>
        </field>
    </record>
    <record id="view_sf_line_balance_kanban" model="ir.ui.view">
        <field name="name">sf.line.balance.kanban</field>
        <field name="model">sf.line.balance</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_view" group_by="state">
                <field name="name"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <menuitem id="menu_sf_line_balance_root" name="Line Balancing Review" sequence="21"
              web_icon="sf_line_balancing_review,static/description/icon.png"/>
    <menuitem id="menu_sf_line_balance_main" name="Records"
              parent="menu_sf_line_balance_root" action="action_sf_line_balance" sequence="10"/>

    <record id="wave_final_sf_line_balancing_review" model="ir.actions.server">
        <field name="name">Refresh Business Data</field>
        <field name="model_id" ref="model_sf_line_balance"/>
        <field name="binding_model_id" ref="model_sf_line_balance"/>
        <field name="state">code</field>
        <field name="code">records.action_refresh_business()</field>
    </record>
</odoo>
