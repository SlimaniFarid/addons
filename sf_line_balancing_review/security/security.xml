<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_line_balancing_review" model="ir.module.category">
        <field name="name">Line Balancing Review</field>
        <field name="sequence">16</field>
    </record>
    <record id="group_line_balancing_review_user" model="res.groups">
        <field name="name">Line Balancing Review User</field>
        <field name="category_id" ref="module_category_line_balancing_review"/>
        <field name="implied_ids" eval="[(4, ref('mrp.group_mrp_user'))]"/>

    </record>
    <record id="group_line_balancing_review_manager" model="res.groups">
        <field name="name">Line Balancing Review Manager</field>
        <field name="category_id" ref="module_category_line_balancing_review"/>
        <field name="implied_ids" eval="[(4, ref('group_line_balancing_review_user'))]"/>
    </record>
    <record id="rule_line_balancing_review_sf_line_balance" model="ir.rule">
        <field name="name">Line Balancing Review: multi-company</field>
        <field name="model_id" ref="model_sf_line_balance"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
