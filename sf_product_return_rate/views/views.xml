<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_product_return_rate" model="ir.actions.act_window">
        <field name="name">Product Return Rate Monitor</field>
        <field name="res_model">sf.product_return_rate</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
    <record id="view_sf_product_return_rate_form" model="ir.ui.view">
        <field name="name">sf.product_return_rate.form</field>
        <field name="model">sf.product_return_rate</field>
        <field name="arch" type="xml">
            <form string="Product Return Rate Monitor">
                <header>
                    <button name="action_submitted" type="object" string="Submitted"
                            class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="product_id"/>
                            <field name="period"/>
                            <field name="units_sold"/>
                            <field name="units_returned"/>
                            <field name="return_rate_percent"/>
                            <field name="threshold_percent"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_product_return_rate_list" model="ir.ui.view">
        <field name="name">sf.product_return_rate.list</field>
        <field name="model">sf.product_return_rate</field>
        <field name="arch" type="xml">
            <list string="Product Return Rate Monitor" sample="1">
                <field name="product_id"/>
                <field name="period"/>
                <field name="units_sold"/>
                <field name="units_returned"/>
                <field name="return_rate_percent"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state in ('submitted','approved')"/>
            </list>
        </field>
    </record>
    <record id="view_sf_product_return_rate_kanban" model="ir.ui.view">
        <field name="name">sf.product_return_rate.kanban</field>
        <field name="model">sf.product_return_rate</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_view" group_by="state">
                <field name="name"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <menuitem id="menu_sf_product_return_rate_root" name="Product Return Rate Monitor" sequence="24"
              web_icon="sf_product_return_rate,static/description/icon.png"/>
    <menuitem id="menu_sf_product_return_rate_main" name="Records"
              parent="menu_sf_product_return_rate_root" action="action_sf_product_return_rate" sequence="10"/>

    <record id="wave_final_sf_product_return_rate" model="ir.actions.server">
        <field name="name">Refresh Business Data</field>
        <field name="model_id" ref="model_sf_product_return_rate"/>
        <field name="binding_model_id" ref="model_sf_product_return_rate"/>
        <field name="state">code</field>
        <field name="code">records.action_refresh_business()</field>
    </record>
</odoo>
