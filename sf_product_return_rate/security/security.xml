<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_product_return_rate" model="ir.module.category">
        <field name="name">Product Return Rate Monitor</field>
        <field name="sequence">177</field>
    </record>
    <record id="group_product_return_rate_user" model="res.groups">
        <field name="name">Product Return Rate Monitor User</field>
        <field name="category_id" ref="module_category_product_return_rate"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>

    </record>
    <record id="group_product_return_rate_manager" model="res.groups">
        <field name="name">Product Return Rate Monitor Manager</field>
        <field name="category_id" ref="module_category_product_return_rate"/>
        <field name="implied_ids" eval="[(4, ref('group_product_return_rate_user'))]"/>
    </record>
    <record id="rule_product_return_rate_sf_product_return_rate" model="ir.rule">
        <field name="name">Product Return Rate Monitor: multi-company</field>
        <field name="model_id" ref="model_sf_product_return_rate"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_product_return_rate"/>
    </record>
</odoo>
