<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_wave_picking" model="ir.module.category">
        <field name="name">Wave Picking</field>
        <field name="sequence">92</field>
    </record>

    <record id="group_wave_picking_user" model="res.groups">
        <field name="name">Wave Picking User</field>
        <field name="category_id" ref="module_category_wave_picking"/>
        <field name="implied_ids" eval="[(4, ref('stock.group_stock_user'))]"/>
    </record>

    <record id="group_wave_picking_manager" model="res.groups">
        <field name="name">Wave Picking Manager</field>
        <field name="category_id" ref="module_category_wave_picking"/>
        <field name="implied_ids" eval="[(4, ref('group_wave_picking_user'))]"/>
    </record>
</odoo>