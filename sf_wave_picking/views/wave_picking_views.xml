<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="wave_picking_view_form" model="ir.ui.view">
        <field name="name">sf.wave.picking.form</field>
        <field name="model">sf.wave.picking</field>
        <field name="arch" type="xml">
            <form string="Wave">
                <header>
                    <button name="action_release" type="object"
                            string="Release" class="btn-primary"
                            invisible="[('state', 'not in', ('draft',))]"/>
                    <button name="action_done" type="object"
                            string="Validate" class="btn-secondary"
                            invisible="[('state', 'not in', ('released',))]"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="warehouse_id"/>
                            <field name="picking_type_id"/>
                            <field name="date_start"/>
                        </group>
                        <group>
                            <field name="progress" widget="progressbar"/>
                            <field name="move_count"/>
                            <field name="done_lines"/>
                        </group>
                    </group>
                    <group>
                        <field name="note"/>
                    </group>
                    <notebook>
                        <page string="Pickings">
                            <field name="picking_ids">
                                <tree string="Pickings" editable="bottom">
                                    <field name="name"/>
                                    <field name="partner_id"/>
                                    <field name="origin"/>
                                    <field name="state"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="wave_picking_view_tree" model="ir.ui.view">
        <field name="name">sf.wave.picking.tree</field>
        <field name="model">sf.wave.picking</field>
        <field name="arch" type="xml">
            <tree string="Waves">
                <field name="name"/>
                <field name="state"/>
                <field name="warehouse_id"/>
                <field name="picking_type_id"/>
                <field name="move_count"/>
                <field name="progress"/>
            </tree>
        </field>
    </record>

    <record id="action_wave_picking" model="ir.actions.act_window">
        <field name="name">Waves</field>
        <field name="res_model">sf.wave.picking</field>
        <field name="view_mode">tree,form</field>
    </record>

</odoo>