<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_sales_capacity" model="ir.actions.act_window">
        <field name="name">Sales Capacity Forecast</field>
        <field name="res_model">sf.sales.capacity</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
    <record id="view_sf_sales_capacity_form" model="ir.ui.view">
        <field name="name">sf.sales.capacity.form</field>
        <field name="model">sf.sales.capacity</field>
        <field name="arch" type="xml">
            <form string="Sales Capacity Forecast">
                <header>
                    <button name="action_reviewed" type="object" string="Reviewed"
                            class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,reviewed,locked"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="period_month"/>
                            <field name="team_lead_id"/>
                            <field name="active_reps"/>
                            <field name="working_days"/>
                            <field name="meetings_target"/>
                            <field name="pipeline_target"/>
                            <field name="notes"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_sales_capacity_list" model="ir.ui.view">
        <field name="name">sf.sales.capacity.list</field>
        <field name="model">sf.sales.capacity</field>
        <field name="arch" type="xml">
            <list string="Sales Capacity Forecast" sample="1">
                <field name="period_month"/>
                <field name="team_lead_id"/>
                <field name="active_reps"/>
                <field name="working_days"/>
                <field name="meetings_target"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state in ('submitted','approved')"/>
            </list>
        </field>
    </record>
    <record id="view_sf_sales_capacity_kanban" model="ir.ui.view">
        <field name="name">sf.sales.capacity.kanban</field>
        <field name="model">sf.sales.capacity</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_view" group_by="state">
                <field name="name"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <menuitem id="menu_sf_sales_capacity_root" name="Sales Capacity Forecast" sequence="6"
              web_icon="sf_capacity_forecast_sales,static/description/icon.png"/>
    <menuitem id="menu_sf_sales_capacity_main" name="Records"
              parent="menu_sf_sales_capacity_root" action="action_sf_sales_capacity" sequence="10"/>
</odoo>
