<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_capacity_forecast_sales" model="ir.module.category">
        <field name="name">Sales Capacity Forecast</field>
        <field name="sequence">44</field>
    </record>
    <record id="group_capacity_forecast_sales_user" model="res.groups">
        <field name="name">Sales Capacity Forecast User</field>
        <field name="category_id" ref="module_category_capacity_forecast_sales"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>

    </record>
    <record id="group_capacity_forecast_sales_manager" model="res.groups">
        <field name="name">Sales Capacity Forecast Manager</field>
        <field name="category_id" ref="module_category_capacity_forecast_sales"/>
        <field name="implied_ids" eval="[(4, ref('group_capacity_forecast_sales_user'))]"/>
    </record>
    <record id="rule_capacity_forecast_sales_sf_sales_capacity" model="ir.rule">
        <field name="name">Sales Capacity Plan: multi-company</field>
        <field name="model_id" ref="model_sf_sales_capacity"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_capacity_forecast_sales"/>
    </record>
</odoo>
