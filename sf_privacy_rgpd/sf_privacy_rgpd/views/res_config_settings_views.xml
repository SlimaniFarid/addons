<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_privacy" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.privacy</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="50"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Privacy &amp; GDPR" string="Privacy &amp; GDPR" name="privacy_rgpd">
                    <block title="Reviews &amp; Deadlines" id="privacy_deadlines">
                        <setting id="privacy_review_days" help="Number of days between periodic reviews of processing activities.">
                            <field name="sf_privacy_review_days"/>
                        </setting>
                        <setting id="privacy_breach_hours" help="Deadline (hours) to notify a data breach (72 by default).">
                            <field name="sf_privacy_breach_hours"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>