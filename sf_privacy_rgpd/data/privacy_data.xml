<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_privacy_treatment" model="ir.sequence">
            <field name="name">Privacy Treatment</field>
            <field name="code">sf.privacy.treatment</field>
            <field name="prefix"></field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>

        <record id="seq_privacy_impact_assessment" model="ir.sequence">
            <field name="name">Privacy Impact Assessment</field>
            <field name="code">sf.privacy.impact.assessment</field>
            <field name="prefix"></field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>

        <record id="seq_privacy_breach" model="ir.sequence">
            <field name="name">Privacy Breach</field>
            <field name="code">sf.privacy.breach</field>
            <field name="prefix"></field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>

        <record id="seq_privacy_request" model="ir.sequence">
            <field name="name">Privacy Request</field>
            <field name="code">sf.privacy.request</field>
            <field name="prefix"></field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>

        <record id="cron_privacy_review" model="ir.cron">
            <field name="name">Privacy: Periodic Review Alerts</field>
            <field name="model_id" ref="model_sf_privacy_treatment"/>
            <field name="state">code</field>
            <field name="code">model._check_privacy_reviews()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="active">True</field>
        </record>
    </data>
</odoo>