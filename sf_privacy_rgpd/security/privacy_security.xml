<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_privacy" model="ir.module.category">
        <field name="name">Privacy &amp; RGPD</field>
        <field name="sequence">90</field>
    </record>

    <record id="group_privacy_user" model="res.groups">
        <field name="name">Privacy User</field>
        <field name="category_id" ref="module_category_privacy"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_privacy_manager" model="res.groups">
        <field name="name">Privacy Manager</field>
        <field name="category_id" ref="module_category_privacy"/>
        <field name="implied_ids" eval="[(4, ref('group_privacy_user'))]"/>
    </record>

    <record id="rule_privacy_treatment_user_company" model="ir.rule">
        <field name="name">Treatment: user sees own company</field>
        <field name="model_id" ref="model_sf_privacy_treatment"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_privacy_user'))]"/>
    </record>

    <record id="rule_privacy_processor_user_company" model="ir.rule">
        <field name="name">Processor: user sees own company</field>
        <field name="model_id" ref="model_sf_privacy_processor"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_privacy_user'))]"/>
    </record>

    <record id="rule_privacy_impact_assessment_user_company" model="ir.rule">
        <field name="name">Impact assessment: user sees own company</field>
        <field name="model_id" ref="model_sf_privacy_impact_assessment"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_privacy_user'))]"/>
    </record>

    <record id="rule_privacy_breach_user_company" model="ir.rule">
        <field name="name">Breach: user sees own company</field>
        <field name="model_id" ref="model_sf_privacy_breach"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_privacy_user'))]"/>
    </record>

    <record id="rule_privacy_request_user_company" model="ir.rule">
        <field name="name">Request: user sees own company</field>
        <field name="model_id" ref="model_sf_privacy_request"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_privacy_user'))]"/>
    </record>

    <record id="rule_privacy_treatment_manager_all" model="ir.rule">
        <field name="name">Treatment: manager sees all companies</field>
        <field name="model_id" ref="model_sf_privacy_treatment"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_privacy_manager'))]"/>
    </record>

    <record id="rule_privacy_processor_manager_all" model="ir.rule">
        <field name="name">Processor: manager sees all companies</field>
        <field name="model_id" ref="model_sf_privacy_processor"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_privacy_manager'))]"/>
    </record>

    <record id="rule_privacy_impact_assessment_manager_all" model="ir.rule">
        <field name="name">Impact assessment: manager sees all companies</field>
        <field name="model_id" ref="model_sf_privacy_impact_assessment"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_privacy_manager'))]"/>
    </record>

    <record id="rule_privacy_breach_manager_all" model="ir.rule">
        <field name="name">Breach: manager sees all companies</field>
        <field name="model_id" ref="model_sf_privacy_breach"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_privacy_manager'))]"/>
    </record>

    <record id="rule_privacy_request_manager_all" model="ir.rule">
        <field name="name">Request: manager sees all companies</field>
        <field name="model_id" ref="model_sf_privacy_request"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_privacy_manager'))]"/>
    </record>
    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_privacy"/>
    </record>
</odoo>