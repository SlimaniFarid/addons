<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_service_item" model="ir.actions.act_window">
        <field name="name">Internal Service Catalog</field>
        <field name="res_model">sf.service.item</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
    <record id="view_sf_service_item_form" model="ir.ui.view">
        <field name="name">sf.service.item.form</field>
        <field name="model">sf.service.item</field>
        <field name="arch" type="xml">
            <form string="Internal Service Catalog">
                <header>
                    <button name="action_published" type="object" string="Published"
                            class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,published,retired"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="service_name"/>
                        <field name="description"/>
                            <field name="target_sla_hours"/>
                            <field name="owner_id"/>
                            <field name="request_types"/>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_service_item_list" model="ir.ui.view">
        <field name="name">sf.service.item.list</field>
        <field name="model">sf.service.item</field>
        <field name="arch" type="xml">
            <list string="Internal Service Catalog" sample="1">
                <field name="service_name"/>
                <field name="description"/>
                <field name="target_sla_hours"/>
                <field name="owner_id"/>
                <field name="request_types"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state in ('submitted','approved')"/>
            </list>
        </field>
    </record>
    <record id="view_sf_service_item_kanban" model="ir.ui.view">
        <field name="name">sf.service.item.kanban</field>
        <field name="model">sf.service.item</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_view" group_by="state">
                <field name="name"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <menuitem id="menu_sf_service_item_root" name="Internal Service Catalog" sequence="8"
              web_icon="sf_service_catalog,static/description/icon.png"/>
    <menuitem id="menu_sf_service_item_main" name="Records"
              parent="menu_sf_service_item_root" action="action_sf_service_item" sequence="10"/>
</odoo>
