<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_service_catalog" model="ir.module.category">
        <field name="name">Internal Service Catalog</field>
        <field name="sequence">52</field>
    </record>
    <record id="group_service_catalog_user" model="res.groups">
        <field name="name">Internal Service Catalog User</field>
        <field name="category_id" ref="module_category_service_catalog"/>

    </record>
    <record id="group_service_catalog_manager" model="res.groups">
        <field name="name">Internal Service Catalog Manager</field>
        <field name="category_id" ref="module_category_service_catalog"/>
        <field name="implied_ids" eval="[(4, ref('group_service_catalog_user'))]"/>
    </record>
    <record id="rule_service_catalog_sf_service_item" model="ir.rule">
        <field name="name">Service Item: multi-company</field>
        <field name="model_id" ref="model_sf_service_item"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_service_catalog"/>
    </record>
</odoo>
