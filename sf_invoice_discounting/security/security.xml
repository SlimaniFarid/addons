<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_invoice_discounting" model="ir.module.category">
        <field name="name">Invoice Discounting &amp; Factoring Register</field>
        <field name="sequence">50</field>
    </record>
    <record id="group_invoice_discounting_user" model="res.groups">
        <field name="name">Invoice Discounting &amp; Factoring Register User</field>
        <field name="category_id" ref="module_category_invoice_discounting"/>

    </record>
    <record id="group_invoice_discounting_manager" model="res.groups">
        <field name="name">Invoice Discounting &amp; Factoring Register Manager</field>
        <field name="category_id" ref="module_category_invoice_discounting"/>
        <field name="implied_ids" eval="[(4, ref('group_invoice_discounting_user'))]"/>
    </record>
    <record id="rule_invoice_discounting_sf_discounted_invoice" model="ir.rule">
        <field name="name">Discounted Invoice: multi-company</field>
        <field name="model_id" ref="model_sf_discounted_invoice"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
