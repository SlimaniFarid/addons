<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_grant_program" model="ir.sequence">
            <field name="name">Grant Program</field>
            <field name="code">sf.grant.program</field>
            <field name="prefix">PRG-</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>

        <record id="seq_grant_call" model="ir.sequence">
            <field name="name">Grant Call</field>
            <field name="code">sf.grant.call</field>
            <field name="prefix">CAL-</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>

        <record id="seq_grant_application" model="ir.sequence">
            <field name="name">Grant Application</field>
            <field name="code">sf.grant.application</field>
            <field name="prefix">APP-</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>

        <record id="seq_grant_expense" model="ir.sequence">
            <field name="name">Grant Expense</field>
            <field name="code">sf.grant.expense</field>
            <field name="prefix">EXP-</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>

        <record id="cron_grant_alerts" model="ir.cron">
            <field name="name">Grants: Deadline and Reporting Alerts</field>
            <field name="model_id" ref="model_sf_grant_call"/>
            <field name="state">code</field>
            <field name="code">model._check_grant_alerts()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="active">True</field>
        </record>
    </data>
</odoo>