<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_grants" model="ir.module.category">
        <field name="name">Grants</field>
        <field name="sequence">90</field>
    </record>

    <record id="group_grant_user" model="res.groups">
        <field name="name">Grants User</field>
        <field name="category_id" ref="module_category_grants"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_grant_manager" model="res.groups">
        <field name="name">Grants Manager</field>
        <field name="category_id" ref="module_category_grants"/>
        <field name="implied_ids" eval="[(4, ref('group_grant_user'))]"/>
    </record>

    <record id="rule_grant_program_user_company" model="ir.rule">
        <field name="name">Program: user sees own company</field>
        <field name="model_id" ref="model_sf_grant_program"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_grant_user'))]"/>
    </record>

    <record id="rule_grant_call_user_company" model="ir.rule">
        <field name="name">Call: user sees own company</field>
        <field name="model_id" ref="model_sf_grant_call"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_grant_user'))]"/>
    </record>

    <record id="rule_grant_application_user_company" model="ir.rule">
        <field name="name">Application: user sees own company</field>
        <field name="model_id" ref="model_sf_grant_application"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_grant_user'))]"/>
    </record>

    <record id="rule_grant_expense_user_company" model="ir.rule">
        <field name="name">Expense: user sees own company</field>
        <field name="model_id" ref="model_sf_grant_expense"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_grant_user'))]"/>
    </record>

    <record id="rule_grant_program_manager_all" model="ir.rule">
        <field name="name">Program: manager sees all companies</field>
        <field name="model_id" ref="model_sf_grant_program"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_grant_manager'))]"/>
    </record>

    <record id="rule_grant_call_manager_all" model="ir.rule">
        <field name="name">Call: manager sees all companies</field>
        <field name="model_id" ref="model_sf_grant_call"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_grant_manager'))]"/>
    </record>

    <record id="rule_grant_application_manager_all" model="ir.rule">
        <field name="name">Application: manager sees all companies</field>
        <field name="model_id" ref="model_sf_grant_application"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_grant_manager'))]"/>
    </record>

    <record id="rule_grant_expense_manager_all" model="ir.rule">
        <field name="name">Expense: manager sees all companies</field>
        <field name="model_id" ref="model_sf_grant_expense"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_grant_manager'))]"/>
    </record>
    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_grants"/>
    </record>
</odoo>