<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="report_financial" model="ir.actions.report">
        <field name="name">Grant Financial Report</field>
        <field name="model">sf.grant.program</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">sf_grants.report_financial_template</field>
        <field name="report_file">sf_grants.report_financial_template</field>
        <field name="binding_model_id" ref="model_sf_grant_program"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_financial_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>Financial Report — <t t-esc="o.name"/></h2>
                        <table class="table table-sm">
                            <tr><td><strong>Program</strong></td><td><t t-esc="o.name"/></td></tr>
                            <tr><td><strong>Funder</strong></td><td><t t-esc="o.funder or ''"/></td></tr>
                            <tr><td><strong>Funder type</strong></td><td><t t-esc="o.funder_type"/></td></tr>
                        </table>
                        <t t-foreach="o.call_ids" t-as="call">
                            <h4>Call: <t t-esc="call.name"/> — <t t-esc="call.title"/></h4>
                            <table class="table table-sm">
                                <thead>
                                    <tr>
                                        <th>Application</th>
                                        <th>Applicant</th>
                                        <th>Requested</th>
                                        <th>Granted</th>
                                        <th>Validated expenses</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="call.application_ids" t-as="app">
                                        <tr>
                                            <td><t t-esc="app.name"/></td>
                                            <td><t t-esc="app.applicant"/></td>
                                            <td><t t-esc="app.requested_amount"/></td>
                                            <td><t t-esc="app.granted_amount or 0"/></td>
                                            <td><t t-esc="app.total_validated_amount"/></td>
                                            <td><t t-esc="app.state"/></td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </t>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <record id="report_aid_register" model="ir.actions.report">
        <field name="name">Aid Register</field>
        <field name="model">sf.grant.application</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">sf_grants.report_aid_register_template</field>
        <field name="report_file">sf_grants.report_aid_register_template</field>
        <field name="binding_model_id" ref="model_sf_grant_application"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_aid_register_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>Aid Register</h2>
                        <table class="table table-sm">
                            <tr><td><strong>Application</strong></td><td><t t-esc="o.name"/></td></tr>
                            <tr><td><strong>Title</strong></td><td><t t-esc="o.title"/></td></tr>
                            <tr><td><strong>Program</strong></td><td><t t-esc="o.program_id.name or ''"/></td></tr>
                            <tr><td><strong>Call</strong></td><td><t t-esc="o.call_id.name or ''"/></td></tr>
                            <tr><td><strong>Applicant</strong></td><td><t t-esc="o.applicant"/></td></tr>
                            <tr><td><strong>Requested amount</strong></td><td><t t-esc="o.requested_amount"/></td></tr>
                            <tr><td><strong>Granted amount</strong></td><td><t t-esc="o.granted_amount or 0"/></td></tr>
                            <tr><td><strong>Currency</strong></td><td><t t-esc="o.currency"/></td></tr>
                            <tr><td><strong>Submission date</strong></td><td><t t-esc="o.submission_date or ''"/></td></tr>
                            <tr><td><strong>Decision date</strong></td><td><t t-esc="o.decision_date or ''"/></td></tr>
                            <tr><td><strong>Status</strong></td><td><t t-esc="o.state"/></td></tr>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>