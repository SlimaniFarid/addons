<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_grants" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.grants</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Grants" string="Grants" name="grants">
                    <block title="Deadline Alerts">
                        <setting string="Grant deadline alert margin (days)"
                                 help="Number of days before a call deadline to raise an activity alert. Deadline and reporting alerts are generated by the daily cron.">
                            <field name="sf_grant_alert_days"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>