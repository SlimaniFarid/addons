<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ========================= TEMPLATE FORM ========================== -->
    <record id="view_approval_template_form" model="ir.ui.view">
        <field name="name">sf.approval.template.form</field>
        <field name="model">sf.approval.template</field>
        <field name="arch" type="xml">
            <form string="Approval Template">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                        <field name="active" invisible="1"/>
                    </div>
                    <group>
                        <group>
                            <field name="sequence"/>
                            <field name="model_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="model_name" readonly="1"/>
                        </group>
                    </group>
                    <field name="note" placeholder="Describe this template..."/>
                    <group string="Approval Steps">
                        <field name="step_ids">
                            <list string="Steps" editable="bottom">
                                <field name="sequence"/>
                                <field name="name"/>
                                <field name="assignment"/>
                                <field name="user_id"
                                       attrs="{'column_invisible': [('assignment', '!=', 'specific')]}"/>
                                <field name="group_id"
                                       attrs="{'column_invisible': [('assignment', '!=', 'group')]}"/>
                                <field name="min_amount"/>
                                <field name="max_amount"/>
                                <field name="required"/>
                                <field name="is_auto_approve"/>
                            </list>
                        </field>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ========================= TEMPLATE TREE ========================== -->
    <record id="view_approval_template_tree" model="ir.ui.view">
        <field name="name">sf.approval.template.tree</field>
        <field name="model">sf.approval.template</field>
        <field name="arch" type="xml">
            <tree string="Approval Templates" editable="bottom">
                <field name="name"/>
                <field name="model_id"/>
                <field name="sequence"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <!-- ========================= REQUEST FORM =========================== -->
    <record id="view_approval_request_form" model="ir.ui.view">
        <field name="name">sf.approval.request.form</field>
        <field name="model">sf.approval.request</field>
        <field name="arch" type="xml">
            <form string="Approval Request">
                <header>
                    <button name="action_submit" type="object"
                            string="Submit" class="btn-primary" states="draft"/>
                    <button name="action_approve" type="object"
                            string="Approve" class="btn-primary" states="submitted"/>
                    <button name="action_reject" type="object"
                            string="Reject" class="btn-danger" states="submitted"/>
                    <button name="action_draft" type="object"
                            string="Reset to Draft" states="submitted,rejected"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                        <group>
                            <field name="state" widget="statusbar"
                                   statusbar_visible="draft,submitted,approved,rejected"/>
                        </group>
                    </div>
                    <group>
                        <group>
                            <field name="template_id"/>
                            <field name="requester_id"/>
                            <field name="date_requested"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="document_name"/>
                            <field name="res_model" readonly="1"/>
                            <field name="res_id" readonly="1"/>
                            <field name="amount"/>
                            <field name="current_step_id" readonly="1"/>
                        </group>
                    </group>
                    <group string="Approvers">
                        <field name="approver_ids" widget="many2many_tags" readonly="1"/>
                        <field name="current_approver_ids" widget="many2many_tags" readonly="1"/>
                    </group>
                    <field name="reason"/>
                    <field name="rejected_reason"/>
                    <notebook>
                        <page string="History" name="history">
                            <field name="step_history_ids">
                                <list string="Approval History">
                                    <field name="date"/>
                                    <field name="step_name"/>
                                    <field name="user_id"/>
                                    <field name="action" widget="badge"/>
                                    <field name="reason"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- ========================= REQUEST TREE =========================== -->
    <record id="view_approval_request_tree" model="ir.ui.view">
        <field name="name">sf.approval.request.tree</field>
        <field name="model">sf.approval.request</field>
        <field name="arch" type="xml">
            <tree string="Approval Requests">
                <field name="name"/>
                <field name="template_id"/>
                <field name="document_name"/>
                <field name="requester_id"/>
                <field name="amount" sum="Total"/>
                <field name="current_step_id"/>
                <field name="state" widget="badge"/>
            </tree>
        </field>
    </record>

    <!-- ========================= REQUEST SEARCH ========================= -->
    <record id="view_approval_request_search" model="ir.ui.view">
        <field name="name">sf.approval.request.search</field>
        <field name="model">sf.approval.request</field>
        <field name="arch" type="xml">
            <search string="Approval Requests">
                <field name="name"/>
                <field name="document_name"/>
                <field name="requester_id"/>
                <field name="template_id"/>
                <filter string="Pending" name="pending"
                        domain="[('state', '=', 'submitted')]"/>
                <filter string="Approved" name="approved"
                        domain="[('state', '=', 'approved')]"/>
                <filter string="Rejected" name="rejected"
                        domain="[('state', '=', 'rejected')]"/>
                <filter string="My Requests" name="mine"
                        domain="[('requester_id', '=', uid)]"/>
                <filter string="To Approve" name="to_approve"
                        domain="[('state', '=', 'submitted'), ('approver_ids', 'in', uid)]"/>
                <group expand="0" string="Group By">
                    <filter string="Template" name="group_tpl"
                            context="{'group_by': 'template_id'}"/>
                    <filter string="Requester" name="group_req"
                            context="{'group_by': 'requester_id'}"/>
                    <filter string="Status" name="group_state"
                            context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ========================== ACTIONS =============================== -->
    <record id="action_approval_template" model="ir.actions.act_window">
        <field name="name">Approval Templates</field>
        <field name="res_model">sf.approval.template</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record id="action_approval_request" model="ir.actions.act_window">
        <field name="name">Approval Requests</field>
        <field name="res_model">sf.approval.request</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_approval_request_search"/>
    </record>
</odoo>