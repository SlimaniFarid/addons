<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_vendor_contracts" model="ir.module.category">
        <field name="name">Vendor Contracts</field>
        <field name="sequence">94</field>
    </record>

    <record id="group_vendor_contracts_user" model="res.groups">
        <field name="name">Vendor Contracts User</field>
        <field name="category_id" ref="module_category_vendor_contracts"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_vendor_contracts_manager" model="res.groups">
        <field name="name">Vendor Contracts Manager</field>
        <field name="category_id" ref="module_category_vendor_contracts"/>
        <field name="implied_ids" eval="[(4, ref('group_vendor_contracts_user'))]"/>
    </record>

    <record id="rule_vendor_contract_user_company" model="ir.rule">
        <field name="name">Vendor Contract: user sees own company</field>
        <field name="model_id" ref="model_sf_vendor_contract"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_vendor_contracts_user'))]"/>
    </record>

    <record id="rule_vendor_clause_user_company" model="ir.rule">
        <field name="name">Contract Clause: user sees own company</field>
        <field name="model_id" ref="model_sf_vendor_contract_clause"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[
            '|',
            ('contract_id', '=', False),
            ('contract_id.company_id', 'in', company_ids),
        ]</field>
        <field name="groups" eval="[(4, ref('group_vendor_contracts_user'))]"/>
    </record>
</odoo>