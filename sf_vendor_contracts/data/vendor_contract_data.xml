<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="vendor_contract_demo" model="sf.vendor.contract">
            <field name="name">Sample Supply Agreement</field>
            <field name="partner_id" ref="base.res_partner_1"/>
            <field name="contract_type">supply</field>
            <field name="date_start" eval="(Date.today()).strftime('%Y-%m-%d')"/>
            <field name="date_end" eval="(Date.today() + relativedelta(years=1)).strftime('%Y-%m-%d')"/>
            <field name="amount_total">10000</field>
            <field name="state">active</field>
        </record>

        <record id="clause_type_pricing" model="sf.vendor.contract.clause">
            <field name="contract_id" ref="vendor_contract_demo"/>
            <field name="title">Pricing</field>
            <field name="type">pricing</field>
            <field name="content">Prices fixed for the duration of the contract.</field>
        </record>

        <record id="clause_type_payment" model="sf.vendor.contract.clause">
            <field name="contract_id" ref="vendor_contract_demo"/>
            <field name="title">Payment Terms</field>
            <field name="type">payment</field>
            <field name="content">Net 30 days from invoice date.</field>
        </record>
    </data>
</odoo>