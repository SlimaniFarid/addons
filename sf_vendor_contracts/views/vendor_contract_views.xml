<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Contract form -->
    <record id="vendor_contract_view_form" model="ir.ui.view">
        <field name="name">sf.vendor.contract.form</field>
        <field name="model">sf.vendor.contract</field>
        <field name="arch" type="xml">
            <form string="Supplier Contract">
                <header>
                    <button name="action_activate" type="object"
                            string="Activate" class="btn-primary"
                            invisible="[('state', 'not in', ('draft',))]"/>
                    <button name="action_renew" type="object"
                            string="Renew" invisible="[('state', 'not in', ('active', 'expiring', 'expired'))]"/>
                    <button name="action_cancel" type="object"
                            string="Cancel" invisible="[('state', 'not in', ('active', 'expiring'))]"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="partner_ref"/>
                            <field name="contract_type"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <field name="renewal_days"/>
                            <field name="amount_total"/>
                            <field name="currency_id" groups="base.group_multi_currency"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Clauses">
                            <field name="clause_ids">
                                <tree string="Clauses" editable="bottom">
                                    <field name="type"/>
                                    <field name="title"/>
                                    <field name="content"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Lines">
                            <field name="line_ids">
                                <tree string="Lines" editable="bottom">
                                    <field name="product_id"/>
                                    <field name="description"/>
                                    <field name="quantity"/>
                                    <field name="unit_price"/>
                                    <field name="amount"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Versions">
                            <field name="version_ids" readonly="1">
                                <tree string="Versions">
                                    <field name="version"/>
                                    <field name="date_start"/>
                                    <field name="date_end"/>
                                    <field name="amount_total"/>
                                    <field name="state"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Attachments">
                            <field name="attachment_ids" widget="many2many_binary"/>
                        </page>
                        <page string="Notes">
                            <field name="notes"/>
                        </page>
                        <page string="Messages">
                            <field name="message_ids"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="vendor_contract_view_tree" model="ir.ui.view">
        <field name="name">sf.vendor.contract.tree</field>
        <field name="model">sf.vendor.contract</field>
        <field name="arch" type="xml">
            <tree string="Contracts">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="contract_type"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="amount_total"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <record id="vendor_contract_view_kanban" model="ir.ui.view">
        <field name="name">sf.vendor.contract.kanban</field>
        <field name="model">sf.vendor.contract</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="date_end"/>
                <field name="amount_total"/>
                <field name="state"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_record_title">
                                <span class="o_kanban_record_headings">
                                    <strong><field name="name"/></strong>
                                </span>
                            </div>
                            <div class="o_kanban_record_body">
                                <field name="partner_id"/>
                                <field name="state" widget="badge"/>
                                <div>
                                    <field name="amount_total"/>
<span t-if="record.date_end.raw_value">
                                        &amp;nbsp;· <field name="date_end"/>
                                    </span>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="vendor_contract_view_search" model="ir.ui.view">
        <field name="name">sf.vendor.contract.search</field>
        <field name="model">sf.vendor.contract</field>
        <field name="arch" type="xml">
            <search string="Contracts">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="contract_type"/>
                <filter name="active" string="Active"
                        domain="[('state', '=', 'active')]"/>
                <filter name="expiring" string="Expiring"
                        domain="[('state', '=', 'expiring')]"/>
                <filter name="expired" string="Expired"
                        domain="[('state', '=', 'expired')]"/>
                <group>
                    <filter name="group_state" string="Status"
                            context="{'group_by': 'state'}"/>
                    <filter name="group_partner" string="Supplier"
                            context="{'group_by': 'partner_id'}"/>
                    <filter name="group_type" string="Type"
                            context="{'group_by': 'contract_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Clause tree -->
    <record id="vendor_contract_clause_view_tree" model="ir.ui.view">
        <field name="name">sf.vendor.contract.clause.tree</field>
        <field name="model">sf.vendor.contract.clause</field>
        <field name="arch" type="xml">
            <tree string="Clauses">
                <field name="contract_id"/>
                <field name="type"/>
                <field name="title"/>
            </tree>
        </field>
    </record>

    <!-- Renew wizard form -->
    <record id="vendor_contract_renew_wizard_form" model="ir.ui.view">
        <field name="name">sf.vendor.contract.renew.wizard.form</field>
        <field name="model">sf.vendor.contract.renew.wizard</field>
        <field name="arch" type="xml">
            <form string="Renew Contract">
                <group>
                    <field name="contract_id"/>
                    <field name="new_date_start"/>
                    <field name="new_date_end"/>
                    <field name="new_amount"/>
                    <field name="currency_id"/>
                    <field name="version"/>
                </group>
                <footer>
                    <button name="action_renew" type="object"
                            string="Renew" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Cancel wizard form -->
    <record id="vendor_contract_cancel_wizard_form" model="ir.ui.view">
        <field name="name">sf.vendor.contract.cancel.wizard.form</field>
        <field name="model">sf.vendor.contract.cancel.wizard</field>
        <field name="arch" type="xml">
            <form string="Cancel Contract">
                <group>
                    <field name="contract_id"/>
                    <field name="reason"/>
                </group>
                <footer>
                    <button name="action_cancel" type="object"
                            string="Cancel Contract" class="btn-danger"/>
                    <button string="Back" class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Inherited res.partner form -->
    <record id="vendor_contract_res_partner_form" model="ir.ui.view">
        <field name="name">res.partner.form.vendor_contract</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='sales_purchases']" position="inside">
                <group string="Contracts">
                    <field name="sf_vendor_contract_ids" readonly="1">
                        <tree string="Contracts">
                            <field name="name"/>
                            <field name="contract_type"/>
                            <field name="date_end"/>
                            <field name="amount_total"/>
                            <field name="state"/>
                        </tree>
                    </field>
                </group>
            </xpath>
        </field>
    </record>

    <!-- Actions -->
    <record id="action_vendor_contract" model="ir.actions.act_window">
        <field name="name">Contracts</field>
        <field name="res_model">sf.vendor.contract</field>
        <field name="view_mode">tree,kanban,form</field>
        <field name="search_view_id" ref="vendor_contract_view_search"/>
    </record>

    <record id="action_vendor_contract_expiring" model="ir.actions.act_window">
        <field name="name">Expiring Soon</field>
        <field name="res_model">sf.vendor.contract</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="vendor_contract_view_search"/>
        <field name="domain">[('state', '=', 'expiring')]</field>
    </record>

    <record id="action_vendor_contract_clause" model="ir.actions.act_window">
        <field name="name">Clauses</field>
        <field name="res_model">sf.vendor.contract.clause</field>
        <field name="view_mode">tree,form</field>
    </record>

</odoo>