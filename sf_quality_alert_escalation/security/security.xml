<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_quality_alert_escalation" model="ir.module.category">
        <field name="name">Quality Alert Escalation Matrix</field>
        <field name="sequence">486</field>
    </record>
    <record id="group_quality_alert_escalation_user" model="res.groups">
        <field name="name">Quality Alert Escalation Matrix User</field>
        <field name="category_id" ref="module_category_quality_alert_escalation"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>

    </record>
    <record id="group_quality_alert_escalation_manager" model="res.groups">
        <field name="name">Quality Alert Escalation Matrix Manager</field>
        <field name="category_id" ref="module_category_quality_alert_escalation"/>
        <field name="implied_ids" eval="[(4, ref('group_quality_alert_escalation_user'))]"/>
    </record>
    <record id="rule_quality_alert_escalation_sf_quality_alert_escalation" model="ir.rule">
        <field name="name">Quality Alert Escalation Matrix: multi-company</field>
        <field name="model_id" ref="model_sf_quality_alert_escalation"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_quality_alert_escalation"/>
    </record>
</odoo>
