<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_quality_alert_escalation" model="ir.actions.act_window">
        <field name="name">Quality Alert Escalation Matrix</field>
        <field name="res_model">sf.quality_alert_escalation</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
    <record id="view_sf_quality_alert_escalation_form" model="ir.ui.view">
        <field name="name">sf.quality_alert_escalation.form</field>
        <field name="model">sf.quality_alert_escalation</field>
        <field name="arch" type="xml">
            <form string="Quality Alert Escalation Matrix">
                <header>
                    <button name="action_submitted" type="object" string="Submitted"
                            class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="alert_type"/>
                            <field name="severity"/>
                            <field name="escalation_level"/>
                            <field name="escalate_to_id"/>
                            <field name="timer_minutes"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_quality_alert_escalation_list" model="ir.ui.view">
        <field name="name">sf.quality_alert_escalation.list</field>
        <field name="model">sf.quality_alert_escalation</field>
        <field name="arch" type="xml">
            <list string="Quality Alert Escalation Matrix" sample="1">
                <field name="alert_type"/>
                <field name="severity"/>
                <field name="escalation_level"/>
                <field name="escalate_to_id"/>
                <field name="timer_minutes"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state in ('submitted','approved')"/>
            </list>
        </field>
    </record>
    <record id="view_sf_quality_alert_escalation_kanban" model="ir.ui.view">
        <field name="name">sf.quality_alert_escalation.kanban</field>
        <field name="model">sf.quality_alert_escalation</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_view" group_by="state">
                <field name="name"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <menuitem id="menu_sf_quality_alert_escalation_root" name="Quality Alert Escalation Matrix" sequence="15"
              web_icon="sf_quality_alert_escalation,static/description/icon.png"/>
    <menuitem id="menu_sf_quality_alert_escalation_main" name="Records"
              parent="menu_sf_quality_alert_escalation_root" action="action_sf_quality_alert_escalation" sequence="10"/>

    <record id="wave_final_sf_quality_alert_escalation" model="ir.actions.server">
        <field name="name">Refresh Business Data</field>
        <field name="model_id" ref="model_sf_quality_alert_escalation"/>
        <field name="binding_model_id" ref="model_sf_quality_alert_escalation"/>
        <field name="state">code</field>
        <field name="code">records.action_refresh_business()</field>
    </record>
</odoo>
