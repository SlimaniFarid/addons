<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_supplier_invoice_3way_match3" model="ir.actions.act_window">
        <field name="name">Invoice Matching Rules</field>
        <field name="res_model">sf.supplier_invoice_3way_match3</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
    <record id="view_sf_supplier_invoice_3way_match3_form" model="ir.ui.view">
        <field name="name">sf.supplier_invoice_3way_match3.form</field>
        <field name="model">sf.supplier_invoice_3way_match3</field>
        <field name="arch" type="xml">
            <form string="Invoice Matching Rules">
                <header>
                    <button name="action_submitted" type="object" string="Submitted"
                            class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="rule_name"/>
                            <field name="match_field"/>
                            <field name="tolerance_percent"/>
                            <field name="auto_match"/>
                            <field name="priority"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_supplier_invoice_3way_match3_list" model="ir.ui.view">
        <field name="name">sf.supplier_invoice_3way_match3.list</field>
        <field name="model">sf.supplier_invoice_3way_match3</field>
        <field name="arch" type="xml">
            <list string="Invoice Matching Rules" sample="1">
                <field name="rule_name"/>
                <field name="match_field"/>
                <field name="tolerance_percent"/>
                <field name="auto_match"/>
                <field name="priority"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state in ('submitted','approved')"/>
            </list>
        </field>
    </record>
    <record id="view_sf_supplier_invoice_3way_match3_kanban" model="ir.ui.view">
        <field name="name">sf.supplier_invoice_3way_match3.kanban</field>
        <field name="model">sf.supplier_invoice_3way_match3</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_view" group_by="state">
                <field name="name"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <menuitem id="menu_sf_supplier_invoice_3way_match3_root" name="Invoice Matching Rules" sequence="5"
              web_icon="sf_supplier_invoice_3way_match3,static/description/icon.png"/>
    <menuitem id="menu_sf_supplier_invoice_3way_match3_main" name="Records"
              parent="menu_sf_supplier_invoice_3way_match3_root" action="action_sf_supplier_invoice_3way_match3" sequence="10"/>

    <record id="wave_final_sf_supplier_invoice_3way_match3" model="ir.actions.server">
        <field name="name">Refresh Business Data</field>
        <field name="model_id" ref="model_sf_supplier_invoice_3way_match3"/>
        <field name="binding_model_id" ref="model_sf_supplier_invoice_3way_match3"/>
        <field name="state">code</field>
        <field name="code">records.action_refresh_business()</field>
    </record>
</odoo>
