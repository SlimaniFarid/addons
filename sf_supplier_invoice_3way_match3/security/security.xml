<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_supplier_invoice_3way_match3" model="ir.module.category">
        <field name="name">Invoice Matching Rules</field>
        <field name="sequence">666</field>
    </record>
    <record id="group_supplier_invoice_3way_match3_user" model="res.groups">
        <field name="name">Invoice Matching Rules User</field>
        <field name="category_id" ref="module_category_supplier_invoice_3way_match3"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>

    </record>
    <record id="group_supplier_invoice_3way_match3_manager" model="res.groups">
        <field name="name">Invoice Matching Rules Manager</field>
        <field name="category_id" ref="module_category_supplier_invoice_3way_match3"/>
        <field name="implied_ids" eval="[(4, ref('group_supplier_invoice_3way_match3_user'))]"/>
    </record>
    <record id="rule_supplier_invoice_3way_match3_sf_supplier_invoice_3way_match3" model="ir.rule">
        <field name="name">Invoice Matching Rules: multi-company</field>
        <field name="model_id" ref="model_sf_supplier_invoice_3way_match3"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_supplier_invoice_3way_match3"/>
    </record>
</odoo>
