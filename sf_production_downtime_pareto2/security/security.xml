<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_production_downtime_pareto2" model="ir.module.category">
        <field name="name">Downtime Pareto Analyzer</field>
        <field name="sequence">457</field>
    </record>
    <record id="group_production_downtime_pareto2_user" model="res.groups">
        <field name="name">Downtime Pareto Analyzer User</field>
        <field name="category_id" ref="module_category_production_downtime_pareto2"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>

    </record>
    <record id="group_production_downtime_pareto2_manager" model="res.groups">
        <field name="name">Downtime Pareto Analyzer Manager</field>
        <field name="category_id" ref="module_category_production_downtime_pareto2"/>
        <field name="implied_ids" eval="[(4, ref('group_production_downtime_pareto2_user'))]"/>
    </record>
    <record id="rule_production_downtime_pareto2_sf_production_downtime_pareto2" model="ir.rule">
        <field name="name">Downtime Pareto Analyzer: multi-company</field>
        <field name="model_id" ref="model_sf_production_downtime_pareto2"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
