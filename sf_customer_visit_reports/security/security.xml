<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_customer_visit_reports" model="ir.module.category">
        <field name="name">Customer Visit Reports</field>
        <field name="sequence">45</field>
    </record>
    <record id="group_customer_visit_reports_user" model="res.groups">
        <field name="name">Customer Visit Reports User</field>
        <field name="category_id" ref="module_category_customer_visit_reports"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>

    </record>
    <record id="group_customer_visit_reports_manager" model="res.groups">
        <field name="name">Customer Visit Reports Manager</field>
        <field name="category_id" ref="module_category_customer_visit_reports"/>
        <field name="implied_ids" eval="[(4, ref('group_customer_visit_reports_user'))]"/>
    </record>
    <record id="rule_customer_visit_reports_sf_visit_report" model="ir.rule">
        <field name="name">Visit Report: multi-company</field>
        <field name="model_id" ref="model_sf_visit_report"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_customer_visit_reports"/>
    </record>
</odoo>
