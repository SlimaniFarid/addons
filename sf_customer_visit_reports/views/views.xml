<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_visit_report" model="ir.actions.act_window">
        <field name="name">Customer Visit Reports</field>
        <field name="res_model">sf.visit.report</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
    <record id="view_sf_visit_report_form" model="ir.ui.view">
        <field name="name">sf.visit.report.form</field>
        <field name="model">sf.visit.report</field>
        <field name="arch" type="xml">
            <form string="Customer Visit Reports">
                <header>
                    <button name="action_submitted" type="object" string="Submitted"
                            class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,acknowledged"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="visit_date"/>
                            <field name="visited_by_id"/>
                            <field name="agenda"/>
                        <field name="findings"/>
                        <field name="opportunities"/>
                            <field name="next_steps"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_visit_report_list" model="ir.ui.view">
        <field name="name">sf.visit.report.list</field>
        <field name="model">sf.visit.report</field>
        <field name="arch" type="xml">
            <list string="Customer Visit Reports" sample="1">
                <field name="partner_id"/>
                <field name="visit_date"/>
                <field name="visited_by_id"/>
                <field name="agenda"/>
                <field name="findings"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state in ('submitted','approved')"/>
            </list>
        </field>
    </record>
    <record id="view_sf_visit_report_kanban" model="ir.ui.view">
        <field name="name">sf.visit.report.kanban</field>
        <field name="model">sf.visit.report</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_view" group_by="state">
                <field name="name"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <menuitem id="menu_sf_visit_report_root" name="Customer Visit Reports" sequence="10"
              web_icon="sf_customer_visit_reports,static/description/icon.png"/>
    <menuitem id="menu_sf_visit_report_main" name="Records"
              parent="menu_sf_visit_report_root" action="action_sf_visit_report" sequence="10"/>

    <record id="wave_final_sf_customer_visit_reports" model="ir.actions.server">
        <field name="name">Refresh Business Data</field>
        <field name="model_id" ref="model_sf_visit_report"/>
        <field name="binding_model_id" ref="model_sf_visit_report"/>
        <field name="state">code</field>
        <field name="code">records.action_refresh_business()</field>
    </record>
</odoo>
