<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_sf_ai_invoice_ocr" model="ir.module.category">
        <field name="name">AI Invoice Ocr</field>
        <field name="description">AI Invoice Ocr Management</field>
        <field name="sequence">10</field>
    </record>

    <record id="group_sf_ai_invoice_ocr_user" model="res.groups">
        <field name="name">AI Invoice Ocr / User</field>
        <field name="category_id" ref="module_category_sf_ai_invoice_ocr"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_sf_ai_invoice_ocr_manager" model="res.groups">
        <field name="name">AI Invoice Ocr / Manager</field>
        <field name="category_id" ref="module_category_sf_ai_invoice_ocr"/>
        <field name="implied_ids" eval="[(4, ref('sf_ai_invoice_ocr.group_sf_ai_invoice_ocr_user'))]"/>
    </record>

    <record id="rule_sf_ai_invoice_ocr_company" model="ir.rule">
        <field name="name">AI Invoice Ocr: user sees own company</field>
        <field name="model_id" ref="model_sf_ai_invoice_ocr"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('sf_ai_invoice_ocr.group_sf_ai_invoice_ocr_user'))]"/>
    </record>
    <record id="rule_sf_ai_invoice_ocr_manager_all" model="ir.rule">
        <field name="name">AI Invoice Ocr: manager sees all companies</field>
        <field name="model_id" ref="model_sf_ai_invoice_ocr"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('sf_ai_invoice_ocr.group_sf_ai_invoice_ocr_manager'))]"/>
    </record>
    <record id="group_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="module_category_sf_ai_invoice_ocr"/>
    </record>
    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_sf_ai_invoice_ocr"/>
    </record>
    <record id="group_system" model="res.groups">
        <field name="name">System</field>
        <field name="category_id" ref="module_category_sf_ai_invoice_ocr"/>
    </record>
</odoo>