<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_supplier_risk" model="ir.actions.act_window">
        <field name="name">Supplier Risk Register</field>
        <field name="res_model">sf.supplier.risk</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
    <record id="view_sf_supplier_risk_form" model="ir.ui.view">
        <field name="name">sf.supplier.risk.form</field>
        <field name="model">sf.supplier.risk</field>
        <field name="arch" type="xml">
            <form string="Supplier Risk Register">
                <header>
                    <button name="action_mitigating" type="object" string="Mitigating"
                            class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="identified,mitigating,closed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="vendor_id"/>
                            <field name="risk_type"/>
                            <field name="score"/>
                            <field name="mitigation"/>
                            <field name="contingency"/>
                            <field name="review_date"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_supplier_risk_list" model="ir.ui.view">
        <field name="name">sf.supplier.risk.list</field>
        <field name="model">sf.supplier.risk</field>
        <field name="arch" type="xml">
            <list string="Supplier Risk Register" sample="1">
                <field name="vendor_id"/>
                <field name="risk_type"/>
                <field name="score"/>
                <field name="mitigation"/>
                <field name="contingency"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state in ('submitted','approved')"/>
            </list>
        </field>
    </record>
    <record id="view_sf_supplier_risk_kanban" model="ir.ui.view">
        <field name="name">sf.supplier.risk.kanban</field>
        <field name="model">sf.supplier.risk</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_view" group_by="state">
                <field name="name"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <menuitem id="menu_sf_supplier_risk_root" name="Supplier Risk Register" sequence="21"
              web_icon="sf_supplier_risk_register,static/description/icon.png"/>
    <menuitem id="menu_sf_supplier_risk_main" name="Records"
              parent="menu_sf_supplier_risk_root" action="action_sf_supplier_risk" sequence="10"/>

    <record id="wave_final_sf_supplier_risk_register" model="ir.actions.server">
        <field name="name">Refresh Business Data</field>
        <field name="model_id" ref="model_sf_supplier_risk"/>
        <field name="binding_model_id" ref="model_sf_supplier_risk"/>
        <field name="state">code</field>
        <field name="code">records.action_refresh_business()</field>
    </record>
</odoo>
