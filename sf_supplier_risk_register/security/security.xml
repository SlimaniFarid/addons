<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_supplier_risk_register" model="ir.module.category">
        <field name="name">Supplier Risk Register</field>
        <field name="sequence">38</field>
    </record>
    <record id="group_supplier_risk_register_user" model="res.groups">
        <field name="name">Supplier Risk Register User</field>
        <field name="category_id" ref="module_category_supplier_risk_register"/>
        <field name="implied_ids" eval="[(4, ref('purchase.group_purchase_user'))]"/>

    </record>
    <record id="group_supplier_risk_register_manager" model="res.groups">
        <field name="name">Supplier Risk Register Manager</field>
        <field name="category_id" ref="module_category_supplier_risk_register"/>
        <field name="implied_ids" eval="[(4, ref('group_supplier_risk_register_user'))]"/>
    </record>
    <record id="rule_supplier_risk_register_sf_supplier_risk" model="ir.rule">
        <field name="name">Supplier Risk: multi-company</field>
        <field name="model_id" ref="model_sf_supplier_risk"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
