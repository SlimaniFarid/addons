<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_purchase_requisition_template" model="ir.module.category">
        <field name="name">Purchase Requisition Templates</field>
        <field name="sequence">289</field>
    </record>
    <record id="group_purchase_requisition_template_user" model="res.groups">
        <field name="name">Purchase Requisition Templates User</field>
        <field name="category_id" ref="module_category_purchase_requisition_template"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>

    </record>
    <record id="group_purchase_requisition_template_manager" model="res.groups">
        <field name="name">Purchase Requisition Templates Manager</field>
        <field name="category_id" ref="module_category_purchase_requisition_template"/>
        <field name="implied_ids" eval="[(4, ref('group_purchase_requisition_template_user'))]"/>
    </record>
    <record id="rule_purchase_requisition_template_sf_purchase_requisition_template" model="ir.rule">
        <field name="name">Purchase Requisition Templates: multi-company</field>
        <field name="model_id" ref="model_sf_purchase_requisition_template"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_purchase_requisition_template"/>
    </record>
</odoo>
