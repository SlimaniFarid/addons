<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_contract_compliance" model="ir.actions.act_window">
        <field name="name">Supplier Contract Compliance</field>
        <field name="res_model">sf.contract.compliance</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
    <record id="view_sf_contract_compliance_form" model="ir.ui.view">
        <field name="name">sf.contract.compliance.form</field>
        <field name="model">sf.contract.compliance</field>
        <field name="arch" type="xml">
            <form string="Supplier Contract Compliance">
                <header>
                    <button name="action_in_review" type="object" string="In Review"
                            class="btn-primary"/>
                    <button name="action_reported" type="object" string="Reported"
                            class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="planned,in_review,reported,closed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="vendor_id"/>
                            <field name="check_type"/>
                            <field name="result"/>
                        <field name="findings"/>
                            <field name="corrective"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_contract_compliance_list" model="ir.ui.view">
        <field name="name">sf.contract.compliance.list</field>
        <field name="model">sf.contract.compliance</field>
        <field name="arch" type="xml">
            <list string="Supplier Contract Compliance" sample="1">
                <field name="vendor_id"/>
                <field name="check_type"/>
                <field name="result"/>
                <field name="findings"/>
                <field name="corrective"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state in ('submitted','approved')"/>
            </list>
        </field>
    </record>
    <record id="view_sf_contract_compliance_kanban" model="ir.ui.view">
        <field name="name">sf.contract.compliance.kanban</field>
        <field name="model">sf.contract.compliance</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_view" group_by="state">
                <field name="name"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <menuitem id="menu_sf_contract_compliance_root" name="Supplier Contract Compliance" sequence="27"
              web_icon="sf_contract_compliance_audit,static/description/icon.png"/>
    <menuitem id="menu_sf_contract_compliance_main" name="Records"
              parent="menu_sf_contract_compliance_root" action="action_sf_contract_compliance" sequence="10"/>
</odoo>
