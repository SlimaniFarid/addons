<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_contract_compliance_audit" model="ir.module.category">
        <field name="name">Supplier Contract Compliance</field>
        <field name="sequence">39</field>
    </record>
    <record id="group_contract_compliance_audit_user" model="res.groups">
        <field name="name">Supplier Contract Compliance User</field>
        <field name="category_id" ref="module_category_contract_compliance_audit"/>
        <field name="implied_ids" eval="[(4, ref('purchase.group_purchase_user'))]"/>

    </record>
    <record id="group_contract_compliance_audit_manager" model="res.groups">
        <field name="name">Supplier Contract Compliance Manager</field>
        <field name="category_id" ref="module_category_contract_compliance_audit"/>
        <field name="implied_ids" eval="[(4, ref('group_contract_compliance_audit_user'))]"/>
    </record>
    <record id="rule_contract_compliance_audit_sf_contract_compliance" model="ir.rule">
        <field name="name">Compliance Check: multi-company</field>
        <field name="model_id" ref="model_sf_contract_compliance"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_contract_compliance_audit"/>
    </record>
</odoo>
