<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_renewal_contract" model="ir.actions.act_window">
        <field name="name">Renewal Contracts</field>
        <field name="res_model">sf.renewal.contract</field>
        <field name="view_mode">list,form,kanban,pivot</field>
        <field name="context">{'search_default_group_by_state': 1}</field>
    </record>

    <record id="view_sf_renewal_contract_form" model="ir.ui.view">
        <field name="name">sf.renewal.contract.form</field>
        <field name="model">sf.renewal.contract</field>
        <field name="arch" type="xml">
            <form string="Renewal Contract">
                <header>
                    <button name="action_flag_expiring" type="object"
                            string="Flag Expiring" invisible="state != 'active'"/>
                    <button name="action_mark_renewed" type="object"
                            string="Renewed" class="btn-primary"
                            invisible="state != 'expiring'"/>
                    <button name="action_mark_lost" type="object"
                            string="Lost" class="btn-danger"
                            invisible="state != 'expiring'"/>
                    <button name="action_mark_expired" type="object"
                            string="Expired" invisible="state != 'active'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="active,expiring,renewed,lost,expired"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="partner_id"/>
                            <field name="contract_type"/>
                            <field name="owner_id"/>
                            <field name="start_date"/>
                            <field name="end_date"/>
                        </group>
                        <group>
                            <field name="notice_period_days"/>
                            <field name="auto_renew"/>
                            <field name="annual_value"/>
                            <field name="renewal_value"/>
                            <field name="churn_risk" widget="radio"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group>
                            <field name="notice_deadline" readonly="1"/>
                            <field name="days_to_notice" readonly="1"/>
                            <field name="days_to_expiry" readonly="1"/>
                            <field name="expiring_soon" readonly="1"
                                   widget="boolean"/>
                        </group>
                        <group>
                            <field name="next_action_date"/>
                            <field name="next_action_note"/>
                            <field name="renewed_end_date"
                                   invisible="state != 'renewed'"/>
                        </group>
                    </group>
                    <group string="Lost Reason" invisible="state != 'lost'">
                        <field name="lost_reason"/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_renewal_contract_list" model="ir.ui.view">
        <field name="name">sf.renewal.contract.list</field>
        <field name="model">sf.renewal.contract</field>
        <field name="arch" type="xml">
            <list string="Renewal Contracts" sample="1" decoration-danger="state == 'expiring' and days_to_expiry &lt; 30">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="contract_type"/>
                <field name="end_date"/>
                <field name="notice_deadline"/>
                <field name="days_to_expiry"/>
                <field name="annual_value"/>
                <field name="churn_risk" widget="badge"
                       decoration-danger="churn_risk == 'high'"
                       decoration-warning="churn_risk == 'medium'"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'renewed'"
                       decoration-danger="state == 'lost'"/>
            </list>
        </field>
    </record>
    <record id="view_sf_renewal_contract_kanban" model="ir.ui.view">
        <field name="name">sf.renewal.contract.kanban</field>
        <field name="model">sf.renewal.contract</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_view" group_by="state">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="end_date"/>
                <field name="annual_value"/>
                <field name="churn_risk"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong><field name="partner_id"/></strong><br/>
                                End: <field name="end_date"/><br/>
                                ACV: <field name="annual_value"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <menuitem id="menu_sf_renewal_root" name="Contract Renewals" sequence="34"
              parent="sale.sale_menu_root"/>
    <menuitem id="menu_sf_renewal_contracts" name="Renewal Contracts"
              parent="menu_sf_renewal_root" action="action_sf_renewal_contract"
              sequence="10"/>
</odoo>
