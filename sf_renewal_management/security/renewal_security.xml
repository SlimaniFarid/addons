<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_sf_renewal" model="ir.module.category">
        <field name="name">Contract Renewals</field>
        <field name="sequence">84</field>
    </record>
    <record id="group_sf_renewal_user" model="res.groups">
        <field name="name">Renewal User</field>
        <field name="category_id" ref="module_category_sf_renewal"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
    </record>
    <record id="group_sf_renewal_manager" model="res.groups">
        <field name="name">Renewal Manager</field>
        <field name="category_id" ref="module_category_sf_renewal"/>
        <field name="implied_ids" eval="[(4, ref('group_sf_renewal_user'))]"/>
    </record>
    <record id="rule_sf_renewal_company" model="ir.rule">
        <field name="name">Renewal Contract: multi-company</field>
        <field name="model_id" ref="model_sf_renewal_contract"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
