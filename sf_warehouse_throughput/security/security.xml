<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_warehouse_throughput" model="ir.module.category">
        <field name="name">Warehouse Throughput Monitor</field>
        <field name="sequence">167</field>
    </record>
    <record id="group_warehouse_throughput_user" model="res.groups">
        <field name="name">Warehouse Throughput Monitor User</field>
        <field name="category_id" ref="module_category_warehouse_throughput"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>

    </record>
    <record id="group_warehouse_throughput_manager" model="res.groups">
        <field name="name">Warehouse Throughput Monitor Manager</field>
        <field name="category_id" ref="module_category_warehouse_throughput"/>
        <field name="implied_ids" eval="[(4, ref('group_warehouse_throughput_user'))]"/>
    </record>
    <record id="rule_warehouse_throughput_sf_warehouse_throughput" model="ir.rule">
        <field name="name">Warehouse Throughput Monitor: multi-company</field>
        <field name="model_id" ref="model_sf_warehouse_throughput"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_warehouse_throughput"/>
    </record>
</odoo>
