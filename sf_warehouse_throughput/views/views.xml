<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_warehouse_throughput" model="ir.actions.act_window">
        <field name="name">Warehouse Throughput Monitor</field>
        <field name="res_model">sf.warehouse_throughput</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
    <record id="view_sf_warehouse_throughput_form" model="ir.ui.view">
        <field name="name">sf.warehouse_throughput.form</field>
        <field name="model">sf.warehouse_throughput</field>
        <field name="arch" type="xml">
            <form string="Warehouse Throughput Monitor">
                <header>
                    <button name="action_submitted" type="object" string="Submitted"
                            class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="date"/>
                            <field name="zone"/>
                            <field name="orders_picked"/>
                            <field name="lines_picked"/>
                            <field name="pick_errors"/>
                            <field name="operators_count"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_warehouse_throughput_list" model="ir.ui.view">
        <field name="name">sf.warehouse_throughput.list</field>
        <field name="model">sf.warehouse_throughput</field>
        <field name="arch" type="xml">
            <list string="Warehouse Throughput Monitor" sample="1">
                <field name="date"/>
                <field name="zone"/>
                <field name="orders_picked"/>
                <field name="lines_picked"/>
                <field name="pick_errors"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state in ('submitted','approved')"/>
            </list>
        </field>
    </record>
    <record id="view_sf_warehouse_throughput_kanban" model="ir.ui.view">
        <field name="name">sf.warehouse_throughput.kanban</field>
        <field name="model">sf.warehouse_throughput</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_view" group_by="state">
                <field name="name"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <menuitem id="menu_sf_warehouse_throughput_root" name="Warehouse Throughput Monitor" sequence="4"
              web_icon="sf_warehouse_throughput,static/description/icon.png"/>
    <menuitem id="menu_sf_warehouse_throughput_main" name="Records"
              parent="menu_sf_warehouse_throughput_root" action="action_sf_warehouse_throughput" sequence="10"/>

    <record id="wave_final_sf_warehouse_throughput" model="ir.actions.server">
        <field name="name">Refresh Business Data</field>
        <field name="model_id" ref="model_sf_warehouse_throughput"/>
        <field name="binding_model_id" ref="model_sf_warehouse_throughput"/>
        <field name="state">code</field>
        <field name="code">records.action_refresh_business()</field>
    </record>
</odoo>
