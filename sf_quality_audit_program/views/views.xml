<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_quality_audit_program" model="ir.actions.act_window">
        <field name="name">Quality Audit Program</field>
        <field name="res_model">sf.quality_audit_program</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
    <record id="view_sf_quality_audit_program_form" model="ir.ui.view">
        <field name="name">sf.quality_audit_program.form</field>
        <field name="model">sf.quality_audit_program</field>
        <field name="arch" type="xml">
            <form string="Quality Audit Program">
                <header>
                    <button name="action_submitted" type="object" string="Submitted"
                            class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="audit_title"/>
                            <field name="audit_type"/>
                            <field name="planned_date"/>
                            <field name="auditor_id"/>
                            <field name="findings_count"/>
                            <field name="capa_ref"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_quality_audit_program_list" model="ir.ui.view">
        <field name="name">sf.quality_audit_program.list</field>
        <field name="model">sf.quality_audit_program</field>
        <field name="arch" type="xml">
            <list string="Quality Audit Program" sample="1">
                <field name="audit_title"/>
                <field name="audit_type"/>
                <field name="planned_date"/>
                <field name="auditor_id"/>
                <field name="findings_count"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state in ('submitted','approved')"/>
            </list>
        </field>
    </record>
    <record id="view_sf_quality_audit_program_kanban" model="ir.ui.view">
        <field name="name">sf.quality_audit_program.kanban</field>
        <field name="model">sf.quality_audit_program</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_view" group_by="state">
                <field name="name"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <menuitem id="menu_sf_quality_audit_program_root" name="Quality Audit Program" sequence="7"
              web_icon="sf_quality_audit_program,static/description/icon.png"/>
    <menuitem id="menu_sf_quality_audit_program_main" name="Records"
              parent="menu_sf_quality_audit_program_root" action="action_sf_quality_audit_program" sequence="10"/>
</odoo>
