<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_quality_audit_program" model="ir.module.category">
        <field name="name">Quality Audit Program</field>
        <field name="sequence">364</field>
    </record>
    <record id="group_quality_audit_program_user" model="res.groups">
        <field name="name">Quality Audit Program User</field>
        <field name="category_id" ref="module_category_quality_audit_program"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>

    </record>
    <record id="group_quality_audit_program_manager" model="res.groups">
        <field name="name">Quality Audit Program Manager</field>
        <field name="category_id" ref="module_category_quality_audit_program"/>
        <field name="implied_ids" eval="[(4, ref('group_quality_audit_program_user'))]"/>
    </record>
    <record id="rule_quality_audit_program_sf_quality_audit_program" model="ir.rule">
        <field name="name">Quality Audit Program: multi-company</field>
        <field name="model_id" ref="model_sf_quality_audit_program"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_quality_audit_program"/>
    </record>
</odoo>
