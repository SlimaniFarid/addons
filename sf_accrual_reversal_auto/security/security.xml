<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_accrual_reversal_auto" model="ir.module.category">
        <field name="name">Automatic Accrual Reversal</field>
        <field name="sequence">183</field>
    </record>
    <record id="group_accrual_reversal_auto_user" model="res.groups">
        <field name="name">Automatic Accrual Reversal User</field>
        <field name="category_id" ref="module_category_accrual_reversal_auto"/>

    </record>
    <record id="group_accrual_reversal_auto_manager" model="res.groups">
        <field name="name">Automatic Accrual Reversal Manager</field>
        <field name="category_id" ref="module_category_accrual_reversal_auto"/>
        <field name="implied_ids" eval="[(4, ref('group_accrual_reversal_auto_user'))]"/>
    </record>
    <record id="rule_accrual_reversal_auto_sf_accrual_reversal_auto" model="ir.rule">
        <field name="name">Automatic Accrual Reversal: multi-company</field>
        <field name="model_id" ref="model_sf_accrual_reversal_auto"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_accrual_reversal_auto"/>
    </record>
</odoo>
