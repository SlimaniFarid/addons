<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_accrual_reversal_auto" model="ir.actions.act_window">
        <field name="name">Automatic Accrual Reversal</field>
        <field name="res_model">sf.accrual_reversal_auto</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
    <record id="view_sf_accrual_reversal_auto_form" model="ir.ui.view">
        <field name="name">sf.accrual_reversal_auto.form</field>
        <field name="model">sf.accrual_reversal_auto</field>
        <field name="arch" type="xml">
            <form string="Automatic Accrual Reversal">
                <header>

                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="accrual_ref"/>
                            <field name="period"/>
                            <field name="reversal_period"/>
                            <field name="amount"/>
                            <field name="auto_reversed"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_accrual_reversal_auto_list" model="ir.ui.view">
        <field name="name">sf.accrual_reversal_auto.list</field>
        <field name="model">sf.accrual_reversal_auto</field>
        <field name="arch" type="xml">
            <list string="Automatic Accrual Reversal" sample="1">
                <field name="accrual_ref"/>
                <field name="period"/>
                <field name="reversal_period"/>
                <field name="amount"/>
                <field name="auto_reversed"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state in ('submitted','approved')"/>
            </list>
        </field>
    </record>
    <record id="view_sf_accrual_reversal_auto_kanban" model="ir.ui.view">
        <field name="name">sf.accrual_reversal_auto.kanban</field>
        <field name="model">sf.accrual_reversal_auto</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_view" group_by="state">
                <field name="name"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <menuitem id="menu_sf_accrual_reversal_auto_root" name="Automatic Accrual Reversal" sequence="18"
              web_icon="sf_accrual_reversal_auto,static/description/icon.png"/>
    <menuitem id="menu_sf_accrual_reversal_auto_main" name="Records"
              parent="menu_sf_accrual_reversal_auto_root" action="action_sf_accrual_reversal_auto" sequence="10"/>
</odoo>
