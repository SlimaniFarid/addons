<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_tax_deadline" model="ir.actions.act_window">
        <field name="name">Tax Deadline Calendar</field>
        <field name="res_model">sf.tax.deadline</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
    <record id="view_sf_tax_deadline_form" model="ir.ui.view">
        <field name="name">sf.tax.deadline.form</field>
        <field name="model">sf.tax.deadline</field>
        <field name="arch" type="xml">
            <form string="Tax Deadline Calendar">
                <header>
                    <button name="action_prepared" type="object" string="Prepared"
                            class="btn-primary"/>
                    <button name="action_filed" type="object" string="Filed"
                            class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="open,prepared,filed,paid"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="obligation"/>
                            <field name="due_date"/>
                            <field name="period_label"/>
                            <field name="responsible_id"/>
                            <field name="amount_estimate"/>
                            <field name="notes"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_tax_deadline_list" model="ir.ui.view">
        <field name="name">sf.tax.deadline.list</field>
        <field name="model">sf.tax.deadline</field>
        <field name="arch" type="xml">
            <list string="Tax Deadline Calendar" sample="1">
                <field name="obligation"/>
                <field name="due_date"/>
                <field name="period_label"/>
                <field name="responsible_id"/>
                <field name="amount_estimate"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state in ('submitted','approved')"/>
            </list>
        </field>
    </record>
    <record id="view_sf_tax_deadline_kanban" model="ir.ui.view">
        <field name="name">sf.tax.deadline.kanban</field>
        <field name="model">sf.tax.deadline</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_view" group_by="state">
                <field name="name"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <menuitem id="menu_sf_tax_deadline_root" name="Tax Deadline Calendar" sequence="9"
              web_icon="sf_tax_deadline_calendar,static/description/icon.png"/>
    <menuitem id="menu_sf_tax_deadline_main" name="Records"
              parent="menu_sf_tax_deadline_root" action="action_sf_tax_deadline" sequence="10"/>
</odoo>
