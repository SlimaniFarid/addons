<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_tax_deadline_calendar" model="ir.module.category">
        <field name="name">Tax Deadline Calendar</field>
        <field name="sequence">58</field>
    </record>
    <record id="group_tax_deadline_calendar_user" model="res.groups">
        <field name="name">Tax Deadline Calendar User</field>
        <field name="category_id" ref="module_category_tax_deadline_calendar"/>

    </record>
    <record id="group_tax_deadline_calendar_manager" model="res.groups">
        <field name="name">Tax Deadline Calendar Manager</field>
        <field name="category_id" ref="module_category_tax_deadline_calendar"/>
        <field name="implied_ids" eval="[(4, ref('group_tax_deadline_calendar_user'))]"/>
    </record>
    <record id="rule_tax_deadline_calendar_sf_tax_deadline" model="ir.rule">
        <field name="name">Tax Deadline: multi-company</field>
        <field name="model_id" ref="model_sf_tax_deadline"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_tax_deadline_calendar"/>
    </record>
</odoo>
