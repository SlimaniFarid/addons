<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_customer_care_escalation_rules3" model="ir.module.category">
        <field name="name">Escalation Rules</field>
        <field name="sequence">656</field>
    </record>
    <record id="group_customer_care_escalation_rules3_user" model="res.groups">
        <field name="name">Escalation Rules User</field>
        <field name="category_id" ref="module_category_customer_care_escalation_rules3"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>

    </record>
    <record id="group_customer_care_escalation_rules3_manager" model="res.groups">
        <field name="name">Escalation Rules Manager</field>
        <field name="category_id" ref="module_category_customer_care_escalation_rules3"/>
        <field name="implied_ids" eval="[(4, ref('group_customer_care_escalation_rules3_user'))]"/>
    </record>
    <record id="rule_customer_care_escalation_rules3_sf_customer_care_escalation_rules3" model="ir.rule">
        <field name="name">Escalation Rules: multi-company</field>
        <field name="model_id" ref="model_sf_customer_care_escalation_rules3"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_customer_care_escalation_rules3"/>
    </record>
</odoo>
