<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_zone_capacity_monitor" model="ir.module.category">
        <field name="name">Warehouse Zone Capacity Monitor</field>
        <field name="sequence">31</field>
    </record>
    <record id="group_zone_capacity_monitor_user" model="res.groups">
        <field name="name">Warehouse Zone Capacity Monitor User</field>
        <field name="category_id" ref="module_category_zone_capacity_monitor"/>
        <field name="implied_ids" eval="[(4, ref('stock.group_stock_user'))]"/>

    </record>
    <record id="group_zone_capacity_monitor_manager" model="res.groups">
        <field name="name">Warehouse Zone Capacity Monitor Manager</field>
        <field name="category_id" ref="module_category_zone_capacity_monitor"/>
        <field name="implied_ids" eval="[(4, ref('group_zone_capacity_monitor_user'))]"/>
    </record>
    <record id="rule_zone_capacity_monitor_sf_zone_capacity" model="ir.rule">
        <field name="name">Zone Capacity: multi-company</field>
        <field name="model_id" ref="model_sf_zone_capacity"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
