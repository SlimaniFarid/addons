<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_zone_capacity" model="ir.actions.act_window">
        <field name="name">Warehouse Zone Capacity Monitor</field>
        <field name="res_model">sf.zone.capacity</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
    <record id="view_sf_zone_capacity_form" model="ir.ui.view">
        <field name="name">sf.zone.capacity.form</field>
        <field name="model">sf.zone.capacity</field>
        <field name="arch" type="xml">
            <form string="Warehouse Zone Capacity Monitor">
                <header>
                    <button name="action_critical" type="object" string="Critical"
                            class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="open,critical,resolved"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="zone_name"/>
                            <field name="max_pallets"/>
                            <field name="current_pallets"/>
                            <field name="occupancy_percent"/>
                            <field name="relocation_note"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_zone_capacity_list" model="ir.ui.view">
        <field name="name">sf.zone.capacity.list</field>
        <field name="model">sf.zone.capacity</field>
        <field name="arch" type="xml">
            <list string="Warehouse Zone Capacity Monitor" sample="1">
                <field name="zone_name"/>
                <field name="max_pallets"/>
                <field name="current_pallets"/>
                <field name="occupancy_percent"/>
                <field name="relocation_note"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state in ('submitted','approved')"/>
            </list>
        </field>
    </record>
    <record id="view_sf_zone_capacity_kanban" model="ir.ui.view">
        <field name="name">sf.zone.capacity.kanban</field>
        <field name="model">sf.zone.capacity</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_view" group_by="state">
                <field name="name"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <menuitem id="menu_sf_zone_capacity_root" name="Warehouse Zone Capacity Monitor" sequence="24"
              web_icon="sf_zone_capacity_monitor,static/description/icon.png"/>
    <menuitem id="menu_sf_zone_capacity_main" name="Records"
              parent="menu_sf_zone_capacity_root" action="action_sf_zone_capacity" sequence="10"/>
</odoo>
