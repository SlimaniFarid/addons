<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_rtv_order" model="ir.actions.act_window">
        <field name="name">RTV Orders</field>
        <field name="res_model">sf.rtv.order</field>
        <field name="view_mode">kanban,list,form,kanban</field>
        <field name="context">{'search_default_group_by_state': 1}</field>
    </record>

    <record id="view_sf_rtv_order_form" model="ir.ui.view">
        <field name="name">sf.rtv.order.form</field>
        <field name="model">sf.rtv.order</field>
        <field name="arch" type="xml">
            <form string="RTV Order">
                <header>
                    <button name="action_confirm" type="object"
                            string="Confirm" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_create_return_picking" type="object"
                            string="Create Return Picking" class="btn-primary"
                            invisible="state != 'confirmed'"/>
                    <button name="action_settle" type="object"
                            string="Settle (Debit Note)"
                            invisible="state != 'shipped'"/>
                    <button name="action_close" type="object" string="Close"
                            invisible="state != 'settled'"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state in ('settled','closed','cancelled')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,confirmed,shipped,settled,closed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_create_return_picking"
                                type="object" class="oe_stat_button"
                                icon="fa-truck" invisible="not return_picking_id">
                            <field name="return_picking_id" widget="statinfo"
                                   string="Return Picking"/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="vendor_id" readonly="state != 'draft'"/>
                            <field name="reason" readonly="state != 'draft'"/>
                            <field name="origin_picking_id"
                                   readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="requested_date"/>
                            <field name="authorization_ref"/>
                            <field name="debit_note_ref"/>
                            <field name="total_value" readonly="1"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <group string="Description / Defect Details">
                        <field name="description"/>
                    </group>
                    <notebook>
                        <page string="RTV Lines" name="lines">
                            <field name="line_ids" readonly="state not in ('draft','confirmed')">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="product_id"/>
                                    <field name="lot_id"
                                           context="{'default_product_id': product_id}"/>
                                    <field name="location_id"/>
                                    <field name="quantity"/>
                                    <field name="unit_cost"/>
                                    <field name="subtotal" readonly="1"/>
                                    <field name="disposition"/>
                                    <field name="notes"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_rtv_order_list" model="ir.ui.view">
        <field name="name">sf.rtv.order.list</field>
        <field name="model">sf.rtv.order</field>
        <field name="arch" type="xml">
            <list string="RTV Orders" sample="1">
                <field name="name"/>
                <field name="vendor_id"/>
                <field name="reason"/>
                <field name="requested_date"/>
                <field name="total_value"/>
                <field name="state" widget="badge"
                       decoration-success="state in ('settled','closed')"
                       decoration-muted="state == 'cancelled'"/>
            </list>
        </field>
    </record>

    <menuitem id="menu_sf_rtv_root" name="Return to Vendor" sequence="38"
              parent="stock.menu_stock_root"/>
    <menuitem id="menu_sf_rtv_orders" name="RTV Orders"
              parent="menu_sf_rtv_root" action="action_sf_rtv_order"
              sequence="10"/>

    <record id="view_sf_return_to_vendor_boost_kanban" model="ir.ui.view">
        <field name="name">sf_return_to_vendor.boost.kanban</field>
        <field name="model">sf.rtv.order</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" t-att-color="state">
                <field name="name"/>
                <field name="state"/>
                <field name="user_id"/>

                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_card oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title">
                                    <field name="name"/></strong>
                                <div class="o_kanban_record_subtitle">
                                    <field name="user_id" widget="many2one_avatar_user"/>
                                    <field name="create_date"/></div>
                            </div>
                            <div class="oe_kanban_bottom_right">
                                <field name="state" widget="badge"
                                       t-attf-options="{'classes_map': {'draft': 'info', 'done': 'success', 'cancelled': 'danger'}, 'domain': []}"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_sf_return_to_vendor_boost_search" model="ir.ui.view">
        <field name="name">sf_return_to_vendor.boost.search</field>
        <field name="model">sf.rtv.order</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
<separator/>
                <filter string="My records" name="my_records" domain="[('user_id', '=', uid)]"/>
                <filter string="To Do" name="todo" domain="[('state', 'not in', ('done', 'cancelled', 'closed'))]"/>
                <group expand="0" string="Group By"><filter string="Status" name="gb_state" context="{'group_by': 'state'}"/></group>
            </search>
        </field>
    </record>

    <record id="wave_final_sf_return_to_vendor" model="ir.actions.server">
        <field name="name">Refresh Business Data</field>
        <field name="model_id" ref="model_sf_rtv_order"/>
        <field name="binding_model_id" ref="model_sf_rtv_order"/>
        <field name="state">code</field>
        <field name="code">records.action_refresh_business()</field>
    </record>
</odoo>
