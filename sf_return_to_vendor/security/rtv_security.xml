<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_sf_rtv" model="ir.module.category">
        <field name="name">Return to Vendor</field>
        <field name="sequence">88</field>
    </record>
    <record id="group_sf_rtv_user" model="res.groups">
        <field name="name">RTV User</field>
        <field name="category_id" ref="module_category_sf_rtv"/>
        <field name="implied_ids" eval="[(4, ref('stock.group_stock_user'))]"/>
    </record>
    <record id="group_sf_rtv_manager" model="res.groups">
        <field name="name">RTV Manager</field>
        <field name="category_id" ref="module_category_sf_rtv"/>
        <field name="implied_ids" eval="[(4, ref('group_sf_rtv_user'))]"/>
    </record>
    <record id="rule_sf_rtv_company" model="ir.rule">
        <field name="name">RTV Order: multi-company</field>
        <field name="model_id" ref="model_sf_rtv_order"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_sf_rtv_line_company" model="ir.rule">
        <field name="name">RTV Line: multi-company</field>
        <field name="model_id" ref="model_sf_rtv_line"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
