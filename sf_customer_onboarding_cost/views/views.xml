<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_customer_onboarding_cost" model="ir.actions.act_window">
        <field name="name">Customer Onboarding Cost Tracker</field>
        <field name="res_model">sf.customer_onboarding_cost</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
    <record id="view_sf_customer_onboarding_cost_form" model="ir.ui.view">
        <field name="name">sf.customer_onboarding_cost.form</field>
        <field name="model">sf.customer_onboarding_cost</field>
        <field name="arch" type="xml">
            <form string="Customer Onboarding Cost Tracker">
                <header>
                    <button name="action_submitted" type="object" string="Submitted"
                            class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="setup_hours"/>
                            <field name="training_hours"/>
                            <field name="hourly_rate"/>
                            <field name="total_cost"/>
                            <field name="notes"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_customer_onboarding_cost_list" model="ir.ui.view">
        <field name="name">sf.customer_onboarding_cost.list</field>
        <field name="model">sf.customer_onboarding_cost</field>
        <field name="arch" type="xml">
            <list string="Customer Onboarding Cost Tracker" sample="1">
                <field name="partner_id"/>
                <field name="setup_hours"/>
                <field name="training_hours"/>
                <field name="hourly_rate"/>
                <field name="total_cost"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state in ('submitted','approved')"/>
            </list>
        </field>
    </record>
    <record id="view_sf_customer_onboarding_cost_kanban" model="ir.ui.view">
        <field name="name">sf.customer_onboarding_cost.kanban</field>
        <field name="model">sf.customer_onboarding_cost</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_view" group_by="state">
                <field name="name"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <menuitem id="menu_sf_customer_onboarding_cost_root" name="Customer Onboarding Cost Tracker" sequence="23"
              web_icon="sf_customer_onboarding_cost,static/description/icon.png"/>
    <menuitem id="menu_sf_customer_onboarding_cost_main" name="Records"
              parent="menu_sf_customer_onboarding_cost_root" action="action_sf_customer_onboarding_cost" sequence="10"/>

    <record id="wave_final_sf_customer_onboarding_cost" model="ir.actions.server">
        <field name="name">Refresh Business Data</field>
        <field name="model_id" ref="model_sf_customer_onboarding_cost"/>
        <field name="binding_model_id" ref="model_sf_customer_onboarding_cost"/>
        <field name="state">code</field>
        <field name="code">records.action_refresh_business()</field>
    </record>
</odoo>
