<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_customer_onboarding_cost" model="ir.module.category">
        <field name="name">Customer Onboarding Cost Tracker</field>
        <field name="sequence">378</field>
    </record>
    <record id="group_customer_onboarding_cost_user" model="res.groups">
        <field name="name">Customer Onboarding Cost Tracker User</field>
        <field name="category_id" ref="module_category_customer_onboarding_cost"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>

    </record>
    <record id="group_customer_onboarding_cost_manager" model="res.groups">
        <field name="name">Customer Onboarding Cost Tracker Manager</field>
        <field name="category_id" ref="module_category_customer_onboarding_cost"/>
        <field name="implied_ids" eval="[(4, ref('group_customer_onboarding_cost_user'))]"/>
    </record>
    <record id="rule_customer_onboarding_cost_sf_customer_onboarding_cost" model="ir.rule">
        <field name="name">Customer Onboarding Cost Tracker: multi-company</field>
        <field name="model_id" ref="model_sf_customer_onboarding_cost"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_customer_onboarding_cost"/>
    </record>
</odoo>
