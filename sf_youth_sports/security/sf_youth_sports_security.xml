<?xml version="1.0" ?>
<odoo>
    <record id="module_category_sf_youth_sports" model="ir.module.category">
        <field name="name">Youth Sports League &amp; Club Management</field>
        <field name="description">Youth sports club: registrations, teams, seasons, matches, certificates, family portal</field>
        <field name="sequence">10</field>
    </record>
    <record id="group_sf_youth_sports_user" model="res.groups">
        <field name="name">Youth Sports / User</field>
        <field name="category_id" ref="module_category_sf_youth_sports"/>
    </record>
    <record id="group_sf_youth_sports_manager" model="res.groups">
        <field name="name">Youth Sports / Manager</field>
        <field name="category_id" ref="module_category_sf_youth_sports"/>
        <field name="implied_ids" eval="[(4, ref('sf_youth_sports.group_sf_youth_sports_user'))]"/>
    </record>
    <record id="group_sf_youth_sports_coach" model="res.groups">
        <field name="name">Youth Sports / Coach</field>
        <field name="category_id" ref="module_category_sf_youth_sports"/>
        <field name="implied_ids" eval="[(4, ref('sf_youth_sports.group_sf_youth_sports_user'))]"/>
    </record>
    <record id="group_sf_youth_sports_referee" model="res.groups">
        <field name="name">Youth Sports / Referee</field>
        <field name="category_id" ref="module_category_sf_youth_sports"/>
        <field name="implied_ids" eval="[(4, ref('sf_youth_sports.group_sf_youth_sports_user'))]"/>
    </record>
</odoo>