<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_inventory_accuracy_rate" model="ir.module.category">
        <field name="name">Inventory Accuracy KPI</field>
        <field name="sequence">194</field>
    </record>
    <record id="group_inventory_accuracy_rate_user" model="res.groups">
        <field name="name">Inventory Accuracy KPI User</field>
        <field name="category_id" ref="module_category_inventory_accuracy_rate"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>

    </record>
    <record id="group_inventory_accuracy_rate_manager" model="res.groups">
        <field name="name">Inventory Accuracy KPI Manager</field>
        <field name="category_id" ref="module_category_inventory_accuracy_rate"/>
        <field name="implied_ids" eval="[(4, ref('group_inventory_accuracy_rate_user'))]"/>
    </record>
    <record id="rule_inventory_accuracy_rate_sf_inventory_accuracy_rate" model="ir.rule">
        <field name="name">Inventory Accuracy KPI: multi-company</field>
        <field name="model_id" ref="model_sf_inventory_accuracy_rate"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
