<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_product_margin_matrix" model="ir.actions.act_window">
        <field name="name">Product Margin Matrix</field>
        <field name="res_model">sf.product_margin_matrix</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
    <record id="view_sf_product_margin_matrix_form" model="ir.ui.view">
        <field name="name">sf.product_margin_matrix.form</field>
        <field name="model">sf.product_margin_matrix</field>
        <field name="arch" type="xml">
            <form string="Product Margin Matrix">
                <header>
                    <button name="action_submitted" type="object" string="Submitted"
                            class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="product_id"/>
                            <field name="margin_percent"/>
                            <field name="volume_class"/>
                            <field name="recommended_action"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_product_margin_matrix_list" model="ir.ui.view">
        <field name="name">sf.product_margin_matrix.list</field>
        <field name="model">sf.product_margin_matrix</field>
        <field name="arch" type="xml">
            <list string="Product Margin Matrix" sample="1">
                <field name="product_id"/>
                <field name="margin_percent"/>
                <field name="volume_class"/>
                <field name="recommended_action"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state in ('submitted','approved')"/>
            </list>
        </field>
    </record>
    <record id="view_sf_product_margin_matrix_kanban" model="ir.ui.view">
        <field name="name">sf.product_margin_matrix.kanban</field>
        <field name="model">sf.product_margin_matrix</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_view" group_by="state">
                <field name="name"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <menuitem id="menu_sf_product_margin_matrix_root" name="Product Margin Matrix" sequence="3"
              web_icon="sf_product_margin_matrix,static/description/icon.png"/>
    <menuitem id="menu_sf_product_margin_matrix_main" name="Records"
              parent="menu_sf_product_margin_matrix_root" action="action_sf_product_margin_matrix" sequence="10"/>
</odoo>
