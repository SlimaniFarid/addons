<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_sales_hiring_funnel" model="ir.module.category">
        <field name="name">Sales Hiring Funnel</field>
        <field name="sequence">497</field>
    </record>
    <record id="group_sales_hiring_funnel_user" model="res.groups">
        <field name="name">Sales Hiring Funnel User</field>
        <field name="category_id" ref="module_category_sales_hiring_funnel"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>

    </record>
    <record id="group_sales_hiring_funnel_manager" model="res.groups">
        <field name="name">Sales Hiring Funnel Manager</field>
        <field name="category_id" ref="module_category_sales_hiring_funnel"/>
        <field name="implied_ids" eval="[(4, ref('group_sales_hiring_funnel_user'))]"/>
    </record>
    <record id="rule_sales_hiring_funnel_sf_sales_hiring_funnel" model="ir.rule">
        <field name="name">Sales Hiring Funnel: multi-company</field>
        <field name="model_id" ref="model_sf_sales_hiring_funnel"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
