<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_energy_saving_tracker" model="ir.module.category">
        <field name="name">Energy Saving Initiative Tracker</field>
        <field name="sequence">164</field>
    </record>
    <record id="group_energy_saving_tracker_user" model="res.groups">
        <field name="name">Energy Saving Initiative Tracker User</field>
        <field name="category_id" ref="module_category_energy_saving_tracker"/>

    </record>
    <record id="group_energy_saving_tracker_manager" model="res.groups">
        <field name="name">Energy Saving Initiative Tracker Manager</field>
        <field name="category_id" ref="module_category_energy_saving_tracker"/>
        <field name="implied_ids" eval="[(4, ref('group_energy_saving_tracker_user'))]"/>
    </record>
    <record id="rule_energy_saving_tracker_sf_energy_saving_tracker" model="ir.rule">
        <field name="name">Energy Saving Initiative Tracker: multi-company</field>
        <field name="model_id" ref="model_sf_energy_saving_tracker"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
