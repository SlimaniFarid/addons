<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_supplier_leadtime_audit" model="ir.module.category">
        <field name="name">Supplier Lead Time Audit</field>
        <field name="sequence">195</field>
    </record>
    <record id="group_supplier_leadtime_audit_user" model="res.groups">
        <field name="name">Supplier Lead Time Audit User</field>
        <field name="category_id" ref="module_category_supplier_leadtime_audit"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>

    </record>
    <record id="group_supplier_leadtime_audit_manager" model="res.groups">
        <field name="name">Supplier Lead Time Audit Manager</field>
        <field name="category_id" ref="module_category_supplier_leadtime_audit"/>
        <field name="implied_ids" eval="[(4, ref('group_supplier_leadtime_audit_user'))]"/>
    </record>
    <record id="rule_supplier_leadtime_audit_sf_supplier_leadtime_audit" model="ir.rule">
        <field name="name">Supplier Lead Time Audit: multi-company</field>
        <field name="model_id" ref="model_sf_supplier_leadtime_audit"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_supplier_leadtime_audit"/>
    </record>
</odoo>
