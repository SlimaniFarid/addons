<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mcp_log_form" model="ir.ui.view">
        <field name="name">mcp.request.log.form</field>
        <field name="model">mcp.request.log</field>
        <field name="arch" type="xml">
            <form string="MCP Request Log" create="false">
                <sheet>
                    <group>
                        <field name="server_id"/>
                        <field name="tool"/>
                        <field name="model"/>
                        <field name="status" widget="badge" decoration-success="status=='success'" decoration-danger="status=='error'" decoration-warning="status=='forbidden'"/>
                        <field name="response_ms"/>
                        <field name="create_date" readonly="1"/>
                    </group>
                    <group string="Parameters">
                        <field name="params" widget="text" readonly="1"/>
                    </group>
                    <group string="Result">
                        <field name="result" widget="text" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_mcp_log_list" model="ir.ui.view">
        <field name="name">mcp.request.log.list</field>
        <field name="model">mcp.request.log</field>
        <field name="arch" type="xml">
            <list string="MCP Request Logs">
                <field name="create_date"/>
                <field name="server_id"/>
                <field name="tool"/>
                <field name="model"/>
                <field name="status" widget="badge" decoration-success="status=='success'" decoration-danger="status=='error'" decoration-warning="status=='forbidden'"/>
                <field name="response_ms"/>
            </list>
        </field>
    </record>

    <record id="view_sf_mcp_server_pro_boost_kanban" model="ir.ui.view">
        <field name="name">sf_mcp_server_pro.boost.kanban</field>
        <field name="model">mcp.request.log</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" t-att-color="state">
                <field name="name"/>
                <field name="state"/>
                <field name="user_id"/>

                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_card oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title">
                                    <field name="name"/></strong>
                                <div class="o_kanban_record_subtitle">
                                    <field name="user_id" widget="many2one_avatar_user"/>
                                    <field name="create_date"/></div>
                            </div>
                            <div class="oe_kanban_bottom_right">
                                <field name="state" widget="badge"
                                       t-attf-options="{'classes_map': {'draft': 'info', 'done': 'success', 'cancelled': 'danger'}, 'domain': []}"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_sf_mcp_server_pro_boost_search" model="ir.ui.view">
        <field name="name">sf_mcp_server_pro.boost.search</field>
        <field name="model">mcp.request.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
<separator/>
                <filter string="My records" name="my_records" domain="[('user_id', '=', uid)]"/>
                <filter string="To Do" name="todo" domain="[('state', 'not in', ('done', 'cancelled', 'closed'))]"/>
                <group expand="0" string="Group By"><filter string="Status" name="gb_state" context="{'group_by': 'state'}"/></group>
            </search>
        </field>
    </record>

    <record id="wave_final_sf_mcp_server_pro" model="ir.actions.server">
        <field name="name">Refresh Business Data</field>
        <field name="model_id" ref="model_mcp_request_log"/>
        <field name="binding_model_id" ref="model_mcp_request_log"/>
        <field name="state">code</field>
        <field name="code">records.action_refresh_business()</field>
    </record>
</odoo>
