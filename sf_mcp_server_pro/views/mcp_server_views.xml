<odoo>
    <record id="action_mcp_server" model="ir.actions.act_window">
        <field name="name">MCP Servers</field>
        <field name="res_model">mcp.server</field>
        <field name="view_mode">kanban,list,form</field>
    </record>

    <record id="action_mcp_token" model="ir.actions.act_window">
        <field name="name">API Tokens</field>
        <field name="res_model">mcp.token</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_mcp_log" model="ir.actions.act_window">
        <field name="name">Request Logs</field>
        <field name="res_model">mcp.request.log</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_mcp_root" name="MCP Server PRO" web_icon="sf_mcp_server_pro,static/description/icon.png"/>
    <menuitem id="menu_mcp_servers" name="Servers" parent="menu_mcp_root" action="action_mcp_server" sequence="10"/>
    <menuitem id="menu_mcp_tokens" name="API Tokens" parent="menu_mcp_root" action="action_mcp_token" sequence="20"/>
    <menuitem id="menu_mcp_logs" name="Request Logs" parent="menu_mcp_root" action="action_mcp_log" sequence="30"/>

    <record id="view_mcp_server_form" model="ir.ui.view">
        <field name="name">mcp.server.form</field>
        <field name="model">mcp.server</field>
        <field name="arch" type="xml">
            <form string="MCP Server">
                <header>
                    <button name="action_activate" string="Activate" type="object" class="btn-primary" invisible="state!='draft'"/>
                    <button name="action_reset" string="Reset" type="object" class="btn-secondary" invisible="state=='draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,ready,error"/>
                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="active"/>
                        <field name="api_key" password="True"/>
                        <field name="max_requests_per_minute"/>
                    </group>
                    <group string="Models">
                        <field name="allowed_models"/>
                    </group>
                    <notebook>
                        <page string="Logs">
                            <field name="log_ids">
                                <list>
                                    <field name="tool"/>
                                    <field name="model"/>
                                    <field name="status"/>
                                    <field name="response_ms"/>
                                    <field name="create_date"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_mcp_server_list" model="ir.ui.view">
        <field name="name">mcp.server.list</field>
        <field name="model">mcp.server</field>
        <field name="arch" type="xml">
            <list string="MCP Servers">
                <field name="name"/>
                <field name="code"/>
                <field name="state" widget="badge" decoration-success="state=='ready'" decoration-danger="state=='error'" decoration-muted="state=='draft'"/>
                <field name="active"/>
                <field name="max_requests_per_minute"/>
            </list>
        </field>
    </record>

    <record id="view_sf_mcp_server_pro_boost_kanban" model="ir.ui.view">
        <field name="name">sf_mcp_server_pro.boost.kanban</field>
        <field name="model">mcp.request.log</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" t-att-color="state">
                <field name="name"/>
                <field name="state"/>
                <field name="user_id"/>

                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_card oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title">
                                    <field name="name"/></strong>
                                <div class="o_kanban_record_subtitle">
                                    <field name="user_id" widget="many2one_avatar_user"/>
                                    <field name="create_date"/></div>
                            </div>
                            <div class="oe_kanban_bottom_right">
                                <field name="state" widget="badge"
                                       t-attf-options="{'classes_map': {'draft': 'info', 'done': 'success', 'cancelled': 'danger'}, 'domain': []}"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_sf_mcp_server_pro_boost_search" model="ir.ui.view">
        <field name="name">sf_mcp_server_pro.boost.search</field>
        <field name="model">mcp.request.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
<separator/>
                <filter string="My records" name="my_records" domain="[('user_id', '=', uid)]"/>
                <filter string="To Do" name="todo" domain="[('state', 'not in', ('done', 'cancelled', 'closed'))]"/>
                <group expand="0" string="Group By"><filter string="Status" name="gb_state" context="{'group_by': 'state'}"/></group>
            </search>
        </field>
    </record>
</odoo>
