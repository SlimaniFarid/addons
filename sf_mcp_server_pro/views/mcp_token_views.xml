<odoo>
    <record id="view_mcp_token_form" model="ir.ui.view">
        <field name="name">mcp.token.form</field>
        <field name="model">mcp.token</field>
        <field name="arch" type="xml">
            <form string="MCP Token">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="server_id" options="{'no_create': True}"/>
                        <field name="active"/>
                        <field name="token" password="True"/>
                        <field name="expires_on"/>
                    </group>
                    <group string="Usage">
                        <field name="use_count" readonly="1"/>
                        <field name="last_used_on" readonly="1"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_rotate" string="Rotate Token" type="object" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_mcp_token_list" model="ir.ui.view">
        <field name="name">mcp.token.list</field>
        <field name="model">mcp.token</field>
        <field name="arch" type="xml">
            <list string="MCP Tokens">
                <field name="name"/>
                <field name="server_id"/>
                <field name="active"/>
                <field name="expires_on"/>
                <field name="use_count"/>
                <field name="last_used_on"/>
            </list>
        </field>
    </record>
</odoo>