<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="module_category_sf_aql_sampling" model="ir.module.category">
            <field name="name">AQL Sampling</field>
            <field name="description">Acceptance Sampling &amp; AQL Inspection Plans.</field>
            <field name="sequence">10</field>
        </record>

        <record id="group_sf_aql_sampling_user" model="res.groups">
            <field name="name">AQL Sampling / User</field>
            <field name="category_id" ref="module_category_sf_aql_sampling"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_sf_aql_sampling_manager" model="res.groups">
            <field name="name">AQL Sampling / Manager</field>
            <field name="category_id" ref="module_category_sf_aql_sampling"/>
            <field name="implied_ids" eval="[(4, ref('sf_aql_sampling.group_sf_aql_sampling_user'))]"/>
        </record>

        <record id="rule_sf_aql_plan_company" model="ir.rule">
            <field name="name">AQL Plan: user sees own company</field>
            <field name="model_id" ref="model_sf_aql_plan"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('sf_aql_sampling.group_sf_aql_sampling_user'))]"/>
        </record>
        <record id="rule_sf_aql_plan_manager_all" model="ir.rule">
            <field name="name">AQL Plan: manager sees all companies</field>
            <field name="model_id" ref="model_sf_aql_plan"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('sf_aql_sampling.group_sf_aql_sampling_manager'))]"/>
        </record>

        <record id="rule_sf_aql_inspection_company" model="ir.rule">
            <field name="name">AQL Inspection: user sees own company</field>
            <field name="model_id" ref="model_sf_aql_inspection"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('sf_aql_sampling.group_sf_aql_sampling_user'))]"/>
        </record>
        <record id="rule_sf_aql_inspection_manager_all" model="ir.rule">
            <field name="name">AQL Inspection: manager sees all companies</field>
            <field name="model_id" ref="model_sf_aql_inspection"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('sf_aql_sampling.group_sf_aql_sampling_manager'))]"/>
        </record>

        <record id="rule_sf_aql_defect_company" model="ir.rule">
            <field name="name">AQL Defect: user sees own company</field>
            <field name="model_id" ref="model_sf_aql_defect"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('sf_aql_sampling.group_sf_aql_sampling_user'))]"/>
        </record>
        <record id="rule_sf_aql_defect_manager_all" model="ir.rule">
            <field name="name">AQL Defect: manager sees all companies</field>
            <field name="model_id" ref="model_sf_aql_defect"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('sf_aql_sampling.group_sf_aql_sampling_manager'))]"/>
        </record>
    </data>
</odoo>