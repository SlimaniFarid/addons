<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sf_aql_inspection_view_list" model="ir.ui.view">
        <field name="name">sf.aql.inspection.list</field>
        <field name="model">sf.aql.inspection</field>
        <field name="arch" type="xml">
            <list string="Lot Inspections">
                <field name="name"/>
                <field name="product_id"/>
                <field name="lot_id"/>
                <field name="partner_id"/>
                <field name="source"/>
                <field name="lot_quantity"/>
                <field name="sample_size"/>
                <field name="decision" widget="badge"/>
                <field name="state" widget="badge"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="sf_aql_inspection_view_form" model="ir.ui.view">
        <field name="name">sf.aql.inspection.form</field>
        <field name="model">sf.aql.inspection</field>
        <field name="arch" type="xml">
            <form string="Lot Inspection">
                <header>
                    <button name="action_start" string="Start" type="object" class="btn-primary" invisible="[('state', '!=', 'draft')]"/>
                    <button name="action_complete" string="Complete" type="object" class="btn-primary" invisible="[('state', '!=', 'in_progress')]"/>
                    <button name="action_release" string="Release" type="object" class="btn-primary" invisible="[('state', '!=', 'completed')]"/>
                    <button name="action_reject" string="Reject" type="object" invisible="[('state', '!=', 'completed')]"/>
                    <button name="action_cancel" string="Cancel" type="object" invisible="[('state', 'in', ('released', 'rejected', 'cancelled'))]"/>
                    <field name="state" widget="statusbar" readonly="1"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="product_id"/>
                            <field name="lot_id"/>
                            <field name="partner_id"/>
                            <field name="source"/>
                        </group>
                        <group>
                            <field name="inspection_level"/>
                            <field name="lot_quantity"/>
                            <field name="plan_id"/>
                            <field name="sample_size"/>
                            <field name="inspection_date"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group string="Decision">
                        <field name="critical_defects"/>
                        <field name="weighted_defects"/>
                        <field name="decision"/>
                    </group>
                    <notebook>
                        <page string="Defects">
                            <field name="defect_ids">
                                <list string="Defects">
                                    <field name="defect_code"/>
                                    <field name="severity"/>
                                    <field name="quantity"/>
                                    <field name="description"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                    <group>
                        <field name="notes"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="sf_aql_inspection_view_search" model="ir.ui.view">
        <field name="name">sf.aql.inspection.search</field>
        <field name="model">sf.aql.inspection</field>
        <field name="arch" type="xml">
            <search string="Lot Inspections">
                <field name="name"/>
                <field name="product_id"/>
                <field name="partner_id"/>
                <filter name="inspection_rejected" string="Rejected" domain="[('decision', '=', 'rejected')]"/>
                <filter name="inspection_pending" string="Pending" domain="[('state', 'in', ('draft', 'in_progress'))]"/>
                <group>
                    <filter name="group_inspection_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_inspection_source" string="Source" context="{'group_by': 'source'}"/>
                    <filter name="group_inspection_product" string="Product" context="{'group_by': 'product_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_sf_aql_inspection" model="ir.actions.act_window">
        <field name="name">Lot Inspections</field>
        <field name="res_model">sf.aql.inspection</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="sf_aql_inspection_view_search"/>
    </record>

    <record id="view_sf_aql_sampling_boost_kanban" model="ir.ui.view">
        <field name="name">sf_aql_sampling.boost.kanban</field>
        <field name="model">sf.aql.defect</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" t-att-color="state">
                <field name="name"/>
                <field name="state"/>
                <field name="user_id"/>

                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_card oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title">
                                    <field name="name"/></strong>
                                <div class="o_kanban_record_subtitle">
                                    <field name="user_id" widget="many2one_avatar_user"/>
                                    <field name="create_date"/></div>
                            </div>
                            <div class="oe_kanban_bottom_right">
                                <field name="state" widget="badge"
                                       t-attf-options="{'classes_map': {'draft': 'info', 'done': 'success', 'cancelled': 'danger'}, 'domain': []}"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_sf_aql_sampling_boost_search" model="ir.ui.view">
        <field name="name">sf_aql_sampling.boost.search</field>
        <field name="model">sf.aql.defect</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
<separator/>
                <filter string="My records" name="my_records" domain="[('user_id', '=', uid)]"/>
                <filter string="To Do" name="todo" domain="[('state', 'not in', ('done', 'cancelled', 'closed'))]"/>
                <group expand="0" string="Group By"><filter string="Status" name="gb_state" context="{'group_by': 'state'}"/></group>
            </search>
        </field>
    </record>
</odoo>
