<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_aql_inspection">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-set="company" t-value="o.company_id or res_company"/>
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>AQL Inspection Report</h2>
                        <table class="table table-sm">
                            <tr><th>Inspection</th><td><span t-field="o.name"/></td></tr>
                            <tr><th>Product</th><td><span t-field="o.product_id"/></td></tr>
                            <tr><th>Lot</th><td><span t-field="o.lot_id"/></td></tr>
                            <tr><th>Supplier</th><td><span t-field="o.partner_id"/></td></tr>
                            <tr><th>Source</th><td><span t-field="o.source"/></td></tr>
                            <tr><th>Lot Quantity</th><td><span t-field="o.lot_quantity"/></td></tr>
                            <tr><th>Inspection Level</th><td><span t-field="o.inspection_level"/></td></tr>
                            <tr><th>Sampling Plan</th><td><span t-field="o.plan_id"/></td></tr>
                            <tr><th>Sample Size</th><td><span t-field="o.sample_size"/></td></tr>
                            <tr><th>Inspection Date</th><td><span t-field="o.inspection_date"/></td></tr>
                        </table>
                        <h3>Defects</h3>
                        <table class="table table-sm">
                            <tr><th>Code</th><th>Severity</th><th>Quantity</th><th>Description</th></tr>
                            <tr t-foreach="o.defect_ids" t-as="d">
                                <td><span t-field="d.defect_code"/></td>
                                <td><span t-field="d.severity"/></td>
                                <td><span t-field="d.quantity"/></td>
                                <td><span t-field="d.description"/></td>
                            </tr>
                        </table>
                        <table class="table table-sm">
                            <tr><th>Critical Defects</th><td><span t-field="o.critical_defects"/></td></tr>
                            <tr><th>Weighted Defects</th><td><span t-field="o.weighted_defects"/></td></tr>
                            <tr><th>Decision</th><td><span t-field="o.decision"/></td></tr>
                            <tr><th>Status</th><td><span t-field="o.state"/></td></tr>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>