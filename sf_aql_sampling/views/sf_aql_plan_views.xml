<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sf_aql_plan_view_list" model="ir.ui.view">
        <field name="name">sf.aql.plan.list</field>
        <field name="model">sf.aql.plan</field>
        <field name="arch" type="xml">
            <list string="Sampling Plans">
                <field name="name"/>
                <field name="inspection_level"/>
                <field name="lot_size_min"/>
                <field name="lot_size_max"/>
                <field name="sample_size"/>
                <field name="accept_number"/>
                <field name="reject_number"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="sf_aql_plan_view_form" model="ir.ui.view">
        <field name="name">sf.aql.plan.form</field>
        <field name="model">sf.aql.plan</field>
        <field name="arch" type="xml">
            <form string="Sampling Plan">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="inspection_level"/>
                            <field name="lot_size_min"/>
                            <field name="lot_size_max"/>
                        </group>
                        <group>
                            <field name="sample_size"/>
                            <field name="accept_number"/>
                            <field name="reject_number"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="sf_aql_plan_view_search" model="ir.ui.view">
        <field name="name">sf.aql.plan.search</field>
        <field name="model">sf.aql.plan</field>
        <field name="arch" type="xml">
            <search string="Sampling Plans">
                <field name="name"/>
                <field name="inspection_level"/>
                <group>
                    <filter name="group_plan_level" string="Inspection Level" context="{'group_by': 'inspection_level'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_sf_aql_plan" model="ir.actions.act_window">
        <field name="name">Sampling Plans</field>
        <field name="res_model">sf.aql.plan</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="sf_aql_plan_view_search"/>
    </record>
</odoo>