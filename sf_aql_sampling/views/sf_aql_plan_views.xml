<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sf_aql_plan_view_list" model="ir.ui.view">
        <field name="name">sf.aql.plan.list</field>
        <field name="model">sf.aql.plan</field>
        <field name="arch" type="xml">
            <list string="Sampling Plans">
                <field name="name"/>
                <field name="inspection_level"/>
                <field name="lot_size_min"/>
                <field name="lot_size_max"/>
                <field name="sample_size"/>
                <field name="accept_number"/>
                <field name="reject_number"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="sf_aql_plan_view_form" model="ir.ui.view">
        <field name="name">sf.aql.plan.form</field>
        <field name="model">sf.aql.plan</field>
        <field name="arch" type="xml">
            <form string="Sampling Plan">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="inspection_level"/>
                            <field name="lot_size_min"/>
                            <field name="lot_size_max"/>
                        </group>
                        <group>
                            <field name="sample_size"/>
                            <field name="accept_number"/>
                            <field name="reject_number"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="sf_aql_plan_view_search" model="ir.ui.view">
        <field name="name">sf.aql.plan.search</field>
        <field name="model">sf.aql.plan</field>
        <field name="arch" type="xml">
            <search string="Sampling Plans">
                <field name="name"/>
                <field name="inspection_level"/>
                <group>
                    <filter name="group_plan_level" string="Inspection Level" context="{'group_by': 'inspection_level'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_sf_aql_plan" model="ir.actions.act_window">
        <field name="name">Sampling Plans</field>
        <field name="res_model">sf.aql.plan</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="sf_aql_plan_view_search"/>
    </record>

    <record id="view_sf_aql_sampling_boost_kanban" model="ir.ui.view">
        <field name="name">sf_aql_sampling.boost.kanban</field>
        <field name="model">sf.aql.defect</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" t-att-color="state">
                <field name="name"/>
                <field name="state"/>
                <field name="user_id"/>

                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_card oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title">
                                    <field name="name"/></strong>
                                <div class="o_kanban_record_subtitle">
                                    <field name="user_id" widget="many2one_avatar_user"/>
                                    <field name="create_date"/></div>
                            </div>
                            <div class="oe_kanban_bottom_right">
                                <field name="state" widget="badge"
                                       t-attf-options="{'classes_map': {'draft': 'info', 'done': 'success', 'cancelled': 'danger'}, 'domain': []}"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_sf_aql_sampling_boost_search" model="ir.ui.view">
        <field name="name">sf_aql_sampling.boost.search</field>
        <field name="model">sf.aql.defect</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
<separator/>
                <filter string="My records" name="my_records" domain="[('user_id', '=', uid)]"/>
                <filter string="To Do" name="todo" domain="[('state', 'not in', ('done', 'cancelled', 'closed'))]"/>
                <group expand="0" string="Group By"><filter string="Status" name="gb_state" context="{'group_by': 'state'}"/></group>
            </search>
        </field>
    </record>
</odoo>
