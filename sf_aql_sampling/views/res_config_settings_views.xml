<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_aql_sampling" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.aql.sampling</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="AQL Sampling" string="AQL Sampling" name="sf_aql_sampling">
                    <block title="AQL Sampling Settings">
                        <setting string="Default Inspection Level">
                            <field name="sf_aql_default_inspection_level"/>
                        </setting>
                        <setting string="Weight defects by severity">
                            <field name="sf_aql_enable_weighted_defects"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>