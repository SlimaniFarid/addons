<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_sales_capacity_model" model="ir.module.category">
        <field name="name">Sales Capacity Modeling</field>
        <field name="sequence">296</field>
    </record>
    <record id="group_sales_capacity_model_user" model="res.groups">
        <field name="name">Sales Capacity Modeling User</field>
        <field name="category_id" ref="module_category_sales_capacity_model"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>

    </record>
    <record id="group_sales_capacity_model_manager" model="res.groups">
        <field name="name">Sales Capacity Modeling Manager</field>
        <field name="category_id" ref="module_category_sales_capacity_model"/>
        <field name="implied_ids" eval="[(4, ref('group_sales_capacity_model_user'))]"/>
    </record>
    <record id="rule_sales_capacity_model_sf_sales_capacity_model" model="ir.rule">
        <field name="name">Sales Capacity Modeling: multi-company</field>
        <field name="model_id" ref="model_sf_sales_capacity_model"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
