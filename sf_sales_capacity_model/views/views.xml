<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_sales_capacity_model" model="ir.actions.act_window">
        <field name="name">Sales Capacity Modeling</field>
        <field name="res_model">sf.sales_capacity_model</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
    <record id="view_sf_sales_capacity_model_form" model="ir.ui.view">
        <field name="name">sf.sales_capacity_model.form</field>
        <field name="model">sf.sales_capacity_model</field>
        <field name="arch" type="xml">
            <form string="Sales Capacity Modeling">
                <header>
                    <button name="action_submitted" type="object" string="Submitted"
                            class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="period"/>
                            <field name="current_reps"/>
                            <field name="ramp_months"/>
                            <field name="target_revenue"/>
                            <field name="reps_needed"/>
                            <field name="hiring_plan"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_sales_capacity_model_list" model="ir.ui.view">
        <field name="name">sf.sales_capacity_model.list</field>
        <field name="model">sf.sales_capacity_model</field>
        <field name="arch" type="xml">
            <list string="Sales Capacity Modeling" sample="1">
                <field name="period"/>
                <field name="current_reps"/>
                <field name="ramp_months"/>
                <field name="target_revenue"/>
                <field name="reps_needed"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state in ('submitted','approved')"/>
            </list>
        </field>
    </record>
    <record id="view_sf_sales_capacity_model_kanban" model="ir.ui.view">
        <field name="name">sf.sales_capacity_model.kanban</field>
        <field name="model">sf.sales_capacity_model</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_view" group_by="state">
                <field name="name"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <menuitem id="menu_sf_sales_capacity_model_root" name="Sales Capacity Modeling" sequence="5"
              web_icon="sf_sales_capacity_model,static/description/icon.png"/>
    <menuitem id="menu_sf_sales_capacity_model_main" name="Records"
              parent="menu_sf_sales_capacity_model_root" action="action_sf_sales_capacity_model" sequence="10"/>

    <record id="wave_final_sf_sales_capacity_model" model="ir.actions.server">
        <field name="name">Refresh Business Data</field>
        <field name="model_id" ref="model_sf_sales_capacity_model"/>
        <field name="binding_model_id" ref="model_sf_sales_capacity_model"/>
        <field name="state">code</field>
        <field name="code">records.action_refresh_business()</field>
    </record>
</odoo>
