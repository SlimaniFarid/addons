<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="report_bia" model="ir.actions.report">
        <field name="name">Business Impact Analysis (BIA)</field>
        <field name="model">sf.bcp.process</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">sf_business_continuity.report_bia_template</field>
        <field name="report_file">sf_business_continuity.report_bia_template</field>
        <field name="binding_model_id" ref="model_sf_bcp_process"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_bia_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>Business Impact Analysis</h2>
                        <p>
                            Company: <strong><t t-esc="o.company_id.name"/></strong>
                        </p>
                        <table class="table table-sm">
                            <tr><td><strong>Process</strong></td><td><t t-esc="o.name"/></td></tr>
                            <tr><td><strong>Department</strong></td><td><t t-esc="o.department_id or ''"/></td></tr>
                            <tr><td><strong>Criticality</strong></td><td><t t-esc="o.criticality"/></td></tr>
                            <tr><td><strong>RTO (hours)</strong></td><td><t t-esc="o.rto or ''"/></td></tr>
                            <tr><td><strong>RPO (hours)</strong></td><td><t t-esc="o.rpo or ''"/></td></tr>
                            <tr><td><strong>Financial impact</strong></td><td><t t-esc="o.impact or ''"/></td></tr>
                            <tr><td><strong>Dependencies</strong></td><td><t t-esc="o.dependencies or ''"/></td></tr>
                            <tr><td><strong>Status</strong></td><td><t t-esc="o.state"/></td></tr>
                        </table>
                        <t t-if="o.strategy_ids">
                            <h4>Continuity Strategies</h4>
                            <table class="table table-sm">
                                <thead>
                                    <tr>
                                        <th>Strategy</th>
                                        <th>Type</th>
                                        <th>Detail</th>
                                        <th>Cost</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="o.strategy_ids" t-as="s">
                                        <tr>
                                            <td><t t-esc="s.name"/></td>
                                            <td><t t-esc="s.strategy_type"/></td>
                                            <td><t t-esc="s.detail or ''"/></td>
                                            <td><t t-esc="s.cost or ''"/></td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </t>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <record id="report_recovery_plan" model="ir.actions.report">
        <field name="name">Recovery Plan</field>
        <field name="model">sf.bcp.plan</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">sf_business_continuity.report_recovery_plan_template</field>
        <field name="report_file">sf_business_continuity.report_recovery_plan_template</field>
        <field name="binding_model_id" ref="model_sf_bcp_plan"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_recovery_plan_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>Recovery Plan</h2>
                        <p>
                            Company: <strong><t t-esc="o.company_id.name"/></strong>
                        </p>
                        <table class="table table-sm">
                            <tr><td><strong>Plan</strong></td><td><t t-esc="o.name"/></td></tr>
                            <tr><td><strong>Process</strong></td><td><t t-esc="o.process_id.name"/></td></tr>
                            <tr><td><strong>Version</strong></td><td><t t-esc="o.version or ''"/></td></tr>
                            <tr><td><strong>Owner</strong></td><td><t t-esc="o.owner_id.name if o.owner_id else ''"/></td></tr>
                            <tr><td><strong>Resources</strong></td><td><t t-esc="o.resource_ids or ''"/></td></tr>
                            <tr><td><strong>Published date</strong></td><td><t t-esc="o.published_date or ''"/></td></tr>
                            <tr><td><strong>Last review date</strong></td><td><t t-esc="o.last_review_date or ''"/></td></tr>
                            <tr><td><strong>Next review date</strong></td><td><t t-esc="o.next_review_date or ''"/></td></tr>
                            <tr><td><strong>Status</strong></td><td><t t-esc="o.state"/></td></tr>
                        </table>
                        <t t-if="o.summary">
                            <h4>Summary</h4>
                            <div><t t-raw="o.summary"/></div>
                        </t>
                        <t t-if="o.steps">
                            <h4>Recovery Steps</h4>
                            <div><t t-raw="o.steps"/></div>
                        </t>
                        <t t-if="o.exercise_ids">
                            <h4>Exercises</h4>
                            <table class="table table-sm">
                                <thead>
                                    <tr>
                                        <th>Exercise</th>
                                        <th>Date</th>
                                        <th>Participants</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="o.exercise_ids" t-as="e">
                                        <tr>
                                            <td><t t-esc="e.name"/></td>
                                            <td><t t-esc="e.exercise_date or ''"/></td>
                                            <td><t t-esc="e.participants or ''"/></td>
                                            <td><t t-esc="e.state"/></td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </t>
                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>