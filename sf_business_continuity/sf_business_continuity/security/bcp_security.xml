<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_bcp" model="ir.module.category">
        <field name="name">Business Continuity</field>
        <field name="sequence">90</field>
    </record>

    <record id="group_bcp_user" model="res.groups">
        <field name="name">Business Continuity User</field>
        <field name="category_id" ref="module_category_bcp"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_bcp_manager" model="res.groups">
        <field name="name">Business Continuity Manager</field>
        <field name="category_id" ref="module_category_bcp"/>
        <field name="implied_ids" eval="[(4, ref('group_bcp_user'))]"/>
    </record>

    <record id="rule_bcp_process_user_company" model="ir.rule">
        <field name="name">Process: user sees own company</field>
        <field name="model_id" ref="model_sf_bcp_process"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_bcp_user'))]"/>
    </record>

    <record id="rule_bcp_strategy_user_company" model="ir.rule">
        <field name="name">Strategy: user sees own company</field>
        <field name="model_id" ref="model_sf_bcp_strategy"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_bcp_user'))]"/>
    </record>

    <record id="rule_bcp_plan_user_company" model="ir.rule">
        <field name="name">Plan: user sees own company</field>
        <field name="model_id" ref="model_sf_bcp_plan"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_bcp_user'))]"/>
    </record>

    <record id="rule_bcp_exercise_user_company" model="ir.rule">
        <field name="name">Exercise: user sees own company</field>
        <field name="model_id" ref="model_sf_bcp_exercise"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_bcp_user'))]"/>
    </record>

    <record id="rule_bcp_process_manager_all" model="ir.rule">
        <field name="name">Process: manager sees all companies</field>
        <field name="model_id" ref="model_sf_bcp_process"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_bcp_manager'))]"/>
    </record>

    <record id="rule_bcp_strategy_manager_all" model="ir.rule">
        <field name="name">Strategy: manager sees all companies</field>
        <field name="model_id" ref="model_sf_bcp_strategy"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_bcp_manager'))]"/>
    </record>

    <record id="rule_bcp_plan_manager_all" model="ir.rule">
        <field name="name">Plan: manager sees all companies</field>
        <field name="model_id" ref="model_sf_bcp_plan"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_bcp_manager'))]"/>
    </record>

    <record id="rule_bcp_exercise_manager_all" model="ir.rule">
        <field name="name">Exercise: manager sees all companies</field>
        <field name="model_id" ref="model_sf_bcp_exercise"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_bcp_manager'))]"/>
    </record>
</odoo>