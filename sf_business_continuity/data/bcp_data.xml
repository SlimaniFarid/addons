<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_bcp_process" model="ir.sequence">
            <field name="name">BCP Process</field>
            <field name="code">sf.bcp.process</field>
            <field name="prefix">BCP-</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>

        <record id="seq_bcp_strategy" model="ir.sequence">
            <field name="name">BCP Strategy</field>
            <field name="code">sf.bcp.strategy</field>
            <field name="prefix">STR-</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>

        <record id="seq_bcp_plan" model="ir.sequence">
            <field name="name">BCP Recovery Plan</field>
            <field name="code">sf.bcp.plan</field>
            <field name="prefix">PLN-</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>

        <record id="seq_bcp_exercise" model="ir.sequence">
            <field name="name">BCP Exercise</field>
            <field name="code">sf.bcp.exercise</field>
            <field name="prefix">EXE-</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>

        <record id="cron_bcp_check_reviews" model="ir.cron">
            <field name="name">Business Continuity: Plan Review Alerts</field>
            <field name="model_id" ref="model_sf_bcp_plan"/>
            <field name="state">code</field>
            <field name="code">model._check_bcp_reviews()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="active">True</field>
        </record>
    </data>
</odoo>