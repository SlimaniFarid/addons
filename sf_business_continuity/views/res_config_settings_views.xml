<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_bcp" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.bcp</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="50"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Business Continuity" string="Business Continuity" name="business_continuity">
                    <block title="Plan Reviews" id="bcp_review">
                        <setting id="bcp_review_days" help="Number of days between the publication or last review of a recovery plan and its next scheduled review reminder.">
                            <field name="sf_bcp_review_days"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>