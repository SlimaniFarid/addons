<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============ PROCESS / BIA ============ -->
    <record id="view_bcp_process_tree" model="ir.ui.view">
        <field name="name">sf.bcp.process.tree</field>
        <field name="model">sf.bcp.process</field>
        <field name="arch" type="xml">
            <tree string="Critical Processes" decoration-danger="criticality == 'critical'" decoration-warning="criticality == 'important'">
                <field name="name"/>
                <field name="department_id"/>
                <field name="criticality"/>
                <field name="rto"/>
                <field name="rpo"/>
                <field name="impact"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <record id="view_bcp_process_form" model="ir.ui.view">
        <field name="name">sf.bcp.process.form</field>
        <field name="model">sf.bcp.process</field>
        <field name="arch" type="xml">
            <form string="Critical Process / BIA">
                <header>
                    <button name="action_assess" type="object"
                            string="Assess" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_validate" type="object"
                            string="Validate" class="btn-success"
                            groups="sf_business_continuity.group_bcp_manager"
                            invisible="state != 'assessed'"/>
                    <button name="action_archive" type="object"
                            string="Archive" class="btn-secondary"
                            invisible="state != 'validated'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="department_id"/>
                            <field name="criticality"/>
                        </group>
                        <group>
                            <field name="rto"/>
                            <field name="rpo"/>
                            <field name="impact"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <field name="dependencies"/>
                    <notebook>
                        <page string="Strategies">
                            <field name="strategy_ids" readonly="state in ('archived',)">
                                <tree string="Strategies" editable="bottom">
                                    <field name="name"/>
                                    <field name="strategy_type"/>
                                    <field name="detail"/>
                                    <field name="cost"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Recovery Plans">
                            <field name="plan_ids" readonly="1">
                                <tree string="Recovery Plans">
                                    <field name="name"/>
                                    <field name="version"/>
                                    <field name="state"/>
                                    <field name="next_review_date"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_bcp_process_search" model="ir.ui.view">
        <field name="name">sf.bcp.process.search</field>
        <field name="model">sf.bcp.process</field>
        <field name="arch" type="xml">
            <search string="Critical Processes">
                <field name="name"/>
                <field name="department_id"/>
                <field name="criticality"/>
                <filter string="Critical" name="critical"
                        domain="[('criticality', '=', 'critical')]"/>
                <filter string="Assessed" name="assessed"
                        domain="[('state', '=', 'assessed')]"/>
                <filter string="Validated" name="validated"
                        domain="[('state', '=', 'validated')]"/>
                <group>
                    <filter string="Criticality" name="criticality_group"
                            context="{'group_by': 'criticality'}"/>
                    <filter string="Status" name="state_group"
                            context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_bcp_process_kanban" model="ir.ui.view">
        <field name="name">sf.bcp.process.kanban</field>
        <field name="model">sf.bcp.process</field>
        <field name="arch" type="xml">
            <kanban default_group_by="criticality">
                <field name="name"/>
                <field name="department_id"/>
                <field name="criticality"/>
                <field name="rto"/>
                <field name="rpo"/>
                <field name="state"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_record_title">
                                <field name="name"/>
                            </div>
                            <div class="o_kanban_record_subtitle">
                                <field name="department_id"/>
                                <field name="criticality"/>
                            </div>
                            <div class="o_kanban_record_bottom">
                                RTO: <field name="rto"/>h &#8212; RPO: <field name="rpo"/>h &#8212; <field name="state"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_bcp_process" model="ir.actions.act_window">
        <field name="name">Critical Processes &amp; BIA</field>
        <field name="res_model">sf.bcp.process</field>
        <field name="view_mode">tree,kanban,form</field>
        <field name="search_view_id" ref="view_bcp_process_search"/>
    </record>

    <!-- ============ STRATEGY ============ -->
    <record id="view_bcp_strategy_tree" model="ir.ui.view">
        <field name="name">sf.bcp.strategy.tree</field>
        <field name="model">sf.bcp.strategy</field>
        <field name="arch" type="xml">
            <tree string="Continuity Strategies">
                <field name="name"/>
                <field name="process_id"/>
                <field name="strategy_type"/>
                <field name="detail"/>
                <field name="cost"/>
            </tree>
        </field>
    </record>

    <record id="view_bcp_strategy_form" model="ir.ui.view">
        <field name="name">sf.bcp.strategy.form</field>
        <field name="model">sf.bcp.strategy</field>
        <field name="arch" type="xml">
            <form string="Continuity Strategy">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="process_id"/>
                            <field name="strategy_type"/>
                        </group>
                        <group>
                            <field name="cost"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <field name="detail"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_bcp_strategy_search" model="ir.ui.view">
        <field name="name">sf.bcp.strategy.search</field>
        <field name="model">sf.bcp.strategy</field>
        <field name="arch" type="xml">
            <search string="Continuity Strategies">
                <field name="name"/>
                <field name="process_id"/>
                <field name="strategy_type"/>
                <group>
                    <filter string="Type" name="type_group"
                            context="{'group_by': 'strategy_type'}"/>
                    <filter string="Process" name="process_group"
                            context="{'group_by': 'process_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_bcp_strategy_kanban" model="ir.ui.view">
        <field name="name">sf.bcp.strategy.kanban</field>
        <field name="model">sf.bcp.strategy</field>
        <field name="arch" type="xml">
            <kanban default_group_by="strategy_type">
                <field name="name"/>
                <field name="process_id"/>
                <field name="strategy_type"/>
                <field name="cost"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_record_title">
                                <field name="name"/>
                            </div>
                            <div class="o_kanban_record_subtitle">
                                <field name="process_id"/>
                                <field name="strategy_type"/>
                            </div>
                            <div class="o_kanban_record_bottom">
                                Cost: <field name="cost"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_bcp_strategy" model="ir.actions.act_window">
        <field name="name">Continuity Strategies</field>
        <field name="res_model">sf.bcp.strategy</field>
        <field name="view_mode">tree,kanban,form</field>
        <field name="search_view_id" ref="view_bcp_strategy_search"/>
    </record>

    <!-- ============ PLAN ============ -->
    <record id="view_bcp_plan_tree" model="ir.ui.view">
        <field name="name">sf.bcp.plan.tree</field>
        <field name="model">sf.bcp.plan</field>
        <field name="arch" type="xml">
            <tree string="Recovery Plans">
                <field name="name"/>
                <field name="process_id"/>
                <field name="version"/>
                <field name="owner_id"/>
                <field name="published_date"/>
                <field name="last_review_date"/>
                <field name="next_review_date"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <record id="view_bcp_plan_form" model="ir.ui.view">
        <field name="name">sf.bcp.plan.form</field>
        <field name="model">sf.bcp.plan</field>
        <field name="arch" type="xml">
            <form string="Recovery Plan">
                <header>
                    <button name="action_publish" type="object"
                            string="Publish" class="btn-primary"
                            groups="sf_business_continuity.group_bcp_manager"
                            invisible="state != 'draft'"/>
                    <button name="action_mark_tested" type="object"
                            string="Mark Tested" class="btn-warning"
                            invisible="state != 'published'"/>
                    <button name="action_update" type="object"
                            string="Update" class="btn-success"
                            invisible="state != 'tested'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="process_id"/>
                            <field name="version"/>
                        </group>
                        <group>
                            <field name="owner_id"/>
                            <field name="resource_ids"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <field name="summary"/>
                    <field name="steps"/>
                    <group>
                        <group>
                            <field name="published_date" readonly="1"/>
                            <field name="last_review_date"/>
                        </group>
                        <group>
                            <field name="next_review_date" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Exercises">
                            <field name="exercise_ids">
                                <tree string="Exercises" editable="bottom">
                                    <field name="name"/>
                                    <field name="exercise_date"/>
                                    <field name="state"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_bcp_plan_search" model="ir.ui.view">
        <field name="name">sf.bcp.plan.search</field>
        <field name="model">sf.bcp.plan</field>
        <field name="arch" type="xml">
            <search string="Recovery Plans">
                <field name="name"/>
                <field name="process_id"/>
                <field name="owner_id"/>
                <filter string="Review due" name="review_due"
                        domain="[('state', '!=', 'draft'), ('next_review_date', '!=', False), ('next_review_date', '&lt;=', '__date_today__')]"/>
                <filter string="Published" name="published"
                        domain="[('state', '=', 'published')]"/>
                <group>
                    <filter string="Status" name="state_group"
                            context="{'group_by': 'state'}"/>
                    <filter string="Process" name="process_group"
                            context="{'group_by': 'process_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_bcp_plan_kanban" model="ir.ui.view">
        <field name="name">sf.bcp.plan.kanban</field>
        <field name="model">sf.bcp.plan</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state">
                <field name="name"/>
                <field name="process_id"/>
                <field name="version"/>
                <field name="next_review_date"/>
                <field name="state"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_record_title">
                                <field name="name"/>
                            </div>
                            <div class="o_kanban_record_subtitle">
                                <field name="process_id"/>
                            </div>
                            <div class="o_kanban_record_bottom">
                                Next review: <field name="next_review_date"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_bcp_plan" model="ir.actions.act_window">
        <field name="name">Recovery Plans</field>
        <field name="res_model">sf.bcp.plan</field>
        <field name="view_mode">tree,kanban,form</field>
        <field name="search_view_id" ref="view_bcp_plan_search"/>
    </record>

    <!-- ============ EXERCISE ============ -->
    <record id="view_bcp_exercise_tree" model="ir.ui.view">
        <field name="name">sf.bcp.exercise.tree</field>
        <field name="model">sf.bcp.exercise</field>
        <field name="arch" type="xml">
            <tree string="Exercises &amp; Tests">
                <field name="name"/>
                <field name="plan_id"/>
                <field name="exercise_date"/>
                <field name="participants"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <record id="view_bcp_exercise_form" model="ir.ui.view">
        <field name="name">sf.bcp.exercise.form</field>
        <field name="model">sf.bcp.exercise</field>
        <field name="arch" type="xml">
            <form string="Exercise / Test">
                <header>
                    <button name="action_execute" type="object"
                            string="Execute" class="btn-primary"
                            invisible="state != 'planned'"/>
                    <button name="action_done" type="object"
                            string="Mark Done" class="btn-success"
                            invisible="state != 'executed'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="plan_id"/>
                            <field name="exercise_date"/>
                        </group>
                        <group>
                            <field name="participants"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <field name="scenario"/>
                    <field name="objectives"/>
                    <field name="results"/>
                    <field name="findings"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_bcp_exercise_search" model="ir.ui.view">
        <field name="name">sf.bcp.exercise.search</field>
        <field name="model">sf.bcp.exercise</field>
        <field name="arch" type="xml">
            <search string="Exercises &amp; Tests">
                <field name="name"/>
                <field name="plan_id"/>
                <field name="exercise_date"/>
                <filter string="Done" name="done"
                        domain="[('state', '=', 'done')]"/>
                <filter string="Open" name="open"
                        domain="[('state', 'in', ('planned', 'executed'))]"/>
                <group>
                    <filter string="Status" name="state_group"
                            context="{'group_by': 'state'}"/>
                    <filter string="Plan" name="plan_group"
                            context="{'group_by': 'plan_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_bcp_exercise_kanban" model="ir.ui.view">
        <field name="name">sf.bcp.exercise.kanban</field>
        <field name="model">sf.bcp.exercise</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state">
                <field name="name"/>
                <field name="plan_id"/>
                <field name="exercise_date"/>
                <field name="participants"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_record_title">
                                <field name="name"/>
                            </div>
                            <div class="o_kanban_record_subtitle">
                                <field name="plan_id"/>
                                <field name="exercise_date"/>
                            </div>
                            <div class="o_kanban_record_bottom">
                                Participants: <field name="participants"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_bcp_exercise" model="ir.actions.act_window">
        <field name="name">Exercises &amp; Tests</field>
        <field name="res_model">sf.bcp.exercise</field>
        <field name="view_mode">tree,kanban,form</field>
        <field name="search_view_id" ref="view_bcp_exercise_search"/>
    </record>

    <!-- ============ DASHBOARD ============ -->
    <record id="view_bcp_dashboard_pivot" model="ir.ui.view">
        <field name="name">sf.bcp.process.dashboard.pivot.criticality</field>
        <field name="model">sf.bcp.process</field>
        <field name="arch" type="xml">
            <pivot string="Processes by Criticality">
                <field name="criticality" type="row"/>
                <field name="id" type="measure" string="Processes"/>
            </pivot>
        </field>
    </record>

    <record id="view_bcp_dashboard_graph" model="ir.ui.view">
        <field name="name">sf.bcp.process.dashboard.graph.criticality</field>
        <field name="model">sf.bcp.process</field>
        <field name="arch" type="xml">
            <graph string="Processes by Criticality">
                <field name="criticality"/>
                <field name="id" type="measure" string="Processes"/>
            </graph>
        </field>
    </record>

    <record id="action_bcp_dashboard" model="ir.actions.act_window">
        <field name="name">Business Continuity Dashboard</field>
        <field name="res_model">sf.bcp.process</field>
        <field name="view_mode">pivot,graph</field>
        <field name="view_ids" eval="[(5, 0), (0, 0, {'view_mode': 'pivot', 'view_id': ref('view_bcp_dashboard_pivot')}), (0, 0, {'view_mode': 'graph', 'view_id': ref('view_bcp_dashboard_graph')})]"/>
    </record>

</odoo>