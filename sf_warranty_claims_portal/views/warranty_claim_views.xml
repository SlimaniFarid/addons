<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_warranty_claim_list" model="ir.ui.view">
        <field name="name">sf.warranty.claims.portal.warranty.claim.list</field>
        <field name="model">sf.warranty.claims.portal.warranty.claim</field>
        <field name="arch" type="xml">
            <list string="Warranty.Claim">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="product_id"/>
                <field name="lot_id"/>
                <field name="claim_date"/>
                <field name="description"/>
                <field name="state" widget="badge"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_warranty_claim_form" model="ir.ui.view">
        <field name="name">sf.warranty.claims.portal.warranty.claim.form</field>
        <field name="model">sf.warranty.claims.portal.warranty.claim</field>
        <field name="arch" type="xml">
            <form string="Warranty.Claim">
                <header>
                <field name="state" widget="badge"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" placeholder="Name"/></h1></div>
                    <group><group>
                            <field name="name"/>
                            <field name="partner_id"/>
                            <field name="product_id"/>
                            <field name="lot_id"/>
                            <field name="claim_date"/>
                            <field name="description"/>
                            <field name="sla_deadline"/>
                            <field name="state"/>
                    </group>
                    <group>
                        <field name="currency_id" invisible="1"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_warranty_claim" model="ir.actions.act_window">
        <field name="name">Warranty.Claim</field>
        <field name="res_model">sf.warranty.claims.portal.warranty.claim</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
