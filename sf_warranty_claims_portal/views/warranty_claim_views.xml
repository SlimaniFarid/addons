<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_warranty_claim_list" model="ir.ui.view">
        <field name="name">sf.warranty.claims.portal.warranty.claim.list</field>
        <field name="model">sf.warranty.claims.portal.warranty.claim</field>
        <field name="arch" type="xml">
            <list string="Warranty.Claim">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="product_id"/>
                <field name="lot_id"/>
                <field name="claim_date"/>
                <field name="description"/>
                <field name="state" widget="badge"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_warranty_claim_form" model="ir.ui.view">
        <field name="name">sf.warranty.claims.portal.warranty.claim.form</field>
        <field name="model">sf.warranty.claims.portal.warranty.claim</field>
        <field name="arch" type="xml">
            <form string="Warranty.Claim">
                <header>
                <field name="state" widget="badge"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" placeholder="Name"/></h1></div>
                    <group><group>
                            <field name="name"/>
                            <field name="partner_id"/>
                            <field name="product_id"/>
                            <field name="lot_id"/>
                            <field name="claim_date"/>
                            <field name="description"/>
                            <field name="sla_deadline"/>
                            <field name="state"/>
                    </group>
                    <group>
                        <field name="currency_id" invisible="1"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_warranty_claim" model="ir.actions.act_window">
        <field name="name">Warranty.Claim</field>
        <field name="res_model">sf.warranty.claims.portal.warranty.claim</field>
        <field name="view_mode">kanban,list,form</field>
    </record>

    <record id="view_sf_warranty_claims_portal_boost_kanban" model="ir.ui.view">
        <field name="name">sf_warranty_claims_portal.boost.kanban</field>
        <field name="model">sf.warranty.claims.portal.warranty.claim</field>
        <field name="arch" type="xml">
            <kanban default_group_by="">
                <field name="name"/>
                <field name="user_id"/>

                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_card oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong>
                                <div><field name="user_id"
                                            widget="many2one_avatar_user"/></div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_sf_warranty_claims_portal_boost_search" model="ir.ui.view">
        <field name="name">sf_warranty_claims_portal.boost.search</field>
        <field name="model">sf.warranty.claims.portal.warranty.claim</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
<separator/>
                <filter string="My records" name="my_records" domain="[('user_id', '=', uid)]"/>
            </search>
        </field>
    </record>

    <record id="wave_final_sf_warranty_claims_portal" model="ir.actions.server">
        <field name="name">Refresh Business Data</field>
        <field name="model_id" ref="model_sf_warranty_claims_portal_warranty_claim"/>
        <field name="binding_model_id" ref="model_sf_warranty_claims_portal_warranty_claim"/>
        <field name="state">code</field>
        <field name="code">records.action_refresh_business()</field>
    </record>
</odoo>
