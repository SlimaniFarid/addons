<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_sf_ppv" model="ir.module.category">
        <field name="name">Purchase Price Analysis</field>
        <field name="sequence">87</field>
    </record>
    <record id="group_sf_ppv_user" model="res.groups">
        <field name="name">PPV Analysis User</field>
        <field name="category_id" ref="module_category_sf_ppv"/>
        <field name="implied_ids" eval="[(4, ref('purchase.group_purchase_user'))]"/>
    </record>
    <record id="group_sf_ppv_manager" model="res.groups">
        <field name="name">PPV Analysis Manager</field>
        <field name="category_id" ref="module_category_sf_ppv"/>
        <field name="implied_ids" eval="[(4, ref('group_sf_ppv_user'))]"/>
    </record>
    <record id="rule_sf_ppv_company" model="ir.rule">
        <field name="name">PPV Analysis: multi-company</field>
        <field name="model_id" ref="model_sf_ppv_analysis"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
