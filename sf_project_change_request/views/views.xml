<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_project_change_request" model="ir.actions.act_window">
        <field name="name">Project Change Request</field>
        <field name="res_model">sf.project_change_request</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
    <record id="view_sf_project_change_request_form" model="ir.ui.view">
        <field name="name">sf.project_change_request.form</field>
        <field name="model">sf.project_change_request</field>
        <field name="arch" type="xml">
            <form string="Project Change Request">
                <header>
                    <button name="action_submitted" type="object" string="Submitted"
                            class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="project_name"/>
                            <field name="change_description"/>
                            <field name="cost_impact"/>
                            <field name="schedule_impact_days"/>
                            <field name="requested_by_id"/>
                            <field name="approver_id"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_project_change_request_list" model="ir.ui.view">
        <field name="name">sf.project_change_request.list</field>
        <field name="model">sf.project_change_request</field>
        <field name="arch" type="xml">
            <list string="Project Change Request" sample="1">
                <field name="project_name"/>
                <field name="change_description"/>
                <field name="cost_impact"/>
                <field name="schedule_impact_days"/>
                <field name="requested_by_id"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state in ('submitted','approved')"/>
            </list>
        </field>
    </record>
    <record id="view_sf_project_change_request_kanban" model="ir.ui.view">
        <field name="name">sf.project_change_request.kanban</field>
        <field name="model">sf.project_change_request</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_view" group_by="state">
                <field name="name"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <menuitem id="menu_sf_project_change_request_root" name="Project Change Request" sequence="5"
              web_icon="sf_project_change_request,static/description/icon.png"/>
    <menuitem id="menu_sf_project_change_request_main" name="Records"
              parent="menu_sf_project_change_request_root" action="action_sf_project_change_request" sequence="10"/>

    <record id="wave_final_sf_project_change_request" model="ir.actions.server">
        <field name="name">Refresh Business Data</field>
        <field name="model_id" ref="model_sf_project_change_request"/>
        <field name="binding_model_id" ref="model_sf_project_change_request"/>
        <field name="state">code</field>
        <field name="code">records.action_refresh_business()</field>
    </record>
</odoo>
