<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_project_change_request" model="ir.module.category">
        <field name="name">Project Change Request</field>
        <field name="sequence">396</field>
    </record>
    <record id="group_project_change_request_user" model="res.groups">
        <field name="name">Project Change Request User</field>
        <field name="category_id" ref="module_category_project_change_request"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>

    </record>
    <record id="group_project_change_request_manager" model="res.groups">
        <field name="name">Project Change Request Manager</field>
        <field name="category_id" ref="module_category_project_change_request"/>
        <field name="implied_ids" eval="[(4, ref('group_project_change_request_user'))]"/>
    </record>
    <record id="rule_project_change_request_sf_project_change_request" model="ir.rule">
        <field name="name">Project Change Request: multi-company</field>
        <field name="model_id" ref="model_sf_project_change_request"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_project_change_request"/>
    </record>
</odoo>
