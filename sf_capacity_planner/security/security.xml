<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_capacity_planner" model="ir.module.category">
        <field name="name">Team Capacity Planner</field>
        <field name="sequence">171</field>
    </record>
    <record id="group_capacity_planner_user" model="res.groups">
        <field name="name">Team Capacity Planner User</field>
        <field name="category_id" ref="module_category_capacity_planner"/>

    </record>
    <record id="group_capacity_planner_manager" model="res.groups">
        <field name="name">Team Capacity Planner Manager</field>
        <field name="category_id" ref="module_category_capacity_planner"/>
        <field name="implied_ids" eval="[(4, ref('group_capacity_planner_user'))]"/>
    </record>
    <record id="rule_capacity_planner_sf_capacity_planner" model="ir.rule">
        <field name="name">Team Capacity Planner: multi-company</field>
        <field name="model_id" ref="model_sf_capacity_planner"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_capacity_planner"/>
    </record>
</odoo>
