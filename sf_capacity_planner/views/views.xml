<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_capacity_planner" model="ir.actions.act_window">
        <field name="name">Team Capacity Planner</field>
        <field name="res_model">sf.capacity_planner</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
    <record id="view_sf_capacity_planner_form" model="ir.ui.view">
        <field name="name">sf.capacity_planner.form</field>
        <field name="model">sf.capacity_planner</field>
        <field name="arch" type="xml">
            <form string="Team Capacity Planner">
                <header>
                    <button name="action_submitted" type="object" string="Submitted"
                            class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="team_name"/>
                            <field name="period"/>
                            <field name="headcount"/>
                            <field name="available_hours"/>
                            <field name="allocated_hours"/>
                            <field name="over_allocation"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_capacity_planner_list" model="ir.ui.view">
        <field name="name">sf.capacity_planner.list</field>
        <field name="model">sf.capacity_planner</field>
        <field name="arch" type="xml">
            <list string="Team Capacity Planner" sample="1">
                <field name="team_name"/>
                <field name="period"/>
                <field name="headcount"/>
                <field name="available_hours"/>
                <field name="allocated_hours"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state in ('submitted','approved')"/>
            </list>
        </field>
    </record>
    <record id="view_sf_capacity_planner_kanban" model="ir.ui.view">
        <field name="name">sf.capacity_planner.kanban</field>
        <field name="model">sf.capacity_planner</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_view" group_by="state">
                <field name="name"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <menuitem id="menu_sf_capacity_planner_root" name="Team Capacity Planner" sequence="30"
              web_icon="sf_capacity_planner,static/description/icon.png"/>
    <menuitem id="menu_sf_capacity_planner_main" name="Records"
              parent="menu_sf_capacity_planner_root" action="action_sf_capacity_planner" sequence="10"/>
</odoo>
