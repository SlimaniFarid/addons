<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_retention_schedule" model="ir.module.category">
        <field name="name">Data &amp; Document Retention Schedule</field>
        <field name="sequence">63</field>
    </record>
    <record id="group_retention_schedule_user" model="res.groups">
        <field name="name">Data &amp; Document Retention Schedule User</field>
        <field name="category_id" ref="module_category_retention_schedule"/>

    </record>
    <record id="group_retention_schedule_manager" model="res.groups">
        <field name="name">Data &amp; Document Retention Schedule Manager</field>
        <field name="category_id" ref="module_category_retention_schedule"/>
        <field name="implied_ids" eval="[(4, ref('group_retention_schedule_user'))]"/>
    </record>
    <record id="rule_retention_schedule_sf_retention_rule" model="ir.rule">
        <field name="name">Retention Rule: multi-company</field>
        <field name="model_id" ref="model_sf_retention_rule"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
