<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_retention_rule" model="ir.actions.act_window">
        <field name="name">Data &amp; Document Retention Schedule</field>
        <field name="res_model">sf.retention.rule</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
    <record id="view_sf_retention_rule_form" model="ir.ui.view">
        <field name="name">sf.retention.rule.form</field>
        <field name="model">sf.retention.rule</field>
        <field name="arch" type="xml">
            <form string="Data &amp; Document Retention Schedule">
                <header>
                    <button name="action_review" type="object" string="Under Review"
                            class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="active,review,archived"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="doc_type"/>
                            <field name="legal_basis"/>
                            <field name="retention_years"/>
                            <field name="disposal_method"/>
                            <field name="last_review"/>
                            <field name="owner_id"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_retention_rule_list" model="ir.ui.view">
        <field name="name">sf.retention.rule.list</field>
        <field name="model">sf.retention.rule</field>
        <field name="arch" type="xml">
            <list string="Data &amp; Document Retention Schedule" sample="1">
                <field name="doc_type"/>
                <field name="legal_basis"/>
                <field name="retention_years"/>
                <field name="disposal_method"/>
                <field name="last_review"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state in ('submitted','approved')"/>
            </list>
        </field>
    </record>
    <record id="view_sf_retention_rule_kanban" model="ir.ui.view">
        <field name="name">sf.retention.rule.kanban</field>
        <field name="model">sf.retention.rule</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_view" group_by="state">
                <field name="name"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <menuitem id="menu_sf_retention_rule_root" name="Data &amp; Document Retention Schedule" sequence="13"
              web_icon="sf_retention_schedule,static/description/icon.png"/>
    <menuitem id="menu_sf_retention_rule_main" name="Records"
              parent="menu_sf_retention_rule_root" action="action_sf_retention_rule" sequence="10"/>
</odoo>
