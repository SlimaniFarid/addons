<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_supplier_capacity_planner" model="ir.module.category">
        <field name="name">Supplier Capacity Planner</field>
        <field name="sequence">481</field>
    </record>
    <record id="group_supplier_capacity_planner_user" model="res.groups">
        <field name="name">Supplier Capacity Planner User</field>
        <field name="category_id" ref="module_category_supplier_capacity_planner"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>

    </record>
    <record id="group_supplier_capacity_planner_manager" model="res.groups">
        <field name="name">Supplier Capacity Planner Manager</field>
        <field name="category_id" ref="module_category_supplier_capacity_planner"/>
        <field name="implied_ids" eval="[(4, ref('group_supplier_capacity_planner_user'))]"/>
    </record>
    <record id="rule_supplier_capacity_planner_sf_supplier_capacity_planner" model="ir.rule">
        <field name="name">Supplier Capacity Planner: multi-company</field>
        <field name="model_id" ref="model_sf_supplier_capacity_planner"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
