<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_probation_review_tracker" model="ir.module.category">
        <field name="name">Probation Review Tracker</field>
        <field name="sequence">27</field>
    </record>
    <record id="group_probation_review_tracker_user" model="res.groups">
        <field name="name">Probation Review Tracker User</field>
        <field name="category_id" ref="module_category_probation_review_tracker"/>

    </record>
    <record id="group_probation_review_tracker_manager" model="res.groups">
        <field name="name">Probation Review Tracker Manager</field>
        <field name="category_id" ref="module_category_probation_review_tracker"/>
        <field name="implied_ids" eval="[(4, ref('group_probation_review_tracker_user'))]"/>
    </record>
    <record id="rule_probation_review_tracker_sf_probation_review" model="ir.rule">
        <field name="name">Probation Review: multi-company</field>
        <field name="model_id" ref="model_sf_probation_review"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
