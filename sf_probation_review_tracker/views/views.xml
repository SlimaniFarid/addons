<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_probation_review" model="ir.actions.act_window">
        <field name="name">Probation Review Tracker</field>
        <field name="res_model">sf.probation.review</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
    <record id="view_sf_probation_review_form" model="ir.ui.view">
        <field name="name">sf.probation.review.form</field>
        <field name="model">sf.probation.review</field>
        <field name="arch" type="xml">
            <form string="Probation Review Tracker">
                <header>
                    <button name="action_review_scheduled" type="object" string="Review Scheduled"
                            class="btn-primary"/>
                    <button name="action_confirmed" type="object" string="Confirmed"
                            class="btn-primary"/>
                    <button name="action_extended" type="object" string="Extended"
                            class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="in_probation,review_scheduled,confirmed,extended,terminated"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="employee_id"/>
                            <field name="probation_end"/>
                            <field name="review_1_date"/>
                            <field name="review_2_date"/>
                            <field name="outcome"/>
                            <field name="manager_comments"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_probation_review_list" model="ir.ui.view">
        <field name="name">sf.probation.review.list</field>
        <field name="model">sf.probation.review</field>
        <field name="arch" type="xml">
            <list string="Probation Review Tracker" sample="1">
                <field name="employee_id"/>
                <field name="probation_end"/>
                <field name="review_1_date"/>
                <field name="review_2_date"/>
                <field name="outcome"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state in ('submitted','approved')"/>
            </list>
        </field>
    </record>
    <record id="view_sf_probation_review_kanban" model="ir.ui.view">
        <field name="name">sf.probation.review.kanban</field>
        <field name="model">sf.probation.review</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_view" group_by="state">
                <field name="name"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <menuitem id="menu_sf_probation_review_root" name="Probation Review Tracker" sequence="17"
              web_icon="sf_probation_review_tracker,static/description/icon.png"/>
    <menuitem id="menu_sf_probation_review_main" name="Records"
              parent="menu_sf_probation_review_root" action="action_sf_probation_review" sequence="10"/>

    <record id="wave_final_sf_probation_review_tracker" model="ir.actions.server">
        <field name="name">Refresh Business Data</field>
        <field name="model_id" ref="model_sf_probation_review"/>
        <field name="binding_model_id" ref="model_sf_probation_review"/>
        <field name="state">code</field>
        <field name="code">records.action_refresh_business()</field>
    </record>
</odoo>
