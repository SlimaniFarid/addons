<odoo>
    <record id="action_whatsapp_account" model="ir.actions.act_window">
        <field name="name">WhatsApp Accounts</field>
        <field name="res_model">whatsapp.account</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_whatsapp_template" model="ir.actions.act_window">
        <field name="name">Templates</field>
        <field name="res_model">whatsapp.template</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_whatsapp_message" model="ir.actions.act_window">
        <field name="name">Messages</field>
        <field name="res_model">whatsapp.message</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_whatsapp_root" name="WhatsApp Business" web_icon="whatsapp_cloud_api,static/description/icon.png"/>
    <menuitem id="menu_whatsapp_accounts" name="Accounts" parent="menu_whatsapp_root" action="action_whatsapp_account" sequence="10"/>
    <menuitem id="menu_whatsapp_templates" name="Templates" parent="menu_whatsapp_root" action="action_whatsapp_template" sequence="20"/>
    <menuitem id="menu_whatsapp_messages" name="Messages" parent="menu_whatsapp_root" action="action_whatsapp_message" sequence="30"/>

    <record id="view_whatsapp_account_form" model="ir.ui.view">
        <field name="name">whatsapp.account.form</field>
        <field name="model">whatsapp.account</field>
        <field name="arch" type="xml">
            <form string="WhatsApp Account">
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="draft,ready,error"/>
                    <button name="action_test_connection" string="Test Connection" type="object" class="btn-primary"/>
                    <button name="action_fetch_templates" string="Fetch Templates" type="object" class="btn-secondary" invisible="state!='ready'"/>
                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="active"/>
                        <field name="phone_number_id"/>
                        <field name="business_account_id"/>
                        <field name="access_token" password="True" groups="base.group_system"/>
                        <field name="webhook_verify_token" password="True" groups="base.group_system"/>
                        <field name="api_version"/>
                    </group>
                    <group string="Webhook">
                        <field name="webhook_url" readonly="1"/>
                    </group>
                    <notebook>
                        <page string="Templates">
                            <field name="template_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="template_name"/>
                                    <field name="category"/>
                                    <field name="language"/>
                                    <field name="status" widget="badge" decoration-success="status=='approved'" decoration-warning="status=='pending'" decoration-danger="status=='rejected'"/>
                                </list>
                            </field>
                        </page>
                        <page string="Messages">
                            <field name="message_ids">
                                <list>
                                    <field name="to_number"/>
                                    <field name="to_name"/>
                                    <field name="template_id"/>
                                    <field name="status" widget="badge" decoration-success="status=='sent'" decoration-danger="status=='failed'"/>
                                    <field name="create_date"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_whatsapp_account_list" model="ir.ui.view">
        <field name="name">whatsapp.account.list</field>
        <field name="model">whatsapp.account</field>
        <field name="arch" type="xml">
            <list string="WhatsApp Accounts">
                <field name="name"/>
                <field name="phone_number_id"/>
                <field name="state" widget="badge" decoration-success="state=='ready'" decoration-danger="state=='error'" decoration-muted="state=='draft'"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_whatsapp_template_form" model="ir.ui.view">
        <field name="name">whatsapp.template.form</field>
        <field name="model">whatsapp.template</field>
        <field name="arch" type="xml">
            <form string="WhatsApp Template">
                <sheet>
                    <group>
                        <field name="account_id" options="{'no_create': True}"/>
                        <field name="name"/>
                        <field name="template_name"/>
                        <field name="category"/>
                        <field name="language"/>
                        <field name="status" widget="badge" decoration-success="status=='approved'" decoration-warning="status=='pending'" decoration-danger="status=='rejected'"/>
                    </group>
                    <group string="Content">
                        <field name="header_type"/>
                        <field name="body_text"/>
                        <field name="footer_text"/>
                        <field name="button_count"/>
                    </group>
                    <group string="Raw Components">
                        <field name="components" widget="text"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_whatsapp_template_list" model="ir.ui.view">
        <field name="name">whatsapp.template.list</field>
        <field name="model">whatsapp.template</field>
        <field name="arch" type="xml">
            <list string="WhatsApp Templates">
                <field name="account_id"/>
                <field name="name"/>
                <field name="template_name"/>
                <field name="category"/>
                <field name="language"/>
                <field name="status" widget="badge" decoration-success="status=='approved'" decoration-warning="status=='pending'" decoration-danger="status=='rejected'"/>
            </list>
        </field>
    </record>

    <record id="view_whatsapp_message_form" model="ir.ui.view">
        <field name="name">whatsapp.message.form</field>
        <field name="model">whatsapp.message</field>
        <field name="arch" type="xml">
            <form string="WhatsApp Message" create="false" edit="false">
                <header>
                    <field name="status" widget="statusbar" statusbar_visible="draft,queued,sent,delivered,read,failed"/>
                    <button name="action_send" string="Send" type="object" class="btn-primary" invisible="status not in ('draft','failed','queued')"/>
                    <button name="action_retry" string="Retry" type="object" class="btn-secondary" invisible="status!='failed'"/>
                </header>
                <sheet>
                    <group>
                        <field name="account_id"/>
                        <field name="template_id"/>
                        <field name="to_number"/>
                        <field name="to_name"/>
                        <field name="res_model"/>
                        <field name="res_id"/>
                        <field name="direction"/>
                        <field name="status"/>
                        <field name="meta_message_id"/>
                    </group>
                    <group string="Content">
                        <field name="body_text" widget="text" readonly="1"/>
                        <field name="components_sent" widget="text" readonly="1"/>
                    </group>
                    <group string="Error">
                        <field name="error_message" widget="text" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_whatsapp_message_list" model="ir.ui.view">
        <field name="name">whatsapp.message.list</field>
        <field name="model">whatsapp.message</field>
        <field name="arch" type="xml">
            <list string="WhatsApp Messages">
                <field name="create_date"/>
                <field name="account_id"/>
                <field name="to_number"/>
                <field name="to_name"/>
                <field name="template_id"/>
                <field name="direction"/>
                <field name="status" widget="badge" decoration-success="status in ('sent','delivered','read')" decoration-danger="status=='failed'" decoration-warning="status=='queued'" decoration-muted="status=='draft'"/>
            </list>
        </field>
    </record>
</odoo>