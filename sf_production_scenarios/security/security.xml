<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_production_scenarios" model="ir.module.category">
        <field name="name">Production What-If Scenarios</field>
        <field name="sequence">362</field>
    </record>
    <record id="group_production_scenarios_user" model="res.groups">
        <field name="name">Production What-If Scenarios User</field>
        <field name="category_id" ref="module_category_production_scenarios"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>

    </record>
    <record id="group_production_scenarios_manager" model="res.groups">
        <field name="name">Production What-If Scenarios Manager</field>
        <field name="category_id" ref="module_category_production_scenarios"/>
        <field name="implied_ids" eval="[(4, ref('group_production_scenarios_user'))]"/>
    </record>
    <record id="rule_production_scenarios_sf_production_scenarios" model="ir.rule">
        <field name="name">Production What-If Scenarios: multi-company</field>
        <field name="model_id" ref="model_sf_production_scenarios"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
