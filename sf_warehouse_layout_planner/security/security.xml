<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_warehouse_layout_planner" model="ir.module.category">
        <field name="name">Warehouse Layout Planner</field>
        <field name="sequence">686</field>
    </record>
    <record id="group_warehouse_layout_planner_user" model="res.groups">
        <field name="name">Warehouse Layout Planner User</field>
        <field name="category_id" ref="module_category_warehouse_layout_planner"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>

    </record>
    <record id="group_warehouse_layout_planner_manager" model="res.groups">
        <field name="name">Warehouse Layout Planner Manager</field>
        <field name="category_id" ref="module_category_warehouse_layout_planner"/>
        <field name="implied_ids" eval="[(4, ref('group_warehouse_layout_planner_user'))]"/>
    </record>
    <record id="rule_warehouse_layout_planner_sf_warehouse_layout_planner" model="ir.rule">
        <field name="name">Warehouse Layout Planner: multi-company</field>
        <field name="model_id" ref="model_sf_warehouse_layout_planner"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_warehouse_layout_planner"/>
    </record>
</odoo>
