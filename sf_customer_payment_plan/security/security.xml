<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_customer_payment_plan" model="ir.module.category">
        <field name="name">Customer Payment Plan Manager</field>
        <field name="sequence">685</field>
    </record>
    <record id="group_customer_payment_plan_user" model="res.groups">
        <field name="name">Customer Payment Plan Manager User</field>
        <field name="category_id" ref="module_category_customer_payment_plan"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>

    </record>
    <record id="group_customer_payment_plan_manager" model="res.groups">
        <field name="name">Customer Payment Plan Manager Manager</field>
        <field name="category_id" ref="module_category_customer_payment_plan"/>
        <field name="implied_ids" eval="[(4, ref('group_customer_payment_plan_user'))]"/>
    </record>
    <record id="rule_customer_payment_plan_sf_customer_payment_plan" model="ir.rule">
        <field name="name">Customer Payment Plan Manager: multi-company</field>
        <field name="model_id" ref="model_sf_customer_payment_plan"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
