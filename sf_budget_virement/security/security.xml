<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_budget_virement" model="ir.module.category">
        <field name="name">Budget Transfer (Virement) Workflow</field>
        <field name="sequence">60</field>
    </record>
    <record id="group_budget_virement_user" model="res.groups">
        <field name="name">Budget Transfer (Virement) Workflow User</field>
        <field name="category_id" ref="module_category_budget_virement"/>

    </record>
    <record id="group_budget_virement_manager" model="res.groups">
        <field name="name">Budget Transfer (Virement) Workflow Manager</field>
        <field name="category_id" ref="module_category_budget_virement"/>
        <field name="implied_ids" eval="[(4, ref('group_budget_virement_user'))]"/>
    </record>
    <record id="rule_budget_virement_sf_budget_virement" model="ir.rule">
        <field name="name">Budget Transfer: multi-company</field>
        <field name="model_id" ref="model_sf_budget_virement"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_budget_virement"/>
    </record>
</odoo>
