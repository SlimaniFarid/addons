<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_quality_hold_register" model="ir.module.category">
        <field name="name">Quality Hold &amp; Quarantine Register</field>
        <field name="sequence">26</field>
    </record>
    <record id="group_quality_hold_register_user" model="res.groups">
        <field name="name">Quality Hold &amp; Quarantine Register User</field>
        <field name="category_id" ref="module_category_quality_hold_register"/>
        <field name="implied_ids" eval="[(4, ref('stock.group_stock_user'))]"/>

    </record>
    <record id="group_quality_hold_register_manager" model="res.groups">
        <field name="name">Quality Hold &amp; Quarantine Register Manager</field>
        <field name="category_id" ref="module_category_quality_hold_register"/>
        <field name="implied_ids" eval="[(4, ref('group_quality_hold_register_user'))]"/>
    </record>
    <record id="rule_quality_hold_register_sf_quality_hold" model="ir.rule">
        <field name="name">Quality Hold: multi-company</field>
        <field name="model_id" ref="model_sf_quality_hold"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_quality_hold_register"/>
    </record>
</odoo>
