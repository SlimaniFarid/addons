<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_quality_hold" model="ir.actions.act_window">
        <field name="name">Quality Hold &amp; Quarantine Register</field>
        <field name="res_model">sf.quality.hold</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
    <record id="view_sf_quality_hold_form" model="ir.ui.view">
        <field name="name">sf.quality.hold.form</field>
        <field name="model">sf.quality.hold</field>
        <field name="arch" type="xml">
            <form string="Quality Hold &amp; Quarantine Register">
                <header>
                    <button name="action_investigating" type="object" string="Investigating"
                            class="btn-primary"/>
                    <button name="action_released" type="object" string="Released"
                            class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="held,investigating,released,scrapped"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="product_id"/>
                            <field name="lot_id"/>
                            <field name="quantity"/>
                            <field name="hold_reason"/>
                            <field name="investigation_ref"/>
                            <field name="release_decision"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_quality_hold_list" model="ir.ui.view">
        <field name="name">sf.quality.hold.list</field>
        <field name="model">sf.quality.hold</field>
        <field name="arch" type="xml">
            <list string="Quality Hold &amp; Quarantine Register" sample="1">
                <field name="product_id"/>
                <field name="lot_id"/>
                <field name="quantity"/>
                <field name="hold_reason"/>
                <field name="investigation_ref"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state in ('submitted','approved')"/>
            </list>
        </field>
    </record>
    <record id="view_sf_quality_hold_kanban" model="ir.ui.view">
        <field name="name">sf.quality.hold.kanban</field>
        <field name="model">sf.quality.hold</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_view" group_by="state">
                <field name="name"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <menuitem id="menu_sf_quality_hold_root" name="Quality Hold &amp; Quarantine Register" sequence="19"
              web_icon="sf_quality_hold_register,static/description/icon.png"/>
    <menuitem id="menu_sf_quality_hold_main" name="Records"
              parent="menu_sf_quality_hold_root" action="action_sf_quality_hold" sequence="10"/>
</odoo>
