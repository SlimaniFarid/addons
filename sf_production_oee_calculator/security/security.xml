<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_production_oee_calculator" model="ir.module.category">
        <field name="name">OEE Calculator</field>
        <field name="sequence">464</field>
    </record>
    <record id="group_production_oee_calculator_user" model="res.groups">
        <field name="name">OEE Calculator User</field>
        <field name="category_id" ref="module_category_production_oee_calculator"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>

    </record>
    <record id="group_production_oee_calculator_manager" model="res.groups">
        <field name="name">OEE Calculator Manager</field>
        <field name="category_id" ref="module_category_production_oee_calculator"/>
        <field name="implied_ids" eval="[(4, ref('group_production_oee_calculator_user'))]"/>
    </record>
    <record id="rule_production_oee_calculator_sf_production_oee_calculator" model="ir.rule">
        <field name="name">OEE Calculator: multi-company</field>
        <field name="model_id" ref="model_sf_production_oee_calculator"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_production_oee_calculator"/>
    </record>
</odoo>
