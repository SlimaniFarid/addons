<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_production_oee_calculator" model="ir.actions.act_window">
        <field name="name">OEE Calculator</field>
        <field name="res_model">sf.production_oee_calculator</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
    <record id="view_sf_production_oee_calculator_form" model="ir.ui.view">
        <field name="name">sf.production_oee_calculator.form</field>
        <field name="model">sf.production_oee_calculator</field>
        <field name="arch" type="xml">
            <form string="OEE Calculator">
                <header>
                    <button name="action_submitted" type="object" string="Submitted"
                            class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="workcenter_id"/>
                            <field name="period"/>
                            <field name="planned_time"/>
                            <field name="downtime"/>
                            <field name="ideal_cycle"/>
                            <field name="total_count"/>
                            <field name="good_count"/>
                            <field name="oee_percent"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_production_oee_calculator_list" model="ir.ui.view">
        <field name="name">sf.production_oee_calculator.list</field>
        <field name="model">sf.production_oee_calculator</field>
        <field name="arch" type="xml">
            <list string="OEE Calculator" sample="1">
                <field name="workcenter_id"/>
                <field name="period"/>
                <field name="planned_time"/>
                <field name="downtime"/>
                <field name="ideal_cycle"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state in ('submitted','approved')"/>
            </list>
        </field>
    </record>
    <record id="view_sf_production_oee_calculator_kanban" model="ir.ui.view">
        <field name="name">sf.production_oee_calculator.kanban</field>
        <field name="model">sf.production_oee_calculator</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_view" group_by="state">
                <field name="name"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <menuitem id="menu_sf_production_oee_calculator_root" name="OEE Calculator" sequence="7"
              web_icon="sf_production_oee_calculator,static/description/icon.png"/>
    <menuitem id="menu_sf_production_oee_calculator_main" name="Records"
              parent="menu_sf_production_oee_calculator_root" action="action_sf_production_oee_calculator" sequence="10"/>
</odoo>
