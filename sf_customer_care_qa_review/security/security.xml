<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_customer_care_qa_review" model="ir.module.category">
        <field name="name">Customer Care QA Review</field>
        <field name="sequence">370</field>
    </record>
    <record id="group_customer_care_qa_review_user" model="res.groups">
        <field name="name">Customer Care QA Review User</field>
        <field name="category_id" ref="module_category_customer_care_qa_review"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>

    </record>
    <record id="group_customer_care_qa_review_manager" model="res.groups">
        <field name="name">Customer Care QA Review Manager</field>
        <field name="category_id" ref="module_category_customer_care_qa_review"/>
        <field name="implied_ids" eval="[(4, ref('group_customer_care_qa_review_user'))]"/>
    </record>
    <record id="rule_customer_care_qa_review_sf_customer_care_qa_review" model="ir.rule">
        <field name="name">Customer Care QA Review: multi-company</field>
        <field name="model_id" ref="model_sf_customer_care_qa_review"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_customer_care_qa_review"/>
    </record>
</odoo>
