<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_document_approval_hybrid" model="ir.module.category">
        <field name="name">Document Approval Reminders</field>
        <field name="sequence">12</field>
    </record>
    <record id="group_document_approval_hybrid_user" model="res.groups">
        <field name="name">Document Approval Reminders User</field>
        <field name="category_id" ref="module_category_document_approval_hybrid"/>

    </record>
    <record id="group_document_approval_hybrid_manager" model="res.groups">
        <field name="name">Document Approval Reminders Manager</field>
        <field name="category_id" ref="module_category_document_approval_hybrid"/>
        <field name="implied_ids" eval="[(4, ref('group_document_approval_hybrid_user'))]"/>
    </record>
    <record id="rule_document_approval_hybrid_sf_doc_approval_chase" model="ir.rule">
        <field name="name">Approval Chase: multi-company</field>
        <field name="model_id" ref="model_sf_doc_approval_chase"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_document_approval_hybrid"/>
    </record>
</odoo>
