<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_doc_approval_chase" model="ir.actions.act_window">
        <field name="name">Document Approval Reminders</field>
        <field name="res_model">sf.doc.approval.chase</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
    <record id="view_sf_doc_approval_chase_form" model="ir.ui.view">
        <field name="name">sf.doc.approval.chase.form</field>
        <field name="model">sf.doc.approval.chase</field>
        <field name="arch" type="xml">
            <form string="Document Approval Reminders">
                <header>
                    <button name="action_reminded" type="object" string="Reminded"
                            class="btn-primary"/>
                    <button name="action_escalated" type="object" string="Escalated"
                            class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="open,reminded,escalated,approved"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="document_ref"/>
                            <field name="pending_with_id"/>
                            <field name="sent_since"/>
                            <field name="days_pending"/>
                            <field name="escalated"/>
                            <field name="notes"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_doc_approval_chase_list" model="ir.ui.view">
        <field name="name">sf.doc.approval.chase.list</field>
        <field name="model">sf.doc.approval.chase</field>
        <field name="arch" type="xml">
            <list string="Document Approval Reminders" sample="1">
                <field name="document_ref"/>
                <field name="pending_with_id"/>
                <field name="sent_since"/>
                <field name="days_pending"/>
                <field name="escalated"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state in ('submitted','approved')"/>
            </list>
        </field>
    </record>
    <record id="view_sf_doc_approval_chase_kanban" model="ir.ui.view">
        <field name="name">sf.doc.approval.chase.kanban</field>
        <field name="model">sf.doc.approval.chase</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_view" group_by="state">
                <field name="name"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <menuitem id="menu_sf_doc_approval_chase_root" name="Document Approval Reminders" sequence="3"
              web_icon="sf_document_approval_hybrid,static/description/icon.png"/>
    <menuitem id="menu_sf_doc_approval_chase_main" name="Records"
              parent="menu_sf_doc_approval_chase_root" action="action_sf_doc_approval_chase" sequence="10"/>
</odoo>
