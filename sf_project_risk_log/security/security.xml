<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_project_risk_log" model="ir.module.category">
        <field name="name">Project Risk Log</field>
        <field name="sequence">54</field>
    </record>
    <record id="group_project_risk_log_user" model="res.groups">
        <field name="name">Project Risk Log User</field>
        <field name="category_id" ref="module_category_project_risk_log"/>

    </record>
    <record id="group_project_risk_log_manager" model="res.groups">
        <field name="name">Project Risk Log Manager</field>
        <field name="category_id" ref="module_category_project_risk_log"/>
        <field name="implied_ids" eval="[(4, ref('group_project_risk_log_user'))]"/>
    </record>
    <record id="rule_project_risk_log_sf_project_risk" model="ir.rule">
        <field name="name">Project Risk: multi-company</field>
        <field name="model_id" ref="model_sf_project_risk"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
