<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_project_risk" model="ir.actions.act_window">
        <field name="name">Project Risk Log</field>
        <field name="res_model">sf.project.risk</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
    <record id="view_sf_project_risk_form" model="ir.ui.view">
        <field name="name">sf.project.risk.form</field>
        <field name="model">sf.project.risk</field>
        <field name="arch" type="xml">
            <form string="Project Risk Log">
                <header>
                    <button name="action_mitigating" type="object" string="Mitigating"
                            class="btn-primary"/>
                    <button name="action_closed" type="object" string="Closed"
                            class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="identified,mitigating,closed,occurred"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="project_name"/>
                            <field name="risk_description"/>
                            <field name="probability"/>
                            <field name="impact"/>
                            <field name="mitigation"/>
                            <field name="owner_id"/>
                            <field name="review_date"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_project_risk_list" model="ir.ui.view">
        <field name="name">sf.project.risk.list</field>
        <field name="model">sf.project.risk</field>
        <field name="arch" type="xml">
            <list string="Project Risk Log" sample="1">
                <field name="project_name"/>
                <field name="risk_description"/>
                <field name="probability"/>
                <field name="impact"/>
                <field name="mitigation"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state in ('submitted','approved')"/>
            </list>
        </field>
    </record>
    <record id="view_sf_project_risk_kanban" model="ir.ui.view">
        <field name="name">sf.project.risk.kanban</field>
        <field name="model">sf.project.risk</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_view" group_by="state">
                <field name="name"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <menuitem id="menu_sf_project_risk_root" name="Project Risk Log" sequence="10"
              web_icon="sf_project_risk_log,static/description/icon.png"/>
    <menuitem id="menu_sf_project_risk_main" name="Records"
              parent="menu_sf_project_risk_root" action="action_sf_project_risk" sequence="10"/>
</odoo>
