<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="module_category_sf_digital_delivery" model="ir.module.category">
            <field name="name">Digital Delivery</field>
            <field name="description">E-commerce Digital Goods &amp; License Key Delivery.</field>
            <field name="sequence">10</field>
        </record>

        <record id="group_sf_digital_delivery_user" model="res.groups">
            <field name="name">Digital Delivery / User</field>
            <field name="category_id" ref="module_category_sf_digital_delivery"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_sf_digital_delivery_manager" model="res.groups">
            <field name="name">Digital Delivery / Manager</field>
            <field name="category_id" ref="module_category_sf_digital_delivery"/>
            <field name="implied_ids" eval="[(4, ref('sf_digital_delivery.group_sf_digital_delivery_user'))]"/>
        </record>

        <record id="rule_sf_digital_product_company" model="ir.rule">
            <field name="name">Digital Product: user sees own company</field>
            <field name="model_id" ref="model_sf_digital_product"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('sf_digital_delivery.group_sf_digital_delivery_user'))]"/>
        </record>
        <record id="rule_sf_digital_product_manager_all" model="ir.rule">
            <field name="name">Digital Product: manager sees all companies</field>
            <field name="model_id" ref="model_sf_digital_product"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('sf_digital_delivery.group_sf_digital_delivery_manager'))]"/>
        </record>

        <record id="rule_sf_digital_key_company" model="ir.rule">
            <field name="name">Digital Key: user sees own company</field>
            <field name="model_id" ref="model_sf_digital_key"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('sf_digital_delivery.group_sf_digital_delivery_user'))]"/>
        </record>
        <record id="rule_sf_digital_key_manager_all" model="ir.rule">
            <field name="name">Digital Key: manager sees all companies</field>
            <field name="model_id" ref="model_sf_digital_key"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('sf_digital_delivery.group_sf_digital_delivery_manager'))]"/>
        </record>

        <record id="rule_sf_digital_delivery_company" model="ir.rule">
            <field name="name">Digital Delivery: user sees own company</field>
            <field name="model_id" ref="model_sf_digital_delivery"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('sf_digital_delivery.group_sf_digital_delivery_user'))]"/>
        </record>
        <record id="rule_sf_digital_delivery_manager_all" model="ir.rule">
            <field name="name">Digital Delivery: manager sees all companies</field>
            <field name="model_id" ref="model_sf_digital_delivery"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('sf_digital_delivery.group_sf_digital_delivery_manager'))]"/>
        </record>

        <record id="rule_sf_digital_delivery_line_company" model="ir.rule">
            <field name="name">Digital Delivery Line: user sees own company</field>
            <field name="model_id" ref="model_sf_digital_delivery_line"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('sf_digital_delivery.group_sf_digital_delivery_user'))]"/>
        </record>
        <record id="rule_sf_digital_delivery_line_manager_all" model="ir.rule">
            <field name="name">Digital Delivery Line: manager sees all companies</field>
            <field name="model_id" ref="model_sf_digital_delivery_line"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('sf_digital_delivery.group_sf_digital_delivery_manager'))]"/>
        </record>
    </data>
    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_sf_digital_delivery"/>
    </record>
</odoo>