<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_digital_delivery">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-set="company" t-value="o.company_id or res_company"/>
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>Digital Delivery</h2>
                        <table class="table table-sm">
                            <tr><th>Delivery</th><td><span t-field="o.name"/></td></tr>
                            <tr><th>Sales Order</th><td><span t-field="o.order_id"/></td></tr>
                            <tr><th>Customer</th><td><span t-field="o.partner_id"/></td></tr>
                            <tr><th>Status</th><td><span t-field="o.state"/></td></tr>
                            <tr><th>Delivery Date</th><td><span t-field="o.delivery_date"/></td></tr>
                        </table>
                        <h3>Delivered Items</h3>
                        <table class="table table-sm">
                            <tr><th>Product</th><th>Quantity</th><th>Keys / Download Link</th></tr>
                            <tr t-foreach="o.line_ids" t-as="l">
                                <td><span t-field="l.product_id"/></td>
                                <td><span t-field="l.quantity"/></td>
                                <td>
                                    <span t-if="l.key_ids" t-esc="l.key_ids.mapped('key')"/>
                                    <span t-if="l.download_url" t-field="l.download_url"/>
                                </td>
                            </tr>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>