<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_digital_delivery" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.digital.delivery</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Digital Delivery" string="Digital Delivery" name="sf_digital_delivery">
                    <block title="Digital Delivery Settings">
                        <setting string="Default License Key Format">
                            <field name="sf_digital_delivery_default_key_format"/>
                        </setting>
                        <setting string="Default Download Link Validity (days)">
                            <field name="sf_digital_delivery_default_validity_days"/>
                        </setting>
                        <setting string="Default Key Activation Delay (days)">
                            <field name="sf_digital_delivery_default_activation_days"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>