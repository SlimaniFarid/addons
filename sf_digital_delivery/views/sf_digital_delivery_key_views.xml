<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sf_digital_delivery_key_view_list" model="ir.ui.view">
        <field name="name">sf.digital.key.list</field>
        <field name="model">sf.digital.key</field>
        <field name="arch" type="xml">
            <list decoration-danger="is_overdue" string="License Keys">
                <field name="name"/>
                <field name="key"/>
                <field name="product_id"/>
                <field name="partner_id"/>
                <field name="order_id"/>
                <field name="state" widget="badge"/>
                <field name="activation_count"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="sf_digital_delivery_key_view_form" model="ir.ui.view">
        <field name="name">sf.digital.key.form</field>
        <field name="model">sf.digital.key</field>
        <field name="arch" type="xml">
            <form string="License Key">
                <header>
                    <button name="action_activate" string="Activate" type="object" class="btn-primary"
                            invisible="[('state', '!=', 'delivered')]"/>
                    <button name="action_revoke" string="Revoke" type="object"
                            invisible="[('state', 'not in', ('delivered', 'activated'))]"/>
                    <field name="state" widget="statusbar" readonly="1"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="key"/>
                            <field name="product_id"/>
                            <field name="delivery_id"/>
                        </group>
                        <group>
                            <field name="order_id"/>
                            <field name="partner_id"/>
                            <field name="activation_count"/>
                            <field name="activated_date"/>
                            <field name="delivered_date"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="sf_digital_delivery_key_view_search" model="ir.ui.view">
        <field name="name">sf.digital.key.search</field>
        <field name="model">sf.digital.key</field>
        <field name="arch" type="xml">
            <search string="License Keys">
                <field name="key"/>
                <field name="partner_id"/>
                <field name="order_id"/>
                <filter name="key_generated" string="Generated" domain="[('state', '=', 'generated')]"/>
                <filter name="key_delivered" string="Delivered" domain="[('state', '=', 'delivered')]"/>
                <filter name="key_activated" string="Activated" domain="[('state', '=', 'activated')]"/>
                <group>
                    <filter name="group_key_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_key_product" string="Product" context="{'group_by': 'product_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_sf_digital_delivery_key" model="ir.actions.act_window">
        <field name="name">License Keys</field>
        <field name="res_model">sf.digital.key</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="sf_digital_delivery_key_view_search"/>
    </record>

    <record id="view_sf_digital_delivery_boost_kanban" model="ir.ui.view">
        <field name="name">sf_digital_delivery.boost.kanban</field>
        <field name="model">sf.digital.delivery</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" t-att-color="state">
                <field name="name"/>
                <field name="state"/>
                <field name="user_id"/>
                <field name="download_expiry_date"/>
                <field name="is_overdue" invisible="1"/>

                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_card oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title">
                                    <field name="name"/></strong>
                                <div class="o_kanban_record_subtitle">
                                    <field name="user_id" widget="many2one_avatar_user"/>
                                    <field name="download_expiry_date"/></div>
                            </div>
                            <div class="oe_kanban_bottom_right">
                                <field name="state" widget="badge"
                                       t-attf-options="{'classes_map': {'draft': 'info', 'done': 'success', 'cancelled': 'danger'}, 'domain': []}"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_sf_digital_delivery_boost_search" model="ir.ui.view">
        <field name="name">sf_digital_delivery.boost.search</field>
        <field name="model">sf.digital.delivery</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
<separator/>
                <filter string="My records" name="my_records" domain="[('user_id', '=', uid)]"/>
                <filter string="To Do" name="todo" domain="[('state', 'not in', ('done', 'cancelled', 'closed'))]"/>
                <group expand="0" string="Group By"><filter string="Status" name="gb_state" context="{'group_by': 'state'}"/></group>
            </search>
        </field>
    </record>
</odoo>
