<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sf_digital_delivery_product_view_list" model="ir.ui.view">
        <field name="name">sf.digital.product.list</field>
        <field name="model">sf.digital.product</field>
        <field name="arch" type="xml">
            <list string="Digital Products">
                <field name="name"/>
                <field name="product_id"/>
                <field name="delivery_type"/>
                <field name="key_format"/>
                <field name="max_activations"/>
                <field name="validity_days"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="sf_digital_delivery_product_view_form" model="ir.ui.view">
        <field name="name">sf.digital.product.form</field>
        <field name="model">sf.digital.product</field>
        <field name="arch" type="xml">
            <form string="Digital Product">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="product_id"/>
                            <field name="delivery_type"/>
                        </group>
                        <group>
                            <field name="key_format"/>
                            <field name="max_activations"/>
                            <field name="validity_days"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group string="Download File">
                        <field name="file_binary" filename="file_name"/>
                        <field name="file_name"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="sf_digital_delivery_product_view_search" model="ir.ui.view">
        <field name="name">sf.digital.product.search</field>
        <field name="model">sf.digital.product</field>
        <field name="arch" type="xml">
            <search string="Digital Products">
                <field name="name"/>
                <field name="product_id"/>
                <filter name="digital_license" string="License Keys" domain="[('delivery_type', '=', 'license_key')]"/>
                <filter name="digital_download" string="Downloads" domain="[('delivery_type', '=', 'download')]"/>
                <group>
                    <filter name="group_digital_type" string="Type" context="{'group_by': 'delivery_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_sf_digital_delivery_product" model="ir.actions.act_window">
        <field name="name">Digital Products</field>
        <field name="res_model">sf.digital.product</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="sf_digital_delivery_product_view_search"/>
    </record>
</odoo>