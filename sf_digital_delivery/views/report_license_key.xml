<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_license_key">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-set="company" t-value="o.company_id or res_company"/>
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>License Key Certificate</h2>
                        <table class="table table-sm">
                            <tr><th>Key</th><td><span t-field="o.key"/></td></tr>
                            <tr><th>Product</th><td><span t-field="o.product_id.product_id"/></td></tr>
                            <tr><th>Customer</th><td><span t-field="o.partner_id"/></td></tr>
                            <tr><th>Sales Order</th><td><span t-field="o.order_id"/></td></tr>
                            <tr><th>Status</th><td><span t-field="o.state"/></td></tr>
                            <tr><th>Activations</th><td><span t-field="o.activation_count"/></td></tr>
                            <tr><th>Activated On</th><td><span t-field="o.activated_date"/></td></tr>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>