<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_po_approval_level" model="ir.actions.act_window">
        <field name="name">PO Approval Matrix</field>
        <field name="res_model">sf.po.approval.level</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
    <record id="view_sf_po_approval_level_form" model="ir.ui.view">
        <field name="name">sf.po.approval.level.form</field>
        <field name="model">sf.po.approval.level</field>
        <field name="arch" type="xml">
            <form string="PO Approval Matrix">
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="active,archived"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="level_name"/>
                            <field name="min_amount"/>
                            <field name="max_amount"/>
                            <field name="approver_id"/>
                            <field name="delegate_id"/>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_po_approval_level_list" model="ir.ui.view">
        <field name="name">sf.po.approval.level.list</field>
        <field name="model">sf.po.approval.level</field>
        <field name="arch" type="xml">
            <list string="PO Approval Matrix" sample="1">
                <field name="level_name"/>
                <field name="min_amount"/>
                <field name="max_amount"/>
                <field name="approver_id"/>
                <field name="delegate_id"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state in ('submitted','approved')"/>
            </list>
        </field>
    </record>
    <record id="view_sf_po_approval_level_kanban" model="ir.ui.view">
        <field name="name">sf.po.approval.level.kanban</field>
        <field name="model">sf.po.approval.level</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_view" group_by="state">
                <field name="name"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <menuitem id="menu_sf_po_approval_level_root" name="PO Approval Matrix" sequence="20"
              web_icon="sf_purchase_approval_matrix,static/description/icon.png"/>
    <menuitem id="menu_sf_po_approval_level_main" name="Records"
              parent="menu_sf_po_approval_level_root" action="action_sf_po_approval_level" sequence="10"/>

    <record id="wave_final_sf_purchase_approval_matrix" model="ir.actions.server">
        <field name="name">Refresh Business Data</field>
        <field name="model_id" ref="model_sf_po_approval_level"/>
        <field name="binding_model_id" ref="model_sf_po_approval_level"/>
        <field name="state">code</field>
        <field name="code">records.action_refresh_business()</field>
    </record>
</odoo>
