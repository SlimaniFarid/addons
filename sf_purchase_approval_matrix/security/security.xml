<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_purchase_approval_matrix" model="ir.module.category">
        <field name="name">PO Approval Matrix</field>
        <field name="sequence">37</field>
    </record>
    <record id="group_purchase_approval_matrix_user" model="res.groups">
        <field name="name">PO Approval Matrix User</field>
        <field name="category_id" ref="module_category_purchase_approval_matrix"/>
        <field name="implied_ids" eval="[(4, ref('purchase.group_purchase_user'))]"/>

    </record>
    <record id="group_purchase_approval_matrix_manager" model="res.groups">
        <field name="name">PO Approval Matrix Manager</field>
        <field name="category_id" ref="module_category_purchase_approval_matrix"/>
        <field name="implied_ids" eval="[(4, ref('group_purchase_approval_matrix_user'))]"/>
    </record>
    <record id="rule_purchase_approval_matrix_sf_po_approval_level" model="ir.rule">
        <field name="name">Approval Level: multi-company</field>
        <field name="model_id" ref="model_sf_po_approval_level"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_purchase_approval_matrix"/>
    </record>
</odoo>
