<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_supplier_bank_change_alert" model="ir.module.category">
        <field name="name">Supplier Bank Change Alert</field>
        <field name="sequence">30</field>
    </record>
    <record id="group_supplier_bank_change_alert_user" model="res.groups">
        <field name="name">Supplier Bank Change Alert User</field>
        <field name="category_id" ref="module_category_supplier_bank_change_alert"/>

    </record>
    <record id="group_supplier_bank_change_alert_manager" model="res.groups">
        <field name="name">Supplier Bank Change Alert Manager</field>
        <field name="category_id" ref="module_category_supplier_bank_change_alert"/>
        <field name="implied_ids" eval="[(4, ref('group_supplier_bank_change_alert_user'))]"/>
    </record>
    <record id="rule_supplier_bank_change_alert_sf_bank_change" model="ir.rule">
        <field name="name">Bank Change Request: multi-company</field>
        <field name="model_id" ref="model_sf_bank_change"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
