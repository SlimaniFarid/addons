<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_bank_change" model="ir.actions.act_window">
        <field name="name">Supplier Bank Change Alert</field>
        <field name="res_model">sf.bank.change</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
    <record id="view_sf_bank_change_form" model="ir.ui.view">
        <field name="name">sf.bank.change.form</field>
        <field name="model">sf.bank.change</field>
        <field name="arch" type="xml">
            <form string="Supplier Bank Change Alert">
                <header>
                    <button name="action_verified" type="object" string="Verified"
                            class="btn-primary"/>
                    <button name="action_applied" type="object" string="Applied"
                            class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="received,verified,applied,rejected"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="vendor_id"/>
                            <field name="old_iban"/>
                            <field name="new_iban"/>
                            <field name="verification_call_done"/>
                            <field name="verified_by_id"/>
                        <field name="documents"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_bank_change_list" model="ir.ui.view">
        <field name="name">sf.bank.change.list</field>
        <field name="model">sf.bank.change</field>
        <field name="arch" type="xml">
            <list string="Supplier Bank Change Alert" sample="1">
                <field name="vendor_id"/>
                <field name="old_iban"/>
                <field name="new_iban"/>
                <field name="verification_call_done"/>
                <field name="verified_by_id"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state in ('submitted','approved')"/>
            </list>
        </field>
    </record>
    <record id="view_sf_bank_change_kanban" model="ir.ui.view">
        <field name="name">sf.bank.change.kanban</field>
        <field name="model">sf.bank.change</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_view" group_by="state">
                <field name="name"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <menuitem id="menu_sf_bank_change_root" name="Supplier Bank Change Alert" sequence="9"
              web_icon="sf_supplier_bank_change_alert,static/description/icon.png"/>
    <menuitem id="menu_sf_bank_change_main" name="Records"
              parent="menu_sf_bank_change_root" action="action_sf_bank_change" sequence="10"/>

    <record id="wave_final_sf_supplier_bank_change_alert" model="ir.actions.server">
        <field name="name">Refresh Business Data</field>
        <field name="model_id" ref="model_sf_bank_change"/>
        <field name="binding_model_id" ref="model_sf_bank_change"/>
        <field name="state">code</field>
        <field name="code">records.action_refresh_business()</field>
    </record>
</odoo>
