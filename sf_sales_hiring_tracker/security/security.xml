<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_sales_hiring_tracker" model="ir.module.category">
        <field name="name">Sales Hiring &amp; Ramp Tracker</field>
        <field name="sequence">698</field>
    </record>
    <record id="group_sales_hiring_tracker_user" model="res.groups">
        <field name="name">Sales Hiring &amp; Ramp Tracker User</field>
        <field name="category_id" ref="module_category_sales_hiring_tracker"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>

    </record>
    <record id="group_sales_hiring_tracker_manager" model="res.groups">
        <field name="name">Sales Hiring &amp; Ramp Tracker Manager</field>
        <field name="category_id" ref="module_category_sales_hiring_tracker"/>
        <field name="implied_ids" eval="[(4, ref('group_sales_hiring_tracker_user'))]"/>
    </record>
    <record id="rule_sales_hiring_tracker_sf_sales_hiring_tracker" model="ir.rule">
        <field name="name">Sales Hiring &amp; Ramp Tracker: multi-company</field>
        <field name="model_id" ref="model_sf_sales_hiring_tracker"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
