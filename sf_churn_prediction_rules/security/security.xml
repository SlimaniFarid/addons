<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_churn_prediction_rules" model="ir.module.category">
        <field name="name">Churn Prediction Rules Engine</field>
        <field name="sequence">295</field>
    </record>
    <record id="group_churn_prediction_rules_user" model="res.groups">
        <field name="name">Churn Prediction Rules Engine User</field>
        <field name="category_id" ref="module_category_churn_prediction_rules"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>

    </record>
    <record id="group_churn_prediction_rules_manager" model="res.groups">
        <field name="name">Churn Prediction Rules Engine Manager</field>
        <field name="category_id" ref="module_category_churn_prediction_rules"/>
        <field name="implied_ids" eval="[(4, ref('group_churn_prediction_rules_user'))]"/>
    </record>
    <record id="rule_churn_prediction_rules_sf_churn_prediction_rules" model="ir.rule">
        <field name="name">Churn Prediction Rules Engine: multi-company</field>
        <field name="model_id" ref="model_sf_churn_prediction_rules"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
