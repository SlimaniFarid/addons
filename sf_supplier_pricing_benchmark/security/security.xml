<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_supplier_pricing_benchmark" model="ir.module.category">
        <field name="name">Supplier Pricing Benchmark</field>
        <field name="sequence">463</field>
    </record>
    <record id="group_supplier_pricing_benchmark_user" model="res.groups">
        <field name="name">Supplier Pricing Benchmark User</field>
        <field name="category_id" ref="module_category_supplier_pricing_benchmark"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>

    </record>
    <record id="group_supplier_pricing_benchmark_manager" model="res.groups">
        <field name="name">Supplier Pricing Benchmark Manager</field>
        <field name="category_id" ref="module_category_supplier_pricing_benchmark"/>
        <field name="implied_ids" eval="[(4, ref('group_supplier_pricing_benchmark_user'))]"/>
    </record>
    <record id="rule_supplier_pricing_benchmark_sf_supplier_pricing_benchmark" model="ir.rule">
        <field name="name">Supplier Pricing Benchmark: multi-company</field>
        <field name="model_id" ref="model_sf_supplier_pricing_benchmark"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_supplier_pricing_benchmark"/>
    </record>
</odoo>
