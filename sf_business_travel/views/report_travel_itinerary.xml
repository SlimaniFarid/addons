<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_travel_itinerary">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-set="company" t-value="o.company_id or res_company"/>
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>Travel Itinerary</h2>
                        <table class="table table-sm">
                            <tr><th>Name</th><td><span t-field="o.name"/></td></tr>
                            <tr><th>Employee</th><td><span t-field="o.employee_id"/></td></tr>
                            <tr><th>Destination</th><td><span t-field="o.destination"/></td></tr>
                            <tr><th>Period</th><td><span t-field="o.departure_date"/> / <span t-field="o.return_date"/></td></tr>
                        </table>
                        <table class="table table-sm">
                            <tr><th>Date</th><th>Type</th><th>Description</th><th>Amount</th></tr>
                            <tr t-foreach="o.line_ids" t-as="l">
                                <td><span t-field="l.line_date"/></td>
                                <td><span t-field="l.line_type"/></td>
                                <td><span t-field="l.description"/></td>
                                <td><span t-field="l.amount"/></td>
                            </tr>
                        </table>
                        <p><strong>Estimated Cost:</strong> <span t-field="o.estimated_cost"/></p>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>