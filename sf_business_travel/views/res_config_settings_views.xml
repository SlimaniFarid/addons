<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_business_travel" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.business.travel</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Business Travel" string="Business Travel" name="sf_business_travel">
                    <block title="Business Travel Settings">
                        <setting string="Departure Reminder (days before departure)">
                            <field name="sf_business_travel_reminder_days"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>