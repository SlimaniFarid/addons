<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_asset_count_campaign" model="ir.module.category">
        <field name="name">Fixed Asset Physical Count</field>
        <field name="sequence">52</field>
    </record>
    <record id="group_asset_count_campaign_user" model="res.groups">
        <field name="name">Fixed Asset Physical Count User</field>
        <field name="category_id" ref="module_category_asset_count_campaign"/>

    </record>
    <record id="group_asset_count_campaign_manager" model="res.groups">
        <field name="name">Fixed Asset Physical Count Manager</field>
        <field name="category_id" ref="module_category_asset_count_campaign"/>
        <field name="implied_ids" eval="[(4, ref('group_asset_count_campaign_user'))]"/>
    </record>
    <record id="rule_asset_count_campaign_sf_asset_count" model="ir.rule">
        <field name="name">Asset Count Campaign: multi-company</field>
        <field name="model_id" ref="model_sf_asset_count"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_asset_count_campaign"/>
    </record>
</odoo>
