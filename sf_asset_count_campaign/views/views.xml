<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_asset_count" model="ir.actions.act_window">
        <field name="name">Fixed Asset Physical Count</field>
        <field name="res_model">sf.asset.count</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
    <record id="view_sf_asset_count_form" model="ir.ui.view">
        <field name="name">sf.asset.count.form</field>
        <field name="model">sf.asset.count</field>
        <field name="arch" type="xml">
            <form string="Fixed Asset Physical Count">
                <header>
                    <button name="action_counting" type="object" string="Counting"
                            class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,counting,reconciled"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="location"/>
                            <field name="count_date"/>
                            <field name="assets_expected"/>
                            <field name="assets_found"/>
                            <field name="missing_count"/>
                            <field name="notes"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_asset_count_list" model="ir.ui.view">
        <field name="name">sf.asset.count.list</field>
        <field name="model">sf.asset.count</field>
        <field name="arch" type="xml">
            <list string="Fixed Asset Physical Count" sample="1">
                <field name="location"/>
                <field name="count_date"/>
                <field name="assets_expected"/>
                <field name="assets_found"/>
                <field name="missing_count"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state in ('submitted','approved')"/>
            </list>
        </field>
    </record>
    <record id="view_sf_asset_count_kanban" model="ir.ui.view">
        <field name="name">sf.asset.count.kanban</field>
        <field name="model">sf.asset.count</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_view" group_by="state">
                <field name="name"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <menuitem id="menu_sf_asset_count_root" name="Fixed Asset Physical Count" sequence="3"
              web_icon="sf_asset_count_campaign,static/description/icon.png"/>
    <menuitem id="menu_sf_asset_count_main" name="Records"
              parent="menu_sf_asset_count_root" action="action_sf_asset_count" sequence="10"/>
</odoo>
