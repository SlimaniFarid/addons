<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_production_order_sequencing2" model="ir.module.category">
        <field name="name">Production Sequencing</field>
        <field name="sequence">670</field>
    </record>
    <record id="group_production_order_sequencing2_user" model="res.groups">
        <field name="name">Production Sequencing User</field>
        <field name="category_id" ref="module_category_production_order_sequencing2"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>

    </record>
    <record id="group_production_order_sequencing2_manager" model="res.groups">
        <field name="name">Production Sequencing Manager</field>
        <field name="category_id" ref="module_category_production_order_sequencing2"/>
        <field name="implied_ids" eval="[(4, ref('group_production_order_sequencing2_user'))]"/>
    </record>
    <record id="rule_production_order_sequencing2_sf_production_order_sequencing2" model="ir.rule">
        <field name="name">Production Sequencing: multi-company</field>
        <field name="model_id" ref="model_sf_production_order_sequencing2"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_production_order_sequencing2"/>
    </record>
</odoo>
