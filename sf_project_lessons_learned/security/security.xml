<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_project_lessons_learned" model="ir.module.category">
        <field name="name">Project Lessons Learned</field>
        <field name="sequence">395</field>
    </record>
    <record id="group_project_lessons_learned_user" model="res.groups">
        <field name="name">Project Lessons Learned User</field>
        <field name="category_id" ref="module_category_project_lessons_learned"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>

    </record>
    <record id="group_project_lessons_learned_manager" model="res.groups">
        <field name="name">Project Lessons Learned Manager</field>
        <field name="category_id" ref="module_category_project_lessons_learned"/>
        <field name="implied_ids" eval="[(4, ref('group_project_lessons_learned_user'))]"/>
    </record>
    <record id="rule_project_lessons_learned_sf_project_lessons_learned" model="ir.rule">
        <field name="name">Project Lessons Learned: multi-company</field>
        <field name="model_id" ref="model_sf_project_lessons_learned"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
