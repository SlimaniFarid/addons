<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_project_lessons_learned" model="ir.actions.act_window">
        <field name="name">Project Lessons Learned</field>
        <field name="res_model">sf.project_lessons_learned</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
    <record id="view_sf_project_lessons_learned_form" model="ir.ui.view">
        <field name="name">sf.project_lessons_learned.form</field>
        <field name="model">sf.project_lessons_learned</field>
        <field name="arch" type="xml">
            <form string="Project Lessons Learned">
                <header>
                    <button name="action_submitted" type="object" string="Submitted"
                            class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="project_name"/>
                            <field name="phase"/>
                        <field name="went_well"/>
                        <field name="to_improve"/>
                        <field name="recommendations"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_project_lessons_learned_list" model="ir.ui.view">
        <field name="name">sf.project_lessons_learned.list</field>
        <field name="model">sf.project_lessons_learned</field>
        <field name="arch" type="xml">
            <list string="Project Lessons Learned" sample="1">
                <field name="project_name"/>
                <field name="phase"/>
                <field name="went_well"/>
                <field name="to_improve"/>
                <field name="recommendations"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state in ('submitted','approved')"/>
            </list>
        </field>
    </record>
    <record id="view_sf_project_lessons_learned_kanban" model="ir.ui.view">
        <field name="name">sf.project_lessons_learned.kanban</field>
        <field name="model">sf.project_lessons_learned</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_view" group_by="state">
                <field name="name"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <menuitem id="menu_sf_project_lessons_learned_root" name="Project Lessons Learned" sequence="6"
              web_icon="sf_project_lessons_learned,static/description/icon.png"/>
    <menuitem id="menu_sf_project_lessons_learned_main" name="Records"
              parent="menu_sf_project_lessons_learned_root" action="action_sf_project_lessons_learned" sequence="10"/>
</odoo>
