<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_financial_ratio_dashboard" model="ir.module.category">
        <field name="name">Financial Ratio Calculator</field>
        <field name="sequence">182</field>
    </record>
    <record id="group_financial_ratio_dashboard_user" model="res.groups">
        <field name="name">Financial Ratio Calculator User</field>
        <field name="category_id" ref="module_category_financial_ratio_dashboard"/>

    </record>
    <record id="group_financial_ratio_dashboard_manager" model="res.groups">
        <field name="name">Financial Ratio Calculator Manager</field>
        <field name="category_id" ref="module_category_financial_ratio_dashboard"/>
        <field name="implied_ids" eval="[(4, ref('group_financial_ratio_dashboard_user'))]"/>
    </record>
    <record id="rule_financial_ratio_dashboard_sf_financial_ratio_dashboard" model="ir.rule">
        <field name="name">Financial Ratio Calculator: multi-company</field>
        <field name="model_id" ref="model_sf_financial_ratio_dashboard"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_financial_ratio_dashboard"/>
    </record>
</odoo>
