<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_environmental_waste_tracking" model="ir.module.category">
        <field name="name">Environmental Waste Tracking</field>
        <field name="sequence">281</field>
    </record>
    <record id="group_environmental_waste_tracking_user" model="res.groups">
        <field name="name">Environmental Waste Tracking User</field>
        <field name="category_id" ref="module_category_environmental_waste_tracking"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>

    </record>
    <record id="group_environmental_waste_tracking_manager" model="res.groups">
        <field name="name">Environmental Waste Tracking Manager</field>
        <field name="category_id" ref="module_category_environmental_waste_tracking"/>
        <field name="implied_ids" eval="[(4, ref('group_environmental_waste_tracking_user'))]"/>
    </record>
    <record id="rule_environmental_waste_tracking_sf_environmental_waste_tracking" model="ir.rule">
        <field name="name">Environmental Waste Tracking: multi-company</field>
        <field name="model_id" ref="model_sf_environmental_waste_tracking"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_environmental_waste_tracking"/>
    </record>
</odoo>
