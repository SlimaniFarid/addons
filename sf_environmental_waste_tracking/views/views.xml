<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_environmental_waste_tracking" model="ir.actions.act_window">
        <field name="name">Environmental Waste Tracking</field>
        <field name="res_model">sf.environmental_waste_tracking</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
    <record id="view_sf_environmental_waste_tracking_form" model="ir.ui.view">
        <field name="name">sf.environmental_waste_tracking.form</field>
        <field name="model">sf.environmental_waste_tracking</field>
        <field name="arch" type="xml">
            <form string="Environmental Waste Tracking">
                <header>
                    <button name="action_submitted" type="object" string="Submitted"
                            class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="site"/>
                            <field name="waste_type"/>
                            <field name="quantity_kg"/>
                            <field name="disposal_method"/>
                            <field name="cost"/>
                            <field name="recycled"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_environmental_waste_tracking_list" model="ir.ui.view">
        <field name="name">sf.environmental_waste_tracking.list</field>
        <field name="model">sf.environmental_waste_tracking</field>
        <field name="arch" type="xml">
            <list string="Environmental Waste Tracking" sample="1">
                <field name="site"/>
                <field name="waste_type"/>
                <field name="quantity_kg"/>
                <field name="disposal_method"/>
                <field name="cost"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state in ('submitted','approved')"/>
            </list>
        </field>
    </record>
    <record id="view_sf_environmental_waste_tracking_kanban" model="ir.ui.view">
        <field name="name">sf.environmental_waste_tracking.kanban</field>
        <field name="model">sf.environmental_waste_tracking</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_view" group_by="state">
                <field name="name"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <menuitem id="menu_sf_environmental_waste_tracking_root" name="Environmental Waste Tracking" sequence="20"
              web_icon="sf_environmental_waste_tracking,static/description/icon.png"/>
    <menuitem id="menu_sf_environmental_waste_tracking_main" name="Records"
              parent="menu_sf_environmental_waste_tracking_root" action="action_sf_environmental_waste_tracking" sequence="10"/>
</odoo>
