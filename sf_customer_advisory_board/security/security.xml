<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_customer_advisory_board" model="ir.module.category">
        <field name="name">Customer Advisory Board Manager</field>
        <field name="sequence">697</field>
    </record>
    <record id="group_customer_advisory_board_user" model="res.groups">
        <field name="name">Customer Advisory Board Manager User</field>
        <field name="category_id" ref="module_category_customer_advisory_board"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>

    </record>
    <record id="group_customer_advisory_board_manager" model="res.groups">
        <field name="name">Customer Advisory Board Manager Manager</field>
        <field name="category_id" ref="module_category_customer_advisory_board"/>
        <field name="implied_ids" eval="[(4, ref('group_customer_advisory_board_user'))]"/>
    </record>
    <record id="rule_customer_advisory_board_sf_customer_advisory_board" model="ir.rule">
        <field name="name">Customer Advisory Board Manager: multi-company</field>
        <field name="model_id" ref="model_sf_customer_advisory_board"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_customer_advisory_board"/>
    </record>
</odoo>
