<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_customer_care_training" model="ir.module.category">
        <field name="name">Customer Care Training Tracker</field>
        <field name="sequence">262</field>
    </record>
    <record id="group_customer_care_training_user" model="res.groups">
        <field name="name">Customer Care Training Tracker User</field>
        <field name="category_id" ref="module_category_customer_care_training"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>

    </record>
    <record id="group_customer_care_training_manager" model="res.groups">
        <field name="name">Customer Care Training Tracker Manager</field>
        <field name="category_id" ref="module_category_customer_care_training"/>
        <field name="implied_ids" eval="[(4, ref('group_customer_care_training_user'))]"/>
    </record>
    <record id="rule_customer_care_training_sf_customer_care_training" model="ir.rule">
        <field name="name">Customer Care Training Tracker: multi-company</field>
        <field name="model_id" ref="model_sf_customer_care_training"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_customer_care_training"/>
    </record>
</odoo>
