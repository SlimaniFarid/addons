<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_sf_tp" model="ir.module.category">
        <field name="name">Transfer Pricing</field>
        <field name="sequence">94</field>
    </record>
    <record id="group_sf_tp_user" model="res.groups">
        <field name="name">Transfer Pricing User</field>
        <field name="category_id" ref="module_category_sf_tp"/>
        <field name="implied_ids" eval="[(4, ref('account.group_account_invoice'))]"/>
    </record>
    <record id="group_sf_tp_manager" model="res.groups">
        <field name="name">Transfer Pricing Manager</field>
        <field name="category_id" ref="module_category_sf_tp"/>
        <field name="implied_ids" eval="[(4, ref('group_sf_tp_user'))]"/>
    </record>
    <record id="rule_sf_tp_policy_company" model="ir.rule">
        <field name="name">TP Policy: multi-company</field>
        <field name="model_id" ref="model_sf_tp_policy"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
