<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_tp_policy" model="ir.actions.act_window">
        <field name="name">TP Policies</field>
        <field name="res_model">sf.tp.policy</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_sf_tp_transaction" model="ir.actions.act_window">
        <field name="name">Transaction Analysis</field>
        <field name="res_model">sf.tp.transaction</field>
        <field name="view_mode">list,form,pivot</field>
    </record>
    <record id="action_sf_tp_documentation" model="ir.actions.act_window">
        <field name="name">Documentation</field>
        <field name="res_model">sf.tp.documentation</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_sf_tp_policy_form" model="ir.ui.view">
        <field name="name">sf.tp.policy.form</field>
        <field name="model">sf.tp.policy</field>
        <field name="arch" type="xml">
            <form string="TP Policy">
                <header>
                    <button name="action_activate" type="object" string="Activate"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_expire" type="object" string="Expire"
                            invisible="state != 'active'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,active,expired"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="company_id"/>
                            <field name="counterpart_company_id"/>
                            <field name="ic_partner_id"/>
                        </group>
                        <group>
                            <field name="method"/>
                            <field name="markup_percent"
                                   invisible="method not in ('cost_plus','tnmm')"/>
                            <field name="target_margin_percent"
                                   invisible="method != 'resale_minus'"/>
                            <field name="review_threshold_percent"/>
                        </group>
                        <group>
                            <field name="valid_from"/>
                            <field name="valid_to"/>
                        </group>
                        <group>
                            <field name="documentation_ref"/>
                            <field name="apa_ref"/>
                        </group>
                    </group>
                    <group string="Method Notes / Benchmarking">
                        <field name="notes"/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_tp_policy_list" model="ir.ui.view">
        <field name="name">sf.tp.policy.list</field>
        <field name="model">sf.tp.policy</field>
        <field name="arch" type="xml">
            <list string="TP Policies" sample="1">
                <field name="name"/>
                <field name="company_id"/>
                <field name="counterpart_company_id"/>
                <field name="method"/>
                <field name="markup_percent" optional="show"/>
                <field name="valid_from"/>
                <field name="valid_to" optional="show"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'active'"/>
            </list>
        </field>
    </record>

    <record id="view_sf_tp_transaction_list" model="ir.ui.view">
        <field name="name">sf.tp.transaction.list</field>
        <field name="model">sf.tp.transaction</field>
        <field name="arch" type="xml">
            <list string="TP Transaction Analysis" sample="1"
                  decoration-danger="review_required and state == 'computed'">
                <field name="invoice_date"/>
                <field name="policy_id"/>
                <field name="product_id"/>
                <field name="quantity"/>
                <field name="actual_unit_price"/>
                <field name="computed_alp"/>
                <field name="variance_percent"/>
                <field name="review_required" widget="boolean"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'reviewed'"/>
            </list>
        </field>
    </record>

    <record id="view_sf_tp_documentation_form" model="ir.ui.view">
        <field name="name">sf.tp.documentation.form</field>
        <field name="model">sf.tp.documentation</field>
        <field name="arch" type="xml">
            <form string="TP Documentation">
                <header>
                    <button name="action_set_in_review" type="object"
                            string="Set In Review" invisible="state != 'draft'"/>
                    <button name="action_set_final" type="object"
                            string="Set Final" invisible="state != 'in_review'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,in_review,final"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="doc_type"/>
                            <field name="fiscal_year"/>
                            <field name="owner_id"/>
                        </group>
                        <group>
                            <field name="entity_scope" widget="many2many_tags"/>
                            <field name="review_date"/>
                            <field name="company_id"
                                   groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group string="Content / Sections">
                        <field name="content"/>
                    </group>
                    <group string="Supporting Files">
                        <field name="attachment_ids" widget="many2many_tags"/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_tp_documentation_list" model="ir.ui.view">
        <field name="name">sf.tp.documentation.list</field>
        <field name="model">sf.tp.documentation</field>
        <field name="arch" type="xml">
            <list string="TP Documentation" sample="1">
                <field name="name"/>
                <field name="doc_type"/>
                <field name="fiscal_year"/>
                <field name="owner_id"/>
                <field name="review_date"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'final'"/>
            </list>
        </field>
    </record>

    <menuitem id="menu_sf_tp_root" name="Transfer Pricing" sequence="44"
              parent="account.menu_finance_configuration"/>
    <menuitem id="menu_sf_tp_policies" name="Policies"
              parent="menu_sf_tp_root" action="action_sf_tp_policy" sequence="10"/>
    <menuitem id="menu_sf_tp_transactions" name="Transaction Analysis"
              parent="menu_sf_tp_root" action="action_sf_tp_transaction"
              sequence="20"/>
    <menuitem id="menu_sf_tp_docs" name="Documentation"
              parent="menu_sf_tp_root" action="action_sf_tp_documentation"
              sequence="30"/>
</odoo>
