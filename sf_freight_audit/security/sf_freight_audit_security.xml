<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_sf_freight_audit" model="ir.module.category">
        <field name="name">Freight Audit</field>
        <field name="description">Freight carrier invoice audit and recovery.</field>
        <field name="sequence">10</field>
    </record>

    <record id="group_sf_freight_audit_user" model="res.groups">
        <field name="name">Freight Audit / User</field>
        <field name="category_id" ref="module_category_sf_freight_audit"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_sf_freight_audit_manager" model="res.groups">
        <field name="name">Freight Audit / Manager</field>
        <field name="category_id" ref="module_category_sf_freight_audit"/>
        <field name="implied_ids" eval="[(4, ref('sf_freight_audit.group_sf_freight_audit_user'))]"/>
    </record>

    <!-- Record rules: multi-company isolation -->
    <record id="rule_sf_freight_contract_company" model="ir.rule">
        <field name="name">Freight Contract: user sees own company</field>
        <field name="model_id" ref="model_sf_freight_carrier_contract"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('sf_freight_audit.group_sf_freight_audit_user'))]"/>
    </record>
    <record id="rule_sf_freight_contract_manager_all" model="ir.rule">
        <field name="name">Freight Contract: manager sees all companies</field>
        <field name="model_id" ref="model_sf_freight_carrier_contract"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('sf_freight_audit.group_sf_freight_audit_manager'))]"/>
    </record>

    <record id="rule_sf_freight_invoice_company" model="ir.rule">
        <field name="name">Freight Invoice: user sees own company</field>
        <field name="model_id" ref="model_sf_freight_invoice"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('sf_freight_audit.group_sf_freight_audit_user'))]"/>
    </record>
    <record id="rule_sf_freight_invoice_manager_all" model="ir.rule">
        <field name="name">Freight Invoice: manager sees all companies</field>
        <field name="model_id" ref="model_sf_freight_invoice"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('sf_freight_audit.group_sf_freight_audit_manager'))]"/>
    </record>

    <record id="rule_sf_freight_dispute_company" model="ir.rule">
        <field name="name">Freight Dispute: user sees own company</field>
        <field name="model_id" ref="model_sf_freight_dispute"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('sf_freight_audit.group_sf_freight_audit_user'))]"/>
    </record>
    <record id="rule_sf_freight_dispute_manager_all" model="ir.rule">
        <field name="name">Freight Dispute: manager sees all companies</field>
        <field name="model_id" ref="model_sf_freight_dispute"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('sf_freight_audit.group_sf_freight_audit_manager'))]"/>
    </record>
    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_sf_freight_audit"/>
    </record>
</odoo>
