<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Minimal placeholder reports (QWeb-PDF) -->
    <template id="report_freight_invoice">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <div class="page">
                    <h2 t-out="doc.name"/>
                    <p t-out="doc.carrier_id.name"/>
                    <table class="table table-sm">
                        <thead><tr><th>Type</th><th>Billed</th><th>Expected</th><th>Variance</th></tr></thead>
                        <tbody>
                            <t t-foreach="doc.line_ids" t-as="line">
                                <tr>
                                    <td t-out="line.charge_type"/>
                                    <td t-out="line.amount_billed"/>
                                    <td t-out="line.amount_expected"/>
                                    <td t-out="line.variance"/>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </div>
            </t>
        </t>
    </template>

    <record id="action_report_freight_invoice" model="ir.actions.report">
        <field name="name">Freight Invoice Audit</field>
        <field name="model">sf.freight.invoice</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">sf_freight_audit.report_freight_invoice</field>
        <field name="report_file">sf_freight_audit.report_freight_invoice</field>
        <field name="binding_model_id" ref="model_sf_freight_invoice"/>
        <field name="binding_type">report</field>
    </record>
</odoo>
