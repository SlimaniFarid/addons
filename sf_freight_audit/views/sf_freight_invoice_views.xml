<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Invoice -->
    <record id="view_sf_freight_invoice_list" model="ir.ui.view">
        <field name="name">sf.freight.invoice.list</field>
        <field name="model">sf.freight.invoice</field>
        <field name="arch" type="xml">
            <list string="Carrier Invoices" decoration-danger="open_finding_count > 0">
                <field name="name"/>
                <field name="carrier_id"/>
                <field name="invoice_ref"/>
                <field name="invoice_date"/>
                <field name="total_declared" sum="Total"/>
                <field name="total_expected" sum="Total"/>
                <field name="total_variance" sum="Total"/>
                <field name="open_finding_count"/>
                <field name="state" widget="badge"
                       decoration-success="state in ('validated', 'paid', 'resolved')"
                       decoration-danger="state == 'discrepancy'"
                       decoration-muted="state == 'cancelled'"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_sf_freight_invoice_form" model="ir.ui.view">
        <field name="name">sf.freight.invoice.form</field>
        <field name="model">sf.freight.invoice</field>
        <field name="arch" type="xml">
            <form string="Freight Invoice">
                <header>
                    <button name="action_run_audit" string="Run Audit" type="object"
                            class="btn-primary"
                            invisible="state not in ('draft', 'imported', 'matched')"/>
                    <button name="action_mark_validated" string="Validate" type="object"
                            class="btn-primary"
                            invisible="state not in ('matched', 'discrepancy')"/>
                    <button name="action_validate_payment" string="Mark Paid" type="object"
                            invisible="state != 'validated'"/>
                    <button name="action_cancel" string="Cancel" type="object"
                            invisible="state in ('paid', 'cancelled')"/>
                    <field name="state" widget="statusbar" readonly="1"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="carrier_id"/>
                            <field name="contract_id"/>
                            <field name="invoice_ref"/>
                            <field name="source" readonly="1"/>
                        </group>
                        <group>
                            <field name="invoice_date"/>
                            <field name="currency_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="total_declared"/>
                            <field name="total_expected"/>
                        </group>
                        <group>
                            <field name="total_variance"/>
                            <field name="open_finding_count"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Lines">
                            <field name="line_ids" readonly="state not in ('draft', 'imported')">
                                <list editable="bottom">
                                    <field name="charge_type"/>
                                    <field name="description"/>
                                    <field name="tracking_ref"/>
                                    <field name="ship_date"/>
                                    <field name="uom_weight"/>
                                    <field name="amount_billed"/>
                                    <field name="amount_expected"/>
                                    <field name="variance"/>
                                    <field name="status"/>
                                </list>
                            </field>
                        </page>
                        <page string="Findings">
                            <field name="finding_ids" readonly="1">
                                <list>
                                    <field name="finding_type"/>
                                    <field name="severity" widget="badge"
                                           decoration-danger="severity == 'critical'"
                                           decoration-warning="severity == 'high'"/>
                                    <field name="expected_amount"/>
                                    <field name="actual_amount"/>
                                    <field name="variance_amount"/>
                                    <field name="status" widget="badge"/>
                                </list>
                            </field>
                        </page>
                        <page string="Disputes">
                            <field name="dispute_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="amount_claimed"/>
                                    <field name="state" widget="badge"/>
                                    <field name="resolution_type"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_sf_freight_invoice_search" model="ir.ui.view">
        <field name="name">sf.freight.invoice.search</field>
        <field name="model">sf.freight.invoice</field>
        <field name="arch" type="xml">
            <search string="Invoices">
                <field name="name"/>
                <field name="invoice_ref"/>
                <field name="carrier_id"/>
                <filter name="discrepancy" string="Discrepancy" domain="[('state', '=', 'discrepancy')]"/>
                <filter name="with_findings" string="Open Findings" domain="[('open_finding_count', '>', 0)]"/>
                <group expand="0" string="Group By">
                    <filter name="by_carrier" string="Carrier" context="{'group_by': 'carrier_id'}"/>
                    <filter name="by_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="by_month" string="Month" context="{'group_by': 'invoice_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_sf_freight_invoice_pivot" model="ir.ui.view">
        <field name="name">sf.freight.invoice.pivot</field>
        <field name="model">sf.freight.invoice</field>
        <field name="arch" type="xml">
            <pivot string="Invoice Analysis">
                <field name="carrier_id" type="row"/>
                <field name="invoice_date" type="col" interval="month"/>
                <field name="total_variance" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="action_sf_freight_invoice" model="ir.actions.act_window">
        <field name="name">Carrier Invoices</field>
        <field name="res_model">sf.freight.invoice</field>
        <field name="view_mode">list,form,pivot</field>
    </record>
</odoo>
