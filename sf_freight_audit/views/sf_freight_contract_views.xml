<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Contract -->
    <record id="view_sf_freight_contract_list" model="ir.ui.view">
        <field name="name">sf.freight.carrier.contract.list</field>
        <field name="model">sf.freight.carrier.contract</field>
        <field name="arch" type="xml">
            <list string="Carrier Contracts">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="tolerance_pct"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'active'"
                       decoration-muted="state in ('draft', 'archived')"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_sf_freight_contract_form" model="ir.ui.view">
        <field name="name">sf.freight.carrier.contract.form</field>
        <field name="model">sf.freight.carrier.contract</field>
        <field name="arch" type="xml">
            <form string="Carrier Contract">
                <header>
                    <button name="action_activate" string="Activate" type="object"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_archive" string="Archive" type="object"
                            invisible="state not in ('active', 'expired')"/>
                    <field name="state" widget="statusbar" readonly="1"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="currency_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <field name="tolerance_pct"/>
                            <field name="warn_pct"/>
                            <field name="high_pct"/>
                            <field name="crit_pct"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Rate Grid">
                            <field name="rate_line_ids">
                                <list editable="bottom">
                                    <field name="service_level"/>
                                    <field name="zone_from"/>
                                    <field name="zone_to"/>
                                    <field name="weight_from"/>
                                    <field name="weight_to"/>
                                    <field name="base_price"/>
                                    <field name="price_per_kg"/>
                                    <field name="min_charge"/>
                                </list>
                            </field>
                        </page>
                        <page string="Allowed Surcharges">
                            <field name="allowed_surcharge_ids">
                                <list editable="bottom">
                                    <field name="charge_type"/>
                                    <field name="max_pct"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_sf_freight_contract_search" model="ir.ui.view">
        <field name="name">sf.freight.carrier.contract.search</field>
        <field name="model">sf.freight.carrier.contract</field>
        <field name="arch" type="xml">
            <search string="Contracts">
                <field name="name"/>
                <field name="partner_id"/>
                <filter name="active" string="Active" domain="[('state', '=', 'active')]"/>
                <group expand="0" string="Group By">
                    <filter name="by_carrier" string="Carrier" context="{'group_by': 'partner_id'}"/>
                    <filter name="by_state" string="Status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_sf_freight_contract" model="ir.actions.act_window">
        <field name="name">Carrier Contracts</field>
        <field name="res_model">sf.freight.carrier.contract</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="wave_final_sf_freight_audit" model="ir.actions.server">
        <field name="name">Refresh Business Data</field>
        <field name="model_id" ref="model_sf_freight_carrier_contract"/>
        <field name="binding_model_id" ref="model_sf_freight_carrier_contract"/>
        <field name="state">code</field>
        <field name="code">records.action_refresh_business()</field>
    </record>
</odoo>
