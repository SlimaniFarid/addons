<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_sf_freight_invoice" model="ir.sequence">
            <field name="name">Freight Invoice</field>
            <field name="code">sf.freight.invoice</field>
            <field name="prefix">FAU-</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="seq_sf_freight_dispute" model="ir.sequence">
            <field name="name">Freight Dispute</field>
            <field name="code">sf.freight.dispute</field>
            <field name="prefix">DPT-</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="seq_sf_freight_contract" model="ir.sequence">
            <field name="name">Freight Contract</field>
            <field name="code">sf.freight.carrier.contract</field>
            <field name="prefix">FCT-</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="cron_sf_freight_dispute_escalation" model="ir.cron">
            <field name="name">Freight Audit: Dispute Escalation</field>
            <field name="model_id" ref="model_sf_freight_dispute"/>
            <field name="function">_cron_dispute_escalation</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="doall" eval="False"/>
        </record>
    </data>
</odoo>
