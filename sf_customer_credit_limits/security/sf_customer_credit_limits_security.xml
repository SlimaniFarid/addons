<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_sf_customer_credit_limits" model="ir.module.category">
        <field name="name">Customer Credit Limits</field>
        <field name="description">Customer Credit Limits</field>
        <field name="sequence">10</field>
    </record>
    <record id="group_customer_credit_limits_user" model="res.groups">
        <field name="name">Customer Credit Limits / User</field>
        <field name="category_id" ref="module_category_sf_customer_credit_limits"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_customer_credit_limits_manager" model="res.groups">
        <field name="name">Customer Credit Limits / Manager</field>
        <field name="category_id" ref="module_category_sf_customer_credit_limits"/>
        <field name="implied_ids" eval="[(4, ref('sf_customer_credit_limits.group_customer_credit_limits_user'))]"/>
    </record>
</odoo>
