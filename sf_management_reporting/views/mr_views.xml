<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_mgmt_report" model="ir.actions.act_window">
        <field name="name">Management Reports</field>
        <field name="res_model">sf.mgmt.report</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="view_sf_mgmt_report_form" model="ir.ui.view">
        <field name="name">sf.mgmt.report.form</field>
        <field name="model">sf.mgmt.report</field>
        <field name="arch" type="xml">
            <form string="Management Report">
                <header>
                    <button name="action_compute" type="object"
                            string="Compute KPIs" class="btn-primary"
                            invisible="state == 'final'"/>
                    <button name="action_finalize" type="object"
                            string="Finalize" invisible="state != 'computed'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,computed,final"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="period_start"/>
                            <field name="period_end"/>
                            <field name="invoice_count" readonly="1"/>
                        </group>
                        <group>
                            <field name="revenue" readonly="1"/>
                            <field name="costs" readonly="1"/>
                            <field name="gross_margin" readonly="1"/>
                            <field name="margin_percent" readonly="1"/>
                            <field name="prev_revenue" readonly="1"/>
                            <field name="revenue_delta_percent" readonly="1"/>
                        </group>
                    </group>
                    <field name="line_ids" readonly="state == 'final'">
                        <list editable="bottom">
                            <field name="name"/>
                            <field name="value"/>
                            <field name="previous_value"/>
                            <field name="delta_percent" readonly="1"/>
                            <field name="comment"/>
                        </list>
                    </field>
                    <group string="Executive Commentary">
                        <field name="commentary"/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_mgmt_report_list" model="ir.ui.view">
        <field name="name">sf.mgmt.report.list</field>
        <field name="model">sf.mgmt.report</field>
        <field name="arch" type="xml">
            <list string="Management Reports" sample="1">
                <field name="name"/>
                <field name="period_start"/>
                <field name="revenue"/>
                <field name="gross_margin"/>
                <field name="margin_percent"/>
                <field name="revenue_delta_percent"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'final'"/>
            </list>
        </field>
    </record>
    <menuitem id="menu_sf_mr_root" name="Management Reporting" sequence="22"
              parent="account.menu_finance_reports"/>
    <menuitem id="menu_sf_mr_reports" name="Monthly Report Pack"
              parent="menu_sf_mr_root" action="action_sf_mgmt_report"
              sequence="10"/>
</odoo>
