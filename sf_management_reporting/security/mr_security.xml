<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_sf_mr" model="ir.module.category">
        <field name="name">Management Reporting</field>
        <field name="sequence">72</field>
    </record>
    <record id="group_sf_mr_user" model="res.groups">
        <field name="name">Management Reporting User</field>
        <field name="category_id" ref="module_category_sf_mr"/>
        <field name="implied_ids" eval="[(4, ref('account.group_account_invoice'))]"/>
    </record>
    <record id="group_sf_mr_manager" model="res.groups">
        <field name="name">Management Reporting Manager</field>
        <field name="category_id" ref="module_category_sf_mr"/>
        <field name="implied_ids" eval="[(4, ref('group_sf_mr_user'))]"/>
    </record>
    <record id="rule_sf_mr_company" model="ir.rule">
        <field name="name">Management Report: multi-company</field>
        <field name="model_id" ref="model_sf_mgmt_report"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
