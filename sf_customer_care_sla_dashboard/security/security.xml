<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_customer_care_sla_dashboard" model="ir.module.category">
        <field name="name">Care SLA Dashboard Config</field>
        <field name="sequence">477</field>
    </record>
    <record id="group_customer_care_sla_dashboard_user" model="res.groups">
        <field name="name">Care SLA Dashboard Config User</field>
        <field name="category_id" ref="module_category_customer_care_sla_dashboard"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>

    </record>
    <record id="group_customer_care_sla_dashboard_manager" model="res.groups">
        <field name="name">Care SLA Dashboard Config Manager</field>
        <field name="category_id" ref="module_category_customer_care_sla_dashboard"/>
        <field name="implied_ids" eval="[(4, ref('group_customer_care_sla_dashboard_user'))]"/>
    </record>
    <record id="rule_customer_care_sla_dashboard_sf_customer_care_sla_dashboard" model="ir.rule">
        <field name="name">Care SLA Dashboard Config: multi-company</field>
        <field name="model_id" ref="model_sf_customer_care_sla_dashboard"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
