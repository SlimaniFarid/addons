<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_mes_shop_floor" model="ir.module.category">
        <field name="name">MES / Shop Floor</field>
        <field name="sequence">96</field>
    </record>

    <record id="group_mes_shop_floor_user" model="res.groups">
        <field name="name">MES User</field>
        <field name="category_id" ref="module_category_mes_shop_floor"/>
        <field name="implied_ids" eval="[(4, ref('mrp.group_mrp_user'))]"/>
    </record>

    <record id="group_mes_shop_floor_manager" model="res.groups">
        <field name="name">MES Manager</field>
        <field name="category_id" ref="module_category_mes_shop_floor"/>
        <field name="implied_ids" eval="[(4, ref('group_mes_shop_floor_user'))]"/>
    </record>
    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_mes_shop_floor"/>
    </record>
</odoo>