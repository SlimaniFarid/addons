<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_sf_inc" model="ir.module.category">
        <field name="name">Incident Management</field>
        <field name="sequence">71</field>
    </record>
    <record id="group_sf_inc_user" model="res.groups">
        <field name="name">Incident Reporter</field>
        <field name="category_id" ref="module_category_sf_inc"/>
    </record>
    <record id="group_sf_inc_manager" model="res.groups">
        <field name="name">Incident Manager</field>
        <field name="category_id" ref="module_category_sf_inc"/>
        <field name="implied_ids" eval="[(4, ref('group_sf_inc_user'))]"/>
    </record>
    <record id="rule_sf_inc_company" model="ir.rule">
        <field name="name">Incident: multi-company</field>
        <field name="model_id" ref="model_sf_incident"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_sf_inc"/>
    </record>
</odoo>
