<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_customer_care_sla_rules" model="ir.module.category">
        <field name="name">SLA Rules Engine</field>
        <field name="sequence">462</field>
    </record>
    <record id="group_customer_care_sla_rules_user" model="res.groups">
        <field name="name">SLA Rules Engine User</field>
        <field name="category_id" ref="module_category_customer_care_sla_rules"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>

    </record>
    <record id="group_customer_care_sla_rules_manager" model="res.groups">
        <field name="name">SLA Rules Engine Manager</field>
        <field name="category_id" ref="module_category_customer_care_sla_rules"/>
        <field name="implied_ids" eval="[(4, ref('group_customer_care_sla_rules_user'))]"/>
    </record>
    <record id="rule_customer_care_sla_rules_sf_customer_care_sla_rules" model="ir.rule">
        <field name="name">SLA Rules Engine: multi-company</field>
        <field name="model_id" ref="model_sf_customer_care_sla_rules"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_customer_care_sla_rules"/>
    </record>
</odoo>
