<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_ic_session" model="ir.actions.act_window">
        <field name="name">Netting Sessions</field>
        <field name="res_model">sf.ic.netting.session</field>
        <field name="view_mode">kanban,list,form</field>
    </record>

    <record id="view_sf_ic_session_form" model="ir.ui.view">
        <field name="name">sf.ic.netting.session.form</field>
        <field name="model">sf.ic.netting.session</field>
        <field name="arch" type="xml">
            <form string="Netting Session">
                <header>
                    <button name="action_compute" type="object"
                            string="Compute Positions" class="btn-primary"
                            invisible="state not in ('draft','computed')"/>
                    <button name="action_confirm" type="object"
                            string="Confirm" invisible="state != 'computed'"/>
                    <button name="action_settle" type="object"
                            string="Settle Net Amounts"
                            class="btn-primary" invisible="state != 'confirmed'"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state in ('settled','cancelled')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,computed,confirmed,settled"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="period_start"/>
                            <field name="period_end"/>
                            <field name="company_id"
                                   groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="company_ids" widget="many2many_tags"/>
                            <field name="dispute_count" readonly="1"/>
                            <field name="total_net" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Net Positions" name="positions">
                            <field name="line_ids" readonly="1">
                                <list create="0" delete="0">
                                    <field name="company_id"/>
                                    <field name="counterpart_company_id"/>
                                    <field name="gross_receivable"/>
                                    <field name="gross_payable"/>
                                    <field name="net_amount"/>
                                    <field name="item_count"/>
                                </list>
                            </field>
                        </page>
                        <page string="Disputed Items" name="disputes">
                            <field name="dispute_ids">
                                <list editable="bottom">
                                    <field name="move_line_id"/>
                                    <field name="reason"/>
                                    <field name="state"/>
                                    <field name="resolved_notes"/>
                                </list>
                            </field>
                        </page>
                        <page string="Settlement Entries" name="settlement"
                              invisible="state != 'settled'">
                            <field name="settlement_move_ids">
                                <list create="0">
                                    <field name="name"/>
                                    <field name="date"/>
                                    <field name="ref"/>
                                    <field name="amount_total_in_company_currency"
                                           string="Amount"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                    <group string="Notes">
                        <field name="notes"/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_ic_session_list" model="ir.ui.view">
        <field name="name">sf.ic.netting.session.list</field>
        <field name="model">sf.ic.netting.session</field>
        <field name="arch" type="xml">
            <list string="Netting Sessions" sample="1">
                <field name="name"/>
                <field name="period_start"/>
                <field name="period_end"/>
                <field name="total_net"/>
                <field name="dispute_count" optional="show"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'settled'"/>
            </list>
        </field>
    </record>

    <menuitem id="menu_sf_ic_root" name="IC Netting" sequence="43"
              parent="account.menu_finance_entries"/>
    <menuitem id="menu_sf_ic_sessions" name="Netting Sessions"
              parent="menu_sf_ic_root" action="action_sf_ic_session"
              sequence="10"/>

    <record id="view_sf_ic_netting_boost_kanban" model="ir.ui.view">
        <field name="name">sf_ic_netting.boost.kanban</field>
        <field name="model">sf.ic.netting.session</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" t-att-color="state">
                <field name="name"/>
                <field name="state"/>
                <field name="user_id"/>

                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_card oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title">
                                    <field name="name"/></strong>
                                <div class="o_kanban_record_subtitle">
                                    <field name="user_id" widget="many2one_avatar_user"/>
                                    <field name="create_date"/></div>
                            </div>
                            <div class="oe_kanban_bottom_right">
                                <field name="state" widget="badge"
                                       t-attf-options="{'classes_map': {'draft': 'info', 'done': 'success', 'cancelled': 'danger'}, 'domain': []}"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_sf_ic_netting_boost_search" model="ir.ui.view">
        <field name="name">sf_ic_netting.boost.search</field>
        <field name="model">sf.ic.netting.session</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
<separator/>
                <filter string="My records" name="my_records" domain="[('user_id', '=', uid)]"/>
                <filter string="To Do" name="todo" domain="[('state', 'not in', ('done', 'cancelled', 'closed'))]"/>
                <group expand="0" string="Group By"><filter string="Status" name="gb_state" context="{'group_by': 'state'}"/></group>
            </search>
        </field>
    </record>
</odoo>
