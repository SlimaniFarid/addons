<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_sf_ic" model="ir.module.category">
        <field name="name">Intercompany Netting</field>
        <field name="sequence">93</field>
    </record>
    <record id="group_sf_ic_user" model="res.groups">
        <field name="name">IC Netting User</field>
        <field name="category_id" ref="module_category_sf_ic"/>
        <field name="implied_ids" eval="[(4, ref('account.group_account_invoice'))]"/>
    </record>
    <record id="group_sf_ic_manager" model="res.groups">
        <field name="name">IC Netting Manager</field>
        <field name="category_id" ref="module_category_sf_ic"/>
        <field name="implied_ids" eval="[(4, ref('group_sf_ic_user'))]"/>
    </record>
    <record id="rule_sf_ic_session_company" model="ir.rule">
        <field name="name">IC Netting Session: multi-company</field>
        <field name="model_id" ref="model_sf_ic_netting_session"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_sf_ic"/>
    </record>
</odoo>
