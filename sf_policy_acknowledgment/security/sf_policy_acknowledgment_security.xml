<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="module_category_sf_policy_acknowledgment" model="ir.module.category">
            <field name="name">Policy Acknowledgment</field>
            <field name="description">Company policy and employee acknowledgment register.</field>
            <field name="sequence">10</field>
        </record>

        <record id="group_sf_policy_user" model="res.groups">
            <field name="name">Policy / User</field>
            <field name="category_id" ref="module_category_sf_policy_acknowledgment"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_sf_policy_manager" model="res.groups">
            <field name="name">Policy / Manager</field>
            <field name="category_id" ref="module_category_sf_policy_acknowledgment"/>
            <field name="implied_ids" eval="[(4, ref('sf_policy_acknowledgment.group_sf_policy_user'))]"/>
        </record>

        <record id="rule_sf_policy_company" model="ir.rule">
            <field name="name">Policy: user sees own company</field>
            <field name="model_id" ref="model_sf_policy"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('sf_policy_acknowledgment.group_sf_policy_user'))]"/>
        </record>
        <record id="rule_sf_policy_manager_all" model="ir.rule">
            <field name="name">Policy: manager sees all companies</field>
            <field name="model_id" ref="model_sf_policy"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('sf_policy_acknowledgment.group_sf_policy_manager'))]"/>
        </record>

        <record id="rule_sf_policy_acknowledgment_company" model="ir.rule">
            <field name="name">Acknowledgment: user sees own company</field>
            <field name="model_id" ref="model_sf_policy_acknowledgment"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('sf_policy_acknowledgment.group_sf_policy_user'))]"/>
        </record>
        <record id="rule_sf_policy_acknowledgment_manager_all" model="ir.rule">
            <field name="name">Acknowledgment: manager sees all companies</field>
            <field name="model_id" ref="model_sf_policy_acknowledgment"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('sf_policy_acknowledgment.group_sf_policy_manager'))]"/>
        </record>
    </data>
</odoo>