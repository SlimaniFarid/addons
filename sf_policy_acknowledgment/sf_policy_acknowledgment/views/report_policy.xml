<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_policy">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-set="company" t-value="o.company_id or res_company"/>
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>Company Policy</h2>
                        <table class="table table-sm">
                            <tr><th>Name</th><td><span t-field="o.name"/></td></tr>
                            <tr><th>Category</th><td><span t-field="o.policy_type"/></td></tr>
                            <tr><th>Version</th><td><span t-field="o.version"/></td></tr>
                            <tr><th>Effective Date</th><td><span t-field="o.effective_date"/></td></tr>
                            <tr><th>Expiry Date</th><td><span t-field="o.expiry_date"/></td></tr>
                            <tr><th>Owner</th><td><span t-field="o.owner_id"/></td></tr>
                            <tr><th>Status</th><td><span t-field="o.state"/></td></tr>
                        </table>
                        <h3>Content</h3>
                        <div t-field="o.body"/>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>