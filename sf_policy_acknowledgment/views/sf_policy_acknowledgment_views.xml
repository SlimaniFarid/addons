<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sf_policy_acknowledgment_view_list" model="ir.ui.view">
        <field name="name">sf.policy.acknowledgment.list</field>
        <field name="model">sf.policy.acknowledgment</field>
        <field name="arch" type="xml">
            <list decoration-danger="is_overdue" string="Policy Acknowledgment Register">
                <field name="name"/>
                <field name="policy_id"/>
                <field name="employee_id"/>
                <field name="state" widget="badge"/>
                <field name="acknowledged_date"/>
                <field name="acknowledged_by"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="sf_policy_acknowledgment_view_form" model="ir.ui.view">
        <field name="name">sf.policy.acknowledgment.form</field>
        <field name="model">sf.policy.acknowledgment</field>
        <field name="arch" type="xml">
            <form string="Policy Acknowledgment">
                <header>
                    <button name="action_acknowledge" string="Acknowledge" type="object" class="btn-primary" invisible="[('state', '!=', 'pending')]"/>
                    <field name="state" widget="statusbar" readonly="1"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="policy_id"/>
                            <field name="employee_id"/>
                        </group>
                        <group>
                            <field name="acknowledged_date"/>
                            <field name="acknowledged_by"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="sf_policy_acknowledgment_view_search" model="ir.ui.view">
        <field name="name">sf.policy.acknowledgment.search</field>
        <field name="model">sf.policy.acknowledgment</field>
        <field name="arch" type="xml">
            <search string="Policy Acknowledgment Register">
                <field name="name"/>
                <field name="policy_id"/>
                <field name="employee_id"/>
                <filter name="ack_pending" string="Pending" domain="[('state', '=', 'pending')]"/>
                <filter name="ack_acknowledged" string="Acknowledged" domain="[('state', '=', 'acknowledged')]"/>
                <group>
                    <filter name="group_ack_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_ack_policy" string="Policy" context="{'group_by': 'policy_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_sf_policy_acknowledgment" model="ir.actions.act_window">
        <field name="name">Acknowledgment Register</field>
        <field name="res_model">sf.policy.acknowledgment</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="sf_policy_acknowledgment_view_search"/>
    </record>

    <record id="view_sf_policy_acknowledgment_boost_kanban" model="ir.ui.view">
        <field name="name">sf_policy_acknowledgment.boost.kanban</field>
        <field name="model">sf.policy</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" t-att-color="state">
                <field name="name"/>
                <field name="state"/>
                <field name="expiry_date"/>
                <field name="is_overdue" invisible="1"/>

                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_card oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title">
                                    <field name="name"/></strong>
                                <div class="o_kanban_record_subtitle">
                                    <field name="user_id" widget="many2one_avatar_user"/>
                                    <field name="expiry_date"/></div>
                            </div>
                            <div class="oe_kanban_bottom_right">
                                <field name="state" widget="badge"
                                       t-attf-options="{'classes_map': {'draft': 'info', 'done': 'success', 'cancelled': 'danger'}, 'domain': []}"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_sf_policy_acknowledgment_boost_search" model="ir.ui.view">
        <field name="name">sf_policy_acknowledgment.boost.search</field>
        <field name="model">sf.policy</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
<separator/>
                <filter string="To Do" name="todo" domain="[('state', 'not in', ('done', 'cancelled', 'closed'))]"/>
                <group expand="0" string="Group By"><filter string="Status" name="gb_state" context="{'group_by': 'state'}"/></group>
            </search>
        </field>
    </record>
</odoo>