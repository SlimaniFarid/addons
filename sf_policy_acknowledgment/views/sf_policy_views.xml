<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sf_policy_view_list" model="ir.ui.view">
        <field name="name">sf.policy.list</field>
        <field name="model">sf.policy</field>
        <field name="arch" type="xml">
            <list decoration-danger="is_overdue" string="Company Policies">
                <field name="name"/>
                <field name="policy_type"/>
                <field name="version"/>
                <field name="effective_date"/>
                <field name="expiry_date"/>
                <field name="acknowledgment_rate" widget="progressbar"/>
                <field name="state" widget="badge"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="sf_policy_view_form" model="ir.ui.view">
        <field name="name">sf.policy.form</field>
        <field name="model">sf.policy</field>
        <field name="arch" type="xml">
            <form string="Company Policy">
                <header>
                    <button name="action_publish" string="Publish" type="object" class="btn-primary" invisible="[('state', '!=', 'draft')]" groups="sf_policy_acknowledgment.group_sf_policy_manager"/>
                    <button name="action_retire" string="Retire" type="object" invisible="[('state', '!=', 'published')]" groups="sf_policy_acknowledgment.group_sf_policy_manager"/>
                    <button name="action_archive" string="Archive" type="object" invisible="[('state', '!=', 'retired')]" groups="sf_policy_acknowledgment.group_sf_policy_manager"/>
                    <field name="state" widget="statusbar" readonly="1"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="policy_type"/>
                            <field name="version"/>
                            <field name="owner_id"/>
                        </group>
                        <group>
                            <field name="effective_date"/>
                            <field name="expiry_date"/>
                            <field name="acknowledgment_rate"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group string="Content">
                        <field name="body" widget="html"/>
                    </group>
                    <group string="Assignment">
                        <field name="employee_ids" widget="many2many_tags"/>
                    </group>
                    <notebook>
                        <page string="Acknowledgment Register">
                            <field name="acknowledgment_ids">
                                <list string="Acknowledgments">
                                    <field name="name"/>
                                    <field name="employee_id"/>
                                    <field name="state" widget="badge"/>
                                    <field name="acknowledged_date"/>
                                    <field name="acknowledged_by"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="sf_policy_view_search" model="ir.ui.view">
        <field name="name">sf.policy.search</field>
        <field name="model">sf.policy</field>
        <field name="arch" type="xml">
            <search string="Company Policies">
                <field name="name"/>
                <field name="policy_type"/>
                <field name="employee_ids"/>
                <filter name="policy_published" string="Published" domain="[('state', '=', 'published')]"/>
                <filter name="policy_draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <group>
                    <filter name="group_policy_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_policy_type" string="Category" context="{'group_by': 'policy_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_sf_policy" model="ir.actions.act_window">
        <field name="name">Company Policies</field>
        <field name="res_model">sf.policy</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="sf_policy_view_search"/>
    </record>

    <record id="view_sf_policy_acknowledgment_boost_kanban" model="ir.ui.view">
        <field name="name">sf_policy_acknowledgment.boost.kanban</field>
        <field name="model">sf.policy</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" t-att-color="state">
                <field name="name"/>
                <field name="state"/>
                <field name="expiry_date"/>
                <field name="is_overdue" invisible="1"/>

                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_card oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title">
                                    <field name="name"/></strong>
                                <div class="o_kanban_record_subtitle">
                                    <field name="user_id" widget="many2one_avatar_user"/>
                                    <field name="expiry_date"/></div>
                            </div>
                            <div class="oe_kanban_bottom_right">
                                <field name="state" widget="badge"
                                       t-attf-options="{'classes_map': {'draft': 'info', 'done': 'success', 'cancelled': 'danger'}, 'domain': []}"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_sf_policy_acknowledgment_boost_search" model="ir.ui.view">
        <field name="name">sf_policy_acknowledgment.boost.search</field>
        <field name="model">sf.policy</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
<separator/>
                <filter string="To Do" name="todo" domain="[('state', 'not in', ('done', 'cancelled', 'closed'))]"/>
                <group expand="0" string="Group By"><filter string="Status" name="gb_state" context="{'group_by': 'state'}"/></group>
            </search>
        </field>
    </record>
</odoo>