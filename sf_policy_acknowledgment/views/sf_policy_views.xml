<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sf_policy_view_list" model="ir.ui.view">
        <field name="name">sf.policy.list</field>
        <field name="model">sf.policy</field>
        <field name="arch" type="xml">
            <list string="Company Policies">
                <field name="name"/>
                <field name="policy_type"/>
                <field name="version"/>
                <field name="effective_date"/>
                <field name="expiry_date"/>
                <field name="acknowledgment_rate" widget="progressbar"/>
                <field name="state" widget="badge"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="sf_policy_view_form" model="ir.ui.view">
        <field name="name">sf.policy.form</field>
        <field name="model">sf.policy</field>
        <field name="arch" type="xml">
            <form string="Company Policy">
                <header>
                    <button name="action_publish" string="Publish" type="object" class="btn-primary" invisible="[('state', '!=', 'draft')]"/>
                    <button name="action_retire" string="Retire" type="object" invisible="[('state', '!=', 'published')]"/>
                    <button name="action_archive" string="Archive" type="object" invisible="[('state', '!=', 'retired')]"/>
                    <field name="state" widget="statusbar" readonly="1"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="policy_type"/>
                            <field name="version"/>
                            <field name="owner_id"/>
                        </group>
                        <group>
                            <field name="effective_date"/>
                            <field name="expiry_date"/>
                            <field name="acknowledgment_rate"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group string="Content">
                        <field name="body" widget="html"/>
                    </group>
                    <group string="Assignment">
                        <field name="employee_ids" widget="many2many_tags"/>
                    </group>
                    <notebook>
                        <page string="Acknowledgment Register">
                            <field name="acknowledgment_ids">
                                <list string="Acknowledgments">
                                    <field name="name"/>
                                    <field name="employee_id"/>
                                    <field name="state" widget="badge"/>
                                    <field name="acknowledged_date"/>
                                    <field name="acknowledged_by"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="sf_policy_view_search" model="ir.ui.view">
        <field name="name">sf.policy.search</field>
        <field name="model">sf.policy</field>
        <field name="arch" type="xml">
            <search string="Company Policies">
                <field name="name"/>
                <field name="policy_type"/>
                <field name="employee_ids"/>
                <filter name="policy_published" string="Published" domain="[('state', '=', 'published')]"/>
                <filter name="policy_draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <group>
                    <filter name="group_policy_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_policy_type" string="Category" context="{'group_by': 'policy_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_sf_policy" model="ir.actions.act_window">
        <field name="name">Company Policies</field>
        <field name="res_model">sf.policy</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="sf_policy_view_search"/>
    </record>
</odoo>