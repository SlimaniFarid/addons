<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_supplier_contract_database" model="ir.actions.act_window">
        <field name="name">Supplier Contract Database</field>
        <field name="res_model">sf.supplier_contract_database</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
    <record id="view_sf_supplier_contract_database_form" model="ir.ui.view">
        <field name="name">sf.supplier_contract_database.form</field>
        <field name="model">sf.supplier_contract_database</field>
        <field name="arch" type="xml">
            <form string="Supplier Contract Database">
                <header>
                    <button name="action_submitted" type="object" string="Submitted"
                            class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="vendor_id"/>
                            <field name="contract_ref"/>
                            <field name="contract_type"/>
                            <field name="value"/>
                            <field name="start_date"/>
                            <field name="end_date"/>
                        <field name="key_clauses"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_supplier_contract_database_list" model="ir.ui.view">
        <field name="name">sf.supplier_contract_database.list</field>
        <field name="model">sf.supplier_contract_database</field>
        <field name="arch" type="xml">
            <list string="Supplier Contract Database" sample="1">
                <field name="vendor_id"/>
                <field name="contract_ref"/>
                <field name="contract_type"/>
                <field name="value"/>
                <field name="start_date"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state in ('submitted','approved')"/>
            </list>
        </field>
    </record>
    <record id="view_sf_supplier_contract_database_kanban" model="ir.ui.view">
        <field name="name">sf.supplier_contract_database.kanban</field>
        <field name="model">sf.supplier_contract_database</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_view" group_by="state">
                <field name="name"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <menuitem id="menu_sf_supplier_contract_database_root" name="Supplier Contract Database" sequence="2"
              web_icon="sf_supplier_contract_database,static/description/icon.png"/>
    <menuitem id="menu_sf_supplier_contract_database_main" name="Records"
              parent="menu_sf_supplier_contract_database_root" action="action_sf_supplier_contract_database" sequence="10"/>

    <record id="wave_final_sf_supplier_contract_database" model="ir.actions.server">
        <field name="name">Refresh Business Data</field>
        <field name="model_id" ref="model_sf_supplier_contract_database"/>
        <field name="binding_model_id" ref="model_sf_supplier_contract_database"/>
        <field name="state">code</field>
        <field name="code">records.action_refresh_business()</field>
    </record>
</odoo>
