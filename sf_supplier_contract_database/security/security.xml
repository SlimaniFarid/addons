<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_supplier_contract_database" model="ir.module.category">
        <field name="name">Supplier Contract Database</field>
        <field name="sequence">469</field>
    </record>
    <record id="group_supplier_contract_database_user" model="res.groups">
        <field name="name">Supplier Contract Database User</field>
        <field name="category_id" ref="module_category_supplier_contract_database"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>

    </record>
    <record id="group_supplier_contract_database_manager" model="res.groups">
        <field name="name">Supplier Contract Database Manager</field>
        <field name="category_id" ref="module_category_supplier_contract_database"/>
        <field name="implied_ids" eval="[(4, ref('group_supplier_contract_database_user'))]"/>
    </record>
    <record id="rule_supplier_contract_database_sf_supplier_contract_database" model="ir.rule">
        <field name="name">Supplier Contract Database: multi-company</field>
        <field name="model_id" ref="model_sf_supplier_contract_database"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
