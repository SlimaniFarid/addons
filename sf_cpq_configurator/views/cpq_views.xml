<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Attribute form -->
    <record id="cpq_attribute_view_form" model="ir.ui.view">
        <field name="name">sf.cpq.attribute.form</field>
        <field name="model">sf.cpq.attribute</field>
        <field name="arch" type="xml">
            <form string="CPQ Attribute">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="description"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Options">
                            <field name="option_ids">
                                <tree string="Options" editable="bottom">
                                    <field name="name"/>
                                    <field name="code"/>
                                    <field name="sequence"/>
                                    <field name="price_adjust"/>
                                    <field name="active"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="cpq_attribute_view_tree" model="ir.ui.view">
        <field name="name">sf.cpq.attribute.tree</field>
        <field name="model">sf.cpq.attribute</field>
        <field name="arch" type="xml">
            <tree string="CPQ Attributes">
                <field name="name"/>
                <field name="code"/>
                <field name="sequence"/>
                <field name="option_ids" widget="many2many_tags"/>
            </tree>
        </field>
    </record>

    <!-- Option form -->
    <record id="cpq_option_view_form" model="ir.ui.view">
        <field name="name">sf.cpq.option.form</field>
        <field name="model">sf.cpq.option</field>
        <field name="arch" type="xml">
            <form string="CPQ Option">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="attribute_id"/>
                            <field name="code"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="price_adjust"/>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="cpq_option_view_tree" model="ir.ui.view">
        <field name="name">sf.cpq.option.tree</field>
        <field name="model">sf.cpq.option</field>
        <field name="arch" type="xml">
            <tree string="CPQ Options">
                <field name="name"/>
                <field name="attribute_id"/>
                <field name="code"/>
                <field name="price_adjust"/>
            </tree>
        </field>
    </record>

    <!-- Configurator form -->
    <record id="cpq_configurator_view_form" model="ir.ui.view">
        <field name="name">sf.cpq.configurator.form</field>
        <field name="model">sf.cpq.configurator</field>
        <field name="arch" type="xml">
            <form string="CPQ Configurator">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="product_id"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="attribute_ids" widget="many2many_tags"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Configurations">
                            <field name="configuration_ids">
                                <tree string="Configurations">
                                    <field name="name"/>
                                    <field name="partner_id"/>
                                    <field name="quantity"/>
                                    <field name="total_price"/>
                                    <field name="state"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="cpq_configurator_view_tree" model="ir.ui.view">
        <field name="name">sf.cpq.configurator.tree</field>
        <field name="model">sf.cpq.configurator</field>
        <field name="arch" type="xml">
            <tree string="CPQ Configurators">
                <field name="product_id"/>
                <field name="attribute_ids" widget="many2many_tags"/>
            </tree>
        </field>
    </record>

    <!-- Configuration form -->
    <record id="cpq_configuration_view_form" model="ir.ui.view">
        <field name="name">sf.cpq.configuration.form</field>
        <field name="model">sf.cpq.configuration</field>
        <field name="arch" type="xml">
            <form string="CPQ Configuration">
                <header>
                    <button name="action_quote" string="Generate Quote"
                            type="object" states="draft"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                        <field name="state" widget="statusbar"/>
                    </div>
                    <group>
                        <group>
                            <field name="configurator_id"/>
                            <field name="product_id"/>
                            <field name="partner_id"/>
                            <field name="quantity"/>
                        </group>
                        <group>
                            <field name="base_price"/>
                            <field name="adjustments"/>
                            <field name="total_price"/>
                            <field name="currency_id"/>
                        </group>
                    </group>
                    <group string="Selected Options">
                        <field name="option_ids" widget="many2many_tags"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="cpq_configuration_view_tree" model="ir.ui.view">
        <field name="name">sf.cpq.configuration.tree</field>
        <field name="model">sf.cpq.configuration</field>
        <field name="arch" type="xml">
            <tree string="CPQ Configurations">
                <field name="name"/>
                <field name="product_id"/>
                <field name="partner_id"/>
                <field name="quantity"/>
                <field name="total_price"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <record id="cpq_configuration_view_search" model="ir.ui.view">
        <field name="name">sf.cpq.configuration.search</field>
        <field name="model">sf.cpq.configuration</field>
        <field name="arch" type="xml">
            <search string="CPQ Configurations">
                <field name="name"/>
                <field name="product_id"/>
                <field name="partner_id"/>
                <filter string="Draft" name="draft"
                        domain="[('state','=','draft')]"/>
                <filter string="Quoted" name="quoted"
                        domain="[('state','=','quoted')]"/>
            </search>
        </field>
    </record>

    <!-- Actions -->
    <record id="action_cpq_configuration" model="ir.actions.act_window">
        <field name="name">CPQ Configurations</field>
        <field name="res_model">sf.cpq.configuration</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="cpq_configuration_view_search"/>
    </record>

    <record id="action_cpq_configurator" model="ir.actions.act_window">
        <field name="name">CPQ Configurators</field>
        <field name="res_model">sf.cpq.configurator</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record id="action_cpq_attribute" model="ir.actions.act_window">
        <field name="name">CPQ Attributes</field>
        <field name="res_model">sf.cpq.attribute</field>
        <field name="view_mode">tree,form</field>
    </record>

</odoo>