<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_tax_provision_calc" model="ir.module.category">
        <field name="name">Tax Provision Calculator</field>
        <field name="sequence">188</field>
    </record>
    <record id="group_tax_provision_calc_user" model="res.groups">
        <field name="name">Tax Provision Calculator User</field>
        <field name="category_id" ref="module_category_tax_provision_calc"/>

    </record>
    <record id="group_tax_provision_calc_manager" model="res.groups">
        <field name="name">Tax Provision Calculator Manager</field>
        <field name="category_id" ref="module_category_tax_provision_calc"/>
        <field name="implied_ids" eval="[(4, ref('group_tax_provision_calc_user'))]"/>
    </record>
    <record id="rule_tax_provision_calc_sf_tax_provision_calc" model="ir.rule">
        <field name="name">Tax Provision Calculator: multi-company</field>
        <field name="model_id" ref="model_sf_tax_provision_calc"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
