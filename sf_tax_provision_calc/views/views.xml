<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_tax_provision_calc" model="ir.actions.act_window">
        <field name="name">Tax Provision Calculator</field>
        <field name="res_model">sf.tax_provision_calc</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
    <record id="view_sf_tax_provision_calc_form" model="ir.ui.view">
        <field name="name">sf.tax_provision_calc.form</field>
        <field name="model">sf.tax_provision_calc</field>
        <field name="arch" type="xml">
            <form string="Tax Provision Calculator">
                <header>
                    <button name="action_submitted" type="object" string="Submitted"
                            class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="fiscal_year"/>
                            <field name="pretax_income"/>
                            <field name="tax_rate_percent"/>
                            <field name="current_tax"/>
                            <field name="deferred_tax"/>
                            <field name="notes"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_tax_provision_calc_list" model="ir.ui.view">
        <field name="name">sf.tax_provision_calc.list</field>
        <field name="model">sf.tax_provision_calc</field>
        <field name="arch" type="xml">
            <list string="Tax Provision Calculator" sample="1">
                <field name="fiscal_year"/>
                <field name="pretax_income"/>
                <field name="tax_rate_percent"/>
                <field name="current_tax"/>
                <field name="deferred_tax"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state in ('submitted','approved')"/>
            </list>
        </field>
    </record>
    <record id="view_sf_tax_provision_calc_kanban" model="ir.ui.view">
        <field name="name">sf.tax_provision_calc.kanban</field>
        <field name="model">sf.tax_provision_calc</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_view" group_by="state">
                <field name="name"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <menuitem id="menu_sf_tax_provision_calc_root" name="Tax Provision Calculator" sequence="13"
              web_icon="sf_tax_provision_calc,static/description/icon.png"/>
    <menuitem id="menu_sf_tax_provision_calc_main" name="Records"
              parent="menu_sf_tax_provision_calc_root" action="action_sf_tax_provision_calc" sequence="10"/>
</odoo>
