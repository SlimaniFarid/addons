<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================ FORM VIEW ============================ -->
    <record id="view_cashflow_forecast_form" model="ir.ui.view">
        <field name="name">sf.cashflow.forecast.form</field>
        <field name="model">sf.cashflow.forecast</field>
        <field name="arch" type="xml">
            <form string="Cash Flow Forecast">
                <header>
                    <button name="action_generate_lines" type="object"
                            string="Generate Lines"
                            class="btn-primary"
                            invisible="[('state', 'not in', ('draft', 'confirmed'))]"
                            confirm="Regenerate the projection from accounting data? Manual lines will be kept."/>
                    <button name="action_confirm" type="object"
                            string="Confirm"
                            class="btn-primary"
                            invisible="[('state', 'not in', ('draft',))]"/>
                    <button name="action_draft" type="object"
                            string="Set to Draft"
                            invisible="[('state', 'not in', ('cancelled',))]"/>
                    <button name="action_cancel" type="object"
                            string="Cancel"
                            invisible="[('state', 'not in', ('draft', 'confirmed'))]"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                        <group>
                            <field name="state" widget="statusbar"
                                   statusbar_visible="draft,confirmed,cancelled"/>
                        </group>
                    </div>
                    <group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="currency_id"/>
                            <field name="date_from"/>
                            <field name="horizon_days"/>
                            <field name="date_to"/>
                        </group>
                        <group>
                            <field name="bank_journal_ids" widget="many2many_tags"/>
                            <field name="alert_threshold"/>
                            <field name="opening_balance" widget="monetary"/>
                            <field name="closing_balance" widget="monetary"/>
                        </group>
                    </group>
                    <group>
                        <group string="Projection">
                            <field name="total_inflow" widget="monetary"
                                   decoration-success="total_inflow &gt; 0"/>
                            <field name="total_outflow" widget="monetary"
                                   decoration-danger="total_outflow &gt; 0"/>
                            <field name="net_cash_flow" widget="monetary"/>
                            <field name="minimum_balance" widget="monetary"/>
                            <field name="minimum_date"/>
                        </group>
                        <group string="Alerts">
                            <field name="alert_ids">
                                <list string="Alerts" editable="bottom">
                                    <field name="date"/>
                                    <field name="projected_balance" widget="monetary"/>
                                    <field name="is_processed"/>
                                </list>
                            </field>
                        </group>
                    </group>
                    <notebook>
                        <page string="Inflow Lines" name="inflow">
                            <field name="inflow_line_ids">
                                <list string="Inflows" editable="bottom">
                                    <field name="date"/>
                                    <field name="partner_id"/>
                                    <field name="name"/>
                                    <field name="amount" widget="monetary"/>
                                    <field name="source"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                        <page string="Outflow Lines" name="outflow">
                            <field name="outflow_line_ids">
                                <list string="Outflows" editable="bottom">
                                    <field name="date"/>
                                    <field name="partner_id"/>
                                    <field name="name"/>
                                    <field name="amount" widget="monetary"/>
                                    <field name="source"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                        <page string="All Lines" name="lines">
                            <field name="line_ids">
                                <list string="Cash Flow Lines" editable="bottom">
                                    <field name="date"/>
                                    <field name="direction"/>
                                    <field name="partner_id"/>
                                    <field name="name"/>
                                    <field name="amount" widget="monetary"/>
                                    <field name="source"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- ============================ TREE VIEW ============================ -->
    <record id="view_cashflow_forecast_tree" model="ir.ui.view">
        <field name="name">sf.cashflow.forecast.tree</field>
        <field name="model">sf.cashflow.forecast</field>
        <field name="arch" type="xml">
            <tree string="Cash Flow Forecasts">
                <field name="name"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="opening_balance" widget="monetary"
                       sum="Total"/>
                <field name="total_inflow" widget="monetary"/>
                <field name="total_outflow" widget="monetary"/>
                <field name="closing_balance" widget="monetary"/>
                <field name="minimum_balance" widget="monetary"/>
                <field name="state" widget="badge"/>
            </tree>
        </field>
    </record>

    <!-- =========================== SEARCH VIEW =========================== -->
    <record id="view_cashflow_forecast_search" model="ir.ui.view">
        <field name="name">sf.cashflow.forecast.search</field>
        <field name="model">sf.cashflow.forecast</field>
        <field name="arch" type="xml">
            <search string="Cash Flow Forecasts">
                <field name="name"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <filter string="Confirmed" name="confirmed"
                        domain="[('state', '=', 'confirmed')]"/>
                <filter string="Low Balance" name="low_balance"
                        domain="[('minimum_balance', '&lt;', 0)]"/>
                <group>
                    <filter string="Company" name="group_company"
                            context="{'group_by': 'company_id'}"/>
                    <filter string="Status" name="group_state"
                            context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ========================== ACTION + MENU ========================== -->
    <record id="action_cashflow_forecast" model="ir.actions.act_window">
        <field name="name">Cash Flow Forecasts</field>
        <field name="res_model">sf.cashflow.forecast</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_cashflow_forecast_search"/>
    </record>

    <menuitem id="menu_cashflow_root"
              name="Cash Flow"
              parent="account.menu_finance"
              sequence="50"/>

    <menuitem id="menu_cashflow_forecasts"
              parent="menu_cashflow_root"
              action="action_cashflow_forecast"
              sequence="10"/>
</odoo>