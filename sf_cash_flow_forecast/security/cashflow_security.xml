<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="module_category_cashflow" model="ir.module.category">
            <field name="name">Cash Flow / Treasury</field>
            <field name="sequence">60</field>
        </record>

        <record id="group_cashflow_user" model="res.groups">
            <field name="name">Cash Flow User</field>
            <field name="category_id" ref="module_category_cashflow"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_cashflow_manager" model="res.groups">
            <field name="name">Cash Flow Manager</field>
            <field name="category_id" ref="module_category_cashflow"/>
            <field name="implied_ids" eval="[(4, ref('group_cashflow_user'))]"/>
        </record>
    </data>
    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_cashflow"/>
    </record>
</odoo>