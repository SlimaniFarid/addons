<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_tender" model="ir.sequence">
            <field name="name">Tender</field>
            <field name="code">sf.tender</field>
            <field name="prefix"></field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>

        <record id="seq_tender_offer" model="ir.sequence">
            <field name="name">Tender Offer</field>
            <field name="code">sf.tender.offer</field>
            <field name="prefix"></field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>

        <record id="cron_tender_deadline" model="ir.cron">
            <field name="name">Tender Management: Deadline Alerts</field>
            <field name="model_id" ref="model_sf_tender"/>
            <field name="state">code</field>
            <field name="code">model._check_tender_deadlines()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="active">True</field>
        </record>
    </data>
</odoo>