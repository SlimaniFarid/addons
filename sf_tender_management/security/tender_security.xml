<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_tender" model="ir.module.category">
        <field name="name">Tender Management</field>
        <field name="sequence">90</field>
    </record>

    <record id="group_tender_user" model="res.groups">
        <field name="name">Tender Management User</field>
        <field name="category_id" ref="module_category_tender"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_tender_manager" model="res.groups">
        <field name="name">Tender Management Manager</field>
        <field name="category_id" ref="module_category_tender"/>
        <field name="implied_ids" eval="[(4, ref('group_tender_user'))]"/>
    </record>

    <record id="rule_tender_user_company" model="ir.rule">
        <field name="name">Tender: user sees own company</field>
        <field name="model_id" ref="model_sf_tender"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_tender_user'))]"/>
    </record>

    <record id="rule_tender_criterion_user_company" model="ir.rule">
        <field name="name">Criterion: user sees own company</field>
        <field name="model_id" ref="model_sf_tender_criterion"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('tender_id.company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_tender_user'))]"/>
    </record>

    <record id="rule_tender_offer_user_company" model="ir.rule">
        <field name="name">Offer: user sees own company</field>
        <field name="model_id" ref="model_sf_tender_offer"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('tender_id.company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_tender_user'))]"/>
    </record>

    <record id="rule_tender_score_user_company" model="ir.rule">
        <field name="name">Score: user sees own company</field>
        <field name="model_id" ref="model_sf_tender_offer_score"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('offer_id.tender_id.company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_tender_user'))]"/>
    </record>

    <record id="rule_tender_manager_all" model="ir.rule">
        <field name="name">Tender: manager sees all companies</field>
        <field name="model_id" ref="model_sf_tender"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_tender_manager'))]"/>
    </record>

    <record id="rule_tender_criterion_manager_all" model="ir.rule">
        <field name="name">Criterion: manager sees all companies</field>
        <field name="model_id" ref="model_sf_tender_criterion"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_tender_manager'))]"/>
    </record>

    <record id="rule_tender_offer_manager_all" model="ir.rule">
        <field name="name">Offer: manager sees all companies</field>
        <field name="model_id" ref="model_sf_tender_offer"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_tender_manager'))]"/>
    </record>

    <record id="rule_tender_score_manager_all" model="ir.rule">
        <field name="name">Score: manager sees all companies</field>
        <field name="model_id" ref="model_sf_tender_offer_score"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_tender_manager'))]"/>
    </record>
</odoo>