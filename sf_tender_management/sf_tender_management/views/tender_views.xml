<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============ TENDER ============ -->
    <record id="view_tender_tree" model="ir.ui.view">
        <field name="name">sf.tender.tree</field>
        <field name="model">sf.tender</field>
        <field name="arch" type="xml">
            <tree string="Tenders">
                <field name="name"/>
                <field name="title"/>
                <field name="tender_type"/>
                <field name="buyer_id"/>
                <field name="deadline"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <record id="view_tender_form" model="ir.ui.view">
        <field name="name">sf.tender.form</field>
        <field name="model">sf.tender</field>
        <field name="arch" type="xml">
            <form string="Tender">
                <header>
                    <button name="action_publish" type="object"
                            string="Publish" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_start_evaluation" type="object"
                            string="Start Evaluation" class="btn-primary"
                            invisible="state != 'published'"/>
                    <button name="action_open_award_wizard" type="object"
                            string="Award" class="btn-success"
                            invisible="state != 'in_evaluation'"/>
                    <button name="action_close" type="object"
                            string="Close" invisible="state != 'awarded'"/>
                    <button name="action_cancel" type="object"
                            string="Cancel" invisible="state not in ('draft', 'published')"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="title"/>
                            <field name="tender_type"/>
                        </group>
                        <group>
                            <field name="buyer_id"/>
                            <field name="deadline"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <field name="description"/>
                    <notebook>
                        <page string="Invited Suppliers">
                            <field name="invited_partner_ids" widget="many2many_tags"/>
                        </page>
                        <page string="Evaluation Criteria">
                            <field name="criterion_ids">
                                <tree string="Criteria" editable="bottom">
                                    <field name="name"/>
                                    <field name="weight"/>
                                    <field name="active"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Offers">
                            <field name="offer_ids" readonly="1">
                                <tree string="Offers">
                                    <field name="name"/>
                                    <field name="partner_id"/>
                                    <field name="date_submitted"/>
                                    <field name="amount_total"/>
                                    <field name="weighted_score"/>
                                    <field name="state"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Award">
                            <group>
                                <group>
                                    <field name="winner_offer_id"/>
                                    <field name="award_date"/>
                                </group>
                                <group>
                                    <field name="award_justification"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                    <field name="notes"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_tender_search" model="ir.ui.view">
        <field name="name">sf.tender.search</field>
        <field name="model">sf.tender</field>
        <field name="arch" type="xml">
            <search string="Tenders">
                <field name="title"/>
                <field name="buyer_id"/>
                <field name="deadline"/>
                <filter string="Published" name="published"
                        domain="[('state', '=', 'published')]"/>
                <filter string="In Evaluation" name="in_evaluation"
                        domain="[('state', '=', 'in_evaluation')]"/>
                <filter string="Awarded" name="awarded"
                        domain="[('state', '=', 'awarded')]"/>
                <group>
                    <filter string="Status" name="state_group"
                            context="{'group_by': 'state'}"/>
                    <filter string="Type" name="type_group"
                            context="{'group_by': 'tender_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_tender_kanban" model="ir.ui.view">
        <field name="name">sf.tender.kanban</field>
        <field name="model">sf.tender</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state">
                <field name="title"/>
                <field name="tender_type"/>
                <field name="deadline"/>
                <field name="buyer_id"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_record_title">
                                <field name="name"/> - <field name="title"/>
                            </div>
                            <div class="o_kanban_record_subtitle">
                                <field name="tender_type"/>
                            </div>
                            <div class="o_kanban_record_bottom">
                                Deadline: <field name="deadline"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_tender" model="ir.actions.act_window">
        <field name="name">Tenders</field>
        <field name="res_model">sf.tender</field>
        <field name="view_mode">tree,kanban,form</field>
        <field name="search_view_id" ref="view_tender_search"/>
    </record>

    <!-- ============ OFFER ============ -->
    <record id="view_tender_offer_tree" model="ir.ui.view">
        <field name="name">sf.tender.offer.tree</field>
        <field name="model">sf.tender.offer</field>
        <field name="arch" type="xml">
            <tree string="Offers">
                <field name="name"/>
                <field name="tender_id"/>
                <field name="partner_id"/>
                <field name="date_submitted"/>
                <field name="amount_total"/>
                <field name="weighted_score"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <record id="view_tender_offer_form" model="ir.ui.view">
        <field name="name">sf.tender.offer.form</field>
        <field name="model">sf.tender.offer</field>
        <field name="arch" type="xml">
            <form string="Offer">
                <header>
                    <button name="action_set_evaluated" type="object"
                            string="Mark Evaluated" class="btn-primary"
                            invisible="state != 'submitted'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="tender_id"/>
                            <field name="partner_id"/>
                            <field name="date_submitted"/>
                        </group>
                        <group>
                            <field name="amount_total" currency_field="currency_id"/>
                            <field name="currency_id"/>
                            <field name="delivery_days"/>
                            <field name="eligible"/>
                            <field name="weighted_score"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Scores">
                            <field name="score_ids">
                                <tree string="Scores" editable="bottom">
                                    <field name="criterion_id"/>
                                    <field name="score"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                    <field name="notes"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_tender_offer_search" model="ir.ui.view">
        <field name="name">sf.tender.offer.search</field>
        <field name="model">sf.tender.offer</field>
        <field name="arch" type="xml">
            <search string="Offers">
                <field name="partner_id"/>
                <field name="tender_id"/>
                <group>
                    <filter string="Status" name="state_group"
                            context="{'group_by': 'state'}"/>
                    <filter string="Supplier" name="partner_group"
                            context="{'group_by': 'partner_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_tender_offer" model="ir.actions.act_window">
        <field name="name">Offers</field>
        <field name="res_model">sf.tender.offer</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_tender_offer_search"/>
    </record>

    <!-- ============ CRITERION ============ -->
    <record id="view_tender_criterion_tree" model="ir.ui.view">
        <field name="name">sf.tender.criterion.tree</field>
        <field name="model">sf.tender.criterion</field>
        <field name="arch" type="xml">
            <tree string="Evaluation Criteria">
                <field name="tender_id"/>
                <field name="name"/>
                <field name="weight"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <record id="action_tender_criterion" model="ir.actions.act_window">
        <field name="name">Evaluation Criteria</field>
        <field name="res_model">sf.tender.criterion</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- ============ DASHBOARD ============ -->
    <record id="view_tender_dashboard_graph" model="ir.ui.view">
        <field name="name">sf.tender.dashboard.graph</field>
        <field name="model">sf.tender</field>
        <field name="arch" type="xml">
            <graph string="Tenders by Type">
                <field name="tender_type"/>
                <field name="id" type="measure" string="Tenders"/>
            </graph>
        </field>
    </record>

    <record id="view_tender_dashboard_pivot" model="ir.ui.view">
        <field name="name">sf.tender.dashboard.pivot</field>
        <field name="model">sf.tender</field>
        <field name="arch" type="xml">
            <pivot string="Tenders by Type and Status">
                <field name="tender_type" type="row"/>
                <field name="state" type="col"/>
                <field name="id" type="measure" string="Tenders"/>
            </pivot>
        </field>
    </record>

    <record id="action_tender_dashboard" model="ir.actions.act_window">
        <field name="name">Tender Dashboard</field>
        <field name="res_model">sf.tender</field>
        <field name="view_mode">graph,pivot</field>
        <field name="view_ids" eval="[(5, 0), (0, 0, {'view_mode': 'graph', 'view_id': ref('view_tender_dashboard_graph')}), (0, 0, {'view_mode': 'pivot', 'view_id': ref('view_tender_dashboard_pivot')})]"/>
    </record>

    <!-- ============ WIZARD ============ -->
    <record id="view_tender_award_wizard" model="ir.ui.view">
        <field name="name">sf.tender.award.wizard.form</field>
        <field name="model">sf.tender.award.wizard</field>
        <field name="arch" type="xml">
            <form string="Award Tender">
                <group>
                    <field name="tender_id" readonly="1"/>
                    <field name="offer_id"/>
                    <field name="justification"/>
                </group>
                <footer>
                    <button name="action_award" type="object"
                            string="Award" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>