<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="report_tender_evaluation" model="ir.actions.report">
        <field name="name">Evaluation Summary</field>
        <field name="model">sf.tender</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">sf_tender_management.tender_evaluation_template</field>
        <field name="report_file">sf_tender_management.tender_evaluation_template</field>
        <field name="binding_model_id" ref="model_sf_tender"/>
        <field name="binding_type">report</field>
    </record>

    <template id="tender_evaluation_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>Evaluation Summary</h2>
                        <table class="table table-sm">
                            <tr><td><strong>Tender</strong></td><td><t t-esc="o.name"/> - <t t-esc="o.title"/></td></tr>
                            <tr><td><strong>Type</strong></td><td><t t-esc="o.tender_type"/></td></tr>
                            <tr><td><strong>Buyer</strong></td><td><t t-esc="o.buyer_id.name"/></td></tr>
                            <tr><td><strong>Deadline</strong></td><td><t t-esc="o.deadline"/></td></tr>
                            <tr><td><strong>Status</strong></td><td><t t-esc="o.state"/></td></tr>
                            <tr><td><strong>Award date</strong></td><td><t t-esc="o.award_date or ''"/></td></tr>
                        </table>

                        <h4>Evaluation criteria</h4>
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Criterion</th>
                                    <th class="text-right">Weight (%)</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="o.criterion_ids.filtered(lambda c: c.active)" t-as="c">
                                    <tr>
                                        <td><t t-esc="c.name"/></td>
                                        <td class="text-right"><t t-esc="c.weight"/></td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>

                        <h4>Offers</h4>
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Offer</th>
                                    <th>Supplier</th>
                                    <th class="text-right">Amount</th>
                                    <th class="text-right">Score</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="o.offer_ids" t-as="offer">
                                    <tr>
                                        <td><t t-esc="offer.name"/></td>
                                        <td><t t-esc="offer.partner_id.name"/></td>
                                        <td class="text-right"><t t-esc="offer.amount_total"/></td>
                                        <td class="text-right"><t t-esc="offer.weighted_score"/></td>
                                        <td><t t-esc="offer.state"/></td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>

                        <t t-if="o.winner_offer_id">
                            <h4>Winner</h4>
                            <p><t t-esc="o.winner_offer_id.partner_id.name"/>
                               (<t t-esc="o.winner_offer_id.name"/>)</p>
                            <p><strong>Justification:</strong>
                               <t t-esc="o.award_justification"/></p>
                        </t>
                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>