<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_invest_portfolio" model="ir.sequence">
            <field name="name">Investment Portfolio</field>
            <field name="code">sf.invest.portfolio</field>
            <field name="prefix">PF-</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>

        <record id="seq_invest_line" model="ir.sequence">
            <field name="name">Investment Line</field>
            <field name="code">sf.invest.line</field>
            <field name="prefix">LIN-</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>

        <record id="seq_invest_valuation" model="ir.sequence">
            <field name="name">Investment Valuation</field>
            <field name="code">sf.invest.valuation</field>
            <field name="prefix">VAL-</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>

        <record id="seq_invest_income" model="ir.sequence">
            <field name="name">Investment Income</field>
            <field name="code">sf.invest.income</field>
            <field name="prefix">INC-</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>

        <record id="cron_invest_alerts" model="ir.cron">
            <field name="name">Investments: Maturity Alerts</field>
            <field name="model_id" ref="model_sf_invest_line"/>
            <field name="state">code</field>
            <field name="code">model._check_invest_alerts()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="active">True</field>
        </record>
    </data>
</odoo>