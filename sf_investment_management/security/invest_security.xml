<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_investment" model="ir.module.category">
        <field name="name">Investments</field>
        <field name="sequence">90</field>
    </record>

    <record id="group_invest_user" model="res.groups">
        <field name="name">Investment Management User</field>
        <field name="category_id" ref="module_category_investment"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_invest_manager" model="res.groups">
        <field name="name">Investment Management Manager</field>
        <field name="category_id" ref="module_category_investment"/>
        <field name="implied_ids" eval="[(4, ref('group_invest_user'))]"/>
    </record>

    <record id="rule_invest_portfolio_user_company" model="ir.rule">
        <field name="name">Portfolio: user sees own company</field>
        <field name="model_id" ref="model_sf_invest_portfolio"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_invest_user'))]"/>
    </record>

    <record id="rule_invest_line_user_company" model="ir.rule">
        <field name="name">Investment line: user sees own company</field>
        <field name="model_id" ref="model_sf_invest_line"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_invest_user'))]"/>
    </record>

    <record id="rule_invest_valuation_user_company" model="ir.rule">
        <field name="name">Valuation: user sees own company</field>
        <field name="model_id" ref="model_sf_invest_valuation"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_invest_user'))]"/>
    </record>

    <record id="rule_invest_income_user_company" model="ir.rule">
        <field name="name">Income: user sees own company</field>
        <field name="model_id" ref="model_sf_invest_income"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_invest_user'))]"/>
    </record>

    <record id="rule_invest_portfolio_manager_all" model="ir.rule">
        <field name="name">Portfolio: manager sees all companies</field>
        <field name="model_id" ref="model_sf_invest_portfolio"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_invest_manager'))]"/>
    </record>

    <record id="rule_invest_line_manager_all" model="ir.rule">
        <field name="name">Investment line: manager sees all companies</field>
        <field name="model_id" ref="model_sf_invest_line"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_invest_manager'))]"/>
    </record>

    <record id="rule_invest_valuation_manager_all" model="ir.rule">
        <field name="name">Valuation: manager sees all companies</field>
        <field name="model_id" ref="model_sf_invest_valuation"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_invest_manager'))]"/>
    </record>

    <record id="rule_invest_income_manager_all" model="ir.rule">
        <field name="name">Income: manager sees all companies</field>
        <field name="model_id" ref="model_sf_invest_income"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_invest_manager'))]"/>
    </record>
    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_investment"/>
    </record>
</odoo>