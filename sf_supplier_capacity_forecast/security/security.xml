<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_supplier_capacity_forecast" model="ir.module.category">
        <field name="name">Supplier Capacity Forecast</field>
        <field name="sequence">165</field>
    </record>
    <record id="group_supplier_capacity_forecast_user" model="res.groups">
        <field name="name">Supplier Capacity Forecast User</field>
        <field name="category_id" ref="module_category_supplier_capacity_forecast"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>

    </record>
    <record id="group_supplier_capacity_forecast_manager" model="res.groups">
        <field name="name">Supplier Capacity Forecast Manager</field>
        <field name="category_id" ref="module_category_supplier_capacity_forecast"/>
        <field name="implied_ids" eval="[(4, ref('group_supplier_capacity_forecast_user'))]"/>
    </record>
    <record id="rule_supplier_capacity_forecast_sf_supplier_capacity_forecast" model="ir.rule">
        <field name="name">Supplier Capacity Forecast: multi-company</field>
        <field name="model_id" ref="model_sf_supplier_capacity_forecast"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
