<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_purchase_order_aging" model="ir.actions.act_window">
        <field name="name">Purchase Order Aging Monitor</field>
        <field name="res_model">sf.purchase_order_aging</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
    <record id="view_sf_purchase_order_aging_form" model="ir.ui.view">
        <field name="name">sf.purchase_order_aging.form</field>
        <field name="model">sf.purchase_order_aging</field>
        <field name="arch" type="xml">
            <form string="Purchase Order Aging Monitor">
                <header>
                    <button name="action_submitted" type="object" string="Submitted"
                            class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="po_id"/>
                            <field name="vendor_id"/>
                            <field name="days_open"/>
                            <field name="expected_receipt"/>
                            <field name="delay_days"/>
                            <field name="action"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_purchase_order_aging_list" model="ir.ui.view">
        <field name="name">sf.purchase_order_aging.list</field>
        <field name="model">sf.purchase_order_aging</field>
        <field name="arch" type="xml">
            <list string="Purchase Order Aging Monitor" sample="1">
                <field name="po_id"/>
                <field name="vendor_id"/>
                <field name="days_open"/>
                <field name="expected_receipt"/>
                <field name="delay_days"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state in ('submitted','approved')"/>
            </list>
        </field>
    </record>
    <record id="view_sf_purchase_order_aging_kanban" model="ir.ui.view">
        <field name="name">sf.purchase_order_aging.kanban</field>
        <field name="model">sf.purchase_order_aging</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_view" group_by="state">
                <field name="name"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <menuitem id="menu_sf_purchase_order_aging_root" name="Purchase Order Aging Monitor" sequence="10"
              web_icon="sf_purchase_order_aging,static/description/icon.png"/>
    <menuitem id="menu_sf_purchase_order_aging_main" name="Records"
              parent="menu_sf_purchase_order_aging_root" action="action_sf_purchase_order_aging" sequence="10"/>

    <record id="wave_final_sf_purchase_order_aging" model="ir.actions.server">
        <field name="name">Refresh Business Data</field>
        <field name="model_id" ref="model_sf_purchase_order_aging"/>
        <field name="binding_model_id" ref="model_sf_purchase_order_aging"/>
        <field name="state">code</field>
        <field name="code">records.action_refresh_business()</field>
    </record>
</odoo>
