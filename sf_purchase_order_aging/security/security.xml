<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_purchase_order_aging" model="ir.module.category">
        <field name="name">Purchase Order Aging Monitor</field>
        <field name="sequence">491</field>
    </record>
    <record id="group_purchase_order_aging_user" model="res.groups">
        <field name="name">Purchase Order Aging Monitor User</field>
        <field name="category_id" ref="module_category_purchase_order_aging"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>

    </record>
    <record id="group_purchase_order_aging_manager" model="res.groups">
        <field name="name">Purchase Order Aging Monitor Manager</field>
        <field name="category_id" ref="module_category_purchase_order_aging"/>
        <field name="implied_ids" eval="[(4, ref('group_purchase_order_aging_user'))]"/>
    </record>
    <record id="rule_purchase_order_aging_sf_purchase_order_aging" model="ir.rule">
        <field name="name">Purchase Order Aging Monitor: multi-company</field>
        <field name="model_id" ref="model_sf_purchase_order_aging"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_purchase_order_aging"/>
    </record>
</odoo>
