<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_spare_part" model="ir.actions.act_window">
        <field name="name">Spare Parts Min/Max</field>
        <field name="res_model">sf.spare.part</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
    <record id="view_sf_spare_part_form" model="ir.ui.view">
        <field name="name">sf.spare.part.form</field>
        <field name="model">sf.spare.part</field>
        <field name="arch" type="xml">
            <form string="Spare Parts Min/Max">
                <header>
                    <button name="action_review" type="object" string="Under Review"
                            class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="active,review,archived"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="product_id"/>
                            <field name="criticality"/>
                            <field name="min_qty"/>
                            <field name="max_qty"/>
                            <field name="lead_time_days"/>
                            <field name="supplier_ref"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_spare_part_list" model="ir.ui.view">
        <field name="name">sf.spare.part.list</field>
        <field name="model">sf.spare.part</field>
        <field name="arch" type="xml">
            <list string="Spare Parts Min/Max" sample="1">
                <field name="product_id"/>
                <field name="criticality"/>
                <field name="min_qty"/>
                <field name="max_qty"/>
                <field name="lead_time_days"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state in ('submitted','approved')"/>
            </list>
        </field>
    </record>
    <record id="view_sf_spare_part_kanban" model="ir.ui.view">
        <field name="name">sf.spare.part.kanban</field>
        <field name="model">sf.spare.part</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_view" group_by="state">
                <field name="name"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <menuitem id="menu_sf_spare_part_root" name="Spare Parts Min/Max" sequence="14"
              web_icon="sf_spare_parts_minmax,static/description/icon.png"/>
    <menuitem id="menu_sf_spare_part_main" name="Records"
              parent="menu_sf_spare_part_root" action="action_sf_spare_part" sequence="10"/>
</odoo>
