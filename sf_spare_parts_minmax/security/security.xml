<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_spare_parts_minmax" model="ir.module.category">
        <field name="name">Spare Parts Min/Max</field>
        <field name="sequence">14</field>
    </record>
    <record id="group_spare_parts_minmax_user" model="res.groups">
        <field name="name">Spare Parts Min/Max User</field>
        <field name="category_id" ref="module_category_spare_parts_minmax"/>
        <field name="implied_ids" eval="[(4, ref('stock.group_stock_user'))]"/>

    </record>
    <record id="group_spare_parts_minmax_manager" model="res.groups">
        <field name="name">Spare Parts Min/Max Manager</field>
        <field name="category_id" ref="module_category_spare_parts_minmax"/>
        <field name="implied_ids" eval="[(4, ref('group_spare_parts_minmax_user'))]"/>
    </record>
    <record id="rule_spare_parts_minmax_sf_spare_part" model="ir.rule">
        <field name="name">Spare Part Parameter: multi-company</field>
        <field name="model_id" ref="model_sf_spare_part"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_spare_parts_minmax"/>
    </record>
</odoo>
