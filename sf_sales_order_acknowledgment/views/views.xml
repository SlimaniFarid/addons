<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_order_ack" model="ir.actions.act_window">
        <field name="name">Order Acknowledgment Tracking</field>
        <field name="res_model">sf.order.ack</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
    <record id="view_sf_order_ack_form" model="ir.ui.view">
        <field name="name">sf.order.ack.form</field>
        <field name="model">sf.order.ack</field>
        <field name="arch" type="xml">
            <form string="Order Acknowledgment Tracking">
                <header>
                    <button name="action_sent" type="object" string="Sent"
                            class="btn-primary"/>
                    <button name="action_signed" type="object" string="Signed"
                            class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="pending,sent,signed,chased"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="order_id"/>
                            <field name="customer_requires"/>
                            <field name="sent_date"/>
                            <field name="customer_signed"/>
                            <field name="chase_date"/>
                            <field name="notes"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_order_ack_list" model="ir.ui.view">
        <field name="name">sf.order.ack.list</field>
        <field name="model">sf.order.ack</field>
        <field name="arch" type="xml">
            <list string="Order Acknowledgment Tracking" sample="1">
                <field name="order_id"/>
                <field name="customer_requires"/>
                <field name="sent_date"/>
                <field name="customer_signed"/>
                <field name="chase_date"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state in ('submitted','approved')"/>
            </list>
        </field>
    </record>
    <record id="view_sf_order_ack_kanban" model="ir.ui.view">
        <field name="name">sf.order.ack.kanban</field>
        <field name="model">sf.order.ack</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_view" group_by="state">
                <field name="name"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <menuitem id="menu_sf_order_ack_root" name="Order Acknowledgment Tracking" sequence="8"
              web_icon="sf_sales_order_acknowledgment,static/description/icon.png"/>
    <menuitem id="menu_sf_order_ack_main" name="Records"
              parent="menu_sf_order_ack_root" action="action_sf_order_ack" sequence="10"/>

    <record id="wave_final_sf_sales_order_acknowledgment" model="ir.actions.server">
        <field name="name">Refresh Business Data</field>
        <field name="model_id" ref="model_sf_order_ack"/>
        <field name="binding_model_id" ref="model_sf_order_ack"/>
        <field name="state">code</field>
        <field name="code">records.action_refresh_business()</field>
    </record>
</odoo>
