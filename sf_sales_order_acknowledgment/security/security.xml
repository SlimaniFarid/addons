<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_sales_order_acknowledgment" model="ir.module.category">
        <field name="name">Order Acknowledgment Tracking</field>
        <field name="sequence">6</field>
    </record>
    <record id="group_sales_order_acknowledgment_user" model="res.groups">
        <field name="name">Order Acknowledgment Tracking User</field>
        <field name="category_id" ref="module_category_sales_order_acknowledgment"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>

    </record>
    <record id="group_sales_order_acknowledgment_manager" model="res.groups">
        <field name="name">Order Acknowledgment Tracking Manager</field>
        <field name="category_id" ref="module_category_sales_order_acknowledgment"/>
        <field name="implied_ids" eval="[(4, ref('group_sales_order_acknowledgment_user'))]"/>
    </record>
    <record id="rule_sales_order_acknowledgment_sf_order_ack" model="ir.rule">
        <field name="name">Order Acknowledgment: multi-company</field>
        <field name="model_id" ref="model_sf_order_ack"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_sales_order_acknowledgment"/>
    </record>
</odoo>
