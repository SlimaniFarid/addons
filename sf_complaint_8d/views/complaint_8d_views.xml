<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_complaint_8d_list" model="ir.ui.view">
        <field name="name">sf.complaint.8d.complaint_8d.list</field>
        <field name="model">sf.complaint.8d.complaint_8d</field>
        <field name="arch" type="xml">
            <list string="Complaint 8D">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="product_id"/>
                <field name="problem_description"/>
                <field name="root_cause"/>
                <field name="corrective_action"/>
                <field name="state" widget="badge"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_complaint_8d_form" model="ir.ui.view">
        <field name="name">sf.complaint.8d.complaint_8d.form</field>
        <field name="model">sf.complaint.8d.complaint_8d</field>
        <field name="arch" type="xml">
            <form string="Complaint 8D">
                <header>
                <field name="state" widget="badge"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" placeholder="Name"/></h1></div>
                    <group><group>
                            <field name="name"/>
                            <field name="partner_id"/>
                            <field name="product_id"/>
                            <field name="problem_description"/>
                            <field name="root_cause"/>
                            <field name="corrective_action"/>
                            <field name="state"/>
                    </group>
                    <group>
                        <field name="currency_id" invisible="1"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_complaint_8d" model="ir.actions.act_window">
        <field name="name">Complaint 8D</field>
        <field name="res_model">sf.complaint.8d.complaint_8d</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
