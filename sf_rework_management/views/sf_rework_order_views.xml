<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sf_rework_order_view_list" model="ir.ui.view">
        <field name="name">sf.rework.order.list</field>
        <field name="model">sf.rework.order</field>
        <field name="arch" type="xml">
            <list string="Rework Orders">
                <field name="name"/>
                <field name="product_id"/>
                <field name="lot_id"/>
                <field name="qty"/>
                <field name="source"/>
                <field name="disposition"/>
                <field name="assignee_id"/>
                <field name="total_hours"/>
                <field name="total_cost" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                <field name="state" widget="badge"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="sf_rework_order_view_kanban" model="ir.ui.view">
        <field name="name">sf.rework.order.kanban</field>
        <field name="model">sf.rework.order</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <t t-name="kanban-box">
                    <div class="oe_kanban_global_click">
                        <div class="o_kanban_record_title">
                            <field name="name"/>
                        </div>
                        <div class="o_kanban_record_subtitle">
                            <field name="product_id"/>
                        </div>
                        <div class="oe_kanban_details">
                            <div>Hours: <field name="total_hours"/></div>
                            <div>Total Cost: <field name="total_cost" widget="monetary" options="{'currency_field': 'currency_id'}"/></div>
                            <field name="state" widget="badge"/>
                        </div>
                    </div>
                </t>
            </kanban>
        </field>
    </record>

    <record id="sf_rework_order_view_form" model="ir.ui.view">
        <field name="name">sf.rework.order.form</field>
        <field name="model">sf.rework.order</field>
        <field name="arch" type="xml">
            <form string="Rework Order">
                <header>
                    <button name="action_start" string="Start" type="object" class="btn-primary" invisible="[('state', '!=', 'draft')]"/>
                    <button name="action_complete" string="Complete" type="object" class="btn-primary" invisible="[('state', '!=', 'in_progress')]"/>
                    <button name="action_close" string="Close" type="object" invisible="[('state', '!=', 'completed')]"/>
                    <button name="action_cancel" string="Cancel" type="object" invisible="[('state', 'in', ('completed', 'closed', 'cancelled'))]"/>
                    <field name="state" widget="statusbar" readonly="1"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="product_id"/>
                            <field name="lot_id"/>
                            <field name="qty"/>
                        </group>
                        <group>
                            <field name="source"/>
                            <field name="reason"/>
                            <field name="disposition"/>
                            <field name="assignee_id"/>
                            <field name="hourly_rate" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group string="Costs">
                        <group>
                            <field name="total_hours"/>
                            <field name="rework_cost" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                        </group>
                        <group>
                            <field name="scrap_value" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                            <field name="total_cost" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                        </group>
                    </group>
                    <group string="Timeline">
                        <group>
                            <field name="actual_start_datetime"/>
                            <field name="actual_end_datetime"/>
                        </group>
                    </group>
                    <group>
                        <field name="description"/>
                    </group>
                    <notebook>
                        <page string="Operations">
                            <field name="operation_ids">
                                <list string="Operations">
                                    <field name="name"/>
                                    <field name="operator_name"/>
                                    <field name="user_id"/>
                                    <field name="hours"/>
                                    <field name="hourly_rate" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                    <field name="done"/>
                                    <field name="description"/>
                                    <field name="notes"/>
                                </list>
                            </field>
                        </page>
                        <page string="Scrap">
                            <field name="scrap_ids">
                                <list string="Scrap">
                                    <field name="product_id"/>
                                    <field name="qty"/>
                                    <field name="unit_value" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                    <field name="value" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                    <field name="scrap_reason"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="sf_rework_order_view_search" model="ir.ui.view">
        <field name="name">sf.rework.order.search</field>
        <field name="model">sf.rework.order</field>
        <field name="arch" type="xml">
            <search string="Rework Orders">
                <field name="name"/>
                <field name="product_id"/>
                <field name="assignee_id"/>
                <filter name="rework_open" string="Open" domain="[('state', 'in', ('draft', 'in_progress'))]"/>
                <filter name="rework_completed" string="Completed" domain="[('state', '=', 'completed')]"/>
                <group>
                    <filter name="group_rework_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_rework_product" string="Product" context="{'group_by': 'product_id'}"/>
                    <filter name="group_rework_source" string="Source" context="{'group_by': 'source'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_sf_rework_order" model="ir.actions.act_window">
        <field name="name">Rework Orders</field>
        <field name="res_model">sf.rework.order</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="sf_rework_order_view_search"/>
    </record>
</odoo>