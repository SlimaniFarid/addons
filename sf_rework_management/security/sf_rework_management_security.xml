<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="module_category_sf_rework_management" model="ir.module.category">
            <field name="name">Rework Management</field>
            <field name="description">Rework Management for manufacturing and quality.</field>
            <field name="sequence">10</field>
        </record>

        <record id="group_sf_rework_management_user" model="res.groups">
            <field name="name">Rework Management / User</field>
            <field name="category_id" ref="module_category_sf_rework_management"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_sf_rework_management_manager" model="res.groups">
            <field name="name">Rework Management / Manager</field>
            <field name="category_id" ref="module_category_sf_rework_management"/>
            <field name="implied_ids" eval="[(4, ref('sf_rework_management.group_sf_rework_management_user'))]"/>
        </record>

        <record id="rule_sf_rework_order_company" model="ir.rule">
            <field name="name">Rework Order: user sees own company</field>
            <field name="model_id" ref="model_sf_rework_order"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('sf_rework_management.group_sf_rework_management_user'))]"/>
        </record>
        <record id="rule_sf_rework_order_manager_all" model="ir.rule">
            <field name="name">Rework Order: manager sees all companies</field>
            <field name="model_id" ref="model_sf_rework_order"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('sf_rework_management.group_sf_rework_management_manager'))]"/>
        </record>

        <record id="rule_sf_rework_operation_company" model="ir.rule">
            <field name="name">Rework Operation: user sees own company</field>
            <field name="model_id" ref="model_sf_rework_operation"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('sf_rework_management.group_sf_rework_management_user'))]"/>
        </record>
        <record id="rule_sf_rework_operation_manager_all" model="ir.rule">
            <field name="name">Rework Operation: manager sees all companies</field>
            <field name="model_id" ref="model_sf_rework_operation"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('sf_rework_management.group_sf_rework_management_manager'))]"/>
        </record>

        <record id="rule_sf_rework_scrap_company" model="ir.rule">
            <field name="name">Rework Scrap: user sees own company</field>
            <field name="model_id" ref="model_sf_rework_scrap"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('sf_rework_management.group_sf_rework_management_user'))]"/>
        </record>
        <record id="rule_sf_rework_scrap_manager_all" model="ir.rule">
            <field name="name">Rework Scrap: manager sees all companies</field>
            <field name="model_id" ref="model_sf_rework_scrap"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('sf_rework_management.group_sf_rework_management_manager'))]"/>
        </record>
    </data>
</odoo>