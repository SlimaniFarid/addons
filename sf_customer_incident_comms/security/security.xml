<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_customer_incident_comms" model="ir.module.category">
        <field name="name">Customer Incident Communications</field>
        <field name="sequence">20</field>
    </record>
    <record id="group_customer_incident_comms_user" model="res.groups">
        <field name="name">Customer Incident Communications User</field>
        <field name="category_id" ref="module_category_customer_incident_comms"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>

    </record>
    <record id="group_customer_incident_comms_manager" model="res.groups">
        <field name="name">Customer Incident Communications Manager</field>
        <field name="category_id" ref="module_category_customer_incident_comms"/>
        <field name="implied_ids" eval="[(4, ref('group_customer_incident_comms_user'))]"/>
    </record>
    <record id="rule_customer_incident_comms_sf_customer_comm" model="ir.rule">
        <field name="name">Customer Communication: multi-company</field>
        <field name="model_id" ref="model_sf_customer_comm"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
