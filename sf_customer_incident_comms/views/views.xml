<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_customer_comm" model="ir.actions.act_window">
        <field name="name">Customer Incident Communications</field>
        <field name="res_model">sf.customer.comm</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
    <record id="view_sf_customer_comm_form" model="ir.ui.view">
        <field name="name">sf.customer.comm.form</field>
        <field name="model">sf.customer.comm</field>
        <field name="arch" type="xml">
            <form string="Customer Incident Communications">
                <header>
                    <button name="action_sent" type="object" string="Sent"
                            class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="planned,sent,feedback"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="incident_ref"/>
                            <field name="channel"/>
                        <field name="message_sent"/>
                            <field name="sent_at"/>
                            <field name="customer_reaction"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_customer_comm_list" model="ir.ui.view">
        <field name="name">sf.customer.comm.list</field>
        <field name="model">sf.customer.comm</field>
        <field name="arch" type="xml">
            <list string="Customer Incident Communications" sample="1">
                <field name="partner_id"/>
                <field name="incident_ref"/>
                <field name="channel"/>
                <field name="message_sent"/>
                <field name="sent_at"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state in ('submitted','approved')"/>
            </list>
        </field>
    </record>
    <record id="view_sf_customer_comm_kanban" model="ir.ui.view">
        <field name="name">sf.customer.comm.kanban</field>
        <field name="model">sf.customer.comm</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_view" group_by="state">
                <field name="name"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <menuitem id="menu_sf_customer_comm_root" name="Customer Incident Communications" sequence="13"
              web_icon="sf_customer_incident_comms,static/description/icon.png"/>
    <menuitem id="menu_sf_customer_comm_main" name="Records"
              parent="menu_sf_customer_comm_root" action="action_sf_customer_comm" sequence="10"/>
</odoo>
