<odoo>
    <record id="action_portal_config" model="ir.actions.act_window">
        <field name="name">Portal Configuration</field>
        <field name="res_model">portal.config</field>
        <field name="view_mode">kanban,list,form</field>
    </record>
    <record id="action_portal_payment" model="ir.actions.act_window">
        <field name="name">Portal Payments</field>
        <field name="res_model">portal.payment</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_group_by_state': 1}</field>
    </record>
    <record id="action_portal_ticket" model="ir.actions.act_window">
        <field name="name">Support Tickets</field>
        <field name="res_model">portal.ticket</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_group_by_state': 1}</field>
    </record>
    <record id="action_portal_document" model="ir.actions.act_window">
        <field name="name">Portal Documents</field>
        <field name="res_model">portal.document</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_group_by_document_type': 1}</field>
    </record>
    <record id="action_portal_subscription" model="ir.actions.act_window">
        <field name="name">Subscription Management</field>
        <field name="res_model">portal.subscription.mgmt</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_portal_tag" model="ir.actions.act_window">
        <field name="name">Document Tags</field>
        <field name="res_model">portal.document.tag</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_portal_config_form" model="ir.ui.view">
        <field name="name">portal.config.form</field>
        <field name="model">portal.config</field>
        <field name="arch" type="xml">
            <form string="Portal Configuration">
                <header>
                    <button name="action_test_connection" type="object" string="Test Connection" class="btn-primary"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="company_id"/>
                            <field name="logo" widget="image"/>
                            <field name="favicon" widget="image"/>
                        </group>
                        <group>
                            <field name="primary_color"/>
                            <field name="secondary_color"/>
                            <field name="custom_css" widget="text"/>
                            <field name="custom_domain"/>
                            <field name="use_subdomain"/>
                            <field name="subdomain" invisible="not use_subdomain"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Features" name="features">
                            <group>
                                <group string="Enabled Modules">
                                    <field name="enable_payments"/>
                                    <field name="enable_subscriptions"/>
                                    <field name="enable_returns"/>
                                    <field name="enable_tickets"/>
                                    <field name="enable_documents"/>
                                    <field name="enable_knowledge_base"/>
                                </group>
                                <group string="Payment Providers">
                                    <field name="payment_provider_ids" widget="many2many_tags"/>
                                </group>
                            </group>
                        </page>
                        <page string="Authentication" name="auth">
                            <group>
                                <group>
                                    <field name="auth_method"/>
                                    <field name="allow_registration"/>
                                    <field name="require_verification"/>
                                </group>
                                <group string="Languages">
                                    <field name="language_ids" widget="many2many_tags"/>
                                </group>
                            </group>
                        </page>
                        <page string="Email Templates" name="templates">
                            <group>
                                <field name="welcome_template_id"/>
                                <field name="invoice_notification_template_id"/>
                                <field name="ticket_notification_template_id"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_portal_config_list" model="ir.ui.view">
        <field name="name">portal.config.list</field>
        <field name="model">portal.config</field>
        <field name="arch" type="xml">
            <list decoration-danger="is_overdue" string="Portal Configurations">
                <field name="name"/>
                <field name="company_id"/>
                <field name="custom_domain"/>
                <field name="enable_payments" optional="hide"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_portal_payment_form" model="ir.ui.view">
        <field name="name">portal.payment.form</field>
        <field name="model">portal.payment</field>
        <field name="arch" type="xml">
            <form string="Portal Payment">
                <header>
                    <button name="action_confirm" type="object" string="Confirm" class="btn-primary" invisible="state != 'pending'"/>
                    <button name="action_refund" type="object" string="Refund" class="btn-secondary" invisible="state != 'done'"/>
                    <field name="state" widget="statusbar" statusbar_visible="pending,processing,done,cancelled,error"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="invoice_id"/>
                            <field name="amount"/>
                            <field name="currency_id"/>
                        </group>
                        <group>
                            <field name="provider_id"/>
                            <field name="transaction_id"/>
                            <field name="external_reference"/>
                            <field name="paid_date"/>
                            <field name="error_message" invisible="state != 'error'"/>
                        </group>
                    </group>
                    <group invisible="1">
                        <field name="config_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_portal_payment_list" model="ir.ui.view">
        <field name="name">portal.payment.list</field>
        <field name="model">portal.payment</field>
        <field name="arch" type="xml">
            <list string="Portal Payments">
                <field name="create_date"/>
                <field name="partner_id"/>
                <field name="invoice_id"/>
                <field name="amount"/>
                <field name="currency_id"/>
                <field name="provider_id"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_portal_ticket_form" model="ir.ui.view">
        <field name="name">portal.ticket.form</field>
        <field name="model">portal.ticket</field>
        <field name="arch" type="xml">
            <form string="Support Ticket">
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="new,assigned,in_progress,resolved,closed"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="partner_id"/>
                            <field name="category"/>
                            <field name="priority" widget="priority"/>
                            <field name="sla_status" readonly="1"/>
                            <field name="sla_deadline"/>
                        </group>
                        <group>
                            <field name="user_id"/>
                            <field name="team_id"/>
                            <field name="resolved_date" readonly="1"/>
                            <field name="closed_date" readonly="1"/>
                            <field name="satisfaction" invisible="state not in ('resolved','closed')"/>
                        </group>
                    </group>
                    <group string="Description">
                        <field name="description"/>
                    </group>
                    <group string="Resolution" invisible="state not in ('resolved','closed')">
                        <field name="resolution"/>
                    </group>
                    <group invisible="1">
                        <field name="config_id"/>
                        <field name="company_id"/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_portal_ticket_list" model="ir.ui.view">
        <field name="name">portal.ticket.list</field>
        <field name="model">portal.ticket</field>
        <field name="arch" type="xml">
            <list string="Support Tickets">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="category"/>
                <field name="priority" widget="priority"/>
                <field name="user_id"/>
                <field name="state"/>
                <field name="create_date"/>
            </list>
        </field>
    </record>

    <record id="view_portal_document_form" model="ir.ui.view">
        <field name="name">portal.document.form</field>
        <field name="model">portal.document</field>
        <field name="arch" type="xml">
            <form string="Portal Document">
                <sheet>
                    <div class="oe_button_box">
                        <button name="action_download" type="object" class="oe_stat_button" icon="fa-download">
                            <div class="o_stat_info">Download</div>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="document_type"/>
                            <field name="file" filename="filename"/>
                            <field name="filename"/>
                            <field name="mimetype" readonly="1"/>
                        </group>
                        <group>
                            <field name="publish_date"/>
                            <field name="expiry_date"/>
                            <field name="version"/>
                            <field name="is_featured"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group string="Access">
                        <field name="partner_ids" widget="many2many_tags"/>
                        <field name="company_ids" widget="many2many_tags"/>
                        <field name="tags" widget="many2many_tags"/>
                    </group>
                    <group string="Description">
                        <field name="description"/>
                    </group>
                    <group string="Version Notes">
                        <field name="version_notes"/>
                    </group>
                    <group invisible="1">
                        <field name="config_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_portal_document_list" model="ir.ui.view">
        <field name="name">portal.document.list</field>
        <field name="model">portal.document</field>
        <field name="arch" type="xml">
            <list string="Portal Documents">
                <field name="name"/>
                <field name="document_type"/>
                <field name="publish_date"/>
                <field name="expiry_date"/>
                <field name="version"/>
                <field name="is_featured" widget="boolean"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_portal_subscription_form" model="ir.ui.view">
        <field name="name">portal.subscription.mgmt.form</field>
        <field name="model">portal.subscription.mgmt</field>
        <field name="arch" type="xml">
            <form string="Subscription Management">
                <header>
                    <button name="action_upgrade" type="object" string="Upgrade" class="btn-primary" invisible="not allow_upgrade"/>
                    <button name="action_cancel" type="object" string="Cancel" class="btn-secondary" invisible="not allow_cancel"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="subscription_id"/>
                        </group>
                        <group string="Portal Permissions">
                            <field name="allow_upgrade"/>
                            <field name="allow_downgrade"/>
                            <field name="allow_cancel"/>
                            <field name="allow_pause"/>
                            <field name="allow_payment_update"/>
                            <field name="default_payment_method_id"/>
                        </group>
                    </group>
                    <group>
                        <group string="Notifications">
                            <field name="notify_renewal_days"/>
                            <field name="notify_payment_failed"/>
                        </group>
                        <group string="Usage Display">
                            <field name="show_usage"/>
                            <field name="usage_limit_alert"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_portal_subscription_list" model="ir.ui.view">
        <field name="name">portal.subscription.mgmt.list</field>
        <field name="model">portal.subscription.mgmt</field>
        <field name="arch" type="xml">
            <list string="Subscription Management">
                <field name="partner_id"/>
                <field name="subscription_id"/>
                <field name="allow_upgrade" widget="boolean"/>
                <field name="allow_cancel" widget="boolean"/>
            </list>
        </field>
    </record>

    <record id="view_portal_tag_form" model="ir.ui.view">
        <field name="name">portal.document.tag.form</field>
        <field name="model">portal.document.tag</field>
        <field name="arch" type="xml">
            <form string="Document Tag">
                <group>
                    <field name="name"/>
                    <field name="color" widget="color_picker"/>
                </group>
            </form>
        </field>
    </record>
    <record id="view_portal_tag_list" model="ir.ui.view">
        <field name="name">portal.document.tag.list</field>
        <field name="model">portal.document.tag</field>
        <field name="arch" type="xml">
            <list string="Document Tags">
                <field name="name"/>
                <field name="color" widget="color_picker"/>
            </list>
        </field>
    </record>

    <menuitem id="menu_portal_root" name="Customer Portal" sequence="60" web_icon="sf_customer_portal_pro,static/description/icon.png"/>
    <menuitem id="menu_portal_config" name="Configuration" parent="menu_portal_root" action="action_portal_config" sequence="10"/>
    <menuitem id="menu_portal_tickets" name="Support Tickets" parent="menu_portal_root" action="action_portal_ticket" sequence="20"/>
    <menuitem id="menu_portal_payments" name="Payments" parent="menu_portal_root" action="action_portal_payment" sequence="30"/>
    <menuitem id="menu_portal_documents" name="Documents" parent="menu_portal_root" action="action_portal_document" sequence="40"/>
    <menuitem id="menu_portal_subscriptions" name="Subscriptions" parent="menu_portal_root" action="action_portal_subscription" sequence="50"/>
    <menuitem id="menu_portal_tags" name="Document Tags" parent="menu_portal_root" action="action_portal_tag" sequence="60"/>

    <record id="view_sf_customer_portal_pro_boost_kanban" model="ir.ui.view">
        <field name="name">sf_customer_portal_pro.boost.kanban</field>
        <field name="model">portal.config</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" t-att-color="state">
                <field name="name"/>
                <field name="state"/>
                <field name="expiry_date"/>
                <field name="is_overdue" invisible="1"/>

                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_card oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title">
                                    <field name="name"/></strong>
                                <div class="o_kanban_record_subtitle">
                                    <field name="user_id" widget="many2one_avatar_user"/>
                                    <field name="expiry_date"/></div>
                            </div>
                            <div class="oe_kanban_bottom_right">
                                <field name="state" widget="badge"
                                       t-attf-options="{'classes_map': {'draft': 'info', 'done': 'success', 'cancelled': 'danger'}, 'domain': []}"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_sf_customer_portal_pro_boost_search" model="ir.ui.view">
        <field name="name">sf_customer_portal_pro.boost.search</field>
        <field name="model">portal.config</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
<separator/>
                <filter string="To Do" name="todo" domain="[('state', 'not in', ('done', 'cancelled', 'closed'))]"/>
                <group expand="0" string="Group By"><filter string="Status" name="gb_state" context="{'group_by': 'state'}"/></group>
            </search>
        </field>
    </record>
</odoo>