<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_sf_customer_portal_pro" model="ir.module.category">
        <field name="name">Customer Portal Pro</field>
        <field name="description">Customer Portal Pro Management</field>
        <field name="sequence">10</field>
    </record>

    <record id="group_sf_customer_portal_pro_user" model="res.groups">
        <field name="name">Customer Portal Pro / User</field>
        <field name="category_id" ref="module_category_sf_customer_portal_pro"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_sf_customer_portal_pro_manager" model="res.groups">
        <field name="name">Customer Portal Pro / Manager</field>
        <field name="category_id" ref="module_category_sf_customer_portal_pro"/>
        <field name="implied_ids" eval="[(4, ref('sf_customer_portal_pro.group_sf_customer_portal_pro_user'))]"/>
    </record>

    <record id="rule_sf_customer_portal_pro_company" model="ir.rule">
        <field name="name">Customer Portal Pro: user sees own company</field>
        <field name="model_id" ref="model_sf_customer_portal_pro"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('sf_customer_portal_pro.group_sf_customer_portal_pro_user'))]"/>
    </record>
    <record id="rule_sf_customer_portal_pro_manager_all" model="ir.rule">
        <field name="name">Customer Portal Pro: manager sees all companies</field>
        <field name="model_id" ref="model_sf_customer_portal_pro"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('sf_customer_portal_pro.group_sf_customer_portal_pro_manager'))]"/>
    </record>
</odoo>