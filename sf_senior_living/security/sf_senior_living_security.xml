<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_sf_senior_living" model="ir.module.category">
        <field name="name">Senior Living</field>
        <field name="description">Senior Living &amp; Retirement Community Management.</field>
        <field name="sequence">10</field>
    </record>

    <record id="group_sf_senior_living_user" model="res.groups">
        <field name="name">Senior Living / User</field>
        <field name="category_id" ref="module_category_sf_senior_living"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_sf_senior_living_manager" model="res.groups">
        <field name="name">Senior Living / Manager</field>
        <field name="category_id" ref="module_category_sf_senior_living"/>
        <field name="implied_ids" eval="[(4, ref('sf_senior_living.group_sf_senior_living_user'))]"/>
    </record>

    <record id="rule_sf_senior_residence_company" model="ir.rule">
        <field name="name">Residence: user sees own company</field>
        <field name="model_id" ref="model_sf_senior_residence"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('sf_senior_living.group_sf_senior_living_user'))]"/>
    </record>
    <record id="rule_sf_senior_residence_manager_all" model="ir.rule">
        <field name="name">Residence: manager sees all companies</field>
        <field name="model_id" ref="model_sf_senior_residence"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('sf_senior_living.group_sf_senior_living_manager'))]"/>
    </record>

    <record id="rule_sf_senior_resident_company" model="ir.rule">
        <field name="name">Resident: user sees own company</field>
        <field name="model_id" ref="model_sf_senior_resident"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('sf_senior_living.group_sf_senior_living_user'))]"/>
    </record>
    <record id="rule_sf_senior_resident_manager_all" model="ir.rule">
        <field name="name">Resident: manager sees all companies</field>
        <field name="model_id" ref="model_sf_senior_resident"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('sf_senior_living.group_sf_senior_living_manager'))]"/>
    </record>
    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_sf_senior_living"/>
    </record>
</odoo>
