<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Resident List View -->
        <record id=""""""view_sf_senior_resident_list"" model=""""""ir.ui.view"">
            <field name=""""""name"">sf.senior.resident.list</field>
            <field name=""""""model"">sf.senior.resident</field>
            <field name=""""""arch"" type=""""""xml"">
                <list string=""""""Residents"" decoration-info=""""""state==&apos;pre_admission&apos;"" decoration-success=""""""state==&apos;admitted&apos;"" decoration-muted=""""""state==&apos;discharged&apos;"" decoration-danger=""""""state==&apos;deceased&apos;"">
                    <field name=""""""name""/>
                    <field name=""""""partner_id""/>
                    <field name=""""""residence_id""/>
                    <field name=""""""room_id""/>
                    <field name=""""""state"" widget=""""""badge"" decoration=""""""{&apos;pre_admission&apos;: &apos;info&apos;, &apos;admitted&apos;: &apos;success&apos;, &apos;discharged&apos;: &apos;muted&apos;, &apos;deceased&apos;: &apos;danger&apos;}""/>
                    <field name=""""""gir_level""/>
                    <field name=""""""gir_next_evaluation""/>
                    <field name=""""""admission_date""/>
                    <field name=""""""discharge_date""/>
                </list>
            </field>
        </record>

        <!-- Resident Form View -->
        <record id=""""""view_sf_senior_resident_form"" model=""""""ir.ui.view"">
            <field name=""""""name"">sf.senior.resident.form</field>
            <field name=""""""model"">sf.senior.resident</field>
            <field name=""""""arch"" type=""""""xml"">
                <form string=""""""Resident"">
                    <header>
                        <button name=""""""action_pre_admission"" type=""""""object"" string=""""""Pre-Admission"" class=""""""btn-secondary"" invisible=""""""state!=&apos;draft&apos;""/>
                        <button name=""""""action_admit"" type=""""""object"" string=""""""Admit"" class=""""""btn-primary"" invisible=""""""state!=&apos;pre_admission&apos;"" groups=""""""sf_senior_living.group_sf_senior_manager""/>
                        <button name=""""""action_discharge"" type=""""""object"" string=""""""Discharge"" class=""""""btn-warning"" invisible=""""""state!=&apos;admitted&apos;"" groups=""""""sf_senior_living.group_sf_senior_manager""/>
                        <button name=""""""action_deceased"" type=""""""object"" string=""""""Deceased"" class=""""""btn-danger"" invisible=""""""state!=&apos;admitted&apos;"" groups=""""""sf_senior_living.group_sf_senior_manager""/>
                        <field name=""""""state"" widget=""""""statusbar"" statusbar_visible=""""""pre_admission,admitted,discharged,deceased""/>
                    </header>
                    <sheet>
                        <div class=""""""oe_button_box"" name=""""""button_box"">
                            <button name=""""""%(action_sf_senior_care_plan)d"" type=""""""action"" class=""""""oe_stat_button"" icon=""""""fa-stethoscope"" string=""""""Care Plans"">
                                <field name=""""""care_plan_ids"" widget=""""""statinfo"" string=""""""Care Plans""/>
                            </button>
                            <button name=""""""%(action_sf_senior_gir_evaluation)d"" type=""""""action"" class=""""""oe_stat_button"" icon=""""""fa-chart-bar"" string=""""""GIR Evaluations"">
                                <field name=""""""gir_evaluation_ids"" widget=""""""statinfo"" string=""""""Evaluations""/>
                            </button>
                            <button name=""""""%(action_sf_senior_activity)d"" type=""""""action"" class=""""""oe_stat_button"" icon=""""""fa-calendar"" string=""""""Activities"">
                                <field name=""""""activity_participant_ids"" widget=""""""statinfo"" string=""""""Activities""/>
                            </button>
                            <button name=""""""%(action_sf_senior_invoice_line)d"" type=""""""action"" class=""""""oe_stat_button"" icon=""""""fa-file-invoice-dollar"" string=""""""Invoices"">
                                <field name=""""""invoice_line_ids"" widget=""""""statinfo"" string=""""""Invoice Lines""/>
                            </button>
                        </div>
                        <div class=""""""oe_title"">
                            <h1>
                                <field name=""""""name"" placeholder=""""""Reference (auto)"" readonly=""""""1""/>
                                <field name=""""""partner_id"" placeholder=""""""Name"" class=""""""oe_inline"" required=""""""1""/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name=""""""residence_id"" required=""""""1""/>
                                <field name=""""""room_id"" domain=""""""[(&apos;residence_id&apos;, &apos;=&apos;, residence_id), (&apos;state&apos;, &apos;in&apos;, [&apos;free&apos;, &apos;reserved&apos;])]""/>
                                <field name=""""""admission_date""/>
                                <field name=""""""discharge_date"" invisible=""""""state not in (&apos;discharged&apos;,&apos;deceased&apos;)""/>
                                <field name=""""""discharge_reason"" invisible=""""""state not in (&apos;discharged&apos;,&apos;deceased&apos;)""/>
                                <field name=""""""gir_level"" groups=""""""sf_senior_living.group_sf_senior_medical,sf_senior_living.group_sf_senior_manager""/>
                                <field name=""""""gir_evaluation_date"" groups=""""""sf_senior_living.group_sf_senior_medical,sf_senior_living.group_sf_senior_manager""/>
                                <field name=""""""gir_next_evaluation"" readonly=""""""1"" groups=""""""sf_senior_living.group_sf_senior_medical,sf_senior_living.group_sf_senior_manager""/>
                            </group>
                            <group>
                                <field name=""""""pps_date"" groups=""""""sf_senior_living.group_sf_senior_medical,sf_senior_living.group_sf_senior_manager""/>
                                <field name=""""""pps_next_review"" readonly=""""""1"" groups=""""""sf_senior_living.group_sf_senior_medical,sf_senior_living.group_sf_senior_manager""/>
                                <field name=""""""contract_id"" groups=""""""sf_senior_living.group_sf_senior_manager""/>
                                <field name=""""""state"" readonly=""""""1""/>
                                <field name=""""""family_portal_access"" groups=""""""sf_senior_living.group_sf_senior_manager""/>
                                <field name=""""""medical_portal_consent"" groups=""""""sf_senior_living.group_sf_senior_medical,sf_senior_living.group_sf_senior_manager""/>
                                <field name=""""""company_id"" options=""""""{&apos;no_create&apos;: True}"" groups=""""""base.group_multi_company""/>
                            </group>
                        </group>
                        <notebook>
                            <page string=""""""Medical"" groups=""""""sf_senior_living.group_sf_senior_medical,sf_senior_living.group_sf_senior_manager"">
                                <group>
                                    <group string=""""""Pathologies"">
                                        <field name=""""""pathology_ids"" widget=""""""many2many_tags""/>
                                    </group>
                                    <group string=""""""Allergies"">
                                        <field name=""""""allergy_ids"" widget=""""""many2many_tags""/>
                                    </group>
                                </group>
                                <group string=""""""Current Treatments"">
                                    <field name=""""""treatment_ids"">
                                        <list editable=""""""bottom"">
                                            <field name=""""""medication_id""/>
                                            <field name=""""""dosage""/>
                                            <field name=""""""frequency""/>
                                            <field name=""""""route""/>
                                            <field name=""""""start_date""/>
                                            <field name=""""""end_date""/>
                                            <field name=""""""prescriber_id""/>
                                            <field name=""""""active""/>
                                        </list>
                                    </field>
                                </group>
                            </page>
                            <page string=""""""Care Plans"" groups=""""""sf_senior_living.group_sf_senior_medical,sf_senior_living.group_sf_senior_manager"">
                                <field name=""""""care_plan_ids"">
                                    <list>
                                        <field name=""""""name""/>
                                        <field name=""""""version""/>
                                        <field name=""""""start_date""/>
                                        <field name=""""""end_date""/>
                                        <field name=""""""state""/>
                                        <field name=""""""pps_validated""/>
                                    </list>
                                </field>
                            </page>
                            <page string=""""""Nursing Notes"" groups=""""""sf_senior_living.group_sf_senior_medical,sf_senior_living.group_sf_senior_manager"">
                                <field name=""""""nursing_note_ids"">
                                    <list>
                                        <field name=""""""name""/>
                                        <field name=""""""note_date""/>
                                        <field name=""""""shift""/>
                                        <field name=""""""author_id""/>
                                        <field name=""""""alert""/>
                                        <field name=""""""alert_type""/>
                                    </list>
                                </field>
                            </page>
                            <page string=""""""GIR Evaluations"" groups=""""""sf_senior_living.group_sf_senior_medical,sf_senior_living.group_sf_senior_manager"">
                                <field name=""""""gir_evaluation_ids"">
                                    <list>
                                        <field name=""""""name""/>
                                        <field name=""""""evaluation_date""/>
                                        <field name=""""""gir_level""/>
                                        <field name=""""""score_total""/>
                                        <field name=""""""state""/>
                                    </list>
                                </field>
                            </page>
                            <page string=""""""Family Contacts"">
                                <field name=""""""family_contact_ids"">
                                    <list editable=""""""bottom"">
                                        <field name=""""""partner_id""/>
                                        <field name=""""""relationship""/>
                                        <field name=""""""is_main_contact""/>
                                        <field name=""""""has_portal_access""/>
                                    </list>
                                </field>
                            </page>
                            <page string=""""""Legal"">
                                <group>
                                    <field name=""""""tutor_id""/>
                                    <field name=""""""emergency_contact_id""/>
                                </group>
                            </page>
                            <page string=""""""Activities"" groups=""""""sf_senior_living.group_sf_senior_user,sf_senior_living.group_sf_senior_manager,sf_senior_living.group_sf_senior_family"">
                                <field name=""""""activity_participant_ids"">
                                    <list>
                                        <field name=""""""name""/>
                                        <field name=""""""planned_date""/>
                                        <field name=""""""activity_type""/>
                                        <field name=""""""state""/>
                                    </list>
                                </field>
                            </page>
                            <page string=""""""Meals"" groups=""""""sf_senior_living.group_sf_senior_user,sf_senior_living.group_sf_senior_manager"">
                                <field name=""""""meal_regime_ids"">
                                    <list>
                                        <field name=""""""name""/>
                                        <field name=""""""regime_type""/>
                                        <field name=""""""start_date""/>
                                        <field name=""""""end_date""/>
                                    </list>
                                </field>
                                <field name=""""""meal_order_ids"">
                                    <list>
                                        <field name=""""""name""/>
                                        <field name=""""""menu_id""/>
                                        <field name=""""""regime_applied""/>
                                        <field name=""""""quantity""/>
                                        <field name=""""""state""/>
                                        <field name=""""""billed""/>
                                    </list>
                                </field>
                            </page>
                            <page string=""""""Billing"" groups=""""""sf_senior_living.group_sf_senior_user,sf_senior_living.group_sf_senior_manager,sf_senior_living.group_sf_senior_family"">
                                <field name=""""""invoice_line_ids"">
                                    <list>
                                        <field name=""""""name""/>
                                        <field name=""""""invoice_id""/>
                                        <field name=""""""line_type""/>
                                        <field name=""""""period_start""/>
                                        <field name=""""""period_end""/>
                                        <field name=""""""price_subtotal""/>
                                    </list>
                                </field>
                            </page>
                            <page string=""""""Messages"" groups=""""""sf_senior_living.group_sf_senior_user,sf_senior_living.group_sf_senior_manager,sf_senior_living.group_sf_senior_family"">
                                <field name=""""""family_message_ids"">
                                    <list>
                                        <field name=""""""name""/>
                                        <field name=""""""sender_id""/>
                                        <field name=""""""recipient_type""/>
                                        <field name=""""""subject""/>
                                        <field name=""""""priority""/>
                                        <field name=""""""is_read""/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                    <div class=""""""oe_chatter"">
                        <field name=""""""message_follower_ids"" widget=""""""mail_followers""/>
                        <field name=""""""activity_ids"" widget=""""""mail_activity""/>
                        <field name=""""""message_ids"" widget=""""""mail_thread""/>
                    </div>
                </form>
            </field>
        </record>

        <!-- Resident Search View -->
        <record id=""""""view_sf_senior_resident_search"" model=""""""ir.ui.view"">
            <field name=""""""name"">sf.senior.resident.search</field>
            <field name=""""""model"">sf.senior.resident</field>
            <field name=""""""arch"" type=""""""xml"">
                <search string=""""""Search Residents"">
                    <field name=""""""name""/>
                    <field name=""""""partner_id""/>
                    <field name=""""""room_id""/>
                    <filter string=""""""Pre-Admission"" name=""""""pre_admission"" domain=""""""[(&apos;state&apos;, &apos;=&apos;, &apos;pre_admission&apos;)]""/>
                    <filter string=""""""Admitted"" name=""""""admitted"" domain=""""""[(&apos;state&apos;, &apos;=&apos;, &apos;admitted&apos;)]""/>
                    <filter string=""""""Discharged"" name=""""""discharged"" domain=""""""[(&apos;state&apos;, &apos;=&apos;, &apos;discharged&apos;)]""/>
                    <filter string=""""""Deceased"" name=""""""deceased"" domain=""""""[(&apos;state&apos;, &apos;=&apos;, &apos;deceased&apos;)]""/>
                    <filter string=""""""GIR Evaluation Due"" name=""""""gir_due"" domain=""""""[(&apos;gir_next_evaluation&apos;, &apos;<=&apos;, fields.Date.today()), (&apos;state&apos;, &apos;=&apos;, &apos;admitted&apos;)]""/>
                    <filter string=""""""PPS Review Due"" name=""""""pps_due"" domain=""""""[(&apos;pps_next_review&apos;, &apos;<=&apos;, fields.Date.today()), (&apos;state&apos;, &apos;=&apos;, &apos;admitted&apos;)]""/>
                    <group string=""""""Group By"">
                        <filter string=""""""Residence"" name=""""""group_by_residence"" context=""""""{&apos;group_by&apos;: &apos;residence_id&apos;}""/>
                        <filter string=""""""Room"" name=""""""group_by_room"" context=""""""{&apos;group_by&apos;: &apos;room_id&apos;}""/>
                        <filter string=""""""State"" name=""""""group_by_state"" context=""""""{&apos;group_by&apos;: &apos;state&apos;}""/>
                        <filter string=""""""GIR Level"" name=""""""group_by_gir"" context=""""""{&apos;group_by&apos;: &apos;gir_level&apos;}""/>
                    </group>
                </search>
            </field>
        </record>

        <!-- Resident Action -->
        <record id=""""""action_sf_senior_resident"" model=""""""ir.actions.act_window"">
            <field name=""""""name"">Residents</field>
            <field name=""""""res_model"">sf.senior.resident</field>
            <field name=""""""view_mode"">list,form</field>
        </record>
    </data>
</odoo>