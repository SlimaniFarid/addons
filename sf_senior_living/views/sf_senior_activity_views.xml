                                    <div><field name=""""""animator_id""/></div>
                                    <div class=""""""mt-2"">
                                        <span class=""""""badge"" t-att-class=""""""{&apos;bg-info&apos;: record.state.raw_value==&apos;planned&apos;, &apos;bg-warning&apos;: record.state.raw_value==&apos;open_registration&apos;, &apos;bg-primary&apos;: record.state.raw_value==&apos;in_progress&apos;, &apos;bg-success&apos;: record.state.raw_value==&apos;done&apos;, &apos;bg-danger&apos;: record.state.raw_value==&apos;cancelled&apos;}"">
                                            <field name=""""""state""/>
                                        </span>
                                        <span class=""""""ms-2""><field name=""""""actual_participants""/> / <field name=""""""capacity_max""/></span>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

