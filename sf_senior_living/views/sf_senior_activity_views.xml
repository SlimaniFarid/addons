        <!-- Activity Kanban View -->
        <record id=""""""view_sf_senior_activity_kanban"" model=""""""ir.ui.view"">
            <field name=""""""name"">sf.senior.activity.kanban</field>
            <field name=""""""model"">sf.senior.activity</field>
            <field name=""""""arch"" type=""""""xml"">
