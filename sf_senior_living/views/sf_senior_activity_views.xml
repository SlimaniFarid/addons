            <field name=""""""model"">sf.senior.activity</field>
            <field name=""""""arch"" type=""""""xml"">
                <list string=""""""Activities"" decoration-info=""""""state==&apos;planned&apos;"" decoration-warning=""""""state==&apos;open_registration&apos;"" decoration-primary=""""""state==&apos;in_progress&apos;"" decoration-success=""""""state==&apos;done&apos;"" decoration-danger=""""""state==&apos;cancelled&apos;"">
                    <field name=""""""name""/>
                    <field name=""""""residence_id""/>
                    <field name=""""""activity_type""/>
                    <field name=""""""category""/>
                    <field name=""""""planned_date""/>
                    <field name=""""""duration_minutes""/>
                    <field name=""""""location_id""/>
                    <field name=""""""animator_id""/>
                    <field name=""""""capacity_max""/>
                    <field name=""""""actual_participants""/>
