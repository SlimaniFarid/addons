            <field name=""""""model"">sf.senior.activity</field>
            <field name=""""""arch"" type=""""""xml"">
                <form string=""""""Activity"">
                    <header>
                        <button name=""""""action_open_registration"" type=""""""object"" string=""""""Open Registration"" class=""""""btn-secondary"" invisible=""""""state!=&apos;planned&apos;"" groups=""""""sf_senior_living.group_sf_senior_user""/>
                        <button name=""""""action_start"" type=""""""object"" string=""""""Start"" class=""""""btn-primary"" invisible=""""""state not in (&apos;planned&apos;, &apos;open_registration&apos;)"" groups=""""""sf_senior_living.group_sf_senior_user""/>
                        <button name=""""""action_done"" type=""""""object"" string=""""""Done"" class=""""""btn-success"" invisible=""""""state!=&apos;in_progress&apos;"" groups=""""""sf_senior_living.group_sf_senior_user""/>
                        <button name=""""""action_cancel"" type=""""""object"" string=""""""Cancel"" class=""""""btn-danger"" invisible=""""""state==&apos;done&apos;"" groups=""""""sf_senior_living.group_sf_senior_user""/>
                        <field name=""""""state"" widget=""""""statusbar"" statusbar_visible=""""""planned,open_registration,in_progress,done,cancelled""/>
                    </header>
                    <sheet>
                        <div class=""""""oe_title"">
                            <h1><field name=""""""name"" placeholder=""""""Reference (auto)"" readonly=""""""1""/></h1>
                        </div>
                        <group>
                            <group>
                                <field name=""""""residence_id"" required=""""""1""/>
                                <field name=""""""activity_type"" required=""""""1""/>
                                <field name=""""""category"" required=""""""1""/>
                                <field name=""""""planned_date"" required=""""""1""/>
                                <field name=""""""duration_minutes""/>
                            </group>
                            <group>
                                <field name=""""""location_id"" domain=""""""[(&apos;residence_id&apos;, &apos;=&apos;, residence_id)]""/>
                                <field name=""""""animator_id""/>
                                <field name=""""""capacity_max""/>
                                <field name=""""""state"" readonly=""""""1""/>
                            </group>
                        </group>
                        <group string=""""""Description"">
                            <field name=""""""description""/>
                        </group>
                        <group string=""""""Participants"">
                            <field name=""""""participant_ids"" widget=""""""many2many_tags"" domain=""""""[(&apos;residence_id&apos;, &apos;=&apos;, residence_id), (&apos;state&apos;, &apos;=&apos;, &apos;admitted&apos;)]""/>
                            <field name=""""""waitlist_ids"" widget=""""""many2many_tags"" domain=""""""[(&apos;residence_id&apos;, &apos;=&apos;, residence_id), (&apos;state&apos;, &apos;=&apos;, &apos;admitted&apos;)]""/>
                        </group>
                        <group string=""""""Notes"">
                            <field name=""""""notes""/>
                        </group>
                    </sheet>
                    <div class=""""""oe_chatter"">
                        <field name=""""""message_follower_ids"" widget=""""""mail_followers""/>
                        <field name=""""""activity_ids"" widget=""""""mail_activity""/>
                        <field name=""""""message_ids"" widget=""""""mail_thread""/>
                    </div>
                </form>
            </field>
        </record>

