            <field name=""""""model"">sf.senior.room</field>
            <field name=""""""arch"" type=""""""xml"">
                <list string=""""""Rooms"" decoration-info=""""""state==&apos;reserved&apos;"" decoration-success=""""""state==&apos;free&apos;"" decoration-warning=""""""state==&apos;maintenance&apos;"" decoration-danger=""""""state in (&apos;occupied&apos;,&apos;blocked&apos;)"">
