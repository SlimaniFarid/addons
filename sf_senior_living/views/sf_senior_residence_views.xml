<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Residence List View -->
        <record id=""""""view_sf_senior_residence_list"" model=""""""ir.ui.view"">
            <field name=""""""name"">sf.senior.residence.list</field>
            <field name=""""""model"">sf.senior.residence</field>
            <field name=""""""arch"" type=""""""xml"">
                <list string=""""""Residences"" decoration-info=""""""state==&apos;pre_admission&apos;"" decoration-success=""""""state==&apos;admitted&apos;"" decoration-danger=""""""state in (&apos;discharged&apos;,&apos;deceased&apos;)"">
                    <field name=""""""name""/>
                    <field name=""""""address_id""/>
                    <field name=""""""director_id""/>
                    <field name=""""""medical_coordinator_id""/>
                    <field name=""""""capacity_total""/>
                    <field name=""""""active"" widget=""""""boolean_toggle""/>
                </list>
            </field>
        </record>

        <!-- Residence Form View -->
        <record id=""""""view_sf_senior_residence_form"" model=""""""ir.ui.view"">
            <field name=""""""name"">sf.senior.residence.form</field>
            <field name=""""""model"">sf.senior.residence</field>
            <field name=""""""arch"" type=""""""xml"">
                <form string=""""""Residence"">
                    <sheet>
                        <div class=""""""oe_button_box"" name=""""""button_box"">
                            <button name=""""""action_view_rooms"" type=""""""object"" class=""""""oe_stat_button"" icon=""""""fa-building"" string=""""""Rooms"">
                                <field name=""""""building_ids"" widget=""""""statinfo"" string=""""""Buildings""/>
                            </button>
                            <button name=""""""action_view_residents"" type=""""""object"" class=""""""oe_stat_button"" icon=""""""fa-users"" string=""""""Residents"">
                                <field name=""""""resident_ids"" widget=""""""statinfo"" string=""""""Residents""/>
                            </button>
                            <button name=""""""action_generate_monthly_billing"" type=""""""object"" class=""""""oe_stat_button"" icon=""""""fa-file-invoice-dollar"" string=""""""Generate Billing"" groups=""""""sf_senior_living.group_sf_senior_manager""/>
                        </div>
                        <div class=""""""oe_title"">
                            <h1>
                                <field name=""""""name"" placeholder=""""""Reference (auto)""/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name=""""""address_id"" required=""""""1""/>
                                <field name=""""""director_id""/>
                                <field name=""""""medical_coordinator_id""/>
                                <field name=""""""phone""/>
                                <field name=""""""email""/>
                                <field name=""""""website""/>
                            </group>
                            <group>
                                <field name=""""""capacity_total"" readonly=""""""1""/>
                                <field name=""""""active"" widget=""""""boolean_toggle""/>
                                <field name=""""""company_id"" options=""""""{&apos;no_create&apos;: True}"" groups=""""""base.group_multi_company""/>
                            </group>
                        </group>
                        <notebook>
                            <page string=""""""Billing Configuration"">
                                <group>
                                    <group>
                                        <field name=""""""care_fee_monthly""/>
                                        <field name=""""""service_fee_monthly""/>
                                        <field name=""""""income_account_accommodation_id""/>
                                        <field name=""""""income_account_dependency_id""/>
                                        <field name=""""""income_account_care_id""/>
                                    </group>
                                    <group>
                                        <field name=""""""income_account_service_id""/>
                                        <field name=""""""income_account_meal_id""/>
                                        <field name=""""""journal_id""/>
                                    </group>
                                </group>
                            </page>
                            <page string=""""""Alert Configuration"">
                                <group>
                                    <group>
                                        <field name=""""""gir_alert_days_before""/>
                                        <field name=""""""gir_alert_days_before_urgent""/>
                                        <field name=""""""pps_alert_days_before""/>
                                    </group>
                                    <group>
                                        <field name=""""""max_room_reservation_days""/>
                                        <field name=""""""medical_portal_consent""/>
                                    </group>
                                </group>
                            </page>
                            <page string=""""""Contract Template"">
                                <field name=""""""contract_template_id""/>
                            </page>
                            <page string=""""""Buildings"">
                                <field name=""""""building_ids"">
                                    <list>
                                        <field name=""""""name""/>
                                        <field name=""""""floors""/>
                                        <field name=""""""room_ids"" widget=""""""many2many_tags""/>
                                    </list>
                                </field>
                            </page>
                            <page string=""""""Residents"">
                                <field name=""""""resident_ids"">
                                    <list>
                                        <field name=""""""name""/>
                                        <field name=""""""partner_id""/>
                                        <field name=""""""room_id""/>
                                        <field name=""""""state""/>
                                        <field name=""""""gir_level""/>
                                        <field name=""""""admission_date""/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                    <div class=""""""oe_chatter"">
                        <field name=""""""message_follower_ids"" widget=""""""mail_followers""/>
                        <field name=""""""activity_ids"" widget=""""""mail_activity""/>
                        <field name=""""""message_ids"" widget=""""""mail_thread""/>
                    </div>
                </form>
            </field>
        </record>

        <!-- Residence Search View -->
        <record id=""""""view_sf_senior_residence_search"" model=""""""ir.ui.view"">
            <field name=""""""name"">sf.senior.residence.search</field>
            <field name=""""""model"">sf.senior.residence</field>
            <field name=""""""arch"" type=""""""xml"">
                <search string=""""""Search Residences"">
                    <field name=""""""name""/>
                    <field name=""""""address_id""/>
                    <field name=""""""director_id""/>
                    <filter string=""""""Active"" name=""""""active"" domain=""""""[(&apos;active&apos;, &apos;=&apos;, True)]""/>
                    <filter string=""""""Inactive"" name=""""""inactive"" domain=""""""[(&apos;active&apos;, &apos;=&apos;, False)]""/>
                    <group string=""""""Group By"">
                        <filter string=""""""Company"" name=""""""group_by_company"" context=""""""{&apos;group_by&apos;: &apos;company_id&apos;}""/>
                        <filter string=""""""Director"" name=""""""group_by_director"" context=""""""{&apos;group_by&apos;: &apos;director_id&apos;}""/>
                    </group>
                </search>
            </field>
        </record>

