<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sf_senior_residence_list" model="ir.ui.view">
        <field name="name">sf.senior.residence.list</field>
        <field name="model">sf.senior.residence</field>
        <field name="arch" type="xml">
            <list decoration-danger="is_overdue" string="Residences">
                <field name="name"/>
                <field name="capacity"/>
                <field name="resident_count"/>
                <field name="state" widget="badge"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_sf_senior_residence_form" model="ir.ui.view">
        <field name="name">sf.senior.residence.form</field>
        <field name="model">sf.senior.residence</field>
        <field name="arch" type="xml">
            <form string="Senior Residence">
                <header>
                    <button name="action_close" string="Close" type="object"
                            invisible="state != 'active'" class="btn-secondary"/>
                    <button name="action_reopen" string="Reopen" type="object"
                            invisible="state != 'closed'" class="btn-primary"/>
                    <field name="state" widget="statusbar" readonly="1"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="phone"/>
                            <field name="email"/>
                            <field name="manager_id"/>
                        </group>
                        <group>
                            <field name="capacity"/>
                            <field name="resident_count"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <field name="address"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_sf_senior_residence" model="ir.actions.act_window">
        <field name="name">Residences</field>
        <field name="res_model">sf.senior.residence</field>
        <field name="view_mode">kanban,list,form</field>
    </record>

    <record id="view_sf_senior_living_boost_kanban" model="ir.ui.view">
        <field name="name">sf_senior_living.boost.kanban</field>
        <field name="model">sf_senior_living.activity.mixin</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" t-att-color="state">
                <field name="name"/>
                <field name="state"/>
                <field name="user_id"/>
                <field name="end_date"/>
                <field name="is_overdue" invisible="1"/>

                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_card oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title">
                                    <field name="name"/></strong>
                                <div class="o_kanban_record_subtitle">
                                    <field name="user_id" widget="many2one_avatar_user"/>
                                    <field name="end_date"/></div>
                            </div>
                            <div class="oe_kanban_bottom_right">
                                <field name="state" widget="badge"
                                       t-attf-options="{'classes_map': {'draft': 'info', 'done': 'success', 'cancelled': 'danger'}, 'domain': []}"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_sf_senior_living_boost_search" model="ir.ui.view">
        <field name="name">sf_senior_living.boost.search</field>
        <field name="model">sf_senior_living.activity.mixin</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
<separator/>
                <filter string="My records" name="my_records" domain="[('user_id', '=', uid)]"/>
                <filter string="To Do" name="todo" domain="[('state', 'not in', ('done', 'cancelled', 'closed'))]"/>
                <group expand="0" string="Group By"><filter string="Status" name="gb_state" context="{'group_by': 'state'}"/></group>
            </search>
        </field>
    </record>

    <record id="wave_final_sf_senior_living" model="ir.actions.server">
        <field name="name">Refresh Business Data</field>
        <field name="model_id" ref="model_sf_senior_living_activity_mixin"/>
        <field name="binding_model_id" ref="model_sf_senior_living_activity_mixin"/>
        <field name="state">code</field>
        <field name="code">records.action_refresh_business()</field>
    </record>
</odoo>
