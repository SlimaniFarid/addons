            <field name=""""""res_model"">sf.senior.residence</field>
            <field name=""""""view_mode"">list,form</field>
            <field name=""""""help"" type=""""""html"">
                <p class=""""""o_view_nocontent_smiling_face"">Create the first residence</p>
            </field>
        </record>

