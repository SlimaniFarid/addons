            <field name=""""""code"">
                records = model.search([('state', '=', 'reserved')])
                for room in records:
                    # Check if reservation expired (max 30 days by default)
                    if room.create_date and (fields.Date.today() - room.create_date.date()).days > (room.residence_id.max_room_reservation_days or 30):
