<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <template id=""""""report_care_plan_template"">
            <div class=""""""page"">
                <div class=""""""page-header"">
                    <div class=""""""row"">
                        <div class=""""""col-6"">
                            <h2><t t-esc=""""""doc.resident_id.residence_id.name""/></h2>
                            <p>Plan de Soins / Projet Personnalisé de Soins (PPS)</p>
                        </div>
                        <div class=""""""col-6 text-end"">
                            <h3>PLAN DE SOINS - Version <t t-esc=""""""doc.version""/></h3>
                            <p><strong>Référence:</strong> <t t-esc=""""""doc.name""/></p>
                            <p><strong>Date début:</strong> <t t-esc=""""""doc.start_date""/></p>
                            <p><strong>Date fin:</strong> <t t-esc=""""""doc.end_date or &apos;En cours&apos;""/></p>
                        </div>
                    </div>
                    <hr/>
                </div>

                <div class=""""""page-content"">
                    <h4>RÉSIDENT</h4>
                    <table class=""""""table table-sm"">
                        <tr><td><strong>Nom:</strong></td><td><t t-esc=""""""doc.resident_id.name""/></td><td><strong>GIR:</strong></td><td><t t-esc=""""""dict(doc.resident_id._fields[&apos;gir_level&apos;].selection).get(doc.resident_id.gir_level)""/></td></tr>
                        <tr><td><strong>Date naissance:</strong></td><td><t t-esc=""""""doc.resident_id.partner_id.birthdate""/></td><td><strong>Chambre:</strong></td><td><t t-esc=""""""doc.resident_id.room_id.name""/></td></tr>
                        <tr><td><strong>Médecin traitant:</strong></td><td colspan=""""""3""><t t-esc=""""""doc.resident_id.tutor_id.name or &apos;Non désigné&apos;""/></td></tr>
                    </table>

                    <h4>VALIDATION PPS</h4>
                    <table class=""""""table table-sm"">
                        <tr>
                            <td><strong>Validé:</strong></td>
                            <td><span t-if=""""""doc.pps_validated"" class=""""""text-success"">✓ Oui</span><span t-if=""""""not doc.pps_validated"" class=""""""text-danger"">✗ Non</span></td>
                            <td><strong>Validé par:</strong></td>
                            <td><t t-esc=""""""doc.pps_validated_by.name""/></td>
                        </tr>
                        <tr>
                            <td><strong>Date validation:</strong></td>
                            <td><t t-esc=""""""doc.pps_validated_date""/></td>
                            <td><strong>Prochaine révision:</strong></td>
                            <td><t t-esc=""""""doc.resident_id.pps_next_review""/></td>
                        </tr>
                    </table>

                    <h4>OBJECTIFS DE SOINS</h4>
                    <div t-out=""""""doc.objectives or ""<p>Aucun objectif défini</p>"/>

                    <h4>INTERVENTIONS INFIRMIÈRES</h4>
                    <table class=""""""table table-bordered table-sm"">
                        <thead>
                            <tr><th>Type</th><th>Description</th><th>Fréquence</th><th>Durée</th><th>Assigné à</th><th>Période</th></tr>
                        </thead>
                        <tbody>
                            <t t-foreach=""""""doc.nursing_intervention_ids"" t-as=""""""interv"">
                                <tr>
                                    <td><t t-esc=""""""dict(interv._fields[&apos;intervention_type&apos;].selection).get(interv.intervention_type)""/></td>
                                    <td><t t-esc=""""""interv.description""/></td>
                                    <td><t t-esc=""""""dict(interv._fields[&apos;frequency&apos;].selection).get(interv.frequency)""/></td>
                                    <td><t t-esc=""""""interv.duration_minutes""/> min</td>
                                    <td><t t-esc=""""""interv.assigned_staff_id.name""/></td>
                                    <td><t t-esc=""""""interv.start_date""/> - <t t-esc=""""""interv.end_date or &apos;indéterminée&apos;""/></td>
                                </tr>
                            </t>
                        </tbody>
                    </table>

                    <h4>PRESCRIPTIONS MÉDICALES</h4>
                    <table class=""""""table table-bordered table-sm"">
                        <thead>
                            <tr><th>Médicament</th><th>Dosage</th><th>Fréquence</th><th>Voie</th><th>Prescripteur</th><th>Période</th><th>État</th></tr>
                        </thead>
                        <tbody>
                            <t t-foreach=""""""doc.prescription_ids"" t-as=""""""rx"">
                                <tr>
                                    <td><t t-esc=""""""rx.medication_id.name""/></td>
                                    <td><t t-esc=""""""rx.dosage""/></td>
                                    <td><t t-esc=""""""rx.frequency""/></td>
                                    <td><t t-esc=""""""dict(rx._fields[&apos;route&apos;].selection).get(rx.route)""/></td>
                                    <td><t t-esc=""""""rx.prescriber_id.name""/></td>
                                    <td><t t-esc=""""""rx.start_date""/> - <t t-esc=""""""rx.end_date or &apos;indéterminée&apos;""/></td>
                                    <td><span class=""""""badge"" t-att-class=""""""{&apos;bg-success&apos;: rx.state==&apos;active&apos;, &apos;bg-warning&apos;: rx.state==&apos;suspended&apos;, &apos;bg-danger&apos;: rx.state==&apos;stopped&apos;}""><t t-esc=""""""dict(rx._fields[&apos;state&apos;].selection).get(rx.state)""/></span></td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </div>

                <div class=""""""page-footer"">
                    <hr/>
                    <p class=""""""text-center text-muted small"">
                        Document généré le <t t-esc=""""""fields.Date.today()""/> - <t t-esc=""""""doc.resident_id.residence_id.name""/>
                    </p>
                </div>
            </div>
        </template>
    </data>
</odoo>