<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <template id=""""""report_room_condition_template"">
            <div class=""""""page"">
                <div class=""""""page-header"">
                    <div class=""""""row"">
                        <div class=""""""col-6"">
                            <h2><t t-esc=""""""doc.residence_id.name""/></h2>
                        </div>
                        <div class=""""""col-6 text-end"">
                            <h3>ÉTAT DES LIEUX</h3>
                            <p><strong>Chambre:</strong> <t t-esc=""""""doc.name""/></p>
                            <p><strong>Type:</strong> <t t-esc=""""""dict(doc._fields[&apos;room_type&apos;].selection).get(doc.room_type)""/></p>
                            <p><strong>Étage:</strong> <t t-esc=""""""doc.floor""/></p>
                            <p><strong>Date:</strong> <t t-esc=""""""fields.Date.today()""/></p>
                        </div>
                    </div>
                    <hr/>
                </div>

                <div class=""""""page-content"">
                    <h4>INFORMATIONS GÉNÉRALES</h4>
                    <table class=""""""table table-sm"">
                        <tr><td><strong>Bâtiment:</strong></td><td><t t-esc=""""""doc.building_id.name""/></td><td><strong>Surface:</strong></td><td><t t-esc=""""""doc.surface""/> m²</td></tr>
                        <tr><td><strong>Tarif hébergement:</strong></td><td><t t-esc=""""""doc.price_accommodation""/> <t t-esc=""""""doc.currency_id.symbol""/></td><td><strong>État actuel:</strong></td><td><t t-esc=""""""dict(doc._fields[&apos;state&apos;].selection).get(doc.state)""/></td></tr>
                        <tr><td><strong>Résident actuel:</strong></td><td colspan=""""""3""><t t-esc=""""""doc.current_resident_id.name or &apos;Aucun&apos;""/></td></tr>
                    </table>

                    <h4>DESCRIPTION DES LIEUX</h4>
                    <table class=""""""table table-bordered table-sm"">
                        <thead>
                            <tr><th>Élément</th><th>État Entrée</th><th>État Sortie</th><th>Observations / Réserves</th></tr>
                        </thead>
                        <tbody>
                            <tr><td>Murs / Peinture</td><td></td><td></td><td></td></tr>
                            <tr><td>Sol / Revêtement</td><td></td><td></td><td></td></tr>
                            <tr><td>Plafond</td><td></td><td></td><td></td></tr>
                            <tr><td>Fenêtres / Volets</td><td></td><td></td><td></td></tr>
                            <tr><td>Portes / Serrures</td><td></td><td></td><td></td></tr>
                            <tr><td>Éclairage</td><td></td><td></td><td></td></tr>
                            <tr><td>Prises électriques</td><td></td><td></td><td></td></tr>
                            <tr><td>Chauffage / Climatisation</td><td></td><td></td><td></td></tr>
                            <tr><td>Salle de bain (lavabo, douche, WC)</td><td></td><td></td><td></td></tr>
                            <tr><td>Mobilier (lit, table, chaise, armoire)</td><td></td><td></td><td></td></tr>
                            <tr><td>Équipements (sonnette, TV, téléphone)</td><td></td><td></td><td></td></tr>
                            <tr><td>Équipements PMR (si adapté)</td><td></td><td></td><td></td></tr>
                        </tbody>
                    </table>

                    <h4>PHOTOS</h4>
                    <p><em>Insérer les photos ici (prise en charge via pièces jointes)</em></p>

                    <h4>SIGNATURES</h4>
                    <table class=""""""table table-sm"">
                        <tr>
                            <td width=""""""50%"">
                                <p><strong>Résident / Famille</strong></p>
                                <p>________________________</p>
                                <p>Date: ________________</p>
                            </td>
                            <td width=""""""50%"">
                                <p><strong>Établissement (Gouvernante/Directeur)</strong></p>
                                <p>________________________</p>
                                <p>Date: ________________</p>
                            </td>
                        </tr>
                    </table>
                </div>

                <div class=""""""page-footer"">
                    <hr/>
                    <p class=""""""text-center text-muted small"">
                        <t t-esc=""""""doc.residence_id.name""/> - Document généré le <t t-esc=""""""fields.Date.today()""/>
                    </p>
                </div>
            </div>
        </template>
    </data>
</odoo>