<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <template id=""""""report_stay_contract_template"">
            <div class=""""""page"">
                <div class=""""""oe_structure""/>
                <div class=""""""page-header"">
                    <div class=""""""row"">
                        <div class=""""""col-6"">
                            <h2><t t-esc=""""""doc.resident_id.residence_id.name""/></h2>
                            <p><t t-esc=""""""doc.resident_id.residence_id.address_id.street""/>, <t t-esc=""""""doc.resident_id.residence_id.address_id.city""/></p>
                            <p>Tél: <t t-esc=""""""doc.resident_id.residence_id.phone""/> | Email: <t t-esc=""""""doc.resident_id.residence_id.email""/></p>
                        </div>
                        <div class=""""""col-6 text-end"">
                            <h3>CONTRAT DE SÉJOUR</h3>
                            <p><strong>Référence:</strong> <t t-esc=""""""doc.name""/></p>
                            <p><strong>Date:</strong> <t t-esc=""""""doc.signed_date or doc.start_date""/></p>
                        </div>
                    </div>
                    <hr/>
                </div>

                <div class=""""""page-content"">
                    <h4>1. PARTIES</h4>
                    <table class=""""""table table-sm"">
                        <tr><td><strong>Établissement:</strong></td><td><t t-esc=""""""doc.resident_id.residence_id.name""/></td></tr>
                        <tr><td><strong>Représenté par:</strong></td><td><t t-esc=""""""doc.resident_id.residence_id.director_id.name""/></td></tr>
                        <tr><td><strong>Résident:</strong></td><td><t t-esc=""""""doc.resident_id.name""/></td></tr>
                        <tr><td><strong>Date de naissance:</strong></td><td><t t-esc=""""""doc.resident_id.partner_id.birthdate""/></td></tr>
                        <tr><td><strong>Représentant légal/Famille:</strong></td><td><t t-esc=""""""doc.resident_id.tutor_id.name or &apos;Non désigné&apos;""/></td></tr>
                    </table>

                    <h4>2. CHAMBRE ET TARIFS</h4>
                    <table class=""""""table table-bordered table-sm"">
                        <thead>
                            <tr><th>Composante</th><th>Tarif Mensuel</th><th>Période</th></tr>
                        </thead>
                        <tbody>
                            <tr><td>Hébergement (Chambre <t t-esc=""""""doc.resident_id.room_id.name""/>)</td><td><t t-esc=""""""doc.price_accommodation""/> <t t-esc=""""""doc.currency_id.symbol""/></td><td>Du <t t-esc=""""""doc.start_date""/> au <t t-esc=""""""doc.end_date or &apos;indéterminée&apos;""/></td></tr>
                            <tr><td>Dépendance (GIR <t t-esc=""""""dict(doc.resident_id._fields[&apos;gir_level&apos;].selection).get(doc.resident_id.gir_level)""/>)</td><td><t t-esc=""""""doc.price_dependency""/> <t t-esc=""""""doc.currency_id.symbol""/></td><td>Révisable selon évaluation GIR</td></tr>
                            <tr><td>Forfait Soins</td><td><t t-esc=""""""doc.price_care""/> <t t-esc=""""""doc.currency_id.symbol""/></td><td>Mensuel</td></tr>
                            <tr><td>Services/Animations</td><td><t t-esc=""""""doc.price_services""/> <t t-esc=""""""doc.currency_id.symbol""/></td><td>Mensuel</td></tr>
                        </tbody>
                        <tfoot>
                            <tr><td colspan=""""""2""><strong>TOTAL MENSUEL</strong></td><td><strong><t t-esc=""""""doc.price_accommodation + doc.price_dependency + doc.price_care + doc.price_services""/> <t t-esc=""""""doc.currency_id.symbol""/></strong></td></tr>
                        </tfoot>
                    </table>

                    <h4>3. CONDITIONS GÉNÉRALES</h4>
                    <div t-out=""""""doc.notes or &apos;&apos;""/>

                    <h4>4. SIGNATURES</h4>
                    <table class=""""""table table-sm"">
                        <tr>
                            <td width=""""""33%"">
                                <p><strong>Le Résident / Famille</strong></p>
                                <p t-if=""""""doc.signed_by_resident"">Signé le <t t-esc=""""""doc.signed_date""/></p>
                                <p t-if=""""""not doc.signed_by_resident"">________________________</p>
                            </td>
                            <td width=""""""33%"">
                                <p><strong>Le Représentant Légal</strong></p>
                                <p t-if=""""""doc.signed_by_family"">Signé le <t t-esc=""""""doc.signed_date""/></p>
                                <p t-if=""""""not doc.signed_by_family"">________________________</p>
                            </td>
                            <td width=""""""33%"">
                                <p><strong>Le Directeur</strong></p>
                                <p t-if=""""""doc.signed_by_director"">Signé le <t t-esc=""""""doc.signed_date""/></p>
                                <p t-if=""""""not doc.signed_by_director"">________________________</p>
                            </td>
                        </tr>
                    </table>

                    <p class=""""""text-muted small"">Fait en trois exemplaires, dont un pour chaque partie.</p>
                </div>

                <div class=""""""page-footer"">
                    <hr/>
                    <p class=""""""text-center text-muted small"">
                        <t t-esc=""""""doc.resident_id.residence_id.name""/> - SIRET: <t t-esc=""""""doc.resident_id.residence_id.company_id.partner_id.vat""/> -
                        <t t-esc=""""""doc.resident_id.residence_id.address_id.street""/>, <t t-esc=""""""doc.resident_id.residence_id.address_id.zip""/> <t t-esc=""""""doc.resident_id.residence_id.address_id.city""/>
                    </p>
                </div>
            </div>
        </template>
    </data>
</odoo>