<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_quality_trend_dashboard" model="ir.actions.act_window">
        <field name="name">Quality Trend Dashboard Config</field>
        <field name="res_model">sf.quality_trend_dashboard</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
    <record id="view_sf_quality_trend_dashboard_form" model="ir.ui.view">
        <field name="name">sf.quality_trend_dashboard.form</field>
        <field name="model">sf.quality_trend_dashboard</field>
        <field name="arch" type="xml">
            <form string="Quality Trend Dashboard Config">
                <header>
                    <button name="action_submitted" type="object" string="Submitted"
                            class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="metric_name"/>
                            <field name="metric_type"/>
                            <field name="target_value"/>
                            <field name="alert_threshold"/>
                            <field name="trend_direction"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_quality_trend_dashboard_list" model="ir.ui.view">
        <field name="name">sf.quality_trend_dashboard.list</field>
        <field name="model">sf.quality_trend_dashboard</field>
        <field name="arch" type="xml">
            <list string="Quality Trend Dashboard Config" sample="1">
                <field name="metric_name"/>
                <field name="metric_type"/>
                <field name="target_value"/>
                <field name="alert_threshold"/>
                <field name="trend_direction"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state in ('submitted','approved')"/>
            </list>
        </field>
    </record>
    <record id="view_sf_quality_trend_dashboard_kanban" model="ir.ui.view">
        <field name="name">sf.quality_trend_dashboard.kanban</field>
        <field name="model">sf.quality_trend_dashboard</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_view" group_by="state">
                <field name="name"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <menuitem id="menu_sf_quality_trend_dashboard_root" name="Quality Trend Dashboard Config" sequence="3"
              web_icon="sf_quality_trend_dashboard,static/description/icon.png"/>
    <menuitem id="menu_sf_quality_trend_dashboard_main" name="Records"
              parent="menu_sf_quality_trend_dashboard_root" action="action_sf_quality_trend_dashboard" sequence="10"/>
</odoo>
