<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_quality_trend_dashboard" model="ir.module.category">
        <field name="name">Quality Trend Dashboard Config</field>
        <field name="sequence">268</field>
    </record>
    <record id="group_quality_trend_dashboard_user" model="res.groups">
        <field name="name">Quality Trend Dashboard Config User</field>
        <field name="category_id" ref="module_category_quality_trend_dashboard"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>

    </record>
    <record id="group_quality_trend_dashboard_manager" model="res.groups">
        <field name="name">Quality Trend Dashboard Config Manager</field>
        <field name="category_id" ref="module_category_quality_trend_dashboard"/>
        <field name="implied_ids" eval="[(4, ref('group_quality_trend_dashboard_user'))]"/>
    </record>
    <record id="rule_quality_trend_dashboard_sf_quality_trend_dashboard" model="ir.rule">
        <field name="name">Quality Trend Dashboard Config: multi-company</field>
        <field name="model_id" ref="model_sf_quality_trend_dashboard"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
