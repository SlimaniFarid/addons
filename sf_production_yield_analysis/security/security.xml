<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_production_yield_analysis" model="ir.module.category">
        <field name="name">Production Yield Analysis</field>
        <field name="sequence">476</field>
    </record>
    <record id="group_production_yield_analysis_user" model="res.groups">
        <field name="name">Production Yield Analysis User</field>
        <field name="category_id" ref="module_category_production_yield_analysis"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>

    </record>
    <record id="group_production_yield_analysis_manager" model="res.groups">
        <field name="name">Production Yield Analysis Manager</field>
        <field name="category_id" ref="module_category_production_yield_analysis"/>
        <field name="implied_ids" eval="[(4, ref('group_production_yield_analysis_user'))]"/>
    </record>
    <record id="rule_production_yield_analysis_sf_production_yield_analysis" model="ir.rule">
        <field name="name">Production Yield Analysis: multi-company</field>
        <field name="model_id" ref="model_sf_production_yield_analysis"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
