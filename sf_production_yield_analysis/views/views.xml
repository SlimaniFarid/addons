<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_production_yield_analysis" model="ir.actions.act_window">
        <field name="name">Production Yield Analysis</field>
        <field name="res_model">sf.production_yield_analysis</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
    <record id="view_sf_production_yield_analysis_form" model="ir.ui.view">
        <field name="name">sf.production_yield_analysis.form</field>
        <field name="model">sf.production_yield_analysis</field>
        <field name="arch" type="xml">
            <form string="Production Yield Analysis">
                <header>
                    <button name="action_submitted" type="object" string="Submitted"
                            class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="production_id"/>
                            <field name="planned_qty"/>
                            <field name="actual_qty"/>
                            <field name="scrap_qty"/>
                            <field name="yield_percent"/>
                            <field name="root_cause"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_production_yield_analysis_list" model="ir.ui.view">
        <field name="name">sf.production_yield_analysis.list</field>
        <field name="model">sf.production_yield_analysis</field>
        <field name="arch" type="xml">
            <list string="Production Yield Analysis" sample="1">
                <field name="production_id"/>
                <field name="planned_qty"/>
                <field name="actual_qty"/>
                <field name="scrap_qty"/>
                <field name="yield_percent"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state in ('submitted','approved')"/>
            </list>
        </field>
    </record>
    <record id="view_sf_production_yield_analysis_kanban" model="ir.ui.view">
        <field name="name">sf.production_yield_analysis.kanban</field>
        <field name="model">sf.production_yield_analysis</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_view" group_by="state">
                <field name="name"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <menuitem id="menu_sf_production_yield_analysis_root" name="Production Yield Analysis" sequence="25"
              web_icon="sf_production_yield_analysis,static/description/icon.png"/>
    <menuitem id="menu_sf_production_yield_analysis_main" name="Records"
              parent="menu_sf_production_yield_analysis_root" action="action_sf_production_yield_analysis" sequence="10"/>

    <record id="wave2_yield_pull" model="ir.actions.server">
        <field name="name">Pull quantities from MO</field>
        <field name="model_id" ref="model_sf_production_yield_analysis"/>
        <field name="binding_model_id" ref="model_sf_production_yield_analysis"/>
        <field name="state">code</field>
        <field name="code">records.action_pull_from_mo()</field>
    </record>
</odoo>
