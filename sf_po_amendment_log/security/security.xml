<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_po_amendment_log" model="ir.module.category">
        <field name="name">Purchase Order Amendment Log</field>
        <field name="sequence">40</field>
    </record>
    <record id="group_po_amendment_log_user" model="res.groups">
        <field name="name">Purchase Order Amendment Log User</field>
        <field name="category_id" ref="module_category_po_amendment_log"/>
        <field name="implied_ids" eval="[(4, ref('purchase.group_purchase_user'))]"/>

    </record>
    <record id="group_po_amendment_log_manager" model="res.groups">
        <field name="name">Purchase Order Amendment Log Manager</field>
        <field name="category_id" ref="module_category_po_amendment_log"/>
        <field name="implied_ids" eval="[(4, ref('group_po_amendment_log_user'))]"/>
    </record>
    <record id="rule_po_amendment_log_sf_po_amendment" model="ir.rule">
        <field name="name">PO Amendment: multi-company</field>
        <field name="model_id" ref="model_sf_po_amendment"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_po_amendment_log"/>
    </record>
</odoo>
