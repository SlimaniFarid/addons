<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_system_health_check" model="ir.actions.act_window">
        <field name="name">System Health Check</field>
        <field name="res_model">sf.system_health_check</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
    <record id="view_sf_system_health_check_form" model="ir.ui.view">
        <field name="name">sf.system_health_check.form</field>
        <field name="model">sf.system_health_check</field>
        <field name="arch" type="xml">
            <form string="System Health Check">
                <header>
                    <button name="action_submitted" type="object" string="Submitted"
                            class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="check_date"/>
                            <field name="db_size_gb"/>
                            <field name="disk_free_percent"/>
                            <field name="active_users"/>
                            <field name="avg_response_ms"/>
                            <field name="alerts"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_system_health_check_list" model="ir.ui.view">
        <field name="name">sf.system_health_check.list</field>
        <field name="model">sf.system_health_check</field>
        <field name="arch" type="xml">
            <list string="System Health Check" sample="1">
                <field name="check_date"/>
                <field name="db_size_gb"/>
                <field name="disk_free_percent"/>
                <field name="active_users"/>
                <field name="avg_response_ms"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state in ('submitted','approved')"/>
            </list>
        </field>
    </record>
    <record id="view_sf_system_health_check_kanban" model="ir.ui.view">
        <field name="name">sf.system_health_check.kanban</field>
        <field name="model">sf.system_health_check</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_view" group_by="state">
                <field name="name"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <menuitem id="menu_sf_system_health_check_root" name="System Health Check" sequence="18"
              web_icon="sf_system_health_check,static/description/icon.png"/>
    <menuitem id="menu_sf_system_health_check_main" name="Records"
              parent="menu_sf_system_health_check_root" action="action_sf_system_health_check" sequence="10"/>

    <record id="wave_final_sf_system_health_check" model="ir.actions.server">
        <field name="name">Refresh Business Data</field>
        <field name="model_id" ref="model_sf_system_health_check"/>
        <field name="binding_model_id" ref="model_sf_system_health_check"/>
        <field name="state">code</field>
        <field name="code">records.action_refresh_business()</field>
    </record>
</odoo>
