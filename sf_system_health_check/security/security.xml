<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_system_health_check" model="ir.module.category">
        <field name="name">System Health Check</field>
        <field name="sequence">383</field>
    </record>
    <record id="group_system_health_check_user" model="res.groups">
        <field name="name">System Health Check User</field>
        <field name="category_id" ref="module_category_system_health_check"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>

    </record>
    <record id="group_system_health_check_manager" model="res.groups">
        <field name="name">System Health Check Manager</field>
        <field name="category_id" ref="module_category_system_health_check"/>
        <field name="implied_ids" eval="[(4, ref('group_system_health_check_user'))]"/>
    </record>
    <record id="rule_system_health_check_sf_system_health_check" model="ir.rule">
        <field name="name">System Health Check: multi-company</field>
        <field name="model_id" ref="model_sf_system_health_check"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_system_health_check"/>
    </record>
</odoo>
