<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_inventory_count_variance" model="ir.module.category">
        <field name="name">Inventory Count Variance Analyzer</field>
        <field name="sequence">490</field>
    </record>
    <record id="group_inventory_count_variance_user" model="res.groups">
        <field name="name">Inventory Count Variance Analyzer User</field>
        <field name="category_id" ref="module_category_inventory_count_variance"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>

    </record>
    <record id="group_inventory_count_variance_manager" model="res.groups">
        <field name="name">Inventory Count Variance Analyzer Manager</field>
        <field name="category_id" ref="module_category_inventory_count_variance"/>
        <field name="implied_ids" eval="[(4, ref('group_inventory_count_variance_user'))]"/>
    </record>
    <record id="rule_inventory_count_variance_sf_inventory_count_variance" model="ir.rule">
        <field name="name">Inventory Count Variance Analyzer: multi-company</field>
        <field name="model_id" ref="model_sf_inventory_count_variance"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_inventory_count_variance"/>
    </record>
</odoo>
