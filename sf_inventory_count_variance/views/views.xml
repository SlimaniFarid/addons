<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_inventory_count_variance" model="ir.actions.act_window">
        <field name="name">Inventory Count Variance Analyzer</field>
        <field name="res_model">sf.inventory_count_variance</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
    <record id="view_sf_inventory_count_variance_form" model="ir.ui.view">
        <field name="name">sf.inventory_count_variance.form</field>
        <field name="model">sf.inventory_count_variance</field>
        <field name="arch" type="xml">
            <form string="Inventory Count Variance Analyzer">
                <header>
                    <button name="action_submitted" type="object" string="Submitted"
                            class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="product_id"/>
                            <field name="zone"/>
                            <field name="variance_qty"/>
                            <field name="variance_value"/>
                            <field name="reason_code"/>
                            <field name="corrective"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_inventory_count_variance_list" model="ir.ui.view">
        <field name="name">sf.inventory_count_variance.list</field>
        <field name="model">sf.inventory_count_variance</field>
        <field name="arch" type="xml">
            <list string="Inventory Count Variance Analyzer" sample="1">
                <field name="product_id"/>
                <field name="zone"/>
                <field name="variance_qty"/>
                <field name="variance_value"/>
                <field name="reason_code"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state in ('submitted','approved')"/>
            </list>
        </field>
    </record>
    <record id="view_sf_inventory_count_variance_kanban" model="ir.ui.view">
        <field name="name">sf.inventory_count_variance.kanban</field>
        <field name="model">sf.inventory_count_variance</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_view" group_by="state">
                <field name="name"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <menuitem id="menu_sf_inventory_count_variance_root" name="Inventory Count Variance Analyzer" sequence="11"
              web_icon="sf_inventory_count_variance,static/description/icon.png"/>
    <menuitem id="menu_sf_inventory_count_variance_main" name="Records"
              parent="menu_sf_inventory_count_variance_root" action="action_sf_inventory_count_variance" sequence="10"/>
</odoo>
