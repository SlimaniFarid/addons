<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="report_inputs_register" model="ir.actions.report">
        <field name="name">Inputs Register</field>
        <field name="model">sf.agri.farm</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">sf_agriculture.report_inputs_register_template</field>
        <field name="report_file">sf_agriculture.report_inputs_register_template</field>
        <field name="binding_model_id" ref="model_sf_agri_farm"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_inputs_register_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>Inputs Register</h2>
                        <table class="table table-sm">
                            <tr><td><strong>Farm</strong></td><td><t t-esc="o.name"/></td></tr>
                            <tr><td><strong>Address</strong></td><td><t t-esc="o.address or ''"/></td></tr>
                            <tr><td><strong>Manager</strong></td><td><t t-esc="o.manager_id.name or ''"/></td></tr>
                        </table>
                        <t t-foreach="o.campaign_ids" t-as="campaign">
                            <h3>Campaign <t t-esc="campaign.name"/> (<t t-esc="campaign.year"/>)</h3>
                            <t t-if="campaign.culture_ids.treatment_ids">
                                <table class="table table-sm">
                                    <thead>
                                        <tr>
                                            <th>Treatment</th>
                                            <th>Culture</th>
                                            <th>Type</th>
                                            <th>Product</th>
                                            <th>Active ingredient</th>
                                            <th>Quantity</th>
                                            <th>Treatment date</th>
                                            <th>Withdrawal (days)</th>
                                            <th>Status</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-foreach="campaign.culture_ids.treatment_ids" t-as="trt">
                                            <tr>
                                                <td><t t-esc="trt.name"/></td>
                                                <td><t t-esc="trt.culture_id.name"/></td>
                                                <td><t t-esc="trt.treatment_type"/></td>
                                                <td><t t-esc="trt.product or ''"/></td>
                                                <td><t t-esc="trt.active_ingredient or ''"/></td>
                                                <td><t t-esc="trt.quantity"/> <t t-esc="trt.unit"/></td>
                                                <td><t t-esc="trt.treatment_date or ''"/></td>
                                                <td><t t-esc="trt.withdrawal_days"/></td>
                                                <td><t t-esc="trt.state"/></td>
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>
                            </t>
                            <t t-else="">
                                <p>No treatments recorded for this campaign.</p>
                            </t>
                        </t>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <record id="report_campaign" model="ir.actions.report">
        <field name="name">Campaign Report</field>
        <field name="model">sf.agri.campaign</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">sf_agriculture.report_campaign_template</field>
        <field name="report_file">sf_agriculture.report_campaign_template</field>
        <field name="binding_model_id" ref="model_sf_agri_campaign"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_campaign_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>Campaign Report</h2>
                        <table class="table table-sm">
                            <tr><td><strong>Campaign</strong></td><td><t t-esc="o.name"/></td></tr>
                            <tr><td><strong>Farm</strong></td><td><t t-esc="o.farm_id.name"/></td></tr>
                            <tr><td><strong>Year</strong></td><td><t t-esc="o.year"/></td></tr>
                            <tr><td><strong>Period</strong></td><td><t t-esc="o.start_date or ''"/> - <t t-esc="o.end_date or ''"/></td></tr>
                            <tr><td><strong>Status</strong></td><td><t t-esc="o.state"/></td></tr>
                        </table>
                        <h3>Cultures</h3>
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Culture</th>
                                    <th>Plot</th>
                                    <th>Crop</th>
                                    <th>Variety</th>
                                    <th>Planted</th>
                                    <th>Harvest</th>
                                    <th>Expected yield</th>
                                    <th>Yield (t/ha)</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="o.culture_ids" t-as="c">
                                    <tr>
                                        <td><t t-esc="c.name"/></td>
                                        <td><t t-esc="c.plot_id.name"/></td>
                                        <td><t t-esc="c.crop"/></td>
                                        <td><t t-esc="c.variety or ''"/></td>
                                        <td><t t-esc="c.planted_date or ''"/></td>
                                        <td><t t-esc="c.harvest_date or ''"/></td>
                                        <td><t t-esc="c.expected_yield"/></td>
                                        <td><t t-esc="c.yield_t_ha"/></td>
                                        <td><t t-esc="c.state"/></td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                        <h3>Treatments</h3>
                        <t t-if="o.culture_ids.treatment_ids">
                            <table class="table table-sm">
                                <thead>
                                    <tr>
                                        <th>Treatment</th>
                                        <th>Culture</th>
                                        <th>Type</th>
                                        <th>Product</th>
                                        <th>Quantity</th>
                                        <th>Treatment date</th>
                                        <th>Withdrawal (days)</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="o.culture_ids.treatment_ids" t-as="trt">
                                        <tr>
                                            <td><t t-esc="trt.name"/></td>
                                            <td><t t-esc="trt.culture_id.name"/></td>
                                            <td><t t-esc="trt.treatment_type"/></td>
                                            <td><t t-esc="trt.product or ''"/></td>
                                            <td><t t-esc="trt.quantity"/> <t t-esc="trt.unit"/></td>
                                            <td><t t-esc="trt.treatment_date or ''"/></td>
                                            <td><t t-esc="trt.withdrawal_days"/></td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </t>
                        <t t-else="">
                            <p>No treatments recorded.</p>
                        </t>
                        <h3>Harvests</h3>
                        <t t-if="o.culture_ids.harvest_ids">
                            <table class="table table-sm">
                                <thead>
                                    <tr>
                                        <th>Harvest</th>
                                        <th>Culture</th>
                                        <th>Plot</th>
                                        <th>Date</th>
                                        <th>Quantity</th>
                                        <th>Yield (t/ha)</th>
                                        <th>Quality</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="o.culture_ids.harvest_ids" t-as="h">
                                        <tr>
                                            <td><t t-esc="h.name"/></td>
                                            <td><t t-esc="h.culture_id.name"/></td>
                                            <td><t t-esc="h.plot_id.name"/></td>
                                            <td><t t-esc="h.harvest_date or ''"/></td>
                                            <td><t t-esc="h.quantity"/> <t t-esc="h.unit"/></td>
                                            <td><t t-esc="h.yield_t_ha"/></td>
                                            <td><t t-esc="h.quality or ''"/></td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </t>
                        <t t-else="">
                            <p>No harvests recorded.</p>
                        </t>
                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>