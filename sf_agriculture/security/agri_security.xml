<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_agri" model="ir.module.category">
        <field name="name">Agriculture</field>
        <field name="sequence">90</field>
    </record>

    <record id="group_agri_user" model="res.groups">
        <field name="name">Agriculture User</field>
        <field name="category_id" ref="module_category_agri"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_agri_manager" model="res.groups">
        <field name="name">Agriculture Manager</field>
        <field name="category_id" ref="module_category_agri"/>
        <field name="implied_ids" eval="[(4, ref('group_agri_user'))]"/>
    </record>

    <record id="rule_agri_farm_user_company" model="ir.rule">
        <field name="name">Farm: user sees own company</field>
        <field name="model_id" ref="model_sf_agri_farm"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_agri_user'))]"/>
    </record>

    <record id="rule_agri_plot_user_company" model="ir.rule">
        <field name="name">Plot: user sees own company</field>
