<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_agri" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.agri</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Agriculture" string="Agriculture" name="agriculture">
                    <block title="Harvest Units">
                        <setting id="sf_agri_default_unit_setting"
                                 help="Default unit applied to new harvest records for this company.">
                            <field name="sf_agri_default_unit"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>