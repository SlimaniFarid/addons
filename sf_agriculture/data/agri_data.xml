<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_agri_farm" model="ir.sequence">
            <field name="name">Agricultural Farm</field>
            <field name="code">sf.agri.farm</field>
            <field name="prefix">FAR-</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>

        <record id="seq_agri_plot" model="ir.sequence">
            <field name="name">Agricultural Plot</field>
            <field name="code">sf.agri.plot</field>
            <field name="prefix">PLT-</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>

        <record id="seq_agri_campaign" model="ir.sequence">
            <field name="name">Agricultural Campaign</field>
            <field name="code">sf.agri.campaign</field>
            <field name="prefix">CMP-</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>

        <record id="seq_agri_culture" model="ir.sequence">
            <field name="name">Agricultural Culture</field>
            <field name="code">sf.agri.culture</field>
            <field name="prefix">CUL-</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>

        <record id="seq_agri_treatment" model="ir.sequence">
            <field name="name">Agricultural Treatment</field>
            <field name="code">sf.agri.treatment</field>
            <field name="prefix">TRT-</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>

        <record id="seq_agri_harvest" model="ir.sequence">
            <field name="name">Agricultural Harvest</field>
            <field name="code">sf.agri.harvest</field>
            <field name="prefix">HAR-</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>

        <record id="cron_agri_alerts" model="ir.cron">
            <field name="name">Agriculture: Withdrawal Period Alerts</field>
            <field name="model_id" ref="model_sf_agri_treatment"/>
            <field name="state">code</field>
            <field name="code">model._check_agri_alerts()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="active">True</field>
        </record>
    </data>
</odoo>