<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_loan" model="ir.module.category">
        <field name="name">Bank Loans</field>
        <field name="sequence">95</field>
    </record>

    <record id="group_loan_user" model="res.groups">
        <field name="name">Bank Loans User</field>
        <field name="category_id" ref="module_category_loan"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_loan_manager" model="res.groups">
        <field name="name">Bank Loans Manager</field>
        <field name="category_id" ref="module_category_loan"/>
        <field name="implied_ids" eval="[(4, ref('group_loan_user'))]"/>
    </record>

    <record id="rule_loan_bank_user_company" model="ir.rule">
        <field name="name">Loan Bank: user sees own company</field>
        <field name="model_id" ref="model_sf_loan_bank"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_loan_user'))]"/>
    </record>

    <record id="rule_loan_user_company" model="ir.rule">
        <field name="name">Loan: user sees own company</field>
        <field name="model_id" ref="model_sf_loan"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_loan_user'))]"/>
    </record>

    <record id="rule_loan_schedule_line_user_company" model="ir.rule">
        <field name="name">Schedule line: user sees own company</field>
        <field name="model_id" ref="model_sf_loan_schedule_line"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_loan_user'))]"/>
    </record>

    <record id="rule_loan_disbursement_user_company" model="ir.rule">
        <field name="name">Disbursement: user sees own company</field>
        <field name="model_id" ref="model_sf_loan_disbursement"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_loan_user'))]"/>
    </record>

    <record id="rule_loan_repayment_user_company" model="ir.rule">
        <field name="name">Repayment: user sees own company</field>
        <field name="model_id" ref="model_sf_loan_repayment"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_loan_user'))]"/>
    </record>

    <record id="rule_loan_covenant_user_company" model="ir.rule">
        <field name="name">Covenant: user sees own company</field>
        <field name="model_id" ref="model_sf_loan_covenant"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_loan_user'))]"/>
    </record>

    <record id="rule_loan_bank_manager_all" model="ir.rule">
        <field name="name">Loan Bank: manager sees all companies</field>
        <field name="model_id" ref="model_sf_loan_bank"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_loan_manager'))]"/>
    </record>

    <record id="rule_loan_manager_all" model="ir.rule">
        <field name="name">Loan: manager sees all companies</field>
        <field name="model_id" ref="model_sf_loan"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_loan_manager'))]"/>
    </record>

    <record id="rule_loan_schedule_line_manager_all" model="ir.rule">
        <field name="name">Schedule line: manager sees all companies</field>
        <field name="model_id" ref="model_sf_loan_schedule_line"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_loan_manager'))]"/>
    </record>

    <record id="rule_loan_disbursement_manager_all" model="ir.rule">
        <field name="name">Disbursement: manager sees all companies</field>
        <field name="model_id" ref="model_sf_loan_disbursement"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_loan_manager'))]"/>
    </record>

    <record id="rule_loan_repayment_manager_all" model="ir.rule">
        <field name="name">Repayment: manager sees all companies</field>
        <field name="model_id" ref="model_sf_loan_repayment"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_loan_manager'))]"/>
    </record>

    <record id="rule_loan_covenant_manager_all" model="ir.rule">
        <field name="name">Covenant: manager sees all companies</field>
        <field name="model_id" ref="model_sf_loan_covenant"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_loan_manager'))]"/>
    </record>
    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_loan"/>
    </record>
</odoo>