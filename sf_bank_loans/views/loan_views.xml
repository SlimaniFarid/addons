    <record id="action_loan_repayment" model="ir.actions.act_window">
        <field name="name">Early Repayments</field>
        <field name="res_model">sf.loan.repayment</field>
        <field name="view_mode">tree,kanban,form</field>
        <field name="search_view_id" ref="view_loan_repayment_search"/>
    </record>

    <!-- ============ COVENANT ============ -->
    <record id="view_loan_covenant_tree" model="ir.ui.view">
        <field name="name">sf.loan.covenant.tree</field>
        <field name="model">sf.loan.covenant</field>
        <field name="arch" type="xml">
            <tree string="Covenants">
                <field name="name"/>
                <field name="loan_id"/>
                <field name="covenant_name"/>
                <field name="metric"/>
                <field name="current_value"/>
                <field name="target_min"/>
                <field name="target_max"/>
                <field name="evaluation_date"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <record id="view_loan_covenant_form" model="ir.ui.view">
        <field name="name">sf.loan.covenant.form</field>
        <field name="model">sf.loan.covenant</field>
        <field name="arch" type="xml">
            <form string="Covenant">
                <header>
                    <button name="action_check_breach" type="object"
                            string="Check Breach" class="btn-secondary"/>
                    <button name="action_review" type="object"
                            string="Review" class="btn-primary"
                            invisible="state != 'breached'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="loan_id"/>
                            <field name="covenant_name"/>
                            <field name="metric"/>
                        </group>
                        <group>
                            <field name="formula"/>
                            <field name="evaluation_date"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="target_min"/>
                            <field name="target_max"/>
                        </group>
                        <group>
                            <field name="current_value"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
