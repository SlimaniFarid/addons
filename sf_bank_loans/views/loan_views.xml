                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_record_title">
                                <field name="covenant_name"/>
                            </div>
                            <div class="o_kanban_record_subtitle">
                                <field name="loan_id"/>
                            </div>
                            <div class="o_kanban_record_bottom">
                                <span>Value: <field name="current_value"/></span>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_loan_covenant" model="ir.actions.act_window">
        <field name="name">Covenants</field>
        <field name="res_model">sf.loan.covenant</field>
        <field name="view_mode">tree,kanban,form</field>
        <field name="search_view_id" ref="view_loan_covenant_search"/>
    </record>

    <!-- ============ DASHBOARD ============ -->
    <record id="view_loan_dashboard_graph" model="ir.ui.view">
        <field name="name">sf.loan.dashboard.graph</field>
        <field name="model">sf.loan</field>
        <field name="arch" type="xml">
            <graph string="Loans by Bank">
                <field name="bank_id"/>
                <field name="amount" type="measure" string="Amount"/>
            </graph>
        </field>
    </record>

    <record id="view_loan_dashboard_pivot" model="ir.ui.view">
        <field name="name">sf.loan.dashboard.pivot</field>
        <field name="model">sf.loan</field>
        <field name="arch" type="xml">
            <pivot string="Loans by State and Bank">
                <field name="state" type="row"/>
                <field name="bank_id" type="col"/>
                <field name="amount" type="measure" string="Amount"/>
            </pivot>
        </field>
    </record>

    <record id="action_loan_dashboard" model="ir.actions.act_window">
        <field name="name">Debt Dashboard</field>
        <field name="res_model">sf.loan</field>
        <field name="view_mode">graph,pivot</field>
        <field name="view_ids" eval="[(5, 0), (0, 0, {'view_mode': 'graph', 'view_id': ref('view_loan_dashboard_graph')}), (0, 0, {'view_mode': 'pivot', 'view_id': ref('view_loan_dashboard_pivot')})]"/>
    </record>

</odoo>