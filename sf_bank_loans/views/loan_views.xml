        <field name="model">sf.loan.repayment</field>
        <field name="arch" type="xml">
            <tree string="Early Repayments">
                <field name="name"/>
                <field name="loan_id"/>
                <field name="date"/>
                <field name="amount" sum="Total"/>
                <field name="reason"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <record id="view_loan_repayment_form" model="ir.ui.view">
        <field name="name">sf.loan.repayment.form</field>
        <field name="model">sf.loan.repayment</field>
        <field name="arch" type="xml">
            <form string="Early Repayment">
                <header>
                    <button name="action_confirm" type="object"
                            string="Confirm" class="btn-primary"
                            groups="sf_bank_loans.group_loan_manager"
                            invisible="state != 'draft'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="loan_id"/>
                            <field name="amount"/>
                        </group>
                        <group>
                            <field name="date"/>
                            <field name="reason"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
