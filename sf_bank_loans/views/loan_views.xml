    </record>

    <record id="action_loan_disbursement" model="ir.actions.act_window">
        <field name="name">Drawdowns</field>
        <field name="res_model">sf.loan.disbursement</field>
        <field name="view_mode">tree,kanban,form</field>
        <field name="search_view_id" ref="view_loan_disbursement_search"/>
