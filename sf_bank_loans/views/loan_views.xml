    <record id="view_loan_repayment_search" model="ir.ui.view">
        <field name="name">sf.loan.repayment.search</field>
        <field name="model">sf.loan.repayment</field>
        <field name="arch" type="xml">
            <search string="Early Repayments">
                <field name="name"/>
                <field name="loan_id"/>
                <field name="date"/>
                <field name="reason"/>
                <group expand="0" string="Group By">
                    <filter string="Loan" name="loan_group"
                            context="{'group_by': 'loan_id'}"/>
                    <filter string="Status" name="state_group"
                            context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_loan_repayment_kanban" model="ir.ui.view">
        <field name="name">sf.loan.repayment.kanban</field>
        <field name="model">sf.loan.repayment</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state">
                <field name="name"/>
                <field name="loan_id"/>
                <field name="amount"/>
                <field name="date"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_record_title">
                                <field name="name"/>
                            </div>
                            <div class="o_kanban_record_subtitle">
                                <field name="loan_id"/>
                            </div>
                            <div class="o_kanban_record_bottom">
                                <span>Amount: <field name="amount"/></span>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
