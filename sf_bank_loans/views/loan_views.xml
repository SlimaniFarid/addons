    <record id="view_loan_disbursement_search" model="ir.ui.view">
        <field name="name">sf.loan.disbursement.search</field>
        <field name="model">sf.loan.disbursement</field>
        <field name="arch" type="xml">
            <search string="Drawdowns">
                <field name="name"/>
                <field name="loan_id"/>
                <field name="date"/>
                <field name="reference"/>
                <group expand="0" string="Group By">
                    <filter string="Loan" name="loan_group"
