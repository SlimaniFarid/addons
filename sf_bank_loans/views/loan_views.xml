                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_loan_schedule" model="ir.actions.act_window">
        <field name="name">Amortization Schedule</field>
        <field name="res_model">sf.loan.schedule.line</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- ============ DISBURSEMENT ============ -->
