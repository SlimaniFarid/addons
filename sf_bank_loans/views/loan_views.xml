<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============ LOAN ============ -->
    <record id="view_loan_tree" model="ir.ui.view">
        <field name="name">sf.loan.tree</field>
        <field name="model">sf.loan</field>
        <field name="arch" type="xml">
            <tree string="Bank Loans">
                <field name="name"/>
                <field name="bank_id"/>
                <field name="loan_type"/>
                <field name="amount" sum="Total"/>
                <field name="rate"/>
                <field name="term_months"/>
                <field name="amortization"/>
                <field name="start_date"/>
                <field name="remaining_balance" sum="Total"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <record id="view_loan_form" model="ir.ui.view">
        <field name="name">sf.loan.form</field>
        <field name="model">sf.loan</field>
        <field name="arch" type="xml">
            <form string="Bank Loan">
                <header>
                    <button name="action_generate_schedule" type="object"
                            string="Generate Schedule" class="btn-primary"/>
                    <button name="action_offer" type="object"
                            string="Offer" class="btn-secondary"
                            invisible="state != 'draft'"/>
                    <button name="action_disburse" type="object"
                            string="Disburse" class="btn-success"
                            invisible="state not in ('draft', 'offered')"/>
                    <button name="action_close" type="object"
                            string="Close Loan" class="btn-danger"
                            groups="sf_bank_loans.group_loan_manager"
                            invisible="state not in ('disbursing', 'active')"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="bank_id"/>
                            <field name="loan_type"/>
                            <field name="amount"/>
                        </group>
                        <group>
                            <field name="rate"/>
                            <field name="term_months"/>
                            <field name="amortization"/>
                            <field name="start_date"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="disbursed_amount"/>
                            <field name="paid_amount"/>
                            <field name="repayment_total"/>
                            <field name="remaining_balance"/>
                        </group>
                    </group>
                    <field name="notes"/>
                    <notebook>
                        <page string="Amortization Schedule">
                            <field name="schedule_line_ids">
                                <tree string="Schedule">
                                    <field name="line_number"/>
                                    <field name="due_date"/>
                                    <field name="principal"/>
                                    <field name="interest"/>
                                    <field name="total"/>
                                    <field name="paid"/>
                                    <field name="paid_date"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Drawdowns">
                            <field name="disbursement_ids">
                                <tree string="Drawdowns">
                                    <field name="name"/>
                                    <field name="date"/>
                                    <field name="amount"/>
                                    <field name="reference"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Early Repayments">
                            <field name="repayment_ids">
                                <tree string="Early Repayments">
                                    <field name="name"/>
                                    <field name="date"/>
                                    <field name="amount"/>
                                    <field name="reason"/>
                                    <field name="state"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Covenants">
                            <field name="covenant_ids">
                                <tree string="Covenants">
                                    <field name="name"/>
                                    <field name="covenant_name"/>
                                    <field name="metric"/>
                                    <field name="current_value"/>
                                    <field name="target_min"/>
                                    <field name="target_max"/>
                                    <field name="state"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_loan_search" model="ir.ui.view">
        <field name="name">sf.loan.search</field>
        <field name="model">sf.loan</field>
        <field name="arch" type="xml">
            <search string="Bank Loans">
                <field name="name"/>
                <field name="bank_id"/>
                <field name="loan_type"/>
                <filter string="Draft" name="draft"
                        domain="[('state', '=', 'draft')]"/>
                <filter string="Disbursing" name="disbursing"
                        domain="[('state', '=', 'disbursing')]"/>
                <filter string="Active" name="active"
                        domain="[('state', '=', 'active')]"/>
                <filter string="Closed" name="closed"
                        domain="[('state', '=', 'closed')]"/>
                <group expand="0" string="Group By">
                    <filter string="Status" name="state_group"
                            context="{'group_by': 'state'}"/>
                    <filter string="Bank" name="bank_group"
                            context="{'group_by': 'bank_id'}"/>
                    <filter string="Loan type" name="type_group"
                            context="{'group_by': 'loan_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_loan_kanban" model="ir.ui.view">
        <field name="name">sf.loan.kanban</field>
        <field name="model">sf.loan</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state">
                <field name="name"/>
                <field name="bank_id"/>
                <field name="amount"/>
                <field name="remaining_balance"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_record_title">
                                <field name="name"/>
                            </div>
                            <div class="o_kanban_record_subtitle">
                                <field name="bank_id"/>
                            </div>
                            <div class="o_kanban_record_bottom">
                                <span>Amount: <field name="amount"/></span>
                            </div>
                            <div class="o_kanban_record_bottom">
                                <span>Remaining: <field name="remaining_balance"/></span>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_loan" model="ir.actions.act_window">
        <field name="name">Loans</field>
        <field name="res_model">sf.loan</field>
        <field name="view_mode">tree,kanban,form</field>
        <field name="search_view_id" ref="view_loan_search"/>
    </record>

    <!-- ============ LOAN BANK ============ -->
    <record id="view_loan_bank_tree" model="ir.ui.view">
        <field name="name">sf.loan.bank.tree</field>
        <field name="model">sf.loan.bank</field>
