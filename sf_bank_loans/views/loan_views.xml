        <field name="name">sf.loan.schedule.line.tree</field>
        <field name="model">sf.loan.schedule.line</field>
        <field name="arch" type="xml">
            <tree string="Amortization Schedule">
                <field name="loan_id"/>
                <field name="line_number"/>
                <field name="due_date"/>
                <field name="principal" sum="Total"/>
                <field name="interest" sum="Total"/>
                <field name="total" sum="Total"/>
                <field name="paid"/>
                <field name="paid_date"/>
            </tree>
        </field>
    </record>

    <record id="view_loan_schedule_form" model="ir.ui.view">
        <field name="name">sf.loan.schedule.line.form</field>
        <field name="model">sf.loan.schedule.line</field>
        <field name="arch" type="xml">
            <form string="Schedule Line">
                <sheet>
                    <group>
                        <group>
                            <field name="loan_id"/>
                            <field name="line_number"/>
                            <field name="due_date"/>
                        </group>
                        <group>
                            <field name="principal"/>
                            <field name="interest"/>
                            <field name="total"/>
                            <field name="paid"/>
                            <field name="paid_date"/>
