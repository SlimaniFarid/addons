        <field name="name">sf.loan.disbursement.tree</field>
        <field name="model">sf.loan.disbursement</field>
        <field name="arch" type="xml">
            <tree string="Drawdowns">
                <field name="name"/>
                <field name="loan_id"/>
                <field name="date"/>
