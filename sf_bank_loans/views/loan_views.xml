    <record id="view_loan_covenant_search" model="ir.ui.view">
        <field name="name">sf.loan.covenant.search</field>
        <field name="model">sf.loan.covenant</field>
        <field name="arch" type="xml">
            <search string="Covenants">
                <field name="name"/>
                <field name="loan_id"/>
                <field name="covenant_name"/>
                <field name="metric"/>
                <filter string="Breached" name="breached"
                        domain="[('state', '=', 'breached')]"/>
                <filter string="Active" name="active"
                        domain="[('state', '=', 'active')]"/>
                <group expand="0" string="Group By">
                    <filter string="Loan" name="loan_group"
                            context="{'group_by': 'loan_id'}"/>
                    <filter string="Status" name="state_group"
                            context="{'group_by': 'state'}"/>
                    <filter string="Metric" name="metric_group"
                            context="{'group_by': 'metric'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_loan_covenant_kanban" model="ir.ui.view">
        <field name="name">sf.loan.covenant.kanban</field>
        <field name="model">sf.loan.covenant</field>
        <field name="arch" type="xml">
