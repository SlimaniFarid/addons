    <record id="view_loan_disbursement_form" model="ir.ui.view">
        <field name="name">sf.loan.disbursement.form</field>
        <field name="model">sf.loan.disbursement</field>
        <field name="arch" type="xml">
            <form string="Drawdown">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="loan_id"/>
                            <field name="amount"/>
                        </group>
                        <group>
                            <field name="date"/>
                            <field name="reference"/>
