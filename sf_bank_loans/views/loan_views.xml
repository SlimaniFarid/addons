        <field name="arch" type="xml">
            <form string="Loan Bank">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="partner_id"/>
                        </group>
                        <group>
                            <field name="contact"/>
                            <field name="phone"/>
                            <field name="active"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_loan_bank_search" model="ir.ui.view">
        <field name="name">sf.loan.bank.search</field>
        <field name="model">sf.loan.bank</field>
        <field name="arch" type="xml">
            <search string="Loan Banks">
                <field name="name"/>
