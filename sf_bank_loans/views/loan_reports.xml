<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="report_loan_amortization" model="ir.actions.report">
        <field name="name">Amortization Schedule</field>
        <field name="model">sf.loan</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">sf_bank_loans.report_amortization_template</field>
        <field name="report_file">sf_bank_loans.report_amortization_template</field>
        <field name="binding_model_id" ref="model_sf_loan"/>
        <field name="binding_type">report</field>
    </record>

    <record id="report_loan_debt_position" model="ir.actions.report">
        <field name="name">Debt Position</field>
        <field name="model">sf.loan.bank</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">sf_bank_loans.report_debt_position_template</field>
        <field name="report_file">sf_bank_loans.report_debt_position_template</field>
        <field name="binding_model_id" ref="model_sf_loan_bank"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_amortization_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>Amortization Schedule</h2>
                        <table class="table table-sm">
                            <tr><td><strong>Loan</strong></td><td><t t-esc="o.name"/></td></tr>
                            <tr><td><strong>Bank</strong></td><td><t t-esc="o.bank_id.display_name"/></td></tr>
                            <tr><td><strong>Loan type</strong></td><td><t t-esc="o.loan_type"/></td></tr>
                            <tr><td><strong>Amount</strong></td><td><t t-esc="o.amount"/></td></tr>
                            <tr><td><strong>Rate (%)</strong></td><td><t t-esc="o.rate"/></td></tr>
                            <tr><td><strong>Term (months)</strong></td><td><t t-esc="o.term_months"/></td></tr>
                            <tr><td><strong>Start date</strong></td><td><t t-esc="o.start_date or ''"/></td></tr>
                            <tr><td><strong>Remaining balance</strong></td><td><t t-esc="o.remaining_balance"/></td></tr>
                        </table>
                        <h4>Installments</h4>
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Line</th>
                                    <th>Due date</th>
                                    <th>Principal</th>
                                    <th>Interest</th>
                                    <th>Total</th>
                                    <th>Paid</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="o.schedule_line_ids" t-as="line">
                                    <tr>
                                        <td><t t-esc="line.line_number"/></td>
                                        <td><t t-esc="line.due_date or ''"/></td>
                                        <td><t t-esc="line.principal"/></td>
                                        <td><t t-esc="line.interest"/></td>
                                        <td><t t-esc="line.total"/></td>
                                        <td><t t-esc="line.paid"/></td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                        <table class="table table-sm">
                            <tr><td><strong>Total principal</strong></td><td><t t-esc="sum(o.schedule_line_ids.mapped('principal'))"/></td></tr>
                            <tr><td><strong>Total interest</strong></td><td><t t-esc="sum(o.schedule_line_ids.mapped('interest'))"/></td></tr>
                            <tr><td><strong>Total</strong></td><td><t t-esc="sum(o.schedule_line_ids.mapped('total'))"/></td></tr>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <template id="report_debt_position_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>Debt Position</h2>
                        <table class="table table-sm">
                            <tr><td><strong>Bank</strong></td><td><t t-esc="o.name"/></td></tr>
                            <tr><td><strong>Partner</strong></td><td><t t-esc="o.partner_id.display_name or ''"/></td></tr>
                            <tr><td><strong>Contact</strong></td><td><t t-esc="o.contact or ''"/></td></tr>
                            <tr><td><strong>Phone</strong></td><td><t t-esc="o.phone or ''"/></td></tr>
                        </table>
                        <h4>Loans</h4>
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Loan</th>
                                    <th>Type</th>
                                    <th>Amount</th>
                                    <th>Remaining balance</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="o.env['sf.loan'].search([('bank_id', '=', o.id)])" t-as="loan">
                                    <tr>
                                        <td><t t-esc="loan.name"/></td>
                                        <td><t t-esc="loan.loan_type"/></td>
                                        <td><t t-esc="loan.amount"/></td>
                                        <td><t t-esc="loan.remaining_balance"/></td>
                                        <td><t t-esc="loan.state"/></td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>