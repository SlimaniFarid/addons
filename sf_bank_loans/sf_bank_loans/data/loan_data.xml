<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_loan_bank" model="ir.sequence">
            <field name="name">Loan Bank</field>
            <field name="code">sf.loan.bank</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>

        <record id="seq_loan" model="ir.sequence">
            <field name="name">Bank Loan</field>
            <field name="code">sf.loan</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>

        <record id="seq_loan_disbursement" model="ir.sequence">
            <field name="name">Loan Disbursement</field>
            <field name="code">sf.loan.disbursement</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>

        <record id="seq_loan_repayment" model="ir.sequence">
            <field name="name">Loan Repayment</field>
            <field name="code">sf.loan.repayment</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>

        <record id="seq_loan_covenant" model="ir.sequence">
            <field name="name">Loan Covenant</field>
            <field name="code">sf.loan.covenant</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>

        <record id="cron_loan_alerts" model="ir.cron">
            <field name="name">Bank Loans: Alerts</field>
            <field name="model_id" ref="model_sf_loan"/>
            <field name="state">code</field>
            <field name="code">model._check_loan_alerts()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="active">True</field>
        </record>
    </data>
</odoo>