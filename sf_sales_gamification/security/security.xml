<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_sales_gamification" model="ir.module.category">
        <field name="name">Sales Gamification Rules</field>
        <field name="sequence">180</field>
    </record>
    <record id="group_sales_gamification_user" model="res.groups">
        <field name="name">Sales Gamification Rules User</field>
        <field name="category_id" ref="module_category_sales_gamification"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>

    </record>
    <record id="group_sales_gamification_manager" model="res.groups">
        <field name="name">Sales Gamification Rules Manager</field>
        <field name="category_id" ref="module_category_sales_gamification"/>
        <field name="implied_ids" eval="[(4, ref('group_sales_gamification_user'))]"/>
    </record>
    <record id="rule_sales_gamification_sf_sales_gamification" model="ir.rule">
        <field name="name">Sales Gamification Rules: multi-company</field>
        <field name="model_id" ref="model_sf_sales_gamification"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_sales_gamification"/>
    </record>
</odoo>
