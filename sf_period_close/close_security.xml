<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_sf_close" model="ir.module.category">
        <field name="name">Financial Close</field>
        <field name="sequence">92</field>
    </record>
    <record id="group_sf_close_user" model="res.groups">
        <field name="name">Financial Close User</field>
        <field name="category_id" ref="module_category_sf_close"/>
        <field name="implied_ids" eval="[(4, ref('account.group_account_invoice'))]"/>
    </record>
    <record id="group_sf_close_manager" model="res.groups">
        <field name="name">Financial Close Manager</field>
        <field name="category_id" ref="module_category_sf_close"/>
        <field name="implied_ids" eval="[(4, ref('group_sf_close_user'))]"/>
    </record>
    <record id="rule_sf_close_period_company" model="ir.rule">
        <field name="name">Close Period: multi-company</field>
        <field name="model_id" ref="model_sf_close_period"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_sf_close_task_company" model="ir.rule">
        <field name="name">Close Task: multi-company</field>
        <field name="model_id" ref="model_sf_close_task"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
