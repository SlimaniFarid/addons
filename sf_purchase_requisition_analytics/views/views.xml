<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_purchase_requisition_analytics" model="ir.actions.act_window">
        <field name="name">Requisition Analytics</field>
        <field name="res_model">sf.purchase_requisition_analytics</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
    <record id="view_sf_purchase_requisition_analytics_form" model="ir.ui.view">
        <field name="name">sf.purchase_requisition_analytics.form</field>
        <field name="model">sf.purchase_requisition_analytics</field>
        <field name="arch" type="xml">
            <form string="Requisition Analytics">
                <header>
                    <button name="action_submitted" type="object" string="Submitted"
                            class="btn-primary"/>
                    <button name="action_approved" type="object" string="Approved"
                            class="btn-primary"/>
                    <button name="action_done" type="object" string="Done"
                            class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,approved,done,cancelled"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="period"/>
                            <field name="total_requisitions"/>
                            <field name="approved_count"/>
                            <field name="rejected_count"/>
                            <field name="avg_approval_days"/>
                            <field name="top_requester"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_purchase_requisition_analytics_list" model="ir.ui.view">
        <field name="name">sf.purchase_requisition_analytics.list</field>
        <field name="model">sf.purchase_requisition_analytics</field>
        <field name="arch" type="xml">
            <list string="Requisition Analytics" sample="1">
                <field name="period"/>
                <field name="total_requisitions"/>
                <field name="approved_count"/>
                <field name="rejected_count"/>
                <field name="avg_approval_days"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state in ('submitted','approved')"/>
            </list>
        </field>
    </record>
    <record id="view_sf_purchase_requisition_analytics_kanban" model="ir.ui.view">
        <field name="name">sf.purchase_requisition_analytics.kanban</field>
        <field name="model">sf.purchase_requisition_analytics</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_view" group_by="state">
                <field name="name"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <menuitem id="menu_sf_purchase_requisition_analytics_root" name="Requisition Analytics" sequence="12"
              web_icon="sf_purchase_requisition_analytics,static/description/icon.png"/>
    <menuitem id="menu_sf_purchase_requisition_analytics_main" name="Records"
              parent="menu_sf_purchase_requisition_analytics_root" action="action_sf_purchase_requisition_analytics" sequence="10"/>

    <record id="wave_final_sf_purchase_requisition_analytics" model="ir.actions.server">
        <field name="name">Refresh Business Data</field>
        <field name="model_id" ref="model_sf_purchase_requisition_analytics"/>
        <field name="binding_model_id" ref="model_sf_purchase_requisition_analytics"/>
        <field name="state">code</field>
        <field name="code">records.action_refresh_business()</field>
    </record>
</odoo>
