<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_purchase_requisition_analytics" model="ir.module.category">
        <field name="name">Requisition Analytics</field>
        <field name="sequence">689</field>
    </record>
    <record id="group_purchase_requisition_analytics_user" model="res.groups">
        <field name="name">Requisition Analytics User</field>
        <field name="category_id" ref="module_category_purchase_requisition_analytics"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>

    </record>
    <record id="group_purchase_requisition_analytics_manager" model="res.groups">
        <field name="name">Requisition Analytics Manager</field>
        <field name="category_id" ref="module_category_purchase_requisition_analytics"/>
        <field name="implied_ids" eval="[(4, ref('group_purchase_requisition_analytics_user'))]"/>
    </record>
    <record id="rule_purchase_requisition_analytics_sf_purchase_requisition_analytics" model="ir.rule">
        <field name="name">Requisition Analytics: multi-company</field>
        <field name="model_id" ref="model_sf_purchase_requisition_analytics"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_purchase_requisition_analytics"/>
    </record>
</odoo>
