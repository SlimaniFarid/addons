<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_customer_care_workload" model="ir.module.category">
        <field name="name">Care Workload Balancer</field>
        <field name="sequence">468</field>
    </record>
    <record id="group_customer_care_workload_user" model="res.groups">
        <field name="name">Care Workload Balancer User</field>
        <field name="category_id" ref="module_category_customer_care_workload"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>

    </record>
    <record id="group_customer_care_workload_manager" model="res.groups">
        <field name="name">Care Workload Balancer Manager</field>
        <field name="category_id" ref="module_category_customer_care_workload"/>
        <field name="implied_ids" eval="[(4, ref('group_customer_care_workload_user'))]"/>
    </record>
    <record id="rule_customer_care_workload_sf_customer_care_workload" model="ir.rule">
        <field name="name">Care Workload Balancer: multi-company</field>
        <field name="model_id" ref="model_sf_customer_care_workload"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_customer_care_workload"/>
    </record>
</odoo>
