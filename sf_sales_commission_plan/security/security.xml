<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_sales_commission_plan" model="ir.module.category">
        <field name="name">Commission Plan Builder</field>
        <field name="sequence">700</field>
    </record>
    <record id="group_sales_commission_plan_user" model="res.groups">
        <field name="name">Commission Plan Builder User</field>
        <field name="category_id" ref="module_category_sales_commission_plan"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>

    </record>
    <record id="group_sales_commission_plan_manager" model="res.groups">
        <field name="name">Commission Plan Builder Manager</field>
        <field name="category_id" ref="module_category_sales_commission_plan"/>
        <field name="implied_ids" eval="[(4, ref('group_sales_commission_plan_user'))]"/>
    </record>
    <record id="rule_sales_commission_plan_sf_sales_commission_plan" model="ir.rule">
        <field name="name">Commission Plan Builder: multi-company</field>
        <field name="model_id" ref="model_sf_sales_commission_plan"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
