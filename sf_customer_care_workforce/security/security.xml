<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_customer_care_workforce" model="ir.module.category">
        <field name="name">Care Workforce Planner</field>
        <field name="sequence">363</field>
    </record>
    <record id="group_customer_care_workforce_user" model="res.groups">
        <field name="name">Care Workforce Planner User</field>
        <field name="category_id" ref="module_category_customer_care_workforce"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>

    </record>
    <record id="group_customer_care_workforce_manager" model="res.groups">
        <field name="name">Care Workforce Planner Manager</field>
        <field name="category_id" ref="module_category_customer_care_workforce"/>
        <field name="implied_ids" eval="[(4, ref('group_customer_care_workforce_user'))]"/>
    </record>
    <record id="rule_customer_care_workforce_sf_customer_care_workforce" model="ir.rule">
        <field name="name">Care Workforce Planner: multi-company</field>
        <field name="model_id" ref="model_sf_customer_care_workforce"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
