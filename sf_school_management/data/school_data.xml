<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_school_year" model="ir.sequence">
            <field name="name">School Year</field>
            <field name="code">sf.school.year</field>
            <field name="prefix">SCY-</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>

        <record id="seq_school_group" model="ir.sequence">
            <field name="name">School Group</field>
            <field name="code">sf.school.group</field>
            <field name="prefix">GRP-</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>

        <record id="seq_school_teacher" model="ir.sequence">
            <field name="name">School Teacher</field>
            <field name="code">sf.school.teacher</field>
            <field name="prefix">TEA-</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>

        <record id="seq_school_student" model="ir.sequence">
            <field name="name">School Student</field>
            <field name="code">sf.school.student</field>
            <field name="prefix">STU-</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>

        <record id="seq_school_course" model="ir.sequence">
            <field name="name">School Course</field>
            <field name="code">sf.school.course</field>
            <field name="prefix">COU-</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>

        <record id="seq_school_enrollment" model="ir.sequence">
            <field name="name">School Enrollment</field>
            <field name="code">sf.school.enrollment</field>
            <field name="prefix">ENR-</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>

        <record id="seq_school_grade" model="ir.sequence">
            <field name="name">School Grade</field>
            <field name="code">sf.school.grade</field>
            <field name="prefix">GRA-</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>

        <record id="seq_school_absence" model="ir.sequence">
            <field name="name">School Absence</field>
            <field name="code">sf.school.absence</field>
            <field name="prefix">ABS-</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>

        <record id="seq_school_tuition" model="ir.sequence">
            <field name="name">School Tuition</field>
            <field name="code">sf.school.tuition</field>
            <field name="prefix">TUI-</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>

        <record id="cron_school_alert" model="ir.cron">
            <field name="name">School Management: Overdue Tuition Alerts</field>
            <field name="model_id" ref="model_sf_school_tuition"/>
            <field name="state">code</field>
            <field name="code">model._check_school_alerts()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="active">True</field>
        </record>
    </data>
</odoo>