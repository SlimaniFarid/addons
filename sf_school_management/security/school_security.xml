<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_school" model="ir.module.category">
        <field name="name">School Management</field>
        <field name="sequence">90</field>
    </record>

    <record id="group_school_user" model="res.groups">
        <field name="name">School Management User</field>
        <field name="category_id" ref="module_category_school"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_school_manager" model="res.groups">
        <field name="name">School Management Manager</field>
        <field name="category_id" ref="module_category_school"/>
        <field name="implied_ids" eval="[(4, ref('group_school_user'))]"/>
    </record>

    <record id="rule_school_year_user_company" model="ir.rule">
        <field name="name">Year: user sees own company</field>
        <field name="model_id" ref="model_sf_school_year"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_school_user'))]"/>
    </record>

    <record id="rule_school_group_user_company" model="ir.rule">
