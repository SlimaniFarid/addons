<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============ SCHOOL YEAR ============ -->
    <record id="view_school_year_tree" model="ir.ui.view">
        <field name="name">sf.school.year.tree</field>
        <field name="model">sf.school.year</field>
        <field name="arch" type="xml">
            <tree string="School Years">
                <field name="name"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="state"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </tree>
        </field>
    </record>

    <record id="view_school_year_form" model="ir.ui.view">
        <field name="name">sf.school.year.form</field>
        <field name="model">sf.school.year</field>
        <field name="arch" type="xml">
            <form string="School Year">
                <header>
                    <button name="action_close_year" type="object"
                            string="Close Year" class="btn-secondary"
                            invisible="state != 'active'"/>
                    <button name="action_reopen_year" type="object"
                            string="Reopen Year" class="btn-secondary"
                            invisible="state != 'closed'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="date_from"/>
                            <field name="date_to"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_school_year_search" model="ir.ui.view">
        <field name="name">sf.school.year.search</field>
        <field name="model">sf.school.year</field>
        <field name="arch" type="xml">
            <search string="School Years">
                <field name="name"/>
                <filter string="Active" name="active_filter"
                        domain="[('state', '=', 'active')]"/>
                <filter string="Closed" name="closed_filter"
                        domain="[('state', '=', 'closed')]"/>
                <group>
                    <filter string="Status" name="state_group"
                            context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_school_year_kanban" model="ir.ui.view">
        <field name="name">sf.school.year.kanban</field>
        <field name="model">sf.school.year</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state">
                <field name="name"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_record_title">
                                <field name="name"/>
                            </div>
                            <div class="o_kanban_record_subtitle">
                                <field name="date_from"/>
                                <field name="date_to"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_school_year" model="ir.actions.act_window">
        <field name="name">Academic Years</field>
        <field name="res_model">sf.school.year</field>
        <field name="view_mode">tree,kanban,form</field>
        <field name="search_view_id" ref="view_school_year_search"/>
    </record>

