                            <field name="reason"/>
                            <field name="justified"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <field name="note"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_school_absence_search" model="ir.ui.view">
        <field name="name">sf.school.absence.search</field>
        <field name="model">sf.school.absence</field>
        <field name="arch" type="xml">
            <search string="Absences">
                <field name="student_id"/>
                <field name="course_id"/>
                <filter string="Justified" name="justified_filter"
                        domain="[('justified', '=', True)]"/>
                <filter string="Unjustified" name="unjustified_filter"
                        domain="[('justified', '=', False)]"/>
                <group>
                    <filter string="Status" name="state_group"
                            context="{'group_by': 'state'}"/>
                    <filter string="Reason" name="reason_group"
                            context="{'group_by': 'reason'}"/>
                    <filter string="Course" name="course_group"
                            context="{'group_by': 'course_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_school_absence_kanban" model="ir.ui.view">
        <field name="name">sf.school.absence.kanban</field>
        <field name="model">sf.school.absence</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state">
                <field name="name"/>
                <field name="student_id"/>
                <field name="course_id"/>
                <field name="date"/>
                <field name="reason"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_record_title">
                                <field name="student_id"/>
                                <field name="course_id"/>
                            </div>
                            <div class="o_kanban_record_subtitle">
                                <field name="date"/>
                            </div>
                            <div class="o_kanban_record_bottom">
                                <field name="reason"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_school_absence" model="ir.actions.act_window">
        <field name="name">Absences</field>
        <field name="res_model">sf.school.absence</field>
        <field name="view_mode">tree,kanban,form</field>
        <field name="search_view_id" ref="view_school_absence_search"/>
    </record>

    <!-- ============ SCHOOL TUITION ============ -->
    <record id="view_school_tuition_tree" model="ir.ui.view">
        <field name="name">sf.school.tuition.tree</field>
        <field name="model">sf.school.tuition</field>
        <field name="arch" type="xml">
            <tree string="Tuition Fees">
                <field name="name"/>
                <field name="student_id"/>
                <field name="year_id"/>
                <field name="amount"/>
                <field name="paid_amount"/>
                <field name="amount_due"/>
                <field name="due_date"/>
                <field name="state"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </tree>
        </field>
    </record>

    <record id="view_school_tuition_form" model="ir.ui.view">
        <field name="name">sf.school.tuition.form</field>
        <field name="model">sf.school.tuition</field>
        <field name="arch" type="xml">
            <form string="Tuition Fee">
                <header>
                    <button name="action_receive_payment" type="object"
                            string="Receive Payment" class="btn-primary"
                            invisible="state == 'paid'"/>
                    <button name="action_mark_paid" type="object"
                            string="Mark Paid" class="btn-success"
                            groups="sf_school_management.group_school_manager"
                            invisible="state == 'paid'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="student_id"/>
                            <field name="year_id"/>
                        </group>
                        <group>
                            <field name="amount"/>
                            <field name="paid_amount"/>
                            <field name="amount_due" readonly="1"/>
                            <field name="due_date"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_school_tuition_search" model="ir.ui.view">
        <field name="name">sf.school.tuition.search</field>
        <field name="model">sf.school.tuition</field>
        <field name="arch" type="xml">
            <search string="Tuition Fees">
                <field name="student_id"/>
                <field name="year_id"/>
                <filter string="Overdue" name="overdue_filter"
                        domain="[('state', '=', 'overdue')]"/>
                <filter string="Partial" name="partial_filter"
                        domain="[('state', '=', 'partial')]"/>
                <filter string="Paid" name="paid_filter"
                        domain="[('state', '=', 'paid')]"/>
                <group>
                    <filter string="Status" name="state_group"
                            context="{'group_by': 'state'}"/>
                    <filter string="Student" name="student_group"
                            context="{'group_by': 'student_id'}"/>
                    <filter string="Year" name="year_group"
                            context="{'group_by': 'year_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_school_tuition_kanban" model="ir.ui.view">
        <field name="name">sf.school.tuition.kanban</field>
        <field name="model">sf.school.tuition</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state">
                <field name="name"/>
                <field name="student_id"/>
                <field name="amount"/>
                <field name="paid_amount"/>
                <field name="amount_due"/>
                <field name="due_date"/>
                <field name="state"/>
                <field name="year_id"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_record_title">
                                <field name="student_id"/>
                            </div>
                            <div class="o_kanban_record_subtitle">
                                <field name="year_id"/>
                                <field name="due_date"/>
                            </div>
                            <div class="o_kanban_record_bottom">
                                Due: <field name="amount_due"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_school_tuition" model="ir.actions.act_window">
        <field name="name">Tuition Fees</field>
        <field name="res_model">sf.school.tuition</field>
        <field name="view_mode">tree,kanban,form</field>
        <field name="search_view_id" ref="view_school_tuition_search"/>
    </record>

    <!-- ============ PAYMENT WIZARD ============ -->
    <record id="view_school_payment_wizard_form" model="ir.ui.view">
        <field name="name">sf.school.payment.wizard.form</field>
        <field name="model">sf.school.payment.wizard</field>
        <field name="arch" type="xml">
            <form string="Record Payment">
                <group>
                    <field name="tuition_id" readonly="1"/>
                    <field name="amount"/>
                </group>
                <footer>
                    <button name="action_record_payment" type="object"
                            string="Record Payment" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- ============ DASHBOARD ============ -->
    <record id="view_school_dashboard_graph" model="ir.ui.view">
        <field name="name">sf.school.student.dashboard.graph</field>
        <field name="model">sf.school.student</field>
        <field name="arch" type="xml">
            <graph string="Students by Status">
                <field name="state"/>
                <field name="id" type="measure" string="Students"/>
            </graph>
        </field>
    </record>

    <record id="view_school_dashboard_pivot" model="ir.ui.view">
        <field name="name">sf.school.student.dashboard.pivot</field>
        <field name="model">sf.school.student</field>
        <field name="arch" type="xml">
            <pivot string="Students by Group and Status">
                <field name="group_id" type="row"/>
                <field name="state" type="col"/>
                <field name="id" type="measure" string="Students"/>
            </pivot>
        </field>
    </record>

    <record id="action_school_dashboard" model="ir.actions.act_window">
        <field name="name">School Dashboard</field>
        <field name="res_model">sf.school.student</field>
        <field name="view_mode">graph,pivot</field>
        <field name="view_ids" eval="[(5, 0), (0, 0, {'view_mode': 'graph', 'view_id': ref('view_school_dashboard_graph')}), (0, 0, {'view_mode': 'pivot', 'view_id': ref('view_school_dashboard_pivot')})]"/>
    </record>


    <record id="wave_final_sf_school_management" model="ir.actions.server">
        <field name="name">Refresh Business Data</field>
        <field name="model_id" ref="model_sf_school_absence"/>
        <field name="binding_model_id" ref="model_sf_school_absence"/>
        <field name="state">code</field>
        <field name="code">records.action_refresh_business()</field>
    </record>
</odoo>