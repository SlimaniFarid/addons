<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="report_school_report_card" model="ir.actions.report">
        <field name="name">Report Card</field>
        <field name="model">sf.school.student</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">sf_school_management.report_card_template</field>
        <field name="report_file">sf_school_management.report_card_template</field>
        <field name="binding_model_id" ref="model_sf_school_student"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_card_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>Report Card</h2>
                        <table class="table table-sm">
                            <tr><td><strong>Student</strong></td><td><t t-esc="o.name"/></td></tr>
                            <tr><td><strong>Group</strong></td><td><t t-esc="o.group_id.name if o.group_id else ''"/></td></tr>
                            <tr><td><strong>Email</strong></td><td><t t-esc="o.email or ''"/></td></tr>
                            <tr><td><strong>Status</strong></td><td><t t-esc="dict(o._fields['state'].selection).get(o.state)"/></td></tr>
                        </table>
                        <h4>Subjects &amp; Grades</h4>
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Course</th>
                                    <th>Subject</th>
                                    <th>Grades</th>
                                    <th>Coefficient</th>
                                    <th>Average</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="o.get_subject_averages()" t-as="row">
                                    <tr>
                                        <td><t t-esc="row['course']"/></td>
                                        <td><t t-esc="row['subject']"/></td>
                                        <td><t t-esc="row['grade_list']"/></td>
                                        <td><t t-esc="row['coef']"/></td>
                                        <td><t t-esc="row['average']"/></td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                        <p><strong>Weighted average: </strong><t t-esc="o.get_weighted_average()"/></p>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <record id="report_school_unpaid_fees" model="ir.actions.report">
        <field name="name">Unpaid Fees</field>
        <field name="model">sf.school.tuition</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">sf_school_management.report_unpaid_fees_template</field>
        <field name="report_file">sf_school_management.report_unpaid_fees_template</field>
        <field name="binding_model_id" ref="model_sf_school_tuition"/>
        <field name="binding_type">report</field>
        <field name="domain">[('state', '!=', 'paid')]</field>
    </record>

    <template id="report_unpaid_fees_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>Unpaid Tuition Fees</h2>
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Tuition</th>
                                    <th>Student</th>
                                    <th>Year</th>
                                    <th>Amount</th>
                                    <th>Paid</th>
                                    <th>Due</th>
                                    <th>Due date</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="docs" t-as="tuition">
                                    <tr>
                                        <td><t t-esc="tuition.name"/></td>
                                        <td><t t-esc="tuition.student_id.name"/></td>
                                        <td><t t-esc="tuition.year_id.name if tuition.year_id else ''"/></td>
                                        <td><t t-esc="tuition.amount"/></td>
                                        <td><t t-esc="tuition.paid_amount"/></td>
                                        <td><t t-esc="tuition.amount_due"/></td>
                                        <td><t t-esc="tuition.due_date or ''"/></td>
                                        <td><t t-esc="dict(tuition._fields['state'].selection).get(tuition.state)"/></td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>