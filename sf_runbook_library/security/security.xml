<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_runbook_library" model="ir.module.category">
        <field name="name">Runbook &amp; Procedure Library</field>
        <field name="sequence">61</field>
    </record>
    <record id="group_runbook_library_user" model="res.groups">
        <field name="name">Runbook &amp; Procedure Library User</field>
        <field name="category_id" ref="module_category_runbook_library"/>

    </record>
    <record id="group_runbook_library_manager" model="res.groups">
        <field name="name">Runbook &amp; Procedure Library Manager</field>
        <field name="category_id" ref="module_category_runbook_library"/>
        <field name="implied_ids" eval="[(4, ref('group_runbook_library_user'))]"/>
    </record>
    <record id="rule_runbook_library_sf_runbook" model="ir.rule">
        <field name="name">Runbook: multi-company</field>
        <field name="model_id" ref="model_sf_runbook"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
