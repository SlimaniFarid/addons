<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_runbook" model="ir.actions.act_window">
        <field name="name">Runbook &amp; Procedure Library</field>
        <field name="res_model">sf.runbook</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
    <record id="view_sf_runbook_form" model="ir.ui.view">
        <field name="name">sf.runbook.form</field>
        <field name="model">sf.runbook</field>
        <field name="arch" type="xml">
            <form string="Runbook &amp; Procedure Library">
                <header>
                    <button name="action_approved" type="object" string="Approved"
                            class="btn-primary"/>
                    <button name="action_review_due" type="object" string="Review Due"
                            class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,approved,review_due,archived"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="title"/>
                            <field name="system"/>
                        <field name="content"/>
                            <field name="version"/>
                            <field name="owner_id"/>
                            <field name="last_review"/>
                            <field name="next_review"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_runbook_list" model="ir.ui.view">
        <field name="name">sf.runbook.list</field>
        <field name="model">sf.runbook</field>
        <field name="arch" type="xml">
            <list string="Runbook &amp; Procedure Library" sample="1">
                <field name="title"/>
                <field name="system"/>
                <field name="content"/>
                <field name="version"/>
                <field name="owner_id"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state in ('submitted','approved')"/>
            </list>
        </field>
    </record>
    <record id="view_sf_runbook_kanban" model="ir.ui.view">
        <field name="name">sf.runbook.kanban</field>
        <field name="model">sf.runbook</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_view" group_by="state">
                <field name="name"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <menuitem id="menu_sf_runbook_root" name="Runbook &amp; Procedure Library" sequence="11"
              web_icon="sf_runbook_library,static/description/icon.png"/>
    <menuitem id="menu_sf_runbook_main" name="Records"
              parent="menu_sf_runbook_root" action="action_sf_runbook" sequence="10"/>
</odoo>
