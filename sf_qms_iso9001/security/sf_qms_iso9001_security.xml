<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_sf_qms_iso9001" model="ir.module.category">
        <field name="name">QMS Iso9001</field>
        <field name="description">QMS Iso9001 Management</field>
        <field name="sequence">10</field>
    </record>

    <record id="group_sf_qms_iso9001_user" model="res.groups">
        <field name="name">QMS Iso9001 / User</field>
        <field name="category_id" ref="module_category_sf_qms_iso9001"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_sf_qms_iso9001_manager" model="res.groups">
        <field name="name">QMS Iso9001 / Manager</field>
        <field name="category_id" ref="module_category_sf_qms_iso9001"/>
        <field name="implied_ids" eval="[(4, ref('sf_qms_iso9001.group_sf_qms_iso9001_user'))]"/>
    </record>

    <record id="rule_sf_qms_iso9001_company" model="ir.rule">
        <field name="name">QMS Iso9001: user sees own company</field>
        <field name="model_id" ref="model_sf_qms_iso9001"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('sf_qms_iso9001.group_sf_qms_iso9001_user'))]"/>
    </record>
    <record id="rule_sf_qms_iso9001_manager_all" model="ir.rule">
        <field name="name">QMS Iso9001: manager sees all companies</field>
        <field name="model_id" ref="model_sf_qms_iso9001"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('sf_qms_iso9001.group_sf_qms_iso9001_manager'))]"/>
    </record>
    <record id="group_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="module_category_sf_qms_iso9001"/>
    </record>
    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_sf_qms_iso9001"/>
    </record>
    <record id="group_system" model="res.groups">
        <field name="name">System</field>
        <field name="category_id" ref="module_category_sf_qms_iso9001"/>
    </record>
</odoo>