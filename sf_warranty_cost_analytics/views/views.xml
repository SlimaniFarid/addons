<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_warranty_cost" model="ir.actions.act_window">
        <field name="name">Warranty Cost Analytics</field>
        <field name="res_model">sf.warranty.cost</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
    <record id="view_sf_warranty_cost_form" model="ir.ui.view">
        <field name="name">sf.warranty.cost.form</field>
        <field name="model">sf.warranty.cost</field>
        <field name="arch" type="xml">
            <form string="Warranty Cost Analytics">
                <header>
                    <button name="action_analyzed" type="object" string="Analyzed"
                            class="btn-primary"/>
                    <button name="action_recovered" type="object" string="Recovered"
                            class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="open,analyzed,recovered,absorbed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="product_id"/>
                            <field name="supplier_id"/>
                            <field name="claim_date"/>
                            <field name="internal_cost"/>
                            <field name="recovered_from_supplier"/>
                            <field name="quality_signal"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_warranty_cost_list" model="ir.ui.view">
        <field name="name">sf.warranty.cost.list</field>
        <field name="model">sf.warranty.cost</field>
        <field name="arch" type="xml">
            <list string="Warranty Cost Analytics" sample="1">
                <field name="product_id"/>
                <field name="supplier_id"/>
                <field name="claim_date"/>
                <field name="internal_cost"/>
                <field name="recovered_from_supplier"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state in ('submitted','approved')"/>
            </list>
        </field>
    </record>
    <record id="view_sf_warranty_cost_kanban" model="ir.ui.view">
        <field name="name">sf.warranty.cost.kanban</field>
        <field name="model">sf.warranty.cost</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_view" group_by="state">
                <field name="name"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <menuitem id="menu_sf_warranty_cost_root" name="Warranty Cost Analytics" sequence="4"
              web_icon="sf_warranty_cost_analytics,static/description/icon.png"/>
    <menuitem id="menu_sf_warranty_cost_main" name="Records"
              parent="menu_sf_warranty_cost_root" action="action_sf_warranty_cost" sequence="10"/>

    <record id="wave_final_sf_warranty_cost_analytics" model="ir.actions.server">
        <field name="name">Refresh Business Data</field>
        <field name="model_id" ref="model_sf_warranty_cost"/>
        <field name="binding_model_id" ref="model_sf_warranty_cost"/>
        <field name="state">code</field>
        <field name="code">records.action_refresh_business()</field>
    </record>
</odoo>
