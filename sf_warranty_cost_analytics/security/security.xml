<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_warranty_cost_analytics" model="ir.module.category">
        <field name="name">Warranty Cost Analytics</field>
        <field name="sequence">13</field>
    </record>
    <record id="group_warranty_cost_analytics_user" model="res.groups">
        <field name="name">Warranty Cost Analytics User</field>
        <field name="category_id" ref="module_category_warranty_cost_analytics"/>

    </record>
    <record id="group_warranty_cost_analytics_manager" model="res.groups">
        <field name="name">Warranty Cost Analytics Manager</field>
        <field name="category_id" ref="module_category_warranty_cost_analytics"/>
        <field name="implied_ids" eval="[(4, ref('group_warranty_cost_analytics_user'))]"/>
    </record>
    <record id="rule_warranty_cost_analytics_sf_warranty_cost" model="ir.rule">
        <field name="name">Warranty Cost Record: multi-company</field>
        <field name="model_id" ref="model_sf_warranty_cost"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_warranty_cost_analytics"/>
    </record>
</odoo>
