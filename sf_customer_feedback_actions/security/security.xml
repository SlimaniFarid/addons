<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_customer_feedback_actions" model="ir.module.category">
        <field name="name">Customer Feedback Action Tracker</field>
        <field name="sequence">1</field>
    </record>
    <record id="group_customer_feedback_actions_user" model="res.groups">
        <field name="name">Customer Feedback Action Tracker User</field>
        <field name="category_id" ref="module_category_customer_feedback_actions"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>

    </record>
    <record id="group_customer_feedback_actions_manager" model="res.groups">
        <field name="name">Customer Feedback Action Tracker Manager</field>
        <field name="category_id" ref="module_category_customer_feedback_actions"/>
        <field name="implied_ids" eval="[(4, ref('group_customer_feedback_actions_user'))]"/>
    </record>
    <record id="rule_customer_feedback_actions_sf_feedback_action" model="ir.rule">
        <field name="name">Feedback Action: multi-company</field>
        <field name="model_id" ref="model_sf_feedback_action"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_customer_feedback_actions"/>
    </record>
</odoo>
