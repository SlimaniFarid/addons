<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_feedback_action" model="ir.actions.act_window">
        <field name="name">Customer Feedback Action Tracker</field>
        <field name="res_model">sf.feedback.action</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
    <record id="view_sf_feedback_action_form" model="ir.ui.view">
        <field name="name">sf.feedback.action.form</field>
        <field name="model">sf.feedback.action</field>
        <field name="arch" type="xml">
            <form string="Customer Feedback Action Tracker">
                <header>
                    <button name="action_in_progress" type="object" string="In Progress"
                            class="btn-primary"/>
                    <button name="action_done" type="object" string="Done"
                            class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="open,in_progress,done,customer_validated"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="feedback_summary"/>
                            <field name="source"/>
                            <field name="action"/>
                            <field name="owner_id"/>
                            <field name="due_date"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_feedback_action_list" model="ir.ui.view">
        <field name="name">sf.feedback.action.list</field>
        <field name="model">sf.feedback.action</field>
        <field name="arch" type="xml">
            <list string="Customer Feedback Action Tracker" sample="1">
                <field name="partner_id"/>
                <field name="feedback_summary"/>
                <field name="source"/>
                <field name="action"/>
                <field name="owner_id"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state in ('submitted','approved')"/>
            </list>
        </field>
    </record>
    <record id="view_sf_feedback_action_kanban" model="ir.ui.view">
        <field name="name">sf.feedback.action.kanban</field>
        <field name="model">sf.feedback.action</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_view" group_by="state">
                <field name="name"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <menuitem id="menu_sf_feedback_action_root" name="Customer Feedback Action Tracker" sequence="6"
              web_icon="sf_customer_feedback_actions,static/description/icon.png"/>
    <menuitem id="menu_sf_feedback_action_main" name="Records"
              parent="menu_sf_feedback_action_root" action="action_sf_feedback_action" sequence="10"/>
</odoo>
