<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_supplier_risk_dashboard" model="ir.module.category">
        <field name="name">Supplier Risk Dashboard Config</field>
        <field name="sequence">291</field>
    </record>
    <record id="group_supplier_risk_dashboard_user" model="res.groups">
        <field name="name">Supplier Risk Dashboard Config User</field>
        <field name="category_id" ref="module_category_supplier_risk_dashboard"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>

    </record>
    <record id="group_supplier_risk_dashboard_manager" model="res.groups">
        <field name="name">Supplier Risk Dashboard Config Manager</field>
        <field name="category_id" ref="module_category_supplier_risk_dashboard"/>
        <field name="implied_ids" eval="[(4, ref('group_supplier_risk_dashboard_user'))]"/>
    </record>
    <record id="rule_supplier_risk_dashboard_sf_supplier_risk_dashboard" model="ir.rule">
        <field name="name">Supplier Risk Dashboard Config: multi-company</field>
        <field name="model_id" ref="model_sf_supplier_risk_dashboard"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_supplier_risk_dashboard"/>
    </record>
</odoo>
