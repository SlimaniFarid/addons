<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_sf_coa" model="ir.module.category">
        <field name="name">Certificates of Analysis</field>
        <field name="sequence">74</field>
    </record>
    <record id="group_sf_coa_user" model="res.groups">
        <field name="name">CoA Technician</field>
        <field name="category_id" ref="module_category_sf_coa"/>
        <field name="implied_ids" eval="[(4, ref('quality.group_quality_user'))]"/>
    </record>
    <record id="group_sf_coa_manager" model="res.groups">
        <field name="name">CoA Approver</field>
        <field name="category_id" ref="module_category_sf_coa"/>
        <field name="implied_ids" eval="[(4, ref('group_sf_coa_user'))]"/>
    </record>
    <record id="rule_sf_coa_company" model="ir.rule">
        <field name="name">CoA: multi-company</field>
        <field name="model_id" ref="model_sf_coa"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
