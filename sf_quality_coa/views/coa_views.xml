<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_coa" model="ir.actions.act_window">
        <field name="name">Certificates of Analysis</field>
        <field name="res_model">sf.coa</field>
        <field name="view_mode">kanban,list,form,kanban</field>
    </record>
    <record id="view_sf_coa_form" model="ir.ui.view">
        <field name="name">sf.coa.form</field>
        <field name="model">sf.coa</field>
        <field name="arch" type="xml">
            <form string="Certificate of Analysis">
                <header>
                    <button name="action_mark_tested" type="object"
                            string="Testing Complete" invisible="state != 'draft'"/>
                    <button name="action_approve" type="object"
                            string="Approve" class="btn-primary"
                            invisible="state != 'tested'"/>
                    <button name="action_issue" type="object"
                            string="Issue to Customer" class="btn-success"
                            invisible="state != 'approved'"/>
                    <button name="action_reject" type="object" string="Reject"
                            invisible="state in ('issued','rejected')"/>
                    <field name="passed_all" widget="boolean" readonly="1"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,tested,approved,issued"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="picking_id" readonly="state != 'draft'"/>
                            <field name="partner_id" readonly="1"/>
                            <field name="product_id" readonly="state != 'draft'"/>
                            <field name="lot_id" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="production_date"/>
                            <field name="expiry_date"/>
                            <field name="tested_by_id" readonly="1"/>
                            <field name="approved_by_id" readonly="1"/>
                            <field name="approved_date" readonly="1"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <field name="line_ids" readonly="state not in ('draft','tested')">
                        <list decoration-danger="is_overdue" editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="parameter"/>
                            <field name="specification"/>
                            <field name="result_value"/>
                            <field name="unit"/>
                            <field name="test_method" optional="show"/>
                            <field name="verdict"/>
                        </list>
                    </field>
                    <group string="Notes">
                        <field name="notes"/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_coa_list" model="ir.ui.view">
        <field name="name">sf.coa.list</field>
        <field name="model">sf.coa</field>
        <field name="arch" type="xml">
            <list string="Certificates of Analysis" sample="1">
                <field name="name"/>
                <field name="picking_id"/>
                <field name="partner_id"/>
                <field name="product_id"/>
                <field name="lot_id" optional="show"/>
                <field name="passed_all" widget="boolean"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'issued'"/>
            </list>
        </field>
    </record>
    <menuitem id="menu_sf_coa_root" name="Certificates of Analysis" sequence="24"
              parent="quality.menu_quality_root"/>
    <menuitem id="menu_sf_coa_records" name="CoA Records"
              parent="menu_sf_coa_root" action="action_sf_coa" sequence="10"/>

    <record id="view_sf_quality_coa_boost_kanban" model="ir.ui.view">
        <field name="name">sf_quality_coa.boost.kanban</field>
        <field name="model">sf.coa</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" t-att-color="state">
                <field name="name"/>
                <field name="state"/>
                <field name="user_id"/>
                <field name="expiry_date"/>
                <field name="is_overdue" invisible="1"/>

                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_card oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title">
                                    <field name="name"/></strong>
                                <div class="o_kanban_record_subtitle">
                                    <field name="user_id" widget="many2one_avatar_user"/>
                                    <field name="expiry_date"/></div>
                            </div>
                            <div class="oe_kanban_bottom_right">
                                <field name="state" widget="badge"
                                       t-attf-options="{'classes_map': {'draft': 'info', 'done': 'success', 'cancelled': 'danger'}, 'domain': []}"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_sf_quality_coa_boost_search" model="ir.ui.view">
        <field name="name">sf_quality_coa.boost.search</field>
        <field name="model">sf.coa</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
<separator/>
                <filter string="My records" name="my_records" domain="[('user_id', '=', uid)]"/>
                <filter string="To Do" name="todo" domain="[('state', 'not in', ('done', 'cancelled', 'closed'))]"/>
                <group expand="0" string="Group By"><filter string="Status" name="gb_state" context="{'group_by': 'state'}"/></group>
            </search>
        </field>
    </record>
</odoo>
