<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_compliance_obligation" model="ir.actions.act_window">
        <field name="name">Compliance Obligation Register</field>
        <field name="res_model">sf.compliance_obligation</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
    <record id="view_sf_compliance_obligation_form" model="ir.ui.view">
        <field name="name">sf.compliance_obligation.form</field>
        <field name="model">sf.compliance_obligation</field>
        <field name="arch" type="xml">
            <form string="Compliance Obligation Register">
                <header>
                    <button name="action_submitted" type="object" string="Submitted"
                            class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="obligation"/>
                            <field name="regulation"/>
                            <field name="requirement"/>
                            <field name="evidence_ref"/>
                            <field name="deadline"/>
                            <field name="owner_id"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_compliance_obligation_list" model="ir.ui.view">
        <field name="name">sf.compliance_obligation.list</field>
        <field name="model">sf.compliance_obligation</field>
        <field name="arch" type="xml">
            <list string="Compliance Obligation Register" sample="1">
                <field name="obligation"/>
                <field name="regulation"/>
                <field name="requirement"/>
                <field name="evidence_ref"/>
                <field name="deadline"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state in ('submitted','approved')"/>
            </list>
        </field>
    </record>
    <record id="view_sf_compliance_obligation_kanban" model="ir.ui.view">
        <field name="name">sf.compliance_obligation.kanban</field>
        <field name="model">sf.compliance_obligation</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_view" group_by="state">
                <field name="name"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <menuitem id="menu_sf_compliance_obligation_root" name="Compliance Obligation Register" sequence="11"
              web_icon="sf_compliance_obligation,static/description/icon.png"/>
    <menuitem id="menu_sf_compliance_obligation_main" name="Records"
              parent="menu_sf_compliance_obligation_root" action="action_sf_compliance_obligation" sequence="10"/>
</odoo>
