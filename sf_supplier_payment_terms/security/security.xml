<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_supplier_payment_terms" model="ir.module.category">
        <field name="name">Supplier Payment Terms Analyzer</field>
        <field name="sequence">181</field>
    </record>
    <record id="group_supplier_payment_terms_user" model="res.groups">
        <field name="name">Supplier Payment Terms Analyzer User</field>
        <field name="category_id" ref="module_category_supplier_payment_terms"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>

    </record>
    <record id="group_supplier_payment_terms_manager" model="res.groups">
        <field name="name">Supplier Payment Terms Analyzer Manager</field>
        <field name="category_id" ref="module_category_supplier_payment_terms"/>
        <field name="implied_ids" eval="[(4, ref('group_supplier_payment_terms_user'))]"/>
    </record>
    <record id="rule_supplier_payment_terms_sf_supplier_payment_terms" model="ir.rule">
        <field name="name">Supplier Payment Terms Analyzer: multi-company</field>
        <field name="model_id" ref="model_sf_supplier_payment_terms"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_supplier_payment_terms"/>
    </record>
</odoo>
