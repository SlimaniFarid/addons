<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_decision" model="ir.actions.act_window">
        <field name="name">Decision Log with Context</field>
        <field name="res_model">sf.decision</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
    <record id="view_sf_decision_form" model="ir.ui.view">
        <field name="name">sf.decision.form</field>
        <field name="model">sf.decision</field>
        <field name="arch" type="xml">
            <form string="Decision Log with Context">
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="recorded,superseded"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="title"/>
                            <field name="date"/>
                        <field name="context"/>
                            <field name="rationale"/>
                            <field name="decision_maker_id"/>
                            <field name="review_date"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_decision_list" model="ir.ui.view">
        <field name="name">sf.decision.list</field>
        <field name="model">sf.decision</field>
        <field name="arch" type="xml">
            <list string="Decision Log with Context" sample="1">
                <field name="title"/>
                <field name="date"/>
                <field name="context"/>
                <field name="rationale"/>
                <field name="decision_maker_id"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state in ('submitted','approved')"/>
            </list>
        </field>
    </record>
    <record id="view_sf_decision_kanban" model="ir.ui.view">
        <field name="name">sf.decision.kanban</field>
        <field name="model">sf.decision</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_view" group_by="state">
                <field name="name"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <menuitem id="menu_sf_decision_root" name="Decision Log with Context" sequence="9"
              web_icon="sf_decision_log,static/description/icon.png"/>
    <menuitem id="menu_sf_decision_main" name="Records"
              parent="menu_sf_decision_root" action="action_sf_decision" sequence="10"/>
</odoo>
