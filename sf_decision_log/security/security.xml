<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_decision_log" model="ir.module.category">
        <field name="name">Decision Log with Context</field>
        <field name="sequence">53</field>
    </record>
    <record id="group_decision_log_user" model="res.groups">
        <field name="name">Decision Log with Context User</field>
        <field name="category_id" ref="module_category_decision_log"/>

    </record>
    <record id="group_decision_log_manager" model="res.groups">
        <field name="name">Decision Log with Context Manager</field>
        <field name="category_id" ref="module_category_decision_log"/>
        <field name="implied_ids" eval="[(4, ref('group_decision_log_user'))]"/>
    </record>
    <record id="rule_decision_log_sf_decision" model="ir.rule">
        <field name="name">Decision Record: multi-company</field>
        <field name="model_id" ref="model_sf_decision"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_decision_log"/>
    </record>
</odoo>
