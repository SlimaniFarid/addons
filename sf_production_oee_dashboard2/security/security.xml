<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_production_oee_dashboard2" model="ir.module.category">
        <field name="name">OEE Dashboard Config</field>
        <field name="sequence">667</field>
    </record>
    <record id="group_production_oee_dashboard2_user" model="res.groups">
        <field name="name">OEE Dashboard Config User</field>
        <field name="category_id" ref="module_category_production_oee_dashboard2"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>

    </record>
    <record id="group_production_oee_dashboard2_manager" model="res.groups">
        <field name="name">OEE Dashboard Config Manager</field>
        <field name="category_id" ref="module_category_production_oee_dashboard2"/>
        <field name="implied_ids" eval="[(4, ref('group_production_oee_dashboard2_user'))]"/>
    </record>
    <record id="rule_production_oee_dashboard2_sf_production_oee_dashboard2" model="ir.rule">
        <field name="name">OEE Dashboard Config: multi-company</field>
        <field name="model_id" ref="model_sf_production_oee_dashboard2"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_production_oee_dashboard2"/>
    </record>
</odoo>
