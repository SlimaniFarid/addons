<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_employee_1on1_tracker" model="ir.actions.act_window">
        <field name="name">Employee 1-on-1 Tracker</field>
        <field name="res_model">sf.employee_1on1_tracker</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
    <record id="view_sf_employee_1on1_tracker_form" model="ir.ui.view">
        <field name="name">sf.employee_1on1_tracker.form</field>
        <field name="model">sf.employee_1on1_tracker</field>
        <field name="arch" type="xml">
            <form string="Employee 1-on-1 Tracker">
                <header>
                    <button name="action_submitted" type="object" string="Submitted"
                            class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="employee_id"/>
                            <field name="manager_id"/>
                            <field name="meeting_date"/>
                            <field name="topics"/>
                            <field name="mood"/>
                            <field name="actions"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_employee_1on1_tracker_list" model="ir.ui.view">
        <field name="name">sf.employee_1on1_tracker.list</field>
        <field name="model">sf.employee_1on1_tracker</field>
        <field name="arch" type="xml">
            <list string="Employee 1-on-1 Tracker" sample="1">
                <field name="employee_id"/>
                <field name="manager_id"/>
                <field name="meeting_date"/>
                <field name="topics"/>
                <field name="mood"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state in ('submitted','approved')"/>
            </list>
        </field>
    </record>
    <record id="view_sf_employee_1on1_tracker_kanban" model="ir.ui.view">
        <field name="name">sf.employee_1on1_tracker.kanban</field>
        <field name="model">sf.employee_1on1_tracker</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_view" group_by="state">
                <field name="name"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <menuitem id="menu_sf_employee_1on1_tracker_root" name="Employee 1-on-1 Tracker" sequence="14"
              web_icon="sf_employee_1on1_tracker,static/description/icon.png"/>
    <menuitem id="menu_sf_employee_1on1_tracker_main" name="Records"
              parent="menu_sf_employee_1on1_tracker_root" action="action_sf_employee_1on1_tracker" sequence="10"/>

    <record id="wave2_onon_scan" model="ir.actions.server">
        <field name="name">Draft overdue 1:1s</field>
        <field name="model_id" ref="model_sf_employee_1on1_tracker"/>
        <field name="binding_model_id" ref="model_sf_employee_1on1_tracker"/>
        <field name="state">code</field>
        <field name="code">records.cron_scan_overdue()</field>
    </record>
</odoo>
