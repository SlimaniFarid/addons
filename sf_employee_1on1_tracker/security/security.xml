<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_employee_1on1_tracker" model="ir.module.category">
        <field name="name">Employee 1-on-1 Tracker</field>
        <field name="sequence">187</field>
    </record>
    <record id="group_employee_1on1_tracker_user" model="res.groups">
        <field name="name">Employee 1-on-1 Tracker User</field>
        <field name="category_id" ref="module_category_employee_1on1_tracker"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>

    </record>
    <record id="group_employee_1on1_tracker_manager" model="res.groups">
        <field name="name">Employee 1-on-1 Tracker Manager</field>
        <field name="category_id" ref="module_category_employee_1on1_tracker"/>
        <field name="implied_ids" eval="[(4, ref('group_employee_1on1_tracker_user'))]"/>
    </record>
    <record id="rule_employee_1on1_tracker_sf_employee_1on1_tracker" model="ir.rule">
        <field name="name">Employee 1-on-1 Tracker: multi-company</field>
        <field name="model_id" ref="model_sf_employee_1on1_tracker"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_employee_1on1_tracker"/>
    </record>
</odoo>
