<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_gift_register">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-set="company" t-value="o.company_id or res_company"/>
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>Gifts &amp; Hospitality Register</h2>
                        <table class="table table-sm">
                            <tr><th>Name</th><th>Employee</th><th>Direction</th><th>Date</th><th>Category</th><th>Value</th><th>Status</th></tr>
                            <tr t-foreach="docs" t-as="g">
                                <td><span t-field="g.name"/></td>
                                <td><span t-field="g.employee_id"/></td>
                                <td><span t-field="g.direction"/></td>
                                <td><span t-field="g.date"/></td>
                                <td><span t-field="g.category"/></td>
                                <td><span t-field="g.estimated_value"/></td>
                                <td><span t-field="g.state"/></td>
                            </tr>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>