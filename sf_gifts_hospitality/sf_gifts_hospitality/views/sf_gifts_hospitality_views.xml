<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sf_gift_hospitality_view_list" model="ir.ui.view">
        <field name="name">sf.gift.hospitality.list</field>
        <field name="model">sf.gift.hospitality</field>
        <field name="arch" type="xml">
            <list string="Gifts &amp; Hospitality">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="direction"/>
                <field name="date"/>
                <field name="category"/>
                <field name="counterparty_id"/>
                <field name="estimated_value"/>
                <field name="requires_approval"/>
                <field name="state" widget="badge"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="sf_gift_hospitality_view_form" model="ir.ui.view">
        <field name="name">sf.gift.hospitality.form</field>
        <field name="model">sf.gift.hospitality</field>
        <field name="arch" type="xml">
            <form string="Gift &amp; Hospitality Declaration">
                <header>
                    <button name="action_submit" string="Submit" type="object" class="btn-primary" invisible="[('state', '!=', 'draft')]"/>
                    <button name="action_approve" string="Approve" type="object" class="btn-primary" invisible="[('state', '!=', 'submitted')]"/>
                    <button name="action_reject" string="Reject" type="object" invisible="[('state', '!=', 'submitted')]"/>
                    <button name="action_resubmit" string="Resubmit" type="object" invisible="[('state', '!=', 'rejected')]"/>
                    <button name="action_archive" string="Archive" type="object" invisible="[('state', '!=', 'approved')]"/>
                    <field name="state" widget="statusbar" readonly="1"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="employee_id"/>
                            <field name="direction"/>
                            <field name="date"/>
                            <field name="category"/>
                            <field name="counterparty_id"/>
                        </group>
                        <group>
                            <field name="estimated_value"/>
                            <field name="requires_approval" readonly="1"/>
                            <field name="approved_by" readonly="1"/>
                            <field name="approved_date" readonly="1"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group string="Details">
                        <field name="description"/>
                        <field name="justification"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="sf_gift_hospitality_view_search" model="ir.ui.view">
        <field name="name">sf.gift.hospitality.search</field>
        <field name="model">sf.gift.hospitality</field>
        <field name="arch" type="xml">
            <search string="Gifts &amp; Hospitality">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="counterparty_id"/>
                <filter name="gift_submitted" string="Submitted" domain="[('state', '=', 'submitted')]"/>
                <filter name="gift_approved" string="Approved" domain="[('state', '=', 'approved')]"/>
                <filter name="gift_rejected" string="Rejected" domain="[('state', '=', 'rejected')]"/>
                <filter name="gift_requires_approval" string="Approval Required" domain="[('requires_approval', '=', True)]"/>
                <group>
                    <filter name="group_gift_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_gift_direction" string="Direction" context="{'group_by': 'direction'}"/>
                    <filter name="group_gift_category" string="Category" context="{'group_by': 'category'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_sf_gift_hospitality" model="ir.actions.act_window">
        <field name="name">Gifts &amp; Hospitality</field>
        <field name="res_model">sf.gift.hospitality</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="sf_gift_hospitality_view_search"/>
    </record>
</odoo>