<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_supplier_payment_optimization" model="ir.actions.act_window">
        <field name="name">Supplier Payment Optimization</field>
        <field name="res_model">sf.supplier_payment_optimization</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
    <record id="view_sf_supplier_payment_optimization_form" model="ir.ui.view">
        <field name="name">sf.supplier_payment_optimization.form</field>
        <field name="model">sf.supplier_payment_optimization</field>
        <field name="arch" type="xml">
            <form string="Supplier Payment Optimization">
                <header>
                    <button name="action_submitted" type="object" string="Submitted"
                            class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="vendor_id"/>
                            <field name="standard_terms_days"/>
                            <field name="early_discount_percent"/>
                            <field name="early_discount_days"/>
                            <field name="annual_benefit"/>
                            <field name="recommendation"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_supplier_payment_optimization_list" model="ir.ui.view">
        <field name="name">sf.supplier_payment_optimization.list</field>
        <field name="model">sf.supplier_payment_optimization</field>
        <field name="arch" type="xml">
            <list string="Supplier Payment Optimization" sample="1">
                <field name="vendor_id"/>
                <field name="standard_terms_days"/>
                <field name="early_discount_percent"/>
                <field name="early_discount_days"/>
                <field name="annual_benefit"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state in ('submitted','approved')"/>
            </list>
        </field>
    </record>
    <record id="view_sf_supplier_payment_optimization_kanban" model="ir.ui.view">
        <field name="name">sf.supplier_payment_optimization.kanban</field>
        <field name="model">sf.supplier_payment_optimization</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_view" group_by="state">
                <field name="name"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <menuitem id="menu_sf_supplier_payment_optimization_root" name="Supplier Payment Optimization" sequence="1"
              web_icon="sf_supplier_payment_optimization,static/description/icon.png"/>
    <menuitem id="menu_sf_supplier_payment_optimization_main" name="Records"
              parent="menu_sf_supplier_payment_optimization_root" action="action_sf_supplier_payment_optimization" sequence="10"/>
</odoo>
