<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_supplier_payment_optimization" model="ir.module.category">
        <field name="name">Supplier Payment Optimization</field>
        <field name="sequence">270</field>
    </record>
    <record id="group_supplier_payment_optimization_user" model="res.groups">
        <field name="name">Supplier Payment Optimization User</field>
        <field name="category_id" ref="module_category_supplier_payment_optimization"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>

    </record>
    <record id="group_supplier_payment_optimization_manager" model="res.groups">
        <field name="name">Supplier Payment Optimization Manager</field>
        <field name="category_id" ref="module_category_supplier_payment_optimization"/>
        <field name="implied_ids" eval="[(4, ref('group_supplier_payment_optimization_user'))]"/>
    </record>
    <record id="rule_supplier_payment_optimization_sf_supplier_payment_optimization" model="ir.rule">
        <field name="name">Supplier Payment Optimization: multi-company</field>
        <field name="model_id" ref="model_sf_supplier_payment_optimization"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_supplier_payment_optimization"/>
    </record>
</odoo>
