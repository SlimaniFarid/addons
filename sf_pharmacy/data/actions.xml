<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_sf_pharmacy_product" model="ir.sequence">
            <field name="name">sf.pharmacy.product</field>
            <field name="code">sf.pharmacy.product</field>
            <field name="prefix">PRE-</field>
            <field name="padding">5</field>
            <field name="number_increment">1</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_sf_pharmacy_batch" model="ir.sequence">
            <field name="name">sf.pharmacy.batch</field>
            <field name="code">sf.pharmacy.batch</field>
            <field name="prefix">BAT-</field>
            <field name="padding">5</field>
            <field name="number_increment">1</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_sf_pharmacy_prescription" model="ir.sequence">
            <field name="name">sf.pharmacy.prescription</field>
            <field name="code">sf.pharmacy.prescription</field>
            <field name="prefix">ORD-</field>
            <field name="padding">5</field>
            <field name="number_increment">1</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_sf_pharmacy_dispensation" model="ir.sequence">
            <field name="name">sf.pharmacy.dispensation</field>
            <field name="code">sf.pharmacy.dispensation</field>
            <field name="prefix">DEL-</field>
            <field name="padding">5</field>
            <field name="number_increment">1</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_sf_pharmacy_batch_movement" model="ir.sequence">
            <field name="name">sf.pharmacy.batch_movement</field>
            <field name="code">sf.pharmacy.batch_movement</field>
            <field name="prefix">MVT-</field>
            <field name="padding">5</field>
            <field name="number_increment">1</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="cron_sf_pharmacy_alerts" model="ir.cron">
            <field name="name">sf_pharmacy : expiry and stock-out alerts</field>
            <field name="model_id" ref="model_sf_pharmacy_batch"/>
            <field name="state">code</field>
            <field name="code">model._cron_stock_alerts()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="active">True</field>
            <field name="priority">5</field>
        </record>
    </data>
</odoo>