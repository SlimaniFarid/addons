<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_sf_pharmacy" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.sf.pharmacy</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="sf_pharmacy" string="sf_pharmacy" data-key="sf_pharmacy">
                    <block title="Alert thresholds" string="Alert thresholds">
                        <setting string="Expiry alert delay (days)" help="Number of days before expiry triggering a cron alert.">
                            <field name="sf_pharmacy_expiry_days"/>
                        </setting>
                        <setting string="Low stock threshold" help="Available quantity below which the batch is considered in an out-of-stock alert.">
                            <field name="sf_pharmacy_low_stock_threshold"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>