<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sf_pharmacy_product_action" model="ir.actions.act_window">
        <field name="name">Produits</field>
        <field name="res_model">sf.pharmacy.product</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_group_by_company': 1}</field>
    </record>

    <record id="sf_pharmacy_product_view_tree" model="ir.ui.view">
        <field name="name">sf.pharmacy.product.tree</field>
        <field name="model">sf.pharmacy.product</field>
        <field name="arch" type="xml">
            <tree string="Produits">
                <field name="name"/>
                <field name="generic_name"/>
                <field name="dosage"/>
                <field name="form"/>
                <field name="atc_code"/>
                <field name="safety_stock"/>
                <field name="price_unit" sum="Total"/>
                <field name="cost" sum="Total"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </tree>
        </field>
    </record>

    <record id="sf_pharmacy_product_view_form" model="ir.ui.view">
        <field name="name">sf.pharmacy.product.form</field>
        <field name="model">sf.pharmacy.product</field>
        <field name="arch" type="xml">
            <form string="Produit">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="generic_name"/>
                            <field name="dosage"/>
                            <field name="form"/>
                            <field name="atc_code"/>
                            <field name="responsible_id"/>
                        </group>
                        <group>
                            <field name="price_unit" currency_field="currency_id"/>
                            <field name="cost" currency_field="currency_id"/>
                            <field name="safety_stock"/>
                            <field name="active"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Lots">
                            <field name="batch_ids" readonly="1">
                                <tree string="Lots" create="false" edit="false">
                                    <field name="name"/>
                                    <field name="lot_ref"/>
                                    <field name="expiry_date"/>
                                    <field name="qty_received"/>
                                    <field name="qty_dispensed"/>
                                    <field name="qty_reserved"/>
                                    <field name="qty_available"/>
                                    <field name="status"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="sf_pharmacy_product_view_search" model="ir.ui.view">
        <field name="name">sf.pharmacy.product.search</field>
        <field name="model">sf.pharmacy.product</field>
        <field name="arch" type="xml">
            <search string="Produits">
                <field name="name"/>
                <field name="generic_name"/>
                <field name="atc_code"/>
                <filter string="Actifs" name="active" domain="[('active', '=', True)]"/>
                <group expand="0" string="Group By">
                    <filter string="Société" name="group_by_company" domain="[]" context="{'group_by': 'company_id'}"/>
                    <filter string="Forme" name="group_by_form" domain="[]" context="{'group_by': 'form'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="sf_pharmacy_batch_action" model="ir.actions.act_window">
        <field name="name">Lots</field>
        <field name="res_model">sf.pharmacy.batch</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="context">{'search_default_group_by_status': 1}</field>
    </record>

    <record id="sf_pharmacy_batch_view_kanban" model="ir.ui.view">
        <field name="name">sf.pharmacy.batch.kanban</field>
        <field name="model">sf.pharmacy.batch</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <field name="name"/>
                <field name="product_id"/>
                <field name="expiry_date"/>
                <field name="qty_available"/>
                <field name="status"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_record_title">
                                <strong><field name="name"/></strong>
                            </div>
                            <div class="o_kanban_record_subtitle">
                                <field name="product_id"/>
                            </div>
                            <div class="o_kanban_record_bottom">
                                <div class="text-muted">
                                    Péremption : <field name="expiry_date"/>
                                </div>
                                <div class="text-muted">
                                    Disponible : <field name="qty_available"/>
                                </div>
                                <span t-if="record.status.raw_value == 'available'" class="badge badge-success">Disponible</span>
                                <span t-if="record.status.raw_value == 'expired'" class="badge badge-danger">Périmé</span>
                                <span t-if="record.status.raw_value == 'recalled'" class="badge badge-warning">Rappelé</span>
                                <span t-if="record.status.raw_value == 'withdrawn'" class="badge badge-secondary">Retiré</span>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="sf_pharmacy_batch_view_tree" model="ir.ui.view">
        <field name="name">sf.pharmacy.batch.tree</field>
        <field name="model">sf.pharmacy.batch</field>
        <field name="arch" type="xml">
            <tree string="Lots">
                <field name="name"/>
                <field name="product_id"/>
                <field name="lot_ref"/>
                <field name="expiry_date"/>
                <field name="qty_received" sum="Total"/>
                <field name="qty_dispensed" sum="Total"/>
                <field name="qty_reserved" sum="Total"/>
                <field name="qty_withdrawn" sum="Total"/>
                <field name="qty_available" sum="Total"/>
                <field name="status" widget="badge" decoration-danger="status == 'expired'" decoration-warning="status == 'recalled'" decoration-info="status == 'withdrawn'"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </tree>
        </field>
    </record>

    <record id="sf_pharmacy_batch_view_form" model="ir.ui.view">
        <field name="name">sf.pharmacy.batch.form</field>
        <field name="model">sf.pharmacy.batch</field>
        <field name="arch" type="xml">
            <form string="Lot">
                <header>
                    <button name="action_withdraw" type="object" string="Retirer (péremption)" groups="sf_pharmacy.group_sf_pharmacy_manager" confirm="Retirer ce lot du stock disponible ?"/>
                    <button name="action_recall" type="object" string="Rappel de lot" groups="sf_pharmacy.group_sf_pharmacy_manager" confirm="Lancer un rappel pour ce lot ?"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="product_id"/>
                            <field name="lot_ref"/>
                            <field name="expiry_date"/>
                            <field name="status" widget="badge"/>
                        </group>
                        <group>
                            <field name="qty_received"/>
                            <field name="qty_dispensed" readonly="1"/>
                            <field name="qty_reserved"/>
                            <field name="qty_withdrawn" readonly="1"/>
                            <field name="qty_available" readonly="1"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Mouvements">
                            <field name="movement_ids" readonly="1">
                                <tree string="Mouvements" create="false" edit="false">
                                    <field name="name"/>
                                    <field name="move_date"/>
                                    <field name="movement_type"/>
                                    <field name="qty"/>
                                    <field name="unit_price"/>
                                    <field name="reference"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="sf_pharmacy_batch_view_search" model="ir.ui.view">
        <field name="name">sf.pharmacy.batch.search</field>
        <field name="model">sf.pharmacy.batch</field>
        <field name="arch" type="xml">
            <search string="Lots">
                <field name="name"/>
                <field name="product_id"/>
                <field name="lot_ref"/>
                <filter string="Disponibles" name="available" domain="[('status', '=', 'available')]"/>
                <filter string="Périmés" name="expired" domain="[('status', '=', 'expired')]"/>
                <filter string="Retirés" name="withdrawn" domain="[('status', '=', 'withdrawn')]"/>
                <filter string="Rappelés" name="recalled" domain="[('status', '=', 'recalled')]"/>
                <group expand="0" string="Group By">
                    <filter string="Statut" name="group_by_status" domain="[]" context="{'group_by': 'status'}"/>
                    <filter string="Produit" name="group_by_product" domain="[]" context="{'group_by': 'product_id'}"/>
                    <filter string="Société" name="group_by_company" domain="[]" context="{'group_by': 'company_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="sf_pharmacy_batch_view_graph" model="ir.ui.view">
        <field name="name">sf.pharmacy.batch.graph</field>
        <field name="model">sf.pharmacy.batch</field>
        <field name="arch" type="xml">
            <graph string="Quantités par statut">
                <field name="status"/>
                <field name="qty_available" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="sf_pharmacy_prescription_action" model="ir.actions.act_window">
        <field name="name">Ordonnances</field>
        <field name="res_model">sf.pharmacy.prescription</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record id="sf_pharmacy_prescription_view_tree" model="ir.ui.view">
        <field name="name">sf.pharmacy.prescription.tree</field>
        <field name="model">sf.pharmacy.prescription</field>
        <field name="arch" type="xml">
            <tree string="Ordonnances">
                <field name="name"/>
                <field name="patient_name"/>
                <field name="prescriber"/>
                <field name="prescription_date"/>
                <field name="state" widget="badge" decoration-success="state == 'done'" decoration-info="state == 'confirmed'" decoration-muted="state == 'cancelled'"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </tree>
        </field>
    </record>

    <record id="sf_pharmacy_prescription_view_form" model="ir.ui.view">
        <field name="name">sf.pharmacy.prescription.form</field>
        <field name="model">sf.pharmacy.prescription</field>
        <field name="arch" type="xml">
            <form string="Ordonnance">
                <header>
                    <button name="action_confirm" type="object" string="Confirmer" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_done" type="object" string="Terminer" class="oe_highlight" invisible="state != 'confirmed'"/>
                    <button name="action_cancel" type="object" string="Annuler" invisible="state not in ('draft', 'confirmed')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,done,cancelled"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="patient_name"/>
                            <field name="prescriber"/>
                            <field name="prescription_date"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Délivrances">
                            <field name="dispensation_ids" context="{'default_company_id': company_id}" readonly="[['state', 'in', ['confirmed', 'done', 'cancelled']]]">
                                <tree string="Délivrances">
                                    <field name="name"/>
                                    <field name="product_id"/>
                                    <field name="batch_id" domain="[('product_id', '=', product_id), ('company_id', '=', company_id)]"/>
                                    <field name="qty"/>
                                    <field name="posology"/>
                                    <field name="state"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="sf_pharmacy_prescription_view_search" model="ir.ui.view">
        <field name="name">sf.pharmacy.prescription.search</field>
        <field name="model">sf.pharmacy.prescription</field>
        <field name="arch" type="xml">
            <search string="Ordonnances">
                <field name="name"/>
                <field name="patient_name"/>
                <field name="prescriber"/>
                <filter string="Brouillons" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Confirmées" name="confirmed" domain="[('state', '=', 'confirmed')]"/>
                <filter string="Terminées" name="done" domain="[('state', '=', 'done')]"/>
            </search>
        </field>
    </record>

    <record id="sf_pharmacy_dispensation_action" model="ir.actions.act_window">
        <field name="name">Délivrances</field>
        <field name="res_model">sf.pharmacy.dispensation</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record id="sf_pharmacy_dispensation_view_tree" model="ir.ui.view">
        <field name="name">sf.pharmacy.dispensation.tree</field>
        <field name="model">sf.pharmacy.dispensation</field>
        <field name="arch" type="xml">
            <tree string="Délivrances">
                <field name="name"/>
                <field name="prescription_id"/>
                <field name="product_id"/>
                <field name="batch_id"/>
                <field name="qty" sum="Total"/>
                <field name="dispensed_by"/>
                <field name="dispensed_at"/>
                <field name="state" widget="badge" decoration-success="state == 'done'" decoration-muted="state == 'cancelled'"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </tree>
        </field>
    </record>

    <record id="sf_pharmacy_dispensation_view_form" model="ir.ui.view">
        <field name="name">sf.pharmacy.dispensation.form</field>
        <field name="model">sf.pharmacy.dispensation</field>
        <field name="arch" type="xml">
            <form string="Délivrance">
                <header>
                    <button name="action_done" type="object" string="Délivrer" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_cancel" type="object" string="Annuler" invisible="state != 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,done,cancelled"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="prescription_id"/>
                            <field name="product_id"/>
                            <field name="batch_id" domain="[('product_id', '=', product_id), ('company_id', '=', company_id)]"/>
                            <field name="qty"/>
                        </group>
                        <group>
                            <field name="posology"/>
                            <field name="dispensed_by" readonly="1"/>
                            <field name="dispensed_at" readonly="1"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="sf_pharmacy_dispensation_view_search" model="ir.ui.view">
        <field name="name">sf.pharmacy.dispensation.search</field>
        <field name="model">sf.pharmacy.dispensation</field>
        <field name="arch" type="xml">
            <search string="Délivrances">
                <field name="name"/>
                <field name="prescription_id"/>
                <field name="product_id"/>
                <field name="batch_id"/>
                <field name="dispensed_by"/>
                <filter string="Terminées" name="done" domain="[('state', '=', 'done')]"/>
                <filter string="Brouillons" name="draft" domain="[('state', '=', 'draft')]"/>
                <group expand="0" string="Group By">
                    <filter string="Produit" name="group_by_product" domain="[]" context="{'group_by': 'product_id'}"/>
                    <filter string="Date" name="group_by_date" domain="[]" context="{'group_by': 'dispensed_at'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="sf_pharmacy_movement_action" model="ir.actions.act_window">
        <field name="name">Mouvements</field>
        <field name="res_model">sf.pharmacy.batch_movement</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record id="sf_pharmacy_movement_view_tree" model="ir.ui.view">
        <field name="name">sf.pharmacy.batch_movement.tree</field>
        <field name="model">sf.pharmacy.batch_movement</field>
        <field name="arch" type="xml">
            <tree string="Mouvements">
                <field name="name"/>
                <field name="move_date"/>
                <field name="batch_id"/>
                <field name="movement_type"/>
                <field name="qty" sum="Total"/>
                <field name="unit_price"/>
                <field name="reference"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </tree>
        </field>
    </record>

    <record id="sf_pharmacy_movement_view_form" model="ir.ui.view">
        <field name="name">sf.pharmacy.batch_movement.form</field>
        <field name="model">sf.pharmacy.batch_movement</field>
        <field name="arch" type="xml">
            <form string="Mouvement">
                <sheet>
                    <group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="batch_id"/>
                            <field name="movement_type"/>
                            <field name="qty"/>
                        </group>
                        <group>
                            <field name="unit_price" currency_field="currency_id"/>
                            <field name="move_date"/>
                            <field name="reference"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="sf_pharmacy_movement_view_search" model="ir.ui.view">
        <field name="name">sf.pharmacy.batch_movement.search</field>
        <field name="model">sf.pharmacy.batch_movement</field>
        <field name="arch" type="xml">
            <search string="Mouvements">
                <field name="name"/>
                <field name="batch_id"/>
                <field name="reference"/>
                <filter string="Entrées" name="in" domain="[('movement_type', '=', 'in')]"/>
                <filter string="Sorties" name="out" domain="[('movement_type', '=', 'out')]"/>
                <filter string="Ajustements" name="adjustment" domain="[('movement_type', '=', 'adjustment')]"/>
                <group expand="0" string="Group By">
                    <filter string="Type" name="group_by_type" domain="[]" context="{'group_by': 'movement_type'}"/>
                    <filter string="Lot" name="group_by_batch" domain="[]" context="{'group_by': 'batch_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <menuitem id="menu_sf_pharmacy_root" name="Pharmacie" web_icon="sf_pharmacy,static/description/icon.png" sequence="50"/>
    <menuitem id="menu_sf_pharmacy_products" name="Produits" parent="menu_sf_pharmacy_root" action="sf_pharmacy_product_action" sequence="10"/>
    <menuitem id="menu_sf_pharmacy_batches" name="Lots" parent="menu_sf_pharmacy_root" action="sf_pharmacy_batch_action" sequence="20"/>
    <menuitem id="menu_sf_pharmacy_prescriptions" name="Ordonnances" parent="menu_sf_pharmacy_root" action="sf_pharmacy_prescription_action" sequence="30"/>
    <menuitem id="menu_sf_pharmacy_dispensations" name="Délivrances" parent="menu_sf_pharmacy_root" action="sf_pharmacy_dispensation_action" sequence="40"/>
    <menuitem id="menu_sf_pharmacy_movements" name="Mouvements" parent="menu_sf_pharmacy_root" action="sf_pharmacy_movement_action" sequence="50"/>
    <menuitem id="menu_sf_pharmacy_reports" name="Rapports" parent="menu_sf_pharmacy_root" sequence="60"/>
    <menuitem id="menu_sf_pharmacy_report_inventory" name="Inventaire des lots" parent="menu_sf_pharmacy_reports" action="sf_pharmacy_action_report_inventory" sequence="10"/>
    <menuitem id="menu_sf_pharmacy_report_deliveries" name="Délivrances" parent="menu_sf_pharmacy_reports" action="sf_pharmacy_action_report_deliveries" sequence="20"/>
    <menuitem id="menu_sf_pharmacy_report_stock_value" name="Valorisation du stock" parent="menu_sf_pharmacy_reports" action="sf_pharmacy_action_report_stock_value" sequence="30"/>
</odoo>