<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sf_pharmacy_product_action" model="ir.actions.act_window">
        <field name="name">Products</field>
        <field name="res_model">sf.pharmacy.product</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_group_by_company': 1}</field>
    </record>

    <record id="sf_pharmacy_product_view_tree" model="ir.ui.view">
        <field name="name">sf.pharmacy.product.tree</field>
        <field name="model">sf.pharmacy.product</field>
        <field name="arch" type="xml">
            <tree string="Products">
                <field name="name"/>
                <field name="generic_name"/>
                <field name="dosage"/>
                <field name="form"/>
                <field name="atc_code"/>
                <field name="safety_stock"/>
                <field name="price_unit" sum="Total"/>
                <field name="cost" sum="Total"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </tree>
        </field>
    </record>

    <record id="sf_pharmacy_product_view_form" model="ir.ui.view">
        <field name="name">sf.pharmacy.product.form</field>
        <field name="model">sf.pharmacy.product</field>
        <field name="arch" type="xml">
            <form string="Product">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="generic_name"/>
                            <field name="dosage"/>
                            <field name="form"/>
                            <field name="atc_code"/>
                            <field name="responsible_id"/>
                        </group>
                        <group>
                            <field name="price_unit" currency_field="currency_id"/>
                            <field name="cost" currency_field="currency_id"/>
                            <field name="safety_stock"/>
                            <field name="active"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Batches">
                            <field name="batch_ids" readonly="1">
                                <tree string="Batches" create="false" edit="false">
                                    <field name="name"/>
                                    <field name="lot_ref"/>
                                    <field name="expiry_date"/>
                                    <field name="qty_received"/>
                                    <field name="qty_dispensed"/>
                                    <field name="qty_reserved"/>
                                    <field name="qty_available"/>
                                    <field name="status"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="sf_pharmacy_product_view_search" model="ir.ui.view">
        <field name="name">sf.pharmacy.product.search</field>
        <field name="model">sf.pharmacy.product</field>
        <field name="arch" type="xml">
            <search string="Products">
                <field name="name"/>
                <field name="generic_name"/>
                <field name="atc_code"/>
                <filter string="Active" name="active" domain="[('active', '=', True)]"/>
                <group>
                    <filter string="Company" name="group_by_company" domain="[]" context="{'group_by': 'company_id'}"/>
                    <filter string="Form" name="group_by_form" domain="[]" context="{'group_by': 'form'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="sf_pharmacy_batch_action" model="ir.actions.act_window">
        <field name="name">Batches</field>
        <field name="res_model">sf.pharmacy.batch</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="context">{'search_default_group_by_status': 1}</field>
    </record>

    <record id="sf_pharmacy_batch_view_kanban" model="ir.ui.view">
        <field name="name">sf.pharmacy.batch.kanban</field>
        <field name="model">sf.pharmacy.batch</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <field name="name"/>
                <field name="product_id"/>
                <field name="expiry_date"/>
                <field name="qty_available"/>
                <field name="status"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_record_title">
                                <strong><field name="name"/></strong>
                            </div>
                            <div class="o_kanban_record_subtitle">
                                <field name="product_id"/>
                            </div>
                            <div class="o_kanban_record_bottom">
                                <div class="text-muted">
                                    Expiry: <field name="expiry_date"/>
                                </div>
                                <div class="text-muted">
                                    Available: <field name="qty_available"/>
                                </div>
                                <span t-if="record.status.raw_value == 'available'" class="badge badge-success">Available</span>
                                <span t-if="record.status.raw_value == 'expired'" class="badge badge-danger">Expired</span>
                                <span t-if="record.status.raw_value == 'recalled'" class="badge badge-warning">Recalled</span>
                                <span t-if="record.status.raw_value == 'withdrawn'" class="badge badge-secondary">Withdrawn</span>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="sf_pharmacy_batch_view_tree" model="ir.ui.view">
        <field name="name">sf.pharmacy.batch.tree</field>
        <field name="model">sf.pharmacy.batch</field>
        <field name="arch" type="xml">
            <tree string="Batches">
                <field name="name"/>
                <field name="product_id"/>
                <field name="lot_ref"/>
                <field name="expiry_date"/>
                <field name="qty_received" sum="Total"/>
                <field name="qty_dispensed" sum="Total"/>
                <field name="qty_reserved" sum="Total"/>
                <field name="qty_withdrawn" sum="Total"/>
                <field name="qty_available" sum="Total"/>
                <field name="status" widget="badge" decoration-danger="status == 'expired'" decoration-warning="status == 'recalled'" decoration-info="status == 'withdrawn'"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </tree>
        </field>
    </record>

    <record id="sf_pharmacy_batch_view_form" model="ir.ui.view">
        <field name="name">sf.pharmacy.batch.form</field>
        <field name="model">sf.pharmacy.batch</field>
        <field name="arch" type="xml">
            <form string="Batch">
                <header>
                    <button name="action_withdraw" type="object" string="Withdraw (expiry)" groups="sf_pharmacy.group_sf_pharmacy_manager" confirm="Withdraw this batch from available stock?"/>
                    <button name="action_recall" type="object" string="Batch recall" groups="sf_pharmacy.group_sf_pharmacy_manager" confirm="Launch a recall for this batch?"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="product_id"/>
                            <field name="lot_ref"/>
                            <field name="expiry_date"/>
                            <field name="status" widget="badge"/>
                        </group>
                        <group>
                            <field name="qty_received"/>
                            <field name="qty_dispensed" readonly="1"/>
                            <field name="qty_reserved"/>
                            <field name="qty_withdrawn" readonly="1"/>
                            <field name="qty_available" readonly="1"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Movements">
                            <field name="movement_ids" readonly="1">
                                <tree string="Movements" create="false" edit="false">
                                    <field name="name"/>
                                    <field name="move_date"/>
                                    <field name="movement_type"/>
                                    <field name="qty"/>
                                    <field name="unit_price"/>
                                    <field name="reference"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="sf_pharmacy_batch_view_search" model="ir.ui.view">
        <field name="name">sf.pharmacy.batch.search</field>
        <field name="model">sf.pharmacy.batch</field>
        <field name="arch" type="xml">
            <search string="Batches">
                <field name="name"/>
                <field name="product_id"/>
                <field name="lot_ref"/>
                <filter string="Available" name="available" domain="[('status', '=', 'available')]"/>
                <filter string="Expired" name="expired" domain="[('status', '=', 'expired')]"/>
                <filter string="Withdrawn" name="withdrawn" domain="[('status', '=', 'withdrawn')]"/>
                <filter string="Recalled" name="recalled" domain="[('status', '=', 'recalled')]"/>
                <group>
                    <filter string="Status" name="group_by_status" domain="[]" context="{'group_by': 'status'}"/>
                    <filter string="Product" name="group_by_product" domain="[]" context="{'group_by': 'product_id'}"/>
                    <filter string="Company" name="group_by_company" domain="[]" context="{'group_by': 'company_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="sf_pharmacy_batch_view_graph" model="ir.ui.view">
        <field name="name">sf.pharmacy.batch.graph</field>
        <field name="model">sf.pharmacy.batch</field>
        <field name="arch" type="xml">
            <graph string="Quantities by status">
                <field name="status"/>
                <field name="qty_available" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="sf_pharmacy_prescription_action" model="ir.actions.act_window">
        <field name="name">Prescriptions</field>
        <field name="res_model">sf.pharmacy.prescription</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record id="sf_pharmacy_prescription_view_tree" model="ir.ui.view">
        <field name="name">sf.pharmacy.prescription.tree</field>
        <field name="model">sf.pharmacy.prescription</field>
        <field name="arch" type="xml">
            <tree string="Prescriptions">
                <field name="name"/>
                <field name="patient_name"/>
                <field name="prescriber"/>
                <field name="prescription_date"/>
                <field name="state" widget="badge" decoration-success="state == 'done'" decoration-info="state == 'confirmed'" decoration-muted="state == 'cancelled'"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </tree>
        </field>
    </record>

    <record id="sf_pharmacy_prescription_view_form" model="ir.ui.view">
        <field name="name">sf.pharmacy.prescription.form</field>
        <field name="model">sf.pharmacy.prescription</field>
        <field name="arch" type="xml">
            <form string="Prescription">
                <header>
                    <button name="action_confirm" type="object" string="Confirm" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_done" type="object" string="Complete" class="oe_highlight" invisible="state != 'confirmed'"/>
                    <button name="action_cancel" type="object" string="Cancel" invisible="state not in ('draft', 'confirmed')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,done,cancelled"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="patient_name"/>
                            <field name="prescriber"/>
                            <field name="prescription_date"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Dispensations">
                            <field name="dispensation_ids" context="{'default_company_id': company_id}" readonly="[['state', 'in', ['confirmed', 'done', 'cancelled']]]">
                                <tree string="Dispensations">
                                    <field name="name"/>
                                    <field name="product_id"/>
                                    <field name="batch_id" domain="[('product_id', '=', product_id), ('company_id', '=', company_id)]"/>
                                    <field name="qty"/>
                                    <field name="posology"/>
                                    <field name="state"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="sf_pharmacy_prescription_view_search" model="ir.ui.view">
        <field name="name">sf.pharmacy.prescription.search</field>
        <field name="model">sf.pharmacy.prescription</field>
        <field name="arch" type="xml">
            <search string="Prescriptions">
                <field name="name"/>
                <field name="patient_name"/>
                <field name="prescriber"/>
                <filter string="Drafts" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Confirmed" name="confirmed" domain="[('state', '=', 'confirmed')]"/>
                <filter string="Done" name="done" domain="[('state', '=', 'done')]"/>
            </search>
        </field>
    </record>

    <record id="sf_pharmacy_dispensation_action" model="ir.actions.act_window">
        <field name="name">Dispensations</field>
        <field name="res_model">sf.pharmacy.dispensation</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record id="sf_pharmacy_dispensation_view_tree" model="ir.ui.view">
        <field name="name">sf.pharmacy.dispensation.tree</field>
        <field name="model">sf.pharmacy.dispensation</field>
        <field name="arch" type="xml">
            <tree string="Dispensations">
                <field name="name"/>
                <field name="prescription_id"/>
                <field name="product_id"/>
                <field name="batch_id"/>
                <field name="qty" sum="Total"/>
                <field name="dispensed_by"/>
                <field name="dispensed_at"/>
                <field name="state" widget="badge" decoration-success="state == 'done'" decoration-muted="state == 'cancelled'"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </tree>
        </field>
    </record>

    <record id="sf_pharmacy_dispensation_view_form" model="ir.ui.view">
        <field name="name">sf.pharmacy.dispensation.form</field>
        <field name="model">sf.pharmacy.dispensation</field>
        <field name="arch" type="xml">
            <form string="Dispensation">
                <header>
                    <button name="action_done" type="object" string="Dispense" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_cancel" type="object" string="Cancel" invisible="state != 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,done,cancelled"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="prescription_id"/>
                            <field name="product_id"/>
                            <field name="batch_id" domain="[('product_id', '=', product_id), ('company_id', '=', company_id)]"/>
                            <field name="qty"/>
                        </group>
                        <group>
                            <field name="posology"/>
                            <field name="dispensed_by" readonly="1"/>
                            <field name="dispensed_at" readonly="1"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="sf_pharmacy_dispensation_view_search" model="ir.ui.view">
        <field name="name">sf.pharmacy.dispensation.search</field>
        <field name="model">sf.pharmacy.dispensation</field>
        <field name="arch" type="xml">
            <search string="Dispensations">
                <field name="name"/>
                <field name="prescription_id"/>
                <field name="product_id"/>
                <field name="batch_id"/>
                <field name="dispensed_by"/>
                <filter string="Done" name="done" domain="[('state', '=', 'done')]"/>
                <filter string="Drafts" name="draft" domain="[('state', '=', 'draft')]"/>
                <group>
                    <filter string="Product" name="group_by_product" domain="[]" context="{'group_by': 'product_id'}"/>
                    <filter string="Date" name="group_by_date" domain="[]" context="{'group_by': 'dispensed_at'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="sf_pharmacy_movement_action" model="ir.actions.act_window">
        <field name="name">Movements</field>
        <field name="res_model">sf.pharmacy.batch_movement</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record id="sf_pharmacy_movement_view_tree" model="ir.ui.view">
        <field name="name">sf.pharmacy.batch_movement.tree</field>
        <field name="model">sf.pharmacy.batch_movement</field>
        <field name="arch" type="xml">
            <tree string="Movements">
                <field name="name"/>
                <field name="move_date"/>
                <field name="batch_id"/>
                <field name="movement_type"/>
                <field name="qty" sum="Total"/>
                <field name="unit_price"/>
                <field name="reference"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </tree>
        </field>
    </record>

    <record id="sf_pharmacy_movement_view_form" model="ir.ui.view">
        <field name="name">sf.pharmacy.batch_movement.form</field>
        <field name="model">sf.pharmacy.batch_movement</field>
        <field name="arch" type="xml">
            <form string="Movement">
                <sheet>
                    <group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="batch_id"/>
                            <field name="movement_type"/>
                            <field name="qty"/>
                        </group>
                        <group>
                            <field name="unit_price" currency_field="currency_id"/>
                            <field name="move_date"/>
                            <field name="reference"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="sf_pharmacy_movement_view_search" model="ir.ui.view">
        <field name="name">sf.pharmacy.batch_movement.search</field>
        <field name="model">sf.pharmacy.batch_movement</field>
        <field name="arch" type="xml">
            <search string="Movements">
                <field name="name"/>
                <field name="batch_id"/>
                <field name="reference"/>
                <filter string="In" name="in" domain="[('movement_type', '=', 'in')]"/>
                <filter string="Out" name="out" domain="[('movement_type', '=', 'out')]"/>
                <filter string="Adjustments" name="adjustment" domain="[('movement_type', '=', 'adjustment')]"/>
                <group>
                    <filter string="Type" name="group_by_type" domain="[]" context="{'group_by': 'movement_type'}"/>
                    <filter string="Batch" name="group_by_batch" domain="[]" context="{'group_by': 'batch_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <menuitem id="menu_sf_pharmacy_root" name="Pharmacy" web_icon="sf_pharmacy,static/description/icon.png" sequence="50"/>
    <menuitem id="menu_sf_pharmacy_products" name="Products" parent="menu_sf_pharmacy_root" action="sf_pharmacy_product_action" sequence="10"/>
    <menuitem id="menu_sf_pharmacy_batches" name="Batches" parent="menu_sf_pharmacy_root" action="sf_pharmacy_batch_action" sequence="20"/>
    <menuitem id="menu_sf_pharmacy_prescriptions" name="Prescriptions" parent="menu_sf_pharmacy_root" action="sf_pharmacy_prescription_action" sequence="30"/>
    <menuitem id="menu_sf_pharmacy_dispensations" name="Dispensations" parent="menu_sf_pharmacy_root" action="sf_pharmacy_dispensation_action" sequence="40"/>
    <menuitem id="menu_sf_pharmacy_movements" name="Movements" parent="menu_sf_pharmacy_root" action="sf_pharmacy_movement_action" sequence="50"/>
    <menuitem id="menu_sf_pharmacy_reports" name="Reports" parent="menu_sf_pharmacy_root" sequence="60"/>
    <menuitem id="menu_sf_pharmacy_report_inventory" name="Batch inventory" parent="menu_sf_pharmacy_reports" action="sf_pharmacy_action_report_inventory" sequence="10"/>
    <menuitem id="menu_sf_pharmacy_report_deliveries" name="Dispensations" parent="menu_sf_pharmacy_reports" action="sf_pharmacy_action_report_deliveries" sequence="20"/>
    <menuitem id="menu_sf_pharmacy_report_stock_value" name="Stock valuation" parent="menu_sf_pharmacy_reports" action="sf_pharmacy_action_report_stock_value" sequence="30"/>
</odoo>