<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="module_category_sf_pharmacy" model="ir.module.category">
            <field name="name">sf_pharmacy</field>
            <field name="description">Pharmacy and dispensation management</field>
            <field name="sequence">10</field>
        </record>

        <record id="group_sf_pharmacy_user" model="res.groups">
            <field name="name">User</field>
            <field name="category_id" ref="module_category_sf_pharmacy"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_sf_pharmacy_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="category_id" ref="module_category_sf_pharmacy"/>
            <field name="implied_ids" eval="[(4, ref('sf_pharmacy.group_sf_pharmacy_user'))]"/>
        </record>

        <record id="sf_pharmacy_product_company_rule" model="ir.rule">
            <field name="name">sf.pharmacy.product : user company</field>
            <field name="model_id" ref="model_sf_pharmacy_product"/>
            <field name="global" eval="False"/>
            <field name="groups" eval="[(4, ref('sf_pharmacy.group_sf_pharmacy_user'))]"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <record id="sf_pharmacy_batch_company_rule" model="ir.rule">
            <field name="name">sf.pharmacy.batch : user company</field>
            <field name="model_id" ref="model_sf_pharmacy_batch"/>
            <field name="global" eval="False"/>
            <field name="groups" eval="[(4, ref('sf_pharmacy.group_sf_pharmacy_user'))]"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <record id="sf_pharmacy_prescription_company_rule" model="ir.rule">
            <field name="name">sf.pharmacy.prescription : user company</field>
            <field name="model_id" ref="model_sf_pharmacy_prescription"/>
            <field name="global" eval="False"/>
            <field name="groups" eval="[(4, ref('sf_pharmacy.group_sf_pharmacy_user'))]"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <record id="sf_pharmacy_dispensation_company_rule" model="ir.rule">
            <field name="name">sf.pharmacy.dispensation : user company</field>
            <field name="model_id" ref="model_sf_pharmacy_dispensation"/>
            <field name="global" eval="False"/>
            <field name="groups" eval="[(4, ref('sf_pharmacy.group_sf_pharmacy_user'))]"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <record id="sf_pharmacy_batch_movement_company_rule" model="ir.rule">
            <field name="name">sf.pharmacy.batch_movement : user company</field>
            <field name="model_id" ref="model_sf_pharmacy_batch_movement"/>
            <field name="global" eval="False"/>
            <field name="groups" eval="[(4, ref('sf_pharmacy.group_sf_pharmacy_user'))]"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <record id="sf_pharmacy_product_manager_all_rule" model="ir.rule">
            <field name="name">sf.pharmacy.product : manager all companies</field>
            <field name="model_id" ref="model_sf_pharmacy_product"/>
            <field name="global" eval="False"/>
            <field name="groups" eval="[(4, ref('sf_pharmacy.group_sf_pharmacy_manager'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

        <record id="sf_pharmacy_batch_manager_all_rule" model="ir.rule">
            <field name="name">sf.pharmacy.batch : manager all companies</field>
            <field name="model_id" ref="model_sf_pharmacy_batch"/>
            <field name="global" eval="False"/>
            <field name="groups" eval="[(4, ref('sf_pharmacy.group_sf_pharmacy_manager'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

        <record id="sf_pharmacy_prescription_manager_all_rule" model="ir.rule">
            <field name="name">sf.pharmacy.prescription : manager all companies</field>
            <field name="model_id" ref="model_sf_pharmacy_prescription"/>
            <field name="global" eval="False"/>
            <field name="groups" eval="[(4, ref('sf_pharmacy.group_sf_pharmacy_manager'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

        <record id="sf_pharmacy_dispensation_manager_all_rule" model="ir.rule">
            <field name="name">sf.pharmacy.dispensation : manager all companies</field>
            <field name="model_id" ref="model_sf_pharmacy_dispensation"/>
            <field name="global" eval="False"/>
            <field name="groups" eval="[(4, ref('sf_pharmacy.group_sf_pharmacy_manager'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

        <record id="sf_pharmacy_batch_movement_manager_all_rule" model="ir.rule">
            <field name="name">sf.pharmacy.batch_movement : manager all companies</field>
            <field name="model_id" ref="model_sf_pharmacy_batch_movement"/>
            <field name="global" eval="False"/>
            <field name="groups" eval="[(4, ref('sf_pharmacy.group_sf_pharmacy_manager'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>
    </data>
</odoo>
