<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_batch_job_monitor" model="ir.actions.act_window">
        <field name="name">Batch Job Monitor</field>
        <field name="res_model">sf.batch_job_monitor</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
    <record id="view_sf_batch_job_monitor_form" model="ir.ui.view">
        <field name="name">sf.batch_job_monitor.form</field>
        <field name="model">sf.batch_job_monitor</field>
        <field name="arch" type="xml">
            <form string="Batch Job Monitor">
                <header>
                    <button name="action_submitted" type="object" string="Submitted"
                            class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="job_name"/>
                            <field name="last_run"/>
                            <field name="duration_seconds"/>
                            <field name="status"/>
                            <field name="records_processed"/>
                            <field name="error_detail"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_batch_job_monitor_list" model="ir.ui.view">
        <field name="name">sf.batch_job_monitor.list</field>
        <field name="model">sf.batch_job_monitor</field>
        <field name="arch" type="xml">
            <list string="Batch Job Monitor" sample="1">
                <field name="job_name"/>
                <field name="last_run"/>
                <field name="duration_seconds"/>
                <field name="status"/>
                <field name="records_processed"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state in ('submitted','approved')"/>
            </list>
        </field>
    </record>
    <record id="view_sf_batch_job_monitor_kanban" model="ir.ui.view">
        <field name="name">sf.batch_job_monitor.kanban</field>
        <field name="model">sf.batch_job_monitor</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_view" group_by="state">
                <field name="name"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <menuitem id="menu_sf_batch_job_monitor_root" name="Batch Job Monitor" sequence="17"
              web_icon="sf_batch_job_monitor,static/description/icon.png"/>
    <menuitem id="menu_sf_batch_job_monitor_main" name="Records"
              parent="menu_sf_batch_job_monitor_root" action="action_sf_batch_job_monitor" sequence="10"/>

    <record id="wave_final_sf_batch_job_monitor" model="ir.actions.server">
        <field name="name">Refresh Business Data</field>
        <field name="model_id" ref="model_sf_batch_job_monitor"/>
        <field name="binding_model_id" ref="model_sf_batch_job_monitor"/>
        <field name="state">code</field>
        <field name="code">records.action_refresh_business()</field>
    </record>
</odoo>
