<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_batch_job_monitor" model="ir.module.category">
        <field name="name">Batch Job Monitor</field>
        <field name="sequence">384</field>
    </record>
    <record id="group_batch_job_monitor_user" model="res.groups">
        <field name="name">Batch Job Monitor User</field>
        <field name="category_id" ref="module_category_batch_job_monitor"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>

    </record>
    <record id="group_batch_job_monitor_manager" model="res.groups">
        <field name="name">Batch Job Monitor Manager</field>
        <field name="category_id" ref="module_category_batch_job_monitor"/>
        <field name="implied_ids" eval="[(4, ref('group_batch_job_monitor_user'))]"/>
    </record>
    <record id="rule_batch_job_monitor_sf_batch_job_monitor" model="ir.rule">
        <field name="name">Batch Job Monitor: multi-company</field>
        <field name="model_id" ref="model_sf_batch_job_monitor"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_batch_job_monitor"/>
    </record>
</odoo>
