<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_customer_advocacy_program" model="ir.module.category">
        <field name="name">Customer Advocacy Program</field>
        <field name="sequence">500</field>
    </record>
    <record id="group_customer_advocacy_program_user" model="res.groups">
        <field name="name">Customer Advocacy Program User</field>
        <field name="category_id" ref="module_category_customer_advocacy_program"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>

    </record>
    <record id="group_customer_advocacy_program_manager" model="res.groups">
        <field name="name">Customer Advocacy Program Manager</field>
        <field name="category_id" ref="module_category_customer_advocacy_program"/>
        <field name="implied_ids" eval="[(4, ref('group_customer_advocacy_program_user'))]"/>
    </record>
    <record id="rule_customer_advocacy_program_sf_customer_advocacy_program" model="ir.rule">
        <field name="name">Customer Advocacy Program: multi-company</field>
        <field name="model_id" ref="model_sf_customer_advocacy_program"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_customer_advocacy_program"/>
    </record>
</odoo>
