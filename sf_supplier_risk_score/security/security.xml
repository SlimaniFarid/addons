<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_supplier_risk_score" model="ir.module.category">
        <field name="name">Supplier Risk Scoring Model</field>
        <field name="sequence">682</field>
    </record>
    <record id="group_supplier_risk_score_user" model="res.groups">
        <field name="name">Supplier Risk Scoring Model User</field>
        <field name="category_id" ref="module_category_supplier_risk_score"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>

    </record>
    <record id="group_supplier_risk_score_manager" model="res.groups">
        <field name="name">Supplier Risk Scoring Model Manager</field>
        <field name="category_id" ref="module_category_supplier_risk_score"/>
        <field name="implied_ids" eval="[(4, ref('group_supplier_risk_score_user'))]"/>
    </record>
    <record id="rule_supplier_risk_score_sf_supplier_risk_score" model="ir.rule">
        <field name="name">Supplier Risk Scoring Model: multi-company</field>
        <field name="model_id" ref="model_sf_supplier_risk_score"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
