<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="module_category_sf_franchise" model="ir.module.category">
            <field name="name">Franchise</field>
            <field name="description">Retail Franchise Network Management.</field>
            <field name="sequence">10</field>
        </record>

        <record id="group_sf_franchise_user" model="res.groups">
            <field name="name">Franchise / User</field>
            <field name="category_id" ref="module_category_sf_franchise"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_sf_franchise_manager" model="res.groups">
            <field name="name">Franchise / Manager</field>
            <field name="category_id" ref="module_category_sf_franchise"/>
            <field name="implied_ids" eval="[(4, ref('sf_franchise.group_sf_franchise_user'))]"/>
        </record>

        <record id="rule_sf_franchise_contract_company" model="ir.rule">
            <field name="name">Franchise Contract: user sees own company</field>
            <field name="model_id" ref="model_sf_franchise_contract"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('sf_franchise.group_sf_franchise_user'))]"/>
        </record>
        <record id="rule_sf_franchise_contract_manager_all" model="ir.rule">
            <field name="name">Franchise Contract: manager sees all companies</field>
            <field name="model_id" ref="model_sf_franchise_contract"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('sf_franchise.group_sf_franchise_manager'))]"/>
        </record>

        <record id="rule_sf_franchise_declaration_company" model="ir.rule">
            <field name="name">Franchise Declaration: user sees own company</field>
            <field name="model_id" ref="model_sf_franchise_declaration"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('sf_franchise.group_sf_franchise_user'))]"/>
        </record>
        <record id="rule_sf_franchise_declaration_manager_all" model="ir.rule">
            <field name="name">Franchise Declaration: manager sees all companies</field>
            <field name="model_id" ref="model_sf_franchise_declaration"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('sf_franchise.group_sf_franchise_manager'))]"/>
        </record>
    </data>
    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_sf_franchise"/>
    </record>
</odoo>