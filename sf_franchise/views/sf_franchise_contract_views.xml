<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sf_franchise_contract_view_list" model="ir.ui.view">
        <field name="name">sf.franchise.contract.list</field>
        <field name="model">sf.franchise.contract</field>
        <field name="arch" type="xml">
            <list decoration-danger="is_overdue" string="Franchise Contracts">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="territory"/>
                <field name="royalty_type"/>
                <field name="royalty_percent"/>
                <field name="fixed_amount"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="state" widget="badge"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="sf_franchise_contract_view_form" model="ir.ui.view">
        <field name="name">sf.franchise.contract.form</field>
        <field name="model">sf.franchise.contract</field>
        <field name="arch" type="xml">
            <form string="Franchise Contract">
                <header>
                    <button name="action_activate" string="Activate" type="object" class="btn-primary"
                            invisible="[('state', '!=', 'draft')]"/>
                    <button name="action_suspend" string="Suspend" type="object"
                            invisible="[('state', '!=', 'active')]"
                            groups="sf_franchise.group_sf_franchise_manager"/>
                    <button name="action_terminate" string="Terminate" type="object"
                            invisible="[('state', 'not in', ('active', 'suspended'))]"
                            groups="sf_franchise.group_sf_franchise_manager"/>
                    <field name="state" widget="statusbar" readonly="1"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="territory"/>
                            <field name="start_date"/>
                            <field name="end_date"/>
                        </group>
                        <group>
                            <field name="royalty_type"/>
                            <field name="fixed_amount" invisible="[('royalty_type', '!=', 'fixed')]"/>
                            <field name="royalty_percent" invisible="[('royalty_type', '!=', 'percentage')]"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Declarations">
                            <field name="declaration_ids">
                                <list string="Declarations">
                                    <field name="name"/>
                                    <field name="period_start"/>
                                    <field name="period_end"/>
                                    <field name="declared_sales"/>
                                    <field name="royalty_amount"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="sf_franchise_contract_view_search" model="ir.ui.view">
        <field name="name">sf.franchise.contract.search</field>
        <field name="model">sf.franchise.contract</field>
        <field name="arch" type="xml">
            <search string="Franchise Contracts">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="territory"/>
                <filter name="contract_active" string="Active" domain="[('state', '=', 'active')]"/>
                <filter name="contract_draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <group>
                    <filter name="group_contract_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_contract_royalty" string="Royalty Type" context="{'group_by': 'royalty_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_sf_franchise_contract" model="ir.actions.act_window">
        <field name="name">Franchise Contracts</field>
        <field name="res_model">sf.franchise.contract</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="sf_franchise_contract_view_search"/>
    </record>

    <record id="view_sf_franchise_boost_kanban" model="ir.ui.view">
        <field name="name">sf_franchise.boost.kanban</field>
        <field name="model">sf.franchise.activity.mixin</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" t-att-color="state">
                <field name="name"/>
                <field name="state"/>
                <field name="user_id"/>
                <field name="end_date"/>
                <field name="is_overdue" invisible="1"/>

                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_card oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title">
                                    <field name="name"/></strong>
                                <div class="o_kanban_record_subtitle">
                                    <field name="user_id" widget="many2one_avatar_user"/>
                                    <field name="end_date"/></div>
                            </div>
                            <div class="oe_kanban_bottom_right">
                                <field name="state" widget="badge"
                                       t-attf-options="{'classes_map': {'draft': 'info', 'done': 'success', 'cancelled': 'danger'}, 'domain': []}"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_sf_franchise_boost_search" model="ir.ui.view">
        <field name="name">sf_franchise.boost.search</field>
        <field name="model">sf.franchise.activity.mixin</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
<separator/>
                <filter string="My records" name="my_records" domain="[('user_id', '=', uid)]"/>
                <filter string="To Do" name="todo" domain="[('state', 'not in', ('done', 'cancelled', 'closed'))]"/>
                <group expand="0" string="Group By"><filter string="Status" name="gb_state" context="{'group_by': 'state'}"/></group>
            </search>
        </field>
    </record>

    <record id="wave_final_sf_franchise" model="ir.actions.server">
        <field name="name">Refresh Business Data</field>
        <field name="model_id" ref="model_sf_franchise_activity_mixin"/>
        <field name="binding_model_id" ref="model_sf_franchise_activity_mixin"/>
        <field name="state">code</field>
        <field name="code">records.action_refresh_business()</field>
    </record>
</odoo>
