<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sf_franchise_declaration_view_list" model="ir.ui.view">
        <field name="name">sf.franchise.declaration.list</field>
        <field name="model">sf.franchise.declaration</field>
        <field name="arch" type="xml">
            <list decoration-danger="is_overdue" string="Sales Declarations">
                <field name="name"/>
                <field name="contract_id"/>
                <field name="period_start"/>
                <field name="period_end"/>
                <field name="declared_sales"/>
                <field name="royalty_amount"/>
                <field name="invoice_id"/>
                <field name="state" widget="badge"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="sf_franchise_declaration_view_form" model="ir.ui.view">
        <field name="name">sf.franchise.declaration.form</field>
        <field name="model">sf.franchise.declaration</field>
        <field name="arch" type="xml">
            <form string="Sales Declaration">
                <header>
                    <button name="action_confirm" string="Confirm" type="object" class="btn-primary"
                            invisible="[('state', '!=', 'draft')]"
                            groups="sf_franchise.group_sf_franchise_manager"/>
                    <button name="action_generate_invoice" string="Generate Invoice" type="object"
                            class="btn-primary" invisible="[('state', '!=', 'confirmed')]"
                            groups="sf_franchise.group_sf_franchise_manager"/>
                    <button name="action_mark_paid" string="Mark Paid" type="object"
                            class="btn-primary" invisible="[('state', '!=', 'invoiced')]"
                            groups="sf_franchise.group_sf_franchise_manager"/>
                    <button name="action_cancel" string="Cancel" type="object"
                            invisible="[('state', 'in', ('invoiced', 'paid', 'cancelled'))]"
                            groups="sf_franchise.group_sf_franchise_manager"/>
                    <field name="state" widget="statusbar" readonly="1"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="contract_id"/>
                            <field name="period_start"/>
                            <field name="period_end"/>
                            <field name="declared_sales"/>
                        </group>
                        <group>
                            <field name="royalty_amount"/>
                            <field name="invoice_id"/>
                            <field name="invoice_state"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="sf_franchise_declaration_view_search" model="ir.ui.view">
        <field name="name">sf.franchise.declaration.search</field>
        <field name="model">sf.franchise.declaration</field>
        <field name="arch" type="xml">
            <search string="Sales Declarations">
                <field name="name"/>
                <field name="contract_id"/>
                <field name="period_start"/>
                <filter name="declaration_confirmed" string="Confirmed" domain="[('state', '=', 'confirmed')]"/>
                <filter name="declaration_invoiced" string="Invoiced" domain="[('state', '=', 'invoiced')]"/>
                <filter name="declaration_paid" string="Paid" domain="[('state', '=', 'paid')]"/>
                <group>
                    <filter name="group_declaration_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_declaration_contract" string="Contract" context="{'group_by': 'contract_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_sf_franchise_declaration" model="ir.actions.act_window">
        <field name="name">Sales Declarations</field>
        <field name="res_model">sf.franchise.declaration</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="sf_franchise_declaration_view_search"/>
    </record>

    <record id="view_sf_franchise_boost_kanban" model="ir.ui.view">
        <field name="name">sf_franchise.boost.kanban</field>
        <field name="model">sf.franchise.activity.mixin</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" t-att-color="state">
                <field name="name"/>
                <field name="state"/>
                <field name="user_id"/>
                <field name="end_date"/>
                <field name="is_overdue" invisible="1"/>

                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_card oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title">
                                    <field name="name"/></strong>
                                <div class="o_kanban_record_subtitle">
                                    <field name="user_id" widget="many2one_avatar_user"/>
                                    <field name="end_date"/></div>
                            </div>
                            <div class="oe_kanban_bottom_right">
                                <field name="state" widget="badge"
                                       t-attf-options="{'classes_map': {'draft': 'info', 'done': 'success', 'cancelled': 'danger'}, 'domain': []}"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_sf_franchise_boost_search" model="ir.ui.view">
        <field name="name">sf_franchise.boost.search</field>
        <field name="model">sf.franchise.activity.mixin</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
<separator/>
                <filter string="My records" name="my_records" domain="[('user_id', '=', uid)]"/>
                <filter string="To Do" name="todo" domain="[('state', 'not in', ('done', 'cancelled', 'closed'))]"/>
                <group expand="0" string="Group By"><filter string="Status" name="gb_state" context="{'group_by': 'state'}"/></group>
            </search>
        </field>
    </record>
</odoo>
