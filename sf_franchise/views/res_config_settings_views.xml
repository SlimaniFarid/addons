<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_franchise" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.franchise</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Franchise" string="Franchise" name="sf_franchise">
                    <block title="Franchise Settings">
                        <setting string="Default Royalty Income Account">
                            <field name="sf_franchise_default_royalty_account_id"/>
                        </setting>
                        <setting string="Default Sale Journal">
                            <field name="sf_franchise_default_sale_journal_id"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>