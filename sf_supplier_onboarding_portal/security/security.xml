<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_supplier_onboarding_portal" model="ir.module.category">
        <field name="name">Supplier Onboarding Portal Config</field>
        <field name="sequence">484</field>
    </record>
    <record id="group_supplier_onboarding_portal_user" model="res.groups">
        <field name="name">Supplier Onboarding Portal Config User</field>
        <field name="category_id" ref="module_category_supplier_onboarding_portal"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>

    </record>
    <record id="group_supplier_onboarding_portal_manager" model="res.groups">
        <field name="name">Supplier Onboarding Portal Config Manager</field>
        <field name="category_id" ref="module_category_supplier_onboarding_portal"/>
        <field name="implied_ids" eval="[(4, ref('group_supplier_onboarding_portal_user'))]"/>
    </record>
    <record id="rule_supplier_onboarding_portal_sf_supplier_onboarding_portal" model="ir.rule">
        <field name="name">Supplier Onboarding Portal Config: multi-company</field>
        <field name="model_id" ref="model_sf_supplier_onboarding_portal"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
