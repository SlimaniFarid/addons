<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_business_requirement" model="ir.actions.act_window">
        <field name="name">Business Requirement Register</field>
        <field name="res_model">sf.business_requirement</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
    <record id="view_sf_business_requirement_form" model="ir.ui.view">
        <field name="name">sf.business_requirement.form</field>
        <field name="model">sf.business_requirement</field>
        <field name="arch" type="xml">
            <form string="Business Requirement Register">
                <header>
                    <button name="action_submitted" type="object" string="Submitted"
                            class="btn-primary"/>
                    <button name="action_approved" type="object" string="Approved"
                            class="btn-primary"/>
                    <button name="action_done" type="object" string="Done"
                            class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,approved,done,cancelled"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="requirement"/>
                            <field name="source"/>
                            <field name="priority"/>
                            <field name="complexity"/>
                            <field name="status"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_business_requirement_list" model="ir.ui.view">
        <field name="name">sf.business_requirement.list</field>
        <field name="model">sf.business_requirement</field>
        <field name="arch" type="xml">
            <list string="Business Requirement Register" sample="1">
                <field name="requirement"/>
                <field name="source"/>
                <field name="priority"/>
                <field name="complexity"/>
                <field name="status"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state in ('submitted','approved')"/>
            </list>
        </field>
    </record>
    <record id="view_sf_business_requirement_kanban" model="ir.ui.view">
        <field name="name">sf.business_requirement.kanban</field>
        <field name="model">sf.business_requirement</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_view" group_by="state">
                <field name="name"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <menuitem id="menu_sf_business_requirement_root" name="Business Requirement Register" sequence="14"
              web_icon="sf_business_requirement,static/description/icon.png"/>
    <menuitem id="menu_sf_business_requirement_main" name="Records"
              parent="menu_sf_business_requirement_root" action="action_sf_business_requirement" sequence="10"/>
</odoo>
