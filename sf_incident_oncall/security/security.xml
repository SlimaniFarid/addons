<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_incident_oncall" model="ir.module.category">
        <field name="name">Incident On-Call Escalation</field>
        <field name="sequence">172</field>
    </record>
    <record id="group_incident_oncall_user" model="res.groups">
        <field name="name">Incident On-Call Escalation User</field>
        <field name="category_id" ref="module_category_incident_oncall"/>

    </record>
    <record id="group_incident_oncall_manager" model="res.groups">
        <field name="name">Incident On-Call Escalation Manager</field>
        <field name="category_id" ref="module_category_incident_oncall"/>
        <field name="implied_ids" eval="[(4, ref('group_incident_oncall_user'))]"/>
    </record>
    <record id="rule_incident_oncall_sf_incident_oncall" model="ir.rule">
        <field name="name">Incident On-Call Escalation: multi-company</field>
        <field name="model_id" ref="model_sf_incident_oncall"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_incident_oncall"/>
    </record>
</odoo>
