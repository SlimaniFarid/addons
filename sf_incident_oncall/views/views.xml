<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_incident_oncall" model="ir.actions.act_window">
        <field name="name">Incident On-Call Escalation</field>
        <field name="res_model">sf.incident_oncall</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
    <record id="view_sf_incident_oncall_form" model="ir.ui.view">
        <field name="name">sf.incident_oncall.form</field>
        <field name="model">sf.incident_oncall</field>
        <field name="arch" type="xml">
            <form string="Incident On-Call Escalation">
                <header>
                    <button name="action_submitted" type="object" string="Submitted"
                            class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="incident_type"/>
                            <field name="l1_user_id"/>
                            <field name="l2_user_id"/>
                            <field name="l3_user_id"/>
                            <field name="escalation_minutes"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_incident_oncall_list" model="ir.ui.view">
        <field name="name">sf.incident_oncall.list</field>
        <field name="model">sf.incident_oncall</field>
        <field name="arch" type="xml">
            <list string="Incident On-Call Escalation" sample="1">
                <field name="incident_type"/>
                <field name="l1_user_id"/>
                <field name="l2_user_id"/>
                <field name="l3_user_id"/>
                <field name="escalation_minutes"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state in ('submitted','approved')"/>
            </list>
        </field>
    </record>
    <record id="view_sf_incident_oncall_kanban" model="ir.ui.view">
        <field name="name">sf.incident_oncall.kanban</field>
        <field name="model">sf.incident_oncall</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_view" group_by="state">
                <field name="name"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <menuitem id="menu_sf_incident_oncall_root" name="Incident On-Call Escalation" sequence="29"
              web_icon="sf_incident_oncall,static/description/icon.png"/>
    <menuitem id="menu_sf_incident_oncall_main" name="Records"
              parent="menu_sf_incident_oncall_root" action="action_sf_incident_oncall" sequence="10"/>
</odoo>
