<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_fixed_assets" model="ir.module.category">
        <field name="name">Fixed Assets</field>
        <field name="sequence">90</field>
    </record>

    <record id="group_fixed_assets_user" model="res.groups">
        <field name="name">Fixed Assets User</field>
        <field name="category_id" ref="module_category_fixed_assets"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_fixed_assets_manager" model="res.groups">
        <field name="name">Fixed Assets Manager</field>
        <field name="category_id" ref="module_category_fixed_assets"/>
        <field name="implied_ids" eval="[(4, ref('group_fixed_assets_user'))]"/>
    </record>
</odoo>