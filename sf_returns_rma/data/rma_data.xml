<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="seq_rma_request" model="ir.sequence">
        <field name="name">RMA Request</field>
        <field name="code">rma.request</field>
        <field name="prefix">RMA-</field>
        <field name="padding">5</field>
    </record>
    <record id="seq_rma_label" model="ir.sequence">
        <field name="name">RMA Carrier Label</field>
        <field name="code">rma.carrier.label</field>
        <field name="prefix">RML-</field>
        <field name="padding">5</field>
    </record>

    <record id="rma_channel_ecommerce" model="rma.channel.config">
        <field name="name">eCommerce</field>
        <field name="code">ecommerce</field>
        <field name="policy_days">30</field>
    </record>
    <record id="rma_channel_pos" model="rma.channel.config">
        <field name="name">POS</field>
        <field name="code">pos</field>
        <field name="policy_days">14</field>
    </record>
    <record id="rma_channel_b2b" model="rma.channel.config">
        <field name="name">B2B</field>
        <field name="code">b2b</field>
        <field name="policy_days">60</field>
    </record>

    <record id="rma_reason_defective" model="rma.reason.config">
        <field name="name">Defective</field>
        <field name="code">defective</field>
        <field name="requires_inspection">True</field>
    </record>
    <record id="rma_reason_wrong" model="rma.reason.config">
        <field name="name">Wrong Item</field>
        <field name="code">wrong_item</field>
        <field name="requires_inspection">True</field>
    </record>
    <record id="rma_reason_damaged" model="rma.reason.config">
        <field name="name">Damaged in Transit</field>
        <field name="code">damaged</field>
        <field name="requires_inspection">True</field>
    </record>
</odoo>