<odoo>
    <record id="action_rma_request" model="ir.actions.act_window">
        <field name="name">RMA Requests</field>
        <field name="res_model">rma.request</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{'search_default_group_by_state': 1}</field>
    </record>
    <record id="action_rma_inspection" model="ir.actions.act_window">
        <field name="name">Inspections</field>
        <field name="res_model">rma.inspection</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_rma_disposition" model="ir.actions.act_window">
        <field name="name">Dispositions</field>
        <field name="res_model">rma.disposition</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_rma_rule" model="ir.actions.act_window">
        <field name="name">Auto-Approval Rules</field>
        <field name="res_model">rma.rule</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_rma_channel" model="ir.actions.act_window">
        <field name="name">Channels</field>
        <field name="res_model">rma.channel.config</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_rma_reason" model="ir.actions.act_window">
        <field name="name">Reasons</field>
        <field name="res_model">rma.reason.config</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_rma_carrier_label" model="ir.actions.act_window">
        <field name="name">Carrier Labels</field>
        <field name="res_model">rma.carrier.label</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_rma_request_form" model="ir.ui.view">
        <field name="name">rma.request.form</field>
        <field name="model">rma.request</field>
        <field name="arch" type="xml">
            <form string="RMA Request">
                <header>
                    <button name="action_submit" type="object" string="Submit" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_approve" type="object" string="Approve" class="btn-secondary" invisible="state not in ('submitted','draft')"/>
                    <button name="action_reject" type="object" string="Reject" class="btn-secondary" invisible="state not in ('submitted','draft')"/>
                    <button name="action_generate_label" type="object" string="Generate Label" class="btn-secondary" invisible="carrier_label_id or not rule_id"/>
                    <button name="action_receive" type="object" string="Receive" class="btn-secondary" invisible="state not in ('approved','submitted')"/>
                    <button name="action_inspect" type="object" string="Inspect" class="btn-secondary" invisible="state != 'received'"/>
                    <button name="action_close" type="object" string="Close" class="btn-primary" invisible="state not in ('dispositioned','inspected')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,approved,received,inspected,dispositioned,closed"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="channel"/>
                            <field name="partner_id"/>
                            <field name="sale_order_id" invisible="channel == 'pos'"/>
                            <field name="pos_order_id" invisible="channel != 'pos'"/>
                            <field name="reason"/>
                        </group>
                        <group>
                            <field name="requested_date"/>
                            <field name="approved_date" readonly="1"/>
                            <field name="received_date" readonly="1"/>
                            <field name="auto_approved" readonly="1"/>
                            <field name="rule_id" readonly="1"/>
                        </group>
                    </group>
                    <group string="Details">
                        <field name="reason_description"/>
                    </group>
                    <group string="Return Lines">
                        <field name="line_ids">
                            <list editable="bottom">
                                <field name="product_id"/>
                                <field name="original_qty"/>
                                <field name="quantity"/>
                                <field name="uom_id"/>
                                <field name="unit_price"/>
                                <field name="refund_amount" readonly="1"/>
                                <field name="condition"/>
                            </list>
                        </field>
                    </group>
                    <group>
                        <group>
                            <field name="total_qty" readonly="1"/>
                            <field name="total_refund" readonly="1"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group string="Process References">
                            <field name="carrier_label_id"/>
                            <field name="inspection_id"/>
                            <field name="disposition_id"/>
                        </group>
                    </group>
                    <group invisible="1">
                        <field name="company_id"/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_rma_request_list" model="ir.ui.view">
        <field name="name">rma.request.list</field>
        <field name="model">rma.request</field>
        <field name="arch" type="xml">
            <list string="RMA Requests">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="channel"/>
                <field name="reason"/>
                <field name="state"/>
                <field name="total_qty"/>
                <field name="total_refund"/>
                <field name="create_date"/>
            </list>
        </field>
    </record>

    <record id="view_rma_inspection_form" model="ir.ui.view">
        <field name="name">rma.inspection.form</field>
        <field name="model">rma.inspection</field>
        <field name="arch" type="xml">
            <form string="RMA Inspection">
                <header>
                    <button name="action_complete" type="object" string="Complete" class="btn-primary" invisible="state == 'done'"/>
                    <field name="state" widget="statusbar" statusbar_visible="pending,in_progress,done"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="rma_id"/>
                            <field name="inspector_id"/>
                            <field name="inspection_date"/>
                        </group>
                        <group>
                            <field name="overall_condition"/>
                            <field name="disposition_recommendation"/>
                        </group>
                    </group>
                    <group string="Inspection Lines">
                        <field name="line_ids">
                            <list editable="bottom">
                                <field name="rma_line_id"/>
                                <field name="product_id" readonly="1"/>
                                <field name="condition"/>
                                <field name="working"/>
                                <field name="missing_accessories"/>
                                <field name="packaging_intact"/>
                                <field name="notes"/>
                            </list>
                        </field>
                    </group>
                    <group string="Notes">
                        <field name="notes"/>
                    </group>
                    <group string="Photos">
                        <field name="photos" widget="many2many_binary"/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_rma_inspection_list" model="ir.ui.view">
        <field name="name">rma.inspection.list</field>
        <field name="model">rma.inspection</field>
        <field name="arch" type="xml">
            <list string="RMA Inspections">
                <field name="rma_id"/>
                <field name="inspector_id"/>
                <field name="inspection_date"/>
                <field name="overall_condition"/>
                <field name="disposition_recommendation"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_rma_disposition_form" model="ir.ui.view">
        <field name="name">rma.disposition.form</field>
        <field name="model">rma.disposition</field>
        <field name="arch" type="xml">
            <form string="RMA Disposition">
                <header>
                    <button name="action_execute" type="object" string="Execute" class="btn-primary" invisible="state == 'done'"/>
                    <field name="state" widget="statusbar" statusbar_visible="planned,in_progress,done,cancelled"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="rma_id"/>
                            <field name="inspection_id"/>
                            <field name="action"/>
                        </group>
                        <group string="Restock" invisible="action not in ('restock','repack')">
                            <field name="warehouse_id"/>
                            <field name="location_id"/>
                        </group>
                    </group>
                    <group string="Repair" invisible="action != 'repair'">
                        <field name="repair_order_id"/>
                    </group>
                    <group string="Refurbish" invisible="action != 'refurbish'">
                        <field name="refurbish_cost"/>
                        <field name="new_sale_price"/>
                    </group>
                    <group string="Scrap" invisible="action != 'scrap'">
                        <field name="scrap_reason"/>
                    </group>
                    <group string="Return to Vendor" invisible="action != 'return_vendor'">
                        <field name="vendor_rma_id"/>
                    </group>
                    <group string="Notes">
                        <field name="notes"/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_rma_disposition_list" model="ir.ui.view">
        <field name="name">rma.disposition.list</field>
        <field name="model">rma.disposition</field>
        <field name="arch" type="xml">
            <list string="RMA Dispositions">
                <field name="rma_id"/>
                <field name="action"/>
                <field name="state"/>
                <field name="create_date"/>
            </list>
        </field>
    </record>

    <record id="view_rma_rule_form" model="ir.ui.view">
        <field name="name">rma.rule.form</field>
        <field name="model">rma.rule</field>
        <field name="arch" type="xml">
            <form string="RMA Auto-Approval Rule">
                <sheet>
                    <div class="oe_button_box">
                        <button name="toggle_active" type="object" class="oe_stat_button" icon="fa-power-off">
                            <field name="active" widget="boolean_toggle" options="{'terminology': {'on': 'Active', 'off': 'Inactive'}}"/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="sequence"/>
                        </group>
                        <group string="Actions">
                            <field name="auto_approve"/>
                            <field name="generate_label"/>
                            <field name="carrier_id"/>
                            <field name="refund_type"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Conditions" name="conditions">
                            <group>
                                <group string="Channels">
                                    <field name="channel_ids" widget="many2many_tags"/>
                                    <field name="country_ids" widget="many2many_tags"/>
                                </group>
                                <group string="Products">
                                    <field name="product_ids" widget="many2many_tags"/>
                                    <field name="category_ids" widget="many2many_tags"/>
                                </group>
                            </group>
                            <group>
                                <group string="Customers">
                                    <field name="partner_ids" widget="many2many_tags"/>
                                    <field name="partner_category_ids" widget="many2many_tags"/>
                                </group>
                                <group string="Value">
                                    <field name="min_amount"/>
                                    <field name="max_amount"/>
                                    <field name="currency_id"/>
                                </group>
                            </group>
                            <group>
                                <group string="Reasons">
                                    <field name="reason_ids" widget="many2many_tags"/>
                                </group>
                                <group string="Time">
                                    <field name="days_from_sale"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_rma_rule_list" model="ir.ui.view">
        <field name="name">rma.rule.list</field>
        <field name="model">rma.rule</field>
        <field name="arch" type="xml">
            <list string="RMA Auto-Approval Rules">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="auto_approve" widget="boolean"/>
                <field name="generate_label" widget="boolean"/>
                <field name="refund_type"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_rma_channel_form" model="ir.ui.view">
        <field name="name">rma.channel.config.form</field>
        <field name="model">rma.channel.config</field>
        <field name="arch" type="xml">
            <form string="RMA Channel">
                <group>
                    <field name="name"/>
                    <field name="code"/>
                    <field name="policy_days"/>
                    <field name="auto_approve_default"/>
                    <field name="active"/>
                </group>
            </form>
        </field>
    </record>
    <record id="view_rma_channel_list" model="ir.ui.view">
        <field name="name">rma.channel.config.list</field>
        <field name="model">rma.channel.config</field>
        <field name="arch" type="xml">
            <list string="RMA Channels">
                <field name="name"/>
                <field name="code"/>
                <field name="policy_days"/>
                <field name="auto_approve_default" widget="boolean"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_rma_reason_form" model="ir.ui.view">
        <field name="name">rma.reason.config.form</field>
        <field name="model">rma.reason.config</field>
        <field name="arch" type="xml">
            <form string="RMA Reason">
                <group>
                    <field name="name"/>
                    <field name="code"/>
                    <field name="requires_inspection"/>
                    <field name="active"/>
                </group>
            </form>
        </field>
    </record>
    <record id="view_rma_reason_list" model="ir.ui.view">
        <field name="name">rma.reason.config.list</field>
        <field name="model">rma.reason.config</field>
        <field name="arch" type="xml">
            <list string="RMA Reasons">
                <field name="name"/>
                <field name="code"/>
                <field name="requires_inspection" widget="boolean"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_rma_carrier_label_form" model="ir.ui.view">
        <field name="name">rma.carrier.label.form</field>
        <field name="model">rma.carrier.label</field>
        <field name="arch" type="xml">
            <form string="Carrier Label">
                <header>
                    <button name="action_generate" type="object" string="Generate" class="btn-primary" invisible="state != 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,generated,printed,shipped,delivered"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="rma_id"/>
                            <field name="carrier_id"/>
                            <field name="tracking_number" readonly="1"/>
                        </group>
                        <group>
                            <field name="label_file" filename="label_filename"/>
                            <field name="label_filename" invisible="1"/>
                            <field name="cost"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_rma_carrier_label_list" model="ir.ui.view">
        <field name="name">rma.carrier.label.list</field>
        <field name="model">rma.carrier.label</field>
        <field name="arch" type="xml">
            <list string="Carrier Labels">
                <field name="rma_id"/>
                <field name="carrier_id"/>
                <field name="tracking_number"/>
                <field name="state"/>
                <field name="cost"/>
            </list>
        </field>
    </record>

    <menuitem id="menu_rma_root" name="Returns &amp; RMA" sequence="50" web_icon="sf_returns_rma,static/description/icon.png"/>
    <menuitem id="menu_rma_requests" name="RMA Requests" parent="menu_rma_root" action="action_rma_request" sequence="10"/>
    <menuitem id="menu_rma_inspections" name="Inspections" parent="menu_rma_root" action="action_rma_inspection" sequence="20"/>
    <menuitem id="menu_rma_dispositions" name="Dispositions" parent="menu_rma_root" action="action_rma_disposition" sequence="30"/>
    <menuitem id="menu_rma_labels" name="Carrier Labels" parent="menu_rma_root" action="action_rma_carrier_label" sequence="40"/>
    <menuitem id="menu_rma_settings" name="Settings" parent="menu_rma_root" sequence="50">
        <menuitem id="menu_rma_rules" name="Auto-Approval Rules" parent="menu_rma_settings" action="action_rma_rule" sequence="10"/>
        <menuitem id="menu_rma_channels" name="Channels" parent="menu_rma_settings" action="action_rma_channel" sequence="20"/>
        <menuitem id="menu_rma_reasons" name="Reasons" parent="menu_rma_settings" action="action_rma_reason" sequence="30"/>
    </menuitem>

    <record id="view_sf_returns_rma_boost_kanban" model="ir.ui.view">
        <field name="name">sf_returns_rma.boost.kanban</field>
        <field name="model">rma.disposition</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" t-att-color="state">
                <field name="name"/>
                <field name="state"/>
                <field name="user_id"/>

                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_card oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title">
                                    <field name="name"/></strong>
                                <div class="o_kanban_record_subtitle">
                                    <field name="user_id" widget="many2one_avatar_user"/>
                                    <field name="create_date"/></div>
                            </div>
                            <div class="oe_kanban_bottom_right">
                                <field name="state" widget="badge"
                                       t-attf-options="{'classes_map': {'draft': 'info', 'done': 'success', 'cancelled': 'danger'}, 'domain': []}"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_sf_returns_rma_boost_search" model="ir.ui.view">
        <field name="name">sf_returns_rma.boost.search</field>
        <field name="model">rma.disposition</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
<separator/>
                <filter string="My records" name="my_records" domain="[('user_id', '=', uid)]"/>
                <filter string="To Do" name="todo" domain="[('state', 'not in', ('done', 'cancelled', 'closed'))]"/>
                <group expand="0" string="Group By"><filter string="Status" name="gb_state" context="{'group_by': 'state'}"/></group>
            </search>
        </field>
    </record>

    <record id="wave_final_sf_returns_rma" model="ir.actions.server">
        <field name="name">Refresh Business Data</field>
        <field name="model_id" ref="model_rma_disposition"/>
        <field name="binding_model_id" ref="model_rma_disposition"/>
        <field name="state">code</field>
        <field name="code">records.action_refresh_business()</field>
    </record>
</odoo>
