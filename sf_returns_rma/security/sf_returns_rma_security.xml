<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_sf_returns_rma" model="ir.module.category">
        <field name="name">Returns Rma</field>
        <field name="description">Returns Rma Management</field>
        <field name="sequence">10</field>
    </record>

    <record id="group_sf_returns_rma_user" model="res.groups">
        <field name="name">Returns Rma / User</field>
        <field name="category_id" ref="module_category_sf_returns_rma"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_sf_returns_rma_manager" model="res.groups">
        <field name="name">Returns Rma / Manager</field>
        <field name="category_id" ref="module_category_sf_returns_rma"/>
        <field name="implied_ids" eval="[(4, ref('sf_returns_rma.group_sf_returns_rma_user'))]"/>
    </record>

    <record id="rule_sf_returns_rma_company" model="ir.rule">
        <field name="name">Returns Rma: user sees own company</field>
        <field name="model_id" ref="model_sf_returns_rma"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('sf_returns_rma.group_sf_returns_rma_user'))]"/>
    </record>
    <record id="rule_sf_returns_rma_manager_all" model="ir.rule">
        <field name="name">Returns Rma: manager sees all companies</field>
        <field name="model_id" ref="model_sf_returns_rma"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('sf_returns_rma.group_sf_returns_rma_manager'))]"/>
    </record>
    <record id="group_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="module_category_sf_returns_rma"/>
    </record>
    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_sf_returns_rma"/>
    </record>
    <record id="group_system" model="res.groups">
        <field name="name">System</field>
        <field name="category_id" ref="module_category_sf_returns_rma"/>
    </record>
</odoo>