<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_quality_inspection_mobile2" model="ir.module.category">
        <field name="name">Mobile Quality Inspection Config</field>
        <field name="sequence">684</field>
    </record>
    <record id="group_quality_inspection_mobile2_user" model="res.groups">
        <field name="name">Mobile Quality Inspection Config User</field>
        <field name="category_id" ref="module_category_quality_inspection_mobile2"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>

    </record>
    <record id="group_quality_inspection_mobile2_manager" model="res.groups">
        <field name="name">Mobile Quality Inspection Config Manager</field>
        <field name="category_id" ref="module_category_quality_inspection_mobile2"/>
        <field name="implied_ids" eval="[(4, ref('group_quality_inspection_mobile2_user'))]"/>
    </record>
    <record id="rule_quality_inspection_mobile2_sf_quality_inspection_mobile2" model="ir.rule">
        <field name="name">Mobile Quality Inspection Config: multi-company</field>
        <field name="model_id" ref="model_sf_quality_inspection_mobile2"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
