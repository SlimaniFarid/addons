<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_sf_pc" model="ir.module.category">
        <field name="name">Price Change Management</field>
        <field name="sequence">75</field>
    </record>
    <record id="group_sf_pc_user" model="res.groups">
        <field name="name">Price Change User</field>
        <field name="category_id" ref="module_category_sf_pc"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
    </record>
    <record id="group_sf_pc_manager" model="res.groups">
        <field name="name">Price Change Manager</field>
        <field name="category_id" ref="module_category_sf_pc"/>
        <field name="implied_ids" eval="[(4, ref('group_sf_pc_user'))]"/>
    </record>
    <record id="rule_sf_pc_company" model="ir.rule">
        <field name="name">Price Change: multi-company</field>
        <field name="model_id" ref="model_sf_price_change"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_sf_pc"/>
    </record>
</odoo>
