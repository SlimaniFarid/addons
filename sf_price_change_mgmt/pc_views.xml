<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_price_change" model="ir.actions.act_window">
        <field name="name">Price Changes</field>
        <field name="res_model">sf.price.change</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
    <record id="view_sf_price_change_form" model="ir.ui.view">
        <field name="name">sf.price.change.form</field>
        <field name="model">sf.price.change</field>
        <field name="arch" type="xml">
            <form string="Price Change">
                <header>
                    <button name="action_announce" type="object"
                            string="Announce" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_apply" type="object"
                            string="Apply Prices" class="btn-success"
                            invisible="state != 'announced'"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state in ('applied','cancelled')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,announced,applied"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="reason"/>
                            <field name="announcement_date"/>
                            <field name="effective_date"/>
                        </group>
                        <group>
                            <field name="line_count" readonly="1"/>
                            <field name="avg_delta" readonly="1"/>
                            <field name="applied_date" readonly="1"/>
                            <field name="company_id"
                                   groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <field name="line_ids" readonly="state in ('applied','cancelled')">
                        <list editable="bottom">
                            <field name="product_id"/>
                            <field name="old_price" readonly="1"/>
                            <field name="new_price"/>
                            <field name="delta_percent" readonly="1"/>
                        </list>
                    </field>
                    <group string="Notes">
                        <field name="notes"/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_price_change_list" model="ir.ui.view">
        <field name="name">sf.price.change.list</field>
        <field name="model">sf.price.change</field>
        <field name="arch" type="xml">
            <list string="Price Changes" sample="1">
                <field name="name"/>
                <field name="reason"/>
                <field name="effective_date"/>
                <field name="line_count"/>
                <field name="avg_delta"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'applied'"/>
            </list>
        </field>
    </record>
    <menuitem id="menu_sf_pc_root" name="Price Changes" sequence="25"
              parent="sale.sale_menu_root"/>
    <menuitem id="menu_sf_pc_changes" name="Price Change Campaigns"
              parent="menu_sf_pc_root" action="action_sf_price_change"
              sequence="10"/>
</odoo>
