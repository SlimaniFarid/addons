<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_price_change" model="ir.actions.act_window">
        <field name="name">Price Changes</field>
        <field name="res_model">sf.price.change</field>
        <field name="view_mode">kanban,list,form,kanban</field>
    </record>
    <record id="view_sf_price_change_form" model="ir.ui.view">
        <field name="name">sf.price.change.form</field>
        <field name="model">sf.price.change</field>
        <field name="arch" type="xml">
            <form string="Price Change">
                <header>
                    <button name="action_announce" type="object"
                            string="Announce" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_apply" type="object"
                            string="Apply Prices" class="btn-success"
                            invisible="state != 'announced'"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state in ('applied','cancelled')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,announced,applied"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="reason"/>
                            <field name="announcement_date"/>
                            <field name="effective_date"/>
                        </group>
                        <group>
                            <field name="line_count" readonly="1"/>
                            <field name="avg_delta" readonly="1"/>
                            <field name="applied_date" readonly="1"/>
                            <field name="company_id"
                                   groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <field name="line_ids" readonly="state in ('applied','cancelled')">
                        <list editable="bottom">
                            <field name="product_id"/>
                            <field name="old_price" readonly="1"/>
                            <field name="new_price"/>
                            <field name="delta_percent" readonly="1"/>
                        </list>
                    </field>
                    <group string="Notes">
                        <field name="notes"/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_price_change_list" model="ir.ui.view">
        <field name="name">sf.price.change.list</field>
        <field name="model">sf.price.change</field>
        <field name="arch" type="xml">
            <list string="Price Changes" sample="1">
                <field name="name"/>
                <field name="reason"/>
                <field name="effective_date"/>
                <field name="line_count"/>
                <field name="avg_delta"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'applied'"/>
            </list>
        </field>
    </record>
    <menuitem id="menu_sf_pc_root" name="Price Changes" sequence="25"
              parent="sale.sale_menu_root"/>
    <menuitem id="menu_sf_pc_changes" name="Price Change Campaigns"
              parent="menu_sf_pc_root" action="action_sf_price_change"
              sequence="10"/>

    <record id="view_sf_price_change_mgmt_boost_kanban" model="ir.ui.view">
        <field name="name">sf_price_change_mgmt.boost.kanban</field>
        <field name="model">sf.price.change</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" t-att-color="state">
                <field name="name"/>
                <field name="state"/>
                <field name="user_id"/>

                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_card oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title">
                                    <field name="name"/></strong>
                                <div class="o_kanban_record_subtitle">
                                    <field name="user_id" widget="many2one_avatar_user"/>
                                    <field name="create_date"/></div>
                            </div>
                            <div class="oe_kanban_bottom_right">
                                <field name="state" widget="badge"
                                       t-attf-options="{'classes_map': {'draft': 'info', 'done': 'success', 'cancelled': 'danger'}, 'domain': []}"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_sf_price_change_mgmt_boost_search" model="ir.ui.view">
        <field name="name">sf_price_change_mgmt.boost.search</field>
        <field name="model">sf.price.change</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
<separator/>
                <filter string="My records" name="my_records" domain="[('user_id', '=', uid)]"/>
                <filter string="To Do" name="todo" domain="[('state', 'not in', ('done', 'cancelled', 'closed'))]"/>
                <group expand="0" string="Group By"><filter string="Status" name="gb_state" context="{'group_by': 'state'}"/></group>
            </search>
        </field>
    </record>

    <record id="wave_final_sf_price_change_mgmt" model="ir.actions.server">
        <field name="name">Refresh Business Data</field>
        <field name="model_id" ref="model_sf_price_change"/>
        <field name="binding_model_id" ref="model_sf_price_change"/>
        <field name="state">code</field>
        <field name="code">records.action_refresh_business()</field>
    </record>
</odoo>
