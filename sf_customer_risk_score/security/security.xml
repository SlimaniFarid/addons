<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_customer_risk_score" model="ir.module.category">
        <field name="name">Customer Concentration Risk</field>
        <field name="sequence">199</field>
    </record>
    <record id="group_customer_risk_score_user" model="res.groups">
        <field name="name">Customer Concentration Risk User</field>
        <field name="category_id" ref="module_category_customer_risk_score"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>

    </record>
    <record id="group_customer_risk_score_manager" model="res.groups">
        <field name="name">Customer Concentration Risk Manager</field>
        <field name="category_id" ref="module_category_customer_risk_score"/>
        <field name="implied_ids" eval="[(4, ref('group_customer_risk_score_user'))]"/>
    </record>
    <record id="rule_customer_risk_score_sf_customer_risk_score" model="ir.rule">
        <field name="name">Customer Concentration Risk: multi-company</field>
        <field name="model_id" ref="model_sf_customer_risk_score"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
