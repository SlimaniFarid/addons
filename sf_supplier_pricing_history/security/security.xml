<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_supplier_pricing_history" model="ir.module.category">
        <field name="name">Supplier Pricing History</field>
        <field name="sequence">678</field>
    </record>
    <record id="group_supplier_pricing_history_user" model="res.groups">
        <field name="name">Supplier Pricing History User</field>
        <field name="category_id" ref="module_category_supplier_pricing_history"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>

    </record>
    <record id="group_supplier_pricing_history_manager" model="res.groups">
        <field name="name">Supplier Pricing History Manager</field>
        <field name="category_id" ref="module_category_supplier_pricing_history"/>
        <field name="implied_ids" eval="[(4, ref('group_supplier_pricing_history_user'))]"/>
    </record>
    <record id="rule_supplier_pricing_history_sf_supplier_pricing_history" model="ir.rule">
        <field name="name">Supplier Pricing History: multi-company</field>
        <field name="model_id" ref="model_sf_supplier_pricing_history"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
