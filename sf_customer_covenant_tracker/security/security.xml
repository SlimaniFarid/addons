<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_customer_covenant_tracker" model="ir.module.category">
        <field name="name">Customer Contract Covenant Tracker</field>
        <field name="sequence">185</field>
    </record>
    <record id="group_customer_covenant_tracker_user" model="res.groups">
        <field name="name">Customer Contract Covenant Tracker User</field>
        <field name="category_id" ref="module_category_customer_covenant_tracker"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>

    </record>
    <record id="group_customer_covenant_tracker_manager" model="res.groups">
        <field name="name">Customer Contract Covenant Tracker Manager</field>
        <field name="category_id" ref="module_category_customer_covenant_tracker"/>
        <field name="implied_ids" eval="[(4, ref('group_customer_covenant_tracker_user'))]"/>
    </record>
    <record id="rule_customer_covenant_tracker_sf_customer_covenant_tracker" model="ir.rule">
        <field name="name">Customer Contract Covenant Tracker: multi-company</field>
        <field name="model_id" ref="model_sf_customer_covenant_tracker"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_customer_covenant_tracker"/>
    </record>
</odoo>
