<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_business_glossary" model="ir.module.category">
        <field name="name">Business Glossary &amp; Data Dictionary</field>
        <field name="sequence">62</field>
    </record>
    <record id="group_business_glossary_user" model="res.groups">
        <field name="name">Business Glossary &amp; Data Dictionary User</field>
        <field name="category_id" ref="module_category_business_glossary"/>

    </record>
    <record id="group_business_glossary_manager" model="res.groups">
        <field name="name">Business Glossary &amp; Data Dictionary Manager</field>
        <field name="category_id" ref="module_category_business_glossary"/>
        <field name="implied_ids" eval="[(4, ref('group_business_glossary_user'))]"/>
    </record>
    <record id="rule_business_glossary_sf_glossary_term" model="ir.rule">
        <field name="name">Glossary Term: multi-company</field>
        <field name="model_id" ref="model_sf_glossary_term"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_business_glossary"/>
    </record>
</odoo>
