<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_glossary_term" model="ir.actions.act_window">
        <field name="name">Business Glossary &amp; Data Dictionary</field>
        <field name="res_model">sf.glossary.term</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
    <record id="view_sf_glossary_term_form" model="ir.ui.view">
        <field name="name">sf.glossary.term.form</field>
        <field name="model">sf.glossary.term</field>
        <field name="arch" type="xml">
            <form string="Business Glossary &amp; Data Dictionary">
                <header>
                    <button name="action_approved" type="object" string="Approved"
                            class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,approved,deprecated"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="term"/>
                        <field name="definition"/>
                            <field name="source_system"/>
                            <field name="owner_id"/>
                            <field name="related_kpis"/>
                            <field name="status"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_glossary_term_list" model="ir.ui.view">
        <field name="name">sf.glossary.term.list</field>
        <field name="model">sf.glossary.term</field>
        <field name="arch" type="xml">
            <list string="Business Glossary &amp; Data Dictionary" sample="1">
                <field name="term"/>
                <field name="definition"/>
                <field name="source_system"/>
                <field name="owner_id"/>
                <field name="related_kpis"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state in ('submitted','approved')"/>
            </list>
        </field>
    </record>
    <record id="view_sf_glossary_term_kanban" model="ir.ui.view">
        <field name="name">sf.glossary.term.kanban</field>
        <field name="model">sf.glossary.term</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_view" group_by="state">
                <field name="name"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <menuitem id="menu_sf_glossary_term_root" name="Business Glossary &amp; Data Dictionary" sequence="12"
              web_icon="sf_business_glossary,static/description/icon.png"/>
    <menuitem id="menu_sf_glossary_term_main" name="Records"
              parent="menu_sf_glossary_term_root" action="action_sf_glossary_term" sequence="10"/>
</odoo>
