<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_customer_journey_mapper" model="ir.actions.act_window">
        <field name="name">Customer Journey Mapper</field>
        <field name="res_model">sf.customer_journey_mapper</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
    <record id="view_sf_customer_journey_mapper_form" model="ir.ui.view">
        <field name="name">sf.customer_journey_mapper.form</field>
        <field name="model">sf.customer_journey_mapper</field>
        <field name="arch" type="xml">
            <form string="Customer Journey Mapper">
                <header>
                    <button name="action_submitted" type="object" string="Submitted"
                            class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="journey_stage"/>
                            <field name="experience_score"/>
                            <field name="pain_points"/>
                            <field name="improvement"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_customer_journey_mapper_list" model="ir.ui.view">
        <field name="name">sf.customer_journey_mapper.list</field>
        <field name="model">sf.customer_journey_mapper</field>
        <field name="arch" type="xml">
            <list string="Customer Journey Mapper" sample="1">
                <field name="partner_id"/>
                <field name="journey_stage"/>
                <field name="experience_score"/>
                <field name="pain_points"/>
                <field name="improvement"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state in ('submitted','approved')"/>
            </list>
        </field>
    </record>
    <record id="view_sf_customer_journey_mapper_kanban" model="ir.ui.view">
        <field name="name">sf.customer_journey_mapper.kanban</field>
        <field name="model">sf.customer_journey_mapper</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_view" group_by="state">
                <field name="name"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <menuitem id="menu_sf_customer_journey_mapper_root" name="Customer Journey Mapper" sequence="8"
              web_icon="sf_customer_journey_mapper,static/description/icon.png"/>
    <menuitem id="menu_sf_customer_journey_mapper_main" name="Records"
              parent="menu_sf_customer_journey_mapper_root" action="action_sf_customer_journey_mapper" sequence="10"/>

    <record id="wave_final_sf_customer_journey_mapper" model="ir.actions.server">
        <field name="name">Refresh Business Data</field>
        <field name="model_id" ref="model_sf_customer_journey_mapper"/>
        <field name="binding_model_id" ref="model_sf_customer_journey_mapper"/>
        <field name="state">code</field>
        <field name="code">records.action_refresh_business()</field>
    </record>
</odoo>
