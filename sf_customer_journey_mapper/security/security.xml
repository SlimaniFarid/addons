<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_customer_journey_mapper" model="ir.module.category">
        <field name="name">Customer Journey Mapper</field>
        <field name="sequence">493</field>
    </record>
    <record id="group_customer_journey_mapper_user" model="res.groups">
        <field name="name">Customer Journey Mapper User</field>
        <field name="category_id" ref="module_category_customer_journey_mapper"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>

    </record>
    <record id="group_customer_journey_mapper_manager" model="res.groups">
        <field name="name">Customer Journey Mapper Manager</field>
        <field name="category_id" ref="module_category_customer_journey_mapper"/>
        <field name="implied_ids" eval="[(4, ref('group_customer_journey_mapper_user'))]"/>
    </record>
    <record id="rule_customer_journey_mapper_sf_customer_journey_mapper" model="ir.rule">
        <field name="name">Customer Journey Mapper: multi-company</field>
        <field name="model_id" ref="model_sf_customer_journey_mapper"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_customer_journey_mapper"/>
    </record>
</odoo>
