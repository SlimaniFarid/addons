<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="report_waste_register" model="ir.actions.report">
        <field name="name">Waste Register</field>
        <field name="model">sf.waste.bsd</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">sf_waste_management.waste_register_template</field>
        <field name="report_file">sf_waste_management.waste_register_template</field>
        <field name="binding_model_id" ref="model_sf_waste_bsd"/>
        <field name="binding_type">report</field>
    </record>

    <template id="waste_register_template">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="page">
                    <h2>Waste Register</h2>
                    <p>Printed on <t t-esc="datetime.now().strftime('%Y-%m-%d')"/></p>
                    <table class="table table-sm">
                        <thead>
                            <tr>
                                <th>Number</th>
                                <th>Site</th>
                                <th>Waste code</th>
                                <th class="text-right">Quantity (kg)</th>
                                <th>Collector</th>
                                <th>Destination</th>
                                <th>Emission</th>
                                <th>Reception</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="docs" t-as="o">
                                <tr>
                                    <td><t t-esc="o.name"/></td>
                                    <td><t t-esc="o.site_id.name"/></td>
                                    <td><t t-esc="o.waste_code_id.name"/></td>
                                    <td class="text-right"><t t-esc="o.quantity_kg"/></td>
                                    <td><t t-esc="o.collector_id.name or ''"/></td>
                                    <td><t t-esc="o.destination_id.name or ''"/></td>
                                    <td><t t-esc="o.emit_date or ''"/></td>
                                    <td><t t-esc="o.reception_date or ''"/></td>
                                    <td><t t-esc="o.state"/></td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </div>
            </t>
        </t>
    </template>

</odoo>