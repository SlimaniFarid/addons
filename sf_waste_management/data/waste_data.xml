<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_waste_bsd" model="ir.sequence">
            <field name="name">Waste BSD</field>
            <field name="code">sf.waste.bsd</field>
            <field name="prefix"></field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>

        <record id="waste_code_dn" model="sf.waste.code">
            <field name="name">DND</field>
            <field name="description">Non-hazardous industrial waste</field>
            <field name="hazardous">False</field>
            <field name="category">Industrial</field>
        </record>
        <record id="waste_code_odi" model="sf.waste.code">
            <field name="name">ODI</field>
            <field name="description">Hazardous industrial waste</field>
            <field name="hazardous">True</field>
            <field name="category">Industrial</field>
        </record>
        <record id="waste_code_deee" model="sf.waste.code">
            <field name="name">DEEE</field>
            <field name="description">Waste electrical and electronic equipment</field>
            <field name="hazardous">True</field>
            <field name="category">Electrical</field>
        </record>
        <record id="waste_code_carton" model="sf.waste.code">
            <field name="name">CARTON</field>
            <field name="description">Cardboard and paper packaging</field>
            <field name="hazardous">False</field>
            <field name="category">Packaging</field>
        </record>

        <record id="cron_waste_reception_overdue" model="ir.cron">
            <field name="name">Waste: BSD reception overdue</field>
            <field name="model_id" ref="model_sf_waste_bsd"/>
            <field name="state">code</field>
            <field name="code">model._check_reception_overdue()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="active">True</field>
        </record>
    </data>
</odoo>