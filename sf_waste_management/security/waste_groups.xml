<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_waste" model="ir.module.category">
        <field name="name">Waste</field>
        <field name="sequence">12</field>
    </record>

    <record id="group_waste_user" model="res.groups">
        <field name="name">Waste Management / User</field>
        <field name="category_id" ref="module_category_waste"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_waste_manager" model="res.groups">
        <field name="name">Waste Management / Manager</field>
        <field name="category_id" ref="module_category_waste"/>
        <field name="implied_ids" eval="[(4, ref('group_waste_user'))]"/>
    </record>
</odoo>