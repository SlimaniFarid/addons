<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="ir_rule_bsd_company" model="ir.rule">
            <field name="name">BSD: company</field>
            <field name="model_id" ref="model_sf_waste_bsd"/>
            <field name="global" eval="True"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('sf_waste_management.group_waste_user'))]"/>
        </record>

        <record id="ir_rule_bsd_manager_all" model="ir.rule">
            <field name="name">BSD: manager all companies</field>
            <field name="model_id" ref="model_sf_waste_bsd"/>
            <field name="global" eval="True"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('sf_waste_management.group_waste_manager'))]"/>
        </record>

        <record id="ir_rule_site_company" model="ir.rule">
            <field name="name">Waste site: company</field>
            <field name="model_id" ref="model_sf_waste_site"/>
            <field name="global" eval="True"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('sf_waste_management.group_waste_user'))]"/>
        </record>

        <record id="ir_rule_site_manager_all" model="ir.rule">
            <field name="name">Waste site: manager all companies</field>
            <field name="model_id" ref="model_sf_waste_site"/>
            <field name="global" eval="True"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('sf_waste_management.group_waste_manager'))]"/>
        </record>
    </data>
    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
    </record>
    <record id="group_waste_manager" model="res.groups">
        <field name="name">Waste Manager</field>
    </record>
    <record id="group_waste_user" model="res.groups">
        <field name="name">Waste User</field>
    </record>
</odoo>