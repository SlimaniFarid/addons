<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_customer_revenue_trend" model="ir.module.category">
        <field name="name">Customer Revenue Trend Alerts</field>
        <field name="sequence">31</field>
    </record>
    <record id="group_customer_revenue_trend_user" model="res.groups">
        <field name="name">Customer Revenue Trend Alerts User</field>
        <field name="category_id" ref="module_category_customer_revenue_trend"/>

    </record>
    <record id="group_customer_revenue_trend_manager" model="res.groups">
        <field name="name">Customer Revenue Trend Alerts Manager</field>
        <field name="category_id" ref="module_category_customer_revenue_trend"/>
        <field name="implied_ids" eval="[(4, ref('group_customer_revenue_trend_user'))]"/>
    </record>
    <record id="rule_customer_revenue_trend_sf_revenue_trend" model="ir.rule">
        <field name="name">Revenue Trend Check: multi-company</field>
        <field name="model_id" ref="model_sf_revenue_trend"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_customer_revenue_trend"/>
    </record>
</odoo>
