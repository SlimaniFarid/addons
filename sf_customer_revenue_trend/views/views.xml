<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_revenue_trend" model="ir.actions.act_window">
        <field name="name">Customer Revenue Trend Alerts</field>
        <field name="res_model">sf.revenue.trend</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
    <record id="view_sf_revenue_trend_form" model="ir.ui.view">
        <field name="name">sf.revenue.trend.form</field>
        <field name="model">sf.revenue.trend</field>
        <field name="arch" type="xml">
            <form string="Customer Revenue Trend Alerts">
                <header>
                    <button name="action_contacted" type="object" string="Contacted"
                            class="btn-primary"/>
                    <button name="action_recovered" type="object" string="Recovered"
                            class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="detected,contacted,recovered,lost"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="period_current"/>
                            <field name="revenue_current"/>
                            <field name="revenue_previous"/>
                            <field name="drop_percent"/>
                            <field name="action_taken"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_revenue_trend_list" model="ir.ui.view">
        <field name="name">sf.revenue.trend.list</field>
        <field name="model">sf.revenue.trend</field>
        <field name="arch" type="xml">
            <list string="Customer Revenue Trend Alerts" sample="1">
                <field name="partner_id"/>
                <field name="period_current"/>
                <field name="revenue_current"/>
                <field name="revenue_previous"/>
                <field name="drop_percent"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state in ('submitted','approved')"/>
            </list>
        </field>
    </record>
    <record id="view_sf_revenue_trend_kanban" model="ir.ui.view">
        <field name="name">sf.revenue.trend.kanban</field>
        <field name="model">sf.revenue.trend</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_view" group_by="state">
                <field name="name"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <menuitem id="menu_sf_revenue_trend_root" name="Customer Revenue Trend Alerts" sequence="10"
              web_icon="sf_customer_revenue_trend,static/description/icon.png"/>
    <menuitem id="menu_sf_revenue_trend_main" name="Records"
              parent="menu_sf_revenue_trend_root" action="action_sf_revenue_trend" sequence="10"/>

    <record id="wave2_trend_refresh" model="ir.actions.server">
        <field name="name">Refresh trend vs last month</field>
        <field name="model_id" ref="model_sf_revenue_trend"/>
        <field name="binding_model_id" ref="model_sf_revenue_trend"/>
        <field name="state">code</field>
        <field name="code">records.action_refresh()</field>
    </record>
</odoo>
