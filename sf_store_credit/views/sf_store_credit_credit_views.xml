<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sf_store_credit_view_list" model="ir.ui.view">
        <field name="name">sf.store.credit.list</field>
        <field name="model">sf.store.credit</field>
        <field name="arch" type="xml">
            <list decoration-danger="is_overdue" string="Store Credits">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="credit_type"/>
                <field name="amount"/>
                <field name="used_amount"/>
                <field name="remaining"/>
                <field name="expiration_date"/>
                <field name="state" widget="badge"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="sf_store_credit_view_form" model="ir.ui.view">
        <field name="name">sf.store.credit.form</field>
        <field name="model">sf.store.credit</field>
        <field name="arch" type="xml">
            <form string="Store Credit">
                <header>
                    <button name="action_confirm" string="Confirm" type="object" class="btn-primary"
                            invisible="[('state', '!=', 'draft')]"
                            groups="sf_store_credit.group_sf_store_credit_manager"/>
                    <button name="action_use_remaining" string="Use Remaining" type="object"
                            class="btn-primary" invisible="[('state', '!=', 'confirmed')]"/>
                    <button name="action_open_adjust_wizard" string="Adjust" type="object"
                            invisible="[('state', '!=', 'confirmed')]"
                            groups="sf_store_credit.group_sf_store_credit_manager"/>
                    <button name="action_cancel" string="Cancel" type="object"
                            invisible="[('state', 'not in', ('draft', 'confirmed'))]"
                            groups="sf_store_credit.group_sf_store_credit_manager"/>
                    <field name="state" widget="statusbar" readonly="1"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="account_id"/>
                            <field name="partner_id"/>
                            <field name="credit_type"/>
                            <field name="reason"/>
                        </group>
                        <group>
                            <field name="amount"/>
                            <field name="used_amount"/>
                            <field name="remaining"/>
                            <field name="expiration_date"/>
                            <field name="sale_order_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Movements">
                            <field name="move_ids" readonly="1">
                                <list string="Movements">
                                    <field name="name"/>
                                    <field name="date"/>
                                    <field name="move_type"/>
                                    <field name="amount"/>
                                    <field name="reason"/>
                                    <field name="sale_order_id"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="sf_store_credit_view_search" model="ir.ui.view">
        <field name="name">sf.store.credit.search</field>
        <field name="model">sf.store.credit</field>
        <field name="arch" type="xml">
            <search string="Store Credits">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="expiration_date"/>
                <filter name="credit_confirmed" string="Confirmed" domain="[('state', '=', 'confirmed')]"/>
                <filter name="credit_used" string="Used" domain="[('state', '=', 'used')]"/>
                <filter name="credit_expired" string="Expired" domain="[('state', '=', 'expired')]"/>
                <group>
                    <filter name="group_credit_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_credit_partner" string="Customer" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_credit_expiry" string="Expiration" context="{'group_by': 'expiration_date'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_sf_store_credit" model="ir.actions.act_window">
        <field name="name">Store Credits</field>
        <field name="res_model">sf.store.credit</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="sf_store_credit_view_search"/>
    </record>

    <record id="view_sf_store_credit_boost_kanban" model="ir.ui.view">
        <field name="name">sf_store_credit.boost.kanban</field>
        <field name="model">sf.store.credit</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" t-att-color="state">
                <field name="name"/>
                <field name="state"/>
                <field name="user_id"/>
                <field name="expiration_date"/>
                <field name="is_overdue" invisible="1"/>

                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_card oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title">
                                    <field name="name"/></strong>
                                <div class="o_kanban_record_subtitle">
                                    <field name="user_id" widget="many2one_avatar_user"/>
                                    <field name="expiration_date"/></div>
                            </div>
                            <div class="oe_kanban_bottom_right">
                                <field name="state" widget="badge"
                                       t-attf-options="{'classes_map': {'draft': 'info', 'done': 'success', 'cancelled': 'danger'}, 'domain': []}"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_sf_store_credit_boost_search" model="ir.ui.view">
        <field name="name">sf_store_credit.boost.search</field>
        <field name="model">sf.store.credit</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
<separator/>
                <filter string="My records" name="my_records" domain="[('user_id', '=', uid)]"/>
                <filter string="To Do" name="todo" domain="[('state', 'not in', ('done', 'cancelled', 'closed'))]"/>
                <group expand="0" string="Group By"><filter string="Status" name="gb_state" context="{'group_by': 'state'}"/></group>
            </search>
        </field>
    </record>
</odoo>
