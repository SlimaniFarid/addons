<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sf_store_credit_adjust_wizard_view_form" model="ir.ui.view">
        <field name="name">sf.store.credit.adjust.wizard.form</field>
        <field name="model">sf.store.credit.adjust.wizard</field>
        <field name="arch" type="xml">
            <form string="Adjust Credit">
                <group>
                    <field name="credit_id"/>
                    <field name="amount"/>
                    <field name="reason"/>
                </group>
                <footer>
                    <button name="action_apply" string="Apply Adjustment" type="object" class="btn-primary"/>
                    <button string="Close" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>