<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="module_category_sf_store_credit" model="ir.module.category">
            <field name="name">Store Credit</field>
            <field name="description">Retail Store Credit &amp; Customer Wallet.</field>
            <field name="sequence">10</field>
        </record>

        <record id="group_sf_store_credit_user" model="res.groups">
            <field name="name">Store Credit / User</field>
            <field name="category_id" ref="module_category_sf_store_credit"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_sf_store_credit_manager" model="res.groups">
            <field name="name">Store Credit / Manager</field>
            <field name="category_id" ref="module_category_sf_store_credit"/>
            <field name="implied_ids" eval="[(4, ref('sf_store_credit.group_sf_store_credit_user'))]"/>
        </record>

        <record id="rule_sf_store_credit_account_company" model="ir.rule">
            <field name="name">Store Credit Account: user sees own company</field>
            <field name="model_id" ref="model_sf_store_credit_account"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('sf_store_credit.group_sf_store_credit_user'))]"/>
        </record>
        <record id="rule_sf_store_credit_account_manager_all" model="ir.rule">
            <field name="name">Store Credit Account: manager sees all companies</field>
            <field name="model_id" ref="model_sf_store_credit_account"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('sf_store_credit.group_sf_store_credit_manager'))]"/>
        </record>

        <record id="rule_sf_store_credit_company" model="ir.rule">
            <field name="name">Store Credit: user sees own company</field>
            <field name="model_id" ref="model_sf_store_credit"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('sf_store_credit.group_sf_store_credit_user'))]"/>
        </record>
        <record id="rule_sf_store_credit_manager_all" model="ir.rule">
            <field name="name">Store Credit: manager sees all companies</field>
            <field name="model_id" ref="model_sf_store_credit"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('sf_store_credit.group_sf_store_credit_manager'))]"/>
        </record>

        <record id="rule_sf_store_credit_move_company" model="ir.rule">
            <field name="name">Store Credit Movement: user sees own company</field>
            <field name="model_id" ref="model_sf_store_credit_move"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('sf_store_credit.group_sf_store_credit_user'))]"/>
        </record>
        <record id="rule_sf_store_credit_move_manager_all" model="ir.rule">
            <field name="name">Store Credit Movement: manager sees all companies</field>
            <field name="model_id" ref="model_sf_store_credit_move"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('sf_store_credit.group_sf_store_credit_manager'))]"/>
        </record>
    </data>
    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_sf_store_credit"/>
    </record>
</odoo>