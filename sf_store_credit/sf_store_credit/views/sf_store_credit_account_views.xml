<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sf_store_credit_account_view_list" model="ir.ui.view">
        <field name="name">sf.store.credit.account.list</field>
        <field name="model">sf.store.credit.account</field>
        <field name="arch" type="xml">
            <list string="Credit Accounts">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="balance"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="sf_store_credit_account_view_form" model="ir.ui.view">
        <field name="name">sf.store.credit.account.form</field>
        <field name="model">sf.store.credit.account</field>
        <field name="arch" type="xml">
            <form string="Credit Account">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id"/>
                        </group>
                        <group>
                            <field name="balance"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Credits">
                            <field name="credit_ids">
                                <list string="Credits">
                                    <field name="name"/>
                                    <field name="amount"/>
                                    <field name="used_amount"/>
                                    <field name="remaining"/>
                                    <field name="expiration_date"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="sf_store_credit_account_view_search" model="ir.ui.view">
        <field name="name">sf.store.credit.account.search</field>
        <field name="model">sf.store.credit.account</field>
        <field name="arch" type="xml">
            <search string="Credit Accounts">
                <field name="name"/>
                <field name="partner_id"/>
                <group>
                    <filter name="group_account_partner" string="Customer" context="{'group_by': 'partner_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_sf_store_credit_account" model="ir.actions.act_window">
        <field name="name">Credit Accounts</field>
        <field name="res_model">sf.store.credit.account</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="sf_store_credit_account_view_search"/>
    </record>
</odoo>