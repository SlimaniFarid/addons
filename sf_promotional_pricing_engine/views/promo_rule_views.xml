<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_promo_rule_list" model="ir.ui.view">
        <field name="name">sf.promotional.pricing.engine.promo.rule.list</field>
        <field name="model">sf.promotional.pricing.engine.promo.rule</field>
        <field name="arch" type="xml">
            <list string="Promo.Rule">
                <field name="name"/>
                <field name="product_tmpl_ids"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="discount_pct"/>
                <field name="fixed_price"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_promo_rule_form" model="ir.ui.view">
        <field name="name">sf.promotional.pricing.engine.promo.rule.form</field>
        <field name="model">sf.promotional.pricing.engine.promo.rule</field>
        <field name="arch" type="xml">
            <form string="Promo.Rule">
                <header>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" placeholder="Name"/></h1></div>
                    <group><group>
                            <field name="name"/>
                            <field name="product_tmpl_ids"/>
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <field name="discount_pct"/>
                            <field name="fixed_price"/>
                            <field name="min_qty"/>
                            <field name="margin_floor_pct"/>
                            <field name="active"/>
                    </group>
                    <group>
                        <field name="currency_id" invisible="1"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_promo_rule" model="ir.actions.act_window">
        <field name="name">Promo.Rule</field>
        <field name="res_model">sf.promotional.pricing.engine.promo.rule</field>
        <field name="view_mode">kanban,list,form</field>
    </record>

    <record id="view_sf_promotional_pricing_engine_boost_kanban" model="ir.ui.view">
        <field name="name">sf_promotional_pricing_engine.boost.kanban</field>
        <field name="model">sf.promotional.pricing.engine.promo.rule</field>
        <field name="arch" type="xml">
            <kanban default_group_by="">
                <field name="name"/>
                <field name="user_id"/>

                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_card oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong>
                                <div><field name="user_id"
                                            widget="many2one_avatar_user"/></div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_sf_promotional_pricing_engine_boost_search" model="ir.ui.view">
        <field name="name">sf_promotional_pricing_engine.boost.search</field>
        <field name="model">sf.promotional.pricing.engine.promo.rule</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
<separator/>
                <filter string="My records" name="my_records" domain="[('user_id', '=', uid)]"/>
            </search>
        </field>
    </record>

    <record id="wave_final_sf_promotional_pricing_engine" model="ir.actions.server">
        <field name="name">Refresh Business Data</field>
        <field name="model_id" ref="model_sf_promotional_pricing_engine_promo_rule"/>
        <field name="binding_model_id" ref="model_sf_promotional_pricing_engine_promo_rule"/>
        <field name="state">code</field>
        <field name="code">records.action_refresh_business()</field>
    </record>
</odoo>
