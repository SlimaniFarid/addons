<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_sf_promotional_pricing_engine" model="ir.module.category">
        <field name="name">Promotional Pricing Engine</field>
        <field name="description">Promotional Pricing Engine</field>
        <field name="sequence">10</field>
    </record>
    <record id="group_promotional_pricing_engine_user" model="res.groups">
        <field name="name">Promotional Pricing Engine / User</field>
        <field name="category_id" ref="module_category_sf_promotional_pricing_engine"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_promotional_pricing_engine_manager" model="res.groups">
        <field name="name">Promotional Pricing Engine / Manager</field>
        <field name="category_id" ref="module_category_sf_promotional_pricing_engine"/>
        <field name="implied_ids" eval="[(4, ref('sf_promotional_pricing_engine.group_promotional_pricing_engine_user'))]"/>
    </record>
</odoo>
