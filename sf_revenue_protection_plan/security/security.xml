<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_revenue_protection_plan" model="ir.module.category">
        <field name="name">Revenue Protection Plan</field>
        <field name="sequence">279</field>
    </record>
    <record id="group_revenue_protection_plan_user" model="res.groups">
        <field name="name">Revenue Protection Plan User</field>
        <field name="category_id" ref="module_category_revenue_protection_plan"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>

    </record>
    <record id="group_revenue_protection_plan_manager" model="res.groups">
        <field name="name">Revenue Protection Plan Manager</field>
        <field name="category_id" ref="module_category_revenue_protection_plan"/>
        <field name="implied_ids" eval="[(4, ref('group_revenue_protection_plan_user'))]"/>
    </record>
    <record id="rule_revenue_protection_plan_sf_revenue_protection_plan" model="ir.rule">
        <field name="name">Revenue Protection Plan: multi-company</field>
        <field name="model_id" ref="model_sf_revenue_protection_plan"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
