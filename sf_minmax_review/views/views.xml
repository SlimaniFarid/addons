<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_minmax_review" model="ir.actions.act_window">
        <field name="name">Min/Max Parameter Review</field>
        <field name="res_model">sf.minmax.review</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
    <record id="view_sf_minmax_review_form" model="ir.ui.view">
        <field name="name">sf.minmax.review.form</field>
        <field name="model">sf.minmax.review</field>
        <field name="arch" type="xml">
            <form string="Min/Max Parameter Review">
                <header>
                    <button name="action_approved" type="object" string="Approved"
                            class="btn-primary"/>
                    <button name="action_applied" type="object" string="Applied"
                            class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="proposed,approved,applied,rejected"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="product_id"/>
                            <field name="current_min"/>
                            <field name="current_max"/>
                            <field name="proposed_min"/>
                            <field name="proposed_max"/>
                            <field name="evidence"/>
                            <field name="reviewer_id"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_minmax_review_list" model="ir.ui.view">
        <field name="name">sf.minmax.review.list</field>
        <field name="model">sf.minmax.review</field>
        <field name="arch" type="xml">
            <list string="Min/Max Parameter Review" sample="1">
                <field name="product_id"/>
                <field name="current_min"/>
                <field name="current_max"/>
                <field name="proposed_min"/>
                <field name="proposed_max"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state in ('submitted','approved')"/>
            </list>
        </field>
    </record>
    <record id="view_sf_minmax_review_kanban" model="ir.ui.view">
        <field name="name">sf.minmax.review.kanban</field>
        <field name="model">sf.minmax.review</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_view" group_by="state">
                <field name="name"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <menuitem id="menu_sf_minmax_review_root" name="Min/Max Parameter Review" sequence="16"
              web_icon="sf_minmax_review,static/description/icon.png"/>
    <menuitem id="menu_sf_minmax_review_main" name="Records"
              parent="menu_sf_minmax_review_root" action="action_sf_minmax_review" sequence="10"/>
</odoo>
