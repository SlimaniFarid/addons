<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_sales_asset_library" model="ir.module.category">
        <field name="name">Sales Asset Library</field>
        <field name="sequence">696</field>
    </record>
    <record id="group_sales_asset_library_user" model="res.groups">
        <field name="name">Sales Asset Library User</field>
        <field name="category_id" ref="module_category_sales_asset_library"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>

    </record>
    <record id="group_sales_asset_library_manager" model="res.groups">
        <field name="name">Sales Asset Library Manager</field>
        <field name="category_id" ref="module_category_sales_asset_library"/>
        <field name="implied_ids" eval="[(4, ref('group_sales_asset_library_user'))]"/>
    </record>
    <record id="rule_sales_asset_library_sf_sales_asset_library" model="ir.rule">
        <field name="name">Sales Asset Library: multi-company</field>
        <field name="model_id" ref="model_sf_sales_asset_library"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_sales_asset_library"/>
    </record>
</odoo>
