<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_batch_records" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.batch.records</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Batch Records" string="Batch Records" name="sf_batch_records">
                    <block title="Batch Records Settings">
                        <setting string="Block release on out-of-spec parameters">
                            <field name="sf_batch_records_block_out_of_spec_release"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>