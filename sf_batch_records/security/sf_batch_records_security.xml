<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="module_category_sf_batch_records" model="ir.module.category">
            <field name="name">Batch Records</field>
            <field name="description">Electronic Batch Production Records.</field>
            <field name="sequence">10</field>
        </record>

        <record id="group_sf_batch_records_user" model="res.groups">
            <field name="name">Batch Records / User</field>
            <field name="category_id" ref="module_category_sf_batch_records"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_sf_batch_records_manager" model="res.groups">
            <field name="name">Batch Records / Manager</field>
            <field name="category_id" ref="module_category_sf_batch_records"/>
            <field name="implied_ids" eval="[(4, ref('sf_batch_records.group_sf_batch_records_user'))]"/>
        </record>

        <record id="rule_sf_batch_record_company" model="ir.rule">
            <field name="name">Batch Record: user sees own company</field>
            <field name="model_id" ref="model_sf_batch_record"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('sf_batch_records.group_sf_batch_records_user'))]"/>
        </record>
        <record id="rule_sf_batch_record_manager_all" model="ir.rule">
            <field name="name">Batch Record: manager sees all companies</field>
            <field name="model_id" ref="model_sf_batch_record"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('sf_batch_records.group_sf_batch_records_manager'))]"/>
        </record>

        <record id="rule_sf_batch_record_material_company" model="ir.rule">
            <field name="name">Batch Record Material: user sees own company</field>
            <field name="model_id" ref="model_sf_batch_record_material"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('sf_batch_records.group_sf_batch_records_user'))]"/>
        </record>
        <record id="rule_sf_batch_record_material_manager_all" model="ir.rule">
            <field name="name">Batch Record Material: manager sees all companies</field>
            <field name="model_id" ref="model_sf_batch_record_material"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('sf_batch_records.group_sf_batch_records_manager'))]"/>
        </record>

        <record id="rule_sf_batch_record_step_company" model="ir.rule">
            <field name="name">Batch Record Step: user sees own company</field>
            <field name="model_id" ref="model_sf_batch_record_step"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('sf_batch_records.group_sf_batch_records_user'))]"/>
        </record>
        <record id="rule_sf_batch_record_step_manager_all" model="ir.rule">
            <field name="name">Batch Record Step: manager sees all companies</field>
            <field name="model_id" ref="model_sf_batch_record_step"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('sf_batch_records.group_sf_batch_records_manager'))]"/>
        </record>

        <record id="rule_sf_batch_record_parameter_company" model="ir.rule">
            <field name="name">Batch Record Parameter: user sees own company</field>
            <field name="model_id" ref="model_sf_batch_record_parameter"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('sf_batch_records.group_sf_batch_records_user'))]"/>
        </record>
        <record id="rule_sf_batch_record_parameter_manager_all" model="ir.rule">
            <field name="name">Batch Record Parameter: manager sees all companies</field>
            <field name="model_id" ref="model_sf_batch_record_parameter"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('sf_batch_records.group_sf_batch_records_manager'))]"/>
        </record>

        <record id="rule_sf_batch_record_deviation_company" model="ir.rule">
            <field name="name">Batch Record Deviation: user sees own company</field>
            <field name="model_id" ref="model_sf_batch_record_deviation"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('sf_batch_records.group_sf_batch_records_user'))]"/>
        </record>
        <record id="rule_sf_batch_record_deviation_manager_all" model="ir.rule">
            <field name="name">Batch Record Deviation: manager sees all companies</field>
            <field name="model_id" ref="model_sf_batch_record_deviation"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('sf_batch_records.group_sf_batch_records_manager'))]"/>
        </record>
    </data>
    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_sf_batch_records"/>
    </record>
</odoo>