<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_payment_milestone_engine" model="ir.module.category">
        <field name="name">Payment Milestone Engine</field>
        <field name="sequence">63</field>
    </record>
    <record id="group_payment_milestone_engine_user" model="res.groups">
        <field name="name">Payment Milestone Engine User</field>
        <field name="category_id" ref="module_category_payment_milestone_engine"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>

    </record>
    <record id="group_payment_milestone_engine_manager" model="res.groups">
        <field name="name">Payment Milestone Engine Manager</field>
        <field name="category_id" ref="module_category_payment_milestone_engine"/>
        <field name="implied_ids" eval="[(4, ref('group_payment_milestone_engine_user'))]"/>
    </record>
    <record id="rule_payment_milestone_engine_sf_payment_milestone" model="ir.rule">
        <field name="name">Payment Milestone Plan: multi-company</field>
        <field name="model_id" ref="model_sf_payment_milestone"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
