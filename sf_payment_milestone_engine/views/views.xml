<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_payment_milestone" model="ir.actions.act_window">
        <field name="name">Payment Milestone Engine</field>
        <field name="res_model">sf.payment.milestone</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
    <record id="view_sf_payment_milestone_form" model="ir.ui.view">
        <field name="name">sf.payment.milestone.form</field>
        <field name="model">sf.payment.milestone</field>
        <field name="arch" type="xml">
            <form string="Payment Milestone Engine">
                <header>

                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="order_id"/>
                            <field name="partner_id"/>
                            <field name="milestone_no"/>
                            <field name="percent"/>
                            <field name="due_date"/>
                            <field name="amount"/>
                            <field name="notes"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_payment_milestone_list" model="ir.ui.view">
        <field name="name">sf.payment.milestone.list</field>
        <field name="model">sf.payment.milestone</field>
        <field name="arch" type="xml">
            <list string="Payment Milestone Engine" sample="1">
                <field name="order_id"/>
                <field name="partner_id"/>
                <field name="milestone_no"/>
                <field name="percent"/>
                <field name="due_date"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state in ('submitted','approved')"/>
            </list>
        </field>
    </record>
    <record id="view_sf_payment_milestone_kanban" model="ir.ui.view">
        <field name="name">sf.payment.milestone.kanban</field>
        <field name="model">sf.payment.milestone</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_view" group_by="state">
                <field name="name"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <menuitem id="menu_sf_payment_milestone_root" name="Payment Milestone Engine" sequence="13"
              web_icon="sf_payment_milestone_engine,static/description/icon.png"/>
    <menuitem id="menu_sf_payment_milestone_main" name="Records"
              parent="menu_sf_payment_milestone_root" action="action_sf_payment_milestone" sequence="10"/>

    <record id="wave_final_sf_payment_milestone_engine" model="ir.actions.server">
        <field name="name">Refresh Business Data</field>
        <field name="model_id" ref="model_sf_payment_milestone"/>
        <field name="binding_model_id" ref="model_sf_payment_milestone"/>
        <field name="state">code</field>
        <field name="code">records.action_refresh_business()</field>
    </record>
</odoo>
