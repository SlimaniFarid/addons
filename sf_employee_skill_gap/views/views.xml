<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_employee_skill_gap" model="ir.actions.act_window">
        <field name="name">Employee Skill Gap Analyzer</field>
        <field name="res_model">sf.employee_skill_gap</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
    <record id="view_sf_employee_skill_gap_form" model="ir.ui.view">
        <field name="name">sf.employee_skill_gap.form</field>
        <field name="model">sf.employee_skill_gap</field>
        <field name="arch" type="xml">
            <form string="Employee Skill Gap Analyzer">
                <header>
                    <button name="action_submitted" type="object" string="Submitted"
                            class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="employee_id"/>
                            <field name="role"/>
                            <field name="required_skills"/>
                            <field name="actual_skills"/>
                        <field name="gap_analysis"/>
                            <field name="training_plan"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_employee_skill_gap_list" model="ir.ui.view">
        <field name="name">sf.employee_skill_gap.list</field>
        <field name="model">sf.employee_skill_gap</field>
        <field name="arch" type="xml">
            <list string="Employee Skill Gap Analyzer" sample="1">
                <field name="employee_id"/>
                <field name="role"/>
                <field name="required_skills"/>
                <field name="actual_skills"/>
                <field name="gap_analysis"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state in ('submitted','approved')"/>
            </list>
        </field>
    </record>
    <record id="view_sf_employee_skill_gap_kanban" model="ir.ui.view">
        <field name="name">sf.employee_skill_gap.kanban</field>
        <field name="model">sf.employee_skill_gap</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_view" group_by="state">
                <field name="name"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <menuitem id="menu_sf_employee_skill_gap_root" name="Employee Skill Gap Analyzer" sequence="20"
              web_icon="sf_employee_skill_gap,static/description/icon.png"/>
    <menuitem id="menu_sf_employee_skill_gap_main" name="Records"
              parent="menu_sf_employee_skill_gap_root" action="action_sf_employee_skill_gap" sequence="10"/>

    <record id="wave_final_sf_employee_skill_gap" model="ir.actions.server">
        <field name="name">Refresh Business Data</field>
        <field name="model_id" ref="model_sf_employee_skill_gap"/>
        <field name="binding_model_id" ref="model_sf_employee_skill_gap"/>
        <field name="state">code</field>
        <field name="code">records.action_refresh_business()</field>
    </record>
</odoo>
