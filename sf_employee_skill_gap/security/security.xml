<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_employee_skill_gap" model="ir.module.category">
        <field name="name">Employee Skill Gap Analyzer</field>
        <field name="sequence">681</field>
    </record>
    <record id="group_employee_skill_gap_user" model="res.groups">
        <field name="name">Employee Skill Gap Analyzer User</field>
        <field name="category_id" ref="module_category_employee_skill_gap"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>

    </record>
    <record id="group_employee_skill_gap_manager" model="res.groups">
        <field name="name">Employee Skill Gap Analyzer Manager</field>
        <field name="category_id" ref="module_category_employee_skill_gap"/>
        <field name="implied_ids" eval="[(4, ref('group_employee_skill_gap_user'))]"/>
    </record>
    <record id="rule_employee_skill_gap_sf_employee_skill_gap" model="ir.rule">
        <field name="name">Employee Skill Gap Analyzer: multi-company</field>
        <field name="model_id" ref="model_sf_employee_skill_gap"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
