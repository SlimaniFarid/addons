<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_shop_floor_entry_list" model="ir.ui.view">
        <field name="name">sf.shop.floor.terminal.shop.floor.entry.list</field>
        <field name="model">sf.shop.floor.terminal.shop.floor.entry</field>
        <field name="arch" type="xml">
            <list string="Shop.Floor.Entry">
                <field name="employee_id"/>
                <field name="workorder_id"/>
                <field name="start_time"/>
                <field name="end_time"/>
                <field name="qty_produced"/>
                <field name="qty_scrap"/>
                <field name="state" widget="badge"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_shop_floor_entry_form" model="ir.ui.view">
        <field name="name">sf.shop.floor.terminal.shop.floor.entry.form</field>
        <field name="model">sf.shop.floor.terminal.shop.floor.entry</field>
        <field name="arch" type="xml">
            <form string="Shop.Floor.Entry">
                <header>
                <field name="state" widget="badge"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" placeholder="Name"/></h1></div>
                    <group><group>
                            <field name="employee_id"/>
                            <field name="workorder_id"/>
                            <field name="start_time"/>
                            <field name="end_time"/>
                            <field name="qty_produced"/>
                            <field name="qty_scrap"/>
                            <field name="state"/>
                    </group>
                    <group>
                        <field name="currency_id" invisible="1"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_shop_floor_entry" model="ir.actions.act_window">
        <field name="name">Shop.Floor.Entry</field>
        <field name="res_model">sf.shop.floor.terminal.shop.floor.entry</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
