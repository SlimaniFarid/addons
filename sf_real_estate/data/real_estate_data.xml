<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_realestate_lease" model="ir.sequence">
            <field name="name">Real Estate Lease</field>
            <field name="code">sf.realestate.lease</field>
            <field name="prefix">LS/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="seq_realestate_rent_invoice" model="ir.sequence">
            <field name="name">Rent Invoice</field>
            <field name="code">sf.realestate.rent.invoice</field>
            <field name="prefix">RI/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>