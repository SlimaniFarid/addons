<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_sf_spa_resource_list" model="ir.ui.view">
            <field name="name">sf.spa.resource.list</field>
            <field name="model">sf.spa.resource</field>
            <field name="arch" type="xml">
                <list string="Resources" multi_edit="1">
                    <field name="name"/>
                    <field name="resource_type"/>
                    <field name="cabin_type" optional="show"/>
                    <field name="capacity"/>
                    <field name="location"/>
                    <field name="company_id" groups="base.group_multi_company"/>
                    <field name="active"/>
                </list>
            </field>
        </record>

        <record id="view_sf_spa_resource_form" model="ir.ui.view">
            <field name="name">sf.spa.resource.form</field>
            <field name="model">sf.spa.resource</field>
            <field name="arch" type="xml">
                <form string="Resource">
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_view_bookings" type="object" class="oe_stat_button" icon="fa-calendar">
                                <field name="booking_count" widget="statinfo" string="Bookings"/>
                            </button>
                        </div>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="resource_type"/>
                                <field name="cabin_type" attrs="{'invisible': [('resource_type', '!=', 'cabin')]}"/>
                                <field name="capacity"/>
                            </group>
                            <group>
                                <field name="location"/>
                                <field name="company_id" groups="base.group_multi_company" options="{'no_create': True}"/>
                                <field name="active"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Equipment" name="equipment">
                                <field name="equipment_ids">
                                    <list>
                                        <field name="name"/>
                                        <field name="equipment_type"/>
                                        <field name="quantity_total"/>
                                        <field name="quantity_available"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Bookings" name="bookings">
                                <field name="booking_ids" domain="[('state', 'in', ['confirmed', 'in_progress'])]">
                                    <list>
                                        <field name="name"/>
                                        <field name="partner_id"/>
                                        <field name="service_id"/>
                                        <field name="start_datetime"/>
                                        <field name="end_datetime"/>
                                        <field name="therapist_id"/>
                                        <field name="state"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_sf_spa_resource_search" model="ir.ui.view">
            <field name="name">sf.spa.resource.search</field>
            <field name="model">sf.spa.resource</field>
            <field name="arch" type="xml">
                <search string="Search Resources">
                    <field name="name"/>
                    <field name="resource_type"/>
                    <field name="location"/>
                    <filter string="Cabins" name="filter_cabin" domain="[('resource_type', '=', 'cabin')]"/>
                    <filter string="Pools" name="filter_pool" domain="[('resource_type', '=', 'pool')]"/>
                    <filter string="Saunas" name="filter_sauna" domain="[('resource_type', '=', 'sauna')]"/>
                    <filter string="Hammams" name="filter_hammam" domain="[('resource_type', '=', 'hammam')]"/>
                    <filter string="Relaxation Rooms" name="filter_relaxation" domain="[('resource_type', '=', 'relaxation_room')]"/>
                    <filter string="Equipment" name="filter_equipment" domain="[('resource_type', '=', 'equipment')]"/>
                    <group string="Group By">
                        <filter string="Type" name="group_by_type" context="{'group_by': 'resource_type'}"/>
                        <filter string="Company" name="group_by_company" context="{'group_by': 'company_id'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="action_sf_spa_resource" model="ir.actions.act_window">
            <field name="name">Resources</field>
            <field name="res_model">sf.spa.resource</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="view_sf_spa_resource_search"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">Create your first spa resource</p>
            </field>
        </record>

        <record id="view_sf_spa_resource_kanban" model="ir.ui.view">
            <field name="name">sf.spa.resource.kanban</field>
            <field name="model">sf.spa.resource</field>
            <field name="arch" type="xml">
                <kanban class="o_kanban_view_spa_resource">
                    <field name="name"/>
                    <field name="resource_type"/>
                    <field name="capacity"/>
                    <field name="location"/>
                    <templates>
                        <t t-name="kanban-box">
                            <div t-attf-class="oe_kanban_global_click o_kanban_card oe_kanban_card_spa_resource">
                                <div class="o_kanban_card_body">
                                    <strong><field name="name"/></strong>
                                    <div class="text-muted"><field name="resource_type"/></div>
                                    <div><field name="location"/></div>
                                    <div class="mt-2">
                                        <span class="badge bg-info"><field name="capacity"/> capacity</span>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>
    </data>
</odoo>