<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_sf_spa_res_config_settings" model="ir.ui.view">
            <field name="name">sf.spa.res.config.settings</field>
            <field name="model">res.config.settings</field>
            <field name="inherit_id" ref="base.res_config_settings_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//div[hasclass('settings')]" position="inside">
                    <div class="app_settings_block" data-string="Spa &amp; Wellness" data-key="sf_spa_wellness" groups="group_spa_manager">
                        <h2>Spa &amp; Wellness Settings</h2>
                        <div class="row mt16">
                            <div class="col-12 col-lg-6 o_setting_box">
                                <div class="o_setting_left_pane">
                                    <label for="slot_duration_minutes"/>
                                </div>
                                <div class="o_setting_right_pane">
                                    <field name="slot_duration_minutes" class="oe_inline"/>
                                    <div class="text-muted">Default planning slot duration in minutes</div>
                                </div>
                            </div>
                            <div class="col-12 col-lg-6 o_setting_box">
                                <div class="o_setting_left_pane">
                                    <label for="no_show_policy"/>
                                </div>
                                <div class="o_setting_right_pane">
                                    <field name="no_show_policy" class="oe_inline"/>
                                    <div class="text-muted">Billing policy for no-shows</div>
                                </div>
                            </div>
                            <div class="col-12 col-lg-6 o_setting_box">
                                <div class="o_setting_left_pane">
                                    <label for="free_cancellation_hours"/>
                                </div>
                                <div class="o_setting_right_pane">
                                    <field name="free_cancellation_hours" class="oe_inline"/>
                                    <div class="text-muted">Hours before appointment for free cancellation</div>
                                </div>
                            </div>
                            <div class="col-12 col-lg-6 o_setting_box">
                                <div class="o_setting_left_pane">
                                    <label for="default_monthly_credits"/>
                                </div>
                                <div class="o_setting_right_pane">
                                    <field name="default_monthly_credits" class="oe_inline"/>
                                    <div class="text-muted">Default monthly credits for new memberships</div>
                                </div>
                            </div>
                            <div class="col-12 col-lg-6 o_setting_box">
                                <div class="o_setting_left_pane">
                                    <label for="income_account_service_id"/>
                                </div>
                                <div class="o_setting_right_pane">
                                    <field name="income_account_service_id" class="oe_inline"/>
                                    <div class="text-muted">Default income account for services</div>
                                </div>
                            </div>
                            <div class="col-12 col-lg-6 o_setting_box">
                                <div class="o_setting_left_pane">
                                    <label for="income_account_package_id"/>
                                </div>
                                <div class="o_setting_right_pane">
                                    <field name="income_account_package_id" class="oe_inline"/>
                                    <div class="text-muted">Default income account for packages</div>
                                </div>
                            </div>
                            <div class="col-12 col-lg-6 o_setting_box">
                                <div class="o_setting_left_pane">
                                    <label for="income_account_cure_id"/>
                                </div>
                                <div class="o_setting_right_pane">
                                    <field name="income_account_cure_id" class="oe_inline"/>
                                    <div class="text-muted">Default income account for cures</div>
                                </div>
                            </div>
                            <div class="col-12 col-lg-6 o_setting_box">
                                <div class="o_setting_left_pane">
                                    <label for="income_account_membership_id"/>
                                </div>
                                <div class="o_setting_right_pane">
                                    <field name="income_account_membership_id" class="oe_inline"/>
                                    <div class="text-muted">Default income account for memberships</div>
                                </div>
                            </div>
                            <div class="col-12 col-lg-6 o_setting_box">
                                <div class="o_setting_left_pane">
                                    <label for="income_account_retail_id"/>
                                </div>
                                <div class="o_setting_right_pane">
                                    <field name="income_account_retail_id" class="oe_inline"/>
                                    <div class="text-muted">Default income account for retail</div>
                                </div>
                            </div>
                            <div class="col-12 col-lg-6 o_setting_box">
                                <div class="o_setting_left_pane">
                                    <label for="sale_journal_id"/>
                                </div>
                                <div class="o_setting_right_pane">
                                    <field name="sale_journal_id" class="oe_inline"/>
                                    <div class="text-muted">Default sales journal</div>
                                </div>
                            </div>
                            <div class="col-12 col-lg-6 o_setting_box">
                                <div class="o_setting_left_pane">
                                    <label for="membership_credit_reset_day"/>
                                </div>
                                <div class="o_setting_right_pane">
                                    <field name="membership_credit_reset_day" class="oe_inline"/>
                                    <div class="text-muted">Day of month to reset membership credits (1-28)</div>
                                </div>
                            </div>
                            <div class="col-12 col-lg-6 o_setting_box">
                                <div class="o_setting_left_pane">
                                    <label for="reevaluation_frequency_months"/>
                                </div>
                                <div class="o_setting_right_pane">
                                    <field name="reevaluation_frequency_months" class="oe_inline"/>
                                    <div class="text-muted">Default re-evaluation frequency in months</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </xpath>
            </field>
        </record>
    </data>
</odoo>