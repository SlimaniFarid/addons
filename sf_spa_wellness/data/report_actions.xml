<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="action_report_daily_planning" model="ir.actions.report">
            <field name="name">Daily Resource Planning</field>
            <field name="model">sf.spa.resource</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">sf_spa_wellness.report_daily_planning</field>
            <field name="report_file">sf_spa_wellness.report_daily_planning</field>
            <field name="binding_model_id" ref="model_sf_spa_resource"/>
            <field name="binding_type">report</field>
        </record>

        <record id="action_report_therapist_planning" model="ir.actions.report">
            <field name="name">Therapist Weekly Planning</field>
            <field name="model">sf.spa.therapist</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">sf_spa_wellness.report_therapist_planning</field>
            <field name="report_file">sf_spa_wellness.report_therapist_planning</field>
            <field name="binding_model_id" ref="model_sf_spa_therapist"/>
            <field name="binding_type">report</field>
        </record>

        <record id="action_report_client_journey" model="ir.actions.report">
            <field name="name">Client Journey</field>
            <field name="model">sf.spa.client.plan</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">sf_spa_wellness.report_client_journey</field>
            <field name="report_file">sf_spa_wellness.report_client_journey</field>
            <field name="binding_model_id" ref="model_sf_spa_client_plan"/>
            <field name="binding_type">report</field>
        </record>

        <record id="action_report_treatment_note" model="ir.actions.report">
            <field name="name">Treatment Note</field>
            <field name="model">sf.spa.booking</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">sf_spa_wellness.report_treatment_note</field>
            <field name="report_file">sf_spa_wellness.report_treatment_note</field>
            <field name="binding_model_id" ref="model_sf_spa_booking"/>
            <field name="binding_type">report</field>
        </record>

        <record id="action_report_invoice_spa" model="ir.actions.report">
            <field name="name">Spa Invoice</field>
            <field name="model">account.move</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">sf_spa_wellness.report_invoice_spa</field>
            <field name="report_file">sf_spa_wellness.report_invoice_spa</field>
            <field name="binding_model_id" ref="account.model_account_move"/>
            <field name="binding_type">report</field>
        </record>

        <record id="action_report_occupancy_pivot" model="ir.actions.act_window">
            <field name="name">Resource Occupancy</field>
            <field name="res_model">sf.spa.booking</field>
            <field name="view_mode">pivot,graph</field>
            <field name="context">{'search_default_group_by_resource': 1, 'search_default_group_by_state': 1}</field>
        </record>

        <record id="action_report_therapist_profitability_pivot" model="ir.actions.act_window">
            <field name="name">Therapist Profitability</field>
            <field name="res_model">sf.spa.booking</field>
            <field name="view_mode">pivot,graph</field>
            <field name="context">{'search_default_group_by_therapist': 1, 'search_default_group_by_service': 1}</field>
        </record>

        <record id="action_report_service_profitability_pivot" model="ir.actions.act_window">
            <field name="name">Service Profitability</field>
            <field name="res_model">sf.spa.booking</field>
            <field name="view_mode">pivot,graph</field>
            <field name="context">{'search_default_group_by_service': 1}</field>
        </record>

        <record id="action_report_cure_tracking_pivot" model="ir.actions.act_window">
            <field name="name">Cure Tracking</field>
            <field name="res_model">sf.spa.cure.instance</field>
            <field name="view_mode">pivot,graph</field>
            <field name="context">{'search_default_group_by_state': 1, 'search_default_group_by_cure_template': 1}</field>
        </record>

        <record id="action_report_membership_pivot" model="ir.actions.act_window">
            <field name="name">Membership Tracking</field>
            <field name="res_model">sf.spa.membership</field>
            <field name="view_mode">pivot,graph</field>
            <field name="context">{'search_default_group_by_state': 1, 'search_default_group_by_membership_type': 1}</field>
        </record>

        <record id="action_report_retail_stock_pivot" model="ir.actions.act_window">
            <field name="name">Retail Stock</field>
            <field name="res_model">sf.spa.retail.sale.line</field>
            <field name="view_mode">pivot,graph</field>
            <field name="context">{'search_default_group_by_product': 1}</field>
        </record>
    </data>
</odoo>