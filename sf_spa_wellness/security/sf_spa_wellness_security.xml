<?xml version="1.0" ?>
<odoo>
    <record id="module_category_sf_spa_wellness" model="ir.module.category">
        <field name="name">Spa &amp; Wellness Center Management</field>
        <field name="description">Complete spa management: resource planning, therapists, treatments, packages, memberships</field>
        <field name="sequence">10</field>
    </record>
    <record id="group_sf_spa_wellness_user" model="res.groups">
        <field name="name">Spa Wellness / User</field>
        <field name="category_id" ref="module_category_sf_spa_wellness"/>
    </record>
    <record id="group_sf_spa_wellness_manager" model="res.groups">
        <field name="name">Spa Wellness / Manager</field>
        <field name="category_id" ref="module_category_sf_spa_wellness"/>
        <field name="implied_ids" eval="[(4, ref('sf_spa_wellness.group_sf_spa_wellness_user'))]"/>
    </record>
    <record id="group_sf_spa_therapist" model="res.groups">
        <field name="name">Spa Wellness / Therapist</field>
        <field name="category_id" ref="module_category_sf_spa_wellness"/>
        <field name="implied_ids" eval="[(4, ref('sf_spa_wellness.group_sf_spa_wellness_user'))]"/>
    </record>
    <record id="rule_sf_spa_wellness_cabin_company" model="ir.rule">
        <field name="name">Cabin: user sees own company</field>
        <field name="model_id" ref="model_sf_spa_wellness_cabin"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('sf_spa_wellness.group_sf_spa_wellness_user'))]"/>
    </record>
</odoo>