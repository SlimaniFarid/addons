<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_anniversary" model="ir.actions.act_window">
        <field name="name">Anniversary &amp; Birthday Reminders</field>
        <field name="res_model">sf.anniversary</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
    <record id="view_sf_anniversary_form" model="ir.ui.view">
        <field name="name">sf.anniversary.form</field>
        <field name="model">sf.anniversary</field>
        <field name="arch" type="xml">
            <form string="Anniversary &amp; Birthday Reminders">
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="tracked,celebrated"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="employee_id"/>
                            <field name="type"/>
                            <field name="event_date"/>
                            <field name="years"/>
                            <field name="celebrated"/>
                            <field name="notes"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_anniversary_list" model="ir.ui.view">
        <field name="name">sf.anniversary.list</field>
        <field name="model">sf.anniversary</field>
        <field name="arch" type="xml">
            <list string="Anniversary &amp; Birthday Reminders" sample="1">
                <field name="employee_id"/>
                <field name="type"/>
                <field name="event_date"/>
                <field name="years"/>
                <field name="celebrated"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state in ('submitted','approved')"/>
            </list>
        </field>
    </record>
    <record id="view_sf_anniversary_kanban" model="ir.ui.view">
        <field name="name">sf.anniversary.kanban</field>
        <field name="model">sf.anniversary</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_view" group_by="state">
                <field name="name"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <menuitem id="menu_sf_anniversary_root" name="Anniversary &amp; Birthday Reminders" sequence="21"
              web_icon="sf_anniversary_reminders,static/description/icon.png"/>
    <menuitem id="menu_sf_anniversary_main" name="Records"
              parent="menu_sf_anniversary_root" action="action_sf_anniversary" sequence="10"/>
</odoo>
