<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_anniversary_reminders" model="ir.module.category">
        <field name="name">Anniversary &amp; Birthday Reminders</field>
        <field name="sequence">2</field>
    </record>
    <record id="group_anniversary_reminders_user" model="res.groups">
        <field name="name">Anniversary &amp; Birthday Reminders User</field>
        <field name="category_id" ref="module_category_anniversary_reminders"/>

    </record>
    <record id="group_anniversary_reminders_manager" model="res.groups">
        <field name="name">Anniversary &amp; Birthday Reminders Manager</field>
        <field name="category_id" ref="module_category_anniversary_reminders"/>
        <field name="implied_ids" eval="[(4, ref('group_anniversary_reminders_user'))]"/>
    </record>
    <record id="rule_anniversary_reminders_sf_anniversary" model="ir.rule">
        <field name="name">Anniversary Entry: multi-company</field>
        <field name="model_id" ref="model_sf_anniversary"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_anniversary_reminders"/>
    </record>
</odoo>
