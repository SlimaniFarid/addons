<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_customer_segment" model="ir.actions.act_window">
        <field name="name">Customer Segment Rules Engine</field>
        <field name="res_model">sf.customer.segment</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
    <record id="view_sf_customer_segment_form" model="ir.ui.view">
        <field name="name">sf.customer.segment.form</field>
        <field name="model">sf.customer.segment</field>
        <field name="arch" type="xml">
            <form string="Customer Segment Rules Engine">
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="active,archived"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="segment_name"/>
                            <field name="min_revenue"/>
                            <field name="max_days_inactive"/>
                            <field name="industry"/>
                            <field name="member_count"/>
                            <field name="last_refresh"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_customer_segment_list" model="ir.ui.view">
        <field name="name">sf.customer.segment.list</field>
        <field name="model">sf.customer.segment</field>
        <field name="arch" type="xml">
            <list string="Customer Segment Rules Engine" sample="1">
                <field name="segment_name"/>
                <field name="min_revenue"/>
                <field name="max_days_inactive"/>
                <field name="industry"/>
                <field name="member_count"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state in ('submitted','approved')"/>
            </list>
        </field>
    </record>
    <record id="view_sf_customer_segment_kanban" model="ir.ui.view">
        <field name="name">sf.customer.segment.kanban</field>
        <field name="model">sf.customer.segment</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_view" group_by="state">
                <field name="name"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <menuitem id="menu_sf_customer_segment_root" name="Customer Segment Rules Engine" sequence="11"
              web_icon="sf_customer_segment_rules,static/description/icon.png"/>
    <menuitem id="menu_sf_customer_segment_main" name="Records"
              parent="menu_sf_customer_segment_root" action="action_sf_customer_segment" sequence="10"/>
</odoo>
