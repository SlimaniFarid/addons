<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_knowledge_article" model="ir.actions.act_window">
        <field name="name">Knowledge Article Library</field>
        <field name="res_model">sf.knowledge.article</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
    <record id="view_sf_knowledge_article_form" model="ir.ui.view">
        <field name="name">sf.knowledge.article.form</field>
        <field name="model">sf.knowledge.article</field>
        <field name="arch" type="xml">
            <form string="Knowledge Article Library">
                <header>
                    <button name="action_review" type="object" string="In Review"
                            class="btn-primary"/>
                    <button name="action_published" type="object" string="Published"
                            class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,review,published,needs_update"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="title"/>
                            <field name="category"/>
                        <field name="content"/>
                            <field name="author_id"/>
                            <field name="review_date"/>
                            <field name="views"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_knowledge_article_list" model="ir.ui.view">
        <field name="name">sf.knowledge.article.list</field>
        <field name="model">sf.knowledge.article</field>
        <field name="arch" type="xml">
            <list string="Knowledge Article Library" sample="1">
                <field name="title"/>
                <field name="category"/>
                <field name="content"/>
                <field name="author_id"/>
                <field name="review_date"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state in ('submitted','approved')"/>
            </list>
        </field>
    </record>
    <record id="view_sf_knowledge_article_kanban" model="ir.ui.view">
        <field name="name">sf.knowledge.article.kanban</field>
        <field name="model">sf.knowledge.article</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_view" group_by="state">
                <field name="name"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <menuitem id="menu_sf_knowledge_article_root" name="Knowledge Article Library" sequence="6"
              web_icon="sf_knowledge_articles,static/description/icon.png"/>
    <menuitem id="menu_sf_knowledge_article_main" name="Records"
              parent="menu_sf_knowledge_article_root" action="action_sf_knowledge_article" sequence="10"/>
</odoo>
