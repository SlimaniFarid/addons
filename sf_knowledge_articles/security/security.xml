<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_knowledge_articles" model="ir.module.category">
        <field name="name">Knowledge Article Library</field>
        <field name="sequence">50</field>
    </record>
    <record id="group_knowledge_articles_user" model="res.groups">
        <field name="name">Knowledge Article Library User</field>
        <field name="category_id" ref="module_category_knowledge_articles"/>

    </record>
    <record id="group_knowledge_articles_manager" model="res.groups">
        <field name="name">Knowledge Article Library Manager</field>
        <field name="category_id" ref="module_category_knowledge_articles"/>
        <field name="implied_ids" eval="[(4, ref('group_knowledge_articles_user'))]"/>
    </record>
    <record id="rule_knowledge_articles_sf_knowledge_article" model="ir.rule">
        <field name="name">Knowledge Article: multi-company</field>
        <field name="model_id" ref="model_sf_knowledge_article"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_knowledge_articles"/>
    </record>
</odoo>
