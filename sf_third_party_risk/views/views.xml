<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_third_party_risk" model="ir.actions.act_window">
        <field name="name">Third-Party Risk Assessment</field>
        <field name="res_model">sf.third_party_risk</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
    <record id="view_sf_third_party_risk_form" model="ir.ui.view">
        <field name="name">sf.third_party_risk.form</field>
        <field name="model">sf.third_party_risk</field>
        <field name="arch" type="xml">
            <form string="Third-Party Risk Assessment">
                <header>
                    <button name="action_submitted" type="object" string="Submitted"
                            class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="vendor_id"/>
                            <field name="data_access"/>
                            <field name="criticality"/>
                            <field name="risk_score"/>
                            <field name="mitigation"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_third_party_risk_list" model="ir.ui.view">
        <field name="name">sf.third_party_risk.list</field>
        <field name="model">sf.third_party_risk</field>
        <field name="arch" type="xml">
            <list string="Third-Party Risk Assessment" sample="1">
                <field name="vendor_id"/>
                <field name="data_access"/>
                <field name="criticality"/>
                <field name="risk_score"/>
                <field name="mitigation"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state in ('submitted','approved')"/>
            </list>
        </field>
    </record>
    <record id="view_sf_third_party_risk_kanban" model="ir.ui.view">
        <field name="name">sf.third_party_risk.kanban</field>
        <field name="model">sf.third_party_risk</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_view" group_by="state">
                <field name="name"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <menuitem id="menu_sf_third_party_risk_root" name="Third-Party Risk Assessment" sequence="13"
              web_icon="sf_third_party_risk,static/description/icon.png"/>
    <menuitem id="menu_sf_third_party_risk_main" name="Records"
              parent="menu_sf_third_party_risk_root" action="action_sf_third_party_risk" sequence="10"/>
</odoo>
