<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_third_party_risk" model="ir.module.category">
        <field name="name">Third-Party Risk Assessment</field>
        <field name="sequence">388</field>
    </record>
    <record id="group_third_party_risk_user" model="res.groups">
        <field name="name">Third-Party Risk Assessment User</field>
        <field name="category_id" ref="module_category_third_party_risk"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>

    </record>
    <record id="group_third_party_risk_manager" model="res.groups">
        <field name="name">Third-Party Risk Assessment Manager</field>
        <field name="category_id" ref="module_category_third_party_risk"/>
        <field name="implied_ids" eval="[(4, ref('group_third_party_risk_user'))]"/>
    </record>
    <record id="rule_third_party_risk_sf_third_party_risk" model="ir.rule">
        <field name="name">Third-Party Risk Assessment: multi-company</field>
        <field name="model_id" ref="model_sf_third_party_risk"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_third_party_risk"/>
    </record>
</odoo>
