<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_field_service_parts" model="ir.module.category">
        <field name="name">Field Service Parts Tracking</field>
        <field name="sequence">392</field>
    </record>
    <record id="group_field_service_parts_user" model="res.groups">
        <field name="name">Field Service Parts Tracking User</field>
        <field name="category_id" ref="module_category_field_service_parts"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>

    </record>
    <record id="group_field_service_parts_manager" model="res.groups">
        <field name="name">Field Service Parts Tracking Manager</field>
        <field name="category_id" ref="module_category_field_service_parts"/>
        <field name="implied_ids" eval="[(4, ref('group_field_service_parts_user'))]"/>
    </record>
    <record id="rule_field_service_parts_sf_field_service_parts" model="ir.rule">
        <field name="name">Field Service Parts Tracking: multi-company</field>
        <field name="model_id" ref="model_sf_field_service_parts"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_field_service_parts"/>
    </record>
</odoo>
