<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_exit_interviews" model="ir.module.category">
        <field name="name">Exit Interview Records</field>
        <field name="sequence">6</field>
    </record>
    <record id="group_exit_interviews_user" model="res.groups">
        <field name="name">Exit Interview Records User</field>
        <field name="category_id" ref="module_category_exit_interviews"/>

    </record>
    <record id="group_exit_interviews_manager" model="res.groups">
        <field name="name">Exit Interview Records Manager</field>
        <field name="category_id" ref="module_category_exit_interviews"/>
        <field name="implied_ids" eval="[(4, ref('group_exit_interviews_user'))]"/>
    </record>
    <record id="rule_exit_interviews_sf_exit_interview" model="ir.rule">
        <field name="name">Exit Interview: multi-company</field>
        <field name="model_id" ref="model_sf_exit_interview"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
