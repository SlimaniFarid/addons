<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_purchase_envelope" model="ir.module.category">
        <field name="name">Category Purchase Envelopes</field>
        <field name="sequence">34</field>
    </record>
    <record id="group_purchase_envelope_user" model="res.groups">
        <field name="name">Category Purchase Envelopes User</field>
        <field name="category_id" ref="module_category_purchase_envelope"/>
        <field name="implied_ids" eval="[(4, ref('purchase.group_purchase_user'))]"/>

    </record>
    <record id="group_purchase_envelope_manager" model="res.groups">
        <field name="name">Category Purchase Envelopes Manager</field>
        <field name="category_id" ref="module_category_purchase_envelope"/>
        <field name="implied_ids" eval="[(4, ref('group_purchase_envelope_user'))]"/>
    </record>
    <record id="rule_purchase_envelope_sf_purchase_envelope" model="ir.rule">
        <field name="name">Purchase Envelope: multi-company</field>
        <field name="model_id" ref="model_sf_purchase_envelope"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_purchase_envelope"/>
    </record>
</odoo>
