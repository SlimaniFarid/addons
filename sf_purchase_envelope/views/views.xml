<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_purchase_envelope" model="ir.actions.act_window">
        <field name="name">Category Purchase Envelopes</field>
        <field name="res_model">sf.purchase.envelope</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
    <record id="view_sf_purchase_envelope_form" model="ir.ui.view">
        <field name="name">sf.purchase.envelope.form</field>
        <field name="model">sf.purchase.envelope</field>
        <field name="arch" type="xml">
            <form string="Category Purchase Envelopes">
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="open,closed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="category_name"/>
                            <field name="fiscal_year"/>
                            <field name="envelope_amount"/>
                            <field name="committed"/>
                            <field name="consumed"/>
                            <field name="owner_id"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_purchase_envelope_list" model="ir.ui.view">
        <field name="name">sf.purchase.envelope.list</field>
        <field name="model">sf.purchase.envelope</field>
        <field name="arch" type="xml">
            <list string="Category Purchase Envelopes" sample="1">
                <field name="category_name"/>
                <field name="fiscal_year"/>
                <field name="envelope_amount"/>
                <field name="committed"/>
                <field name="consumed"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state in ('submitted','approved')"/>
            </list>
        </field>
    </record>
    <record id="view_sf_purchase_envelope_kanban" model="ir.ui.view">
        <field name="name">sf.purchase.envelope.kanban</field>
        <field name="model">sf.purchase.envelope</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_view" group_by="state">
                <field name="name"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <menuitem id="menu_sf_purchase_envelope_root" name="Category Purchase Envelopes" sequence="22"
              web_icon="sf_purchase_envelope,static/description/icon.png"/>
    <menuitem id="menu_sf_purchase_envelope_main" name="Records"
              parent="menu_sf_purchase_envelope_root" action="action_sf_purchase_envelope" sequence="10"/>

    <record id="wave_final_sf_purchase_envelope" model="ir.actions.server">
        <field name="name">Refresh Business Data</field>
        <field name="model_id" ref="model_sf_purchase_envelope"/>
        <field name="binding_model_id" ref="model_sf_purchase_envelope"/>
        <field name="state">code</field>
        <field name="code">records.action_refresh_business()</field>
    </record>
</odoo>
