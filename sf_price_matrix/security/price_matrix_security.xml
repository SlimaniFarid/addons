<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_price_matrix" model="ir.module.category">
        <field name="name">Price Matrix</field>
        <field name="sequence">90</field>
    </record>

    <record id="group_price_matrix_user" model="res.groups">
        <field name="name">Price Matrix User</field>
        <field name="category_id" ref="module_category_price_matrix"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_price_matrix_manager" model="res.groups">
        <field name="name">Price Matrix Manager</field>
        <field name="category_id" ref="module_category_price_matrix"/>
        <field name="implied_ids" eval="[(4, ref('group_price_matrix_user'))]"/>
    </record>
    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_price_matrix"/>
    </record>
</odoo>