<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Category form -->
    <record id="price_matrix_category_view_form" model="ir.ui.view">
        <field name="name">sf.price.matrix.category.form</field>
        <field name="model">sf.price.matrix.category</field>
        <field name="arch" type="xml">
            <form string="Customer Category">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="default_discount"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="description"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Price Rules">
                            <field name="rule_ids">
                                <tree string="Price Rules" editable="bottom">
                                    <field name="product_id"/>
                                    <field name="tier_ids" widget="many2many_tags"/>
                                    <field name="max_discount"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="price_matrix_category_view_tree" model="ir.ui.view">
        <field name="name">sf.price.matrix.category.tree</field>
        <field name="model">sf.price.matrix.category</field>
        <field name="arch" type="xml">
            <tree string="Customer Categories">
                <field name="name"/>
                <field name="code"/>
                <field name="default_discount"/>
            </tree>
        </field>
    </record>

    <!-- Tier -->
    <record id="price_matrix_tier_view_form" model="ir.ui.view">
        <field name="name">sf.price.matrix.tier.form</field>
        <field name="model">sf.price.matrix.tier</field>
        <field name="arch" type="xml">
            <form string="Discount Tier">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="sequence"/>
                            <field name="min_qty"/>
                        </group>
                        <group>
                            <field name="discount"/>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="price_matrix_tier_view_tree" model="ir.ui.view">
        <field name="name">sf.price.matrix.tier.tree</field>
        <field name="model">sf.price.matrix.tier</field>
        <field name="arch" type="xml">
            <tree string="Discount Tiers">
                <field name="name"/>
                <field name="min_qty"/>
                <field name="discount"/>
            </tree>
        </field>
    </record>

    <!-- Rule -->
    <record id="price_matrix_rule_view_form" model="ir.ui.view">
        <field name="name">sf.price.matrix.rule.form</field>
        <field name="model">sf.price.matrix.rule</field>
        <field name="arch" type="xml">
            <form string="Price Rule">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="product_id"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="category_id"/>
                            <field name="product_id"/>
                        </group>
                        <group>
                            <field name="tier_ids" widget="many2many_tags"/>
                            <field name="max_discount"/>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="price_matrix_rule_view_tree" model="ir.ui.view">
        <field name="name">sf.price.matrix.rule.tree</field>
        <field name="model">sf.price.matrix.rule</field>
        <field name="arch" type="xml">
            <tree string="Price Rules">
                <field name="category_id"/>
                <field name="product_id"/>
                <field name="tier_ids" widget="many2many_tags"/>
                <field name="max_discount"/>
            </tree>
        </field>
    </record>

    <!-- Inherited partner form -->
    <record id="price_matrix_partner_view_form_ext" model="ir.ui.view">
        <field name="name">res.partner.form.sf</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/group" position="inside">
                <group string="Price Matrix" colspan="2">
                    <field name="price_matrix_category_id"/>
                </group>
            </xpath>
        </field>
    </record>

    <!-- Inherited sale order form -->
    <record id="price_matrix_sale_order_view_form_ext" model="ir.ui.view">
        <field name="name">sale.order.form.sf</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']/ancestor::group[1]" position="inside">
                <field name="price_matrix_category_id"/>
            </xpath>
        </field>
    </record>

    <!-- Actions -->
    <record id="action_price_matrix_category" model="ir.actions.act_window">
        <field name="name">Customer Categories</field>
        <field name="res_model">sf.price.matrix.category</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record id="action_price_matrix_tier" model="ir.actions.act_window">
        <field name="name">Discount Tiers</field>
        <field name="res_model">sf.price.matrix.tier</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record id="action_price_matrix_rule" model="ir.actions.act_window">
        <field name="name">Price Rules</field>
        <field name="res_model">sf.price.matrix.rule</field>
        <field name="view_mode">tree,form</field>
    </record>

</odoo>