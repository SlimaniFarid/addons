<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sf_courier_route_view_list" model="ir.ui.view">
        <field name="name">sf.courier.route.list</field>
        <field name="model">sf.courier.route</field>
        <field name="arch" type="xml">
            <list string="Routes">
                <field name="name"/>
                <field name="courier_id"/>
                <field name="date"/>
                <field name="state" widget="badge"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="sf_courier_route_view_form" model="ir.ui.view">
        <field name="name">sf.courier.route.form</field>
        <field name="model">sf.courier.route</field>
        <field name="arch" type="xml">
            <form string="Route">
                <header>
                    <button name="action_plan" string="Plan" type="object" class="btn-primary" invisible="[('state', '!=', 'draft')]"/>
                    <button name="action_start" string="Start Route" type="object" class="btn-primary" invisible="[('state', '!=', 'planned')]"/>
                    <button name="action_done" string="Close Route" type="object" class="btn-primary" invisible="[('state', '!=', 'in_progress')]"/>
                    <button name="action_cancel" string="Cancel Route" type="object" invisible="[('state', 'in', ('done', 'cancelled'))]"/>
                    <field name="state" widget="statusbar" readonly="1"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="courier_id"/>
                            <field name="date"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group string="Deliveries">
                        <field name="delivery_ids">
                            <list string="Deliveries">
                                <field name="name"/>
                                <field name="order_id"/>
                                <field name="state" widget="badge"/>
                            </list>
                        </field>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="sf_courier_route_view_search" model="ir.ui.view">
        <field name="name">sf.courier.route.search</field>
        <field name="model">sf.courier.route</field>
        <field name="arch" type="xml">
            <search string="Routes">
                <field name="name"/>
                <field name="courier_id"/>
                <filter name="route_planned" string="Planned" domain="[('state', '=', 'planned')]"/>
                <filter name="route_in_progress" string="In Progress" domain="[('state', '=', 'in_progress')]"/>
                <group>
                    <filter name="group_route_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_route_courier" string="Courier" context="{'group_by': 'courier_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_sf_courier_route" model="ir.actions.act_window">
        <field name="name">Routes</field>
        <field name="res_model">sf.courier.route</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="sf_courier_route_view_search"/>
    </record>

    <record id="view_sf_courier_delivery_boost_kanban" model="ir.ui.view">
        <field name="name">sf_courier_delivery.boost.kanban</field>
        <field name="model">sf.courier.activity.mixin</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" t-att-color="state">
                <field name="name"/>
                <field name="state"/>
                <field name="user_id"/>

                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_card oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title">
                                    <field name="name"/></strong>
                                <div class="o_kanban_record_subtitle">
                                    <field name="user_id" widget="many2one_avatar_user"/>
                                    <field name="create_date"/></div>
                            </div>
                            <div class="oe_kanban_bottom_right">
                                <field name="state" widget="badge"
                                       t-attf-options="{'classes_map': {'draft': 'info', 'done': 'success', 'cancelled': 'danger'}, 'domain': []}"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_sf_courier_delivery_boost_search" model="ir.ui.view">
        <field name="name">sf_courier_delivery.boost.search</field>
        <field name="model">sf.courier.activity.mixin</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
<separator/>
                <filter string="My records" name="my_records" domain="[('user_id', '=', uid)]"/>
                <filter string="To Do" name="todo" domain="[('state', 'not in', ('done', 'cancelled', 'closed'))]"/>
                <group expand="0" string="Group By"><filter string="Status" name="gb_state" context="{'group_by': 'state'}"/></group>
            </search>
        </field>
    </record>
</odoo>
