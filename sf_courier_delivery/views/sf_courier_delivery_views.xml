<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sf_courier_delivery_view_list" model="ir.ui.view">
        <field name="name">sf.courier.delivery.list</field>
        <field name="model">sf.courier.delivery</field>
        <field name="arch" type="xml">
            <list string="Deliveries">
                <field name="name"/>
                <field name="order_id"/>
                <field name="courier_id"/>
                <field name="route_id"/>
                <field name="parcel_description"/>
                <field name="weight_kg"/>
                <field name="price"/>
                <field name="state" widget="badge"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="sf_courier_delivery_view_form" model="ir.ui.view">
        <field name="name">sf.courier.delivery.form</field>
        <field name="model">sf.courier.delivery</field>
        <field name="arch" type="xml">
            <form string="Delivery">
                <header>
                    <button name="action_assign" string="Assign" type="object" class="btn-primary" invisible="[('state', '!=', 'draft')]"/>
                    <button name="action_start" string="Start Delivery" type="object" class="btn-primary" invisible="[('state', '!=', 'assigned')]"/>
                    <button name="action_deliver" string="Deliver" type="object" class="btn-primary" invisible="[('state', '!=', 'in_transit')]"/>
                    <button name="action_fail" string="Fail" type="object" invisible="[('state', 'not in', ('assigned', 'in_transit'))]"/>
                    <button name="action_retry" string="Retry" type="object" class="btn-primary" invisible="[('state', '!=', 'failed')]"/>
                    <button name="action_return" string="Return Parcel" type="object" invisible="[('state', '!=', 'failed')]"/>
                    <button name="action_cancel" string="Cancel Delivery" type="object" invisible="[('state', 'in', ('delivered', 'returned', 'cancelled'))]"/>
                    <field name="state" widget="statusbar" readonly="1"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="order_id"/>
                            <field name="courier_id"/>
                            <field name="route_id"/>
                        </group>
                        <group>
                            <field name="parcel_description"/>
                            <field name="weight_kg"/>
                            <field name="price"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group string="Delivery Proof">
                        <field name="proof_type"/>
                        <field name="proof_signature" widget="binary"/>
                        <field name="proof_photo" widget="image"/>
                        <field name="delivery_date"/>
                    </group>
                    <group string="Failure &amp; Return">
                        <field name="failure_reason"/>
                        <field name="return_date"/>
                    </group>
                    <group string="Attempts">
                        <field name="attempt_ids">
                            <list string="Attempts">
                                <field name="name"/>
                                <field name="attempt_date"/>
                                <field name="result"/>
                                <field name="failure_reason"/>
                                <field name="notes"/>
                            </list>
                        </field>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="sf_courier_delivery_view_search" model="ir.ui.view">
        <field name="name">sf.courier.delivery.search</field>
        <field name="model">sf.courier.delivery</field>
        <field name="arch" type="xml">
            <search string="Deliveries">
                <field name="name"/>
                <field name="courier_id"/>
                <field name="order_id"/>
                <filter name="delivery_in_transit" string="In Transit" domain="[('state', '=', 'in_transit')]"/>
                <filter name="delivery_failed" string="Failed" domain="[('state', '=', 'failed')]"/>
                <filter name="delivery_delivered" string="Delivered" domain="[('state', '=', 'delivered')]"/>
                <group>
                    <filter name="group_delivery_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_delivery_courier" string="Courier" context="{'group_by': 'courier_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_sf_courier_delivery" model="ir.actions.act_window">
        <field name="name">Deliveries</field>
        <field name="res_model">sf.courier.delivery</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="sf_courier_delivery_view_search"/>
    </record>
</odoo>