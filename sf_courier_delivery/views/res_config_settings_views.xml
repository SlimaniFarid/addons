<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_courier" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.courier</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Courier" string="Courier" name="sf_courier_delivery">
                    <block title="Courier Settings">
                        <setting string="Default Delivery Price">
                            <field name="sf_courier_default_price"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>