<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_delivery_ticket">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-set="company" t-value="o.company_id or res_company"/>
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>Delivery Ticket</h2>
                        <table class="table table-sm">
                            <tr><th>Delivery</th><td><span t-field="o.name"/></td></tr>
                            <tr><th>Customer</th><td><span t-field="o.order_id.partner_id"/></td></tr>
                            <tr><th>Courier</th><td><span t-field="o.courier_id"/></td></tr>
                            <tr><th>Parcel</th><td><span t-field="o.parcel_description"/></td></tr>
                            <tr><th>Delivery Date</th><td><span t-field="o.delivery_date"/></td></tr>
                            <tr><th>Proof</th><td><span t-field="o.proof_type"/></td></tr>
                            <tr><th>Price</th><td><span t-field="o.price"/></td></tr>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>