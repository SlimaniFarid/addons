<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="module_category_sf_courier" model="ir.module.category">
            <field name="name">Courier</field>
            <field name="description">Courier &amp; Parcel Delivery Management.</field>
            <field name="sequence">10</field>
        </record>

        <record id="group_sf_courier_user" model="res.groups">
            <field name="name">Courier / User</field>
            <field name="category_id" ref="module_category_sf_courier"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_sf_courier_manager" model="res.groups">
            <field name="name">Courier / Manager</field>
            <field name="category_id" ref="module_category_sf_courier"/>
            <field name="implied_ids" eval="[(4, ref('sf_courier_delivery.group_sf_courier_user'))]"/>
        </record>

        <record id="rule_sf_courier_order_company" model="ir.rule">
            <field name="name">Courier Request: user sees own company</field>
            <field name="model_id" ref="model_sf_courier_order"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('sf_courier_delivery.group_sf_courier_user'))]"/>
        </record>
        <record id="rule_sf_courier_order_manager_all" model="ir.rule">
            <field name="name">Courier Request: manager sees all companies</field>
            <field name="model_id" ref="model_sf_courier_order"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('sf_courier_delivery.group_sf_courier_manager'))]"/>
        </record>

        <record id="rule_sf_courier_delivery_company" model="ir.rule">
            <field name="name">Courier Delivery: user sees own company</field>
            <field name="model_id" ref="model_sf_courier_delivery"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('sf_courier_delivery.group_sf_courier_user'))]"/>
        </record>
        <record id="rule_sf_courier_delivery_manager_all" model="ir.rule">
            <field name="name">Courier Delivery: manager sees all companies</field>
            <field name="model_id" ref="model_sf_courier_delivery"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('sf_courier_delivery.group_sf_courier_manager'))]"/>
        </record>

        <record id="rule_sf_courier_route_company" model="ir.rule">
            <field name="name">Courier Route: user sees own company</field>
            <field name="model_id" ref="model_sf_courier_route"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('sf_courier_delivery.group_sf_courier_user'))]"/>
        </record>
        <record id="rule_sf_courier_route_manager_all" model="ir.rule">
            <field name="name">Courier Route: manager sees all companies</field>
            <field name="model_id" ref="model_sf_courier_route"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('sf_courier_delivery.group_sf_courier_manager'))]"/>
        </record>

        <record id="rule_sf_courier_attempt_company" model="ir.rule">
            <field name="name">Courier Attempt: user sees own company</field>
            <field name="model_id" ref="model_sf_courier_delivery_attempt"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('sf_courier_delivery.group_sf_courier_user'))]"/>
        </record>
        <record id="rule_sf_courier_attempt_manager_all" model="ir.rule">
            <field name="name">Courier Attempt: manager sees all companies</field>
            <field name="model_id" ref="model_sf_courier_delivery_attempt"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('sf_courier_delivery.group_sf_courier_manager'))]"/>
        </record>
    </data>
</odoo>