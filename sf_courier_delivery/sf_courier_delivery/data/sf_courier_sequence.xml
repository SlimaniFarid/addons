<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_sf_courier_order" model="ir.sequence">
            <field name="name">Courier Request</field>
            <field name="code">sf.courier.order</field>
            <field name="prefix">CR-</field>
            <field name="padding">5</field>
        </record>
        <record id="seq_sf_courier_delivery" model="ir.sequence">
            <field name="name">Courier Delivery</field>
            <field name="code">sf.courier.delivery</field>
            <field name="prefix">DLV-</field>
            <field name="padding">6</field>
        </record>
        <record id="seq_sf_courier_route" model="ir.sequence">
            <field name="name">Courier Route</field>
            <field name="code">sf.courier.route</field>
            <field name="prefix">RT-</field>
            <field name="padding">5</field>
        </record>
        <record id="seq_sf_courier_attempt" model="ir.sequence">
            <field name="name">Courier Delivery Attempt</field>
            <field name="code">sf.courier.delivery.attempt</field>
            <field name="prefix">ATT-</field>
            <field name="padding">6</field>
        </record>
    </data>
</odoo>