<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_disputes_list">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-set="company" t-value="o.company_id or res_company"/>
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>Disputes List</h2>
                        <table class="table table-sm">
                            <tr><th>Delivery</th><th>Request</th><th>Courier</th><th>Failure Reason</th><th>Return Date</th></tr>
                            <tr t-foreach="o" t-as="d">
                                <td><span t-field="d.name"/></td>
                                <td><span t-field="d.order_id"/></td>
                                <td><span t-field="d.courier_id"/></td>
                                <td><span t-field="d.failure_reason"/></td>
                                <td><span t-field="d.return_date"/></td>
                            </tr>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>