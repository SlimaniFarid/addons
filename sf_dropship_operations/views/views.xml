<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_dropship_order" model="ir.actions.act_window">
        <field name="name">Dropshipping Operations Log</field>
        <field name="res_model">sf.dropship.order</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
    <record id="view_sf_dropship_order_form" model="ir.ui.view">
        <field name="name">sf.dropship.order.form</field>
        <field name="model">sf.dropship.order</field>
        <field name="arch" type="xml">
            <form string="Dropshipping Operations Log">
                <header>
                    <button name="action_notified" type="object" string="Notified"
                            class="btn-primary"/>
                    <button name="action_shipped" type="object" string="Shipped"
                            class="btn-primary"/>
                    <button name="action_delivered" type="object" string="Delivered"
                            class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="pending,notified,shipped,delivered,issue"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="vendor_id"/>
                            <field name="product_desc"/>
                            <field name="supplier_tracking"/>
                            <field name="notified_date"/>
                            <field name="delivered_date"/>
                            <field name="issues"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_dropship_order_list" model="ir.ui.view">
        <field name="name">sf.dropship.order.list</field>
        <field name="model">sf.dropship.order</field>
        <field name="arch" type="xml">
            <list string="Dropshipping Operations Log" sample="1">
                <field name="partner_id"/>
                <field name="vendor_id"/>
                <field name="product_desc"/>
                <field name="supplier_tracking"/>
                <field name="notified_date"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state in ('submitted','approved')"/>
            </list>
        </field>
    </record>
    <record id="view_sf_dropship_order_kanban" model="ir.ui.view">
        <field name="name">sf.dropship.order.kanban</field>
        <field name="model">sf.dropship.order</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_view" group_by="state">
                <field name="name"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <menuitem id="menu_sf_dropship_order_root" name="Dropshipping Operations Log" sequence="26"
              web_icon="sf_dropship_operations,static/description/icon.png"/>
    <menuitem id="menu_sf_dropship_order_main" name="Records"
              parent="menu_sf_dropship_order_root" action="action_sf_dropship_order" sequence="10"/>
</odoo>
