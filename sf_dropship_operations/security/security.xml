<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_dropship_operations" model="ir.module.category">
        <field name="name">Dropshipping Operations Log</field>
        <field name="sequence">33</field>
    </record>
    <record id="group_dropship_operations_user" model="res.groups">
        <field name="name">Dropshipping Operations Log User</field>
        <field name="category_id" ref="module_category_dropship_operations"/>
        <field name="implied_ids" eval="[(4, ref('stock.group_stock_user'))]"/>

    </record>
    <record id="group_dropship_operations_manager" model="res.groups">
        <field name="name">Dropshipping Operations Log Manager</field>
        <field name="category_id" ref="module_category_dropship_operations"/>
        <field name="implied_ids" eval="[(4, ref('group_dropship_operations_user'))]"/>
    </record>
    <record id="rule_dropship_operations_sf_dropship_order" model="ir.rule">
        <field name="name">Dropship Order: multi-company</field>
        <field name="model_id" ref="model_sf_dropship_order"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_dropship_operations"/>
    </record>
</odoo>
