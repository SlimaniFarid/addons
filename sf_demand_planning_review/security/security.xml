<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_demand_planning_review" model="ir.module.category">
        <field name="name">Demand Planning Review</field>
        <field name="sequence">283</field>
    </record>
    <record id="group_demand_planning_review_user" model="res.groups">
        <field name="name">Demand Planning Review User</field>
        <field name="category_id" ref="module_category_demand_planning_review"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>

    </record>
    <record id="group_demand_planning_review_manager" model="res.groups">
        <field name="name">Demand Planning Review Manager</field>
        <field name="category_id" ref="module_category_demand_planning_review"/>
        <field name="implied_ids" eval="[(4, ref('group_demand_planning_review_user'))]"/>
    </record>
    <record id="rule_demand_planning_review_sf_demand_planning_review" model="ir.rule">
        <field name="name">Demand Planning Review: multi-company</field>
        <field name="model_id" ref="model_sf_demand_planning_review"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
