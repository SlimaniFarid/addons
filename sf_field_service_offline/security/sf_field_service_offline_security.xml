<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_sf_field_service_offline" model="ir.module.category">
        <field name="name">Field Service Offline</field>
        <field name="description">Field Service Offline Management</field>
        <field name="sequence">10</field>
    </record>

    <record id="group_sf_field_service_offline_user" model="res.groups">
        <field name="name">Field Service Offline / User</field>
        <field name="category_id" ref="module_category_sf_field_service_offline"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_sf_field_service_offline_manager" model="res.groups">
        <field name="name">Field Service Offline / Manager</field>
        <field name="category_id" ref="module_category_sf_field_service_offline"/>
        <field name="implied_ids" eval="[(4, ref('sf_field_service_offline.group_sf_field_service_offline_user'))]"/>
    </record>

    <record id="rule_sf_field_service_offline_company" model="ir.rule">
        <field name="name">Field Service Offline: user sees own company</field>
        <field name="model_id" ref="model_sf_field_service_offline"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('sf_field_service_offline.group_sf_field_service_offline_user'))]"/>
    </record>
    <record id="rule_sf_field_service_offline_manager_all" model="ir.rule">
        <field name="name">Field Service Offline: manager sees all companies</field>
        <field name="model_id" ref="model_sf_field_service_offline"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('sf_field_service_offline.group_sf_field_service_offline_manager'))]"/>
    </record>
    <record id="group_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="module_category_sf_field_service_offline"/>
    </record>
    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_sf_field_service_offline"/>
    </record>
    <record id="group_system" model="res.groups">
        <field name="name">System</field>
        <field name="category_id" ref="module_category_sf_field_service_offline"/>
    </record>
</odoo>