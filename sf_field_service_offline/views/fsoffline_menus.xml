<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_fsoffline_technician" model="ir.actions.act_window">
        <field name="name">Technicians</field>
        <field name="res_model">fsoffline.technician</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_fsoffline_sync_log" model="ir.actions.act_window">
        <field name="name">Sync Logs</field>
        <field name="res_model">fsoffline.sync.log</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_group_by_state': 1}</field>
    </record>
    <record id="action_fsoffline_workorder_cache" model="ir.actions.act_window">
        <field name="name">Cached Work Orders</field>
        <field name="res_model">fsoffline.workorder.cache</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_fsoffline_technician_form" model="ir.ui.view">
        <field name="name">fsoffline.technician.form</field>
        <field name="model">fsoffline.technician</field>
        <field name="arch" type="xml">
            <form string="Offline Technician">
                <header>
                    <button name="action_sync_now" type="object" string="Sync Now" class="btn-primary"/>
                    <button name="action_reset_cache" type="object" string="Reset Cache" class="btn-secondary"/>
                </header>
                <sheet>
                    <div class="oe_button_box">
                        <button name="toggle_active" type="object" class="oe_stat_button" icon="fa-power-off">
                            <field name="active" widget="boolean_toggle" options="{'terminology': {'on': 'Active', 'off': 'Inactive'}}"/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="user_id"/>
                            <field name="employee_id"/>
                            <field name="device_id"/>
                            <field name="device_model"/>
                            <field name="device_os"/>
                            <field name="app_version"/>
                        </group>
                        <group string="Sync Status">
                            <field name="sync_status" readonly="1"/>
                            <field name="last_sync" readonly="1"/>
                            <field name="pending_changes" readonly="1"/>
                            <field name="last_conflict" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <group string="Capabilities">
                            <field name="has_gps"/>
                            <field name="has_camera"/>
                            <field name="has_barcode"/>
                        </group>
                        <group string="Cache">
                            <field name="cache_updated" readonly="1"/>
                            <field name="workorder_count" readonly="1"/>
                            <field name="equipment_count" readonly="1"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_fsoffline_technician_list" model="ir.ui.view">
        <field name="name">fsoffline.technician.list</field>
        <field name="model">fsoffline.technician</field>
        <field name="arch" type="xml">
            <list string="Offline Technicians">
                <field name="user_id"/>
                <field name="employee_id"/>
                <field name="device_model"/>
                <field name="app_version"/>
                <field name="sync_status"/>
                <field name="pending_changes"/>
                <field name="last_sync"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_fsoffline_sync_log_form" model="ir.ui.view">
        <field name="name">fsoffline.sync.log.form</field>
        <field name="model">fsoffline.sync.log</field>
        <field name="arch" type="xml">
            <form string="Sync Log" create="false" edit="false">
                <group>
                    <group>
                        <field name="technician_id"/>
                        <field name="direction"/>
                        <field name="state"/>
                    </group>
                    <group>
                        <field name="records_pushed"/>
                        <field name="records_pulled"/>
                        <field name="conflicts_detected"/>
                        <field name="duration_ms"/>
                    </group>
                </group>
                <group string="Conflict Details" invisible="not conflicts_detected">
                    <field name="conflict_details" widget="text"/>
                </group>
                <group string="Error" invisible="state != 'failed'">
                    <field name="error_message" widget="text"/>
                </group>
            </form>
        </field>
    </record>
    <record id="view_fsoffline_sync_log_list" model="ir.ui.view">
        <field name="name">fsoffline.sync.log.list</field>
        <field name="model">fsoffline.sync.log</field>
        <field name="arch" type="xml">
            <list string="Sync Logs">
                <field name="create_date"/>
                <field name="technician_id"/>
                <field name="direction"/>
                <field name="state"/>
                <field name="records_pushed"/>
                <field name="records_pulled"/>
                <field name="conflicts_detected"/>
            </list>
        </field>
    </record>

    <record id="view_fsoffline_workorder_cache_form" model="ir.ui.view">
        <field name="name">fsoffline.workorder.cache.form</field>
        <field name="model">fsoffline.workorder.cache</field>
        <field name="arch" type="xml">
            <form string="Cached Work Order">
                <group>
                    <field name="technician_id"/>
                    <field name="workorder_id"/>
                    <field name="cached_data" widget="text"/>
                    <field name="cached_at"/>
                    <field name="is_dirty" widget="boolean"/>
                    <field name="local_version"/>
                    <field name="server_version"/>
                </group>
            </form>
        </field>
    </record>
    <record id="view_fsoffline_workorder_cache_list" model="ir.ui.view">
        <field name="name">fsoffline.workorder.cache.list</field>
        <field name="model">fsoffline.workorder.cache</field>
        <field name="arch" type="xml">
            <list string="Cached Work Orders">
                <field name="technician_id"/>
                <field name="workorder_id"/>
                <field name="cached_at"/>
                <field name="is_dirty" widget="boolean"/>
                <field name="local_version"/>
                <field name="server_version"/>
            </list>
        </field>
    </record>

    <menuitem id="menu_fsoffline_root" name="Field Service Offline" sequence="65" web_icon="sf_field_service_offline,static/description/icon.png"/>
    <menuitem id="menu_fsoffline_technicians" name="Technicians" parent="menu_fsoffline_root" action="action_fsoffline_technician" sequence="10"/>
    <menuitem id="menu_fsoffline_cache" name="Cached Work Orders" parent="menu_fsoffline_root" action="action_fsoffline_workorder_cache" sequence="20"/>
    <menuitem id="menu_fsoffline_logs" name="Sync Logs" parent="menu_fsoffline_root" action="action_fsoffline_sync_log" sequence="30"/>

    <record id="wave_final_sf_field_service_offline" model="ir.actions.server">
        <field name="name">Refresh Business Data</field>
        <field name="model_id" ref="model_fsoffline_technician"/>
        <field name="binding_model_id" ref="model_fsoffline_technician"/>
        <field name="state">code</field>
        <field name="code">records.action_refresh_business()</field>
    </record>
</odoo>