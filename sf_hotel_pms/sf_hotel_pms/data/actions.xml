<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_sf_hotel_room" model="ir.sequence">
            <field name="name">Hotel Room</field>
            <field name="code">sf.hotel.room</field>
            <field name="prefix">ROM-</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>

        <record id="seq_sf_hotel_reservation" model="ir.sequence">
            <field name="name">Hotel Reservation</field>
            <field name="code">sf.hotel.reservation</field>
            <field name="prefix">RES-</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>

        <record id="seq_sf_hotel_extra" model="ir.sequence">
            <field name="name">Hotel Extra</field>
            <field name="code">sf.hotel.extra</field>
            <field name="prefix">EXT-</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>

        <record id="seq_sf_hotel_housekeeping" model="ir.sequence">
            <field name="name">Hotel Housekeeping</field>
            <field name="code">sf.hotel.housekeeping</field>
            <field name="prefix">HSK-</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>

        <record id="cron_sf_hotel_alerts" model="ir.cron">
            <field name="name">Hotel PMS: Daily Departure and Housekeeping Alerts</field>
            <field name="model_id" ref="model_sf_hotel_reservation"/>
            <field name="state">code</field>
            <field name="code">model._check_departures_and_housekeeping()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="active">True</field>
        </record>
    </data>
</odoo>