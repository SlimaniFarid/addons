<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============ ROOM ============ -->
    <record id="view_sf_hotel_room_tree" model="ir.ui.view">
        <field name="name">sf.hotel.room.tree</field>
        <field name="model">sf.hotel.room</field>
        <field name="arch" type="xml">
            <tree string="Rooms">
                <field name="name"/>
                <field name="number"/>
                <field name="floor"/>
                <field name="room_type"/>
                <field name="capacity"/>
                <field name="base_price"/>
                <field name="status"/>
            </tree>
        </field>
    </record>

    <record id="view_sf_hotel_room_form" model="ir.ui.view">
        <field name="name">sf.hotel.room.form</field>
        <field name="model">sf.hotel.room</field>
        <field name="arch" type="xml">
            <form string="Room">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="number"/>
                            <field name="floor"/>
                        </group>
                        <group>
                            <field name="room_type"/>
                            <field name="capacity"/>
                            <field name="base_price"/>
                            <field name="status"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Housekeeping">
                            <field name="housekeeping_ids" readonly="1">
                                <tree string="Housekeeping tasks">
                                    <field name="name"/>
                                    <field name="date"/>
                                    <field name="task_type"/>
                                    <field name="assigned_to"/>
                                    <field name="state"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_sf_hotel_room_search" model="ir.ui.view">
        <field name="name">sf.hotel.room.search</field>
        <field name="model">sf.hotel.room</field>
        <field name="arch" type="xml">
            <search string="Rooms">
                <field name="name"/>
                <field name="number"/>
                <field name="floor"/>
                <field name="room_type"/>
                <filter string="Available" name="available"
                        domain="[('status', '=', 'available')]"/>
                <filter string="Occupied" name="occupied"
                        domain="[('status', '=', 'occupied')]"/>
                <filter string="Reserved" name="reserved"
                        domain="[('status', '=', 'reserved')]"/>
                <group expand="0" string="Group By">
                    <filter string="Status" name="status_group"
                            context="{'group_by': 'status'}"/>
                    <filter string="Type" name="type_group"
                            context="{'group_by': 'room_type'}"/>
                    <filter string="Floor" name="floor_group"
                            context="{'group_by': 'floor'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_sf_hotel_room" model="ir.actions.act_window">
        <field name="name">Rooms</field>
        <field name="res_model">sf.hotel.room</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_sf_hotel_room_search"/>
    </record>

    <!-- ============ RESERVATION ============ -->
    <record id="view_sf_hotel_reservation_tree" model="ir.ui.view">
        <field name="name">sf.hotel.reservation.tree</field>
        <field name="model">sf.hotel.reservation</field>
        <field name="arch" type="xml">
            <tree string="Reservations">
                <field name="name"/>
                <field name="guest_name"/>
                <field name="guest_id"/>
                <field name="room_ids"/>
                <field name="check_in"/>
                <field name="check_out"/>
                <field name="nights"/>
                <field name="total"/>
                <field name="status"/>
            </tree>
        </field>
    </record>

    <record id="view_sf_hotel_reservation_form" model="ir.ui.view">
        <field name="name">sf.hotel.reservation.form</field>
        <field name="model">sf.hotel.reservation</field>
        <field name="arch" type="xml">
            <form string="Reservation">
                <header>
                    <button name="action_reservation_confirm" type="object"
                            string="Confirm" class="btn-primary"
                            invisible="status != 'draft'"/>
                    <button name="action_check_in" type="object"
                            string="Check In" class="btn-success"
                            invisible="status != 'confirmed'"
                            groups="sf_hotel_pms.group_sf_hotel_manager"/>
                    <button name="action_check_out" type="object"
                            string="Check Out" class="btn-warning"
                            invisible="status != 'checked_in'"
                            groups="sf_hotel_pms.group_sf_hotel_manager"/>
                    <button name="action_cancel" type="object"
                            string="Cancel"
                            invisible="status not in ('draft', 'confirmed')"/>
                    <field name="status" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="guest_id"/>
                            <field name="guest_name"
                                   invisible="guest_id != False"/>
                            <field name="guest_count"/>
                        </group>
                        <group>
                            <field name="check_in"/>
                            <field name="check_out"/>
                            <field name="nights"/>
                            <field name="total"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group>
                        <field name="room_ids"/>
                    </group>
                    <notebook>
                        <page string="Extras">
                            <field name="extra_ids">
                                <tree string="Extras" editable="bottom">
                                    <field name="name"/>
                                    <field name="description"/>
                                    <field name="amount"/>
                                    <field name="date"/>
                                    <field name="state"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_sf_hotel_reservation_search" model="ir.ui.view">
        <field name="name">sf.hotel.reservation.search</field>
        <field name="model">sf.hotel.reservation</field>
        <field name="arch" type="xml">
            <search string="Reservations">
                <field name="name"/>
                <field name="guest_name"/>
                <field name="guest_id"/>
                <field name="room_ids"/>
                <filter string="Confirmed" name="confirmed"
                        domain="[('status', '=', 'confirmed')]"/>
                <filter string="Checked In" name="checked_in"
                        domain="[('status', '=', 'checked_in')]"/>
                <filter string="Departing today" name="departing_today"
                        domain="[('check_out', '=', context_today()), ('status', '=', 'confirmed')]"/>
                <group expand="0" string="Group By">
                    <filter string="Status" name="status_group"
                            context="{'group_by': 'status'}"/>
                    <filter string="Check-in" name="checkin_group"
                            context="{'group_by': 'check_in'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_sf_hotel_reservation" model="ir.actions.act_window">
        <field name="name">Reservations</field>
        <field name="res_model">sf.hotel.reservation</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_sf_hotel_reservation_search"/>
    </record>

    <!-- ============ EXTRA ============ -->
    <record id="view_sf_hotel_extra_tree" model="ir.ui.view">
        <field name="name">sf.hotel.extra.tree</field>
        <field name="model">sf.hotel.extra</field>
        <field name="arch" type="xml">
            <tree string="Extras">
                <field name="name"/>
                <field name="reservation_id"/>
                <field name="description"/>
                <field name="amount"/>
                <field name="date"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <record id="view_sf_hotel_extra_form" model="ir.ui.view">
        <field name="name">sf.hotel.extra.form</field>
        <field name="model">sf.hotel.extra</field>
        <field name="arch" type="xml">
            <form string="Extra">
                <header>
                    <button name="action_charge" type="object"
                            string="Charge" class="btn-primary"
                            invisible="state != 'draft'"
                            groups="sf_hotel_pms.group_sf_hotel_manager"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="reservation_id"/>
                        </group>
                        <group>
                            <field name="description"/>
                            <field name="amount"/>
                            <field name="date"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_sf_hotel_extra" model="ir.actions.act_window">
        <field name="name">Extras</field>
        <field name="res_model">sf.hotel.extra</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- ============ HOUSEKEEPING ============ -->
    <record id="view_sf_hotel_housekeeping_tree" model="ir.ui.view">
        <field name="name">sf.hotel.housekeeping.tree</field>
        <field name="model">sf.hotel.housekeeping</field>
        <field name="arch" type="xml">
            <tree string="Housekeeping">
                <field name="name"/>
                <field name="room_id"/>
                <field name="date"/>
                <field name="task_type"/>
                <field name="assigned_to"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <record id="view_sf_hotel_housekeeping_form" model="ir.ui.view">
        <field name="name">sf.hotel.housekeeping.form</field>
        <field name="model">sf.hotel.housekeeping</field>
        <field name="arch" type="xml">
            <form string="Housekeeping Task">
                <header>
                    <button name="action_plan" type="object"
                            string="Plan" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_done" type="object"
                            string="Done" class="btn-success"
                            invisible="state != 'planned'"
                            groups="sf_hotel_pms.group_sf_hotel_manager"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="room_id"/>
                        </group>
                        <group>
                            <field name="date"/>
                            <field name="task_type"/>
                            <field name="assigned_to"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_sf_hotel_housekeeping" model="ir.actions.act_window">
        <field name="name">Housekeeping</field>
        <field name="res_model">sf.hotel.housekeeping</field>
        <field name="view_mode">tree,form</field>
    </record>

</odoo>