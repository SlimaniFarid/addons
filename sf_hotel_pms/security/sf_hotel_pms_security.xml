<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_sf_hotel" model="ir.module.category">
        <field name="name">Hotel PMS</field>
        <field name="sequence">89</field>
    </record>

    <record id="group_sf_hotel_user" model="res.groups">
        <field name="name">Hotel PMS User</field>
        <field name="category_id" ref="module_category_sf_hotel"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_sf_hotel_manager" model="res.groups">
        <field name="name">Hotel PMS Manager</field>
        <field name="category_id" ref="module_category_sf_hotel"/>
        <field name="implied_ids" eval="[(4, ref('group_sf_hotel_user'))]"/>
    </record>

    <record id="rule_sf_hotel_room_user_company" model="ir.rule">
        <field name="name">Room: user sees own company</field>
        <field name="model_id" ref="model_sf_hotel_room"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_sf_hotel_user'))]"/>
    </record>

    <record id="rule_sf_hotel_reservation_user_company" model="ir.rule">
        <field name="name">Reservation: user sees own company</field>
        <field name="model_id" ref="model_sf_hotel_reservation"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_sf_hotel_user'))]"/>
    </record>

    <record id="rule_sf_hotel_extra_user_company" model="ir.rule">
        <field name="name">Extra: user sees own company</field>
        <field name="model_id" ref="model_sf_hotel_extra"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_sf_hotel_user'))]"/>
    </record>

    <record id="rule_sf_hotel_housekeeping_user_company" model="ir.rule">
        <field name="name">Housekeeping: user sees own company</field>
        <field name="model_id" ref="model_sf_hotel_housekeeping"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_sf_hotel_user'))]"/>
    </record>

    <record id="rule_sf_hotel_room_manager_all" model="ir.rule">
        <field name="name">Room: manager sees all companies</field>
        <field name="model_id" ref="model_sf_hotel_room"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_sf_hotel_manager'))]"/>
    </record>

    <record id="rule_sf_hotel_reservation_manager_all" model="ir.rule">
        <field name="name">Reservation: manager sees all companies</field>
        <field name="model_id" ref="model_sf_hotel_reservation"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_sf_hotel_manager'))]"/>
    </record>

    <record id="rule_sf_hotel_extra_manager_all" model="ir.rule">
        <field name="name">Extra: manager sees all companies</field>
        <field name="model_id" ref="model_sf_hotel_extra"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_sf_hotel_manager'))]"/>
    </record>

    <record id="rule_sf_hotel_housekeeping_manager_all" model="ir.rule">
        <field name="name">Housekeeping: manager sees all companies</field>
        <field name="model_id" ref="model_sf_hotel_housekeeping"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_sf_hotel_manager'))]"/>
    </record>
    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_sf_hotel"/>
    </record>
</odoo>
