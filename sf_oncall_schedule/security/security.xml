<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_oncall_schedule" model="ir.module.category">
        <field name="name">On-Call Schedule &amp; Escalation</field>
        <field name="sequence">60</field>
    </record>
    <record id="group_oncall_schedule_user" model="res.groups">
        <field name="name">On-Call Schedule &amp; Escalation User</field>
        <field name="category_id" ref="module_category_oncall_schedule"/>

    </record>
    <record id="group_oncall_schedule_manager" model="res.groups">
        <field name="name">On-Call Schedule &amp; Escalation Manager</field>
        <field name="category_id" ref="module_category_oncall_schedule"/>
        <field name="implied_ids" eval="[(4, ref('group_oncall_schedule_user'))]"/>
    </record>
    <record id="rule_oncall_schedule_sf_oncall_slot" model="ir.rule">
        <field name="name">On-Call Slot: multi-company</field>
        <field name="model_id" ref="model_sf_oncall_slot"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
