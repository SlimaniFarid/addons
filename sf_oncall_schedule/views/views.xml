<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_oncall_slot" model="ir.actions.act_window">
        <field name="name">On-Call Schedule &amp; Escalation</field>
        <field name="res_model">sf.oncall.slot</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
    <record id="view_sf_oncall_slot_form" model="ir.ui.view">
        <field name="name">sf.oncall.slot.form</field>
        <field name="model">sf.oncall.slot</field>
        <field name="arch" type="xml">
            <form string="On-Call Schedule &amp; Escalation">
                <header>
                    <button name="action_active" type="object" string="Active"
                            class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="scheduled,active,completed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="member_id"/>
                            <field name="rotation"/>
                            <field name="start"/>
                            <field name="end"/>
                            <field name="escalation_level"/>
                            <field name="override_by_id"/>
                            <field name="handover_note"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_oncall_slot_list" model="ir.ui.view">
        <field name="name">sf.oncall.slot.list</field>
        <field name="model">sf.oncall.slot</field>
        <field name="arch" type="xml">
            <list string="On-Call Schedule &amp; Escalation" sample="1">
                <field name="member_id"/>
                <field name="rotation"/>
                <field name="start"/>
                <field name="end"/>
                <field name="escalation_level"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state in ('submitted','approved')"/>
            </list>
        </field>
    </record>
    <record id="view_sf_oncall_slot_kanban" model="ir.ui.view">
        <field name="name">sf.oncall.slot.kanban</field>
        <field name="model">sf.oncall.slot</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_view" group_by="state">
                <field name="name"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <menuitem id="menu_sf_oncall_slot_root" name="On-Call Schedule &amp; Escalation" sequence="10"
              web_icon="sf_oncall_schedule,static/description/icon.png"/>
    <menuitem id="menu_sf_oncall_slot_main" name="Records"
              parent="menu_sf_oncall_slot_root" action="action_sf_oncall_slot" sequence="10"/>
</odoo>
