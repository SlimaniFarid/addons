<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_warehouse_slotting_review" model="ir.module.category">
        <field name="name">Warehouse Slotting Review</field>
        <field name="sequence">284</field>
    </record>
    <record id="group_warehouse_slotting_review_user" model="res.groups">
        <field name="name">Warehouse Slotting Review User</field>
        <field name="category_id" ref="module_category_warehouse_slotting_review"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>

    </record>
    <record id="group_warehouse_slotting_review_manager" model="res.groups">
        <field name="name">Warehouse Slotting Review Manager</field>
        <field name="category_id" ref="module_category_warehouse_slotting_review"/>
        <field name="implied_ids" eval="[(4, ref('group_warehouse_slotting_review_user'))]"/>
    </record>
    <record id="rule_warehouse_slotting_review_sf_warehouse_slotting_review" model="ir.rule">
        <field name="name">Warehouse Slotting Review: multi-company</field>
        <field name="model_id" ref="model_sf_warehouse_slotting_review"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
