<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_maintenance_intake" model="ir.module.category">
        <field name="name">Maintenance Request Intake</field>
        <field name="sequence">15</field>
    </record>
    <record id="group_maintenance_intake_user" model="res.groups">
        <field name="name">Maintenance Request Intake User</field>
        <field name="category_id" ref="module_category_maintenance_intake"/>
        <field name="implied_ids" eval="[(4, ref('maintenance.group_maintenance_user'))]"/>

    </record>
    <record id="group_maintenance_intake_manager" model="res.groups">
        <field name="name">Maintenance Request Intake Manager</field>
        <field name="category_id" ref="module_category_maintenance_intake"/>
        <field name="implied_ids" eval="[(4, ref('group_maintenance_intake_user'))]"/>
    </record>
    <record id="rule_maintenance_intake_sf_maintenance_intake" model="ir.rule">
        <field name="name">Maintenance Request: multi-company</field>
        <field name="model_id" ref="model_sf_maintenance_intake"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_maintenance_intake"/>
    </record>
</odoo>
