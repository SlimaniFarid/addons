<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_maintenance_intake" model="ir.actions.act_window">
        <field name="name">Maintenance Request Intake</field>
        <field name="res_model">sf.maintenance.intake</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
    <record id="view_sf_maintenance_intake_form" model="ir.ui.view">
        <field name="name">sf.maintenance.intake.form</field>
        <field name="model">sf.maintenance.intake</field>
        <field name="arch" type="xml">
            <form string="Maintenance Request Intake">
                <header>
                    <button name="action_triaged" type="object" string="Triaged"
                            class="btn-primary"/>
                    <button name="action_in_progress" type="object" string="In Progress"
                            class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="submitted,triaged,in_progress,resolved"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="equipment_id"/>
                            <field name="description"/>
                            <field name="priority"/>
                            <field name="requested_by_id"/>
                            <field name="assigned_team"/>
                            <field name="resolution_note"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_maintenance_intake_list" model="ir.ui.view">
        <field name="name">sf.maintenance.intake.list</field>
        <field name="model">sf.maintenance.intake</field>
        <field name="arch" type="xml">
            <list string="Maintenance Request Intake" sample="1">
                <field name="equipment_id"/>
                <field name="description"/>
                <field name="priority"/>
                <field name="requested_by_id"/>
                <field name="assigned_team"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state in ('submitted','approved')"/>
            </list>
        </field>
    </record>
    <record id="view_sf_maintenance_intake_kanban" model="ir.ui.view">
        <field name="name">sf.maintenance.intake.kanban</field>
        <field name="model">sf.maintenance.intake</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_view" group_by="state">
                <field name="name"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <menuitem id="menu_sf_maintenance_intake_root" name="Maintenance Request Intake" sequence="15"
              web_icon="sf_maintenance_intake,static/description/icon.png"/>
    <menuitem id="menu_sf_maintenance_intake_main" name="Records"
              parent="menu_sf_maintenance_intake_root" action="action_sf_maintenance_intake" sequence="10"/>

    <record id="wave_final_sf_maintenance_intake" model="ir.actions.server">
        <field name="name">Refresh Business Data</field>
        <field name="model_id" ref="model_sf_maintenance_intake"/>
        <field name="binding_model_id" ref="model_sf_maintenance_intake"/>
        <field name="state">code</field>
        <field name="code">records.action_refresh_business()</field>
    </record>
</odoo>
