<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Engagement form -->
    <record id="psa_engagement_view_form" model="ir.ui.view">
        <field name="name">sf.psa.engagement.form</field>
        <field name="model">sf.psa.engagement</field>
        <field name="arch" type="xml">
            <form string="Engagement">
                <header>
                    <button name="action_start" type="object"
                            string="Start" class="btn-primary"
                            states="draft"/>
                    <button name="action_close" type="object"
                            string="Close" class="btn-secondary"
                            states="active"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="partner_id"/>
                            <field name="project_id"/>
                        </group>
                        <group>
                            <field name="start_date"/>
                            <field name="end_date"/>
                        </group>
                    </group>
                    <group string="Budget">
                        <group>
                            <field name="budget_hours"/>
                            <field name="logged_hours"/>
                        </group>
                        <group>
                            <field name="progress" widget="progressbar"/>
                        </group>
                    </group>
                    <group>
                        <field name="description"/>
                    </group>
                    <notebook>
                        <page string="Assignments">
                            <field name="assignment_ids">
                                <tree string="Assignments" editable="bottom">
                                    <field name="resource_id"/>
                                    <field name="role"/>
                                    <field name="allocated_hours"/>
                                    <field name="logged_hours"/>
                                    <field name="utilization"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Time Entries">
                            <field name="time_entry_ids">
                                <tree string="Time Entries">
                                    <field name="date"/>
                                    <field name="resource_id"/>
                                    <field name="hours"/>
                                    <field name="billable"/>
                                    <field name="amount"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="psa_engagement_view_tree" model="ir.ui.view">
        <field name="name">sf.psa.engagement.tree</field>
        <field name="model">sf.psa.engagement</field>
        <field name="arch" type="xml">
            <tree string="Engagements">
                <field name="name"/>
                <field name="code"/>
                <field name="partner_id"/>
                <field name="state"/>
                <field name="budget_hours"/>
                <field name="logged_hours"/>
                <field name="progress"/>
            </tree>
        </field>
    </record>

    <!-- Resource -->
    <record id="psa_resource_view_form" model="ir.ui.view">
        <field name="name">sf.psa.resource.form</field>
        <field name="model">sf.psa.resource</field>
        <field name="arch" type="xml">
            <form string="Resource">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="partner_id"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="employee_id"/>
                            <field name="role"/>
                        </group>
                        <group>
                            <field name="hourly_rate"/>
                            <field name="capacity_hours"/>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="psa_resource_view_tree" model="ir.ui.view">
        <field name="name">sf.psa.resource.tree</field>
        <field name="model">sf.psa.resource</field>
        <field name="arch" type="xml">
            <tree string="Resources">
                <field name="partner_id"/>
                <field name="role"/>
                <field name="hourly_rate"/>
                <field name="capacity_hours"/>
            </tree>
        </field>
    </record>

    <!-- Assignment -->
    <record id="psa_assignment_view_form" model="ir.ui.view">
        <field name="name">sf.psa.assignment.form</field>
        <field name="model">sf.psa.assignment</field>
        <field name="arch" type="xml">
            <form string="Assignment">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="resource_id"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="engagement_id"/>
                            <field name="role"/>
                        </group>
                        <group>
                            <field name="allocated_hours"/>
                            <field name="logged_hours"/>
                            <field name="utilization"/>
                        </group>
                        <group>
                            <field name="start_date"/>
                            <field name="end_date"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Time Entries">
                            <field name="time_entry_ids">
                                <tree string="Time Entries">
                                    <field name="date"/>
                                    <field name="hours"/>
                                    <field name="billable"/>
                                    <field name="amount"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="psa_assignment_view_tree" model="ir.ui.view">
        <field name="name">sf.psa.assignment.tree</field>
        <field name="model">sf.psa.assignment</field>
        <field name="arch" type="xml">
            <tree string="Assignments">
                <field name="engagement_id"/>
                <field name="resource_id"/>
                <field name="role"/>
                <field name="allocated_hours"/>
                <field name="logged_hours"/>
                <field name="utilization"/>
            </tree>
        </field>
    </record>

    <!-- Time entry -->
    <record id="psa_time_entry_view_form" model="ir.ui.view">
        <field name="name">sf.psa.time.entry.form</field>
        <field name="model">sf.psa.time.entry</field>
        <field name="arch" type="xml">
            <form string="Time Entry">
                <sheet>
                    <group>
                        <group>
                            <field name="date"/>
                            <field name="engagement_id"/>
                            <field name="assignment_id"/>
                        </group>
                        <group>
                            <field name="resource_id"/>
                            <field name="hours"/>
                            <field name="billable"/>
                            <field name="amount"/>
                        </group>
                    </group>
                    <group>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="psa_time_entry_view_tree" model="ir.ui.view">
        <field name="name">sf.psa.time.entry.tree</field>
        <field name="model">sf.psa.time.entry</field>
        <field name="arch" type="xml">
            <tree string="Time Entries">
                <field name="date"/>
                <field name="engagement_id"/>
                <field name="resource_id"/>
                <field name="hours"/>
                <field name="billable"/>
                <field name="amount"/>
            </tree>
        </field>
    </record>

    <!-- Actions -->
    <record id="action_psa_engagement" model="ir.actions.act_window">
        <field name="name">Engagements</field>
        <field name="res_model">sf.psa.engagement</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record id="action_psa_resource" model="ir.actions.act_window">
        <field name="name">Resources</field>
        <field name="res_model">sf.psa.resource</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record id="action_psa_assignment" model="ir.actions.act_window">
        <field name="name">Assignments</field>
        <field name="res_model">sf.psa.assignment</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record id="action_psa_time_entry" model="ir.actions.act_window">
        <field name="name">Time Entries</field>
        <field name="res_model">sf.psa.time.entry</field>
        <field name="view_mode">tree,form</field>
    </record>

</odoo>