<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_account_plan" model="ir.actions.act_window">
        <field name="name">Key Account Plans (JBP)</field>
        <field name="res_model">sf.account.plan</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
    <record id="view_sf_account_plan_form" model="ir.ui.view">
        <field name="name">sf.account.plan.form</field>
        <field name="model">sf.account.plan</field>
        <field name="arch" type="xml">
            <form string="Key Account Plans (JBP)">
                <header>
                    <button name="action_active" type="object" string="Active"
                            class="btn-primary"/>
                    <button name="action_review" type="object" string="In Review"
                            class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,active,review,closed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="plan_year"/>
                        <field name="objectives"/>
                        <field name="joint_actions"/>
                            <field name="revenue_target"/>
                            <field name="review_date"/>
                            <field name="owner_id"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_account_plan_list" model="ir.ui.view">
        <field name="name">sf.account.plan.list</field>
        <field name="model">sf.account.plan</field>
        <field name="arch" type="xml">
            <list string="Key Account Plans (JBP)" sample="1">
                <field name="partner_id"/>
                <field name="plan_year"/>
                <field name="objectives"/>
                <field name="joint_actions"/>
                <field name="revenue_target"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state in ('submitted','approved')"/>
            </list>
        </field>
    </record>
    <record id="view_sf_account_plan_kanban" model="ir.ui.view">
        <field name="name">sf.account.plan.kanban</field>
        <field name="model">sf.account.plan</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_view" group_by="state">
                <field name="name"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <menuitem id="menu_sf_account_plan_root" name="Key Account Plans (JBP)" sequence="9"
              web_icon="sf_key_account_plans,static/description/icon.png"/>
    <menuitem id="menu_sf_account_plan_main" name="Records"
              parent="menu_sf_account_plan_root" action="action_sf_account_plan" sequence="10"/>
</odoo>
