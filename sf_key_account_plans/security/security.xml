<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_key_account_plans" model="ir.module.category">
        <field name="name">Key Account Plans (JBP)</field>
        <field name="sequence">43</field>
    </record>
    <record id="group_key_account_plans_user" model="res.groups">
        <field name="name">Key Account Plans (JBP) User</field>
        <field name="category_id" ref="module_category_key_account_plans"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>

    </record>
    <record id="group_key_account_plans_manager" model="res.groups">
        <field name="name">Key Account Plans (JBP) Manager</field>
        <field name="category_id" ref="module_category_key_account_plans"/>
        <field name="implied_ids" eval="[(4, ref('group_key_account_plans_user'))]"/>
    </record>
    <record id="rule_key_account_plans_sf_account_plan" model="ir.rule">
        <field name="name">Key Account Plan: multi-company</field>
        <field name="model_id" ref="model_sf_account_plan"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_key_account_plans"/>
    </record>
</odoo>
