<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_treasury_week" model="ir.actions.act_window">
        <field name="name">Weekly Treasury Planning Board</field>
        <field name="res_model">sf.treasury.week</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
    <record id="view_sf_treasury_week_form" model="ir.ui.view">
        <field name="name">sf.treasury.week.form</field>
        <field name="model">sf.treasury.week</field>
        <field name="arch" type="xml">
            <form string="Weekly Treasury Planning Board">
                <header>
                    <button name="action_reviewed" type="object" string="Reviewed"
                            class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,reviewed,locked"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="week_start"/>
                            <field name="opening_balance"/>
                            <field name="expected_inflows"/>
                            <field name="expected_outflows"/>
                            <field name="projected_close"/>
                            <field name="decisions"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_treasury_week_list" model="ir.ui.view">
        <field name="name">sf.treasury.week.list</field>
        <field name="model">sf.treasury.week</field>
        <field name="arch" type="xml">
            <list string="Weekly Treasury Planning Board" sample="1">
                <field name="week_start"/>
                <field name="opening_balance"/>
                <field name="expected_inflows"/>
                <field name="expected_outflows"/>
                <field name="projected_close"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state in ('submitted','approved')"/>
            </list>
        </field>
    </record>
    <record id="view_sf_treasury_week_kanban" model="ir.ui.view">
        <field name="name">sf.treasury.week.kanban</field>
        <field name="model">sf.treasury.week</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_view" group_by="state">
                <field name="name"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <menuitem id="menu_sf_treasury_week_root" name="Weekly Treasury Planning Board" sequence="2"
              web_icon="sf_treasury_week_board,static/description/icon.png"/>
    <menuitem id="menu_sf_treasury_week_main" name="Records"
              parent="menu_sf_treasury_week_root" action="action_sf_treasury_week" sequence="10"/>
</odoo>
