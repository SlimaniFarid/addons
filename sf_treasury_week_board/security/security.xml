<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_treasury_week_board" model="ir.module.category">
        <field name="name">Weekly Treasury Planning Board</field>
        <field name="sequence">51</field>
    </record>
    <record id="group_treasury_week_board_user" model="res.groups">
        <field name="name">Weekly Treasury Planning Board User</field>
        <field name="category_id" ref="module_category_treasury_week_board"/>

    </record>
    <record id="group_treasury_week_board_manager" model="res.groups">
        <field name="name">Weekly Treasury Planning Board Manager</field>
        <field name="category_id" ref="module_category_treasury_week_board"/>
        <field name="implied_ids" eval="[(4, ref('group_treasury_week_board_user'))]"/>
    </record>
    <record id="rule_treasury_week_board_sf_treasury_week" model="ir.rule">
        <field name="name">Treasury Week: multi-company</field>
        <field name="model_id" ref="model_sf_treasury_week"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
