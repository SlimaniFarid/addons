<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_purchase_requisition_sf_list" model="ir.ui.view">
        <field name="name">sf.purchase.requisition.purchase.requisition.sf.list</field>
        <field name="model">sf.purchase.requisition.purchase.requisition.sf</field>
        <field name="arch" type="xml">
            <list string="Purchase.Requisition.Sf">
                <field name="name"/>
                <field name="requested_by"/>
                <field name="department_id"/>
                <field name="budget_check"/>
                <field name="state"/>
                <field name="line_ids"/>
                <field name="state" widget="badge"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_purchase_requisition_sf_form" model="ir.ui.view">
        <field name="name">sf.purchase.requisition.purchase.requisition.sf.form</field>
        <field name="model">sf.purchase.requisition.purchase.requisition.sf</field>
        <field name="arch" type="xml">
            <form string="Purchase.Requisition.Sf">
                <header>
                <field name="state" widget="badge"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" placeholder="Name"/></h1></div>
                    <group><group>
                            <field name="name"/>
                            <field name="requested_by"/>
                            <field name="department_id"/>
                            <field name="budget_check"/>
                            <field name="state"/>
                            <field name="line_ids"/>
                    </group>
                    <group>
                        <field name="currency_id" invisible="1"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_purchase_requisition_sf" model="ir.actions.act_window">
        <field name="name">Purchase.Requisition.Sf</field>
        <field name="res_model">sf.purchase.requisition.purchase.requisition.sf</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
