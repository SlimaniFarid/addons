<?xml version="1.0" ?>
<odoo>
    <record id="module_category_sf_community_center" model="ir.module.category">
        <field name="name">Community Center &amp; Recreation Management</field>
        <field name="description">Community center management: spaces, activities, memberships, ticketing, grants</field>
        <field name="sequence">10</field>
    </record>
    <record id="group_sf_community_center_user" model="res.groups">
        <field name="name">Community Center / User</field>
        <field name="category_id" ref="module_category_sf_community_center"/>
    </record>
    <record id="group_sf_community_center_manager" model="res.groups">
        <field name="name">Community Center / Manager</field>
        <field name="category_id" ref="module_category_sf_community_center"/>
        <field name="implied_ids" eval="[(4, ref('sf_community_center.group_sf_community_center_user'))]"/>
    </record>
    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_sf_community_center"/>
    </record>
</odoo>