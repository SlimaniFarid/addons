<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_training_budget" model="ir.module.category">
        <field name="name">Training Budget Tracker</field>
        <field name="sequence">196</field>
    </record>
    <record id="group_training_budget_user" model="res.groups">
        <field name="name">Training Budget Tracker User</field>
        <field name="category_id" ref="module_category_training_budget"/>

    </record>
    <record id="group_training_budget_manager" model="res.groups">
        <field name="name">Training Budget Tracker Manager</field>
        <field name="category_id" ref="module_category_training_budget"/>
        <field name="implied_ids" eval="[(4, ref('group_training_budget_user'))]"/>
    </record>
    <record id="rule_training_budget_sf_training_budget" model="ir.rule">
        <field name="name">Training Budget Tracker: multi-company</field>
        <field name="model_id" ref="model_sf_training_budget"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
