<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_inventory_writeoff_register" model="ir.module.category">
        <field name="name">Inventory Write-Off Register</field>
        <field name="sequence">23</field>
    </record>
    <record id="group_inventory_writeoff_register_user" model="res.groups">
        <field name="name">Inventory Write-Off Register User</field>
        <field name="category_id" ref="module_category_inventory_writeoff_register"/>
        <field name="implied_ids" eval="[(4, ref('stock.group_stock_user'))]"/>

    </record>
    <record id="group_inventory_writeoff_register_manager" model="res.groups">
        <field name="name">Inventory Write-Off Register Manager</field>
        <field name="category_id" ref="module_category_inventory_writeoff_register"/>
        <field name="implied_ids" eval="[(4, ref('group_inventory_writeoff_register_user'))]"/>
    </record>
    <record id="rule_inventory_writeoff_register_sf_writeoff" model="ir.rule">
        <field name="name">Write-Off: multi-company</field>
        <field name="model_id" ref="model_sf_writeoff"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_inventory_writeoff_register"/>
    </record>
</odoo>
