<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_writeoff" model="ir.actions.act_window">
        <field name="name">Inventory Write-Off Register</field>
        <field name="res_model">sf.writeoff</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
    <record id="view_sf_writeoff_form" model="ir.ui.view">
        <field name="name">sf.writeoff.form</field>
        <field name="model">sf.writeoff</field>
        <field name="arch" type="xml">
            <form string="Inventory Write-Off Register">
                <header>
                    <button name="action_approved" type="object" string="Approved"
                            class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="proposed,approved,posted"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="product_id"/>
                            <field name="quantity"/>
                            <field name="value"/>
                            <field name="reason"/>
                            <field name="approved_by_id"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_writeoff_list" model="ir.ui.view">
        <field name="name">sf.writeoff.list</field>
        <field name="model">sf.writeoff</field>
        <field name="arch" type="xml">
            <list string="Inventory Write-Off Register" sample="1">
                <field name="product_id"/>
                <field name="quantity"/>
                <field name="value"/>
                <field name="reason"/>
                <field name="approved_by_id"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state in ('submitted','approved')"/>
            </list>
        </field>
    </record>
    <record id="view_sf_writeoff_kanban" model="ir.ui.view">
        <field name="name">sf.writeoff.kanban</field>
        <field name="model">sf.writeoff</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_view" group_by="state">
                <field name="name"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <menuitem id="menu_sf_writeoff_root" name="Inventory Write-Off Register" sequence="13"
              web_icon="sf_inventory_writeoff_register,static/description/icon.png"/>
    <menuitem id="menu_sf_writeoff_main" name="Records"
              parent="menu_sf_writeoff_root" action="action_sf_writeoff" sequence="10"/>
</odoo>
