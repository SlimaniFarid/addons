<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_return_reason" model="ir.actions.act_window">
        <field name="name">Product Return Reason Analytics</field>
        <field name="res_model">sf.return.reason</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
    <record id="view_sf_return_reason_form" model="ir.ui.view">
        <field name="name">sf.return.reason.form</field>
        <field name="model">sf.return.reason</field>
        <field name="arch" type="xml">
            <form string="Product Return Reason Analytics">
                <header>
                    <button name="action_analyzed" type="object" string="Analyzed"
                            class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="open,analyzed,closed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="return_picking_id"/>
                            <field name="reason"/>
                            <field name="cost_of_return"/>
                            <field name="root_cause"/>
                            <field name="corrective_action"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_return_reason_list" model="ir.ui.view">
        <field name="name">sf.return.reason.list</field>
        <field name="model">sf.return.reason</field>
        <field name="arch" type="xml">
            <list string="Product Return Reason Analytics" sample="1">
                <field name="return_picking_id"/>
                <field name="reason"/>
                <field name="cost_of_return"/>
                <field name="root_cause"/>
                <field name="corrective_action"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state in ('submitted','approved')"/>
            </list>
        </field>
    </record>
    <record id="view_sf_return_reason_kanban" model="ir.ui.view">
        <field name="name">sf.return.reason.kanban</field>
        <field name="model">sf.return.reason</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_view" group_by="state">
                <field name="name"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <menuitem id="menu_sf_return_reason_root" name="Product Return Reason Analytics" sequence="4"
              web_icon="sf_product_return_reasons,static/description/icon.png"/>
    <menuitem id="menu_sf_return_reason_main" name="Records"
              parent="menu_sf_return_reason_root" action="action_sf_return_reason" sequence="10"/>
</odoo>
