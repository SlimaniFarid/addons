<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_product_return_reasons" model="ir.module.category">
        <field name="name">Product Return Reason Analytics</field>
        <field name="sequence">42</field>
    </record>
    <record id="group_product_return_reasons_user" model="res.groups">
        <field name="name">Product Return Reason Analytics User</field>
        <field name="category_id" ref="module_category_product_return_reasons"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>

    </record>
    <record id="group_product_return_reasons_manager" model="res.groups">
        <field name="name">Product Return Reason Analytics Manager</field>
        <field name="category_id" ref="module_category_product_return_reasons"/>
        <field name="implied_ids" eval="[(4, ref('group_product_return_reasons_user'))]"/>
    </record>
    <record id="rule_product_return_reasons_sf_return_reason" model="ir.rule">
        <field name="name">Return Reason Record: multi-company</field>
        <field name="model_id" ref="model_sf_return_reason"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_product_return_reasons"/>
    </record>
</odoo>
