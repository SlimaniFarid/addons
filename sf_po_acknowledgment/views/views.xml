<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_po_acknowledgment" model="ir.actions.act_window">
        <field name="name">PO Supplier Acknowledgment</field>
        <field name="res_model">sf.po_acknowledgment</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
    <record id="view_sf_po_acknowledgment_form" model="ir.ui.view">
        <field name="name">sf.po_acknowledgment.form</field>
        <field name="model">sf.po_acknowledgment</field>
        <field name="arch" type="xml">
            <form string="PO Supplier Acknowledgment">
                <header>
                    <button name="action_submitted" type="object" string="Submitted"
                            class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="po_id"/>
                            <field name="sent_date"/>
                            <field name="ack_due_date"/>
                            <field name="acknowledged"/>
                            <field name="chase_count"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_po_acknowledgment_list" model="ir.ui.view">
        <field name="name">sf.po_acknowledgment.list</field>
        <field name="model">sf.po_acknowledgment</field>
        <field name="arch" type="xml">
            <list string="PO Supplier Acknowledgment" sample="1">
                <field name="po_id"/>
                <field name="sent_date"/>
                <field name="ack_due_date"/>
                <field name="acknowledged"/>
                <field name="chase_count"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state in ('submitted','approved')"/>
            </list>
        </field>
    </record>
    <record id="view_sf_po_acknowledgment_kanban" model="ir.ui.view">
        <field name="name">sf.po_acknowledgment.kanban</field>
        <field name="model">sf.po_acknowledgment</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_view" group_by="state">
                <field name="name"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <menuitem id="menu_sf_po_acknowledgment_root" name="PO Supplier Acknowledgment" sequence="5"
              web_icon="sf_po_acknowledgment,static/description/icon.png"/>
    <menuitem id="menu_sf_po_acknowledgment_main" name="Records"
              parent="menu_sf_po_acknowledgment_root" action="action_sf_po_acknowledgment" sequence="10"/>
</odoo>
