<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_po_acknowledgment" model="ir.module.category">
        <field name="name">PO Supplier Acknowledgment</field>
        <field name="sequence">196</field>
    </record>
    <record id="group_po_acknowledgment_user" model="res.groups">
        <field name="name">PO Supplier Acknowledgment User</field>
        <field name="category_id" ref="module_category_po_acknowledgment"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>

    </record>
    <record id="group_po_acknowledgment_manager" model="res.groups">
        <field name="name">PO Supplier Acknowledgment Manager</field>
        <field name="category_id" ref="module_category_po_acknowledgment"/>
        <field name="implied_ids" eval="[(4, ref('group_po_acknowledgment_user'))]"/>
    </record>
    <record id="rule_po_acknowledgment_sf_po_acknowledgment" model="ir.rule">
        <field name="name">PO Supplier Acknowledgment: multi-company</field>
        <field name="model_id" ref="model_sf_po_acknowledgment"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_po_acknowledgment"/>
    </record>
</odoo>
