<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_supplier_questionnaire" model="ir.actions.act_window">
        <field name="name">Supplier Questionnaire Campaigns</field>
        <field name="res_model">sf.supplier.questionnaire</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
    <record id="view_sf_supplier_questionnaire_form" model="ir.ui.view">
        <field name="name">sf.supplier.questionnaire.form</field>
        <field name="model">sf.supplier.questionnaire</field>
        <field name="arch" type="xml">
            <form string="Supplier Questionnaire Campaigns">
                <header>
                    <button name="action_received" type="object" string="Received"
                            class="btn-primary"/>
                    <button name="action_evaluated" type="object" string="Evaluated"
                            class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="sent,received,evaluated,chased"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="vendor_id"/>
                            <field name="questionnaire_type"/>
                            <field name="sent_date"/>
                            <field name="due_date"/>
                            <field name="score"/>
                            <field name="follow_up"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_supplier_questionnaire_list" model="ir.ui.view">
        <field name="name">sf.supplier.questionnaire.list</field>
        <field name="model">sf.supplier.questionnaire</field>
        <field name="arch" type="xml">
            <list string="Supplier Questionnaire Campaigns" sample="1">
                <field name="vendor_id"/>
                <field name="questionnaire_type"/>
                <field name="sent_date"/>
                <field name="due_date"/>
                <field name="score"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state in ('submitted','approved')"/>
            </list>
        </field>
    </record>
    <record id="view_sf_supplier_questionnaire_kanban" model="ir.ui.view">
        <field name="name">sf.supplier.questionnaire.kanban</field>
        <field name="model">sf.supplier.questionnaire</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_view" group_by="state">
                <field name="name"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <menuitem id="menu_sf_supplier_questionnaire_root" name="Supplier Questionnaire Campaigns" sequence="17"
              web_icon="sf_supplier_questionnaire,static/description/icon.png"/>
    <menuitem id="menu_sf_supplier_questionnaire_main" name="Records"
              parent="menu_sf_supplier_questionnaire_root" action="action_sf_supplier_questionnaire" sequence="10"/>

    <record id="wave_final_sf_supplier_questionnaire" model="ir.actions.server">
        <field name="name">Refresh Business Data</field>
        <field name="model_id" ref="model_sf_supplier_questionnaire"/>
        <field name="binding_model_id" ref="model_sf_supplier_questionnaire"/>
        <field name="state">code</field>
        <field name="code">records.action_refresh_business()</field>
    </record>
</odoo>
