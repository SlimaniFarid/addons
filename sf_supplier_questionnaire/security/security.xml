<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_supplier_questionnaire" model="ir.module.category">
        <field name="name">Supplier Questionnaire Campaigns</field>
        <field name="sequence">7</field>
    </record>
    <record id="group_supplier_questionnaire_user" model="res.groups">
        <field name="name">Supplier Questionnaire Campaigns User</field>
        <field name="category_id" ref="module_category_supplier_questionnaire"/>
        <field name="implied_ids" eval="[(4, ref('purchase.group_purchase_user'))]"/>

    </record>
    <record id="group_supplier_questionnaire_manager" model="res.groups">
        <field name="name">Supplier Questionnaire Campaigns Manager</field>
        <field name="category_id" ref="module_category_supplier_questionnaire"/>
        <field name="implied_ids" eval="[(4, ref('group_supplier_questionnaire_user'))]"/>
    </record>
    <record id="rule_supplier_questionnaire_sf_supplier_questionnaire" model="ir.rule">
        <field name="name">Questionnaire: multi-company</field>
        <field name="model_id" ref="model_sf_supplier_questionnaire"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
