<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_kyc_file" model="ir.actions.act_window">
        <field name="name">KYC Files</field>
        <field name="res_model">sf.kyc.file</field>
        <field name="view_mode">kanban,list,form,kanban</field>
        <field name="context">{'search_default_group_by_state': 1}</field>
    </record>
    <record id="view_sf_kyc_file_form" model="ir.ui.view">
        <field name="name">sf.kyc.file.form</field>
        <field name="model">sf.kyc.file</field>
        <field name="arch" type="xml">
            <form string="KYC File">
                <header>
                    <button name="action_approve" type="object"
                            string="Approve" class="btn-primary"
                            invisible="state != 'pending'"/>
                    <button name="action_reject" type="object" string="Reject"
                            invisible="state != 'pending'"/>
                    <button name="action_expire" type="object" string="Expire"
                            invisible="state != 'approved'"/>
                    <button name="action_run_screening" type="object"
                            string="Screening Done"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="pending,approved,rejected,expired"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="partner_id"/>
                            <field name="file_type"/>
                            <field name="risk_rating" widget="radio"/>
                        </group>
                        <group>
                            <field name="reviewer_id"/>
                            <field name="screening_date"/>
                            <field name="screening_result"/>
                            <field name="ubo_declared"/>
                        </group>
                        <group string="Document Checklist">
                            <field name="id_document"/>
                            <field name="proof_of_address"/>
                            <field name="bank_statement"/>
                        </group>
                        <group string="Review Cycle">
                            <field name="review_frequency_months"/>
                            <field name="last_review_date"/>
                            <field name="next_review_date" readonly="1"/>
                            <field name="review_overdue" readonly="1"
                                   widget="boolean"/>
                            <field name="company_id"
                                   groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group string="Notes">
                        <field name="notes"/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_kyc_file_list" model="ir.ui.view">
        <field name="name">sf.kyc.file.list</field>
        <field name="model">sf.kyc.file</field>
        <field name="arch" type="xml">
            <list decoration-danger="is_overdue" string="KYC Files" sample="1">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="file_type"/>
                <field name="risk_rating" widget="badge"
                       decoration-danger="risk_rating == 'high'"
                       decoration-warning="risk_rating == 'medium'"/>
                <field name="screening_result"/>
                <field name="next_review_date"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'approved'"/>
            </list>
        </field>
    </record>
    <menuitem id="menu_sf_kyc_root" name="KYC / AML" sequence="33"
              parent="account.menu_finance_configuration"/>
    <menuitem id="menu_sf_kyc_files" name="KYC Files"
              parent="menu_sf_kyc_root" action="action_sf_kyc_file"
              sequence="10"/>

    <record id="view_sf_kyc_aml_boost_kanban" model="ir.ui.view">
        <field name="name">sf_kyc_aml.boost.kanban</field>
        <field name="model">sf.kyc.file</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" t-att-color="state">
                <field name="name"/>
                <field name="state"/>
                <field name="user_id"/>
                <field name="last_review_date"/>
                <field name="is_overdue" invisible="1"/>

                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_card oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title">
                                    <field name="name"/></strong>
                                <div class="o_kanban_record_subtitle">
                                    <field name="user_id" widget="many2one_avatar_user"/>
                                    <field name="last_review_date"/></div>
                            </div>
                            <div class="oe_kanban_bottom_right">
                                <field name="state" widget="badge"
                                       t-attf-options="{'classes_map': {'draft': 'info', 'done': 'success', 'cancelled': 'danger'}, 'domain': []}"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_sf_kyc_aml_boost_search" model="ir.ui.view">
        <field name="name">sf_kyc_aml.boost.search</field>
        <field name="model">sf.kyc.file</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
<separator/>
                <filter string="My records" name="my_records" domain="[('user_id', '=', uid)]"/>
                <filter string="To Do" name="todo" domain="[('state', 'not in', ('done', 'cancelled', 'closed'))]"/>
                <group expand="0" string="Group By"><filter string="Status" name="gb_state" context="{'group_by': 'state'}"/></group>
            </search>
        </field>
    </record>
</odoo>
