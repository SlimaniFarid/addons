<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_sf_kyc" model="ir.module.category">
        <field name="name">KYC / AML</field>
        <field name="sequence">83</field>
    </record>
    <record id="group_sf_kyc_user" model="res.groups">
        <field name="name">KYC Analyst</field>
        <field name="category_id" ref="module_category_sf_kyc"/>
    </record>
    <record id="group_sf_kyc_manager" model="res.groups">
        <field name="name">KYC Compliance Manager</field>
        <field name="category_id" ref="module_category_sf_kyc"/>
        <field name="implied_ids" eval="[(4, ref('group_sf_kyc_user'))]"/>
    </record>
    <record id="rule_sf_kyc_company" model="ir.rule">
        <field name="name">KYC File: multi-company</field>
        <field name="model_id" ref="model_sf_kyc_file"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_sf_kyc"/>
    </record>
</odoo>
