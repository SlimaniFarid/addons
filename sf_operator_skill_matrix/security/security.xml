<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_operator_skill_matrix" model="ir.module.category">
        <field name="name">Operator Skill Matrix</field>
        <field name="sequence">12</field>
    </record>
    <record id="group_operator_skill_matrix_user" model="res.groups">
        <field name="name">Operator Skill Matrix User</field>
        <field name="category_id" ref="module_category_operator_skill_matrix"/>
        <field name="implied_ids" eval="[(4, ref('mrp.group_mrp_user'))]"/>

    </record>
    <record id="group_operator_skill_matrix_manager" model="res.groups">
        <field name="name">Operator Skill Matrix Manager</field>
        <field name="category_id" ref="module_category_operator_skill_matrix"/>
        <field name="implied_ids" eval="[(4, ref('group_operator_skill_matrix_user'))]"/>
    </record>
    <record id="rule_operator_skill_matrix_sf_operator_skill" model="ir.rule">
        <field name="name">Operator Skill: multi-company</field>
        <field name="model_id" ref="model_sf_operator_skill"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_operator_skill_matrix"/>
    </record>
</odoo>
