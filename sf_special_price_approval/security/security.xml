<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_special_price_approval" model="ir.module.category">
        <field name="name">Special Price Approval Workflow</field>
        <field name="sequence">46</field>
    </record>
    <record id="group_special_price_approval_user" model="res.groups">
        <field name="name">Special Price Approval Workflow User</field>
        <field name="category_id" ref="module_category_special_price_approval"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>

    </record>
    <record id="group_special_price_approval_manager" model="res.groups">
        <field name="name">Special Price Approval Workflow Manager</field>
        <field name="category_id" ref="module_category_special_price_approval"/>
        <field name="implied_ids" eval="[(4, ref('group_special_price_approval_user'))]"/>
    </record>
    <record id="rule_special_price_approval_sf_price_approval" model="ir.rule">
        <field name="name">Special Price Request: multi-company</field>
        <field name="model_id" ref="model_sf_price_approval"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
