<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sf_correspondence_department_view_list" model="ir.ui.view">
        <field name="name">sf.correspondence.department.list</field>
        <field name="model">sf.correspondence.department</field>
        <field name="arch" type="xml">
            <list string="Departments">
                <field name="name"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="sf_correspondence_department_view_form" model="ir.ui.view">
        <field name="name">sf.correspondence.department.form</field>
        <field name="model">sf.correspondence.department</field>
        <field name="arch" type="xml">
            <form string="Department">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Name"/>
                        </h1>
                    </div>
                    <group>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="sf_correspondence_department_view_search" model="ir.ui.view">
        <field name="name">sf.correspondence.department.search</field>
        <field name="model">sf.correspondence.department</field>
        <field name="arch" type="xml">
            <search string="Departments">
                <field name="name"/>
            </search>
        </field>
    </record>

    <record id="action_sf_correspondence_department" model="ir.actions.act_window">
        <field name="name">Departments</field>
        <field name="res_model">sf.correspondence.department</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="sf_correspondence_department_view_search"/>
    </record>
</odoo>