<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sf_correspondence_view_list" model="ir.ui.view">
        <field name="name">sf.correspondence.list</field>
        <field name="model">sf.correspondence</field>
        <field name="arch" type="xml">
            <list decoration-danger="is_overdue" string="Correspondence">
                <field name="name"/>
                <field name="direction"/>
                <field name="correspondence_date"/>
                <field name="partner_id"/>
                <field name="department_id"/>
                <field name="subject"/>
                <field name="response_due_date"/>
                <field name="state" widget="badge"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="sf_correspondence_view_form" model="ir.ui.view">
        <field name="name">sf.correspondence.form</field>
        <field name="model">sf.correspondence</field>
        <field name="arch" type="xml">
            <form string="Correspondence">
                <header>
                    <button name="action_open" string="Open" type="object" class="btn-primary" invisible="[('state', '!=', 'draft')]"/>
                    <button name="action_start" string="In Progress" type="object" class="btn-primary" invisible="[('state', '!=', 'open')]"/>
                    <button name="action_responded" string="Mark Responded" type="object" class="btn-primary" invisible="[('state', 'not in', ('open', 'in_progress'))]"/>
                    <button name="action_archive" string="Archive" type="object" class="btn-primary" invisible="[('state', '!=', 'responded')]"/>
                    <button name="action_cancel" string="Cancel" type="object" invisible="[('state', 'in', ('responded', 'archived', 'cancelled'))]"/>
                    <field name="state" widget="statusbar" readonly="1"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="direction"/>
                            <field name="correspondence_date"/>
                            <field name="partner_id"/>
                            <field name="subject"/>
                            <field name="reference"/>
                        </group>
                        <group>
                            <field name="department_id"/>
                            <field name="assigned_to"/>
                            <field name="registered_mail"/>
                            <field name="ack_received" invisible="[('registered_mail', '=', False)]"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group string="Response">
                        <field name="response_due_date"/>
                        <field name="response_date"/>
                    </group>
                    <group string="Attachments">
                        <field name="attachment_ids" widget="many2many_binary" string="Attachments"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="sf_correspondence_view_search" model="ir.ui.view">
        <field name="name">sf.correspondence.search</field>
        <field name="model">sf.correspondence</field>
        <field name="arch" type="xml">
            <search string="Correspondence">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="subject"/>
                <field name="department_id"/>
                <filter name="correspondence_open" string="Open" domain="[('state', '=', 'open')]"/>
                <filter name="correspondence_in_progress" string="In Progress" domain="[('state', '=', 'in_progress')]"/>
                <filter name="correspondence_responded" string="Responded" domain="[('state', '=', 'responded')]"/>
                <filter name="correspondence_due" string="Response Due" domain="[('response_due_date', '!=', False), ('state', 'in', ('open', 'in_progress'))]"/>
                <group>
                    <filter name="group_correspondence_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_correspondence_direction" string="Direction" context="{'group_by': 'direction'}"/>
                    <filter name="group_correspondence_department" string="Department" context="{'group_by': 'department_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_sf_correspondence" model="ir.actions.act_window">
        <field name="name">Correspondence</field>
        <field name="res_model">sf.correspondence</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="sf_correspondence_view_search"/>
    </record>

    <record id="view_sf_correspondence_boost_kanban" model="ir.ui.view">
        <field name="name">sf_correspondence.boost.kanban</field>
        <field name="model">sf.correspondence</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" t-att-color="state">
                <field name="name"/>
                <field name="state"/>
                <field name="user_id"/>
                <field name="response_due_date"/>
                <field name="is_overdue" invisible="1"/>

                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_card oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title">
                                    <field name="name"/></strong>
                                <div class="o_kanban_record_subtitle">
                                    <field name="user_id" widget="many2one_avatar_user"/>
                                    <field name="response_due_date"/></div>
                            </div>
                            <div class="oe_kanban_bottom_right">
                                <field name="state" widget="badge"
                                       t-attf-options="{'classes_map': {'draft': 'info', 'done': 'success', 'cancelled': 'danger'}, 'domain': []}"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_sf_correspondence_boost_search" model="ir.ui.view">
        <field name="name">sf_correspondence.boost.search</field>
        <field name="model">sf.correspondence</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
<separator/>
                <filter string="My records" name="my_records" domain="[('user_id', '=', uid)]"/>
                <filter string="To Do" name="todo" domain="[('state', 'not in', ('done', 'cancelled', 'closed'))]"/>
                <group expand="0" string="Group By"><filter string="Status" name="gb_state" context="{'group_by': 'state'}"/></group>
            </search>
        </field>
    </record>
</odoo>
