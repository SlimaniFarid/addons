<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="module_category_sf_correspondence" model="ir.module.category">
            <field name="name">Correspondence</field>
            <field name="description">Business Mail &amp; Correspondence Register.</field>
            <field name="sequence">10</field>
        </record>

        <record id="group_sf_correspondence_user" model="res.groups">
            <field name="name">Correspondence / User</field>
            <field name="category_id" ref="module_category_sf_correspondence"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_sf_correspondence_manager" model="res.groups">
            <field name="name">Correspondence / Manager</field>
            <field name="category_id" ref="module_category_sf_correspondence"/>
            <field name="implied_ids" eval="[(4, ref('sf_correspondence.group_sf_correspondence_user'))]"/>
        </record>

        <record id="rule_sf_correspondence_company" model="ir.rule">
            <field name="name">Correspondence: user sees own company</field>
            <field name="model_id" ref="model_sf_correspondence"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('sf_correspondence.group_sf_correspondence_user'))]"/>
        </record>
        <record id="rule_sf_correspondence_manager_all" model="ir.rule">
            <field name="name">Correspondence: manager sees all companies</field>
            <field name="model_id" ref="model_sf_correspondence"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('sf_correspondence.group_sf_correspondence_manager'))]"/>
        </record>

        <record id="rule_sf_correspondence_department_company" model="ir.rule">
            <field name="name">Correspondence Department: user sees own company</field>
            <field name="model_id" ref="model_sf_correspondence_department"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('sf_correspondence.group_sf_correspondence_user'))]"/>
        </record>
        <record id="rule_sf_correspondence_department_manager_all" model="ir.rule">
            <field name="name">Correspondence Department: manager sees all companies</field>
            <field name="model_id" ref="model_sf_correspondence_department"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('sf_correspondence.group_sf_correspondence_manager'))]"/>
        </record>
    </data>
    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_sf_correspondence"/>
    </record>
</odoo>