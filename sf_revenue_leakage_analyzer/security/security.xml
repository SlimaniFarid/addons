<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_revenue_leakage_analyzer" model="ir.module.category">
        <field name="name">Revenue Leakage Analyzer</field>
        <field name="sequence">495</field>
    </record>
    <record id="group_revenue_leakage_analyzer_user" model="res.groups">
        <field name="name">Revenue Leakage Analyzer User</field>
        <field name="category_id" ref="module_category_revenue_leakage_analyzer"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>

    </record>
    <record id="group_revenue_leakage_analyzer_manager" model="res.groups">
        <field name="name">Revenue Leakage Analyzer Manager</field>
        <field name="category_id" ref="module_category_revenue_leakage_analyzer"/>
        <field name="implied_ids" eval="[(4, ref('group_revenue_leakage_analyzer_user'))]"/>
    </record>
    <record id="rule_revenue_leakage_analyzer_sf_revenue_leakage_analyzer" model="ir.rule">
        <field name="name">Revenue Leakage Analyzer: multi-company</field>
        <field name="model_id" ref="model_sf_revenue_leakage_analyzer"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_revenue_leakage_analyzer"/>
    </record>
</odoo>
