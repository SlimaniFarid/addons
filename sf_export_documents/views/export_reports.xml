<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="report_export_invoice" model="ir.actions.report">
        <field name="name">Export Commercial Invoice</field>
        <field name="model">sf.export.dossier</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">sf_export_documents.export_invoice_template</field>
        <field name="report_file">sf_export_documents.export_invoice_template</field>
        <field name="binding_model_id" ref="model_sf_export_dossier"/>
        <field name="binding_type">report</field>
    </record>

    <record id="report_export_packing" model="ir.actions.report">
        <field name="name">Export Packing List</field>
        <field name="model">sf.export.dossier</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">sf_export_documents.export_packing_template</field>
        <field name="report_file">sf_export_documents.export_packing_template</field>
        <field name="binding_model_id" ref="model_sf_export_dossier"/>
        <field name="binding_type">report</field>
    </record>

    <record id="report_export_origin" model="ir.actions.report">
        <field name="name">Certificate of Origin</field>
        <field name="model">sf.export.dossier</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">sf_export_documents.export_origin_template</field>
        <field name="report_file">sf_export_documents.export_origin_template</field>
        <field name="binding_model_id" ref="model_sf_export_dossier"/>
        <field name="binding_type">report</field>
    </record>

    <record id="report_export_eur1" model="ir.actions.report">
        <field name="name">EUR.1 / ATR</field>
        <field name="model">sf.export.dossier</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">sf_export_documents.export_eur1_template</field>
        <field name="report_file">sf_export_documents.export_eur1_template</field>
        <field name="binding_model_id" ref="model_sf_export_dossier"/>
        <field name="binding_type">report</field>
    </record>

    <template id="export_invoice_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>Commercial Invoice</h2>
                        <div class="row">
                            <div class="col-6">
                                <strong>Seller:</strong>
                                <p>
                                    <t t-esc="o.company_id.name"/><br/>
                                    <t t-esc="o.company_id.partner_id.street or ''"/>
                                </p>
                            </div>
                            <div class="col-6">
                                <strong>Buyer:</strong>
                                <p>
                                    <t t-esc="o.partner_id.name"/><br/>
                                    <t t-esc="o.partner_id.street or ''"/><br/>
                                    <t t-esc="o.destination_country_id.name or ''"/>
                                </p>
                            </div>
                        </div>
                        <p><strong>Invoice No:</strong> <t t-esc="o.name"/>
                           <strong>Date:</strong> <t t-esc="o.create_date.date()"/>
                           <strong>Incoterm:</strong> <t t-esc="o.incoterm_id.code or ''"/></p>
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Product</th>
                                    <th class="text-right">Qty</th>
                                    <th class="text-right">Unit Price</th>
                                    <th class="text-right">Total</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="o.sale_order_id.order_line or []" t-as="line">
                                    <tr>
                                        <td><t t-esc="line.name"/></td>
                                        <td class="text-right"><t t-esc="line.product_uom_qty"/></td>
                                        <td class="text-right"><t t-esc="line.price_unit"/></td>
                                        <td class="text-right"><t t-esc="line.price_subtotal"/></td>
                                    </tr>
                                </t>
                            </tbody>
                            <tfoot>
                                <tr>
                                    <td colspan="3" class="text-right"><strong>Total</strong></td>
                                    <td class="text-right"><t t-esc="o.sale_order_id.amount_total if o.sale_order_id else 0"/></td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <template id="export_packing_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>Packing List</h2>
                        <p><strong>Dossier:</strong> <t t-esc="o.name"/>
                           <strong>Buyer:</strong> <t t-esc="o.partner_id.name"/>
                           <strong>Port of loading:</strong> <t t-esc="o.port_loading or ''"/>
                           <strong>Port of discharge:</strong> <t t-esc="o.port_discharge or ''"/></p>
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Product</th>
                                    <th class="text-right">Qty</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="o.sale_order_id.order_line or []" t-as="line">
                                    <tr>
                                        <td><t t-esc="line.name"/></td>
                                        <td class="text-right"><t t-esc="line.product_uom_qty"/></td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <template id="export_origin_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>Certificate of Origin</h2>
                        <p><strong>Dossier:</strong> <t t-esc="o.name"/></p>
                        <table class="table table-sm">
                            <tr><td><strong>Exporter</strong></td><td><t t-esc="o.company_id.name"/></td></tr>
                            <tr><td><strong>Consignee</strong></td><td><t t-esc="o.partner_id.name"/></td></tr>
                            <tr><td><strong>Country of origin</strong></td><td><t t-esc="o.origin_country_id.name or ''"/></td></tr>
                            <tr><td><strong>Destination country</strong></td><td><t t-esc="o.destination_country_id.name or ''"/></td></tr>
                            <tr><td><strong>Incoterm</strong></td><td><t t-esc="o.incoterm_id.code or ''"/></td></tr>
                            <tr><td><strong>Transport mode</strong></td><td><t t-esc="o.transport_mode"/></td></tr>
                        </table>
                        <p>The goods described herein originate from the country of origin stated above.</p>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <template id="export_eur1_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>Movement Certificate EUR.1 / ATR</h2>
                        <table class="table table-sm">
                            <tr><td><strong>Exporter</strong></td><td><t t-esc="o.company_id.name"/></td></tr>
                            <tr><td><strong>Consignee</strong></td><td><t t-esc="o.partner_id.name"/></td></tr>
                            <tr><td><strong>Country of origin</strong></td><td><t t-esc="o.origin_country_id.name or ''"/></td></tr>
                            <tr><td><strong>Destination country</strong></td><td><t t-esc="o.destination_country_id.name or ''"/></td></tr>
                            <tr><td><strong>Incoterm</strong></td><td><t t-esc="o.incoterm_id.code or ''"/></td></tr>
                            <tr><td><strong>Transport mode</strong></td><td><t t-esc="o.transport_mode"/></td></tr>
                        </table>
                        <p>This certificate supports preferential origin for the goods of the export dossier.</p>
                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>