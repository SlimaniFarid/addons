<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_export" model="ir.module.category">
        <field name="name">Export Documents</field>
        <field name="sequence">90</field>
    </record>

    <record id="group_export_user" model="res.groups">
        <field name="name">Export Documents User</field>
        <field name="category_id" ref="module_category_export"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_export_manager" model="res.groups">
        <field name="name">Export Documents Manager</field>
        <field name="category_id" ref="module_category_export"/>
        <field name="implied_ids" eval="[(4, ref('group_export_user'))]"/>
    </record>

    <record id="rule_export_dossier_user_company" model="ir.rule">
        <field name="name">Dossier: user sees own company</field>
        <field name="model_id" ref="model_sf_export_dossier"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_export_user'))]"/>
    </record>

    <record id="rule_export_incoterm_user" model="ir.rule">
        <field name="name">Incoterm: visible to users</field>
        <field name="model_id" ref="model_sf_export_incoterm"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_export_user'))]"/>
    </record>

    <record id="rule_export_dossier_manager_all" model="ir.rule">
        <field name="name">Dossier: manager sees all companies</field>
        <field name="model_id" ref="model_sf_export_dossier"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_export_manager'))]"/>
    </record>

    <record id="rule_export_incoterm_manager" model="ir.rule">
        <field name="name">Incoterm: manager access</field>
        <field name="model_id" ref="model_sf_export_incoterm"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_export_manager'))]"/>
    </record>
    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_export"/>
    </record>
</odoo>