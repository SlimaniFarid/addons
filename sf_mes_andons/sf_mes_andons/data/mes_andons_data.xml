<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Default escalation rules -->
        <record id="escalation_quality_l1" model="sf.andon.escalation.rule">
            <field name="name">Quality - Level 1</field>
            <field name="call_type">quality</field>
            <field name="level">1</field>
            <field name="trigger_delay">5</field>
            <field name="send_email">True</field>
        </record>
        <record id="escalation_quality_l2" model="sf.andon.escalation.rule">
            <field name="name">Quality - Level 2</field>
            <field name="call_type">quality</field>
            <field name="level">2</field>
            <field name="trigger_delay">15</field>
            <field name="send_email">True</field>
        </record>
        <record id="escalation_maintenance_l1" model="sf.andon.escalation.rule">
            <field name="name">Maintenance - Level 1</field>
            <field name="call_type">maintenance</field>
            <field name="level">1</field>
            <field name="trigger_delay">10</field>
        </record>
        <record id="escalation_material_l1" model="sf.andon.escalation.rule">
            <field name="name">Material - Level 1</field>
            <field name="call_type">material</field>
            <field name="level">1</field>
            <field name="trigger_delay">10</field>
        </record>
        <record id="escalation_safety_l1" model="sf.andon.escalation.rule">
            <field name="name">Safety - Level 1</field>
            <field name="call_type">safety</field>
            <field name="level">1</field>
            <field name="trigger_delay">0</field>
            <field name="send_email">True</field>
            <field name="send_sms">True</field>
        </record>
    </data>
</odoo>