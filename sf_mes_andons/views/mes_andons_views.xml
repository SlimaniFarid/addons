<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Andon Call Form -->
    <record id="andon_call_view_form" model="ir.ui.view">
        <field name="name">sf.andon.call.form</field>
        <field name="model">sf.andon.call</field>
        <field name="arch" type="xml">
            <form string="Andon Call">
                <header>
                    <button name="action_acknowledge" type="object"
                            string="Acknowledge" class="btn-primary"
                            invisible="[('state', 'not in', ('new',))]" groups="sf_mes_andons.group_mes_andons_responder,sf_mes_andons.group_mes_andons_manager"/>
                    <button name="action_start_work" type="object"
                            string="Start Work" class="btn-secondary"
                            invisible="[('state', 'not in', ('new', 'acknowledged'))]" groups="sf_mes_andons.group_mes_andons_responder,sf_mes_andons.group_mes_andons_manager"/>
                    <button name="action_resolve" type="object"
                            string="Resolve" class="btn-primary"
                            invisible="[('state', 'not in', ('acknowledged', 'in_progress'))]" groups="sf_mes_andons.group_mes_andons_responder,sf_mes_andons.group_mes_andons_manager"/>
                    <button name="action_close" type="object"
                            string="Close" class="btn-secondary"
                            invisible="[('state', 'not in', ('resolved',))]" groups="sf_mes_andons.group_mes_andons_manager"/>
                    <button name="action_cancel" type="object"
                            string="Cancel" class="btn-secondary"
                            invisible="[('state', 'not in', ('new', 'acknowledged', 'in_progress'))]" groups="sf_mes_andons.group_mes_andons_manager"/>
                    <button name="action_escalate" type="object"
                            string="Escalate" class="btn-warning"
                            invisible="[('state', 'not in', ('new', 'acknowledged', 'in_progress'))]" groups="sf_mes_andons.group_mes_andons_manager"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="new,acknowledged,in_progress,resolved,closed"
                           statusbar_colors='{"new":"red","acknowledged":"orange","in_progress":"blue","resolved":"green","closed":"gray"}'/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="display_name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="station_id"/>
                            <field name="work_order_id"/>
                            <field name="call_type"/>
                            <field name="severity" widget="radio"/>
                        </group>
                        <group>
                            <field name="priority"/>
                            <field name="escalation_level"/>
                            <field name="assigned_user_id"/>
                            <field name="create_date" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="description"/>
                    </group>
                    <group string="Resolution" invisible="[('state', 'in', ('new', 'acknowledged', 'in_progress'))]">
                        <group>
                            <field name="root_cause"/>
                            <field name="corrective_action"/>
                        </group>
                        <group>
                            <field name="preventive_action"/>
                        </group>
                    </group>
                    <group string="Timestamps" invisible="[('state', '=', 'new')]">
                        <group>
                            <field name="acknowledged_date" readonly="1"/>
                            <field name="response_time" readonly="1" widget="float_time"/>
                        </group>
                        <group>
                            <field name="resolved_date" readonly="1"/>
                            <field name="resolution_time" readonly="1" widget="float_time"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Response Log">
                            <field name="response_log_ids">
                                <tree string="Response Log" editable="bottom">
                                    <field name="user_id"/>
                                    <field name="action"/>
                                    <field name="comment"/>
                                    <field name="create_date"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="andon_call_view_tree" model="ir.ui.view">
        <field name="name">sf.andon.call.tree</field>
        <field name="model">sf.andon.call</field>
        <field name="arch" type="xml">
            <tree string="Andon Calls" decoration-danger="state=='new' and severity in ('high','critical')"
                  decoration-warning="state=='acknowledged'" decoration-info="state=='in_progress'"
                  decoration-success="state in ('resolved','closed')" editable="bottom">
                <field name="display_name"/>
                <field name="station_id"/>
                <field name="call_type"/>
                <field name="severity"/>
                <field name="state"/>
                <field name="assigned_user_id"/>
                <field name="escalation_level"/>
                <field name="response_time" widget="float_time"/>
                <field name="resolution_time" widget="float_time"/>
            </tree>
        </field>
    </record>

    <record id="andon_call_view_kanban" model="ir.ui.view">
        <field name="name">sf.andon.call.kanban</field>
        <field name="model">sf.andon.call</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_andons" default_group_by="state">
                <field name="station_id"/>
                <field name="call_type"/>
                <field name="severity"/>
                <field name="assigned_user_id"/>
                <templates>
                    <t t-name="card">
                        <div t-attf-class="oe_kanban_card oe_kanban_andon_card {{'border-danger' if record.severity.raw_value in ('high','critical') else ''}}">
                            <div class="oe_kanban_content">
                                <div class="d-flex justify-content-between">
                                    <strong><field name="display_name"/></strong>
                                    <span t-attf-class="badge badge-{{'danger' if record.severity.raw_value == 'critical' else 'warning' if record.severity.raw_value == 'high' else 'info' if record.severity.raw_value == 'medium' else 'secondary'}}">
                                        <field name="severity"/>
                                    </span>
                                </div>
                                <div><field name="station_id"/></div>
                                <div><field name="call_type"/></div>
                                <div class="text-muted small"><field name="create_date"/></div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Station Form -->
    <record id="andon_station_view_form" model="ir.ui.view">
        <field name="name">sf.andon.station.form</field>
        <field name="model">sf.andon.station</field>
        <field name="arch" type="xml">
            <form string="Andon Station">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="sequence"/>
                            <field name="line_id"/>
                        </group>
                        <group>
                            <field name="location"/>
                            <field name="tower_light_ip"/>
                            <field name="tower_light_port"/>
                            <field name="screen_url"/>
                        </group>
                    </group>
                    <group>
                        <field name="active_operators" widget="many2many_tags"/>
                    </group>
                    <notebook>
                        <page string="Calls">
                            <field name="call_ids">
                                <tree string="Calls">
                                    <field name="display_name"/>
                                    <field name="call_type"/>
                                    <field name="severity"/>
                                    <field name="state"/>
                                    <field name="create_date"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="andon_station_view_tree" model="ir.ui.view">
        <field name="name">sf.andon.station.tree</field>
        <field name="model">sf.andon.station</field>
        <field name="arch" type="xml">
            <tree string="Andon Stations" editable="bottom">
                <field name="sequence"/>
                <field name="name"/>
                <field name="code"/>
                <field name="line_id"/>
                <field name="location"/>
                <field name="open_calls_count"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <!-- Escalation Rule -->
    <record id="escalation_rule_view_form" model="ir.ui.view">
        <field name="name">sf.andon.escalation.rule.form</field>
        <field name="model">sf.andon.escalation.rule</field>
        <field name="arch" type="xml">
            <form string="Escalation Rule">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="call_type"/>
                            <field name="level"/>
                            <field name="trigger_delay"/>
                        </group>
                        <group>
                            <field name="send_email"/>
                            <field name="send_sms"/>
                            <field name="require_acknowledgment"/>
                            <field name="auto_escalate"/>
                        </group>
                    </group>
                    <group>
                        <field name="user_ids" widget="many2many_tags"/>
                        <field name="group_ids" widget="many2many_tags"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="escalation_rule_view_tree" model="ir.ui.view">
        <field name="name">sf.andon.escalation.rule.tree</field>
        <field name="model">sf.andon.escalation.rule</field>
        <field name="arch" type="xml">
            <tree string="Escalation Rules" editable="bottom">
                <field name="call_type"/>
                <field name="level"/>
                <field name="trigger_delay"/>
                <field name="user_ids" widget="many2many_tags"/>
                <field name="send_email"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <!-- Response Log -->
    <record id="response_log_view_tree" model="ir.ui.view">
        <field name="name">sf.andon.response.log.tree</field>
        <field name="model">sf.andon.response.log</field>
        <field name="arch" type="xml">
            <tree string="Response Log">
                <field name="call_id"/>
                <field name="user_id"/>
                <field name="action"/>
                <field name="comment"/>
                <field name="create_date"/>
            </tree>
        </field>
    </record>

    <!-- Dashboard Action -->
    <record id="action_andon_dashboard" model="ir.actions.act_window">
        <field name="name">Andon Dashboard</field>
        <field name="res_model">sf.andon.call</field>
        <field name="view_mode">kanban,tree,form,pivot,graph</field>
        <field name="context">{"search_default_state_new": 1}</field>
    </record>

    <!-- Visual Board Action -->
    <record id="action_andon_board" model="ir.actions.act_window">
        <field name="name">Andon Visual Board</field>
        <field name="res_model">sf.andon.call</field>
        <field name="view_mode">kanban</field>
        <field name="context">{"search_default_state_new": 1, "search_default_state_acknowledged": 1, "search_default_state_in_progress": 1}</field>
    </record>

    <!-- Actions -->
    <record id="action_andon_call" model="ir.actions.act_window">
        <field name="name">Andon Calls</field>
        <field name="res_model">sf.andon.call</field>
        <field name="view_mode">tree,kanban,form,pivot,graph</field>
    </record>

    <record id="action_andon_station" model="ir.actions.act_window">
        <field name="name">Stations</field>
        <field name="res_model">sf.andon.station</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record id="action_escalation_rule" model="ir.actions.act_window">
        <field name="name">Escalation Rules</field>
        <field name="res_model">sf.andon.escalation.rule</field>
        <field name="view_mode">tree,form</field>
    </record>

</odoo>