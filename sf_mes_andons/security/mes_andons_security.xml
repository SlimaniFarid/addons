<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_mes_andons" model="ir.module.category">
        <field name="name">MES Andon</field>
        <field name="sequence">96</field>
    </record>

    <record id="group_mes_andons_operator" model="res.groups">
        <field name="name">Andon Operator</field>
        <field name="category_id" ref="module_category_mes_andons"/>
        <field name="implied_ids" eval="[(4, ref('mrp.group_mrp_user'))]"/>
    </record>

    <record id="group_mes_andons_responder" model="res.groups">
        <field name="name">Andon Responder</field>
        <field name="category_id" ref="module_category_mes_andons"/>
        <field name="implied_ids" eval="[(4, ref('group_mes_andons_operator'))]"/>
    </record>

    <record id="group_mes_andons_manager" model="res.groups">
        <field name="name">Andon Manager</field>
        <field name="category_id" ref="module_category_mes_andons"/>
        <field name="implied_ids" eval="[(4, ref('group_mes_andons_responder'))]"/>
    </record>
</odoo>