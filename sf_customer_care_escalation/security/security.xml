<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_customer_care_escalation" model="ir.module.category">
        <field name="name">Customer Care Escalation Tracker</field>
        <field name="sequence">162</field>
    </record>
    <record id="group_customer_care_escalation_user" model="res.groups">
        <field name="name">Customer Care Escalation Tracker User</field>
        <field name="category_id" ref="module_category_customer_care_escalation"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>

    </record>
    <record id="group_customer_care_escalation_manager" model="res.groups">
        <field name="name">Customer Care Escalation Tracker Manager</field>
        <field name="category_id" ref="module_category_customer_care_escalation"/>
        <field name="implied_ids" eval="[(4, ref('group_customer_care_escalation_user'))]"/>
    </record>
    <record id="rule_customer_care_escalation_sf_customer_care_escalation" model="ir.rule">
        <field name="name">Customer Care Escalation Tracker: multi-company</field>
        <field name="model_id" ref="model_sf_customer_care_escalation"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_customer_care_escalation"/>
    </record>
</odoo>
