<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_quality_inspection_plan" model="ir.actions.act_window">
        <field name="name">Inspection Plan Template</field>
        <field name="res_model">sf.quality_inspection_plan</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
    <record id="view_sf_quality_inspection_plan_form" model="ir.ui.view">
        <field name="name">sf.quality_inspection_plan.form</field>
        <field name="model">sf.quality_inspection_plan</field>
        <field name="arch" type="xml">
            <form string="Inspection Plan Template">
                <header>
                    <button name="action_submitted" type="object" string="Submitted"
                            class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="product_id"/>
                            <field name="operation"/>
                            <field name="inspection_type"/>
                            <field name="sampling_plan"/>
                            <field name="criteria"/>
                            <field name="control_method"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_quality_inspection_plan_list" model="ir.ui.view">
        <field name="name">sf.quality_inspection_plan.list</field>
        <field name="model">sf.quality_inspection_plan</field>
        <field name="arch" type="xml">
            <list string="Inspection Plan Template" sample="1">
                <field name="product_id"/>
                <field name="operation"/>
                <field name="inspection_type"/>
                <field name="sampling_plan"/>
                <field name="criteria"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state in ('submitted','approved')"/>
            </list>
        </field>
    </record>
    <record id="view_sf_quality_inspection_plan_kanban" model="ir.ui.view">
        <field name="name">sf.quality_inspection_plan.kanban</field>
        <field name="model">sf.quality_inspection_plan</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_view" group_by="state">
                <field name="name"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <menuitem id="menu_sf_quality_inspection_plan_root" name="Inspection Plan Template" sequence="26"
              web_icon="sf_quality_inspection_plan,static/description/icon.png"/>
    <menuitem id="menu_sf_quality_inspection_plan_main" name="Records"
              parent="menu_sf_quality_inspection_plan_root" action="action_sf_quality_inspection_plan" sequence="10"/>
</odoo>
