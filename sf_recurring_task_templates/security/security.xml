<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_recurring_task_templates" model="ir.module.category">
        <field name="name">Recurring Task Templates</field>
        <field name="sequence">8</field>
    </record>
    <record id="group_recurring_task_templates_user" model="res.groups">
        <field name="name">Recurring Task Templates User</field>
        <field name="category_id" ref="module_category_recurring_task_templates"/>

    </record>
    <record id="group_recurring_task_templates_manager" model="res.groups">
        <field name="name">Recurring Task Templates Manager</field>
        <field name="category_id" ref="module_category_recurring_task_templates"/>
        <field name="implied_ids" eval="[(4, ref('group_recurring_task_templates_user'))]"/>
    </record>
    <record id="rule_recurring_task_templates_sf_recurring_task" model="ir.rule">
        <field name="name">Recurring Task Template: multi-company</field>
        <field name="model_id" ref="model_sf_recurring_task"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
