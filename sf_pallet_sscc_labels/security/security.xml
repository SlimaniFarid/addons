<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_pallet_sscc_labels" model="ir.module.category">
        <field name="name">Pallet SSCC Label Generator</field>
        <field name="sequence">30</field>
    </record>
    <record id="group_pallet_sscc_labels_user" model="res.groups">
        <field name="name">Pallet SSCC Label Generator User</field>
        <field name="category_id" ref="module_category_pallet_sscc_labels"/>
        <field name="implied_ids" eval="[(4, ref('stock.group_stock_user'))]"/>

    </record>
    <record id="group_pallet_sscc_labels_manager" model="res.groups">
        <field name="name">Pallet SSCC Label Generator Manager</field>
        <field name="category_id" ref="module_category_pallet_sscc_labels"/>
        <field name="implied_ids" eval="[(4, ref('group_pallet_sscc_labels_user'))]"/>
    </record>
    <record id="rule_pallet_sscc_labels_sf_pallet_sscc" model="ir.rule">
        <field name="name">Pallet Label: multi-company</field>
        <field name="model_id" ref="model_sf_pallet_sscc"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_pallet_sscc_labels"/>
    </record>
</odoo>
