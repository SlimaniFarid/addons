<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_quality_document_control_sys" model="ir.module.category">
        <field name="name">Quality Document Control System</field>
        <field name="sequence">482</field>
    </record>
    <record id="group_quality_document_control_sys_user" model="res.groups">
        <field name="name">Quality Document Control System User</field>
        <field name="category_id" ref="module_category_quality_document_control_sys"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>

    </record>
    <record id="group_quality_document_control_sys_manager" model="res.groups">
        <field name="name">Quality Document Control System Manager</field>
        <field name="category_id" ref="module_category_quality_document_control_sys"/>
        <field name="implied_ids" eval="[(4, ref('group_quality_document_control_sys_user'))]"/>
    </record>
    <record id="rule_quality_document_control_sys_sf_quality_document_control_sys" model="ir.rule">
        <field name="name">Quality Document Control System: multi-company</field>
        <field name="model_id" ref="model_sf_quality_document_control_sys"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_quality_document_control_sys"/>
    </record>
</odoo>
