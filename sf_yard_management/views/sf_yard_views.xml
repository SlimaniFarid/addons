<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sf_yard_trailer_list" model="ir.ui.view">
        <field name="name">sf.yard.trailer.list</field>
        <field name="model">sf.yard.trailer</field>
        <field name="arch" type="xml">
            <list string="Trailers" decoration-info="status == 'at_yard'"
                  decoration-warning="status == 'in_shunt'"
                  decoration-success="status == 'at_dock'">
                <field name="name"/>
                <field name="trailer_type"/>
                <field name="carrier_id"/>
                <field name="status" widget="badge"/>
                <field name="current_location_id"/>
                <field name="arrived_at"/>
                <field name="dwell_hours"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>
    <record id="view_sf_yard_trailer_form" model="ir.ui.view">
        <field name="name">sf.yard.trailer.form</field>
        <field name="model">sf.yard.trailer</field>
        <field name="arch" type="xml">
            <form string="Trailer">
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="trailer_type"/>
                            <field name="carrier_id"/>
                            <field name="owner_type"/>
                        </group>
                        <group>
                            <field name="status"/>
                            <field name="current_location_id"/>
                            <field name="arrived_at"/>
                            <field name="departed_at"/>
                            <field name="dwell_hours"/>
                        </group>
                    </group>
                    <field name="content_desc"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_sf_yard_trailer" model="ir.actions.act_window">
        <field name="name">Trailers</field>
        <field name="res_model">sf.yard.trailer</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_sf_yard_checkin" model="ir.actions.act_window">
        <field name="name">Check-ins</field>
        <field name="res_model">sf.yard.checkin</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_sf_yard_shunt" model="ir.actions.act_window">
        <field name="name">Shunt Moves</field>
        <field name="res_model">sf.yard.shunt.move</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_sf_yard_detention" model="ir.actions.act_window">
        <field name="name">Detention</field>
        <field name="res_model">sf.yard.detention</field>
        <field name="view_mode">list,form,pivot</field>
    </record>
    <record id="action_sf_yard_zone" model="ir.actions.act_window">
        <field name="name">Zones &amp; Locations</field>
        <field name="res_model">sf.yard.zone</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
