<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_sf_yard_management" model="ir.module.category">
        <field name="name">Yard Management</field>
        <field name="description">Yard Management System for trailer tracking, gate check-in/out, dock assignment and detention billing.</field>
        <field name="sequence">10</field>
    </record>

    <record id="group_sf_yard_user" model="res.groups">
        <field name="name">Yard Management / User</field>
        <field name="category_id" ref="module_category_sf_yard_management"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_sf_yard_manager" model="res.groups">
        <field name="name">Yard Management / Manager</field>
        <field name="category_id" ref="module_category_sf_yard_management"/>
        <field name="implied_ids" eval="[(4, ref('sf_yard_management.group_sf_yard_user'))]"/>
    </record>

    <record id="rule_sf_yard_zone_company" model="ir.rule">
        <field name="name">Zone: user sees own company</field>
        <field name="model_id" ref="model_sf_yard_zone"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('sf_yard_management.group_sf_yard_user'))]"/>
    </record>
    <record id="rule_sf_yard_trailer_company" model="ir.rule">
        <field name="name">Trailer: user sees own company</field>
        <field name="model_id" ref="model_sf_yard_trailer"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('sf_yard_management.group_sf_yard_user'))]"/>
    </record>
    <record id="rule_sf_yard_checkin_company" model="ir.rule">
        <field name="name">Checkin: user sees own company</field>
        <field name="model_id" ref="model_sf_yard_checkin"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('sf_yard_management.group_sf_yard_user'))]"/>
    </record>
    <record id="rule_sf_yard_shunt_company" model="ir.rule">
        <field name="name">Shunt: user sees own company</field>
        <field name="model_id" ref="model_sf_yard_shunt_move"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('sf_yard_management.group_sf_yard_user'))]"/>
    </record>
    <record id="rule_sf_yard_detention_company" model="ir.rule">
        <field name="name">Detention: user sees own company</field>
        <field name="model_id" ref="model_sf_yard_detention"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('sf_yard_management.group_sf_yard_user'))]"/>
    </record>

    <record id="rule_sf_yard_zone_manager_all" model="ir.rule">
        <field name="name">Zone: manager sees all companies</field>
        <field name="model_id" ref="model_sf_yard_zone"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('sf_yard_management.group_sf_yard_manager'))]"/>
    </record>
    <record id="rule_sf_yard_trailer_manager_all" model="ir.rule">
        <field name="name">Trailer: manager sees all companies</field>
        <field name="model_id" ref="model_sf_yard_trailer"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('sf_yard_management.group_sf_yard_manager'))]"/>
    </record>
    <record id="rule_sf_yard_checkin_manager_all" model="ir.rule">
        <field name="name">Checkin: manager sees all companies</field>
        <field name="model_id" ref="model_sf_yard_checkin"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('sf_yard_management.group_sf_yard_manager'))]"/>
    </record>
    <record id="rule_sf_yard_shunt_manager_all" model="ir.rule">
        <field name="name">Shunt: manager sees all companies</field>
        <field name="model_id" ref="model_sf_yard_shunt_move"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('sf_yard_management.group_sf_yard_manager'))]"/>
    </record>
    <record id="rule_sf_yard_detention_manager_all" model="ir.rule">
        <field name="name">Detention: manager sees all companies</field>
        <field name="model_id" ref="model_sf_yard_detention"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('sf_yard_management.group_sf_yard_manager'))]"/>
    </record>
    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_sf_yard_management"/>
    </record>
</odoo>
