<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_sf_yard_checkin" model="ir.sequence">
            <field name="name">Yard Check-in</field>
            <field name="code">sf.yard.checkin</field>
            <field name="prefix">YCI-</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="seq_sf_yard_shunt" model="ir.sequence">
            <field name="name">Yard Shunt Move</field>
            <field name="code">sf.yard.shunt.move</field>
            <field name="prefix">YSM-</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="seq_sf_yard_detention" model="ir.sequence">
            <field name="name">Yard Detention</field>
            <field name="code">sf.yard.detention</field>
            <field name="prefix">YDT-</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="cron_sf_yard_update_detention" model="ir.cron">
            <field name="name">Yard: Update Detention Clocks</field>
            <field name="model_id" ref="model_sf_yard_detention"/>
            <field name="function">_cron_update_detention</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="numbercall">-1</field>
            <field name="doall" eval="False"/>
        </record>
    </data>
</odoo>
