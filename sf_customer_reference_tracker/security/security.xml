<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_customer_reference_tracker" model="ir.module.category">
        <field name="name">Customer Reference Tracker</field>
        <field name="sequence">277</field>
    </record>
    <record id="group_customer_reference_tracker_user" model="res.groups">
        <field name="name">Customer Reference Tracker User</field>
        <field name="category_id" ref="module_category_customer_reference_tracker"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>

    </record>
    <record id="group_customer_reference_tracker_manager" model="res.groups">
        <field name="name">Customer Reference Tracker Manager</field>
        <field name="category_id" ref="module_category_customer_reference_tracker"/>
        <field name="implied_ids" eval="[(4, ref('group_customer_reference_tracker_user'))]"/>
    </record>
    <record id="rule_customer_reference_tracker_sf_customer_reference_tracker" model="ir.rule">
        <field name="name">Customer Reference Tracker: multi-company</field>
        <field name="model_id" ref="model_sf_customer_reference_tracker"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
