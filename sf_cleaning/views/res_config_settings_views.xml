<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sf_cleaning_config_settings" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.sf.cleaning</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Cleaning &amp; Services"
                     string="Cleaning &amp; Services"
                     name="sf_cleaning">
                    <block title="Alert Cron">
                        <setting string="Enable Cleaning Alerts"
                                 help="Enable the automatic alert cron that creates TODO activities for overdue frequencies and unassigned agents.">
                            <field name="sf_cleaning_alert_enabled"/>
                        </setting>
                        <setting string="Overdue Threshold (Days)"
                                 help="Number of days after the planned date before a schedule is considered overdue.">
                            <field name="sf_cleaning_overdue_days"/>
                        </setting>
                    </block>
                    <block title="Interventions">
                        <setting string="Default Intervention Duration (Hours)"
                                 help="Default duration in hours applied when computing the end time of an intervention.">
                            <field name="sf_cleaning_default_duration"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>