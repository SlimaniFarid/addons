<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sf_cleaning_contract_tree" model="ir.ui.view">
        <field name="name">sf.cleaning.contract.tree</field>
        <field name="model">sf.cleaning.contract</field>
        <field name="arch" type="xml">
            <tree string="Cleaning Contracts">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="contract_type"/>
                <field name="billing_period"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="overdue_quality_check_count"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <record id="view_sf_cleaning_contract_form" model="ir.ui.view">
        <field name="name">sf.cleaning.contract.form</field>
        <field name="model">sf.cleaning.contract</field>
        <field name="arch" type="xml">
            <form string="Cleaning Contract">
                <header>
                    <button name="action_activate" type="object"
                            string="Activate" class="btn-primary"
                            invisible="state != 'draft'"
                            groups="sf_cleaning.group_sf_cleaning_manager"/>
                    <button name="action_suspend" type="object"
                            string="Suspend" class="btn-warning"
                            invisible="state != 'active'"
                            groups="sf_cleaning.group_sf_cleaning_manager"/>
                    <button name="action_resume" type="object"
                            string="Resume" class="btn-primary"
                            invisible="state != 'suspended'"
                            groups="sf_cleaning.group_sf_cleaning_manager"/>
                    <button name="action_done" type="object"
                            string="Mark Done" class="btn-success"
                            invisible="state not in ('active', 'suspended')"
                            groups="sf_cleaning.group_sf_cleaning_manager"/>
                    <button name="action_cancel" type="object"
                            string="Cancel" class="btn-danger"
                            invisible="state not in ('draft', 'active', 'suspended')"
                            groups="sf_cleaning.group_sf_cleaning_manager"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="partner_id"/>
                            <field name="contract_type"/>
                        </group>
                        <group>
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <field name="billing_period"/>
                            <field name="overdue_quality_check_count" readonly="1"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Site lines">
                            <field name="line_ids">
                                <tree string="Site lines" editable="bottom">
                                    <field name="site_id"/>
                                    <field name="cleaning_type"/>
                                    <field name="frequency"/>
                                    <field name="interval_days" readonly="1"/>
                                    <field name="planned_qty"/>
                                    <field name="unit_price"/>
                                    <field name="currency_id" groups="base.group_multi_currency"/>
                                    <field name="active"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Schedules">
                            <field name="schedule_ids" readonly="1">
                                <tree string="Schedules">
                                    <field name="name"/>
                                    <field name="site_id"/>
                                    <field name="agent_id"/>
                                    <field name="planned_date"/>
                                    <field name="invoice_amount"/>
                                    <field name="state"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Notes">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_sf_cleaning_contract_search" model="ir.ui.view">
        <field name="name">sf.cleaning.contract.search</field>
        <field name="model">sf.cleaning.contract</field>
        <field name="arch" type="xml">
            <search string="Cleaning Contracts">
                <field name="name"/>
                <field name="partner_id"/>
                <filter string="Active" name="active_contract"
                        domain="[('state', '=', 'active')]"/>
                <filter string="Suspended" name="suspended_contract"
                        domain="[('state', '=', 'suspended')]"/>
                <filter string="Overdue quality checks" name="overdue_contract"
                        domain="[('overdue_quality_check_count', '&gt;', 0)]"/>
                <group>
                    <filter string="Status" name="state_group"
                            context="{'group_by': 'state'}"/>
                    <filter string="Contract type" name="type_group"
                            context="{'group_by': 'contract_type'}"/>
                    <filter string="Billing period" name="billing_group"
                            context="{'group_by': 'billing_period'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_sf_cleaning_contract" model="ir.actions.act_window">
        <field name="name">Contracts</field>
        <field name="res_model">sf.cleaning.contract</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_sf_cleaning_contract_search"/>
    </record>

    <record id="view_sf_cleaning_site_tree" model="ir.ui.view">
        <field name="name">sf.cleaning.site.tree</field>
        <field name="model">sf.cleaning.site</field>
        <field name="arch" type="xml">
            <tree string="Cleaning Sites">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="address_id"/>
                <field name="manager_id"/>
                <field name="area_m2"/>
                <field name="validated_intervention_count"/>
            </tree>
        </field>
    </record>

    <record id="view_sf_cleaning_site_form" model="ir.ui.view">
        <field name="name">sf.cleaning.site.form</field>
        <field name="model">sf.cleaning.site</field>
        <field name="arch" type="xml">
            <form string="Cleaning Site">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="partner_id"/>
                            <field name="address_id"/>
                        </group>
                        <group>
                            <field name="area_m2"/>
                            <field name="manager_id"/>
                            <field name="validated_intervention_count" readonly="1"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="notes"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Schedules">
                            <field name="schedule_ids" readonly="1">
                                <tree string="Schedules">
                                    <field name="name"/>
                                    <field name="contract_id"/>
                                    <field name="agent_id"/>
                                    <field name="planned_date"/>
                                    <field name="invoice_amount"/>
                                    <field name="state"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_sf_cleaning_site_search" model="ir.ui.view">
        <field name="name">sf.cleaning.site.search</field>
        <field name="model">sf.cleaning.site</field>
        <field name="arch" type="xml">
            <search string="Cleaning Sites">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="manager_id"/>
                <group>
                    <filter string="Manager" name="manager_group"
                            context="{'group_by': 'manager_id'}"/>
                    <filter string="Client" name="partner_group"
                            context="{'group_by': 'partner_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_sf_cleaning_site" model="ir.actions.act_window">
        <field name="name">Sites</field>
        <field name="res_model">sf.cleaning.site</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_sf_cleaning_site_search"/>
    </record>

    <record id="view_sf_cleaning_schedule_tree" model="ir.ui.view">
        <field name="name">sf.cleaning.schedule.tree</field>
        <field name="model">sf.cleaning.schedule</field>
        <field name="arch" type="xml">
            <tree string="Cleaning Schedules">
                <field name="name"/>
                <field name="contract_id"/>
                <field name="site_id"/>
                <field name="agent_id"/>
                <field name="planned_date"/>
                <field name="qty"/>
                <field name="invoice_amount"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <record id="view_sf_cleaning_schedule_form" model="ir.ui.view">
        <field name="name">sf.cleaning.schedule.form</field>
        <field name="model">sf.cleaning.schedule</field>
        <field name="arch" type="xml">
            <form string="Cleaning Schedule">
                <header>
                    <button name="action_start" type="object"
                            string="Start" class="btn-primary"
                            invisible="state != 'planned'"/>
                    <button name="action_submit" type="object"
                            string="Submit" class="btn-primary"
                            invisible="state != 'in_progress'"/>
                    <button name="action_validate" type="object"
                            string="Validate" class="btn-success"
                            invisible="state != 'submitted'"
                            groups="sf_cleaning.group_sf_cleaning_manager"/>
                    <button name="action_invoice" type="object"
                            string="Invoice" class="btn-success"
                            invisible="state != 'validated'"
                            groups="sf_cleaning.group_sf_cleaning_manager"/>
                    <button name="action_cancel" type="object"
                            string="Cancel" class="btn-danger"
                            invisible="state not in ('planned', 'in_progress', 'submitted')"
                            groups="sf_cleaning.group_sf_cleaning_manager"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="contract_id"/>
                            <field name="site_id"/>
                        </group>
                        <group>
                            <field name="agent_id"/>
                            <field name="planned_date"/>
                            <field name="qty"/>
                            <field name="invoice_amount" readonly="1"/>
                            <field name="activity_date"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Interventions">
                            <field name="line_ids"
                                   readonly="state in ('validated', 'invoiced', 'cancelled')">
                                <tree string="Interventions" editable="bottom">
                                    <field name="task"/>
                                    <field name="planned_date"/>
                                    <field name="agent_id"/>
                                    <field name="start_time"/>
                                    <field name="end_time"/>
                                    <field name="executed_date"/>
                                    <field name="prochaine_date_prevue" readonly="1"/>
                                    <field name="quality_check_id"/>
                                    <field name="state"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_sf_cleaning_schedule_search" model="ir.ui.view">
        <field name="name">sf.cleaning.schedule.search</field>
        <field name="model">sf.cleaning.schedule</field>
        <field name="arch" type="xml">
            <search string="Cleaning Schedules">
                <field name="name"/>
                <field name="contract_id"/>
                <field name="site_id"/>
                <field name="agent_id"/>
                <filter string="Validated" name="validated_schedule"
                        domain="[('state', '=', 'validated')]"/>
                <filter string="Invoiced" name="invoiced_schedule"
                        domain="[('state', '=', 'invoiced')]"/>
                <filter string="Unassigned agent" name="unassigned_schedule"
                        domain="[('agent_id', '=', False)]"/>
                <group>
                    <filter string="Status" name="state_group"
                            context="{'group_by': 'state'}"/>
                    <filter string="Site" name="site_group"
                            context="{'group_by': 'site_id'}"/>
                    <filter string="Agent" name="agent_group"
                            context="{'group_by': 'agent_id'}"/>
                    <filter string="Contract" name="contract_group"
                            context="{'group_by': 'contract_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_sf_cleaning_schedule" model="ir.actions.act_window">
        <field name="name">Schedules</field>
        <field name="res_model">sf.cleaning.schedule</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_sf_cleaning_schedule_search"/>
    </record>

    <record id="view_sf_cleaning_quality_check_tree" model="ir.ui.view">
        <field name="name">sf.cleaning.quality.check.tree</field>
        <field name="model">sf.cleaning.quality_check</field>
        <field name="arch" type="xml">
            <tree string="Quality Checks">
                <field name="name"/>
                <field name="schedule_line_id"/>
                <field name="checker_id"/>
                <field name="check_date"/>
                <field name="rating"/>
                <field name="redo_required"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <record id="view_sf_cleaning_quality_check_form" model="ir.ui.view">
        <field name="name">sf.cleaning.quality.check.form</field>
        <field name="model">sf.cleaning.quality_check</field>
        <field name="arch" type="xml">
            <form string="Quality Check">
                <header>
                    <button name="action_validate" type="object"
                            string="Validate" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="schedule_line_id"/>
                            <field name="checker_id"/>
                        </group>
                        <group>
                            <field name="check_date"/>
                            <field name="rating"/>
                            <field name="redo_required"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="comments"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_sf_cleaning_quality_check_search" model="ir.ui.view">
        <field name="name">sf.cleaning.quality.check.search</field>
        <field name="model">sf.cleaning.quality_check</field>
        <field name="arch" type="xml">
            <search string="Quality Checks">
                <field name="name"/>
                <field name="schedule_line_id"/>
                <field name="checker_id"/>
                <filter string="Draft" name="draft_check"
                        domain="[('state', '=', 'draft')]"/>
                <filter string="Done" name="done_check"
                        domain="[('state', '=', 'done')]"/>
                <filter string="Redo required" name="redo_check"
                        domain="[('redo_required', '=', True)]"/>
                <group>
                    <filter string="Status" name="state_group"
                            context="{'group_by': 'state'}"/>
                    <filter string="Checker" name="checker_group"
                            context="{'group_by': 'checker_id'}"/>
                    <filter string="Rating" name="rating_group"
                            context="{'group_by': 'rating'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_sf_cleaning_quality_check" model="ir.actions.act_window">
        <field name="name">Quality Checks</field>
        <field name="res_model">sf.cleaning.quality_check</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_sf_cleaning_quality_check_search"/>
    </record>
</odoo>