<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_sf_cleaning_contract" model="ir.sequence">
            <field name="name">Cleaning Contract</field>
            <field name="code">sf.cleaning.contract</field>
            <field name="prefix">CLN-</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>

        <record id="seq_sf_cleaning_schedule" model="ir.sequence">
            <field name="name">Cleaning Schedule</field>
            <field name="code">sf.cleaning.schedule</field>
            <field name="prefix">SCH-</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>

        <record id="seq_sf_cleaning_quality_check" model="ir.sequence">
            <field name="name">Cleaning Quality Check</field>
            <field name="code">sf.cleaning.quality_check</field>
            <field name="prefix">QC-</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>

        <record id="cron_sf_cleaning_alert" model="ir.cron">
            <field name="name">SF Cleaning Alert</field>
            <field name="model_id" ref="model_sf_cleaning_schedule"/>
            <field name="state">code</field>
            <field name="code">model._cron_sf_cleaning_alert()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="active">True</field>
        </record>
    </data>
</odoo>