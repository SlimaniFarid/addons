<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_sf_cleaning" model="ir.module.category">
        <field name="name">Sales</field>
        <field name="sequence">90</field>
    </record>

    <record id="group_sf_cleaning_user" model="res.groups">
        <field name="name">Cleaning User</field>
        <field name="category_id" ref="module_category_sf_cleaning"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_sf_cleaning_manager" model="res.groups">
        <field name="name">Cleaning Manager</field>
        <field name="category_id" ref="module_category_sf_cleaning"/>
        <field name="implied_ids" eval="[(4, ref('group_sf_cleaning_user'))]"/>
    </record>

    <record id="rule_sf_cleaning_contract_user_company" model="ir.rule">
        <field name="name">Contract: user sees own company</field>
        <field name="model_id" ref="model_sf_cleaning_contract"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_sf_cleaning_user'))]"/>
    </record>

    <record id="rule_sf_cleaning_contract_manager_all" model="ir.rule">
        <field name="name">Contract: manager sees all companies</field>
        <field name="model_id" ref="model_sf_cleaning_contract"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_sf_cleaning_manager'))]"/>
    </record>

    <record id="rule_sf_cleaning_contract_line_user_company" model="ir.rule">
