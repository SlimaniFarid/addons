<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_sf_gym" model="ir.module.category">
        <field name="name">Gym &amp; Fitness</field>
        <field name="sequence">90</field>
    </record>

    <record id="group_sf_gym_user" model="res.groups">
        <field name="name">Gym User</field>
        <field name="category_id" ref="module_category_sf_gym"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_sf_gym_manager" model="res.groups">
        <field name="name">Gym Manager</field>
        <field name="category_id" ref="module_category_sf_gym"/>
        <field name="implied_ids" eval="[(4, ref('group_sf_gym_user'))]"/>
    </record>

    <record id="rule_sf_gym_member_user_company" model="ir.rule">
        <field name="name">Member: user sees own company</field>
        <field name="model_id" ref="model_sf_gym_member"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_sf_gym_user'))]"/>
    </record>

    <record id="rule_sf_gym_member_manager_all" model="ir.rule">
        <field name="name">Member: manager sees all companies</field>
        <field name="model_id" ref="model_sf_gym_member"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_sf_gym_manager'))]"/>
    </record>

