<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_sf_gym_member" model="ir.sequence">
            <field name="name">Gym Member</field>
            <field name="code">sf.gym.member</field>
            <field name="prefix">MEM-</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>

        <record id="seq_sf_gym_plan" model="ir.sequence">
            <field name="name">Gym Plan</field>
            <field name="code">sf.gym.plan</field>
            <field name="prefix">PLA-</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>

        <record id="seq_sf_gym_lesson" model="ir.sequence">
            <field name="name">Gym Lesson</field>
            <field name="code">sf.gym.lesson</field>
            <field name="prefix">LES-</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>

        <record id="seq_sf_gym_subscription" model="ir.sequence">
            <field name="name">Gym Subscription</field>
            <field name="code">sf.gym.subscription</field>
            <field name="prefix">SUB-</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>

        <record id="seq_sf_gym_session" model="ir.sequence">
            <field name="name">Gym Session</field>
            <field name="code">sf.gym.session</field>
            <field name="prefix">SES-</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>

        <record id="seq_sf_gym_attendance" model="ir.sequence">
            <field name="name">Gym Attendance</field>
            <field name="code">sf.gym.attendance</field>
            <field name="prefix">ATT-</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>

        <record id="seq_sf_gym_payment" model="ir.sequence">
            <field name="name">Gym Payment</field>
            <field name="code">sf.gym.payment</field>
            <field name="prefix">PAY-</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>

        <record id="cron_sf_gym_expire_subscriptions" model="ir.cron">
            <field name="name">Gym: Expire Subscriptions</field>
            <field name="model_id" ref="model_sf_gym_subscription"/>
            <field name="state">code</field>
            <field name="code">model._cron_expire_subscriptions()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="active">True</field>
        </record>

        <record id="cron_sf_gym_alerts" model="ir.cron">
            <field name="name">Gym: Renewal and Empty Session Alerts</field>
            <field name="model_id" ref="model_sf_gym_subscription"/>
            <field name="state">code</field>
            <field name="code">model._cron_gym_alerts()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="active">True</field>
        </record>
    </data>
</odoo>
