<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sf_gym_config_settings" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.sf.gym</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Gym &amp; Fitness"
                     string="Gym &amp; Fitness"
                     name="sf_gym_fitness">
                    <block title="Alerts">
                        <setting string="Subscription Alert Days"
                                 help="Number of days before the end of an active subscription that triggers a renewal alert for unpaid subscriptions, and days for empty session alerts by the daily cron.">
                            <field name="sf_gym_alert_days"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
