<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="report_sf_gym_subscription_contract" model="ir.actions.report">
        <field name="name">Subscription Contract</field>
        <field name="model">sf.gym.subscription</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">sf_gym_fitness.sf_gym_subscription_contract_template</field>
        <field name="report_file">sf_gym_fitness.sf_gym_subscription_contract_template</field>
        <field name="binding_model_id" ref="model_sf_gym_subscription"/>
        <field name="binding_type">report</field>
    </record>

    <template id="sf_gym_subscription_contract_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>Subscription Contract</h2>
                        <table class="table table-sm">
                            <tr><td><strong>Number</strong></td><td><t t-esc="o.name"/></td></tr>
                            <tr><td><strong>Member</strong></td><td><t t-esc="o.member_id.name or ''"/></td></tr>
                            <tr><td><strong>Plan</strong></td><td><t t-esc="o.plan_id.name or ''"/></td></tr>
                            <tr><td><strong>Start date</strong></td><td><t t-esc="o.start_date or ''"/></td></tr>
                            <tr><td><strong>End date</strong></td><td><t t-esc="o.end_date or ''"/></td></tr>
                            <tr><td><strong>Price</strong></td><td><t t-esc="o.price"/></td></tr>
                            <tr><td><strong>Paid</strong></td><td><t t-esc="o.paid"/></td></tr>
                            <tr><td><strong>Status</strong></td><td><t t-esc="o.state"/></td></tr>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <record id="report_sf_gym_session_planning" model="ir.actions.report">
        <field name="name">Session Planning</field>
        <field name="model">sf.gym.session</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">sf_gym_fitness.sf_gym_session_planning_template</field>
        <field name="report_file">sf_gym_fitness.sf_gym_session_planning_template</field>
        <field name="binding_model_id" ref="model_sf_gym_session"/>
        <field name="binding_type">report</field>
    </record>

    <template id="sf_gym_session_planning_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>Session Planning</h2>
                        <table class="table table-sm">
                            <tr><td><strong>Number</strong></td><td><t t-esc="o.name"/></td></tr>
                            <tr><td><strong>Lesson</strong></td><td><t t-esc="o.lesson_id.name or ''"/></td></tr>
                            <tr><td><strong>Coach</strong></td><td><t t-esc="o.coach_id.name or ''"/></td></tr>
                            <tr><td><strong>Date</strong></td><td><t t-esc="o.date or ''"/></td></tr>
                            <tr><td><strong>Start time</strong></td><td><t t-esc="o.start_time"/></td></tr>
                            <tr><td><strong>Capacity</strong></td><td><t t-esc="o.capacity"/></td></tr>
                            <tr><td><strong>Attendances</strong></td><td><t t-esc="o.attendance_count"/></td></tr>
                            <tr><td><strong>Status</strong></td><td><t t-esc="o.state"/></td></tr>
                        </table>
                        <h4>Attendances</h4>
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Number</th>
                                    <th>Member</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <t t-foreach="o.attendance_ids" t-as="attendance">
                                <tr>
                                    <td><t t-esc="attendance.name"/></td>
                                    <td><t t-esc="attendance.member_id.name or ''"/></td>
                                    <td><t t-esc="attendance.state"/></td>
                                </tr>
                            </t>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
