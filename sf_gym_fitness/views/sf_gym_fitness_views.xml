<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sf_gym_member_tree" model="ir.ui.view">
        <field name="name">sf.gym.member.tree</field>
        <field name="model">sf.gym.member</field>
        <field name="arch" type="xml">
            <tree string="Gym Members">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="phone"/>
                <field name="email"/>
                <field name="birth_date"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <record id="view_sf_gym_member_form" model="ir.ui.view">
        <field name="name">sf.gym.member.form</field>
        <field name="model">sf.gym.member</field>
        <field name="arch" type="xml">
            <form string="Gym Member">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="partner_id"/>
                            <field name="phone"/>
                            <field name="email"/>
                        </group>
                        <group>
                            <field name="birth_date"/>
                            <field name="photo" widget="image"/>
                            <field name="active"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_sf_gym_member_search" model="ir.ui.view">
        <field name="name">sf.gym.member.search</field>
        <field name="model">sf.gym.member</field>
        <field name="arch" type="xml">
            <search string="Gym Members">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="phone"/>
                <field name="email"/>
                <filter string="Archived" name="archived_member"
                        domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_sf_gym_member" model="ir.actions.act_window">
        <field name="name">Members</field>
        <field name="res_model">sf.gym.member</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_sf_gym_member_search"/>
    </record>

    <record id="view_sf_gym_plan_tree" model="ir.ui.view">
        <field name="name">sf.gym.plan.tree</field>
        <field name="model">sf.gym.plan</field>
        <field name="arch" type="xml">
            <tree string="Gym Plans">
                <field name="name"/>
                <field name="code"/>
                <field name="price_monthly"/>
                <field name="duration_months"/>
                <field name="lesson_ids"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <record id="view_sf_gym_plan_form" model="ir.ui.view">
        <field name="name">sf.gym.plan.form</field>
        <field name="model">sf.gym.plan</field>
        <field name="arch" type="xml">
            <form string="Gym Plan">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="price_monthly"/>
                        </group>
                        <group>
                            <field name="duration_months"/>
                            <field name="active"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="lesson_ids" widget="many2many_tags"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_sf_gym_plan_search" model="ir.ui.view">
        <field name="name">sf.gym.plan.search</field>
        <field name="model">sf.gym.plan</field>
        <field name="arch" type="xml">
            <search string="Gym Plans">
                <field name="name"/>
                <field name="code"/>
                <field name="lesson_ids"/>
                <filter string="Active" name="active_plan"
                        domain="[('active', '=', True)]"/>
            </search>
        </field>
    </record>

    <record id="action_sf_gym_plan" model="ir.actions.act_window">
        <field name="name">Plans</field>
        <field name="res_model">sf.gym.plan</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_sf_gym_plan_search"/>
    </record>

    <record id="view_sf_gym_lesson_tree" model="ir.ui.view">
        <field name="name">sf.gym.lesson.tree</field>
        <field name="model">sf.gym.lesson</field>
        <field name="arch" type="xml">
            <tree string="Gym Lessons">
                <field name="name"/>
                <field name="plan_ids"/>
                <field name="capacity"/>
            </tree>
        </field>
    </record>

    <record id="view_sf_gym_lesson_form" model="ir.ui.view">
        <field name="name">sf.gym.lesson.form</field>
        <field name="model">sf.gym.lesson</field>
        <field name="arch" type="xml">
            <form string="Gym Lesson">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="capacity"/>
                        </group>
                        <group>
                            <field name="plan_ids" widget="many2many_tags"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_sf_gym_lesson_search" model="ir.ui.view">
        <field name="name">sf.gym.lesson.search</field>
        <field name="model">sf.gym.lesson</field>
        <field name="arch" type="xml">
            <search string="Gym Lessons">
                <field name="name"/>
                <field name="plan_ids"/>
            </search>
        </field>
    </record>

    <record id="action_sf_gym_lesson" model="ir.actions.act_window">
        <field name="name">Lessons</field>
        <field name="res_model">sf.gym.lesson</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_sf_gym_lesson_search"/>
    </record>

    <record id="view_sf_gym_subscription_tree" model="ir.ui.view">
        <field name="name">sf.gym.subscription.tree</field>
        <field name="model">sf.gym.subscription</field>
        <field name="arch" type="xml">
            <tree string="Gym Subscriptions">
                <field name="name"/>
                <field name="member_id"/>
                <field name="plan_id"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="price"/>
                <field name="paid"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <record id="view_sf_gym_subscription_form" model="ir.ui.view">
        <field name="name">sf.gym.subscription.form</field>
        <field name="model">sf.gym.subscription</field>
        <field name="arch" type="xml">
            <form string="Gym Subscription">
                <header>
                    <button name="action_activate" type="object"
                            string="Activate" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_cancel" type="object"
                            string="Cancel" class="btn-danger"
                            invisible="state not in ('draft', 'active')"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="member_id"/>
                            <field name="plan_id"/>
                        </group>
                        <group>
                            <field name="start_date"/>
                            <field name="end_date" readonly="1"/>
                            <field name="price" readonly="1"/>
                            <field name="paid"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Payments">
                            <field name="payment_ids" readonly="1">
                                <tree string="Payments">
                                    <field name="name"/>
                                    <field name="amount"/>
                                    <field name="payment_date"/>
                                    <field name="method"/>
                                    <field name="state"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_sf_gym_subscription_search" model="ir.ui.view">
        <field name="name">sf.gym.subscription.search</field>
        <field name="model">sf.gym.subscription</field>
        <field name="arch" type="xml">
            <search string="Gym Subscriptions">
                <field name="name"/>
                <field name="member_id"/>
                <field name="plan_id"/>
                <filter string="Active" name="active_subscription"
                        domain="[('state', '=', 'active')]"/>
                <filter string="Expired" name="expired_subscription"
                        domain="[('state', '=', 'expired')]"/>
                <filter string="Paid" name="paid_subscription"
                        domain="[('paid', '=', True)]"/>
                <group expand="0" string="Group By">
                    <filter string="Status" name="state_group"
                            context="{'group_by': 'state'}"/>
                    <filter string="Plan" name="plan_group"
                            context="{'group_by': 'plan_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_sf_gym_subscription" model="ir.actions.act_window">
        <field name="name">Subscriptions</field>
        <field name="res_model">sf.gym.subscription</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_sf_gym_subscription_search"/>
    </record>

    <record id="view_sf_gym_session_tree" model="ir.ui.view">
        <field name="name">sf.gym.session.tree</field>
        <field name="model">sf.gym.session</field>
        <field name="arch" type="xml">
            <tree string="Gym Sessions">
                <field name="name"/>
                <field name="lesson_id"/>
                <field name="coach_id"/>
                <field name="date"/>
                <field name="start_time"/>
                <field name="capacity"/>
                <field name="attendance_count"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <record id="view_sf_gym_session_form" model="ir.ui.view">
        <field name="name">sf.gym.session.form</field>
        <field name="model">sf.gym.session</field>
        <field name="arch" type="xml">
            <form string="Gym Session">
                <header>
                    <button name="action_confirm" type="object"
                            string="Confirm" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_mark_in_progress" type="object"
                            string="Mark In Progress" class="btn-success"
                            invisible="state != 'confirmed'"
                            groups="sf_gym_fitness.group_sf_gym_manager,sf_gym_fitness.group_sf_gym_user"/>
                    <button name="action_mark_done" type="object"
                            string="Mark Done" class="btn-success"
                            invisible="state != 'in_progress'"
                            groups="sf_gym_fitness.group_sf_gym_manager,sf_gym_fitness.group_sf_gym_user"/>
                    <button name="action_cancel" type="object"
                            string="Cancel" class="btn-danger"
                            invisible="state not in ('draft', 'confirmed')"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="lesson_id"/>
                            <field name="coach_id"/>
                        </group>
                        <group>
                            <field name="date"/>
                            <field name="start_time"/>
                            <field name="capacity" readonly="1"/>
                            <field name="attendance_count" readonly="1"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Attendances">
                            <field name="attendance_ids">
                                <tree string="Attendances">
                                    <field name="name"/>
                                    <field name="member_id"/>
                                    <field name="state"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_sf_gym_session_search" model="ir.ui.view">
        <field name="name">sf.gym.session.search</field>
        <field name="model">sf.gym.session</field>
        <field name="arch" type="xml">
            <search string="Gym Sessions">
                <field name="name"/>
                <field name="lesson_id"/>
                <field name="coach_id"/>
                <field name="date"/>
                <filter string="Confirmed" name="confirmed_session"
                        domain="[('state', '=', 'confirmed')]"/>
                <filter string="In Progress" name="in_progress_session"
                        domain="[('state', '=', 'in_progress')]"/>
                <filter string="Done" name="done_session"
                        domain="[('state', '=', 'done')]"/>
                <group expand="0" string="Group By">
                    <filter string="Status" name="state_group"
                            context="{'group_by': 'state'}"/>
                    <filter string="Lesson" name="lesson_group"
                            context="{'group_by': 'lesson_id'}"/>
                    <filter string="Coach" name="coach_group"
                            context="{'group_by': 'coach_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_sf_gym_session" model="ir.actions.act_window">
        <field name="name">Sessions</field>
        <field name="res_model">sf.gym.session</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_sf_gym_session_search"/>
    </record>

    <record id="view_sf_gym_attendance_tree" model="ir.ui.view">
        <field name="name">sf.gym.attendance.tree</field>
        <field name="model">sf.gym.attendance</field>
        <field name="arch" type="xml">
            <tree string="Gym Attendances">
                <field name="name"/>
                <field name="session_id"/>
                <field name="member_id"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <record id="view_sf_gym_attendance_form" model="ir.ui.view">
        <field name="name">sf.gym.attendance.form</field>
        <field name="model">sf.gym.attendance</field>
        <field name="arch" type="xml">
            <form string="Gym Attendance">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="session_id"/>
                            <field name="member_id"/>
                        </group>
                        <group>
                            <field name="state"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_sf_gym_attendance_search" model="ir.ui.view">
        <field name="name">sf.gym.attendance.search</field>
        <field name="model">sf.gym.attendance</field>
        <field name="arch" type="xml">
            <search string="Gym Attendances">
                <field name="name"/>
                <field name="session_id"/>
                <field name="member_id"/>
                <group expand="0" string="Group By">
                    <filter string="Session" name="session_group"
                            context="{'group_by': 'session_id'}"/>
                    <filter string="Member" name="member_group"
                            context="{'group_by': 'member_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_sf_gym_attendance" model="ir.actions.act_window">
        <field name="name">Attendances</field>
        <field name="res_model">sf.gym.attendance</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_sf_gym_attendance_search"/>
    </record>

    <record id="view_sf_gym_payment_tree" model="ir.ui.view">
        <field name="name">sf.gym.payment.tree</field>
        <field name="model">sf.gym.payment</field>
        <field name="arch" type="xml">
            <tree string="Gym Payments">
                <field name="name"/>
                <field name="subscription_id"/>
                <field name="partner_id"/>
                <field name="amount"/>
                <field name="payment_date"/>
                <field name="method"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <record id="view_sf_gym_payment_form" model="ir.ui.view">
        <field name="name">sf.gym.payment.form</field>
        <field name="model">sf.gym.payment</field>
        <field name="arch" type="xml">
            <form string="Gym Payment">
                <header>
                    <button name="action_done" type="object"
                            string="Mark Done" class="btn-primary"
                            invisible="state != 'draft'"
                            groups="sf_gym_fitness.group_sf_gym_manager,sf_gym_fitness.group_sf_gym_user"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="subscription_id"/>
                            <field name="partner_id"/>
                        </group>
                        <group>
                            <field name="amount"/>
                            <field name="payment_date"/>
                            <field name="method"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_sf_gym_payment_search" model="ir.ui.view">
        <field name="name">sf.gym.payment.search</field>
        <field name="model">sf.gym.payment</field>
        <field name="arch" type="xml">
            <search string="Gym Payments">
                <field name="name"/>
                <field name="subscription_id"/>
                <field name="partner_id"/>
                <filter string="Done" name="done_payment"
                        domain="[('state', '=', 'done')]"/>
                <group expand="0" string="Group By">
                    <filter string="Status" name="state_group"
                            context="{'group_by': 'state'}"/>
                    <filter string="Method" name="method_group"
                            context="{'group_by': 'method'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_sf_gym_payment" model="ir.actions.act_window">
        <field name="name">Payments</field>
        <field name="res_model">sf.gym.payment</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_sf_gym_payment_search"/>
    </record>
</odoo>
