<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_sf_fac" model="ir.module.category">
        <field name="name">Facility Management</field>
        <field name="sequence">67</field>
    </record>
    <record id="group_sf_fac_user" model="res.groups">
        <field name="name">Facility User</field>
        <field name="category_id" ref="module_category_sf_fac"/>
    </record>
    <record id="group_sf_fac_manager" model="res.groups">
        <field name="name">Facility Manager</field>
        <field name="category_id" ref="module_category_sf_fac"/>
        <field name="implied_ids" eval="[(4, ref('group_sf_fac_user'))]"/>
    </record>
    <record id="rule_sf_fac_site_company" model="ir.rule">
        <field name="name">Facility Site: multi-company</field>
        <field name="model_id" ref="model_sf_facility_site"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
