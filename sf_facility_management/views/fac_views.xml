<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_fac_site" model="ir.actions.act_window">
        <field name="name">Sites</field>
        <field name="res_model">sf.facility.site</field>
        <field name="view_mode">kanban,list,form</field>
    </record>
    <record id="action_sf_fac_room" model="ir.actions.act_window">
        <field name="name">Rooms</field>
        <field name="res_model">sf.facility.room</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_sf_fac_booking" model="ir.actions.act_window">
        <field name="name">Bookings</field>
        <field name="res_model">sf.facility.booking</field>
        <field name="view_mode">list,form,calendar</field>
    </record>
    <record id="view_sf_fac_site_form" model="ir.ui.view">
        <field name="name">sf.facility.site.form</field>
        <field name="model">sf.facility.site</field>
        <field name="arch" type="xml">
            <form string="Facility Site">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="owner_type"/>
                            <field name="lease_reference"
                                   invisible="owner_type != 'leased'"/>
                        </group>
                        <group>
                            <field name="surface_m2"/>
                            <field name="room_count" readonly="1"/>
                            <field name="company_id"
                                   groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group string="Address">
                        <field name="address"/>
                    </group>
                    <field name="room_ids">
                        <list editable="bottom">
                            <field name="name"/>
                            <field name="room_type"/>
                            <field name="capacity"/>
                            <field name="floor" optional="show"/>
                            <field name="surface_m2" optional="show"/>
                        </list>
                    </field>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_fac_site_list" model="ir.ui.view">
        <field name="name">sf.facility.site.list</field>
        <field name="model">sf.facility.site</field>
        <field name="arch" type="xml">
            <list string="Sites" sample="1">
                <field name="name"/>
                <field name="owner_type"/>
                <field name="surface_m2"/>
                <field name="room_count"/>
            </list>
        </field>
    </record>
    <record id="view_sf_fac_booking_form" model="ir.ui.view">
        <field name="name">sf.facility.booking.form</field>
        <field name="model">sf.facility.booking</field>
        <field name="arch" type="xml">
            <form string="Room Booking">
                <sheet>
                    <group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="room_id"/>
                            <field name="purpose"/>
                            <field name="booked_by_id"/>
                        </group>
                        <group>
                            <field name="start"/>
                            <field name="end"/>
                            <field name="attendees"/>
                            <field name="state" widget="radio"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <menuitem id="menu_sf_fac_root" name="Facility Management" sequence="17"
              web_icon="sf_facility_management,static/description/icon.png"/>
    <menuitem id="menu_sf_fac_sites" name="Sites"
              parent="menu_sf_fac_root" action="action_sf_fac_site"
              sequence="10"/>
    <menuitem id="menu_sf_fac_rooms" name="Rooms"
              parent="menu_sf_fac_root" action="action_sf_fac_room"
              sequence="20"/>
    <menuitem id="menu_sf_fac_bookings" name="Bookings"
              parent="menu_sf_fac_root" action="action_sf_fac_booking"
              sequence="30"/>

    <record id="view_sf_facility_management_boost_kanban" model="ir.ui.view">
        <field name="name">sf_facility_management.boost.kanban</field>
        <field name="model">sf.facility.site</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" t-att-color="state">
                <field name="name"/>
                <field name="state"/>
                <field name="user_id"/>

                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_card oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title">
                                    <field name="name"/></strong>
                                <div class="o_kanban_record_subtitle">
                                    <field name="user_id" widget="many2one_avatar_user"/>
                                    <field name="create_date"/></div>
                            </div>
                            <div class="oe_kanban_bottom_right">
                                <field name="state" widget="badge"
                                       t-attf-options="{'classes_map': {'draft': 'info', 'done': 'success', 'cancelled': 'danger'}, 'domain': []}"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_sf_facility_management_boost_search" model="ir.ui.view">
        <field name="name">sf_facility_management.boost.search</field>
        <field name="model">sf.facility.site</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
<separator/>
                <filter string="My records" name="my_records" domain="[('user_id', '=', uid)]"/>
                <filter string="To Do" name="todo" domain="[('state', 'not in', ('done', 'cancelled', 'closed'))]"/>
                <group expand="0" string="Group By"><filter string="Status" name="gb_state" context="{'group_by': 'state'}"/></group>
            </search>
        </field>
    </record>
</odoo>
