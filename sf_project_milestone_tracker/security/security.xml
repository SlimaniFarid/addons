<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_project_milestone_tracker" model="ir.module.category">
        <field name="name">Milestone Tracker</field>
        <field name="sequence">398</field>
    </record>
    <record id="group_project_milestone_tracker_user" model="res.groups">
        <field name="name">Milestone Tracker User</field>
        <field name="category_id" ref="module_category_project_milestone_tracker"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>

    </record>
    <record id="group_project_milestone_tracker_manager" model="res.groups">
        <field name="name">Milestone Tracker Manager</field>
        <field name="category_id" ref="module_category_project_milestone_tracker"/>
        <field name="implied_ids" eval="[(4, ref('group_project_milestone_tracker_user'))]"/>
    </record>
    <record id="rule_project_milestone_tracker_sf_project_milestone_tracker" model="ir.rule">
        <field name="name">Milestone Tracker: multi-company</field>
        <field name="model_id" ref="model_sf_project_milestone_tracker"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_project_milestone_tracker"/>
    </record>
</odoo>
