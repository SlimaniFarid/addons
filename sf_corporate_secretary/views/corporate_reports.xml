<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="report_meeting_minutes" model="ir.actions.report">
        <field name="name">Meeting Minutes</field>
        <field name="model">sf.corporate.meeting</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">sf_corporate_secretary.meeting_minutes_template</field>
        <field name="report_file">sf_corporate_secretary.meeting_minutes_template</field>
        <field name="binding_model_id" ref="model_sf_corporate_meeting"/>
        <field name="binding_type">report</field>
    </record>

    <template id="meeting_minutes_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>Meeting Minutes (PV)</h2>
                        <table class="table table-sm">
                            <tr><td><strong>Meeting</strong></td><td><t t-esc="o.name"/></td></tr>
                            <tr><td><strong>Organ</strong></td><td><t t-esc="o.org_id.name"/></td></tr>
                            <tr><td><strong>Scheduled date</strong></td><td><t t-esc="o.scheduled_date"/></td></tr>
                            <tr><td><strong>Location</strong></td><td><t t-esc="o.location or ''"/></td></tr>
                            <tr><td><strong>Notice date</strong></td><td><t t-esc="o.notice_date or ''"/></td></tr>
                            <tr><td><strong>Convocation</strong></td><td><t t-esc="o.convocation_state"/></td></tr>
                            <tr><td><strong>Recorded by</strong></td><td><t t-esc="o.recorded_by.name or ''"/></td></tr>
                        </table>
                        <h4>Resolutions</h4>
                        <table class="table table-sm">
                            <thead>
                                <tr><th>No.</th><th>Subject</th><th>For</th><th>Against</th><th>Abstain</th><th>Adopted</th></tr>
                            </thead>
                            <tbody>
                                <t t-foreach="o.resolution_ids" t-as="r">
                                    <tr>
                                        <td><t t-esc="r.number"/></td>
                                        <td><t t-esc="r.subject"/></td>
                                        <td><t t-esc="r.vote_for"/></td>
                                        <td><t t-esc="r.vote_against"/></td>
                                        <td><t t-esc="r.vote_abstain"/></td>
                                        <td><t t-esc="r.adopted"/></td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                        <t t-if="o.minutes">
                            <h4>Minutes</h4>
                            <div><t t-raw="o.minutes"/></div>
                        </t>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <record id="report_formality_schedule" model="ir.actions.report">
        <field name="name">Formality Schedule</field>
        <field name="model">sf.corporate.formality</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">sf_corporate_secretary.formality_schedule_template</field>
        <field name="report_file">sf_corporate_secretary.formality_schedule_template</field>
        <field name="binding_model_id" ref="model_sf_corporate_formality"/>
        <field name="binding_type">report</field>
    </record>

    <template id="formality_schedule_template">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="page">
                    <h2>Formality Schedule</h2>
                    <p>Regulatory deadlines per company.</p>
                    <table class="table table-sm">
                        <thead>
                            <tr><th>Number</th><th>Company</th><th>Type</th><th>Due date</th><th>Reminder (days)</th><th>Done</th><th>Done date</th></tr>
                        </thead>
                        <tbody>
                            <t t-foreach="docs" t-as="f">
                                <tr>
                                    <td><t t-esc="f.name"/></td>
                                    <td><t t-esc="f.company_id.name"/></td>
                                    <td><t t-esc="f.formality_type"/></td>
                                    <td><t t-esc="f.due_date"/></td>
                                    <td><t t-esc="f.reminder_days"/></td>
                                    <td><t t-esc="f.done"/></td>
                                    <td><t t-esc="f.done_date or ''"/></td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </div>
            </t>
        </t>
    </template>

</odoo>