            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>

        <record id="seq_corporate_resolution" model="ir.sequence">
            <field name="name">Corporate Resolution</field>
            <field name="code">sf.corporate.resolution</field>
            <field name="prefix"></field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>

        <record id="seq_corporate_legal_decision" model="ir.sequence">
            <field name="name">Corporate Legal Decision</field>
