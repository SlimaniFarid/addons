        </record>

        <record id="cron_corporate_formalities" model="ir.cron">
            <field name="name">Corporate Secretary: Regulatory Formalities and Convocation Alerts</field>
            <field name="model_id" ref="model_sf_corporate_formality"/>
            <field name="state">code</field>
            <field name="code">model._check_formalities()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="active">True</field>
