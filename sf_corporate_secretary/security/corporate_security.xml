<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_corporate" model="ir.module.category">
        <field name="name">Corporate Secretary</field>
        <field name="sequence">90</field>
    </record>

    <record id="group_corporate_user" model="res.groups">
        <field name="name">Corporate Secretary User</field>
        <field name="category_id" ref="module_category_corporate"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_corporate_manager" model="res.groups">
        <field name="name">Corporate Secretary Manager</field>
        <field name="category_id" ref="module_category_corporate"/>
        <field name="implied_ids" eval="[(4, ref('group_corporate_user'))]"/>
    </record>

    <record id="rule_corporate_org_user_company" model="ir.rule">
        <field name="name">Organ: user sees own company</field>
        <field name="model_id" ref="model_sf_corporate_org"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_corporate_user'))]"/>
    </record>

    <record id="rule_corporate_meeting_user_company" model="ir.rule">
        <field name="name">Meeting: user sees own company</field>
        <field name="model_id" ref="model_sf_corporate_meeting"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_corporate_user'))]"/>
    </record>

    <record id="rule_corporate_resolution_user_company" model="ir.rule">
        <field name="name">Resolution: user sees own company</field>
        <field name="model_id" ref="model_sf_corporate_resolution"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_corporate_user'))]"/>
    </record>

    <record id="rule_corporate_decision_user_company" model="ir.rule">
        <field name="name">Decision: user sees own company</field>
        <field name="model_id" ref="model_sf_corporate_legal_decision"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_corporate_user'))]"/>
    </record>

    <record id="rule_corporate_formality_user_company" model="ir.rule">
        <field name="name">Formality: user sees own company</field>
        <field name="model_id" ref="model_sf_corporate_formality"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_corporate_user'))]"/>
    </record>

    <record id="rule_corporate_org_manager_all" model="ir.rule">
        <field name="name">Organ: manager sees all companies</field>
        <field name="model_id" ref="model_sf_corporate_org"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_corporate_manager'))]"/>
    </record>

    <record id="rule_corporate_meeting_manager_all" model="ir.rule">
        <field name="name">Meeting: manager sees all companies</field>
        <field name="model_id" ref="model_sf_corporate_meeting"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_corporate_manager'))]"/>
    </record>

    <record id="rule_corporate_resolution_manager_all" model="ir.rule">
        <field name="name">Resolution: manager sees all companies</field>
        <field name="model_id" ref="model_sf_corporate_resolution"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_corporate_manager'))]"/>
    </record>

    <record id="rule_corporate_decision_manager_all" model="ir.rule">
        <field name="name">Decision: manager sees all companies</field>
        <field name="model_id" ref="model_sf_corporate_legal_decision"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_corporate_manager'))]"/>
    </record>

    <record id="rule_corporate_formality_manager_all" model="ir.rule">
        <field name="name">Formality: manager sees all companies</field>
        <field name="model_id" ref="model_sf_corporate_formality"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_corporate_manager'))]"/>
    </record>
    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_corporate"/>
    </record>
</odoo>