<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_provision_register" model="ir.module.category">
        <field name="name">Provision Register</field>
        <field name="sequence">61</field>
    </record>
    <record id="group_provision_register_user" model="res.groups">
        <field name="name">Provision Register User</field>
        <field name="category_id" ref="module_category_provision_register"/>

    </record>
    <record id="group_provision_register_manager" model="res.groups">
        <field name="name">Provision Register Manager</field>
        <field name="category_id" ref="module_category_provision_register"/>
        <field name="implied_ids" eval="[(4, ref('group_provision_register_user'))]"/>
    </record>
    <record id="rule_provision_register_sf_provision" model="ir.rule">
        <field name="name">Provision: multi-company</field>
        <field name="model_id" ref="model_sf_provision"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
