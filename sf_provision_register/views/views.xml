<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_provision" model="ir.actions.act_window">
        <field name="name">Provision Register</field>
        <field name="res_model">sf.provision</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
    <record id="view_sf_provision_form" model="ir.ui.view">
        <field name="name">sf.provision.form</field>
        <field name="model">sf.provision</field>
        <field name="arch" type="xml">
            <form string="Provision Register">
                <header>
                    <button name="action_booked" type="object" string="Booked"
                            class="btn-primary"/>
                    <button name="action_utilized" type="object" string="Utilized"
                            class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,booked,utilized,reversed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="provision_type"/>
                            <field name="period_year"/>
                            <field name="amount"/>
                            <field name="utilized_amount"/>
                            <field name="reversal_date"/>
                            <field name="notes"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_provision_list" model="ir.ui.view">
        <field name="name">sf.provision.list</field>
        <field name="model">sf.provision</field>
        <field name="arch" type="xml">
            <list string="Provision Register" sample="1">
                <field name="provision_type"/>
                <field name="period_year"/>
                <field name="amount"/>
                <field name="utilized_amount"/>
                <field name="reversal_date"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state in ('submitted','approved')"/>
            </list>
        </field>
    </record>
    <record id="view_sf_provision_kanban" model="ir.ui.view">
        <field name="name">sf.provision.kanban</field>
        <field name="model">sf.provision</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_view" group_by="state">
                <field name="name"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <menuitem id="menu_sf_provision_root" name="Provision Register" sequence="12"
              web_icon="sf_provision_register,static/description/icon.png"/>
    <menuitem id="menu_sf_provision_main" name="Records"
              parent="menu_sf_provision_root" action="action_sf_provision" sequence="10"/>

    <record id="wave_final_sf_provision_register" model="ir.actions.server">
        <field name="name">Refresh Business Data</field>
        <field name="model_id" ref="model_sf_provision"/>
        <field name="binding_model_id" ref="model_sf_provision"/>
        <field name="state">code</field>
        <field name="code">records.action_refresh_business()</field>
    </record>
</odoo>
