<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_warning_letter_register" model="ir.module.category">
        <field name="name">Employee Warning Letter Register</field>
        <field name="sequence">11</field>
    </record>
    <record id="group_warning_letter_register_user" model="res.groups">
        <field name="name">Employee Warning Letter Register User</field>
        <field name="category_id" ref="module_category_warning_letter_register"/>

    </record>
    <record id="group_warning_letter_register_manager" model="res.groups">
        <field name="name">Employee Warning Letter Register Manager</field>
        <field name="category_id" ref="module_category_warning_letter_register"/>
        <field name="implied_ids" eval="[(4, ref('group_warning_letter_register_user'))]"/>
    </record>
    <record id="rule_warning_letter_register_sf_warning_letter" model="ir.rule">
        <field name="name">Warning Letter: multi-company</field>
        <field name="model_id" ref="model_sf_warning_letter"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_warning_letter_register"/>
    </record>
</odoo>
