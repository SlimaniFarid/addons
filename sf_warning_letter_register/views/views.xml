<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_warning_letter" model="ir.actions.act_window">
        <field name="name">Employee Warning Letter Register</field>
        <field name="res_model">sf.warning.letter</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
    <record id="view_sf_warning_letter_form" model="ir.ui.view">
        <field name="name">sf.warning.letter.form</field>
        <field name="model">sf.warning.letter</field>
        <field name="arch" type="xml">
            <form string="Employee Warning Letter Register">
                <header>
                    <button name="action_issued" type="object" string="Issued"
                            class="btn-primary"/>
                    <button name="action_acknowledged" type="object" string="Acknowledged"
                            class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,issued,acknowledged,expired"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="employee_id"/>
                            <field name="severity"/>
                            <field name="reason"/>
                            <field name="letter_date"/>
                            <field name="acknowledged"/>
                            <field name="expires_on"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_warning_letter_list" model="ir.ui.view">
        <field name="name">sf.warning.letter.list</field>
        <field name="model">sf.warning.letter</field>
        <field name="arch" type="xml">
            <list string="Employee Warning Letter Register" sample="1">
                <field name="employee_id"/>
                <field name="severity"/>
                <field name="reason"/>
                <field name="letter_date"/>
                <field name="acknowledged"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state in ('submitted','approved')"/>
            </list>
        </field>
    </record>
    <record id="view_sf_warning_letter_kanban" model="ir.ui.view">
        <field name="name">sf.warning.letter.kanban</field>
        <field name="model">sf.warning.letter</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_view" group_by="state">
                <field name="name"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <menuitem id="menu_sf_warning_letter_root" name="Employee Warning Letter Register" sequence="30"
              web_icon="sf_warning_letter_register,static/description/icon.png"/>
    <menuitem id="menu_sf_warning_letter_main" name="Records"
              parent="menu_sf_warning_letter_root" action="action_sf_warning_letter" sequence="10"/>

    <record id="wave_final_sf_warning_letter_register" model="ir.actions.server">
        <field name="name">Refresh Business Data</field>
        <field name="model_id" ref="model_sf_warning_letter"/>
        <field name="binding_model_id" ref="model_sf_warning_letter"/>
        <field name="state">code</field>
        <field name="code">records.action_refresh_business()</field>
    </record>
</odoo>
