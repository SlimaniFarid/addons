<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_esg" model="ir.module.category">
        <field name="name">ESG Reporting</field>
        <field name="sequence">90</field>
    </record>

    <record id="group_esg_user" model="res.groups">
        <field name="name">ESG Reporting User</field>
        <field name="category_id" ref="module_category_esg"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_esg_manager" model="res.groups">
        <field name="name">ESG Reporting Manager</field>
        <field name="category_id" ref="module_category_esg"/>
        <field name="implied_ids" eval="[(4, ref('group_esg_user'))]"/>
    </record>

    <record id="rule_esg_indicator_user_company" model="ir.rule">
        <field name="name">Indicator: user sees own company</field>
        <field name="model_id" ref="model_sf_esg_indicator"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_esg_user'))]"/>
    </record>

    <record id="rule_esg_period_user_company" model="ir.rule">
        <field name="name">Period: user sees own company</field>
        <field name="model_id" ref="model_sf_esg_period"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_esg_user'))]"/>
    </record>

    <record id="rule_esg_value_user_company" model="ir.rule">
        <field name="name">Value: user sees own company</field>
        <field name="model_id" ref="model_sf_esg_value"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_esg_user'))]"/>
    </record>

    <record id="rule_esg_indicator_manager_all" model="ir.rule">
        <field name="name">Indicator: manager sees all companies</field>
        <field name="model_id" ref="model_sf_esg_indicator"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_esg_manager'))]"/>
    </record>

    <record id="rule_esg_period_manager_all" model="ir.rule">
        <field name="name">Period: manager sees all companies</field>
        <field name="model_id" ref="model_sf_esg_period"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_esg_manager'))]"/>
    </record>

    <record id="rule_esg_value_manager_all" model="ir.rule">
        <field name="name">Value: manager sees all companies</field>
        <field name="model_id" ref="model_sf_esg_value"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_esg_manager'))]"/>
    </record>
    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_esg"/>
    </record>
</odoo>