<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============ INDICATOR ============ -->
    <record id="view_esg_indicator_tree" model="ir.ui.view">
        <field name="name">sf.esg.indicator.tree</field>
        <field name="model">sf.esg.indicator</field>
        <field name="arch" type="xml">
            <tree string="ESG Indicators">
                <field name="name"/>
                <field name="code"/>
                <field name="category"/>
                <field name="unit"/>
                <field name="direction"/>
                <field name="frequency"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <record id="view_esg_indicator_form" model="ir.ui.view">
        <field name="name">sf.esg.indicator.form</field>
        <field name="model">sf.esg.indicator</field>
        <field name="arch" type="xml">
            <form string="ESG Indicator">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="category"/>
                        </group>
                        <group>
                            <field name="unit"/>
                            <field name="direction"/>
                            <field name="frequency"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="target_source"/>
                            <field name="active"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_esg_indicator_search" model="ir.ui.view">
        <field name="name">sf.esg.indicator.search</field>
        <field name="model">sf.esg.indicator</field>
        <field name="arch" type="xml">
            <search string="ESG Indicators">
                <field name="name"/>
                <field name="code"/>
                <filter string="Environment" name="environment"
                        domain="[('category', '=', 'environment')]"/>
                <filter string="Social" name="social"
                        domain="[('category', '=', 'social')]"/>
                <filter string="Governance" name="governance"
                        domain="[('category', '=', 'governance')]"/>
                <group expand="0" string="Group By">
                    <filter string="Category" name="category_group"
                            context="{'group_by': 'category'}"/>
                    <filter string="Unit" name="unit_group"
                            context="{'group_by': 'unit'}"/>
                    <filter string="Frequency" name="frequency_group"
                            context="{'group_by': 'frequency'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_esg_indicator_kanban" model="ir.ui.view">
        <field name="name">sf.esg.indicator.kanban</field>
        <field name="model">sf.esg.indicator</field>
        <field name="arch" type="xml">
            <kanban default_group_by="category">
                <field name="name"/>
                <field name="code"/>
                <field name="category"/>
                <field name="unit"/>
                <field name="frequency"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_record_title">
                                <field name="name"/>
                            </div>
                            <div class="o_kanban_record_subtitle">
                                <field name="code"/>
                                <field name="category"/>
                            </div>
                            <div class="o_kanban_record_bottom">
                                <field name="unit"/>
                                - <field name="frequency"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_esg_indicator" model="ir.actions.act_window">
        <field name="name">Indicators</field>
        <field name="res_model">sf.esg.indicator</field>
        <field name="view_mode">tree,kanban,form</field>
        <field name="search_view_id" ref="view_esg_indicator_search"/>
    </record>

    <!-- ============ PERIOD ============ -->
    <record id="view_esg_period_tree" model="ir.ui.view">
        <field name="name">sf.esg.period.tree</field>
        <field name="model">sf.esg.period</field>
        <field name="arch" type="xml">
            <tree string="ESG Periods">
                <field name="name"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="state"/>
                <field name="submitted_date"/>
                <field name="approved_date"/>
                <field name="total_value"/>
            </tree>
        </field>
    </record>

    <record id="view_esg_period_form" model="ir.ui.view">
        <field name="name">sf.esg.period.form</field>
        <field name="model">sf.esg.period</field>
        <field name="arch" type="xml">
            <form string="ESG Period">
                <header>
                    <button name="action_submit" type="object"
                            string="Submit" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_approve" type="object"
                            string="Approve" class="btn-success"
                            invisible="state != 'submitted'"
                            groups="sf_esg_reporting.group_esg_manager"/>
                    <button name="action_close" type="object"
                            string="Close" invisible="state != 'approved'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="date_from"/>
                            <field name="date_to"/>
                        </group>
                        <group>
                            <field name="submitted_date"/>
                            <field name="approved_date"/>
                            <field name="approved_by"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Values">
                            <field name="value_ids">
                                <tree string="ESG Values" editable="bottom">
                                    <field name="indicator_id"/>
                                    <field name="category"/>
                                    <field name="value"/>
                                    <field name="target"/>
                                    <field name="variation"/>
                                    <field name="achieved"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_esg_period_search" model="ir.ui.view">
        <field name="name">sf.esg.period.search</field>
        <field name="model">sf.esg.period</field>
        <field name="arch" type="xml">
            <search string="ESG Periods">
                <field name="name"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <filter string="Draft" name="draft"
                        domain="[('state', '=', 'draft')]"/>
                <filter string="Submitted" name="submitted"
                        domain="[('state', '=', 'submitted')]"/>
                <filter string="Approved" name="approved"
                        domain="[('state', '=', 'approved')]"/>
                <group expand="0" string="Group By">
                    <filter string="Status" name="state_group"
                            context="{'group_by': 'state'}"/>
                    <filter string="Company" name="company_group"
                            context="{'group_by': 'company_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_esg_period_kanban" model="ir.ui.view">
        <field name="name">sf.esg.period.kanban</field>
        <field name="model">sf.esg.period</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state">
                <field name="name"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="state"/>
                <field name="total_value"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_record_title">
                                <field name="name"/>
                            </div>
                            <div class="o_kanban_record_subtitle">
                                <field name="date_from"/>
                                - <field name="date_to"/>
                            </div>
                            <div class="o_kanban_record_bottom">
                                Total: <field name="total_value"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_esg_period" model="ir.actions.act_window">
        <field name="name">Periods</field>
        <field name="res_model">sf.esg.period</field>
        <field name="view_mode">tree,kanban,form</field>
        <field name="search_view_id" ref="view_esg_period_search"/>
    </record>

    <!-- ============ VALUE ============ -->
    <record id="view_esg_value_tree" model="ir.ui.view">
        <field name="name">sf.esg.value.tree</field>
        <field name="model">sf.esg.value</field>
        <field name="arch" type="xml">
            <tree string="ESG Values">
                <field name="period_id"/>
                <field name="indicator_id"/>
                <field name="category"/>
                <field name="value"/>
                <field name="target"/>
                <field name="variation"/>
                <field name="achieved"/>
            </tree>
        </field>
    </record>

    <record id="view_esg_value_form" model="ir.ui.view">
        <field name="name">sf.esg.value.form</field>
        <field name="model">sf.esg.value</field>
        <field name="arch" type="xml">
            <form string="ESG Value">
                <sheet>
                    <group>
                        <group>
                            <field name="period_id"/>
                            <field name="indicator_id"/>
                        </group>
                        <group>
                            <field name="value"/>
                            <field name="target"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="variation" readonly="1"/>
                            <field name="achieved" readonly="1"/>
                        </group>
                    </group>
                    <field name="notes"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_esg_value_search" model="ir.ui.view">
        <field name="name">sf.esg.value.search</field>
        <field name="model">sf.esg.value</field>
        <field name="arch" type="xml">
            <search string="ESG Values">
                <field name="period_id"/>
                <field name="indicator_id"/>
                <filter string="Environment" name="environment"
                        domain="[('category', '=', 'environment')]"/>
                <filter string="Social" name="social"
                        domain="[('category', '=', 'social')]"/>
                <filter string="Governance" name="governance"
                        domain="[('category', '=', 'governance')]"/>
                <filter string="Approved periods" name="approved"
                        domain="[('period_id.state', '=', 'approved')]"/>
                <group expand="0" string="Group By">
                    <filter string="Category" name="category_group"
                            context="{'group_by': 'category'}"/>
                    <filter string="Period" name="period_group"
                            context="{'group_by': 'period_id'}"/>
                    <filter string="Indicator" name="indicator_group"
                            context="{'group_by': 'indicator_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_esg_value_kanban" model="ir.ui.view">
        <field name="name">sf.esg.value.kanban</field>
        <field name="model">sf.esg.value</field>
        <field name="arch" type="xml">
            <kanban default_group_by="category">
                <field name="period_id"/>
                <field name="indicator_id"/>
                <field name="category"/>
                <field name="value"/>
                <field name="target"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_record_title">
                                <field name="indicator_id"/>
                            </div>
                            <div class="o_kanban_record_subtitle">
                                <field name="period_id"/>
                                <field name="category"/>
                            </div>
                            <div class="o_kanban_record_bottom">
                                <field name="value"/>
                                / <field name="target"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_esg_value" model="ir.actions.act_window">
        <field name="name">Values</field>
        <field name="res_model">sf.esg.value</field>
        <field name="view_mode">tree,kanban,form</field>
        <field name="search_view_id" ref="view_esg_value_search"/>
    </record>

    <!-- ============ DASHBOARD ============ -->
    <record id="view_esg_dashboard_pivot" model="ir.ui.view">
        <field name="name">sf.esg.value.dashboard.pivot</field>
        <field name="model">sf.esg.value</field>
        <field name="arch" type="xml">
            <pivot string="ESG Dashboard by Category">
                <field name="category" type="row"/>
                <field name="period_id" type="col"/>
                <field name="value" type="measure" string="Value"/>
            </pivot>
        </field>
    </record>

    <record id="view_esg_dashboard_graph" model="ir.ui.view">
        <field name="name">sf.esg.value.dashboard.graph</field>
        <field name="model">sf.esg.value</field>
        <field name="arch" type="xml">
            <graph string="ESG Values by Category">
                <field name="category"/>
                <field name="value" type="measure" string="Value"/>
            </graph>
        </field>
    </record>

    <record id="action_esg_dashboard" model="ir.actions.act_window">
        <field name="name">ESG Dashboard</field>
        <field name="res_model">sf.esg.value</field>
        <field name="view_mode">pivot,graph</field>
        <field name="view_ids" eval="[(5, 0), (0, 0, {'view_mode': 'pivot', 'view_id': ref('view_esg_dashboard_pivot')}), (0, 0, {'view_mode': 'graph', 'view_id': ref('view_esg_dashboard_graph')})]"/>
    </record>

</odoo>