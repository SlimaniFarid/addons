<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_esg" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.esg</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="50"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="ESG Reporting" string="ESG Reporting" name="esg_reporting">
                    <block title="Collection Defaults" id="esg_defaults">
                        <setting id="esg_frequency" help="Default frequency used for the creation of new ESG collection periods.">
                            <field name="sf_esg_default_frequency"/>
                        </setting>
                        <setting id="esg_company" help="Mark this company as the default ESG reporting company.">
                            <field name="sf_esg_default_company"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>