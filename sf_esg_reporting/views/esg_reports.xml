<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="report_esg" model="ir.actions.report">
        <field name="name">ESG Report</field>
        <field name="model">sf.esg.period</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">sf_esg_reporting.report_esg_template</field>
        <field name="report_file">sf_esg_reporting.report_esg_template</field>
        <field name="binding_model_id" ref="model_sf_esg_period"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_esg_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>ESG Report</h2>
                        <table class="table table-sm">
                            <tr><td><strong>Company</strong></td><td><t t-esc="o.company_id.name"/></td></tr>
                            <tr><td><strong>Period</strong></td><td><t t-esc="o.name"/></td></tr>
                            <tr><td><strong>From</strong></td><td><t t-esc="o.date_from or ''"/></td></tr>
                            <tr><td><strong>To</strong></td><td><t t-esc="o.date_to or ''"/></td></tr>
                            <tr><td><strong>Status</strong></td><td><t t-esc="dict(o._fields['state'].selection).get(o.state)"/></td></tr>
                        </table>
                        <h4>Indicators</h4>
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Category</th>
                                    <th>Indicator</th>
                                    <th>Unit</th>
                                    <th>Value</th>
                                    <th>Target</th>
                                    <th>Variation (%)</th>
                                    <th>Achievement</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="o.value_ids" t-as="v">
                                    <tr>
                                        <td><t t-esc="dict(v._fields['category'].selection).get(v.category)"/></td>
                                        <td><t t-esc="v.indicator_id.name"/></td>
                                        <td><t t-esc="v.indicator_id.unit"/></td>
                                        <td><t t-esc="v.value"/></td>
                                        <td><t t-esc="v.target or ''"/></td>
                                        <td><t t-esc="v.variation"/></td>
                                        <td><t t-esc="v.achieved"/></td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <record id="report_esg_csv" model="ir.actions.report">
        <field name="name">ESG Values Export (CSV)</field>
        <field name="model">sf.esg.value</field>
        <field name="report_type">text</field>
        <field name="report_name">sf_esg_reporting.esg_csv_template</field>
        <field name="report_file">sf_esg_reporting.esg_csv_template</field>
        <field name="binding_model_id" ref="model_sf_esg_value"/>
        <field name="binding_type">report</field>
        <field name="mimetype">text/csv</field>
    </record>

    <template id="esg_csv_template"><t t-out="'Period;Indicator;Category;Value;Target;Variation (%);Achievement'"/>&#10;<t t-foreach="docs" t-as="v"><t t-out="v.period_id.name"/>;<t t-out="v.indicator_id.code"/>;<t t-out="v.category"/>;<t t-out="v.value"/>;<t t-out="v.target or ''"/>;<t t-out="v.variation"/>;<t t-out="v.achieved"/>&#10;</t></template>

</odoo>