<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_sales_territory_review" model="ir.module.category">
        <field name="name">Sales Territory Balance Review</field>
        <field name="sequence">197</field>
    </record>
    <record id="group_sales_territory_review_user" model="res.groups">
        <field name="name">Sales Territory Balance Review User</field>
        <field name="category_id" ref="module_category_sales_territory_review"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>

    </record>
    <record id="group_sales_territory_review_manager" model="res.groups">
        <field name="name">Sales Territory Balance Review Manager</field>
        <field name="category_id" ref="module_category_sales_territory_review"/>
        <field name="implied_ids" eval="[(4, ref('group_sales_territory_review_user'))]"/>
    </record>
    <record id="rule_sales_territory_review_sf_sales_territory_review" model="ir.rule">
        <field name="name">Sales Territory Balance Review: multi-company</field>
        <field name="model_id" ref="model_sf_sales_territory_review"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_sales_territory_review"/>
    </record>
</odoo>
