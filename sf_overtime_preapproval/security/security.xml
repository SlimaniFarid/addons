<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_overtime_preapproval" model="ir.module.category">
        <field name="name">Overtime Pre-Approval</field>
        <field name="sequence">8</field>
    </record>
    <record id="group_overtime_preapproval_user" model="res.groups">
        <field name="name">Overtime Pre-Approval User</field>
        <field name="category_id" ref="module_category_overtime_preapproval"/>

    </record>
    <record id="group_overtime_preapproval_manager" model="res.groups">
        <field name="name">Overtime Pre-Approval Manager</field>
        <field name="category_id" ref="module_category_overtime_preapproval"/>
        <field name="implied_ids" eval="[(4, ref('group_overtime_preapproval_user'))]"/>
    </record>
    <record id="rule_overtime_preapproval_sf_overtime_request" model="ir.rule">
        <field name="name">Overtime Request: multi-company</field>
        <field name="model_id" ref="model_sf_overtime_request"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
