<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_overtime_request" model="ir.actions.act_window">
        <field name="name">Overtime Pre-Approval</field>
        <field name="res_model">sf.overtime.request</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
    <record id="view_sf_overtime_request_form" model="ir.ui.view">
        <field name="name">sf.overtime.request.form</field>
        <field name="model">sf.overtime.request</field>
        <field name="arch" type="xml">
            <form string="Overtime Pre-Approval">
                <header>
                    <button name="action_pre_approved" type="object" string="Pre-Approved"
                            class="btn-primary"/>
                    <button name="action_validated" type="object" string="Validated"
                            class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="requested,pre_approved,validated,rejected"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="employee_id"/>
                            <field name="date"/>
                            <field name="estimated_hours"/>
                            <field name="actual_hours"/>
                            <field name="project_ref"/>
                            <field name="approver_id"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_overtime_request_list" model="ir.ui.view">
        <field name="name">sf.overtime.request.list</field>
        <field name="model">sf.overtime.request</field>
        <field name="arch" type="xml">
            <list string="Overtime Pre-Approval" sample="1">
                <field name="employee_id"/>
                <field name="date"/>
                <field name="estimated_hours"/>
                <field name="actual_hours"/>
                <field name="project_ref"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state in ('submitted','approved')"/>
            </list>
        </field>
    </record>
    <record id="view_sf_overtime_request_kanban" model="ir.ui.view">
        <field name="name">sf.overtime.request.kanban</field>
        <field name="model">sf.overtime.request</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_view" group_by="state">
                <field name="name"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <menuitem id="menu_sf_overtime_request_root" name="Overtime Pre-Approval" sequence="27"
              web_icon="sf_overtime_preapproval,static/description/icon.png"/>
    <menuitem id="menu_sf_overtime_request_main" name="Records"
              parent="menu_sf_overtime_request_root" action="action_sf_overtime_request" sequence="10"/>

    <record id="wave_final_sf_overtime_preapproval" model="ir.actions.server">
        <field name="name">Refresh Business Data</field>
        <field name="model_id" ref="model_sf_overtime_request"/>
        <field name="binding_model_id" ref="model_sf_overtime_request"/>
        <field name="state">code</field>
        <field name="code">records.action_refresh_business()</field>
    </record>
</odoo>
