<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_asset_disposal_request" model="ir.module.category">
        <field name="name">Asset Disposal Request</field>
        <field name="sequence">168</field>
    </record>
    <record id="group_asset_disposal_request_user" model="res.groups">
        <field name="name">Asset Disposal Request User</field>
        <field name="category_id" ref="module_category_asset_disposal_request"/>

    </record>
    <record id="group_asset_disposal_request_manager" model="res.groups">
        <field name="name">Asset Disposal Request Manager</field>
        <field name="category_id" ref="module_category_asset_disposal_request"/>
        <field name="implied_ids" eval="[(4, ref('group_asset_disposal_request_user'))]"/>
    </record>
    <record id="rule_asset_disposal_request_sf_asset_disposal_request" model="ir.rule">
        <field name="name">Asset Disposal Request: multi-company</field>
        <field name="model_id" ref="model_sf_asset_disposal_request"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
