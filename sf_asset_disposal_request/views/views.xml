<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_asset_disposal_request" model="ir.actions.act_window">
        <field name="name">Asset Disposal Request</field>
        <field name="res_model">sf.asset_disposal_request</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
    <record id="view_sf_asset_disposal_request_form" model="ir.ui.view">
        <field name="name">sf.asset_disposal_request.form</field>
        <field name="model">sf.asset_disposal_request</field>
        <field name="arch" type="xml">
            <form string="Asset Disposal Request">
                <header>
                    <button name="action_submitted" type="object" string="Submitted"
                            class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="asset_ref"/>
                            <field name="disposal_reason"/>
                            <field name="book_value"/>
                            <field name="disposal_value"/>
                            <field name="approved_by_id"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_asset_disposal_request_list" model="ir.ui.view">
        <field name="name">sf.asset_disposal_request.list</field>
        <field name="model">sf.asset_disposal_request</field>
        <field name="arch" type="xml">
            <list string="Asset Disposal Request" sample="1">
                <field name="asset_ref"/>
                <field name="disposal_reason"/>
                <field name="book_value"/>
                <field name="disposal_value"/>
                <field name="approved_by_id"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state in ('submitted','approved')"/>
            </list>
        </field>
    </record>
    <record id="view_sf_asset_disposal_request_kanban" model="ir.ui.view">
        <field name="name">sf.asset_disposal_request.kanban</field>
        <field name="model">sf.asset_disposal_request</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_view" group_by="state">
                <field name="name"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <menuitem id="menu_sf_asset_disposal_request_root" name="Asset Disposal Request" sequence="3"
              web_icon="sf_asset_disposal_request,static/description/icon.png"/>
    <menuitem id="menu_sf_asset_disposal_request_main" name="Records"
              parent="menu_sf_asset_disposal_request_root" action="action_sf_asset_disposal_request" sequence="10"/>
</odoo>
