<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_packaging_type" model="ir.sequence">
            <field name="name">Packaging Type</field>
            <field name="code">sf.packaging.type</field>
            <field name="prefix">PKG-</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>

        <record id="seq_packaging_site" model="ir.sequence">
            <field name="name">Packaging Site</field>
            <field name="code">sf.packaging.site</field>
            <field name="prefix">SIT-</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>

        <record id="seq_packaging_park" model="ir.sequence">
            <field name="name">Packaging Park</field>
            <field name="code">sf.packaging.park</field>
            <field name="prefix">PRK-</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>

        <record id="seq_packaging_move" model="ir.sequence">
            <field name="name">Packaging Emission</field>
            <field name="code">sf.packaging.move</field>
            <field name="prefix">MOV-</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>

        <record id="seq_packaging_return" model="ir.sequence">
            <field name="name">Packaging Return</field>
            <field name="code">sf.packaging.return</field>
            <field name="prefix">RET-</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>

        <record id="cron_packaging_alerts" model="ir.cron">
            <field name="name">Packaging Consigns: Park Alerts</field>
            <field name="model_id" ref="model_sf_packaging_park"/>
            <field name="state">code</field>
            <field name="code">model._check_packaging_alerts()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="active">True</field>
        </record>
    </data>
</odoo>