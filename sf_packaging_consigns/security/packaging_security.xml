<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_packaging" model="ir.module.category">
        <field name="name">Packaging Consigns</field>
        <field name="sequence">90</field>
    </record>

    <record id="group_packaging_user" model="res.groups">
        <field name="name">Packaging Consigns User</field>
        <field name="category_id" ref="module_category_packaging"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_packaging_manager" model="res.groups">
        <field name="name">Packaging Consigns Manager</field>
        <field name="category_id" ref="module_category_packaging"/>
        <field name="implied_ids" eval="[(4, ref('group_packaging_user'))]"/>
    </record>

    <record id="rule_packaging_type_user_company" model="ir.rule">
        <field name="name">Type: user sees own company</field>
        <field name="model_id" ref="model_sf_packaging_type"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_packaging_user'))]"/>
    </record>

    <record id="rule_packaging_site_user_company" model="ir.rule">
        <field name="name">Site: user sees own company</field>
        <field name="model_id" ref="model_sf_packaging_site"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_packaging_user'))]"/>
    </record>

    <record id="rule_packaging_park_user_company" model="ir.rule">
        <field name="name">Park: user sees own company</field>
        <field name="model_id" ref="model_sf_packaging_park"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_packaging_user'))]"/>
    </record>

    <record id="rule_packaging_move_user_company" model="ir.rule">
        <field name="name">Move: user sees own company</field>
        <field name="model_id" ref="model_sf_packaging_move"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_packaging_user'))]"/>
    </record>

    <record id="rule_packaging_return_user_company" model="ir.rule">
        <field name="name">Return: user sees own company</field>
        <field name="model_id" ref="model_sf_packaging_return"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_packaging_user'))]"/>
    </record>

    <record id="rule_packaging_type_manager_all" model="ir.rule">
        <field name="name">Type: manager sees all companies</field>
        <field name="model_id" ref="model_sf_packaging_type"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_packaging_manager'))]"/>
    </record>

    <record id="rule_packaging_site_manager_all" model="ir.rule">
        <field name="name">Site: manager sees all companies</field>
        <field name="model_id" ref="model_sf_packaging_site"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_packaging_manager'))]"/>
    </record>

    <record id="rule_packaging_park_manager_all" model="ir.rule">
        <field name="name">Park: manager sees all companies</field>
        <field name="model_id" ref="model_sf_packaging_park"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_packaging_manager'))]"/>
    </record>

    <record id="rule_packaging_move_manager_all" model="ir.rule">
        <field name="name">Move: manager sees all companies</field>
        <field name="model_id" ref="model_sf_packaging_move"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_packaging_manager'))]"/>
    </record>

    <record id="rule_packaging_return_manager_all" model="ir.rule">
        <field name="name">Return: manager sees all companies</field>
        <field name="model_id" ref="model_sf_packaging_return"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_packaging_manager'))]"/>
    </record>
</odoo>