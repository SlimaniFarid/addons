<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_expiry_alert" model="ir.actions.act_window">
        <field name="name">Expiry &amp; FEFO Alert Manager</field>
        <field name="res_model">sf.expiry.alert</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
    <record id="view_sf_expiry_alert_form" model="ir.ui.view">
        <field name="name">sf.expiry.alert.form</field>
        <field name="model">sf.expiry.alert</field>
        <field name="arch" type="xml">
            <form string="Expiry &amp; FEFO Alert Manager">
                <header>
                    <button name="action_actioned" type="object" string="Actioned"
                            class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="open,actioned,closed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="lot_id"/>
                            <field name="product_id"/>
                            <field name="expiry_date"/>
                            <field name="alert_days"/>
                            <field name="quantity"/>
                            <field name="disposition"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_expiry_alert_list" model="ir.ui.view">
        <field name="name">sf.expiry.alert.list</field>
        <field name="model">sf.expiry.alert</field>
        <field name="arch" type="xml">
            <list string="Expiry &amp; FEFO Alert Manager" sample="1">
                <field name="lot_id"/>
                <field name="product_id"/>
                <field name="expiry_date"/>
                <field name="alert_days"/>
                <field name="quantity"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state in ('submitted','approved')"/>
            </list>
        </field>
    </record>
    <record id="view_sf_expiry_alert_kanban" model="ir.ui.view">
        <field name="name">sf.expiry.alert.kanban</field>
        <field name="model">sf.expiry.alert</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_view" group_by="state">
                <field name="name"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <menuitem id="menu_sf_expiry_alert_root" name="Expiry &amp; FEFO Alert Manager" sequence="20"
              web_icon="sf_expiry_alert_manager,static/description/icon.png"/>
    <menuitem id="menu_sf_expiry_alert_main" name="Records"
              parent="menu_sf_expiry_alert_root" action="action_sf_expiry_alert" sequence="10"/>

    <record id="wave_final_sf_expiry_alert_manager" model="ir.actions.server">
        <field name="name">Refresh Business Data</field>
        <field name="model_id" ref="model_sf_expiry_alert"/>
        <field name="binding_model_id" ref="model_sf_expiry_alert"/>
        <field name="state">code</field>
        <field name="code">records.action_refresh_business()</field>
    </record>
</odoo>
