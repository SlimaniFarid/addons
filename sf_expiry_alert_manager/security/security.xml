<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_expiry_alert_manager" model="ir.module.category">
        <field name="name">Expiry &amp; FEFO Alert Manager</field>
        <field name="sequence">27</field>
    </record>
    <record id="group_expiry_alert_manager_user" model="res.groups">
        <field name="name">Expiry &amp; FEFO Alert Manager User</field>
        <field name="category_id" ref="module_category_expiry_alert_manager"/>
        <field name="implied_ids" eval="[(4, ref('stock.group_stock_user'))]"/>

    </record>
    <record id="group_expiry_alert_manager_manager" model="res.groups">
        <field name="name">Expiry &amp; FEFO Alert Manager Manager</field>
        <field name="category_id" ref="module_category_expiry_alert_manager"/>
        <field name="implied_ids" eval="[(4, ref('group_expiry_alert_manager_user'))]"/>
    </record>
    <record id="rule_expiry_alert_manager_sf_expiry_alert" model="ir.rule">
        <field name="name">Expiry Alert: multi-company</field>
        <field name="model_id" ref="model_sf_expiry_alert"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_expiry_alert_manager"/>
    </record>
</odoo>
