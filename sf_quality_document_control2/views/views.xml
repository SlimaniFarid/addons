<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_quality_document_control2" model="ir.actions.act_window">
        <field name="name">Quality Document Control</field>
        <field name="res_model">sf.quality_document_control2</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
    <record id="view_sf_quality_document_control2_form" model="ir.ui.view">
        <field name="name">sf.quality_document_control2.form</field>
        <field name="model">sf.quality_document_control2</field>
        <field name="arch" type="xml">
            <form string="Quality Document Control">
                <header>
                    <button name="action_submitted" type="object" string="Submitted"
                            class="btn-primary"/>
                    <button name="action_approved" type="object" string="Approved"
                            class="btn-primary"/>
                    <button name="action_done" type="object" string="Done"
                            class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,approved,done,cancelled"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="doc_title"/>
                            <field name="doc_type"/>
                            <field name="version"/>
                            <field name="owner_id"/>
                            <field name="review_date"/>
                            <field name="approved_by_id"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_quality_document_control2_list" model="ir.ui.view">
        <field name="name">sf.quality_document_control2.list</field>
        <field name="model">sf.quality_document_control2</field>
        <field name="arch" type="xml">
            <list string="Quality Document Control" sample="1">
                <field name="doc_title"/>
                <field name="doc_type"/>
                <field name="version"/>
                <field name="owner_id"/>
                <field name="review_date"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state in ('submitted','approved')"/>
            </list>
        </field>
    </record>
    <record id="view_sf_quality_document_control2_kanban" model="ir.ui.view">
        <field name="name">sf.quality_document_control2.kanban</field>
        <field name="model">sf.quality_document_control2</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_view" group_by="state">
                <field name="name"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <menuitem id="menu_sf_quality_document_control2_root" name="Quality Document Control" sequence="22"
              web_icon="sf_quality_document_control2,static/description/icon.png"/>
    <menuitem id="menu_sf_quality_document_control2_main" name="Records"
              parent="menu_sf_quality_document_control2_root" action="action_sf_quality_document_control2" sequence="10"/>
</odoo>
