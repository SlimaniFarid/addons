<?xml version="1.0" ?>
<odoo>
    <record id="seq_sf_mental_health_patient" model="ir.sequence">
        <field name="name">Patient</field>
        <field name="code">sf.mh.patient</field>
        <field name="prefix">PAT-</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_sf_mental_health_session" model="ir.sequence">
        <field name="name">Session</field>
        <field name="code">sf.mh.session</field>
        <field name="prefix">SES-</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_sf_mental_health_plan" model="ir.sequence">
        <field name="name">Treatment Plan</field>
        <field name="code">sf.mh.plan</field>
        <field name="prefix">PLN-</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>