<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_sf_ci" model="ir.module.category">
        <field name="name">Credit Insurance</field>
        <field name="sequence">82</field>
    </record>
    <record id="group_sf_ci_user" model="res.groups">
        <field name="name">Credit Insurance User</field>
        <field name="category_id" ref="module_category_sf_ci"/>
        <field name="implied_ids" eval="[(4, ref('account.group_account_invoice'))]"/>
    </record>
    <record id="group_sf_ci_manager" model="res.groups">
        <field name="name">Credit Insurance Manager</field>
        <field name="category_id" ref="module_category_sf_ci"/>
        <field name="implied_ids" eval="[(4, ref('group_sf_ci_user'))]"/>
    </record>
    <record id="rule_sf_ci_policy_company" model="ir.rule">
        <field name="name">CI Policy: multi-company</field>
        <field name="model_id" ref="model_sf_ci_policy"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
