<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="seq_sf_ci_policy" model="ir.sequence">
        <field name="name">CI Policy</field>
        <field name="code">sf.ci.policy</field>
        <field name="prefix">CIP/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_sf_ci_claim" model="ir.sequence">
        <field name="name">CI Claim</field>
        <field name="code">sf.ci.claim</field>
        <field name="prefix">CIC/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
