<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_sales_hygiene_audit" model="ir.module.category">
        <field name="name">Pipeline Hygiene Audit</field>
        <field name="sequence">39</field>
    </record>
    <record id="group_sales_hygiene_audit_user" model="res.groups">
        <field name="name">Pipeline Hygiene Audit User</field>
        <field name="category_id" ref="module_category_sales_hygiene_audit"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>

    </record>
    <record id="group_sales_hygiene_audit_manager" model="res.groups">
        <field name="name">Pipeline Hygiene Audit Manager</field>
        <field name="category_id" ref="module_category_sales_hygiene_audit"/>
        <field name="implied_ids" eval="[(4, ref('group_sales_hygiene_audit_user'))]"/>
    </record>
    <record id="rule_sales_hygiene_audit_sf_pipeline_audit" model="ir.rule">
        <field name="name">Pipeline Audit: multi-company</field>
        <field name="model_id" ref="model_sf_pipeline_audit"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
