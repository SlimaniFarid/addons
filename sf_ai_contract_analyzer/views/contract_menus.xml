<odoo>
    <record id="action_contract_document" model="ir.actions.act_window">
        <field name="name">Contracts</field>
        <field name="res_model">contract.document</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
    <record id="action_contract_obligation" model="ir.actions.act_window">
        <field name="name">Obligations</field>
        <field name="res_model">contract.obligation</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_contract_alert" model="ir.actions.act_window">
        <field name="name">Alerts</field>
        <field name="res_model">contract.alert</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_contract_provider" model="ir.actions.act_window">
        <field name="name">AI Providers</field>
        <field name="res_model">contract.provider</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_contract_risk" model="ir.actions.act_window">
        <field name="name">Risk Flags</field>
        <field name="res_model">contract.risk.flag</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_contract_root" name="AI Contract Analyzer" web_icon="sf_ai_contract_analyzer,static/description/icon.png"/>
    <menuitem id="menu_contract_documents" name="Contracts" parent="menu_contract_root" action="action_contract_document" sequence="10"/>
    <menuitem id="menu_contract_obligations" name="Obligations" parent="menu_contract_root" action="action_contract_obligation" sequence="20"/>
    <menuitem id="menu_contract_alerts" name="Alerts" parent="menu_contract_root" action="action_contract_alert" sequence="30"/>
    <menuitem id="menu_contract_risks" name="Risk Flags" parent="menu_contract_root" action="action_contract_risk" sequence="40"/>
    <menuitem id="menu_contract_providers" name="AI Providers" parent="menu_contract_root" action="action_contract_provider" sequence="50"/>

    <record id="view_contract_document_form" model="ir.ui.view">
        <field name="name">contract.document.form</field>
        <field name="model">contract.document</field>
        <field name="arch" type="xml">
            <form string="Contract">
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="draft,under_review,pending_signature,active,expired,terminated"/>
                    <field name="processing_state" widget="statusbar" statusbar_visible="pending,processing,done,error" invisible="1"/>
                    <button name="action_process" string="Process with AI" type="object" class="btn-primary" invisible="processing_state not in ('pending','error')"/>
                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="contract_type"/>
                        <field name="attachment_id" options="{'no_create': True}"/>
                        <field name="our_party_id" readonly="1"/>
                    </group>
                    <group string="Dates">
                        <field name="effective_date"/>
                        <field name="expiration_date"/>
                        <field name="auto_renewal"/>
                        <field name="renewal_period"/>
                        <field name="notice_period_days"/>
                    </group>
                    <group string="Financial">
                        <field name="currency_id"/>
                        <field name="contract_value"/>
                        <field name="payment_terms"/>
                    </group>
                    <group string="AI Processing">
                        <field name="provider_id" options="{'no_create': True}"/>
                        <field name="processed"/>
                        <field name="confidence_score" widget="progressbar" options="{'current_value': 'confidence_score', 'max_value': 1}"/>
                        <field name="risk_level" widget="badge" decoration-success="risk_level=='low'" decoration-warning="risk_level=='medium'" decoration-danger="risk_level in ('high','critical')"/>
                    </group>
                    <notebook>
                        <page string="Parties">
                            <field name="party_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="role"/>
                                    <field name="is_our_party"/>
                                    <field name="contact_name"/>
                                    <field name="email"/>
                                </list>
                            </field>
                        </page>
                        <page string="Obligations">
                            <field name="obligation_ids">
                                <list editable="bottom">
                                    <field name="title"/>
                                    <field name="obligation_type"/>
                                    <field name="responsible_party"/>
                                    <field name="due_date"/>
                                    <field name="state" widget="badge" decoration-success="state=='completed'" decoration-danger="state=='overdue'" decoration-warning="state=='in_progress'"/>
                                </list>
                            </field>
                        </page>
                        <page string="Risk Flags">
                            <field name="risk_flags">
                                <list>
                                    <field name="title"/>
                                    <field name="category"/>
                                    <field name="severity" widget="badge" decoration-danger="severity in ('high','critical')" decoration-warning="severity=='medium'" decoration-success="severity=='low'"/>
                                    <field name="status"/>
                                </list>
                            </field>
                        </page>
                        <page string="Alerts">
                            <field name="alert_ids">
                                <list>
                                    <field name="alert_type"/>
                                    <field name="trigger_date"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_contract_document_list" model="ir.ui.view">
        <field name="name">contract.document.list</field>
        <field name="model">contract.document</field>
        <field name="arch" type="xml">
            <list string="Contracts">
                <field name="name"/>
                <field name="contract_type"/>
                <field name="our_party_id"/>
                <field name="state" widget="badge" decoration-success="state=='active'" decoration-danger="state in ('expired','terminated')" decoration-warning="state=='under_review'" decoration-muted="state=='draft'"/>
                <field name="processing_state" widget="badge" decoration-success="processing_state=='done'" decoration-danger="processing_state=='error'" decoration-warning="processing_state=='processing'"/>
                <field name="risk_level" widget="badge" decoration-success="risk_level=='low'" decoration-warning="risk_level=='medium'" decoration-danger="risk_level in ('high','critical')"/>
                <field name="effective_date"/>
                <field name="expiration_date"/>
            </list>
        </field>
    </record>
</odoo>