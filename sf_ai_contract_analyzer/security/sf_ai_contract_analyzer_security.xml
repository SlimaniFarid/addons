<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_sf_ai_contract_analyzer" model="ir.module.category">
        <field name="name">AI Contract Analyzer</field>
        <field name="description">AI Contract Analyzer Management</field>
        <field name="sequence">10</field>
    </record>

    <record id="group_sf_ai_contract_analyzer_user" model="res.groups">
        <field name="name">AI Contract Analyzer / User</field>
        <field name="category_id" ref="module_category_sf_ai_contract_analyzer"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_sf_ai_contract_analyzer_manager" model="res.groups">
        <field name="name">AI Contract Analyzer / Manager</field>
        <field name="category_id" ref="module_category_sf_ai_contract_analyzer"/>
        <field name="implied_ids" eval="[(4, ref('sf_ai_contract_analyzer.group_sf_ai_contract_analyzer_user'))]"/>
    </record>

    <record id="rule_sf_ai_contract_analyzer_company" model="ir.rule">
        <field name="name">AI Contract Analyzer: user sees own company</field>
        <field name="model_id" ref="model_sf_ai_contract_analyzer"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('sf_ai_contract_analyzer.group_sf_ai_contract_analyzer_user'))]"/>
    </record>
    <record id="rule_sf_ai_contract_analyzer_manager_all" model="ir.rule">
        <field name="name">AI Contract Analyzer: manager sees all companies</field>
        <field name="model_id" ref="model_sf_ai_contract_analyzer"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('sf_ai_contract_analyzer.group_sf_ai_contract_analyzer_manager'))]"/>
    </record>
    <record id="group_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="module_category_sf_ai_contract_analyzer"/>
    </record>
    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_sf_ai_contract_analyzer"/>
    </record>
    <record id="group_system" model="res.groups">
        <field name="name">System</field>
        <field name="category_id" ref="module_category_sf_ai_contract_analyzer"/>
    </record>
</odoo>