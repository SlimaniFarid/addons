<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="report_warranty_certificate" model="ir.actions.report">
        <field name="name">Warranty Certificate</field>
        <field name="model">sf.warranty.claim</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">sf_warranty_management.warranty_certificate_template</field>
        <field name="report_file">sf_warranty_management.warranty_certificate_template</field>
        <field name="binding_model_id" ref="model_sf_warranty_claim"/>
        <field name="binding_type">report</field>
    </record>

    <template id="warranty_certificate_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>Warranty Certificate</h2>
                        <table class="table table-sm">
                            <tr><td><strong>Claim</strong></td><td><t t-esc="o.name"/></td></tr>
                            <tr><td><strong>Customer</strong></td><td><t t-esc="o.partner_id.name"/></td></tr>
                            <tr><td><strong>Product</strong></td><td><t t-esc="o.product_id.display_name"/></td></tr>
                            <tr><td><strong>Serial number</strong></td><td><t t-esc="o.serial_number or ''"/></td></tr>
                            <tr><td><strong>Purchase date</strong></td><td><t t-esc="o.purchase_date or ''"/></td></tr>
                            <tr><td><strong>Applicable warranty</strong></td><td><t t-esc="o.warranty_id.name if o.warranty_id else 'None'"/></td></tr>
                            <tr><td><strong>Eligible</strong></td><td><t t-esc="o.eligible"/></td></tr>
                            <tr><td><strong>Eligibility detail</strong></td><td><t t-esc="o.eligibility_detail or ''"/></td></tr>
                        </table>
                        <t t-if="o.decision">
                            <h4>Decision</h4>
                            <table class="table table-sm">
                                <tr><td><strong>Decision</strong></td><td><t t-esc="o.decision"/></td></tr>
                                <tr><td><strong>Reason</strong></td><td><t t-esc="o.decision_reason or ''"/></td></tr>
                                <tr><td><strong>Estimated cost</strong></td><td><t t-esc="o.estimated_cost"/></td></tr>
                                <tr><td><strong>Decision date</strong></td><td><t t-esc="o.decision_date or ''"/></td></tr>
                            </table>
                        </t>
                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>