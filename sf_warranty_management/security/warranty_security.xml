<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_warranty" model="ir.module.category">
        <field name="name">Warranty Management</field>
        <field name="sequence">90</field>
    </record>

    <record id="group_warranty_user" model="res.groups">
        <field name="name">Warranty Management User</field>
        <field name="category_id" ref="module_category_warranty"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_warranty_manager" model="res.groups">
        <field name="name">Warranty Management Manager</field>
        <field name="category_id" ref="module_category_warranty"/>
        <field name="implied_ids" eval="[(4, ref('group_warranty_user'))]"/>
    </record>

    <record id="rule_warranty_user_company" model="ir.rule">
        <field name="name">Warranty: user sees own company</field>
        <field name="model_id" ref="model_sf_warranty"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_warranty_user'))]"/>
    </record>

    <record id="rule_warranty_claim_user_company" model="ir.rule">
        <field name="name">Claim: user sees own company</field>
        <field name="model_id" ref="model_sf_warranty_claim"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_warranty_user'))]"/>
    </record>

    <record id="rule_warranty_manager_all" model="ir.rule">
        <field name="name">Warranty: manager sees all companies</field>
        <field name="model_id" ref="model_sf_warranty"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_warranty_manager'))]"/>
    </record>

    <record id="rule_warranty_claim_manager_all" model="ir.rule">
        <field name="name">Claim: manager sees all companies</field>
        <field name="model_id" ref="model_sf_warranty_claim"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_warranty_manager'))]"/>
    </record>
    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_warranty"/>
    </record>
</odoo>