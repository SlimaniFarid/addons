<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_energy_meter_readings" model="ir.module.category">
        <field name="name">Energy Meter Readings &amp; Alerts</field>
        <field name="sequence">18</field>
    </record>
    <record id="group_energy_meter_readings_user" model="res.groups">
        <field name="name">Energy Meter Readings &amp; Alerts User</field>
        <field name="category_id" ref="module_category_energy_meter_readings"/>

    </record>
    <record id="group_energy_meter_readings_manager" model="res.groups">
        <field name="name">Energy Meter Readings &amp; Alerts Manager</field>
        <field name="category_id" ref="module_category_energy_meter_readings"/>
        <field name="implied_ids" eval="[(4, ref('group_energy_meter_readings_user'))]"/>
    </record>
    <record id="rule_energy_meter_readings_sf_energy_reading" model="ir.rule">
        <field name="name">Meter Reading: multi-company</field>
        <field name="model_id" ref="model_sf_energy_reading"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_energy_meter_readings"/>
    </record>
</odoo>
