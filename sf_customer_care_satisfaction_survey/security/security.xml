<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_customer_care_satisfaction_survey" model="ir.module.category">
        <field name="name">Post-Resolution Survey</field>
        <field name="sequence">359</field>
    </record>
    <record id="group_customer_care_satisfaction_survey_user" model="res.groups">
        <field name="name">Post-Resolution Survey User</field>
        <field name="category_id" ref="module_category_customer_care_satisfaction_survey"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>

    </record>
    <record id="group_customer_care_satisfaction_survey_manager" model="res.groups">
        <field name="name">Post-Resolution Survey Manager</field>
        <field name="category_id" ref="module_category_customer_care_satisfaction_survey"/>
        <field name="implied_ids" eval="[(4, ref('group_customer_care_satisfaction_survey_user'))]"/>
    </record>
    <record id="rule_customer_care_satisfaction_survey_sf_customer_care_satisfaction_survey" model="ir.rule">
        <field name="name">Post-Resolution Survey: multi-company</field>
        <field name="model_id" ref="model_sf_customer_care_satisfaction_survey"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_customer_care_satisfaction_survey"/>
    </record>
</odoo>
