<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_field_service_customer_satisfaction" model="ir.actions.act_window">
        <field name="name">Field Service CSAT</field>
        <field name="res_model">sf.field_service_customer_satisfaction</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
    <record id="view_sf_field_service_customer_satisfaction_form" model="ir.ui.view">
        <field name="name">sf.field_service_customer_satisfaction.form</field>
        <field name="model">sf.field_service_customer_satisfaction</field>
        <field name="arch" type="xml">
            <form string="Field Service CSAT">
                <header>
                    <button name="action_submitted" type="object" string="Submitted"
                            class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="service_ref"/>
                            <field name="rating"/>
                            <field name="comments"/>
                            <field name="follow_up_done"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_field_service_customer_satisfaction_list" model="ir.ui.view">
        <field name="name">sf.field_service_customer_satisfaction.list</field>
        <field name="model">sf.field_service_customer_satisfaction</field>
        <field name="arch" type="xml">
            <list string="Field Service CSAT" sample="1">
                <field name="partner_id"/>
                <field name="service_ref"/>
                <field name="rating"/>
                <field name="comments"/>
                <field name="follow_up_done"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state in ('submitted','approved')"/>
            </list>
        </field>
    </record>
    <record id="view_sf_field_service_customer_satisfaction_kanban" model="ir.ui.view">
        <field name="name">sf.field_service_customer_satisfaction.kanban</field>
        <field name="model">sf.field_service_customer_satisfaction</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_view" group_by="state">
                <field name="name"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <menuitem id="menu_sf_field_service_customer_satisfaction_root" name="Field Service CSAT" sequence="10"
              web_icon="sf_field_service_customer_satisfaction,static/description/icon.png"/>
    <menuitem id="menu_sf_field_service_customer_satisfaction_main" name="Records"
              parent="menu_sf_field_service_customer_satisfaction_root" action="action_sf_field_service_customer_satisfaction" sequence="10"/>
</odoo>
