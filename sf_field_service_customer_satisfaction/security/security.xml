<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_field_service_customer_satisfaction" model="ir.module.category">
        <field name="name">Field Service CSAT</field>
        <field name="sequence">391</field>
    </record>
    <record id="group_field_service_customer_satisfaction_user" model="res.groups">
        <field name="name">Field Service CSAT User</field>
        <field name="category_id" ref="module_category_field_service_customer_satisfaction"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>

    </record>
    <record id="group_field_service_customer_satisfaction_manager" model="res.groups">
        <field name="name">Field Service CSAT Manager</field>
        <field name="category_id" ref="module_category_field_service_customer_satisfaction"/>
        <field name="implied_ids" eval="[(4, ref('group_field_service_customer_satisfaction_user'))]"/>
    </record>
    <record id="rule_field_service_customer_satisfaction_sf_field_service_customer_satisfaction" model="ir.rule">
        <field name="name">Field Service CSAT: multi-company</field>
        <field name="model_id" ref="model_sf_field_service_customer_satisfaction"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_field_service_customer_satisfaction"/>
    </record>
</odoo>
