<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_warehouse_safety_log" model="ir.module.category">
        <field name="name">Warehouse Safety Incident Log</field>
        <field name="sequence">193</field>
    </record>
    <record id="group_warehouse_safety_log_user" model="res.groups">
        <field name="name">Warehouse Safety Incident Log User</field>
        <field name="category_id" ref="module_category_warehouse_safety_log"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>

    </record>
    <record id="group_warehouse_safety_log_manager" model="res.groups">
        <field name="name">Warehouse Safety Incident Log Manager</field>
        <field name="category_id" ref="module_category_warehouse_safety_log"/>
        <field name="implied_ids" eval="[(4, ref('group_warehouse_safety_log_user'))]"/>
    </record>
    <record id="rule_warehouse_safety_log_sf_warehouse_safety_log" model="ir.rule">
        <field name="name">Warehouse Safety Incident Log: multi-company</field>
        <field name="model_id" ref="model_sf_warehouse_safety_log"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_warehouse_safety_log"/>
    </record>
</odoo>
