<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_it_asset_lifecycle" model="ir.actions.act_window">
        <field name="name">IT Asset Lifecycle Tracker</field>
        <field name="res_model">sf.it_asset_lifecycle</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
    <record id="view_sf_it_asset_lifecycle_form" model="ir.ui.view">
        <field name="name">sf.it_asset_lifecycle.form</field>
        <field name="model">sf.it_asset_lifecycle</field>
        <field name="arch" type="xml">
            <form string="IT Asset Lifecycle Tracker">
                <header>
                    <button name="action_submitted" type="object" string="Submitted"
                            class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="asset_tag"/>
                            <field name="asset_type"/>
                            <field name="assigned_to_id"/>
                            <field name="purchase_date"/>
                            <field name="warranty_expiry"/>
                            <field name="refresh_due"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_it_asset_lifecycle_list" model="ir.ui.view">
        <field name="name">sf.it_asset_lifecycle.list</field>
        <field name="model">sf.it_asset_lifecycle</field>
        <field name="arch" type="xml">
            <list string="IT Asset Lifecycle Tracker" sample="1">
                <field name="asset_tag"/>
                <field name="asset_type"/>
                <field name="assigned_to_id"/>
                <field name="purchase_date"/>
                <field name="warranty_expiry"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state in ('submitted','approved')"/>
            </list>
        </field>
    </record>
    <record id="view_sf_it_asset_lifecycle_kanban" model="ir.ui.view">
        <field name="name">sf.it_asset_lifecycle.kanban</field>
        <field name="model">sf.it_asset_lifecycle</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_view" group_by="state">
                <field name="name"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <menuitem id="menu_sf_it_asset_lifecycle_root" name="IT Asset Lifecycle Tracker" sequence="26"
              web_icon="sf_it_asset_lifecycle,static/description/icon.png"/>
    <menuitem id="menu_sf_it_asset_lifecycle_main" name="Records"
              parent="menu_sf_it_asset_lifecycle_root" action="action_sf_it_asset_lifecycle" sequence="10"/>

    <record id="wave_final_sf_it_asset_lifecycle" model="ir.actions.server">
        <field name="name">Refresh Business Data</field>
        <field name="model_id" ref="model_sf_it_asset_lifecycle"/>
        <field name="binding_model_id" ref="model_sf_it_asset_lifecycle"/>
        <field name="state">code</field>
        <field name="code">records.action_refresh_business()</field>
    </record>
</odoo>
