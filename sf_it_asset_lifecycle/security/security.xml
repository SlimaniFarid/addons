<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_it_asset_lifecycle" model="ir.module.category">
        <field name="name">IT Asset Lifecycle Tracker</field>
        <field name="sequence">175</field>
    </record>
    <record id="group_it_asset_lifecycle_user" model="res.groups">
        <field name="name">IT Asset Lifecycle Tracker User</field>
        <field name="category_id" ref="module_category_it_asset_lifecycle"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>

    </record>
    <record id="group_it_asset_lifecycle_manager" model="res.groups">
        <field name="name">IT Asset Lifecycle Tracker Manager</field>
        <field name="category_id" ref="module_category_it_asset_lifecycle"/>
        <field name="implied_ids" eval="[(4, ref('group_it_asset_lifecycle_user'))]"/>
    </record>
    <record id="rule_it_asset_lifecycle_sf_it_asset_lifecycle" model="ir.rule">
        <field name="name">IT Asset Lifecycle Tracker: multi-company</field>
        <field name="model_id" ref="model_sf_it_asset_lifecycle"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_it_asset_lifecycle"/>
    </record>
</odoo>
