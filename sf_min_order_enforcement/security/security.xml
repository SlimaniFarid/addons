<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_min_order_enforcement" model="ir.module.category">
        <field name="name">Minimum Order Enforcement</field>
        <field name="sequence">47</field>
    </record>
    <record id="group_min_order_enforcement_user" model="res.groups">
        <field name="name">Minimum Order Enforcement User</field>
        <field name="category_id" ref="module_category_min_order_enforcement"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>

    </record>
    <record id="group_min_order_enforcement_manager" model="res.groups">
        <field name="name">Minimum Order Enforcement Manager</field>
        <field name="category_id" ref="module_category_min_order_enforcement"/>
        <field name="implied_ids" eval="[(4, ref('group_min_order_enforcement_user'))]"/>
    </record>
    <record id="rule_min_order_enforcement_sf_min_order_rule" model="ir.rule">
        <field name="name">Minimum Order Rule: multi-company</field>
        <field name="model_id" ref="model_sf_min_order_rule"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
