<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_receipt_discrepancy" model="ir.actions.act_window">
        <field name="name">Goods Receipt Discrepancy Log</field>
        <field name="res_model">sf.receipt.discrepancy</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
    <record id="view_sf_receipt_discrepancy_form" model="ir.ui.view">
        <field name="name">sf.receipt.discrepancy.form</field>
        <field name="model">sf.receipt.discrepancy</field>
        <field name="arch" type="xml">
            <form string="Goods Receipt Discrepancy Log">
                <header>
                    <button name="action_notified" type="object" string="Notified"
                            class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="open,notified,resolved"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="picking_id"/>
                            <field name="discrepancy_type"/>
                            <field name="qty_affected"/>
                            <field name="disposition"/>
                            <field name="supplier_notified"/>
                            <field name="notes"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_receipt_discrepancy_list" model="ir.ui.view">
        <field name="name">sf.receipt.discrepancy.list</field>
        <field name="model">sf.receipt.discrepancy</field>
        <field name="arch" type="xml">
            <list string="Goods Receipt Discrepancy Log" sample="1">
                <field name="picking_id"/>
                <field name="discrepancy_type"/>
                <field name="qty_affected"/>
                <field name="disposition"/>
                <field name="supplier_notified"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state in ('submitted','approved')"/>
            </list>
        </field>
    </record>
    <record id="view_sf_receipt_discrepancy_kanban" model="ir.ui.view">
        <field name="name">sf.receipt.discrepancy.kanban</field>
        <field name="model">sf.receipt.discrepancy</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_view" group_by="state">
                <field name="name"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <menuitem id="menu_sf_receipt_discrepancy_root" name="Goods Receipt Discrepancy Log" sequence="26"
              web_icon="sf_receiving_discrepancy_log,static/description/icon.png"/>
    <menuitem id="menu_sf_receipt_discrepancy_main" name="Records"
              parent="menu_sf_receipt_discrepancy_root" action="action_sf_receipt_discrepancy" sequence="10"/>
</odoo>
