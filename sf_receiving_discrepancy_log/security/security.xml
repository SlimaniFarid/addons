<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_receiving_discrepancy_log" model="ir.module.category">
        <field name="name">Goods Receipt Discrepancy Log</field>
        <field name="sequence">38</field>
    </record>
    <record id="group_receiving_discrepancy_log_user" model="res.groups">
        <field name="name">Goods Receipt Discrepancy Log User</field>
        <field name="category_id" ref="module_category_receiving_discrepancy_log"/>
        <field name="implied_ids" eval="[(4, ref('purchase.group_purchase_user'))]"/>

    </record>
    <record id="group_receiving_discrepancy_log_manager" model="res.groups">
        <field name="name">Goods Receipt Discrepancy Log Manager</field>
        <field name="category_id" ref="module_category_receiving_discrepancy_log"/>
        <field name="implied_ids" eval="[(4, ref('group_receiving_discrepancy_log_user'))]"/>
    </record>
    <record id="rule_receiving_discrepancy_log_sf_receipt_discrepancy" model="ir.rule">
        <field name="name">Receipt Discrepancy: multi-company</field>
        <field name="model_id" ref="model_sf_receipt_discrepancy"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_receiving_discrepancy_log"/>
    </record>
</odoo>
