<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_customer_care_escalation_dashboard" model="ir.actions.act_window">
        <field name="name">Escalation Dashboard Config</field>
        <field name="res_model">sf.customer_care_escalation_dashboard</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
    <record id="view_sf_customer_care_escalation_dashboard_form" model="ir.ui.view">
        <field name="name">sf.customer_care_escalation_dashboard.form</field>
        <field name="model">sf.customer_care_escalation_dashboard</field>
        <field name="arch" type="xml">
            <form string="Escalation Dashboard Config">
                <header>
                    <button name="action_submitted" type="object" string="Submitted"
                            class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="metric"/>
                            <field name="metric_type"/>
                            <field name="target"/>
                            <field name="alert_threshold"/>
                            <field name="team_routing"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_customer_care_escalation_dashboard_list" model="ir.ui.view">
        <field name="name">sf.customer_care_escalation_dashboard.list</field>
        <field name="model">sf.customer_care_escalation_dashboard</field>
        <field name="arch" type="xml">
            <list string="Escalation Dashboard Config" sample="1">
                <field name="metric"/>
                <field name="metric_type"/>
                <field name="target"/>
                <field name="alert_threshold"/>
                <field name="team_routing"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state in ('submitted','approved')"/>
            </list>
        </field>
    </record>
    <record id="view_sf_customer_care_escalation_dashboard_kanban" model="ir.ui.view">
        <field name="name">sf.customer_care_escalation_dashboard.kanban</field>
        <field name="model">sf.customer_care_escalation_dashboard</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_view" group_by="state">
                <field name="name"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <menuitem id="menu_sf_customer_care_escalation_dashboard_root" name="Escalation Dashboard Config" sequence="10"
              web_icon="sf_customer_care_escalation_dashboard,static/description/icon.png"/>
    <menuitem id="menu_sf_customer_care_escalation_dashboard_main" name="Records"
              parent="menu_sf_customer_care_escalation_dashboard_root" action="action_sf_customer_care_escalation_dashboard" sequence="10"/>
</odoo>
