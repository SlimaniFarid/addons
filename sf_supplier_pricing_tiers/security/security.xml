<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_supplier_pricing_tiers" model="ir.module.category">
        <field name="name">Supplier Pricing Tiers</field>
        <field name="sequence">688</field>
    </record>
    <record id="group_supplier_pricing_tiers_user" model="res.groups">
        <field name="name">Supplier Pricing Tiers User</field>
        <field name="category_id" ref="module_category_supplier_pricing_tiers"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>

    </record>
    <record id="group_supplier_pricing_tiers_manager" model="res.groups">
        <field name="name">Supplier Pricing Tiers Manager</field>
        <field name="category_id" ref="module_category_supplier_pricing_tiers"/>
        <field name="implied_ids" eval="[(4, ref('group_supplier_pricing_tiers_user'))]"/>
    </record>
    <record id="rule_supplier_pricing_tiers_sf_supplier_pricing_tiers" model="ir.rule">
        <field name="name">Supplier Pricing Tiers: multi-company</field>
        <field name="model_id" ref="model_sf_supplier_pricing_tiers"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
