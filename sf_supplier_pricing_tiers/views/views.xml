<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_supplier_pricing_tiers" model="ir.actions.act_window">
        <field name="name">Supplier Pricing Tiers</field>
        <field name="res_model">sf.supplier_pricing_tiers</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
    <record id="view_sf_supplier_pricing_tiers_form" model="ir.ui.view">
        <field name="name">sf.supplier_pricing_tiers.form</field>
        <field name="model">sf.supplier_pricing_tiers</field>
        <field name="arch" type="xml">
            <form string="Supplier Pricing Tiers">
                <header>
                    <button name="action_submitted" type="object" string="Submitted"
                            class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="vendor_id"/>
                            <field name="product_id"/>
                            <field name="tier_1_qty"/>
                            <field name="tier_1_price"/>
                            <field name="tier_2_qty"/>
                            <field name="tier_2_price"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_supplier_pricing_tiers_list" model="ir.ui.view">
        <field name="name">sf.supplier_pricing_tiers.list</field>
        <field name="model">sf.supplier_pricing_tiers</field>
        <field name="arch" type="xml">
            <list string="Supplier Pricing Tiers" sample="1">
                <field name="vendor_id"/>
                <field name="product_id"/>
                <field name="tier_1_qty"/>
                <field name="tier_1_price"/>
                <field name="tier_2_qty"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state in ('submitted','approved')"/>
            </list>
        </field>
    </record>
    <record id="view_sf_supplier_pricing_tiers_kanban" model="ir.ui.view">
        <field name="name">sf.supplier_pricing_tiers.kanban</field>
        <field name="model">sf.supplier_pricing_tiers</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_view" group_by="state">
                <field name="name"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <menuitem id="menu_sf_supplier_pricing_tiers_root" name="Supplier Pricing Tiers" sequence="13"
              web_icon="sf_supplier_pricing_tiers,static/description/icon.png"/>
    <menuitem id="menu_sf_supplier_pricing_tiers_main" name="Records"
              parent="menu_sf_supplier_pricing_tiers_root" action="action_sf_supplier_pricing_tiers" sequence="10"/>
</odoo>
