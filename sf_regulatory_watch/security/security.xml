<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_regulatory_watch" model="ir.module.category">
        <field name="name">Regulatory Watch Register</field>
        <field name="sequence">57</field>
    </record>
    <record id="group_regulatory_watch_user" model="res.groups">
        <field name="name">Regulatory Watch Register User</field>
        <field name="category_id" ref="module_category_regulatory_watch"/>

    </record>
    <record id="group_regulatory_watch_manager" model="res.groups">
        <field name="name">Regulatory Watch Register Manager</field>
        <field name="category_id" ref="module_category_regulatory_watch"/>
        <field name="implied_ids" eval="[(4, ref('group_regulatory_watch_user'))]"/>
    </record>
    <record id="rule_regulatory_watch_sf_reg_watch" model="ir.rule">
        <field name="name">Regulation Watch: multi-company</field>
        <field name="model_id" ref="model_sf_reg_watch"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_regulatory_watch"/>
    </record>
</odoo>
