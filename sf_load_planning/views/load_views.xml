<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_load_plan" model="ir.actions.act_window">
        <field name="name">Load Plans</field>
        <field name="res_model">sf.load.plan</field>
        <field name="view_mode">kanban,list,form,kanban</field>
    </record>

    <record id="view_sf_load_plan_form" model="ir.ui.view">
        <field name="name">sf.load.plan.form</field>
        <field name="model">sf.load.plan</field>
        <field name="arch" type="xml">
            <form string="Load Plan">
                <header>
                    <button name="action_plan" type="object"
                            string="Plan Load" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_loaded" type="object" string="Loaded"
                            invisible="state != 'planned'"/>
                    <button name="action_depart" type="object" string="Depart"
                            invisible="state != 'loaded'"/>
                    <button name="action_complete" type="object"
                            string="Complete" invisible="state != 'departed'"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state in ('completed','cancelled')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,planned,loaded,departed,completed"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="carrier_id"/>
                            <field name="vehicle_ref"/>
                            <field name="warehouse_id"/>
                        </group>
                        <group>
                            <field name="departure_date"/>
                            <field name="max_weight_kg"/>
                            <field name="max_volume_m3"/>
                            <field name="max_pallets"/>
                        </group>
                        <group>
                            <field name="total_weight_kg" readonly="1"/>
                            <field name="total_volume_m3" readonly="1"/>
                            <field name="total_pallets" readonly="1"/>
                        </group>
                        <group>
                            <field name="weight_over" widget="boolean" readonly="1"/>
                            <field name="volume_over" widget="boolean" readonly="1"/>
                            <field name="pallets_over" widget="boolean" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Deliveries" name="pickings">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="picking_id"/>
                                    <field name="partner_id" readonly="1"/>
                                    <field name="stop_id"/>
                                    <field name="pallet_count" readonly="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Route Stops" name="stops">
                            <field name="stop_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="partner_id"/>
                                    <field name="planned_arrival"/>
                                    <field name="notes"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                    <group string="Notes">
                        <field name="notes"/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_load_plan_list" model="ir.ui.view">
        <field name="name">sf.load.plan.list</field>
        <field name="model">sf.load.plan</field>
        <field name="arch" type="xml">
            <list string="Load Plans" sample="1" decoration-danger="weight_over or volume_over or pallets_over">
                <field name="name"/>
                <field name="carrier_id"/>
                <field name="departure_date"/>
                <field name="picking_count"/>
                <field name="total_weight_kg"/>
                <field name="state" widget="badge"
                       decoration-success="state in ('departed','completed')"/>
            </list>
        </field>
    </record>

    <menuitem id="menu_sf_load_root" name="Load Planning" sequence="36"
              parent="stock.menu_stock_root"/>
    <menuitem id="menu_sf_load_plans" name="Load Plans"
              parent="menu_sf_load_root" action="action_sf_load_plan"
              sequence="10"/>

    <record id="view_sf_load_planning_boost_kanban" model="ir.ui.view">
        <field name="name">sf_load_planning.boost.kanban</field>
        <field name="model">sf.load.plan</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" t-att-color="state">
                <field name="name"/>
                <field name="state"/>
                <field name="user_id"/>

                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_card oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title">
                                    <field name="name"/></strong>
                                <div class="o_kanban_record_subtitle">
                                    <field name="user_id" widget="many2one_avatar_user"/>
                                    <field name="create_date"/></div>
                            </div>
                            <div class="oe_kanban_bottom_right">
                                <field name="state" widget="badge"
                                       t-attf-options="{'classes_map': {'draft': 'info', 'done': 'success', 'cancelled': 'danger'}, 'domain': []}"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_sf_load_planning_boost_search" model="ir.ui.view">
        <field name="name">sf_load_planning.boost.search</field>
        <field name="model">sf.load.plan</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
<separator/>
                <filter string="My records" name="my_records" domain="[('user_id', '=', uid)]"/>
                <filter string="To Do" name="todo" domain="[('state', 'not in', ('done', 'cancelled', 'closed'))]"/>
                <group expand="0" string="Group By"><filter string="Status" name="gb_state" context="{'group_by': 'state'}"/></group>
            </search>
        </field>
    </record>

    <record id="wave_final_sf_load_planning" model="ir.actions.server">
        <field name="name">Refresh Business Data</field>
        <field name="model_id" ref="model_sf_load_plan"/>
        <field name="binding_model_id" ref="model_sf_load_plan"/>
        <field name="state">code</field>
        <field name="code">records.action_refresh_business()</field>
    </record>
</odoo>
