<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_sf_load" model="ir.module.category">
        <field name="name">Load Planning</field>
        <field name="sequence">86</field>
    </record>
    <record id="group_sf_load_user" model="res.groups">
        <field name="name">Load Planning User</field>
        <field name="category_id" ref="module_category_sf_load"/>
        <field name="implied_ids" eval="[(4, ref('stock.group_stock_user'))]"/>
    </record>
    <record id="group_sf_load_manager" model="res.groups">
        <field name="name">Load Planning Manager</field>
        <field name="category_id" ref="module_category_sf_load"/>
        <field name="implied_ids" eval="[(4, ref('group_sf_load_user'))]"/>
    </record>
    <record id="rule_sf_load_company" model="ir.rule">
        <field name="name">Load Plan: multi-company</field>
        <field name="model_id" ref="model_sf_load_plan"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_sf_load"/>
    </record>
</odoo>
