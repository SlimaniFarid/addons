<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_fleet">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-set="company" t-value="o.company_id or res_company"/>
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>Fleet Report</h2>
                        <table class="table table-sm">
                            <tr><th>Equipment</th><th>Category</th><th>Serial</th><th>Status</th><th>Daily</th><th>Weekly</th><th>Monthly</th></tr>
                            <tr t-foreach="o" t-as="e">
                                <td><span t-field="e.name"/></td>
                                <td><span t-field="e.category_id"/></td>
                                <td><span t-field="e.serial"/></td>
                                <td><span t-field="e.state"/></td>
                                <td><span t-field="e.daily_price"/></td>
                                <td><span t-field="e.weekly_price"/></td>
                                <td><span t-field="e.monthly_price"/></td>
                            </tr>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>