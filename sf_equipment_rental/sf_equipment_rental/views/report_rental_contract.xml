<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_rental_contract">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-set="company" t-value="o.company_id or res_company"/>
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>Rental Contract</h2>
                        <table class="table table-sm">
                            <tr><th>Contract</th><td><span t-field="o.name"/></td></tr>
                            <tr><th>Customer</th><td><span t-field="o.partner_id"/></td></tr>
                            <tr><th>Period</th><td><span t-field="o.start_datetime"/> - <span t-field="o.end_datetime"/></td></tr>
                            <tr><th>Total</th><td><span t-field="o.amount_total"/></td></tr>
                            <tr><th>Penalties</th><td><span t-field="o.penalty_total"/></td></tr>
                        </table>
                        <h3>Equipment</h3>
                        <table class="table table-sm">
                            <tr><th>Equipment</th><th>Qty</th><th>Unit Price</th><th>Subtotal</th></tr>
                            <tr t-foreach="o.line_ids" t-as="l">
                                <td><span t-field="l.equipment_id"/></td>
                                <td><span t-field="l.qty"/></td>
                                <td><span t-field="l.price_unit"/></td>
                                <td><span t-field="l.subtotal"/></td>
                            </tr>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>