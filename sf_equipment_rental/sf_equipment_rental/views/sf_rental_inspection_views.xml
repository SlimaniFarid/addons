<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sf_rental_inspection_view_list" model="ir.ui.view">
        <field name="name">sf.rental.inspection.list</field>
        <field name="model">sf.rental.inspection</field>
        <field name="arch" type="xml">
            <list string="Inspections">
                <field name="name"/>
                <field name="contract_id"/>
                <field name="direction"/>
                <field name="date"/>
                <field name="condition"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="sf_rental_inspection_view_form" model="ir.ui.view">
        <field name="name">sf.rental.inspection.form</field>
        <field name="model">sf.rental.inspection</field>
        <field name="arch" type="xml">
            <form string="Inspection">
                <header>
                    <button name="action_done" string="Complete" type="object" class="btn-primary"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="contract_id"/>
                            <field name="line_id"/>
                            <field name="direction"/>
                        </group>
                        <group>
                            <field name="date"/>
                            <field name="condition"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group string="Damages">
                        <field name="damage_ids">
                            <list string="Damages">
                                <field name="description"/>
                                <field name="penalty_amount"/>
                            </list>
                        </field>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_sf_rental_inspection" model="ir.actions.act_window">
        <field name="name">Inspections</field>
        <field name="res_model">sf.rental.inspection</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>