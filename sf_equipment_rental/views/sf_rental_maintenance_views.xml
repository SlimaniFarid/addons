<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sf_rental_maintenance_view_list" model="ir.ui.view">
        <field name="name">sf.rental.maintenance.list</field>
        <field name="model">sf.rental.maintenance</field>
        <field name="arch" type="xml">
            <list string="Maintenance">
                <field name="name"/>
                <field name="equipment_id"/>
                <field name="scheduled_date"/>
                <field name="state" widget="badge"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="sf_rental_maintenance_view_form" model="ir.ui.view">
        <field name="name">sf.rental.maintenance.form</field>
        <field name="model">sf.rental.maintenance</field>
        <field name="arch" type="xml">
            <form string="Maintenance">
                <header>
                    <button name="action_schedule" string="Schedule" type="object" class="btn-primary" invisible="[('state', '!=', 'draft')]"/>
                    <button name="action_start" string="Start" type="object" class="btn-primary" invisible="[('state', '!=', 'scheduled')]"/>
                    <button name="action_done" string="Complete" type="object" class="btn-primary" invisible="[('state', '!=', 'in_progress')]"/>
                    <button name="action_cancel" string="Cancel" type="object" invisible="[('state', 'in', ('done', 'cancelled'))]"/>
                    <field name="state" widget="statusbar" readonly="1"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="equipment_id"/>
                            <field name="scheduled_date"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group string="Description">
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="sf_rental_maintenance_view_search" model="ir.ui.view">
        <field name="name">sf.rental.maintenance.search</field>
        <field name="model">sf.rental.maintenance</field>
        <field name="arch" type="xml">
            <search string="Maintenance">
                <field name="name"/>
                <field name="equipment_id"/>
                <filter name="maintenance_scheduled" string="Scheduled" domain="[('state', '=', 'scheduled')]"/>
                <filter name="maintenance_in_progress" string="In Progress" domain="[('state', '=', 'in_progress')]"/>
                <group>
                    <filter name="group_maintenance_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_maintenance_equipment" string="Equipment" context="{'group_by': 'equipment_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_sf_rental_maintenance" model="ir.actions.act_window">
        <field name="name">Maintenance</field>
        <field name="res_model">sf.rental.maintenance</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="sf_rental_maintenance_view_search"/>
    </record>
</odoo>