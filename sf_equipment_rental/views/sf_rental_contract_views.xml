<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sf_rental_contract_view_list" model="ir.ui.view">
        <field name="name">sf.rental.contract.list</field>
        <field name="model">sf.rental.contract</field>
        <field name="arch" type="xml">
            <list string="Contracts">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="start_datetime"/>
                <field name="end_datetime"/>
                <field name="amount_total"/>
                <field name="penalty_total"/>
                <field name="state" widget="badge"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="sf_rental_contract_view_form" model="ir.ui.view">
        <field name="name">sf.rental.contract.form</field>
        <field name="model">sf.rental.contract</field>
        <field name="arch" type="xml">
            <form string="Contract">
                <header>
                    <button name="action_confirm" string="Confirm" type="object" class="btn-primary" invisible="[('state', '!=', 'draft')]"/>
                    <button name="action_active" string="Start Rental" type="object" class="btn-primary" invisible="[('state', '!=', 'confirmed')]"/>
                    <button name="action_return" string="Return" type="object" class="btn-primary" invisible="[('state', '!=', 'active')]"/>
                    <button name="action_invoice" string="Invoice" type="object" class="btn-primary" invisible="[('state', '!=', 'returned')]"/>
                    <button name="action_close" string="Close" type="object" class="btn-primary" invisible="[('state', '!=', 'invoiced')]"/>
                    <button name="action_cancel" string="Cancel Contract" type="object" invisible="[('state', 'in', ('active', 'returned', 'invoiced', 'closed', 'cancelled'))]"/>
                    <field name="state" widget="statusbar" readonly="1"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="start_datetime"/>
                            <field name="end_datetime"/>
                        </group>
                        <group>
                            <field name="invoice_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Lines">
                            <field name="line_ids">
                                <list string="Lines">
                                    <field name="equipment_id"/>
                                    <field name="qty"/>
                                    <field name="price_unit"/>
                                    <field name="subtotal"/>
                                </list>
                            </field>
                        </page>
                        <page string="Inspections">
                            <group string="Out Inspections">
                                <field name="inspection_out_ids">
                                    <list string="Out">
                                        <field name="name"/>
                                        <field name="line_id"/>
                                        <field name="date"/>
                                        <field name="condition"/>
                                    </list>
                                </field>
                            </group>
                            <group string="In Inspections">
                                <field name="inspection_in_ids">
                                    <list string="In">
                                        <field name="name"/>
                                        <field name="line_id"/>
                                        <field name="date"/>
                                        <field name="condition"/>
                                    </list>
                                </field>
                            </group>
                        </page>
                    </notebook>
                    <div class="oe_subtotal_footer oe_right">
                        <div class="oe_subtotal">
                            <span class="oe_subtotal_footer_separator">Penalties:</span>
                            <field name="penalty_total"/>
                        </div>
                        <div class="oe_subtotal">
                            <span class="oe_subtotal_footer_separator">Total:</span>
                            <field name="amount_total"/>
                        </div>
                        <div class="oe_subtotal">
                            <span class="oe_subtotal_footer_separator">Amount Due:</span>
                            <field name="amount_due"/>
                        </div>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="sf_rental_contract_view_search" model="ir.ui.view">
        <field name="name">sf.rental.contract.search</field>
        <field name="model">sf.rental.contract</field>
        <field name="arch" type="xml">
            <search string="Contracts">
                <field name="name"/>
                <field name="partner_id"/>
                <filter name="contract_active" string="Active" domain="[('state', '=', 'active')]"/>
                <filter name="contract_confirmed" string="Confirmed" domain="[('state', '=', 'confirmed')]"/>
                <filter name="contract_returned" string="Returned" domain="[('state', '=', 'returned')]"/>
                <group>
                    <filter name="group_contract_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_contract_customer" string="Customer" context="{'group_by': 'partner_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_sf_rental_contract" model="ir.actions.act_window">
        <field name="name">Rental Contracts</field>
        <field name="res_model">sf.rental.contract</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="sf_rental_contract_view_search"/>
    </record>

    <record id="view_sf_equipment_rental_boost_kanban" model="ir.ui.view">
        <field name="name">sf_equipment_rental.boost.kanban</field>
        <field name="model">sf.rental.activity.mixin</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" t-att-color="state">
                <field name="name"/>
                <field name="state"/>
                <field name="user_id"/>

                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_card oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title">
                                    <field name="name"/></strong>
                                <div class="o_kanban_record_subtitle">
                                    <field name="user_id" widget="many2one_avatar_user"/>
                                    <field name="create_date"/></div>
                            </div>
                            <div class="oe_kanban_bottom_right">
                                <field name="state" widget="badge"
                                       t-attf-options="{'classes_map': {'draft': 'info', 'done': 'success', 'cancelled': 'danger'}, 'domain': []}"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_sf_equipment_rental_boost_search" model="ir.ui.view">
        <field name="name">sf_equipment_rental.boost.search</field>
        <field name="model">sf.rental.activity.mixin</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
<separator/>
                <filter string="My records" name="my_records" domain="[('user_id', '=', uid)]"/>
                <filter string="To Do" name="todo" domain="[('state', 'not in', ('done', 'cancelled', 'closed'))]"/>
                <group expand="0" string="Group By"><filter string="Status" name="gb_state" context="{'group_by': 'state'}"/></group>
            </search>
        </field>
    </record>

    <record id="wave_final_sf_equipment_rental" model="ir.actions.server">
        <field name="name">Refresh Business Data</field>
        <field name="model_id" ref="model_sf_rental_activity_mixin"/>
        <field name="binding_model_id" ref="model_sf_rental_activity_mixin"/>
        <field name="state">code</field>
        <field name="code">records.action_refresh_business()</field>
    </record>
</odoo>
