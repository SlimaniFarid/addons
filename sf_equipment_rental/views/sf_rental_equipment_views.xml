<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sf_rental_equipment_view_list" model="ir.ui.view">
        <field name="name">sf.rental.equipment.list</field>
        <field name="model">sf.rental.equipment</field>
        <field name="arch" type="xml">
            <list string="Equipment">
                <field name="name"/>
                <field name="category_id"/>
                <field name="serial"/>
                <field name="daily_price"/>
                <field name="weekly_price"/>
                <field name="monthly_price"/>
                <field name="state" widget="badge"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="sf_rental_equipment_view_form" model="ir.ui.view">
        <field name="name">sf.rental.equipment.form</field>
        <field name="model">sf.rental.equipment</field>
        <field name="arch" type="xml">
            <form string="Equipment">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Name"/>
                        </h1>
                        <field name="state" widget="badge"/>
                    </div>
                    <group>
                        <group>
                            <field name="category_id"/>
                            <field name="serial"/>
                            <field name="purchase_value"/>
                        </group>
                        <group>
                            <field name="hourly_price"/>
                            <field name="daily_price"/>
                            <field name="weekly_price"/>
                            <field name="monthly_price"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="sf_rental_equipment_view_search" model="ir.ui.view">
        <field name="name">sf.rental.equipment.search</field>
        <field name="model">sf.rental.equipment</field>
        <field name="arch" type="xml">
            <search string="Equipment">
                <field name="name"/>
                <field name="category_id"/>
                <filter name="equipment_available" string="Available" domain="[('state', '=', 'available')]"/>
                <filter name="equipment_out" string="Out" domain="[('state', '=', 'out')]"/>
                <filter name="equipment_maintenance" string="Maintenance" domain="[('state', '=', 'maintenance')]"/>
                <group>
                    <filter name="group_equipment_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_equipment_category" string="Category" context="{'group_by': 'category_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_sf_rental_equipment" model="ir.actions.act_window">
        <field name="name">Equipment</field>
        <field name="res_model">sf.rental.equipment</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="sf_rental_equipment_view_search"/>
    </record>

    <record id="action_sf_rental_category" model="ir.actions.act_window">
        <field name="name">Categories</field>
        <field name="res_model">sf.rental.category</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_sf_equipment_rental_boost_kanban" model="ir.ui.view">
        <field name="name">sf_equipment_rental.boost.kanban</field>
        <field name="model">sf.rental.activity.mixin</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" t-att-color="state">
                <field name="name"/>
                <field name="state"/>
                <field name="user_id"/>

                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_card oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title">
                                    <field name="name"/></strong>
                                <div class="o_kanban_record_subtitle">
                                    <field name="user_id" widget="many2one_avatar_user"/>
                                    <field name="create_date"/></div>
                            </div>
                            <div class="oe_kanban_bottom_right">
                                <field name="state" widget="badge"
                                       t-attf-options="{'classes_map': {'draft': 'info', 'done': 'success', 'cancelled': 'danger'}, 'domain': []}"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_sf_equipment_rental_boost_search" model="ir.ui.view">
        <field name="name">sf_equipment_rental.boost.search</field>
        <field name="model">sf.rental.activity.mixin</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
<separator/>
                <filter string="My records" name="my_records" domain="[('user_id', '=', uid)]"/>
                <filter string="To Do" name="todo" domain="[('state', 'not in', ('done', 'cancelled', 'closed'))]"/>
                <group expand="0" string="Group By"><filter string="Status" name="gb_state" context="{'group_by': 'state'}"/></group>
            </search>
        </field>
    </record>
</odoo>
