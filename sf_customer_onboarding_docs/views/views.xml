<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_customer_doc_req" model="ir.actions.act_window">
        <field name="name">Customer Document Collection</field>
        <field name="res_model">sf.customer.doc.req</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
    <record id="view_sf_customer_doc_req_form" model="ir.ui.view">
        <field name="name">sf.customer.doc.req.form</field>
        <field name="model">sf.customer.doc.req</field>
        <field name="arch" type="xml">
            <form string="Customer Document Collection">
                <header>
                    <button name="action_chased" type="object" string="Chased"
                            class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="requested,chased,received"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="document_needed"/>
                            <field name="needed_for"/>
                            <field name="chase_date"/>
                            <field name="received"/>
                            <field name="blocking_order"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_customer_doc_req_list" model="ir.ui.view">
        <field name="name">sf.customer.doc.req.list</field>
        <field name="model">sf.customer.doc.req</field>
        <field name="arch" type="xml">
            <list string="Customer Document Collection" sample="1">
                <field name="partner_id"/>
                <field name="document_needed"/>
                <field name="needed_for"/>
                <field name="chase_date"/>
                <field name="received"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state in ('submitted','approved')"/>
            </list>
        </field>
    </record>
    <record id="view_sf_customer_doc_req_kanban" model="ir.ui.view">
        <field name="name">sf.customer.doc.req.kanban</field>
        <field name="model">sf.customer.doc.req</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_view" group_by="state">
                <field name="name"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <menuitem id="menu_sf_customer_doc_req_root" name="Customer Document Collection" sequence="9"
              web_icon="sf_customer_onboarding_docs,static/description/icon.png"/>
    <menuitem id="menu_sf_customer_doc_req_main" name="Records"
              parent="menu_sf_customer_doc_req_root" action="action_sf_customer_doc_req" sequence="10"/>
</odoo>
