<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_customer_onboarding_docs" model="ir.module.category">
        <field name="name">Customer Document Collection</field>
        <field name="sequence">9</field>
    </record>
    <record id="group_customer_onboarding_docs_user" model="res.groups">
        <field name="name">Customer Document Collection User</field>
        <field name="category_id" ref="module_category_customer_onboarding_docs"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>

    </record>
    <record id="group_customer_onboarding_docs_manager" model="res.groups">
        <field name="name">Customer Document Collection Manager</field>
        <field name="category_id" ref="module_category_customer_onboarding_docs"/>
        <field name="implied_ids" eval="[(4, ref('group_customer_onboarding_docs_user'))]"/>
    </record>
    <record id="rule_customer_onboarding_docs_sf_customer_doc_req" model="ir.rule">
        <field name="name">Document Request: multi-company</field>
        <field name="model_id" ref="model_sf_customer_doc_req"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
