<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_sla_pause_tracking" model="ir.module.category">
        <field name="name">SLA Clock Pause Tracking</field>
        <field name="sequence">51</field>
    </record>
    <record id="group_sla_pause_tracking_user" model="res.groups">
        <field name="name">SLA Clock Pause Tracking User</field>
        <field name="category_id" ref="module_category_sla_pause_tracking"/>

    </record>
    <record id="group_sla_pause_tracking_manager" model="res.groups">
        <field name="name">SLA Clock Pause Tracking Manager</field>
        <field name="category_id" ref="module_category_sla_pause_tracking"/>
        <field name="implied_ids" eval="[(4, ref('group_sla_pause_tracking_user'))]"/>
    </record>
    <record id="rule_sla_pause_tracking_sf_sla_pause" model="ir.rule">
        <field name="name">SLA Pause: multi-company</field>
        <field name="model_id" ref="model_sf_sla_pause"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
