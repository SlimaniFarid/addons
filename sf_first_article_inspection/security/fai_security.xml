<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_fai" model="ir.module.category">
        <field name="name">First Article Inspection</field>
        <field name="sequence">98</field>
    </record>

    <record id="group_fai_inspector" model="res.groups">
        <field name="name">FAI Inspector</field>
        <field name="category_id" ref="module_category_fai"/>
        <field name="implied_ids" eval="[(4, ref('quality.group_quality_user'))]"/>
    </record>

    <record id="group_fai_engineer" model="res.groups">
        <field name="name">FAI Quality Engineer</field>
        <field name="category_id" ref="module_category_fai"/>
        <field name="implied_ids" eval="[(4, ref('group_fai_inspector'))]"/>
    </record>

    <record id="group_fai_manager" model="res.groups">
        <field name="name">FAI Manager</field>
        <field name="category_id" ref="module_category_fai"/>
        <field name="implied_ids" eval="[(4, ref('group_fai_engineer'))]"/>
    </record>
</odoo>