<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_accrual_proposals" model="ir.module.category">
        <field name="name">Month-End Accrual Proposals</field>
        <field name="sequence">53</field>
    </record>
    <record id="group_accrual_proposals_user" model="res.groups">
        <field name="name">Month-End Accrual Proposals User</field>
        <field name="category_id" ref="module_category_accrual_proposals"/>

    </record>
    <record id="group_accrual_proposals_manager" model="res.groups">
        <field name="name">Month-End Accrual Proposals Manager</field>
        <field name="category_id" ref="module_category_accrual_proposals"/>
        <field name="implied_ids" eval="[(4, ref('group_accrual_proposals_user'))]"/>
    </record>
    <record id="rule_accrual_proposals_sf_accrual" model="ir.rule">
        <field name="name">Accrual: multi-company</field>
        <field name="model_id" ref="model_sf_accrual"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
