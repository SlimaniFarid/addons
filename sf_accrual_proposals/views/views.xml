<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_accrual" model="ir.actions.act_window">
        <field name="name">Month-End Accrual Proposals</field>
        <field name="res_model">sf.accrual</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
    <record id="view_sf_accrual_form" model="ir.ui.view">
        <field name="name">sf.accrual.form</field>
        <field name="model">sf.accrual</field>
        <field name="arch" type="xml">
            <form string="Month-End Accrual Proposals">
                <header>
                    <button name="action_approved" type="object" string="Approved"
                            class="btn-primary"/>
                    <button name="action_posted" type="object" string="Posted"
                            class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="proposed,approved,posted,reversed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="label"/>
                            <field name="period_month"/>
                            <field name="amount"/>
                            <field name="reversal_month"/>
                            <field name="category"/>
                            <field name="notes"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_accrual_list" model="ir.ui.view">
        <field name="name">sf.accrual.list</field>
        <field name="model">sf.accrual</field>
        <field name="arch" type="xml">
            <list string="Month-End Accrual Proposals" sample="1">
                <field name="label"/>
                <field name="period_month"/>
                <field name="amount"/>
                <field name="reversal_month"/>
                <field name="category"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state in ('submitted','approved')"/>
            </list>
        </field>
    </record>
    <record id="view_sf_accrual_kanban" model="ir.ui.view">
        <field name="name">sf.accrual.kanban</field>
        <field name="model">sf.accrual</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_view" group_by="state">
                <field name="name"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <menuitem id="menu_sf_accrual_root" name="Month-End Accrual Proposals" sequence="4"
              web_icon="sf_accrual_proposals,static/description/icon.png"/>
    <menuitem id="menu_sf_accrual_main" name="Records"
              parent="menu_sf_accrual_root" action="action_sf_accrual" sequence="10"/>
</odoo>
