<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_purchase_contract_compliance" model="ir.module.category">
        <field name="name">Contract Compliance Checker</field>
        <field name="sequence">690</field>
    </record>
    <record id="group_purchase_contract_compliance_user" model="res.groups">
        <field name="name">Contract Compliance Checker User</field>
        <field name="category_id" ref="module_category_purchase_contract_compliance"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>

    </record>
    <record id="group_purchase_contract_compliance_manager" model="res.groups">
        <field name="name">Contract Compliance Checker Manager</field>
        <field name="category_id" ref="module_category_purchase_contract_compliance"/>
        <field name="implied_ids" eval="[(4, ref('group_purchase_contract_compliance_user'))]"/>
    </record>
    <record id="rule_purchase_contract_compliance_sf_purchase_contract_compliance" model="ir.rule">
        <field name="name">Contract Compliance Checker: multi-company</field>
        <field name="model_id" ref="model_sf_purchase_contract_compliance"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
