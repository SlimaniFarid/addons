<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_damaged_goods_log" model="ir.module.category">
        <field name="name">Damaged Goods Log</field>
        <field name="sequence">24</field>
    </record>
    <record id="group_damaged_goods_log_user" model="res.groups">
        <field name="name">Damaged Goods Log User</field>
        <field name="category_id" ref="module_category_damaged_goods_log"/>
        <field name="implied_ids" eval="[(4, ref('stock.group_stock_user'))]"/>

    </record>
    <record id="group_damaged_goods_log_manager" model="res.groups">
        <field name="name">Damaged Goods Log Manager</field>
        <field name="category_id" ref="module_category_damaged_goods_log"/>
        <field name="implied_ids" eval="[(4, ref('group_damaged_goods_log_user'))]"/>
    </record>
    <record id="rule_damaged_goods_log_sf_damaged_goods" model="ir.rule">
        <field name="name">Damaged Goods Entry: multi-company</field>
        <field name="model_id" ref="model_sf_damaged_goods"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_damaged_goods_log"/>
    </record>
</odoo>
