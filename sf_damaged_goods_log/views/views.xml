<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_damaged_goods" model="ir.actions.act_window">
        <field name="name">Damaged Goods Log</field>
        <field name="res_model">sf.damaged.goods</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
    <record id="view_sf_damaged_goods_form" model="ir.ui.view">
        <field name="name">sf.damaged.goods.form</field>
        <field name="model">sf.damaged.goods</field>
        <field name="arch" type="xml">
            <form string="Damaged Goods Log">
                <header>
                    <button name="action_investigated" type="object" string="Investigated"
                            class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="open,investigated,closed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="product_id"/>
                            <field name="quantity"/>
                            <field name="cause"/>
                            <field name="responsible"/>
                            <field name="estimated_cost"/>
                            <field name="recovered"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_damaged_goods_list" model="ir.ui.view">
        <field name="name">sf.damaged.goods.list</field>
        <field name="model">sf.damaged.goods</field>
        <field name="arch" type="xml">
            <list string="Damaged Goods Log" sample="1">
                <field name="product_id"/>
                <field name="quantity"/>
                <field name="cause"/>
                <field name="responsible"/>
                <field name="estimated_cost"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state in ('submitted','approved')"/>
            </list>
        </field>
    </record>
    <record id="view_sf_damaged_goods_kanban" model="ir.ui.view">
        <field name="name">sf.damaged.goods.kanban</field>
        <field name="model">sf.damaged.goods</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_view" group_by="state">
                <field name="name"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <menuitem id="menu_sf_damaged_goods_root" name="Damaged Goods Log" sequence="17"
              web_icon="sf_damaged_goods_log,static/description/icon.png"/>
    <menuitem id="menu_sf_damaged_goods_main" name="Records"
              parent="menu_sf_damaged_goods_root" action="action_sf_damaged_goods" sequence="10"/>
</odoo>
