<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_sf_quality_inspection" model="ir.module.category">
        <field name="name">Quality Inspection Mobile</field>
        <field name="description">Quality Inspection Mobile</field>
        <field name="sequence">10</field>
    </record>
    <record id="group_quality_inspection_user" model="res.groups">
        <field name="name">Quality Inspection Mobile / User</field>
        <field name="category_id" ref="module_category_sf_quality_inspection"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_quality_inspection_manager" model="res.groups">
        <field name="name">Quality Inspection Mobile / Manager</field>
        <field name="category_id" ref="module_category_sf_quality_inspection"/>
        <field name="implied_ids" eval="[(4, ref('sf_quality_inspection.group_quality_inspection_user'))]"/>
    </record>
    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_sf_quality_inspection"/>
    </record>
</odoo>
