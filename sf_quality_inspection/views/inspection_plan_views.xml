<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_inspection_plan_list" model="ir.ui.view">
        <field name="name">sf.quality.inspection.inspection.plan.list</field>
        <field name="model">sf.quality.inspection.inspection.plan</field>
        <field name="arch" type="xml">
            <list string="Inspection.Plan">
                <field name="name"/>
                <field name="product_tmpl_id"/>
                <field name="frequency"/>
                <field name="active"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_inspection_plan_form" model="ir.ui.view">
        <field name="name">sf.quality.inspection.inspection.plan.form</field>
        <field name="model">sf.quality.inspection.inspection.plan</field>
        <field name="arch" type="xml">
            <form string="Inspection.Plan">
                <header>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" placeholder="Name"/></h1></div>
                    <group><group>
                            <field name="name"/>
                            <field name="product_tmpl_id"/>
                            <field name="frequency"/>
                            <field name="active"/>
                    </group>
                    <group>
                        <field name="currency_id" invisible="1"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_inspection_plan" model="ir.actions.act_window">
        <field name="name">Inspection.Plan</field>
        <field name="res_model">sf.quality.inspection.inspection.plan</field>
        <field name="view_mode">kanban,list,form</field>
    </record>

    <record id="view_sf_quality_inspection_boost_kanban" model="ir.ui.view">
        <field name="name">sf_quality_inspection.boost.kanban</field>
        <field name="model">sf.quality.inspection.inspection.plan</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" t-att-color="state">
                <field name="name"/>
                <field name="state"/>
                <field name="user_id"/>

                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_card oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title">
                                    <field name="name"/></strong>
                                <div class="o_kanban_record_subtitle">
                                    <field name="user_id" widget="many2one_avatar_user"/>
                                    <field name="create_date"/></div>
                            </div>
                            <div class="oe_kanban_bottom_right">
                                <field name="state" widget="badge"
                                       t-attf-options="{'classes_map': {'draft': 'info', 'done': 'success', 'cancelled': 'danger'}, 'domain': []}"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_sf_quality_inspection_boost_search" model="ir.ui.view">
        <field name="name">sf_quality_inspection.boost.search</field>
        <field name="model">sf.quality.inspection.inspection.plan</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
<separator/>
                <filter string="My records" name="my_records" domain="[('user_id', '=', uid)]"/>
                <filter string="To Do" name="todo" domain="[('state', 'not in', ('done', 'cancelled', 'closed'))]"/>
                <group expand="0" string="Group By"><filter string="Status" name="gb_state" context="{'group_by': 'state'}"/></group>
            </search>
        </field>
    </record>

    <record id="wave_final_sf_quality_inspection" model="ir.actions.server">
        <field name="name">Refresh Business Data</field>
        <field name="model_id" ref="model_sf_quality_inspection_inspection_plan"/>
        <field name="binding_model_id" ref="model_sf_quality_inspection_inspection_plan"/>
        <field name="state">code</field>
        <field name="code">records.action_refresh_business()</field>
    </record>
</odoo>
