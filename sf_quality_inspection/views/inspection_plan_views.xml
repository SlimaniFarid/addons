<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_inspection_plan_list" model="ir.ui.view">
        <field name="name">sf.quality.inspection.inspection.plan.list</field>
        <field name="model">sf.quality.inspection.inspection.plan</field>
        <field name="arch" type="xml">
            <list string="Inspection.Plan">
                <field name="name"/>
                <field name="product_tmpl_id"/>
                <field name="frequency"/>
                <field name="active"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_inspection_plan_form" model="ir.ui.view">
        <field name="name">sf.quality.inspection.inspection.plan.form</field>
        <field name="model">sf.quality.inspection.inspection.plan</field>
        <field name="arch" type="xml">
            <form string="Inspection.Plan">
                <header>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" placeholder="Name"/></h1></div>
                    <group><group>
                            <field name="name"/>
                            <field name="product_tmpl_id"/>
                            <field name="frequency"/>
                            <field name="active"/>
                    </group>
                    <group>
                        <field name="currency_id" invisible="1"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_inspection_plan" model="ir.actions.act_window">
        <field name="name">Inspection.Plan</field>
        <field name="res_model">sf.quality.inspection.inspection.plan</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
