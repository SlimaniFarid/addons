<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_quality_inspection_list" model="ir.ui.view">
        <field name="name">sf.quality.inspection.quality.inspection.list</field>
        <field name="model">sf.quality.inspection.quality.inspection</field>
        <field name="arch" type="xml">
            <list string="Quality.Inspection">
                <field name="plan_id"/>
                <field name="picking_id"/>
                <field name="result"/>
                <field name="inspector_id"/>
                <field name="notes"/>
                <field name="photo_ids"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_quality_inspection_form" model="ir.ui.view">
        <field name="name">sf.quality.inspection.quality.inspection.form</field>
        <field name="model">sf.quality.inspection.quality.inspection</field>
        <field name="arch" type="xml">
            <form string="Quality.Inspection">
                <header>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" placeholder="Name"/></h1></div>
                    <group><group>
                            <field name="plan_id"/>
                            <field name="picking_id"/>
                            <field name="result"/>
                            <field name="inspector_id"/>
                            <field name="notes"/>
                            <field name="photo_ids"/>
                    </group>
                    <group>
                        <field name="currency_id" invisible="1"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_quality_inspection" model="ir.actions.act_window">
        <field name="name">Quality.Inspection</field>
        <field name="res_model">sf.quality.inspection.quality.inspection</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
