<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_vendor_sla_monitor" model="ir.module.category">
        <field name="name">Vendor SLA Monitoring</field>
        <field name="sequence">64</field>
    </record>
    <record id="group_vendor_sla_monitor_user" model="res.groups">
        <field name="name">Vendor SLA Monitoring User</field>
        <field name="category_id" ref="module_category_vendor_sla_monitor"/>

    </record>
    <record id="group_vendor_sla_monitor_manager" model="res.groups">
        <field name="name">Vendor SLA Monitoring Manager</field>
        <field name="category_id" ref="module_category_vendor_sla_monitor"/>
        <field name="implied_ids" eval="[(4, ref('group_vendor_sla_monitor_user'))]"/>
    </record>
    <record id="rule_vendor_sla_monitor_sf_vendor_sla" model="ir.rule">
        <field name="name">Vendor SLA: multi-company</field>
        <field name="model_id" ref="model_sf_vendor_sla"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
