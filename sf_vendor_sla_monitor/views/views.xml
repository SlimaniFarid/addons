<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_vendor_sla" model="ir.actions.act_window">
        <field name="name">Vendor SLA Monitoring</field>
        <field name="res_model">sf.vendor.sla</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
    <record id="view_sf_vendor_sla_form" model="ir.ui.view">
        <field name="name">sf.vendor.sla.form</field>
        <field name="model">sf.vendor.sla</field>
        <field name="arch" type="xml">
            <form string="Vendor SLA Monitoring">
                <header>
                    <button name="action_breached" type="object" string="Breached"
                            class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="active,breached,suspended"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="vendor_id"/>
                            <field name="service"/>
                            <field name="response_target_h"/>
                            <field name="resolution_target_h"/>
                            <field name="last_breach_date"/>
                            <field name="breach_count"/>
                            <field name="notes"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_vendor_sla_list" model="ir.ui.view">
        <field name="name">sf.vendor.sla.list</field>
        <field name="model">sf.vendor.sla</field>
        <field name="arch" type="xml">
            <list string="Vendor SLA Monitoring" sample="1">
                <field name="vendor_id"/>
                <field name="service"/>
                <field name="response_target_h"/>
                <field name="resolution_target_h"/>
                <field name="last_breach_date"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state in ('submitted','approved')"/>
            </list>
        </field>
    </record>
    <record id="view_sf_vendor_sla_kanban" model="ir.ui.view">
        <field name="name">sf.vendor.sla.kanban</field>
        <field name="model">sf.vendor.sla</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_view" group_by="state">
                <field name="name"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <menuitem id="menu_sf_vendor_sla_root" name="Vendor SLA Monitoring" sequence="14"
              web_icon="sf_vendor_sla_monitor,static/description/icon.png"/>
    <menuitem id="menu_sf_vendor_sla_main" name="Records"
              parent="menu_sf_vendor_sla_root" action="action_sf_vendor_sla" sequence="10"/>
</odoo>
