<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_customer_care_qa_scorecard2" model="ir.module.category">
        <field name="name">QA Scorecard</field>
        <field name="sequence">671</field>
    </record>
    <record id="group_customer_care_qa_scorecard2_user" model="res.groups">
        <field name="name">QA Scorecard User</field>
        <field name="category_id" ref="module_category_customer_care_qa_scorecard2"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>

    </record>
    <record id="group_customer_care_qa_scorecard2_manager" model="res.groups">
        <field name="name">QA Scorecard Manager</field>
        <field name="category_id" ref="module_category_customer_care_qa_scorecard2"/>
        <field name="implied_ids" eval="[(4, ref('group_customer_care_qa_scorecard2_user'))]"/>
    </record>
    <record id="rule_customer_care_qa_scorecard2_sf_customer_care_qa_scorecard2" model="ir.rule">
        <field name="name">QA Scorecard: multi-company</field>
        <field name="model_id" ref="model_sf_customer_care_qa_scorecard2"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_customer_care_qa_scorecard2"/>
    </record>
</odoo>
