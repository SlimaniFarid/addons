<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_sf_field_dispatch_board" model="ir.module.category">
        <field name="name">Field Dispatch Board</field>
        <field name="description">Field Dispatch Board</field>
        <field name="sequence">10</field>
    </record>
    <record id="group_field_dispatch_board_user" model="res.groups">
        <field name="name">Field Dispatch Board / User</field>
        <field name="category_id" ref="module_category_sf_field_dispatch_board"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_field_dispatch_board_manager" model="res.groups">
        <field name="name">Field Dispatch Board / Manager</field>
        <field name="category_id" ref="module_category_sf_field_dispatch_board"/>
        <field name="implied_ids" eval="[(4, ref('sf_field_dispatch_board.group_field_dispatch_board_user'))]"/>
    </record>
    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_sf_field_dispatch_board"/>
    </record>
</odoo>
