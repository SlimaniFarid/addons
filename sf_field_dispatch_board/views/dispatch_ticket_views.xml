<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dispatch_ticket_list" model="ir.ui.view">
        <field name="name">sf.field.dispatch.board.dispatch.ticket.list</field>
        <field name="model">sf.field.dispatch.board.dispatch.ticket</field>
        <field name="arch" type="xml">
            <list string="Dispatch.Ticket">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="technician_id"/>
                <field name="priority"/>
                <field name="scheduled_date"/>
                <field name="state"/>
                <field name="state" widget="badge"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_dispatch_ticket_form" model="ir.ui.view">
        <field name="name">sf.field.dispatch.board.dispatch.ticket.form</field>
        <field name="model">sf.field.dispatch.board.dispatch.ticket</field>
        <field name="arch" type="xml">
            <form string="Dispatch.Ticket">
                <header>
                <field name="state" widget="badge"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" placeholder="Name"/></h1></div>
                    <group><group>
                            <field name="name"/>
                            <field name="partner_id"/>
                            <field name="technician_id"/>
                            <field name="priority"/>
                            <field name="scheduled_date"/>
                            <field name="state"/>
                    </group>
                    <group>
                        <field name="currency_id" invisible="1"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_dispatch_ticket" model="ir.actions.act_window">
        <field name="name">Dispatch.Ticket</field>
        <field name="res_model">sf.field.dispatch.board.dispatch.ticket</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
