<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_sales_coaching_dashboard" model="ir.module.category">
        <field name="name">Sales Coaching Dashboard</field>
        <field name="sequence">699</field>
    </record>
    <record id="group_sales_coaching_dashboard_user" model="res.groups">
        <field name="name">Sales Coaching Dashboard User</field>
        <field name="category_id" ref="module_category_sales_coaching_dashboard"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>

    </record>
    <record id="group_sales_coaching_dashboard_manager" model="res.groups">
        <field name="name">Sales Coaching Dashboard Manager</field>
        <field name="category_id" ref="module_category_sales_coaching_dashboard"/>
        <field name="implied_ids" eval="[(4, ref('group_sales_coaching_dashboard_user'))]"/>
    </record>
    <record id="rule_sales_coaching_dashboard_sf_sales_coaching_dashboard" model="ir.rule">
        <field name="name">Sales Coaching Dashboard: multi-company</field>
        <field name="model_id" ref="model_sf_sales_coaching_dashboard"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
