<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_covenant" model="ir.actions.act_window">
        <field name="name">Financial Covenant Monitor</field>
        <field name="res_model">sf.covenant</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
    <record id="view_sf_covenant_form" model="ir.ui.view">
        <field name="name">sf.covenant.form</field>
        <field name="model">sf.covenant</field>
        <field name="arch" type="xml">
            <form string="Financial Covenant Monitor">
                <header>
                    <button name="action_compliant" type="object" string="Compliant"
                            class="btn-primary"/>
                    <button name="action_breached" type="object" string="Breached"
                            class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="active,compliant,breached,waived"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="lender"/>
                            <field name="covenant_type"/>
                            <field name="threshold"/>
                            <field name="actual_value"/>
                            <field name="test_date"/>
                            <field name="notes"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_covenant_list" model="ir.ui.view">
        <field name="name">sf.covenant.list</field>
        <field name="model">sf.covenant</field>
        <field name="arch" type="xml">
            <list string="Financial Covenant Monitor" sample="1">
                <field name="lender"/>
                <field name="covenant_type"/>
                <field name="threshold"/>
                <field name="actual_value"/>
                <field name="test_date"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state in ('submitted','approved')"/>
            </list>
        </field>
    </record>
    <record id="view_sf_covenant_kanban" model="ir.ui.view">
        <field name="name">sf.covenant.kanban</field>
        <field name="model">sf.covenant</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_view" group_by="state">
                <field name="name"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <menuitem id="menu_sf_covenant_root" name="Financial Covenant Monitor" sequence="8"
              web_icon="sf_financial_covenant_monitor,static/description/icon.png"/>
    <menuitem id="menu_sf_covenant_main" name="Records"
              parent="menu_sf_covenant_root" action="action_sf_covenant" sequence="10"/>
</odoo>
