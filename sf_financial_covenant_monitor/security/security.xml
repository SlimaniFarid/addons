<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_financial_covenant_monitor" model="ir.module.category">
        <field name="name">Financial Covenant Monitor</field>
        <field name="sequence">57</field>
    </record>
    <record id="group_financial_covenant_monitor_user" model="res.groups">
        <field name="name">Financial Covenant Monitor User</field>
        <field name="category_id" ref="module_category_financial_covenant_monitor"/>

    </record>
    <record id="group_financial_covenant_monitor_manager" model="res.groups">
        <field name="name">Financial Covenant Monitor Manager</field>
        <field name="category_id" ref="module_category_financial_covenant_monitor"/>
        <field name="implied_ids" eval="[(4, ref('group_financial_covenant_monitor_user'))]"/>
    </record>
    <record id="rule_financial_covenant_monitor_sf_covenant" model="ir.rule">
        <field name="name">Covenant: multi-company</field>
        <field name="model_id" ref="model_sf_covenant"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_financial_covenant_monitor"/>
    </record>
</odoo>
