<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_internal_mobility" model="ir.module.category">
        <field name="name">Internal Job Postings &amp; Mobility</field>
        <field name="sequence">5</field>
    </record>
    <record id="group_internal_mobility_user" model="res.groups">
        <field name="name">Internal Job Postings &amp; Mobility User</field>
        <field name="category_id" ref="module_category_internal_mobility"/>

    </record>
    <record id="group_internal_mobility_manager" model="res.groups">
        <field name="name">Internal Job Postings &amp; Mobility Manager</field>
        <field name="category_id" ref="module_category_internal_mobility"/>
        <field name="implied_ids" eval="[(4, ref('group_internal_mobility_user'))]"/>
    </record>
    <record id="rule_internal_mobility_sf_internal_posting" model="ir.rule">
        <field name="name">Internal Job Posting: multi-company</field>
        <field name="model_id" ref="model_sf_internal_posting"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_internal_mobility"/>
    </record>
</odoo>
