<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_production_order_sequencing" model="ir.actions.act_window">
        <field name="name">Production Order Sequencing</field>
        <field name="res_model">sf.production_order_sequencing</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
    <record id="view_sf_production_order_sequencing_form" model="ir.ui.view">
        <field name="name">sf.production_order_sequencing.form</field>
        <field name="model">sf.production_order_sequencing</field>
        <field name="arch" type="xml">
            <form string="Production Order Sequencing">
                <header>
                    <button name="action_submitted" type="object" string="Submitted"
                            class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="production_id"/>
                            <field name="sequence_no"/>
                            <field name="priority_score"/>
                            <field name="changeover_minutes"/>
                            <field name="due_date"/>
                            <field name="optimization_note"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_production_order_sequencing_list" model="ir.ui.view">
        <field name="name">sf.production_order_sequencing.list</field>
        <field name="model">sf.production_order_sequencing</field>
        <field name="arch" type="xml">
            <list string="Production Order Sequencing" sample="1">
                <field name="production_id"/>
                <field name="sequence_no"/>
                <field name="priority_score"/>
                <field name="changeover_minutes"/>
                <field name="due_date"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state in ('submitted','approved')"/>
            </list>
        </field>
    </record>
    <record id="view_sf_production_order_sequencing_kanban" model="ir.ui.view">
        <field name="name">sf.production_order_sequencing.kanban</field>
        <field name="model">sf.production_order_sequencing</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_view" group_by="state">
                <field name="name"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <menuitem id="menu_sf_production_order_sequencing_root" name="Production Order Sequencing" sequence="4"
              web_icon="sf_production_order_sequencing,static/description/icon.png"/>
    <menuitem id="menu_sf_production_order_sequencing_main" name="Records"
              parent="menu_sf_production_order_sequencing_root" action="action_sf_production_order_sequencing" sequence="10"/>

    <record id="wave_final_sf_production_order_sequencing" model="ir.actions.server">
        <field name="name">Refresh Business Data</field>
        <field name="model_id" ref="model_sf_production_order_sequencing"/>
        <field name="binding_model_id" ref="model_sf_production_order_sequencing"/>
        <field name="state">code</field>
        <field name="code">records.action_refresh_business()</field>
    </record>
</odoo>
