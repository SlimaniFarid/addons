<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_production_order_sequencing" model="ir.module.category">
        <field name="name">Production Order Sequencing</field>
        <field name="sequence">467</field>
    </record>
    <record id="group_production_order_sequencing_user" model="res.groups">
        <field name="name">Production Order Sequencing User</field>
        <field name="category_id" ref="module_category_production_order_sequencing"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>

    </record>
    <record id="group_production_order_sequencing_manager" model="res.groups">
        <field name="name">Production Order Sequencing Manager</field>
        <field name="category_id" ref="module_category_production_order_sequencing"/>
        <field name="implied_ids" eval="[(4, ref('group_production_order_sequencing_user'))]"/>
    </record>
    <record id="rule_production_order_sequencing_sf_production_order_sequencing" model="ir.rule">
        <field name="name">Production Order Sequencing: multi-company</field>
        <field name="model_id" ref="model_sf_production_order_sequencing"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
