<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_customer_payment_behavior" model="ir.actions.act_window">
        <field name="name">Customer Payment Behavior Analysis</field>
        <field name="res_model">sf.customer_payment_behavior</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
    <record id="view_sf_customer_payment_behavior_form" model="ir.ui.view">
        <field name="name">sf.customer_payment_behavior.form</field>
        <field name="model">sf.customer_payment_behavior</field>
        <field name="arch" type="xml">
            <form string="Customer Payment Behavior Analysis">
                <header>
                    <button name="action_submitted" type="object" string="Submitted"
                            class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="avg_days_to_pay"/>
                            <field name="trend"/>
                            <field name="risk_score"/>
                            <field name="credit_action"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_customer_payment_behavior_list" model="ir.ui.view">
        <field name="name">sf.customer_payment_behavior.list</field>
        <field name="model">sf.customer_payment_behavior</field>
        <field name="arch" type="xml">
            <list string="Customer Payment Behavior Analysis" sample="1">
                <field name="partner_id"/>
                <field name="avg_days_to_pay"/>
                <field name="trend"/>
                <field name="risk_score"/>
                <field name="credit_action"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state in ('submitted','approved')"/>
            </list>
        </field>
    </record>
    <record id="view_sf_customer_payment_behavior_kanban" model="ir.ui.view">
        <field name="name">sf.customer_payment_behavior.kanban</field>
        <field name="model">sf.customer_payment_behavior</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_view" group_by="state">
                <field name="name"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <menuitem id="menu_sf_customer_payment_behavior_root" name="Customer Payment Behavior Analysis" sequence="12"
              web_icon="sf_customer_payment_behavior,static/description/icon.png"/>
    <menuitem id="menu_sf_customer_payment_behavior_main" name="Records"
              parent="menu_sf_customer_payment_behavior_root" action="action_sf_customer_payment_behavior" sequence="10"/>

    <record id="wave_final_sf_customer_payment_behavior" model="ir.actions.server">
        <field name="name">Refresh Business Data</field>
        <field name="model_id" ref="model_sf_customer_payment_behavior"/>
        <field name="binding_model_id" ref="model_sf_customer_payment_behavior"/>
        <field name="state">code</field>
        <field name="code">records.action_refresh_business()</field>
    </record>
</odoo>
