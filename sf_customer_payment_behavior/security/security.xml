<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_customer_payment_behavior" model="ir.module.category">
        <field name="name">Customer Payment Behavior Analysis</field>
        <field name="sequence">189</field>
    </record>
    <record id="group_customer_payment_behavior_user" model="res.groups">
        <field name="name">Customer Payment Behavior Analysis User</field>
        <field name="category_id" ref="module_category_customer_payment_behavior"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>

    </record>
    <record id="group_customer_payment_behavior_manager" model="res.groups">
        <field name="name">Customer Payment Behavior Analysis Manager</field>
        <field name="category_id" ref="module_category_customer_payment_behavior"/>
        <field name="implied_ids" eval="[(4, ref('group_customer_payment_behavior_user'))]"/>
    </record>
    <record id="rule_customer_payment_behavior_sf_customer_payment_behavior" model="ir.rule">
        <field name="name">Customer Payment Behavior Analysis: multi-company</field>
        <field name="model_id" ref="model_sf_customer_payment_behavior"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_customer_payment_behavior"/>
    </record>
</odoo>
