<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sf_restaurant_zone_view_list" model="ir.ui.view">
        <field name="name">sf.restaurant.zone.list</field>
        <field name="model">sf.restaurant.zone</field>
        <field name="arch" type="xml">
            <list string="Zones">
                <field name="name"/>
                <field name="table_ids" string="Tables"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="sf_restaurant_zone_view_form" model="ir.ui.view">
        <field name="name">sf.restaurant.zone.form</field>
        <field name="model">sf.restaurant.zone</field>
        <field name="arch" type="xml">
            <form string="Zone">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Tables">
                            <field name="table_ids">
                                <list string="Tables">
                                    <field name="name"/>
                                    <field name="seats"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="sf_restaurant_zone_view_search" model="ir.ui.view">
        <field name="name">sf.restaurant.zone.search</field>
        <field name="model">sf.restaurant.zone</field>
        <field name="arch" type="xml">
            <search string="Zones">
                <field name="name"/>
            </search>
        </field>
    </record>

    <record id="action_sf_restaurant_zone" model="ir.actions.act_window">
        <field name="name">Zones</field>
        <field name="res_model">sf.restaurant.zone</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="sf_restaurant_zone_view_search"/>
    </record>
</odoo>