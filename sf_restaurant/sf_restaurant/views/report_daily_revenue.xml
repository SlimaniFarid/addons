<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_daily_revenue">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-set="company" t-value="o.company_id or res_company"/>
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>Daily Revenue Report</h2>
                        <table class="table table-sm">
                            <tr><th>Service</th><th>Revenue</th></tr>
                            <tr t-foreach="o.env['sf.restaurant.order'].search([('state', '=', 'closed'), ('order_date', '=', o.order_date)])" t-as="order">
                                <td><span t-field="order.service"/></td>
                                <td><span t-field="order.total" t-options='{"widget": "monetary", "display_currency": order.currency_id}'/></td>
                            </tr>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>