<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sf_restaurant_menu_item_view_list" model="ir.ui.view">
        <field name="name">sf.restaurant.menu.item.list</field>
        <field name="model">sf.restaurant.menu.item</field>
        <field name="arch" type="xml">
            <list string="Menu Items">
                <field name="name"/>
                <field name="category_id"/>
                <field name="price_unit" currency_field="currency_id"/>
                <field name="available_breakfast"/>
                <field name="available_lunch"/>
                <field name="available_dinner"/>
                <field name="active"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="sf_restaurant_menu_item_view_form" model="ir.ui.view">
        <field name="name">sf.restaurant.menu.item.form</field>
        <field name="model">sf.restaurant.menu.item</field>
        <field name="arch" type="xml">
            <form string="Menu Item">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="category_id"/>
                            <field name="product_id"/>
                            <field name="price_unit" currency_field="currency_id"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group>
                            <field name="available_breakfast"/>
                            <field name="available_lunch"/>
                            <field name="available_dinner"/>
                            <field name="active"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="sf_restaurant_menu_item_view_search" model="ir.ui.view">
        <field name="name">sf.restaurant.menu.item.search</field>
        <field name="model">sf.restaurant.menu.item</field>
        <field name="arch" type="xml">
            <search string="Menu Items">
                <field name="name"/>
                <field name="category_id"/>
                <group>
                    <filter name="group_menu_item_category" string="Category" context="{'group_by': 'category_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_sf_restaurant_menu_item" model="ir.actions.act_window">
        <field name="name">Menu Items</field>
        <field name="res_model">sf.restaurant.menu.item</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="sf_restaurant_menu_item_view_search"/>
    </record>
</odoo>