<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="module_category_sf_restaurant" model="ir.module.category">
            <field name="name">Restaurant</field>
            <field name="description">Restaurant, cafe and in-room dining management.</field>
            <field name="sequence">10</field>
        </record>

        <record id="group_sf_restaurant_user" model="res.groups">
            <field name="name">Restaurant / User</field>
            <field name="category_id" ref="module_category_sf_restaurant"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_sf_restaurant_manager" model="res.groups">
            <field name="name">Restaurant / Manager</field>
            <field name="category_id" ref="module_category_sf_restaurant"/>
            <field name="implied_ids" eval="[(4, ref('sf_restaurant.group_sf_restaurant_user'))]"/>
        </record>

        <record id="rule_sf_restaurant_table_company" model="ir.rule">
            <field name="name">Restaurant Table: user sees own company</field>
            <field name="model_id" ref="model_sf_restaurant_table"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('sf_restaurant.group_sf_restaurant_user'))]"/>
        </record>
        <record id="rule_sf_restaurant_table_manager_all" model="ir.rule">
            <field name="name">Restaurant Table: manager sees all companies</field>
            <field name="model_id" ref="model_sf_restaurant_table"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('sf_restaurant.group_sf_restaurant_manager'))]"/>
        </record>

