<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sf_restaurant_menu_category_view_list" model="ir.ui.view">
        <field name="name">sf.restaurant.menu.category.list</field>
        <field name="model">sf.restaurant.menu.category</field>
        <field name="arch" type="xml">
            <list string="Menu Categories">
                <field name="name"/>
                <field name="sequence"/>
                <field name="product_ids" string="Items"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="sf_restaurant_menu_category_view_form" model="ir.ui.view">
        <field name="name">sf.restaurant.menu.category.form</field>
        <field name="model">sf.restaurant.menu.category</field>
        <field name="arch" type="xml">
            <form string="Menu Category">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="sequence"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Menu Items">
                            <field name="product_ids">
                                <list string="Menu Items">
                                    <field name="name"/>
                                    <field name="price_unit" currency_field="currency_id"/>
                                    <field name="available_breakfast"/>
                                    <field name="available_lunch"/>
                                    <field name="available_dinner"/>
                                    <field name="active"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="sf_restaurant_menu_category_view_search" model="ir.ui.view">
        <field name="name">sf.restaurant.menu.category.search</field>
        <field name="model">sf.restaurant.menu.category</field>
        <field name="arch" type="xml">
            <search string="Menu Categories">
                <field name="name"/>
            </search>
        </field>
    </record>

    <record id="action_sf_restaurant_menu_category" model="ir.actions.act_window">
        <field name="name">Menu Categories</field>
        <field name="res_model">sf.restaurant.menu.category</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="sf_restaurant_menu_category_view_search"/>
    </record>
</odoo>