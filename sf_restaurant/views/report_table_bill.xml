<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_table_bill">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-set="company" t-value="o.company_id or res_company"/>
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>Table Bill</h2>
                        <table class="table table-sm">
                            <tr><th>Order</th><td><span t-field="o.name"/></td></tr>
                            <tr><th>Table</th><td><span t-field="o.table_id.name"/></td></tr>
                            <tr><th>Service</th><td><span t-field="o.service"/></td></tr>
                            <tr><th>Date</th><td><span t-field="o.order_date"/></td></tr>
                        </table>
                        <h3>Items</h3>
                        <table class="table table-sm">
                            <tr><th>Item</th><th>Qty</th><th>Price</th><th>Subtotal</th></tr>
                            <tr t-foreach="o.line_ids" t-as="line">
                                <td><span t-field="line.item_id.name"/></td>
                                <td><span t-field="line.qty"/></td>
                                <td><span t-field="line.price_unit" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/></td>
                                <td><span t-field="line.subtotal" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/></td>
                            </tr>
                        </table>
                        <h3>Total: <span t-field="o.total" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/></h3>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>