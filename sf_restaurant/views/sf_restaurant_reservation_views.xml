<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sf_restaurant_reservation_view_list" model="ir.ui.view">
        <field name="name">sf.restaurant.reservation.list</field>
        <field name="model">sf.restaurant.reservation</field>
        <field name="arch" type="xml">
            <list string="Reservations">
                <field name="name"/>
                <field name="contact_name"/>
                <field name="reservation_date"/>
                <field name="start_time"/>
                <field name="guests"/>
                <field name="table_ids" string="Tables"/>
                <field name="state" widget="badge"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="sf_restaurant_reservation_view_form" model="ir.ui.view">
        <field name="name">sf.restaurant.reservation.form</field>
        <field name="model">sf.restaurant.reservation</field>
        <field name="arch" type="xml">
            <form string="Reservation">
                <header>
                    <button name="action_confirm" type="object" string="Confirm" invisible="[('state', 'not in', ('draft',))]" class="btn-primary"/>
                    <button name="action_seat" type="object" string="Seat Guests" invisible="[('state', 'not in', ('confirmed',))]"/>
                    <button name="action_done" type="object" string="Mark As Done" invisible="[('state', 'not in', ('confirmed', 'seated'))]"/>
                    <button name="action_cancel" type="object" string="Cancel Reservation" invisible="[('state', 'not in', ('draft', 'confirmed'))]"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,seated,done,cancelled"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="contact_name"/>
                            <field name="phone"/>
                            <field name="notes"/>
                        </group>
                        <group>
                            <field name="reservation_date"/>
                            <field name="start_time"/>
                            <field name="guests"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group string="Tables">
                        <field name="table_ids"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="sf_restaurant_reservation_view_calendar" model="ir.ui.view">
        <field name="name">sf.restaurant.reservation.calendar</field>
        <field name="model">sf.restaurant.reservation</field>
        <field name="arch" type="xml">
            <calendar date_start="reservation_date" string="Reservations" color="state">
                <field name="contact_name"/>
            </calendar>
        </field>
    </record>

    <record id="sf_restaurant_reservation_view_search" model="ir.ui.view">
        <field name="name">sf.restaurant.reservation.search</field>
        <field name="model">sf.restaurant.reservation</field>
        <field name="arch" type="xml">
            <search string="Reservations">
                <field name="name"/>
                <field name="contact_name"/>
                <field name="partner_id"/>
                <filter name="reservation_confirmed" string="Confirmed" domain="[('state', '=', 'confirmed')]"/>
                <filter name="reservation_today" string="Today" domain="[('reservation_date', '=', context_today())]"/>
                <group>
                    <filter name="group_reservation_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_reservation_date" string="Date" context="{'group_by': 'reservation_date'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_sf_restaurant_reservation" model="ir.actions.act_window">
        <field name="name">Reservations</field>
        <field name="res_model">sf.restaurant.reservation</field>
        <field name="view_mode">calendar,list,form</field>
        <field name="search_view_id" ref="sf_restaurant_reservation_view_search"/>
    </record>
</odoo>