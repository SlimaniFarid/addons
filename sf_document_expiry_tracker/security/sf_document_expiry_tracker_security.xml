<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_sf_document_expiry_tracker" model="ir.module.category">
        <field name="name">Employee Document Expiry Tracker</field>
        <field name="description">Employee Document Expiry Tracker</field>
        <field name="sequence">10</field>
    </record>
    <record id="group_document_expiry_tracker_user" model="res.groups">
        <field name="name">Employee Document Expiry Tracker / User</field>
        <field name="category_id" ref="module_category_sf_document_expiry_tracker"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_document_expiry_tracker_manager" model="res.groups">
        <field name="name">Employee Document Expiry Tracker / Manager</field>
        <field name="category_id" ref="module_category_sf_document_expiry_tracker"/>
        <field name="implied_ids" eval="[(4, ref('sf_document_expiry_tracker.group_document_expiry_tracker_user'))]"/>
    </record>
    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_sf_document_expiry_tracker"/>
    </record>
</odoo>
