<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_employee_document_list" model="ir.ui.view">
        <field name="name">sf.document.expiry.tracker.employee.document.list</field>
        <field name="model">sf.document.expiry.tracker.employee.document</field>
        <field name="arch" type="xml">
            <list string="Employee.Document">
                <field name="employee_id"/>
                <field name="doc_type"/>
                <field name="expiry_date"/>
                <field name="reminder_days"/>
                <field name="attachment_id"/>
                <field name="state"/>
                <field name="state" widget="badge"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_employee_document_form" model="ir.ui.view">
        <field name="name">sf.document.expiry.tracker.employee.document.form</field>
        <field name="model">sf.document.expiry.tracker.employee.document</field>
        <field name="arch" type="xml">
            <form string="Employee.Document">
                <header>
                <field name="state" widget="badge"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" placeholder="Name"/></h1></div>
                    <group><group>
                            <field name="employee_id"/>
                            <field name="doc_type"/>
                            <field name="expiry_date"/>
                            <field name="reminder_days"/>
                            <field name="attachment_id"/>
                            <field name="state"/>
                    </group>
                    <group>
                        <field name="currency_id" invisible="1"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_employee_document" model="ir.actions.act_window">
        <field name="name">Employee.Document</field>
        <field name="res_model">sf.document.expiry.tracker.employee.document</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="wave_final_sf_document_expiry_tracker" model="ir.actions.server">
        <field name="name">Refresh Business Data</field>
        <field name="model_id" ref="model_sf_document_expiry_tracker_employee_document"/>
        <field name="binding_model_id" ref="model_sf_document_expiry_tracker_employee_document"/>
        <field name="state">code</field>
        <field name="code">records.action_refresh_business()</field>
    </record>
</odoo>
