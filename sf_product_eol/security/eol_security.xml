<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_sf_eol" model="ir.module.category">
        <field name="name">Product EOL</field>
        <field name="sequence">78</field>
    </record>
    <record id="group_sf_eol_user" model="res.groups">
        <field name="name">Product EOL User</field>
        <field name="category_id" ref="module_category_sf_eol"/>
        <field name="implied_ids" eval="[(4, ref('stock.group_stock_user'))]"/>
    </record>
    <record id="group_sf_eol_manager" model="res.groups">
        <field name="name">Product EOL Manager</field>
        <field name="category_id" ref="module_category_sf_eol"/>
        <field name="implied_ids" eval="[(4, ref('group_sf_eol_user'))]"/>
    </record>
    <record id="rule_sf_eol_company" model="ir.rule">
        <field name="name">Product EOL: multi-company</field>
        <field name="model_id" ref="model_sf_product_eol"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_sf_eol"/>
    </record>
</odoo>
