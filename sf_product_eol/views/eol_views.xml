<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_product_eol" model="ir.actions.act_window">
        <field name="name">Product EOL Records</field>
        <field name="res_model">sf.product.eol</field>
        <field name="view_mode">kanban,list,form,kanban</field>
    </record>
    <record id="view_sf_product_eol_form" model="ir.ui.view">
        <field name="name">sf.product.eol.form</field>
        <field name="model">sf.product.eol</field>
        <field name="arch" type="xml">
            <form string="Product EOL">
                <header>
                    <button name="action_phaseout" type="object"
                            string="Start Phase-Out" class="btn-primary"
                            invisible="state != 'announced'"/>
                    <button name="action_discontinue" type="object"
                            string="Discontinue (Block Sales)"
                            class="btn-danger" invisible="state != 'phaseout'"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state == 'discontinued'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="announced,phaseout,discontinued"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="product_id" readonly="state != 'announced'"/>
                            <field name="announcement_date"/>
                            <field name="eol_date"/>
                            <field name="last_time_buy_date"/>
                        </group>
                        <group>
                            <field name="replacement_product_id"/>
                            <field name="remaining_stock" readonly="1"/>
                            <field name="open_sale_orders" readonly="1"/>
                            <field name="open_order_lines" readonly="1"/>
                            <field name="discontinued_on" readonly="1"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group string="Customer Communication Plan">
                        <field name="communication_plan"/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_product_eol_list" model="ir.ui.view">
        <field name="name">sf.product.eol.list</field>
        <field name="model">sf.product.eol</field>
        <field name="arch" type="xml">
            <list string="Product EOL" sample="1">
                <field name="name"/>
                <field name="product_id"/>
                <field name="eol_date"/>
                <field name="last_time_buy_date" optional="show"/>
                <field name="replacement_product_id"/>
                <field name="remaining_stock"/>
                <field name="open_sale_orders"/>
                <field name="state" widget="badge"
                       decoration-danger="state == 'discontinued'"
                       decoration-warning="state == 'phaseout'"/>
            </list>
        </field>
    </record>
    <menuitem id="menu_sf_eol_root" name="Product EOL" sequence="28"
              parent="stock.menu_stock_root"/>
    <menuitem id="menu_sf_eol_records" name="EOL Records"
              parent="menu_sf_eol_root" action="action_sf_product_eol"
              sequence="10"/>

    <record id="view_sf_product_eol_boost_kanban" model="ir.ui.view">
        <field name="name">sf_product_eol.boost.kanban</field>
        <field name="model">sf.product.eol</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" t-att-color="state">
                <field name="name"/>
                <field name="state"/>
                <field name="user_id"/>

                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_card oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title">
                                    <field name="name"/></strong>
                                <div class="o_kanban_record_subtitle">
                                    <field name="user_id" widget="many2one_avatar_user"/>
                                    <field name="create_date"/></div>
                            </div>
                            <div class="oe_kanban_bottom_right">
                                <field name="state" widget="badge"
                                       t-attf-options="{'classes_map': {'draft': 'info', 'done': 'success', 'cancelled': 'danger'}, 'domain': []}"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_sf_product_eol_boost_search" model="ir.ui.view">
        <field name="name">sf_product_eol.boost.search</field>
        <field name="model">sf.product.eol</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
<separator/>
                <filter string="My records" name="my_records" domain="[('user_id', '=', uid)]"/>
                <filter string="To Do" name="todo" domain="[('state', 'not in', ('done', 'cancelled', 'closed'))]"/>
                <group expand="0" string="Group By"><filter string="Status" name="gb_state" context="{'group_by': 'state'}"/></group>
            </search>
        </field>
    </record>
</odoo>
