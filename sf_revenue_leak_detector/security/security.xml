<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_revenue_leak_detector" model="ir.module.category">
        <field name="name">Revenue Leak Detector</field>
        <field name="sequence">176</field>
    </record>
    <record id="group_revenue_leak_detector_user" model="res.groups">
        <field name="name">Revenue Leak Detector User</field>
        <field name="category_id" ref="module_category_revenue_leak_detector"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>

    </record>
    <record id="group_revenue_leak_detector_manager" model="res.groups">
        <field name="name">Revenue Leak Detector Manager</field>
        <field name="category_id" ref="module_category_revenue_leak_detector"/>
        <field name="implied_ids" eval="[(4, ref('group_revenue_leak_detector_user'))]"/>
    </record>
    <record id="rule_revenue_leak_detector_sf_revenue_leak_detector" model="ir.rule">
        <field name="name">Revenue Leak Detector: multi-company</field>
        <field name="model_id" ref="model_sf_revenue_leak_detector"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
