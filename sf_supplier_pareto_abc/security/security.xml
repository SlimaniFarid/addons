<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_supplier_pareto_abc" model="ir.module.category">
        <field name="name">Supplier ABC Classification</field>
        <field name="sequence">286</field>
    </record>
    <record id="group_supplier_pareto_abc_user" model="res.groups">
        <field name="name">Supplier ABC Classification User</field>
        <field name="category_id" ref="module_category_supplier_pareto_abc"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>

    </record>
    <record id="group_supplier_pareto_abc_manager" model="res.groups">
        <field name="name">Supplier ABC Classification Manager</field>
        <field name="category_id" ref="module_category_supplier_pareto_abc"/>
        <field name="implied_ids" eval="[(4, ref('group_supplier_pareto_abc_user'))]"/>
    </record>
    <record id="rule_supplier_pareto_abc_sf_supplier_pareto_abc" model="ir.rule">
        <field name="name">Supplier ABC Classification: multi-company</field>
        <field name="model_id" ref="model_sf_supplier_pareto_abc"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
