<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_customer_pricing_requests" model="ir.module.category">
        <field name="name">Customer Pricing Request Log</field>
        <field name="sequence">35</field>
    </record>
    <record id="group_customer_pricing_requests_user" model="res.groups">
        <field name="name">Customer Pricing Request Log User</field>
        <field name="category_id" ref="module_category_customer_pricing_requests"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>

    </record>
    <record id="group_customer_pricing_requests_manager" model="res.groups">
        <field name="name">Customer Pricing Request Log Manager</field>
        <field name="category_id" ref="module_category_customer_pricing_requests"/>
        <field name="implied_ids" eval="[(4, ref('group_customer_pricing_requests_user'))]"/>
    </record>
    <record id="rule_customer_pricing_requests_sf_pricing_request" model="ir.rule">
        <field name="name">Pricing Request: multi-company</field>
        <field name="model_id" ref="model_sf_pricing_request"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
