<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_pricing_request" model="ir.actions.act_window">
        <field name="name">Customer Pricing Request Log</field>
        <field name="res_model">sf.pricing.request</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
    <record id="view_sf_pricing_request_form" model="ir.ui.view">
        <field name="name">sf.pricing.request.form</field>
        <field name="model">sf.pricing.request</field>
        <field name="arch" type="xml">
            <form string="Customer Pricing Request Log">
                <header>
                    <button name="action_quoted" type="object" string="Quoted"
                            class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="received,quoted,decided"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="product_id"/>
                            <field name="requested_qty"/>
                            <field name="quoted_price"/>
                            <field name="target_price"/>
                            <field name="response_hours"/>
                            <field name="outcome"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_pricing_request_list" model="ir.ui.view">
        <field name="name">sf.pricing.request.list</field>
        <field name="model">sf.pricing.request</field>
        <field name="arch" type="xml">
            <list string="Customer Pricing Request Log" sample="1">
                <field name="partner_id"/>
                <field name="product_id"/>
                <field name="requested_qty"/>
                <field name="quoted_price"/>
                <field name="target_price"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state in ('submitted','approved')"/>
            </list>
        </field>
    </record>
    <record id="view_sf_pricing_request_kanban" model="ir.ui.view">
        <field name="name">sf.pricing.request.kanban</field>
        <field name="model">sf.pricing.request</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_view" group_by="state">
                <field name="name"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <menuitem id="menu_sf_pricing_request_root" name="Customer Pricing Request Log" sequence="14"
              web_icon="sf_customer_pricing_requests,static/description/icon.png"/>
    <menuitem id="menu_sf_pricing_request_main" name="Records"
              parent="menu_sf_pricing_request_root" action="action_sf_pricing_request" sequence="10"/>
</odoo>
