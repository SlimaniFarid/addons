<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============ MPS ============ -->
    <record id="view_mps_tree" model="ir.ui.view">
        <field name="name">sf.mps.tree</field>
        <field name="model">sf.mps</field>
        <field name="arch" type="xml">
            <tree string="Master Production Schedules">
                <field name="name"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <record id="view_mps_form" model="ir.ui.view">
        <field name="name">sf.mps.form</field>
        <field name="model">sf.mps</field>
        <field name="arch" type="xml">
            <form string="Master Production Schedule">
                <header>
                    <button name="action_load_productions" type="object"
                            string="Load MOs" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_confirm" type="object"
                            string="Confirm" class="btn-success"
                            invisible="state != 'draft'"/>
                    <button name="action_close" type="object"
                            string="Close" invisible="state != 'confirmed'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="date_start"/>
                            <field name="date_end"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Plan Lines">
                            <field name="line_ids" readonly="state == 'confirmed'">
                                <tree string="Plan Lines" editable="bottom">
                                    <field name="workcenter_id"/>
                                    <field name="product_id"/>
                                    <field name="production_id"/>
                                    <field name="quantity"/>
                                    <field name="date_start"/>
                                    <field name="date_end"/>
                                    <field name="duration_hours"/>
                                    <field name="priority"/>
                                    <field name="state"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_mps_search" model="ir.ui.view">
        <field name="name">sf.mps.search</field>
        <field name="model">sf.mps</field>
        <field name="arch" type="xml">
            <search string="Master Production Schedules">
                <field name="name"/>
                <filter string="Draft" name="draft"
                        domain="[('state', '=', 'draft')]"/>
                <filter string="Confirmed" name="confirmed"
                        domain="[('state', '=', 'confirmed')]"/>
                <group expand="0" string="Group By">
                    <filter string="Status" name="state_group"
                            context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_mps" model="ir.actions.act_window">
        <field name="name">Master Production Schedules</field>
        <field name="res_model">sf.mps</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_mps_search"/>
    </record>

    <!-- ============ LINE GANTT ============ -->
    <record id="view_mps_line_gantt" model="ir.ui.view">
        <field name="name">sf.mps.line.gantt</field>
        <field name="model">sf.mps.line</field>
        <field name="arch" type="xml">
            <gantt string="Production Schedule" date_start="date_start"
                   date_stop="date_end" default_group_by="workcenter_id"
                   decoration-danger="priority == 'urgent'"
                   decoration-warning="priority == 'high'"
                   decoration-success="state == 'done'">
                <field name="product_id"/>
                <field name="priority"/>
                <field name="state"/>
            </gantt>
        </field>
    </record>

    <record id="action_mps_line_gantt" model="ir.actions.act_window">
        <field name="name">Scheduling (Gantt)</field>
        <field name="res_model">sf.mps.line</field>
        <field name="view_mode">gantt</field>
        <field name="view_id" ref="view_mps_line_gantt"/>
    </record>

    <!-- ============ LINE TREE / CHARGE ============ -->
    <record id="view_mps_line_tree" model="ir.ui.view">
        <field name="name">sf.mps.line.tree</field>
        <field name="model">sf.mps.line</field>
        <field name="arch" type="xml">
            <tree string="Plan Lines">
                <field name="mps_id"/>
                <field name="workcenter_id"/>
                <field name="product_id"/>
                <field name="production_id"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="duration_hours"/>
                <field name="priority"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <record id="action_mps_line_tree" model="ir.actions.act_window">
        <field name="name">All Plan Lines</field>
        <field name="res_model">sf.mps.line</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record id="view_mps_load_tree" model="ir.ui.view">
        <field name="name">sf.mps.load.tree</field>
        <field name="model">sf.mps.line</field>
        <field name="arch" type="xml">
            <tree string="Load by Work Center" default_group_by="workcenter_id">
                <field name="workcenter_id"/>
                <field name="product_id"/>
                <field name="date_start"/>
                <field name="duration_hours"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <record id="action_mps_load" model="ir.actions.act_window">
        <field name="name">Load by Work Center</field>
        <field name="res_model">sf.mps.line</field>
        <field name="view_mode">tree</field>
        <field name="view_id" ref="view_mps_load_tree"/>
    </record>

    <!-- ============ DASHBOARD ============ -->
    <record id="view_mps_dashboard_graph" model="ir.ui.view">
        <field name="name">sf.mps.line.dashboard.graph</field>
        <field name="model">sf.mps.line</field>
        <field name="arch" type="xml">
            <graph string="Lines by Work Center">
                <field name="workcenter_id"/>
                <field name="duration_hours" type="measure" string="Hours"/>
            </graph>
        </field>
    </record>

    <record id="view_mps_dashboard_pivot" model="ir.ui.view">
        <field name="name">sf.mps.line.dashboard.pivot</field>
        <field name="model">sf.mps.line</field>
        <field name="arch" type="xml">
            <pivot string="Lines by Work Center and Status">
                <field name="workcenter_id" type="row"/>
                <field name="state" type="col"/>
                <field name="duration_hours" type="measure" string="Hours"/>
            </pivot>
        </field>
    </record>

    <record id="action_mps_dashboard" model="ir.actions.act_window">
        <field name="name">Production Dashboard</field>
        <field name="res_model">sf.mps.line</field>
        <field name="view_mode">graph,pivot</field>
        <field name="view_ids" eval="[(5, 0), (0, 0, {'view_mode': 'graph', 'view_id': ref('view_mps_dashboard_graph')}), (0, 0, {'view_mode': 'pivot', 'view_id': ref('view_mps_dashboard_pivot')})]"/>
    </record>

    <!-- ============ WIZARD ============ -->
    <record id="view_mps_load_wizard" model="ir.ui.view">
        <field name="name">sf.mps.load.wizard.form</field>
        <field name="model">sf.mps.load.wizard</field>
        <field name="arch" type="xml">
            <form string="Load Manufacturing Orders">
                <group>
                    <field name="mps_id" readonly="1"/>
                    <field name="workcenter_id"/>
                    <field name="production_ids" widget="many2many_tags"/>
                </group>
                <footer>
                    <button name="action_load" type="object"
                            string="Load" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>