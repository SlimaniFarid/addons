<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="report_mps_master_plan" model="ir.actions.report">
        <field name="name">Master Production Plan</field>
        <field name="model">sf.mps</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">sf_production_planning.mps_master_plan_template</field>
        <field name="report_file">sf_production_planning.mps_master_plan_template</field>
        <field name="binding_model_id" ref="model_sf_mps"/>
        <field name="binding_type">report</field>
    </record>

    <template id="mps_master_plan_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>Master Production Plan</h2>
                        <table class="table table-sm">
                            <tr><td><strong>Plan</strong></td><td><t t-esc="o.name"/></td></tr>
                            <tr><td><strong>Period</strong></td><td><t t-esc="o.date_start"/> - <t t-esc="o.date_end"/></td></tr>
                            <tr><td><strong>Status</strong></td><td><t t-esc="o.state"/></td></tr>
                        </table>
                        <h4>Lines by work center (priority order)</h4>
                        <t t-set="workcenters" t-value="o.line_ids.mapped('workcenter_id').sorted()"/>
                        <t t-foreach="workcenters" t-as="wc">
                            <h5><t t-esc="wc.name"/></h5>
                            <table class="table table-sm">
                                <thead>
                                    <tr>
                                        <th>Product</th>
                                        <th class="text-right">Qty</th>
                                        <th>Start</th>
                                        <th>End</th>
                                        <th>Priority</th>
                                        <th class="text-right">Hours</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="o.line_ids.filtered(lambda l: l.workcenter_id == wc).sorted(key=lambda l: l.date_start)" t-as="line">
                                        <tr>
                                            <td><t t-esc="line.product_id.display_name"/></td>
                                            <td class="text-right"><t t-esc="line.quantity"/></td>
                                            <td><t t-esc="line.date_start"/></td>
                                            <td><t t-esc="line.date_end"/></td>
                                            <td><t t-esc="line.priority"/></td>
                                            <td class="text-right"><t t-esc="line.duration_hours"/></td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </t>
                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>