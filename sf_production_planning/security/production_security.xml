<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_production" model="ir.module.category">
        <field name="name">Production Planning</field>
        <field name="sequence">90</field>
    </record>

    <record id="group_production_user" model="res.groups">
        <field name="name">Production Planning User</field>
        <field name="category_id" ref="module_category_production"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_production_manager" model="res.groups">
        <field name="name">Production Planning Manager</field>
        <field name="category_id" ref="module_category_production"/>
        <field name="implied_ids" eval="[(4, ref('group_production_user'))]"/>
    </record>

    <record id="rule_mps_user_company" model="ir.rule">
        <field name="name">MPS: user sees own company</field>
        <field name="model_id" ref="model_sf_mps"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_production_user'))]"/>
    </record>

    <record id="rule_mps_line_user_company" model="ir.rule">
        <field name="name">MPS line: user sees own company</field>
        <field name="model_id" ref="model_sf_mps_line"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('mps_id.company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_production_user'))]"/>
    </record>

    <record id="rule_mps_manager_all" model="ir.rule">
        <field name="name">MPS: manager sees all companies</field>
        <field name="model_id" ref="model_sf_mps"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_production_manager'))]"/>
    </record>

    <record id="rule_mps_line_manager_all" model="ir.rule">
        <field name="name">MPS line: manager sees all companies</field>
        <field name="model_id" ref="model_sf_mps_line"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_production_manager'))]"/>
    </record>
</odoo>