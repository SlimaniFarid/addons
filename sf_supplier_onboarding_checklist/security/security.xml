<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_supplier_onboarding_checklist" model="ir.module.category">
        <field name="name">Supplier Onboarding Checklist</field>
        <field name="sequence">267</field>
    </record>
    <record id="group_supplier_onboarding_checklist_user" model="res.groups">
        <field name="name">Supplier Onboarding Checklist User</field>
        <field name="category_id" ref="module_category_supplier_onboarding_checklist"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>

    </record>
    <record id="group_supplier_onboarding_checklist_manager" model="res.groups">
        <field name="name">Supplier Onboarding Checklist Manager</field>
        <field name="category_id" ref="module_category_supplier_onboarding_checklist"/>
        <field name="implied_ids" eval="[(4, ref('group_supplier_onboarding_checklist_user'))]"/>
    </record>
    <record id="rule_supplier_onboarding_checklist_sf_supplier_onboarding_checklist" model="ir.rule">
        <field name="name">Supplier Onboarding Checklist: multi-company</field>
        <field name="model_id" ref="model_sf_supplier_onboarding_checklist"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
