<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_sf_bo" model="ir.module.category">
        <field name="name">Backorder Priority</field>
        <field name="sequence">77</field>
    </record>
    <record id="group_sf_bo_user" model="res.groups">
        <field name="name">Backorder Allocation User</field>
        <field name="category_id" ref="module_category_sf_bo"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
    </record>
    <record id="group_sf_bo_manager" model="res.groups">
        <field name="name">Backorder Allocation Manager</field>
        <field name="category_id" ref="module_category_sf_bo"/>
        <field name="implied_ids" eval="[(4, ref('group_sf_bo_user'))]"/>
    </record>
    <record id="rule_sf_bo_company" model="ir.rule">
        <field name="name">BO Allocation: multi-company</field>
        <field name="model_id" ref="model_sf_bo_allocation"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
