<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_bo_allocation" model="ir.actions.act_window">
        <field name="name">Allocation Runs</field>
        <field name="res_model">sf.bo.allocation</field>
        <field name="view_mode">kanban,list,form</field>
    </record>
    <record id="view_sf_bo_allocation_form" model="ir.ui.view">
        <field name="name">sf.bo.allocation.form</field>
        <field name="model">sf.bo.allocation</field>
        <field name="arch" type="xml">
            <form string="Backorder Allocation">
                <header>
                    <button name="action_compute" type="object"
                            string="Compute Allocation" class="btn-primary"
                            invisible="state == 'applied'"/>
                    <button name="action_apply" type="object"
                            string="Apply Reservations"
                            invisible="state != 'computed'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,computed,applied"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="product_id"/>
                            <field name="available_qty" readonly="1"/>
                            <field name="allocated_qty" readonly="1"/>
                        </group>
                        <group>
                            <field name="weight_customer"/>
                            <field name="weight_value"/>
                            <field name="weight_lateness"/>
                            <field name="company_id"
                                   groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <field name="line_ids" readonly="1">
                        <list create="0">
                            <field name="picking_id"/>
                            <field name="partner_id"/>
                            <field name="shortage_qty"/>
                            <field name="days_late"/>
                            <field name="order_value" optional="show"/>
                            <field name="priority_score"/>
                            <field name="allocated_qty"/>
                        </list>
                    </field>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_bo_allocation_list" model="ir.ui.view">
        <field name="name">sf.bo.allocation.list</field>
        <field name="model">sf.bo.allocation</field>
        <field name="arch" type="xml">
            <list string="Allocation Runs" sample="1">
                <field name="name"/>
                <field name="product_id"/>
                <field name="available_qty"/>
                <field name="allocated_qty"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'applied'"/>
            </list>
        </field>
    </record>
    <menuitem id="menu_sf_bo_root" name="Backorder Priority" sequence="27"
              parent="sale.sale_menu_root"/>
    <menuitem id="menu_sf_bo_runs" name="Allocation Runs"
              parent="menu_sf_bo_root" action="action_sf_bo_allocation"
              sequence="10"/>

    <record id="view_sf_backorder_priority_boost_kanban" model="ir.ui.view">
        <field name="name">sf_backorder_priority.boost.kanban</field>
        <field name="model">sf.bo.allocation</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" t-att-color="state">
                <field name="name"/>
                <field name="state"/>
                <field name="user_id"/>

                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_card oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title">
                                    <field name="name"/></strong>
                                <div class="o_kanban_record_subtitle">
                                    <field name="user_id" widget="many2one_avatar_user"/>
                                    <field name="create_date"/></div>
                            </div>
                            <div class="oe_kanban_bottom_right">
                                <field name="state" widget="badge"
                                       t-attf-options="{'classes_map': {'draft': 'info', 'done': 'success', 'cancelled': 'danger'}, 'domain': []}"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_sf_backorder_priority_boost_search" model="ir.ui.view">
        <field name="name">sf_backorder_priority.boost.search</field>
        <field name="model">sf.bo.allocation</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
<separator/>
                <filter string="My records" name="my_records" domain="[('user_id', '=', uid)]"/>
                <filter string="To Do" name="todo" domain="[('state', 'not in', ('done', 'cancelled', 'closed'))]"/>
                <group expand="0" string="Group By"><filter string="Status" name="gb_state" context="{'group_by': 'state'}"/></group>
            </search>
        </field>
    </record>
</odoo>
