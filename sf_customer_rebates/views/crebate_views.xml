<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_crebate_deal" model="ir.actions.act_window">
        <field name="name">Customer Rebate Deals</field>
        <field name="res_model">sf.customer.rebate.deal</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
    <record id="view_sf_crebate_deal_form" model="ir.ui.view">
        <field name="name">sf.customer.rebate.deal.form</field>
        <field name="model">sf.customer.rebate.deal</field>
        <field name="arch" type="xml">
            <form string="Customer Rebate Deal">
                <header>
                    <button name="action_activate" type="object"
                            string="Activate" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_compute_accrual" type="object"
                            string="Compute Accruals"
                            invisible="state != 'active'"/>
                    <button name="action_expire" type="object" string="Expire"
                            invisible="state != 'active'"/>
                    <button name="action_settle" type="object"
                            string="Settled" class="btn-success"
                            invisible="state != 'active'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,active,settled"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="partner_id"/>
                            <field name="deal_type"/>
                            <field name="product_category_id"/>
                        </group>
                        <group>
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <field name="company_id"
                                   groups="base.group_multi_company"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group>
                            <field name="threshold_amount"
                                   invisible="deal_type != 'turnover_bonus'"/>
                            <field name="fixed_bonus_amount"
                                   invisible="deal_type != 'turnover_bonus'"/>
                            <field name="rebate_percent"
                                   invisible="deal_type != 'retro_percent'"/>
                            <field name="rebate_per_unit"
                                   invisible="deal_type != 'per_unit'"/>
                        </group>
                        <group>
                            <field name="total_sales" readonly="1"/>
                            <field name="total_accrued" readonly="1"/>
                            <field name="credit_note_ref"/>
                            <field name="settled_date" readonly="1"/>
                        </group>
                    </group>
                    <field name="accrual_ids" readonly="1">
                        <list create="0">
                            <field name="period_month"/>
                            <field name="sales"/>
                            <field name="units" optional="show"/>
                            <field name="accrued_amount"/>
                            <field name="claimed" widget="boolean"/>
                        </list>
                    </field>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_crebate_deal_list" model="ir.ui.view">
        <field name="name">sf.customer.rebate.deal.list</field>
        <field name="model">sf.customer.rebate.deal</field>
        <field name="arch" type="xml">
            <list string="Customer Rebate Deals" sample="1">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="deal_type"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="total_sales" optional="show"/>
                <field name="total_accrued"/>
                <field name="state" widget="badge"
                       decoration-success="state in ('active','settled')"/>
            </list>
        </field>
    </record>
    <menuitem id="menu_sf_crebate_root" name="Customer Rebates" sequence="29"
              parent="sale.sale_menu_root"/>
    <menuitem id="menu_sf_crebate_deals" name="Rebate Deals"
              parent="menu_sf_crebate_root" action="action_sf_crebate_deal"
              sequence="10"/>
</odoo>
