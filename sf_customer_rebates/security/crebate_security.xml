<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_sf_crebate" model="ir.module.category">
        <field name="name">Customer Rebates</field>
        <field name="sequence">79</field>
    </record>
    <record id="group_sf_crebate_user" model="res.groups">
        <field name="name">Customer Rebate User</field>
        <field name="category_id" ref="module_category_sf_crebate"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
    </record>
    <record id="group_sf_crebate_manager" model="res.groups">
        <field name="name">Customer Rebate Manager</field>
        <field name="category_id" ref="module_category_sf_crebate"/>
        <field name="implied_ids" eval="[(4, ref('group_sf_crebate_user'))]"/>
    </record>
    <record id="rule_sf_crebate_company" model="ir.rule">
        <field name="name">Customer Rebate Deal: multi-company</field>
        <field name="model_id" ref="model_sf_customer_rebate_deal"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_sf_crebate"/>
    </record>
</odoo>
