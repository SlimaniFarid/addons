<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_payroll_deadline" model="ir.actions.act_window">
        <field name="name">Payroll Deadline Tracker</field>
        <field name="res_model">sf.payroll.deadline</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
    <record id="view_sf_payroll_deadline_form" model="ir.ui.view">
        <field name="name">sf.payroll.deadline.form</field>
        <field name="model">sf.payroll.deadline</field>
        <field name="arch" type="xml">
            <form string="Payroll Deadline Tracker">
                <header>
                    <button name="action_inputs_locked" type="object" string="Inputs Locked"
                            class="btn-primary"/>
                    <button name="action_processed" type="object" string="Processed"
                            class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="open,inputs_locked,processed,paid"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="period_month"/>
                            <field name="input_cutoff"/>
                            <field name="processing_date"/>
                            <field name="payment_date"/>
                            <field name="declaration_date"/>
                            <field name="responsible_id"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_payroll_deadline_list" model="ir.ui.view">
        <field name="name">sf.payroll.deadline.list</field>
        <field name="model">sf.payroll.deadline</field>
        <field name="arch" type="xml">
            <list string="Payroll Deadline Tracker" sample="1">
                <field name="period_month"/>
                <field name="input_cutoff"/>
                <field name="processing_date"/>
                <field name="payment_date"/>
                <field name="declaration_date"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state in ('submitted','approved')"/>
            </list>
        </field>
    </record>
    <record id="view_sf_payroll_deadline_kanban" model="ir.ui.view">
        <field name="name">sf.payroll.deadline.kanban</field>
        <field name="model">sf.payroll.deadline</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_view" group_by="state">
                <field name="name"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <menuitem id="menu_sf_payroll_deadline_root" name="Payroll Deadline Tracker" sequence="19"
              web_icon="sf_payroll_deadline_tracker,static/description/icon.png"/>
    <menuitem id="menu_sf_payroll_deadline_main" name="Records"
              parent="menu_sf_payroll_deadline_root" action="action_sf_payroll_deadline" sequence="10"/>

    <record id="wave_final_sf_payroll_deadline_tracker" model="ir.actions.server">
        <field name="name">Refresh Business Data</field>
        <field name="model_id" ref="model_sf_payroll_deadline"/>
        <field name="binding_model_id" ref="model_sf_payroll_deadline"/>
        <field name="state">code</field>
        <field name="code">records.action_refresh_business()</field>
    </record>
</odoo>
