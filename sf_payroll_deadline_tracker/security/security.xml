<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_payroll_deadline_tracker" model="ir.module.category">
        <field name="name">Payroll Deadline Tracker</field>
        <field name="sequence">29</field>
    </record>
    <record id="group_payroll_deadline_tracker_user" model="res.groups">
        <field name="name">Payroll Deadline Tracker User</field>
        <field name="category_id" ref="module_category_payroll_deadline_tracker"/>

    </record>
    <record id="group_payroll_deadline_tracker_manager" model="res.groups">
        <field name="name">Payroll Deadline Tracker Manager</field>
        <field name="category_id" ref="module_category_payroll_deadline_tracker"/>
        <field name="implied_ids" eval="[(4, ref('group_payroll_deadline_tracker_user'))]"/>
    </record>
    <record id="rule_payroll_deadline_tracker_sf_payroll_deadline" model="ir.rule">
        <field name="name">Payroll Deadline: multi-company</field>
        <field name="model_id" ref="model_sf_payroll_deadline"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_payroll_deadline_tracker"/>
    </record>
</odoo>
