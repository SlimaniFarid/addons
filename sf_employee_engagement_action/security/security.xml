<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_employee_engagement_action" model="ir.module.category">
        <field name="name">Engagement Action Tracker</field>
        <field name="sequence">176</field>
    </record>
    <record id="group_employee_engagement_action_user" model="res.groups">
        <field name="name">Engagement Action Tracker User</field>
        <field name="category_id" ref="module_category_employee_engagement_action"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>

    </record>
    <record id="group_employee_engagement_action_manager" model="res.groups">
        <field name="name">Engagement Action Tracker Manager</field>
        <field name="category_id" ref="module_category_employee_engagement_action"/>
        <field name="implied_ids" eval="[(4, ref('group_employee_engagement_action_user'))]"/>
    </record>
    <record id="rule_employee_engagement_action_sf_employee_engagement_action" model="ir.rule">
        <field name="name">Engagement Action Tracker: multi-company</field>
        <field name="model_id" ref="model_sf_employee_engagement_action"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
