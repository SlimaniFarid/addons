<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_sf_dedup" model="ir.module.category">
        <field name="name">Data Quality</field>
        <field name="sequence">73</field>
    </record>
    <record id="group_sf_dedup_user" model="res.groups">
        <field name="name">Data Steward</field>
        <field name="category_id" ref="module_category_sf_dedup"/>
    </record>
    <record id="group_sf_dedup_manager" model="res.groups">
        <field name="name">Data Quality Manager</field>
        <field name="category_id" ref="module_category_sf_dedup"/>
        <field name="implied_ids" eval="[(4, ref('group_sf_dedup_user'))]"/>
    </record>
    <record id="rule_sf_dedup_company" model="ir.rule">
        <field name="name">Dedup Scan: multi-company</field>
        <field name="model_id" ref="model_sf_dedup_scan"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_sf_dedup"/>
    </record>
    <record id="group_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="module_category_sf_dedup"/>
    </record>
    <record id="group_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="module_category_sf_dedup"/>
    </record>
</odoo>
