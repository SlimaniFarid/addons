<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_dedup_scan" model="ir.actions.act_window">
        <field name="name">Duplicate Scans</field>
        <field name="res_model">sf.dedup.scan</field>
        <field name="view_mode">kanban,list,form</field>
    </record>
    <record id="view_sf_dedup_scan_form" model="ir.ui.view">
        <field name="name">sf.dedup.scan.form</field>
        <field name="model">sf.dedup.scan</field>
        <field name="arch" type="xml">
            <form string="Duplicate Scan">
                <header>
                    <button name="action_scan" type="object"
                            string="Run Scan" class="btn-primary"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,done"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="strategy"/>
                        </group>
                        <group>
                            <field name="group_count" readonly="1"/>
                            <field name="open_count" readonly="1"/>
                            <field name="company_id"
                                   groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <field name="group_ids" readonly="1"
                           decoration-muted="state != 'open'">
                        <list create="0">
                            <field name="match_key"/>
                            <field name="record_count"/>
                            <field name="record_names"/>
                            <field name="state" widget="badge"
                                   decoration-success="state == 'merged'"/>
                        </list>
                    </field>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_dedup_scan_list" model="ir.ui.view">
        <field name="name">sf.dedup.scan.list</field>
        <field name="model">sf.dedup.scan</field>
        <field name="arch" type="xml">
            <list string="Duplicate Scans" sample="1">
                <field name="name"/>
                <field name="strategy"/>
                <field name="group_count"/>
                <field name="open_count"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"/>
            </list>
        </field>
    </record>
    <menuitem id="menu_sf_dedup_root" name="Duplicate Audit" sequence="23"
              parent="base.menu_administration"/>
    <menuitem id="menu_sf_dedup_scans" name="Duplicate Scans"
              parent="menu_sf_dedup_root" action="action_sf_dedup_scan"
              sequence="10"/>

    <record id="view_sf_data_dedup_boost_kanban" model="ir.ui.view">
        <field name="name">sf_data_dedup.boost.kanban</field>
        <field name="model">sf.dedup.scan</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" t-att-color="state">
                <field name="name"/>
                <field name="state"/>
                <field name="user_id"/>

                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_card oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title">
                                    <field name="name"/></strong>
                                <div class="o_kanban_record_subtitle">
                                    <field name="user_id" widget="many2one_avatar_user"/>
                                    <field name="create_date"/></div>
                            </div>
                            <div class="oe_kanban_bottom_right">
                                <field name="state" widget="badge"
                                       t-attf-options="{'classes_map': {'draft': 'info', 'done': 'success', 'cancelled': 'danger'}, 'domain': []}"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_sf_data_dedup_boost_search" model="ir.ui.view">
        <field name="name">sf_data_dedup.boost.search</field>
        <field name="model">sf.dedup.scan</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
<separator/>
                <filter string="My records" name="my_records" domain="[('user_id', '=', uid)]"/>
                <filter string="To Do" name="todo" domain="[('state', 'not in', ('done', 'cancelled', 'closed'))]"/>
                <group expand="0" string="Group By"><filter string="Status" name="gb_state" context="{'group_by': 'state'}"/></group>
            </search>
        </field>
    </record>
</odoo>
