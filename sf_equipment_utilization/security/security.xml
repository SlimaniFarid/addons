<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_equipment_utilization" model="ir.module.category">
        <field name="name">Equipment Utilization Tracker</field>
        <field name="sequence">183</field>
    </record>
    <record id="group_equipment_utilization_user" model="res.groups">
        <field name="name">Equipment Utilization Tracker User</field>
        <field name="category_id" ref="module_category_equipment_utilization"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>

    </record>
    <record id="group_equipment_utilization_manager" model="res.groups">
        <field name="name">Equipment Utilization Tracker Manager</field>
        <field name="category_id" ref="module_category_equipment_utilization"/>
        <field name="implied_ids" eval="[(4, ref('group_equipment_utilization_user'))]"/>
    </record>
    <record id="rule_equipment_utilization_sf_equipment_utilization" model="ir.rule">
        <field name="name">Equipment Utilization Tracker: multi-company</field>
        <field name="model_id" ref="model_sf_equipment_utilization"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_equipment_utilization"/>
    </record>
</odoo>
