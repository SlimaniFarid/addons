<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_equipment_utilization" model="ir.actions.act_window">
        <field name="name">Equipment Utilization Tracker</field>
        <field name="res_model">sf.equipment_utilization</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
    <record id="view_sf_equipment_utilization_form" model="ir.ui.view">
        <field name="name">sf.equipment_utilization.form</field>
        <field name="model">sf.equipment_utilization</field>
        <field name="arch" type="xml">
            <form string="Equipment Utilization Tracker">
                <header>
                    <button name="action_submitted" type="object" string="Submitted"
                            class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="equipment_id"/>
                            <field name="period"/>
                            <field name="available_hours"/>
                            <field name="used_hours"/>
                            <field name="utilization_percent"/>
                            <field name="downtime_reason"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_equipment_utilization_list" model="ir.ui.view">
        <field name="name">sf.equipment_utilization.list</field>
        <field name="model">sf.equipment_utilization</field>
        <field name="arch" type="xml">
            <list string="Equipment Utilization Tracker" sample="1">
                <field name="equipment_id"/>
                <field name="period"/>
                <field name="available_hours"/>
                <field name="used_hours"/>
                <field name="utilization_percent"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state in ('submitted','approved')"/>
            </list>
        </field>
    </record>
    <record id="view_sf_equipment_utilization_kanban" model="ir.ui.view">
        <field name="name">sf.equipment_utilization.kanban</field>
        <field name="model">sf.equipment_utilization</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_view" group_by="state">
                <field name="name"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <menuitem id="menu_sf_equipment_utilization_root" name="Equipment Utilization Tracker" sequence="18"
              web_icon="sf_equipment_utilization,static/description/icon.png"/>
    <menuitem id="menu_sf_equipment_utilization_main" name="Records"
              parent="menu_sf_equipment_utilization_root" action="action_sf_equipment_utilization" sequence="10"/>
</odoo>
