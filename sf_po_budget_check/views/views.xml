<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_po_budget_check" model="ir.actions.act_window">
        <field name="name">PO Budget Check Workflow</field>
        <field name="res_model">sf.po_budget_check</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
    <record id="view_sf_po_budget_check_form" model="ir.ui.view">
        <field name="name">sf.po_budget_check.form</field>
        <field name="model">sf.po_budget_check</field>
        <field name="arch" type="xml">
            <form string="PO Budget Check Workflow">
                <header>
                    <button name="action_submitted" type="object" string="Submitted"
                            class="btn-primary"/>
                    <button name="action_approved" type="object" string="Approved"
                            class="btn-primary"/>
                    <button name="action_done" type="object" string="Done"
                            class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,approved,done,cancelled"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="po_id"/>
                            <field name="budget_line"/>
                            <field name="budget_available"/>
                            <field name="po_amount"/>
                            <field name="over_budget"/>
                            <field name="override_approved"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_sf_po_budget_check_list" model="ir.ui.view">
        <field name="name">sf.po_budget_check.list</field>
        <field name="model">sf.po_budget_check</field>
        <field name="arch" type="xml">
            <list string="PO Budget Check Workflow" sample="1">
                <field name="po_id"/>
                <field name="budget_line"/>
                <field name="budget_available"/>
                <field name="po_amount"/>
                <field name="over_budget"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state in ('submitted','approved')"/>
            </list>
        </field>
    </record>
    <record id="view_sf_po_budget_check_kanban" model="ir.ui.view">
        <field name="name">sf.po_budget_check.kanban</field>
        <field name="model">sf.po_budget_check</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_view" group_by="state">
                <field name="name"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <menuitem id="menu_sf_po_budget_check_root" name="PO Budget Check Workflow" sequence="9"
              web_icon="sf_po_budget_check,static/description/icon.png"/>
    <menuitem id="menu_sf_po_budget_check_main" name="Records"
              parent="menu_sf_po_budget_check_root" action="action_sf_po_budget_check" sequence="10"/>
</odoo>
