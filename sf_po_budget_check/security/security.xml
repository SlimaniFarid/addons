<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_po_budget_check" model="ir.module.category">
        <field name="name">PO Budget Check Workflow</field>
        <field name="sequence">292</field>
    </record>
    <record id="group_po_budget_check_user" model="res.groups">
        <field name="name">PO Budget Check Workflow User</field>
        <field name="category_id" ref="module_category_po_budget_check"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>

    </record>
    <record id="group_po_budget_check_manager" model="res.groups">
        <field name="name">PO Budget Check Workflow Manager</field>
        <field name="category_id" ref="module_category_po_budget_check"/>
        <field name="implied_ids" eval="[(4, ref('group_po_budget_check_user'))]"/>
    </record>
    <record id="rule_po_budget_check_sf_po_budget_check" model="ir.rule">
        <field name="name">PO Budget Check Workflow: multi-company</field>
        <field name="model_id" ref="model_sf_po_budget_check"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="group_id" model="res.groups">
        <field name="name">Id</field>
        <field name="category_id" ref="module_category_po_budget_check"/>
    </record>
</odoo>
